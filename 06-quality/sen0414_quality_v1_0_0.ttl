@prefix cme:     <http://example.org/cme#> .
@prefix sen0414: <http://example.org/sen0414#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Quality evidence part - ENQA ESG cited: the evidence that assessment is aligned to outcomes.
# Only alignments with a stated basis are asserted. The rest are recorded as undeclared, because
# which outcomes the midterm and final test is the instructor's decision and has not been made yet.

<http://example.org/sen0414/quality> a owl:Ontology ; rdfs:label "SEN0414: quality evidence"@en ;
    owl:versionInfo "1.0.0" ; dcterms:identifier "sen0414_quality_v1_0_0" .

sen0414:Align_Project_LO8 a cme:Alignment ;
    cme:component sen0414:Project ; cme:assessesOutcome sen0414:LO8 ;
    cme:alignmentBasis "LO-8 is written to be what the project assesses, and was approved by the owner on that basis." .

sen0414:Gap_ExamAlignment a cme:AlignmentGap ;
    rdfs:label "Which outcomes the midterm and final assess is not yet declared"@en ;
    cme:gapFor sen0414:Midterm, sen0414:Final ;
    cme:gapNote "Outcomes LO-1 to LO-7 are assessed by no declared component yet. Declared by the instructor when the exams are authored; not inferred here." .
