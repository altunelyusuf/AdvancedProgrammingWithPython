chx:X_CopyFile a owl:NamedIndividual, chx:CopyFile ; rdfs:label "shutil.copy(source, destination)"@en ; skos:definition "shutil.copy copies one file to a destination that is either a folder, which keeps the file's name, or a file name, which becomes the copy's name; an existing destination file is replaced, and the call returns the path of the new file."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_CopyFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'a.txt\\').write_text(\\'Hello\\')\\n(t/\\'box\\').mkdir()\\nr1 = shutil.copy(t/\\'a.txt\\', t/\\'box\\')\\nr2 = shutil.copy(t/\\'a.txt\\', t/\\'box\\'/\\'b.txt\\')\\nout = (Path(r1).name, Path(r2).name, sorted(p.name for p in (t/\\'box\\').iterdir()), (t/\\'a.txt\\').exists())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ('a.txt', 'b.txt', ['a.txt', 'b.txt'], True)"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'a.txt\\').write_text(\\'Hello\\')\\n(t/\\'box\\').mkdir()\\nr1 = shutil.copy(t/\\'a.txt\\', t/\\'box\\')\\nr2 = shutil.copy(t/\\'a.txt\\', t/\\'box\\'/\\'b.txt\\')\\nout = (Path(r1).name, Path(r2).name, sorted(p.name for p in (t/\\'box\\').iterdir()), (t/\\'a.txt\\').exists())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "('a.txt', 'b.txt', ['a.txt', 'b.txt'], True)" .
chx:X_CopyFile rd:hasIOExample chx:IO_CopyFile .
chx:X_CopyFolderTree a owl:NamedIndividual, chx:CopyFolderTree ; rdfs:label "shutil.copytree(source, destination)"@en ; skos:definition "shutil.copytree copies a whole folder with all its files and subfolders to a new folder that must not exist yet, and returns the destination; it raises FileExistsError when the destination exists."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_CopyFolderTree a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\n(t/\\'spam\\'/\\'eggs\\'/\\'file2.txt\\').write_text(\\'Hi\\')\\nshutil.copytree(t/\\'spam\\', t/\\'spam_backup\\')\\ncopied = sorted(str(p.relative_to(t/\\'spam_backup\\')) for p in (t/\\'spam_backup\\').rglob(\\'*\\'))\\ntry:\\n    shutil.copytree(t/\\'spam\\', t/\\'spam_backup\\')\\n    second = \\'no error\\'\\nexcept FileExistsError:\\n    second = \\'FileExistsError\\'\\nout = (copied, second)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to (['eggs', 'eggs/file2.txt', 'file1.txt'], 'FileExistsError')"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\n(t/\\'spam\\'/\\'eggs\\'/\\'file2.txt\\').write_text(\\'Hi\\')\\nshutil.copytree(t/\\'spam\\', t/\\'spam_backup\\')\\ncopied = sorted(str(p.relative_to(t/\\'spam_backup\\')) for p in (t/\\'spam_backup\\').rglob(\\'*\\'))\\ntry:\\n    shutil.copytree(t/\\'spam\\', t/\\'spam_backup\\')\\n    second = \\'no error\\'\\nexcept FileExistsError:\\n    second = \\'FileExistsError\\'\\nout = (copied, second)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "(['eggs', 'eggs/file2.txt', 'file1.txt'], 'FileExistsError')" .
chx:X_CopyFolderTree rd:hasIOExample chx:IO_CopyFolderTree .
chx:X_CopyWithMetadata a owl:NamedIndividual, chx:CopyWithMetadata ; rdfs:label "shutil.copy2(source, destination)"@en ; skos:definition "shutil.copy2 copies a file like shutil.copy and also tries to keep its metadata, such as the modification time, which shutil.copy does not keep; copytree uses copy2 for every file."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_CopyWithMetadata a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nsrc = t/\\'a.txt\\'\\nsrc.write_text(\\'x\\')\\nos.utime(src, (n * 100_000_000, n * 100_000_000))\\nshutil.copy(src, t/\\'plain.txt\\')\\nshutil.copy2(src, t/\\'kept.txt\\')\\nout = (int((t/\\'kept.txt\\').stat().st_mtime), (t/\\'plain.txt\\').stat().st_mtime > 1_500_000_000)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10}) evaluates to (1000000000, True)"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nsrc = t/\\'a.txt\\'\\nsrc.write_text(\\'x\\')\\nos.utime(src, (n * 100_000_000, n * 100_000_000))\\nshutil.copy(src, t/\\'plain.txt\\')\\nshutil.copy2(src, t/\\'kept.txt\\')\\nout = (int((t/\\'kept.txt\\').stat().st_mtime), (t/\\'plain.txt\\').stat().st_mtime > 1_500_000_000)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10})" ; chx:output "(1000000000, True)" .
chx:X_CopyWithMetadata rd:hasIOExample chx:IO_CopyWithMetadata .
chx:X_ExistingDestination a owl:NamedIndividual, chx:ExistingDestination ; rdfs:label "shutil.copytree(source, destination, dirs_exist_ok=True)"@en ; skos:definition "With dirs_exist_ok=True, copytree continues into a destination folder that already exists and overwrites files of the same name there, leaving the other files in place."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_ExistingDestination a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'src\\').mkdir()\\n(t/\\'src\\'/\\'a.txt\\').write_text(\\'new\\')\\n(t/\\'dst\\').mkdir()\\n(t/\\'dst\\'/\\'a.txt\\').write_text(\\'old\\')\\n(t/\\'dst\\'/\\'keep.txt\\').write_text(\\'kept\\')\\nshutil.copytree(t/\\'src\\', t/\\'dst\\', dirs_exist_ok=True)\\nout = (sorted(p.name for p in (t/\\'dst\\').iterdir()), (t/\\'dst\\'/\\'a.txt\\').read_text())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to (['a.txt', 'keep.txt'], 'new')"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'src\\').mkdir()\\n(t/\\'src\\'/\\'a.txt\\').write_text(\\'new\\')\\n(t/\\'dst\\').mkdir()\\n(t/\\'dst\\'/\\'a.txt\\').write_text(\\'old\\')\\n(t/\\'dst\\'/\\'keep.txt\\').write_text(\\'kept\\')\\nshutil.copytree(t/\\'src\\', t/\\'dst\\', dirs_exist_ok=True)\\nout = (sorted(p.name for p in (t/\\'dst\\').iterdir()), (t/\\'dst\\'/\\'a.txt\\').read_text())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "(['a.txt', 'keep.txt'], 'new')" .
chx:X_ExistingDestination rd:hasIOExample chx:IO_ExistingDestination .
chx:X_MoveFileOrFolder a owl:NamedIndividual, chx:MoveFileOrFolder ; rdfs:label "shutil.move(source, destination)"@en ; skos:definition "shutil.move moves a file or a folder to a destination and returns where it went; if the destination is an existing folder the source goes inside it under its own name, and across file systems the move is a copy followed by a delete."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_MoveFileOrFolder a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam2\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\nr = shutil.move(t/\\'spam\\'/\\'file1.txt\\', t/\\'spam2\\')\\nout = (type(r).__name__, Path(r).relative_to(t).as_posix(), (t/\\'spam\\'/\\'file1.txt\\').exists())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ('str', 'spam2/file1.txt', False)"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam2\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\nr = shutil.move(t/\\'spam\\'/\\'file1.txt\\', t/\\'spam2\\')\\nout = (type(r).__name__, Path(r).relative_to(t).as_posix(), (t/\\'spam\\'/\\'file1.txt\\').exists())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "('str', 'spam2/file1.txt', False)" .
chx:X_MoveFileOrFolder rd:hasIOExample chx:IO_MoveFileOrFolder .
chx:X_MoveAsRename a owl:NamedIndividual, chx:MoveAsRename ; rdfs:label "shutil.move(source, destination_not_a_folder)"@en ; skos:definition "When the destination is not an existing folder, shutil.move uses it as the new path, so a move inside one folder is a rename, and an existing file at that path may be overwritten as os.rename would do on the platform."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_MoveAsRename a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\nr = shutil.move(t/\\'spam\\'/\\'file1.txt\\', t/\\'spam\\'/\\'new_name.txt\\')\\nout = (type(r).__name__, sorted(p.name for p in (t/\\'spam\\').iterdir()))\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ('PosixPath', ['new_name.txt'])"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\nr = shutil.move(t/\\'spam\\'/\\'file1.txt\\', t/\\'spam\\'/\\'new_name.txt\\')\\nout = (type(r).__name__, sorted(p.name for p in (t/\\'spam\\').iterdir()))\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "('PosixPath', ['new_name.txt'])" .
chx:X_MoveAsRename rd:hasIOExample chx:IO_MoveAsRename .
chx:X_MoveCollision a owl:NamedIndividual, chx:MoveCollision ; rdfs:label "shutil.move(file, folder_that_already_holds_that_name)"@en ; skos:definition "When the destination is a folder that already holds an item of the source's name, shutil.move raises shutil.Error and moves nothing, which differs from the chapter's statement that the file would be overwritten."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_MoveCollision a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam2\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'new\\')\\n(t/\\'spam2\\'/\\'file1.txt\\').write_text(\\'old\\')\\ntry:\\n    shutil.move(t/\\'spam\\'/\\'file1.txt\\', t/\\'spam2\\')\\n    res = \\'moved\\'\\nexcept shutil.Error:\\n    res = \\'shutil.Error\\'\\nout = (res, (t/\\'spam2\\'/\\'file1.txt\\').read_text(), (t/\\'spam\\'/\\'file1.txt\\').exists())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ('shutil.Error', 'old', True)"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam2\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'new\\')\\n(t/\\'spam2\\'/\\'file1.txt\\').write_text(\\'old\\')\\ntry:\\n    shutil.move(t/\\'spam\\'/\\'file1.txt\\', t/\\'spam2\\')\\n    res = \\'moved\\'\\nexcept shutil.Error:\\n    res = \\'shutil.Error\\'\\nout = (res, (t/\\'spam2\\'/\\'file1.txt\\').read_text(), (t/\\'spam\\'/\\'file1.txt\\').exists())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "('shutil.Error', 'old', True)" .
chx:X_MoveCollision rd:hasIOExample chx:IO_MoveCollision .
chx:X_PathlibCopyMove a owl:NamedIndividual, chx:PathlibCopyMove ; rdfs:label "Path.copy(target), Path.move(target)"@en ; skos:definition "Since Python 3.14 a Path object can copy and move itself with Path.copy, Path.copy_into, Path.move and Path.move_into, and they return the new Path; before 3.14 this needed shutil, so the page of this course runs these only under 3.14."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:X_DeleteFile a owl:NamedIndividual, chx:DeleteFile ; rdfs:label "os.unlink(path)"@en ; skos:definition "os.unlink deletes one file for good, with no recycle bin; it is the same operation as os.remove, and it raises FileNotFoundError for a missing path and an error for a folder."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_DeleteFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nf = t/\\'a.txt\\'\\nf.write_text(\\'x\\')\\nos.unlink(f)\\ntry:\\n    os.unlink(f)\\n    again = \\'no error\\'\\nexcept FileNotFoundError:\\n    again = \\'FileNotFoundError\\'\\nout = (f.exists(), again)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to (False, 'FileNotFoundError')"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nf = t/\\'a.txt\\'\\nf.write_text(\\'x\\')\\nos.unlink(f)\\ntry:\\n    os.unlink(f)\\n    again = \\'no error\\'\\nexcept FileNotFoundError:\\n    again = \\'FileNotFoundError\\'\\nout = (f.exists(), again)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "(False, 'FileNotFoundError')" .
chx:X_DeleteFile rd:hasIOExample chx:IO_DeleteFile .
chx:X_DeleteEmptyFolder a owl:NamedIndividual, chx:DeleteEmptyFolder ; rdfs:label "os.rmdir(path)"@en ; skos:definition "os.rmdir deletes one folder, and only if it is empty; a folder that still holds something raises OSError."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_DeleteEmptyFolder a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'d\\').mkdir()\\n(t/\\'d\\'/\\'f.txt\\').write_text(\\'x\\')\\ntry:\\n    os.rmdir(t/\\'d\\')\\n    first = \\'removed\\'\\nexcept OSError:\\n    first = \\'OSError\\'\\nos.unlink(t/\\'d\\'/\\'f.txt\\')\\nos.rmdir(t/\\'d\\')\\nout = (first, (t/\\'d\\').exists())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ('OSError', False)"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'d\\').mkdir()\\n(t/\\'d\\'/\\'f.txt\\').write_text(\\'x\\')\\ntry:\\n    os.rmdir(t/\\'d\\')\\n    first = \\'removed\\'\\nexcept OSError:\\n    first = \\'OSError\\'\\nos.unlink(t/\\'d\\'/\\'f.txt\\')\\nos.rmdir(t/\\'d\\')\\nout = (first, (t/\\'d\\').exists())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "('OSError', False)" .
chx:X_DeleteEmptyFolder rd:hasIOExample chx:IO_DeleteEmptyFolder .
chx:X_DeleteFolderTree a owl:NamedIndividual, chx:DeleteFolderTree ; rdfs:label "shutil.rmtree(path)"@en ; skos:definition "shutil.rmtree deletes a folder with everything in it, irreversibly; it raises FileNotFoundError for a missing path, unless ignore_errors=True."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_DeleteFolderTree a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'eggs\\'/\\'f.txt\\').write_text(\\'x\\')\\nshutil.rmtree(t/\\'spam\\')\\nshutil.rmtree(t/\\'spam\\', ignore_errors=True)\\ntry:\\n    shutil.rmtree(t/\\'spam\\')\\n    second = \\'no error\\'\\nexcept FileNotFoundError:\\n    second = \\'FileNotFoundError\\'\\nout = ((t/\\'spam\\').exists(), second)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to (False, 'FileNotFoundError')"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'eggs\\'/\\'f.txt\\').write_text(\\'x\\')\\nshutil.rmtree(t/\\'spam\\')\\nshutil.rmtree(t/\\'spam\\', ignore_errors=True)\\ntry:\\n    shutil.rmtree(t/\\'spam\\')\\n    second = \\'no error\\'\\nexcept FileNotFoundError:\\n    second = \\'FileNotFoundError\\'\\nout = ((t/\\'spam\\').exists(), second)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "(False, 'FileNotFoundError')" .
chx:X_DeleteFolderTree rd:hasIOExample chx:IO_DeleteFolderTree .
chx:X_DeletionErrors a owl:NamedIndividual, chx:DeletionErrors ; rdfs:label "shutil.rmtree(path, onexc=handler)"@en ; skos:definition "Instead of stopping, rmtree can call a handler with the failing function, the path and the exception; the onexc parameter exists since Python 3.12 and replaces the deprecated onerror, whose handler receives an exception-information tuple instead of the exception."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_DeletionErrors a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nseen = []\\nshutil.rmtree(t/\\'missing\\', onexc=lambda func, path, exc: seen.append((Path(path).name, type(exc).__name__)))\\nout = seen\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to [('missing', 'FileNotFoundError')]"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nseen = []\\nshutil.rmtree(t/\\'missing\\', onexc=lambda func, path, exc: seen.append((Path(path).name, type(exc).__name__)))\\nout = seen\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "[('missing', 'FileNotFoundError')]" .
chx:X_DeletionErrors rd:hasIOExample chx:IO_DeletionErrors .
chx:X_DryRun a owl:NamedIndividual, chx:DryRun ; rdfs:label "print('Deleting', filename)  # os.unlink(filename)"@en ; skos:definition "A dry run replaces the dangerous call with a print, so the program shows what it would delete, copy, rename or move before it does so; the chapter's typo *.rxt for *.txt is found this way."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_DryRun a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'a.txt\\').write_text(\\'x\\')\\n(t/\\'b.txt\\').write_text(\\'y\\')\\nfor i in range(n):\\n    (t/(\\'extra%d.txt\\' % i)).write_text(\\'x\\')\\nwould = [f.name for f in sorted(t.glob(\\'*.rxt\\'))]\\nwould_fixed = [f.name for f in sorted(t.glob(\\'*.txt\\'))]\\nout = (would, would_fixed, sorted(p.name for p in t.iterdir()))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0}) evaluates to ([], ['a.txt', 'b.txt'], ['a.txt', 'b.txt'])"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'a.txt\\').write_text(\\'x\\')\\n(t/\\'b.txt\\').write_text(\\'y\\')\\nfor i in range(n):\\n    (t/(\\'extra%d.txt\\' % i)).write_text(\\'x\\')\\nwould = [f.name for f in sorted(t.glob(\\'*.rxt\\'))]\\nwould_fixed = [f.name for f in sorted(t.glob(\\'*.txt\\'))]\\nout = (would, would_fixed, sorted(p.name for p in t.iterdir()))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0})" ; chx:output "([], ['a.txt', 'b.txt'], ['a.txt', 'b.txt'])" .
chx:X_DryRun rd:hasIOExample chx:IO_DryRun .
chx:X_RecycleBin a owl:NamedIndividual, chx:RecycleBin ; rdfs:label "send2trash.send2trash(path)"@en ; skos:definition "The third-party send2trash module moves a file or folder to the recycle bin or trash instead of deleting it, so it can be restored, but it frees no disk space and cannot take anything out of the bin; it needs installing and a desktop with a trash, so this course does not run it."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:X_ListDirectory a owl:NamedIndividual, chx:ListDirectory ; rdfs:label "os.listdir(path)"@en ; skos:definition "os.listdir returns the names in one folder as a list of strings, both files and folders, without their contents and in no promised order."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_ListDirectory a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'x\\')\\nfor i in range(n):\\n    (t/\\'spam\\'/(\\'extra%d.txt\\' % i)).write_text(\\'x\\')\\nout = sorted(os.listdir(t/\\'spam\\'))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0}) evaluates to ['eggs', 'file1.txt']"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'x\\')\\nfor i in range(n):\\n    (t/\\'spam\\'/(\\'extra%d.txt\\' % i)).write_text(\\'x\\')\\nout = sorted(os.listdir(t/\\'spam\\'))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0})" ; chx:output "['eggs', 'file1.txt']" .
chx:X_ListDirectory rd:hasIOExample chx:IO_ListDirectory .
chx:X_IterateDirectory a owl:NamedIndividual, chx:IterateDirectory ; rdfs:label "Path.iterdir()"@en ; skos:definition "Path.iterdir yields a Path object for every entry of a folder, and like listdir it does not look into subfolders and promises no order."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_IterateDirectory a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'x\\')\\nfor i in range(n):\\n    (t/\\'spam\\'/(\\'extra%d.txt\\' % i)).write_text(\\'x\\')\\nout = sorted((p.name, p.is_dir()) for p in (t/\\'spam\\').iterdir())\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0}) evaluates to [('eggs', True), ('file1.txt', False)]"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'x\\')\\nfor i in range(n):\\n    (t/\\'spam\\'/(\\'extra%d.txt\\' % i)).write_text(\\'x\\')\\nout = sorted((p.name, p.is_dir()) for p in (t/\\'spam\\').iterdir())\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0})" ; chx:output "[('eggs', True), ('file1.txt', False)]" .
chx:X_IterateDirectory rd:hasIOExample chx:IO_IterateDirectory .
chx:X_GlobPattern a owl:NamedIndividual, chx:GlobPattern ; rdfs:label "folder.glob('*.txt'), folder.rglob('*.txt')"@en ; skos:definition "Path.glob yields the entries of one folder whose names match a wildcard pattern, and Path.rglob searches the subfolders too; its case_sensitive argument decides whether the case of letters matters in the pattern."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_GlobPattern a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'sub\\').mkdir()\\n(t/\\'a.txt\\').write_text(\\'x\\')\\n(t/\\'b.pdf\\').write_text(\\'x\\')\\n(t/\\'sub\\'/\\'c.txt\\').write_text(\\'x\\')\\nfor i in range(n):\\n    (t/(\\'extra%d.txt\\' % i)).write_text(\\'x\\')\\nout = (sorted(p.name for p in t.glob(\\'*.txt\\')), sorted(p.name for p in t.rglob(\\'*.txt\\')))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0}) evaluates to (['a.txt'], ['a.txt', 'c.txt'])"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'sub\\').mkdir()\\n(t/\\'a.txt\\').write_text(\\'x\\')\\n(t/\\'b.pdf\\').write_text(\\'x\\')\\n(t/\\'sub\\'/\\'c.txt\\').write_text(\\'x\\')\\nfor i in range(n):\\n    (t/(\\'extra%d.txt\\' % i)).write_text(\\'x\\')\\nout = (sorted(p.name for p in t.glob(\\'*.txt\\')), sorted(p.name for p in t.rglob(\\'*.txt\\')))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0})" ; chx:output "(['a.txt'], ['a.txt', 'c.txt'])" .
chx:X_GlobPattern rd:hasIOExample chx:IO_GlobPattern .
chx:X_WalkTree a owl:NamedIndividual, chx:WalkTree ; rdfs:label "for folder_name, subfolders, filenames in os.walk(top):"@en ; skos:definition "os.walk visits a folder and every folder below it and on each pass gives three values: the current folder's path as a string, the list of its subfolder names and the list of its file names, with no path in the names."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_WalkTree a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nfor d in (\\'spam/eggs/bacon\\', \\'spam/eggs2\\'):\\n    (t/d).mkdir(parents=True)\\nfor f in (\\'spam/file1.txt\\', \\'spam/eggs/file2.txt\\', \\'spam/eggs/bacon/file4.txt\\'):\\n    (t/f).write_text(\\'Hello\\')\\nout = [(Path(a).relative_to(t).as_posix(), sorted(b), sorted(c)) for a, b, c in os.walk(t/\\'spam\\')]\\nout.sort()\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to [('spam', ['eggs', 'eggs2'], ['file1.txt']), ('spam/eggs', ['bacon'], ['file2.txt']), ('spam/eggs/bacon', [], ['file4.txt']), ('spam/eggs2', [], [])]"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nfor d in (\\'spam/eggs/bacon\\', \\'spam/eggs2\\'):\\n    (t/d).mkdir(parents=True)\\nfor f in (\\'spam/file1.txt\\', \\'spam/eggs/file2.txt\\', \\'spam/eggs/bacon/file4.txt\\'):\\n    (t/f).write_text(\\'Hello\\')\\nout = [(Path(a).relative_to(t).as_posix(), sorted(b), sorted(c)) for a, b, c in os.walk(t/\\'spam\\')]\\nout.sort()\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "[('spam', ['eggs', 'eggs2'], ['file1.txt']), ('spam/eggs', ['bacon'], ['file2.txt']), ('spam/eggs/bacon', [], ['file4.txt']), ('spam/eggs2', [], [])]" .
chx:X_WalkTree rd:hasIOExample chx:IO_WalkTree .
chx:X_WalkOrder a owl:NamedIndividual, chx:WalkOrder ; rdfs:label "os.walk(top, topdown=False)"@en ; skos:definition "By default os.walk gives a folder before its subfolders; with topdown=False it gives the subfolders first, which is the order needed to delete a tree with rmdir, and the order of names inside one folder depends on the file system."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_WalkOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'a\\'/\\'b\\').mkdir(parents=True)\\n(t/\\'a\\'/\\'b\\'/\\'f.txt\\').write_text(\\'x\\')\\nfor i in range(n):\\n    (t/(\\'extra%d\\' % i)).mkdir()\\ndown = [Path(a).relative_to(t).as_posix() for a, b, c in os.walk(t)]\\nup = [Path(a).relative_to(t).as_posix() for a, b, c in os.walk(t, topdown=False)]\\nout = (down, up)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0}) evaluates to (['.', 'a', 'a/b'], ['a/b', 'a', '.'])"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'a\\'/\\'b\\').mkdir(parents=True)\\n(t/\\'a\\'/\\'b\\'/\\'f.txt\\').write_text(\\'x\\')\\nfor i in range(n):\\n    (t/(\\'extra%d\\' % i)).mkdir()\\ndown = [Path(a).relative_to(t).as_posix() for a, b, c in os.walk(t)]\\nup = [Path(a).relative_to(t).as_posix() for a, b, c in os.walk(t, topdown=False)]\\nout = (down, up)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0})" ; chx:output "(['.', 'a', 'a/b'], ['a/b', 'a', '.'])" .
chx:X_WalkOrder rd:hasIOExample chx:IO_WalkOrder .
chx:X_PruneWalk a owl:NamedIndividual, chx:PruneWalk ; rdfs:label "subfolders.remove('name')"@en ; skos:definition "When walking top-down the loop may change the subfolder list in place, for example with remove or del, and os.walk then skips the removed folders; assigning a new list to the name does not prune."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_PruneWalk a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nfor d in (\\'keep\\', \\'skip\\', \\'keep/inner\\'):\\n    (t/d).mkdir()\\nfor i in range(n):\\n    (t/(\\'extra%d\\' % i)).mkdir()\\nvisited = []\\nfor a, b, c in os.walk(t):\\n    if \\'skip\\' in b:\\n        b.remove(\\'skip\\')\\n    visited.append(Path(a).relative_to(t).as_posix())\\nout = sorted(visited)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0}) evaluates to ['.', 'keep', 'keep/inner']"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nfor d in (\\'keep\\', \\'skip\\', \\'keep/inner\\'):\\n    (t/d).mkdir()\\nfor i in range(n):\\n    (t/(\\'extra%d\\' % i)).mkdir()\\nvisited = []\\nfor a, b, c in os.walk(t):\\n    if \\'skip\\' in b:\\n        b.remove(\\'skip\\')\\n    visited.append(Path(a).relative_to(t).as_posix())\\nout = sorted(visited)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0})" ; chx:output "['.', 'keep', 'keep/inner']" .
chx:X_PruneWalk rd:hasIOExample chx:IO_PruneWalk .
chx:X_WalkAndRename a owl:NamedIndividual, chx:WalkAndRename ; rdfs:label "shutil.move(p / filename, p / filename.upper())"@en ; skos:definition "The chapter's program walks a tree and renames each file to upper case with shutil.move; the documentation leaves it unspecified whether a file renamed during the walk is listed, so the program is safe only because it renames files and never adds or removes folders."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_WalkAndRename a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\n(t/\\'spam\\'/\\'eggs\\'/\\'file2.txt\\').write_text(\\'Hello\\')\\nfor folder_name, subfolders, filenames in os.walk(t/\\'spam\\'):\\n    p = Path(folder_name)\\n    for filename in filenames:\\n        shutil.move(p / filename, p / filename.upper())\\nout = sorted(str(p.relative_to(t)) for p in (t/\\'spam\\').rglob(\\'*.TXT\\'))\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ['spam/FILE1.TXT', 'spam/eggs/FILE2.TXT']"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\n(t/\\'spam\\'/\\'eggs\\'/\\'file2.txt\\').write_text(\\'Hello\\')\\nfor folder_name, subfolders, filenames in os.walk(t/\\'spam\\'):\\n    p = Path(folder_name)\\n    for filename in filenames:\\n        shutil.move(p / filename, p / filename.upper())\\nout = sorted(str(p.relative_to(t)) for p in (t/\\'spam\\').rglob(\\'*.TXT\\'))\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "['spam/FILE1.TXT', 'spam/eggs/FILE2.TXT']" .
chx:X_WalkAndRename rd:hasIOExample chx:IO_WalkAndRename .
chx:X_PathWalk a owl:NamedIndividual, chx:PathWalk ; rdfs:label "folder.walk()"@en ; skos:definition "Path.walk, added in Python 3.12, is os.walk for Path objects: it yields the current folder as a Path, and lists of subfolder and file names as strings; it has top_down, on_error and follow_symlinks parameters."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_PathWalk a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'x\\')\\nout = sorted((type(d).__name__, d.relative_to(t).as_posix(), sorted(s), sorted(f)) for d, s, f in (t/\\'spam\\').walk())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to [('PosixPath', 'spam', ['eggs'], ['file1.txt']), ('PosixPath', 'spam/eggs', [], [])]"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'eggs\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'x\\')\\nout = sorted((type(d).__name__, d.relative_to(t).as_posix(), sorted(s), sorted(f)) for d, s, f in (t/\\'spam\\').walk())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "[('PosixPath', 'spam', ['eggs'], ['file1.txt']), ('PosixPath', 'spam/eggs', [], [])]" .
chx:X_PathWalk rd:hasIOExample chx:IO_PathWalk .
chx:X_CreateZip a owl:NamedIndividual, chx:CreateZip ; rdfs:label "zipfile.ZipFile('example.zip', 'w')"@en ; skos:definition "A ZipFile opened with mode 'w' creates a new ZIP file, or empties an existing one, and its write method adds a file from the disk under its path; using the object in a with statement closes it at the end."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_CreateZip a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'file1.txt\\').write_text(\\'Hello\\' * 10000)\\nwith zipfile.ZipFile(t/\\'example.zip\\', \\'w\\') as z:\\n    z.write(t/\\'file1.txt\\', arcname=\\'file1.txt\\', compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)\\nout = (zipfile.is_zipfile(t/\\'example.zip\\'), zipfile.ZipFile(t/\\'example.zip\\').namelist())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to (True, ['file1.txt'])"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'file1.txt\\').write_text(\\'Hello\\' * 10000)\\nwith zipfile.ZipFile(t/\\'example.zip\\', \\'w\\') as z:\\n    z.write(t/\\'file1.txt\\', arcname=\\'file1.txt\\', compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)\\nout = (zipfile.is_zipfile(t/\\'example.zip\\'), zipfile.ZipFile(t/\\'example.zip\\').namelist())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "(True, ['file1.txt'])" .
chx:X_CreateZip rd:hasIOExample chx:IO_CreateZip .
chx:X_CompressionMethod a owl:NamedIndividual, chx:CompressionMethod ; rdfs:label "compress_type=zipfile.ZIP_DEFLATED"@en ; skos:definition "The compression method is ZIP_STORED by default, which does not compress at all, or ZIP_DEFLATED, which the chapter recommends; the standard library also offers ZIP_BZIP2 and ZIP_LZMA, and ZIP_ZSTANDARD since Python 3.14."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_CompressionMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nsizes = {}\\nfor name, method in ((\\'stored\\', zipfile.ZIP_STORED), (\\'deflated\\', zipfile.ZIP_DEFLATED)):\\n    b = io.BytesIO()\\n    with zipfile.ZipFile(b, \\'w\\') as z:\\n        z.writestr(\\'a.txt\\', \\'Hello\\' * (n * 1000), compress_type=method)\\n    sizes[name] = zipfile.ZipFile(b).getinfo(\\'a.txt\\').compress_size\\nout = (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED, sizes[\\'stored\\'], sizes[\\'deflated\\'] < sizes[\\'stored\\'])\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10}) evaluates to (0, 8, 50000, True)"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nsizes = {}\\nfor name, method in ((\\'stored\\', zipfile.ZIP_STORED), (\\'deflated\\', zipfile.ZIP_DEFLATED)):\\n    b = io.BytesIO()\\n    with zipfile.ZipFile(b, \\'w\\') as z:\\n        z.writestr(\\'a.txt\\', \\'Hello\\' * (n * 1000), compress_type=method)\\n    sizes[name] = zipfile.ZipFile(b).getinfo(\\'a.txt\\').compress_size\\nout = (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED, sizes[\\'stored\\'], sizes[\\'deflated\\'] < sizes[\\'stored\\'])\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10})" ; chx:output "(0, 8, 50000, True)" .
chx:X_CompressionMethod rd:hasIOExample chx:IO_CompressionMethod .
chx:X_CompressionLevel a owl:NamedIndividual, chx:CompressionLevel ; rdfs:label "compresslevel=9"@en ; skos:definition "compresslevel picks the compression effort for ZIP_DEFLATED from 0 to 9; higher is slower and smaller, 9 is the most compressed, and the default level is that of zlib, which is level 6."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_CompressionLevel a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nsizes = {}\\nfor lvl in (0, 1, 6, 9):\\n    b = io.BytesIO()\\n    with zipfile.ZipFile(b, \\'w\\') as z:\\n        z.writestr(\\'a.txt\\', \\'Hello\\' * (n * 1000), compress_type=zipfile.ZIP_DEFLATED, compresslevel=lvl)\\n    sizes[lvl] = zipfile.ZipFile(b).getinfo(\\'a.txt\\').compress_size\\nout = (sizes[0] > 50000, sizes[0] > sizes[1] > sizes[9], sizes[9] <= sizes[6], sizes[9] < 200)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10}) evaluates to (True, True, True, True)"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nsizes = {}\\nfor lvl in (0, 1, 6, 9):\\n    b = io.BytesIO()\\n    with zipfile.ZipFile(b, \\'w\\') as z:\\n        z.writestr(\\'a.txt\\', \\'Hello\\' * (n * 1000), compress_type=zipfile.ZIP_DEFLATED, compresslevel=lvl)\\n    sizes[lvl] = zipfile.ZipFile(b).getinfo(\\'a.txt\\').compress_size\\nout = (sizes[0] > 50000, sizes[0] > sizes[1] > sizes[9], sizes[9] <= sizes[6], sizes[9] < 200)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10})" ; chx:output "(True, True, True, True)" .
chx:X_CompressionLevel rd:hasIOExample chx:IO_CompressionLevel .
chx:X_AppendToZip a owl:NamedIndividual, chx:AppendToZip ; rdfs:label "zipfile.ZipFile('example.zip', 'a')"@en ; skos:definition "Mode 'a' adds files to an existing ZIP file and keeps what is there, mode 'w' erases it first, and mode 'x' refuses to touch an existing file with FileExistsError."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_AppendToZip a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\np = t/\\'z.zip\\'\\nwith zipfile.ZipFile(p, \\'w\\') as z:\\n    z.writestr(\\'one.txt\\', \\'1\\')\\nwith zipfile.ZipFile(p, \\'a\\') as z:\\n    z.writestr(\\'two.txt\\', \\'2\\')\\nafter_a = zipfile.ZipFile(p).namelist()\\ntry:\\n    zipfile.ZipFile(p, \\'x\\')\\n    x = \\'no error\\'\\nexcept FileExistsError:\\n    x = \\'FileExistsError\\'\\nwith zipfile.ZipFile(p, \\'w\\') as z:\\n    z.writestr(\\'three.txt\\', \\'3\\')\\nout = (after_a, x, zipfile.ZipFile(p).namelist())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to (['one.txt', 'two.txt'], 'FileExistsError', ['three.txt'])"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\np = t/\\'z.zip\\'\\nwith zipfile.ZipFile(p, \\'w\\') as z:\\n    z.writestr(\\'one.txt\\', \\'1\\')\\nwith zipfile.ZipFile(p, \\'a\\') as z:\\n    z.writestr(\\'two.txt\\', \\'2\\')\\nafter_a = zipfile.ZipFile(p).namelist()\\ntry:\\n    zipfile.ZipFile(p, \\'x\\')\\n    x = \\'no error\\'\\nexcept FileExistsError:\\n    x = \\'FileExistsError\\'\\nwith zipfile.ZipFile(p, \\'w\\') as z:\\n    z.writestr(\\'three.txt\\', \\'3\\')\\nout = (after_a, x, zipfile.ZipFile(p).namelist())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "(['one.txt', 'two.txt'], 'FileExistsError', ['three.txt'])" .
chx:X_AppendToZip rd:hasIOExample chx:IO_AppendToZip .
chx:X_NameList a owl:NamedIndividual, chx:NameList ; rdfs:label "example_zip.namelist()"@en ; skos:definition "ZipFile(name) opens an archive for reading, and namelist returns the names of its members as a list of strings, folders included with a closing slash; the ZipFile object is a different thing from the zipfile module."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_NameList a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nwith zipfile.ZipFile(t/\\'z.zip\\', \\'w\\') as z:\\n    z.writestr(\\'file1.txt\\', \\'x\\')\\n    z.writestr(\\'sub/file2.txt\\', \\'y\\')\\n    z.mkdir(\\'emptydir\\')\\nfor i in range(n):\\n    zipfile.ZipFile(t/\\'z.zip\\', \\'a\\').writestr(\\'extra%d.txt\\' % i, \\'E\\')\\nout = zipfile.ZipFile(t/\\'z.zip\\').namelist()\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0}) evaluates to ['file1.txt', 'sub/file2.txt', 'emptydir/']"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nwith zipfile.ZipFile(t/\\'z.zip\\', \\'w\\') as z:\\n    z.writestr(\\'file1.txt\\', \\'x\\')\\n    z.writestr(\\'sub/file2.txt\\', \\'y\\')\\n    z.mkdir(\\'emptydir\\')\\nfor i in range(n):\\n    zipfile.ZipFile(t/\\'z.zip\\', \\'a\\').writestr(\\'extra%d.txt\\' % i, \\'E\\')\\nout = zipfile.ZipFile(t/\\'z.zip\\').namelist()\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0})" ; chx:output "['file1.txt', 'sub/file2.txt', 'emptydir/']" .
chx:X_NameList rd:hasIOExample chx:IO_NameList .
chx:X_ZipInfoSizes a owl:NamedIndividual, chx:ZipInfoSizes ; rdfs:label "example_zip.getinfo('file1.txt').compress_size"@en ; skos:definition "getinfo returns a ZipInfo for one member of the archive, whose file_size is the original size in bytes and compress_size the size inside the archive."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_ZipInfoSizes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nb = io.BytesIO()\\nwith zipfile.ZipFile(b, \\'w\\') as z:\\n    z.writestr(\\'file1.txt\\', \\'Hello\\' * (n * 1000), compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)\\ninfo = zipfile.ZipFile(b).getinfo(\\'file1.txt\\')\\nout = (info.filename, info.file_size, info.compress_size < info.file_size)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10}) evaluates to ('file1.txt', 50000, True)"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nb = io.BytesIO()\\nwith zipfile.ZipFile(b, \\'w\\') as z:\\n    z.writestr(\\'file1.txt\\', \\'Hello\\' * (n * 1000), compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)\\ninfo = zipfile.ZipFile(b).getinfo(\\'file1.txt\\')\\nout = (info.filename, info.file_size, info.compress_size < info.file_size)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10})" ; chx:output "('file1.txt', 50000, True)" .
chx:X_ZipInfoSizes rd:hasIOExample chx:IO_ZipInfoSizes .
chx:X_CompressionRatio a owl:NamedIndividual, chx:CompressionRatio ; rdfs:label "file_size / compress_size"@en ; skos:definition "The ratio of the original size to the compressed size tells how well the data compressed; highly repetitive text such as 'Hello' repeated 10000 times compresses about 515 times, and data that is already compressed hardly at all."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_CompressionRatio a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nb = io.BytesIO()\\nwith zipfile.ZipFile(b, \\'w\\') as z:\\n    z.writestr(\\'file1.txt\\', \\'Hello\\' * (n * 1000), compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)\\ninfo = zipfile.ZipFile(b).getinfo(\\'file1.txt\\')\\nout = (info.file_size, info.file_size / info.compress_size > 100, info.compress_size < 200)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10}) evaluates to (50000, True, True)"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nb = io.BytesIO()\\nwith zipfile.ZipFile(b, \\'w\\') as z:\\n    z.writestr(\\'file1.txt\\', \\'Hello\\' * (n * 1000), compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)\\ninfo = zipfile.ZipFile(b).getinfo(\\'file1.txt\\')\\nout = (info.file_size, info.file_size / info.compress_size > 100, info.compress_size < 200)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10})" ; chx:output "(50000, True, True)" .
chx:X_CompressionRatio rd:hasIOExample chx:IO_CompressionRatio .
chx:X_ExtractAll a owl:NamedIndividual, chx:ExtractAll ; rdfs:label "example_zip.extractall(folder)"@en ; skos:definition "extractall writes every member of the archive into the current folder, or into the folder named, which is created when missing, and it overwrites files of the same name without asking."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_ExtractAll a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nwith zipfile.ZipFile(t/\\'z.zip\\', \\'w\\') as z:\\n    z.writestr(\\'a.txt\\', \\'A\\')\\n    z.writestr(\\'sub/b.txt\\', \\'B\\')\\nfor i in range(n):\\n    zipfile.ZipFile(t/\\'z.zip\\', \\'a\\').writestr(\\'extra%d.txt\\' % i, \\'E\\')\\nzipfile.ZipFile(t/\\'z.zip\\').extractall(t/\\'out\\')\\nout = sorted(p.relative_to(t/\\'out\\').as_posix() for p in (t/\\'out\\').rglob(\\'*\\'))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0}) evaluates to ['a.txt', 'sub', 'sub/b.txt']"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nwith zipfile.ZipFile(t/\\'z.zip\\', \\'w\\') as z:\\n    z.writestr(\\'a.txt\\', \\'A\\')\\n    z.writestr(\\'sub/b.txt\\', \\'B\\')\\nfor i in range(n):\\n    zipfile.ZipFile(t/\\'z.zip\\', \\'a\\').writestr(\\'extra%d.txt\\' % i, \\'E\\')\\nzipfile.ZipFile(t/\\'z.zip\\').extractall(t/\\'out\\')\\nout = sorted(p.relative_to(t/\\'out\\').as_posix() for p in (t/\\'out\\').rglob(\\'*\\'))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0})" ; chx:output "['a.txt', 'sub', 'sub/b.txt']" .
chx:X_ExtractAll rd:hasIOExample chx:IO_ExtractAll .
chx:X_ExtractOne a owl:NamedIndividual, chx:ExtractOne ; rdfs:label "example_zip.extract('file1.txt', folder)"@en ; skos:definition "extract takes out one member, whose name must be one of those namelist returns, and returns the path it wrote; a name that is not in the archive raises KeyError."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_ExtractOne a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nwith zipfile.ZipFile(t/\\'z.zip\\', \\'w\\') as z:\\n    z.writestr(\\'a.txt\\', \\'A\\')\\nzf = zipfile.ZipFile(t/\\'z.zip\\')\\nr = zf.extract(\\'a.txt\\', t/\\'new\\'/\\'folder\\')\\ntry:\\n    zf.extract(\\'nothing.txt\\', t)\\n    k = \\'no error\\'\\nexcept KeyError:\\n    k = \\'KeyError\\'\\nout = (Path(r).relative_to(t).as_posix(), k)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ('new/folder/a.txt', 'KeyError')"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nwith zipfile.ZipFile(t/\\'z.zip\\', \\'w\\') as z:\\n    z.writestr(\\'a.txt\\', \\'A\\')\\nzf = zipfile.ZipFile(t/\\'z.zip\\')\\nr = zf.extract(\\'a.txt\\', t/\\'new\\'/\\'folder\\')\\ntry:\\n    zf.extract(\\'nothing.txt\\', t)\\n    k = \\'no error\\'\\nexcept KeyError:\\n    k = \\'KeyError\\'\\nout = (Path(r).relative_to(t).as_posix(), k)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "('new/folder/a.txt', 'KeyError')" .
chx:X_ExtractOne rd:hasIOExample chx:IO_ExtractOne .
chx:X_ExtractionSafety a owl:NamedIndividual, chx:ExtractionSafety ; rdfs:label "a member named '../../evil.txt'"@en ; skos:definition "An archive from an untrusted source may carry member names with .. or a leading slash; the zipfile module removes them on extraction so nothing lands outside the target folder, but the documentation still says never to extract untrusted archives without inspecting them first."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_ExtractionSafety a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nb = io.BytesIO()\\nwith zipfile.ZipFile(b, \\'w\\') as z:\\n    z.writestr(\\'../../evil.txt\\', \\'x\\')\\n    z.writestr(\\'/abs.txt\\', \\'y\\')\\nz = zipfile.ZipFile(b)\\nz.extractall(t/\\'safe\\')\\nout = (z.namelist(), sorted(p.relative_to(t).as_posix() for p in t.rglob(\\'*.txt\\')))\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to (['../../evil.txt', '/abs.txt'], ['safe/abs.txt', 'safe/evil.txt'])"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nb = io.BytesIO()\\nwith zipfile.ZipFile(b, \\'w\\') as z:\\n    z.writestr(\\'../../evil.txt\\', \\'x\\')\\n    z.writestr(\\'/abs.txt\\', \\'y\\')\\nz = zipfile.ZipFile(b)\\nz.extractall(t/\\'safe\\')\\nout = (z.namelist(), sorted(p.relative_to(t).as_posix() for p in t.rglob(\\'*.txt\\')))\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "(['../../evil.txt', '/abs.txt'], ['safe/abs.txt', 'safe/evil.txt'])" .
chx:X_ExtractionSafety rd:hasIOExample chx:IO_ExtractionSafety .
chx:X_MakeArchive a owl:NamedIndividual, chx:MakeArchive ; rdfs:label "shutil.make_archive(name, 'zip', root_dir, base_dir)"@en ; skos:definition "shutil.make_archive builds a zip, tar or other archive of a folder in one call and returns the archive's name; its zip files are compressed with the deflate method, where the chapter's ZipFile.write compresses only when told to."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_MakeArchive a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'sub\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'a.txt\\').write_text(\\'Hello\\' * 100)\\n(t/\\'spam\\'/\\'sub\\'/\\'b.txt\\').write_text(\\'B\\')\\nname = shutil.make_archive(str(t/\\'snap\\'), \\'zip\\', root_dir=t, base_dir=\\'spam\\')\\nzf = zipfile.ZipFile(name)\\nout = (Path(name).name, sorted(zf.namelist()), {i.compress_type for i in zf.infolist() if not i.is_dir()})\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ('snap.zip', ['spam/', 'spam/a.txt', 'spam/sub/', 'spam/sub/b.txt'], {8})"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'sub\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'a.txt\\').write_text(\\'Hello\\' * 100)\\n(t/\\'spam\\'/\\'sub\\'/\\'b.txt\\').write_text(\\'B\\')\\nname = shutil.make_archive(str(t/\\'snap\\'), \\'zip\\', root_dir=t, base_dir=\\'spam\\')\\nzf = zipfile.ZipFile(name)\\nout = (Path(name).name, sorted(zf.namelist()), {i.compress_type for i in zf.infolist() if not i.is_dir()})\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "('snap.zip', ['spam/', 'spam/a.txt', 'spam/sub/', 'spam/sub/b.txt'], {8})" .
chx:X_MakeArchive rd:hasIOExample chx:IO_MakeArchive .
chx:X_UnpackArchive a owl:NamedIndividual, chx:UnpackArchive ; rdfs:label "shutil.unpack_archive(filename, extract_dir)"@en ; skos:definition "shutil.unpack_archive extracts an archive, choosing the format from the file name's extension, into the folder named or the current one; for a zip file it uses the zipfile module."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_UnpackArchive a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nwith zipfile.ZipFile(t/\\'z.zip\\', \\'w\\') as z:\\n    z.writestr(\\'a.txt\\', \\'A\\')\\n    z.writestr(\\'sub/b.txt\\', \\'B\\')\\nfor i in range(n):\\n    zipfile.ZipFile(t/\\'z.zip\\', \\'a\\').writestr(\\'extra%d.txt\\' % i, \\'E\\')\\nshutil.unpack_archive(t/\\'z.zip\\', t/\\'un\\')\\nout = sorted(p.relative_to(t/\\'un\\').as_posix() for p in (t/\\'un\\').rglob(\\'*\\'))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0}) evaluates to ['a.txt', 'sub', 'sub/b.txt']"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nwith zipfile.ZipFile(t/\\'z.zip\\', \\'w\\') as z:\\n    z.writestr(\\'a.txt\\', \\'A\\')\\n    z.writestr(\\'sub/b.txt\\', \\'B\\')\\nfor i in range(n):\\n    zipfile.ZipFile(t/\\'z.zip\\', \\'a\\').writestr(\\'extra%d.txt\\' % i, \\'E\\')\\nshutil.unpack_archive(t/\\'z.zip\\', t/\\'un\\')\\nout = sorted(p.relative_to(t/\\'un\\').as_posix() for p in (t/\\'un\\').rglob(\\'*\\'))\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 0})" ; chx:output "['a.txt', 'sub', 'sub/b.txt']" .
chx:X_UnpackArchive rd:hasIOExample chx:IO_UnpackArchive .
chx:X_NextZipName a owl:NamedIndividual, chx:NextZipName ; rdfs:label "zip_filename = Path(folder.parts[-1] + '_' + str(number) + '.zip')"@en ; skos:definition "The backup program names its archive after the last part of the folder's path, then counts up from 1 and stops at the first name that does not exist yet, so each run makes the next numbered snapshot; it tests names in the current working directory."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_NextZipName a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nos.chdir(t)\\nfolder = Path(\\'/home/al/spam\\')\\nmade = []\\nfor run in range(n):\\n    number = 1\\n    while True:\\n        zip_filename = Path(folder.parts[-1] + \\'_\\' + str(number) + \\'.zip\\')\\n        if not zip_filename.exists():\\n            break\\n        number = number + 1\\n    zip_filename.write_text(\\'\\')\\n    made.append(zip_filename.name)\\nos.chdir(\\'/\\')\\nout = made\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 3}) evaluates to ['spam_1.zip', 'spam_2.zip', 'spam_3.zip']"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nos.chdir(t)\\nfolder = Path(\\'/home/al/spam\\')\\nmade = []\\nfor run in range(n):\\n    number = 1\\n    while True:\\n        zip_filename = Path(folder.parts[-1] + \\'_\\' + str(number) + \\'.zip\\')\\n        if not zip_filename.exists():\\n            break\\n        number = number + 1\\n    zip_filename.write_text(\\'\\')\\n    made.append(zip_filename.name)\\nos.chdir(\\'/\\')\\nout = made\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 3})" ; chx:output "['spam_1.zip', 'spam_2.zip', 'spam_3.zip']" .
chx:X_NextZipName rd:hasIOExample chx:IO_NextZipName .
chx:X_WalkIntoZip a owl:NamedIndividual, chx:WalkIntoZip ; rdfs:label "backup_zip.write(folder_name / filename)"@en ; skos:definition "The program walks the folder with os.walk and writes every file into the archive, so one loop inside another covers the whole tree; folders that hold no files are not recorded in the archive."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_WalkIntoZip a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'sub\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'empty\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\n(t/\\'spam\\'/\\'sub\\'/\\'f2.txt\\').write_text(\\'x\\')\\nbackup_zip = zipfile.ZipFile(t/\\'spam_1.zip\\', \\'w\\')\\nfor folder_name, subfolders, filenames in os.walk(t/\\'spam\\'):\\n    folder_name = Path(folder_name)\\n    for filename in filenames:\\n        backup_zip.write(folder_name / filename, arcname=(folder_name / filename).relative_to(t))\\nbackup_zip.close()\\nout = sorted(zipfile.ZipFile(t/\\'spam_1.zip\\').namelist())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ['spam/file1.txt', 'spam/sub/f2.txt']"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\'/\\'sub\\').mkdir(parents=True)\\n(t/\\'spam\\'/\\'empty\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\n(t/\\'spam\\'/\\'sub\\'/\\'f2.txt\\').write_text(\\'x\\')\\nbackup_zip = zipfile.ZipFile(t/\\'spam_1.zip\\', \\'w\\')\\nfor folder_name, subfolders, filenames in os.walk(t/\\'spam\\'):\\n    folder_name = Path(folder_name)\\n    for filename in filenames:\\n        backup_zip.write(folder_name / filename, arcname=(folder_name / filename).relative_to(t))\\nbackup_zip.close()\\nout = sorted(zipfile.ZipFile(t/\\'spam_1.zip\\').namelist())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "['spam/file1.txt', 'spam/sub/f2.txt']" .
chx:X_WalkIntoZip rd:hasIOExample chx:IO_WalkIntoZip .
chx:X_ArchiveNames a owl:NamedIndividual, chx:ArchiveNames ; rdfs:label "backup_zip.write(path, arcname=relative_path)"@en ; skos:definition "ZipFile.write stores a file under the path it was given, less any drive letter and leading slash, so the chapter's program, which passes absolute paths, stores the folder's whole path inside the archive; passing arcname with a path relative to the folder's parent keeps the archive tidy."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_ArchiveNames a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\nwith zipfile.ZipFile(t/\\'abs.zip\\', \\'w\\') as z:\\n    z.write(t/\\'spam\\'/\\'file1.txt\\')\\nname = zipfile.ZipFile(t/\\'abs.zip\\').namelist()[0]\\nout = (name.endswith(\\'spam/file1.txt\\'), len(name) > len(\\'spam/file1.txt\\'), str(t).lstrip(\\'/\\') + \\'/spam/file1.txt\\' == name)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to (True, True, True)"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\nwith zipfile.ZipFile(t/\\'abs.zip\\', \\'w\\') as z:\\n    z.write(t/\\'spam\\'/\\'file1.txt\\')\\nname = zipfile.ZipFile(t/\\'abs.zip\\').namelist()[0]\\nout = (name.endswith(\\'spam/file1.txt\\'), len(name) > len(\\'spam/file1.txt\\'), str(t).lstrip(\\'/\\') + \\'/spam/file1.txt\\' == name)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "(True, True, True)" .
chx:X_ArchiveNames rd:hasIOExample chx:IO_ArchiveNames .
chx:X_StoredByDefault a owl:NamedIndividual, chx:StoredByDefault ; rdfs:label "backup_zip = zipfile.ZipFile(zip_filename, 'w')"@en ; skos:definition "The chapter's backup program opens the archive without a compression argument, so the default ZIP_STORED applies and the snapshot is not compressed; it is slightly larger than its files until compression=zipfile.ZIP_DEFLATED is passed."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_StoredByDefault a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\' * (n * 100))\\nsizes = []\\nfor comp in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED):\\n    with zipfile.ZipFile(t/(\\'c%d.zip\\' % comp), \\'w\\', compression=comp) as z:\\n        z.write(t/\\'spam\\'/\\'file1.txt\\', arcname=\\'file1.txt\\')\\n    sizes.append(os.path.getsize(t/(\\'c%d.zip\\' % comp)))\\nout = (sizes[0] > 5000, sizes[1] < 500)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10}) evaluates to (True, True)"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\' * (n * 100))\\nsizes = []\\nfor comp in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED):\\n    with zipfile.ZipFile(t/(\\'c%d.zip\\' % comp), \\'w\\', compression=comp) as z:\\n        z.write(t/\\'spam\\'/\\'file1.txt\\', arcname=\\'file1.txt\\')\\n    sizes.append(os.path.getsize(t/(\\'c%d.zip\\' % comp)))\\nout = (sizes[0] > 5000, sizes[1] < 500)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10})" ; chx:output "(True, True)" .
chx:X_StoredByDefault rd:hasIOExample chx:IO_StoredByDefault .
chx:X_SelfInclusion a owl:NamedIndividual, chx:SelfInclusion ; rdfs:label "os.walk(folder) while the new zip is inside folder"@en ; skos:definition "If the archive is created inside the folder being backed up, the walk lists the new archive among the files and the program writes it into itself; the program should put its archives elsewhere or skip them."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_SelfInclusion a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\nz = zipfile.ZipFile(t/\\'spam\\'/\\'spam_1.zip\\', \\'w\\')\\nadded = []\\nfor folder_name, subfolders, filenames in os.walk(t/\\'spam\\'):\\n    for filename in sorted(filenames):\\n        added.append(filename)\\n        z.write(Path(folder_name) / filename, arcname=filename)\\nz.close()\\nout = added\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ['file1.txt', 'spam_1.zip']"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'spam\\').mkdir()\\n(t/\\'spam\\'/\\'file1.txt\\').write_text(\\'Hello\\')\\nz = zipfile.ZipFile(t/\\'spam\\'/\\'spam_1.zip\\', \\'w\\')\\nadded = []\\nfor folder_name, subfolders, filenames in os.walk(t/\\'spam\\'):\\n    for filename in sorted(filenames):\\n        added.append(filename)\\n        z.write(Path(folder_name) / filename, arcname=filename)\\nz.close()\\nout = added\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "['file1.txt', 'spam_1.zip']" .
chx:X_SelfInclusion rd:hasIOExample chx:IO_SelfInclusion .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "shutil.copy() versus shutil.copytree()"@en ; skos:definition "The four practice questions ask how shutil.copy differs from shutil.copytree, which function renames files, how the delete functions of send2trash and shutil differ, and which ZipFile method matches open() on a file; the answers follow from the concepts of this chapter."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_PracticeQuestions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'f.txt\\').write_text(\\'x\\')\\n(t/\\'d\\').mkdir()\\n(t/\\'d\\'/\\'g.txt\\').write_text(\\'y\\')\\ntry:\\n    shutil.copy(t/\\'d\\', t/\\'dcopy\\')\\n    copy_on_folder = \\'copied\\'\\nexcept IsADirectoryError:\\n    copy_on_folder = \\'IsADirectoryError\\'\\nshutil.copytree(t/\\'d\\', t/\\'dtree\\')\\nout = (copy_on_folder, [p.name for p in (t/\\'dtree\\').iterdir()], zipfile.ZipFile.__name__, zipfile.ZipFile.open.__qualname__)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ('IsADirectoryError', ['g.txt'], 'ZipFile', 'ZipFile.open')"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'f.txt\\').write_text(\\'x\\')\\n(t/\\'d\\').mkdir()\\n(t/\\'d\\'/\\'g.txt\\').write_text(\\'y\\')\\ntry:\\n    shutil.copy(t/\\'d\\', t/\\'dcopy\\')\\n    copy_on_folder = \\'copied\\'\\nexcept IsADirectoryError:\\n    copy_on_folder = \\'IsADirectoryError\\'\\nshutil.copytree(t/\\'d\\', t/\\'dtree\\')\\nout = (copy_on_folder, [p.name for p in (t/\\'dtree\\').iterdir()], zipfile.ZipFile.__name__, zipfile.ZipFile.open.__qualname__)\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "('IsADirectoryError', ['g.txt'], 'ZipFile', 'ZipFile.open')" .
chx:X_PracticeQuestions rd:hasIOExample chx:IO_PracticeQuestions .
chx:X_SelectiveCopy a owl:NamedIndividual, chx:SelectiveCopy ; rdfs:label "if filename.endswith('.pdf'): shutil.copy(...)"@en ; skos:definition "The first practice program walks a tree and copies the files with one extension into a new folder; the extension test is best done on the lower-cased suffix, and the destination must not be inside the tree being walked."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_SelectiveCopy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nfor d in (\\'src/a\\', \\'src/b\\'):\\n    (t/d).mkdir(parents=True)\\nfor f in (\\'src/one.pdf\\', \\'src/a/two.PDF\\', \\'src/b/three.txt\\', \\'src/b/four.pdf\\'):\\n    (t/f).write_text(f)\\n(t/\\'dest\\').mkdir()\\nfor folder_name, subfolders, filenames in os.walk(t/\\'src\\'):\\n    for filename in filenames:\\n        if filename.lower().endswith(\\'.pdf\\'):\\n            shutil.copy(Path(folder_name) / filename, t/\\'dest\\')\\nout = sorted(p.name for p in (t/\\'dest\\').iterdir())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ['four.pdf', 'one.pdf', 'two.PDF']"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nfor d in (\\'src/a\\', \\'src/b\\'):\\n    (t/d).mkdir(parents=True)\\nfor f in (\\'src/one.pdf\\', \\'src/a/two.PDF\\', \\'src/b/three.txt\\', \\'src/b/four.pdf\\'):\\n    (t/f).write_text(f)\\n(t/\\'dest\\').mkdir()\\nfor folder_name, subfolders, filenames in os.walk(t/\\'src\\'):\\n    for filename in filenames:\\n        if filename.lower().endswith(\\'.pdf\\'):\\n            shutil.copy(Path(folder_name) / filename, t/\\'dest\\')\\nout = sorted(p.name for p in (t/\\'dest\\').iterdir())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "['four.pdf', 'one.pdf', 'two.PDF']" .
chx:X_SelectiveCopy rd:hasIOExample chx:IO_SelectiveCopy .
chx:X_LargeFiles a owl:NamedIndividual, chx:LargeFiles ; rdfs:label "os.path.getsize(path)"@en ; skos:definition "The second practice program walks a tree and prints the files whose size from os.path.getsize exceeds a limit; the chapter's limit is 100MB, and the same code is shown here with a limit of 1000 bytes on small test files."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_LargeFiles a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'d\\').mkdir()\\n(t/\\'d\\'/\\'big.bin\\').write_bytes(b\\'x\\' * 2000)\\n(t/\\'d\\'/\\'small.bin\\').write_bytes(b\\'x\\' * 10)\\n(t/\\'big2.bin\\').write_bytes(b\\'x\\' * 1001)\\nlimit = n * 100\\nout = sorted((Path(f).name, os.path.getsize(f)) for folder_name, subfolders, filenames in os.walk(t) for f in (os.path.join(folder_name, n) for n in filenames) if os.path.getsize(f) > limit)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10}) evaluates to [('big.bin', 2000), ('big2.bin', 1001)]"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\n(t/\\'d\\').mkdir()\\n(t/\\'d\\'/\\'big.bin\\').write_bytes(b\\'x\\' * 2000)\\n(t/\\'d\\'/\\'small.bin\\').write_bytes(b\\'x\\' * 10)\\n(t/\\'big2.bin\\').write_bytes(b\\'x\\' * 1001)\\nlimit = n * 100\\nout = sorted((Path(f).name, os.path.getsize(f)) for folder_name, subfolders, filenames in os.walk(t) for f in (os.path.join(folder_name, n) for n in filenames) if os.path.getsize(f) > limit)\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 10})" ; chx:output "[('big.bin', 2000), ('big2.bin', 1001)]" .
chx:X_LargeFiles rd:hasIOExample chx:IO_LargeFiles .
chx:X_RenumberFiles a owl:NamedIndividual, chx:RenumberFiles ; rdfs:label "zfill and shutil.move"@en ; skos:definition "The third practice program finds the numbered files of a prefix, locates gaps in the numbers and renames the later files down to close them; str.zfill pads a number with zeros to the width of the names."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_RenumberFiles a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nfor i in (1, 2, 4, 5, n):\\n    (t/(\\'spam%s.txt\\' % str(i).zfill(3))).write_text(\\'\\')\\nfiles = sorted(p for p in t.iterdir() if p.name.startswith(\\'spam\\'))\\nfor new_number, p in enumerate(files, start=1):\\n    new_name = \\'spam%s.txt\\' % str(new_number).zfill(3)\\n    if p.name != new_name:\\n        shutil.move(p, p.with_name(new_name))\\nout = sorted(p.name for p in t.iterdir())\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 8}) evaluates to ['spam001.txt', 'spam002.txt', 'spam003.txt', 'spam004.txt', 'spam005.txt']"@en ; chx:input "(lambda g: exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nfor i in (1, 2, 4, 5, n):\\n    (t/(\\'spam%s.txt\\' % str(i).zfill(3))).write_text(\\'\\')\\nfiles = sorted(p for p in t.iterdir() if p.name.startswith(\\'spam\\'))\\nfor new_number, p in enumerate(files, start=1):\\n    new_name = \\'spam%s.txt\\' % str(new_number).zfill(3)\\n    if p.name != new_name:\\n        shutil.move(p, p.with_name(new_name))\\nout = sorted(p.name for p in t.iterdir())\\nshutil.rmtree(t)\\n', g) or g['out'])({'n': 8})" ; chx:output "['spam001.txt', 'spam002.txt', 'spam003.txt', 'spam004.txt', 'spam005.txt']" .
chx:X_RenumberFiles rd:hasIOExample chx:IO_RenumberFiles .
chx:X_DateRenaming a owl:NamedIndividual, chx:DateRenaming ; rdfs:label "re.sub(r'(\\d\\d)-(\\d\\d)-(\\d\\d\\d\\d)', r'\\2-\\1-\\3', name)"@en ; skos:definition "The fourth practice program finds file names with an American date MM-DD-YYYY and renames them to the European DD-MM-YYYY by swapping the first two groups of a regular expression, using shutil.move to rename; a name without a date is left alone."@en ; dcterms:source <http://example.org/sen0414/ch11/research> .
chx:IO_DateRenaming a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nimport re\\nfor n in (\\'spam12-31-1900.txt\\', \\'report01-02-2020.txt\\', \\'notes.txt\\'):\\n    (t/n).write_text(\\'\\')\\npattern = re.compile(r\\'(\\\\d\\\\d)-(\\\\d\\\\d)-(\\\\d\\\\d\\\\d\\\\d)\\')\\nfor folder_name, subfolders, filenames in os.walk(t):\\n    for filename in filenames:\\n        if pattern.search(filename):\\n            shutil.move(Path(folder_name) / filename, Path(folder_name) / pattern.sub(r\\'\\\\2-\\\\1-\\\\3\\', filename))\\nout = sorted(p.name for p in t.iterdir())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({}) evaluates to ['notes.txt', 'report02-01-2020.txt', 'spam31-12-1900.txt']"@en ; chx:input "(lambda g: (exec('import os, shutil, tempfile, zipfile, io\\nfrom pathlib import Path\\nt = Path(tempfile.mkdtemp())\\nimport re\\nfor n in (\\'spam12-31-1900.txt\\', \\'report01-02-2020.txt\\', \\'notes.txt\\'):\\n    (t/n).write_text(\\'\\')\\npattern = re.compile(r\\'(\\\\d\\\\d)-(\\\\d\\\\d)-(\\\\d\\\\d\\\\d\\\\d)\\')\\nfor folder_name, subfolders, filenames in os.walk(t):\\n    for filename in filenames:\\n        if pattern.search(filename):\\n            shutil.move(Path(folder_name) / filename, Path(folder_name) / pattern.sub(r\\'\\\\2-\\\\1-\\\\3\\', filename))\\nout = sorted(p.name for p in t.iterdir())\\nshutil.rmtree(t)\\n', g), g['out'])[1])({})" ; chx:output "['notes.txt', 'report02-01-2020.txt', 'spam31-12-1900.txt']" .
chx:X_DateRenaming rd:hasIOExample chx:IO_DateRenaming .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 11 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch11/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 11 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which file operations of the chapter change the disk for good, which can be undone, and how can a program show what it will do before it does it?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, statements and programs of the chapter differ in current Python, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 11 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 11 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch11/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-01."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

