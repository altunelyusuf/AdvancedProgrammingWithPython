pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Copy, move and rename files and folders with shutil, and predict what each call returns and what it does when the destination already exists"@en ;
    skos:definition "The objective is met when the reader can copy, move and rename files and folders with shutil, and predict what each call returns and what it does when the destination already exists, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter11.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Delete files and folders permanently with os and shutil, use a dry run to check a program before it deletes, and explain what a recycle-bin module adds"@en ;
    skos:definition "The objective is met when the reader can delete files and folders permanently with os and shutil, use a dry run to check a program before it deletes, and explain what a recycle-bin module adds, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter11.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Walk a folder tree with os.walk and pathlib and act on every file, including pruning folders and choosing the walking order"@en ;
    skos:definition "The objective is met when the reader can walk a folder tree with os.walk and pathlib and act on every file, including pruning folders and choosing the walking order, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter11.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Create, read, append to and extract from ZIP archives with zipfile, and choose the compression method and the mode"@en ;
    skos:definition "The objective is met when the reader can create, read, append to and extract from ZIP archives with zipfile, and choose the compression method and the mode, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter11.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Analyze a backup program for what it stores, whether it compresses, where its archive lands and how it fails, and extract archives safely"@en ;
    skos:definition "The objective is met when the reader can analyze a backup program for what it stores, whether it compresses, where its archive lands and how it fails, and extract archives safely, at the analyze level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter11.html> ;
    ld:bloomLevel ld:Analyze  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "The folder dest already holds a file named file1.txt. Under Python 3.14, what does shutil.move('file1.txt', 'dest') do with another file1.txt in the current folder?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "The chapter says so, but the documentation says the destination path in the folder must not already exist, and 3.14.4 raised an error." ;
    ld:distractorRationale "shutil.move never invents a new name." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "It silently overwrites dest/file1.txt" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "It raises shutil.Error and moves nothing" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "It renames the moved file file1(1).txt" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What is the difference between shutil.copy() and shutil.copytree()?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Neither function deletes the original; shutil.move does that." ;
    ld:distractorRationale "copytree copies the files too." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "copy copies one file; copytree copies a whole folder with its subfolders to a destination that must not exist" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "copy keeps the original; copytree deletes it afterwards" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "copytree copies only the folders and leaves the files" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "shutil.copytree('src', 'dst') is run twice with no other arguments. What does the second call do?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Only dirs_exist_ok=True lets it continue into an existing folder." ;
    ld:distractorRationale "copytree never invents a new name." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "It overwrites dst" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "It raises FileExistsError" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "It creates dst_2" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does os.rmdir() do to a folder that still contains a file?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "That is shutil.rmtree; os.rmdir needs an empty folder." ;
    ld:distractorRationale "os.rmdir never uses a recycle bin; the send2trash module does." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "It deletes the folder and the file" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "It raises OSError and deletes nothing" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "It moves the file to the recycle bin" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A folder holds only a.txt and b.txt. The dry run for a program with the typo Path.home().glob('*.rxt') prints a line for each match. What is printed?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "That would be the output for the pattern *.txt." ;
    ld:distractorRationale "glob accepts any pattern and simply matches nothing." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "Deleting a.txt and Deleting b.txt" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "Nothing, because no file matches *.rxt" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "An error, because .rxt is not a file type" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "According to the chapter, what does send2trash.send2trash() give you that shutil.rmtree() does not?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "It frees no disk space until the bin is emptied." ;
    ld:distractorRationale "The chapter says nothing of the kind." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "The file can be restored from the recycle bin, but no disk space is freed" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "The file is deleted faster and frees more space" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "The file is overwritten with zeros first" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "In for a, b, c in os.walk('spam'), which variable holds the names of the files in the current folder?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "a is the path of the current folder as a string." ;
    ld:distractorRationale "b is the list of subfolder names." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "a" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "b" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "c" .
pg:Q8 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "You want os.walk to skip a subfolder called skip. What works in a top-down walk?"@en ; ld:hasOption pg:Q8_O0, pg:Q8_O1, pg:Q8_O2 ; ld:hasCorrectOption pg:Q8_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "os.walk has no skip parameter." ;
    ld:distractorRationale "Changing the list after the loop body does not stop the walk from entering folders it already listed; the list must be changed in place while the walk is waiting." .
pg:Q8_O0 a ld:AnswerOption ; rdfs:label "Call subfolders.remove('skip') inside the loop" .
pg:Q8_O1 a ld:AnswerOption ; rdfs:label "Write os.walk(top, skip='skip')" .
pg:Q8_O2 a ld:AnswerOption ; rdfs:label "Assign subfolders = [] after the loop" .
pg:Q9 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "backup_zip = zipfile.ZipFile('a.zip', 'w') and backup_zip.write('f.txt') are run with no compress_type. How is f.txt stored?"@en ; ld:hasOption pg:Q9_O0, pg:Q9_O1, pg:Q9_O2 ; ld:hasCorrectOption pg:Q9_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "Deflate is used only when compress_type=zipfile.ZIP_DEFLATED is passed." ;
    ld:distractorRationale "Nothing is nested." .
pg:Q9_O0 a ld:AnswerOption ; rdfs:label "Compressed with deflate" .
pg:Q9_O1 a ld:AnswerOption ; rdfs:label "Stored at its regular size, uncompressed" .
pg:Q9_O2 a ld:AnswerOption ; rdfs:label "Stored as a second ZIP file" .
pg:Q10 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "a.zip holds one.txt. A program opens it with zipfile.ZipFile('a.zip', 'a'), writes two.txt and closes it. What does namelist() return?"@en ; ld:hasOption pg:Q10_O0, pg:Q10_O1, pg:Q10_O2 ; ld:hasCorrectOption pg:Q10_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "That is what mode 'w' would leave, because it erases the archive first." ;
    ld:distractorRationale "Mode 'x' raises FileExistsError for an existing file; mode 'a' adds." .
pg:Q10_O0 a ld:AnswerOption ; rdfs:label "['two.txt']" .
pg:Q10_O1 a ld:AnswerOption ; rdfs:label "['one.txt', 'two.txt']" .
pg:Q10_O2 a ld:AnswerOption ; rdfs:label "FileExistsError is raised" .
pg:Q11 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Project 5 calls backup_zip.write(folder_name / filename) where folder_name is /home/al/spam. What member name is stored for /home/al/spam/file1.txt?"@en ; ld:hasOption pg:Q11_O0, pg:Q11_O1, pg:Q11_O2 ; ld:hasCorrectOption pg:Q11_O2 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "The name is kept whole unless arcname is given." ;
    ld:distractorRationale "Only arcname can shorten it to a path relative to the folder's parent." .
pg:Q11_O0 a ld:AnswerOption ; rdfs:label "file1.txt" .
pg:Q11_O1 a ld:AnswerOption ; rdfs:label "spam/file1.txt" .
pg:Q11_O2 a ld:AnswerOption ; rdfs:label "home/al/spam/file1.txt" .
pg:Q12 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "backup_to_zip(Path('.')) is called. Why does Project 5 fail?"@en ; ld:hasOption pg:Q12_O0, pg:Q12_O1, pg:Q12_O2 ; ld:hasCorrectOption pg:Q12_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "os.walk walks the current folder without trouble." ;
    ld:distractorRationale "The archive can be created there; the failure comes earlier, when the name is made." .
pg:Q12_O0 a ld:AnswerOption ; rdfs:label "Path('.').parts is an empty tuple, so folder.parts[-1] raises IndexError" .
pg:Q12_O1 a ld:AnswerOption ; rdfs:label "os.walk cannot walk the current folder" .
pg:Q12_O2 a ld:AnswerOption ; rdfs:label "A ZIP file cannot be created in the current folder" .
pg:CopyingAndMoving a ipo:ChapterSection ; rdfs:label "Copying and moving"@en ;
    skos:definition "Copying, moving and renaming files and folders with the shutil module is the first subject of chapter 11, and every one of its functions takes a source and a destination and leaves the destination holding the content, by one path or another (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_CopyingAndMoving> ;
    sen0414:anchor "#s-CopyingAndMoving" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:CopyingAndMoving .
pg:Copying a ipo:ChapterSection ; rdfs:label "Copying"@en ;
    skos:definition "Two functions copy: shutil.copy for one file and shutil.copytree for a folder with everything in it, and both return the path they wrote to rather than nothing at all (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_Copying> ;
    sen0414:anchor "#s-Copying" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:CopyingAndMoving .
pg:Page ipo:coversChapterSection pg:Copying .
pg:CopyFile a ipo:ChapterSection ; rdfs:label "Copy file"@en ;
    skos:definition "shutil.copy(source, destination) copies a file to a folder, which keeps the name, or to a file name, which becomes the copy's name (Sweigart, 2025); run under Python 3.14.6, copying a.txt into a folder named box and separately to b.txt inside that folder left a.txt, b.txt and the untouched source all in place, and the documentation adds that an existing destination file is replaced and that permission bits travel with the copy while other metadata does not (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_CopyFile> ;
    sen0414:anchor "#s-CopyFile" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Copying .
pg:Page ipo:coversChapterSection pg:CopyFile .
pg:CopyFolderTree a ipo:ChapterSection ; rdfs:label "Copy folder tree"@en ;
    skos:definition "shutil.copytree(h / 'spam', h / 'spam_backup') makes a backup folder with the same content and returns its path (Sweigart, 2025); run under 3.14.6 it returned a PosixPath holding file1.txt and eggs/file2.txt, and a second call against the same destination raised FileExistsError, because the destination folder must not exist yet (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_CopyFolderTree> ;
    sen0414:anchor "#s-CopyFolderTree" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Copying .
pg:Page ipo:coversChapterSection pg:CopyFolderTree .
pg:CopyWithMetadata a ipo:ChapterSection ; rdfs:label "Copy with metadata"@en ;
    skos:definition "shutil.copy2 is not in the chapter; it copies as shutil.copy does and also tries to keep metadata such as the modification time (Sweigart, 2025); a file whose modification time was set to 1000000000 with os.utime kept that exact time in a copy2 copy and did not in a copy made by shutil.copy, and copytree copies every one of its files with copy2 rather than copy (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_CopyWithMetadata> ;
    sen0414:anchor "#s-CopyWithMetadata" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Copying .
pg:Page ipo:coversChapterSection pg:CopyWithMetadata .
pg:ExistingDestination a ipo:ChapterSection ; rdfs:label "Existing destination"@en ;
    skos:definition "The chapter's own copytree needs a destination that does not exist (Sweigart, 2025); since Python 3.8 dirs_exist_ok=True lets it continue into an existing folder instead, where a file of the same name already there is overwritten and every other file is left alone, so a destination folder whose a.txt read 'old' and whose keep.txt read 'kept' ended the call holding a.txt changed to 'new' and keep.txt untouched (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ExistingDestination> ;
    sen0414:anchor "#s-ExistingDestination" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Copying .
pg:Page ipo:coversChapterSection pg:ExistingDestination .
pg:Moving a ipo:ChapterSection ; rdfs:label "Moving"@en ;
    skos:definition "shutil.move moves and renames, and the chapter treats the two as one operation, decided entirely by what the destination argument turns out to be (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_Moving> ;
    sen0414:anchor "#s-Moving" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:CopyingAndMoving .
pg:Page ipo:coversChapterSection pg:Moving .
pg:MoveFileOrFolder a ipo:ChapterSection ; rdfs:label "Move file or folder"@en ;
    skos:definition "shutil.move(h / 'spam/file1.txt', h / 'spam2') moves the file into the folder and keeps its name (Sweigart, 2025); the chapter says the call returns a string, and run under 3.14.6 it returned a str when the destination was an existing folder and a PosixPath when the destination was a new file name instead, exactly the same split copy file's own shutil.copy makes, and across file systems the function copies first and then deletes the source (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_MoveFileOrFolder> ;
    sen0414:anchor "#s-MoveFileOrFolder" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Moving .
pg:Page ipo:coversChapterSection pg:MoveFileOrFolder .
pg:MoveAsRename a ipo:ChapterSection ; rdfs:label "Move as rename"@en ;
    skos:definition "When the destination is not an existing folder, shutil.move(h / 'spam/file1.txt', h / 'spam2/new_name.txt') moves and renames in one step (Sweigart, 2025); inside one folder it is a plain rename, and run under 3.14.6 it returned a PosixPath and left only new_name.txt in the folder, the old name gone (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_MoveAsRename> ;
    sen0414:anchor "#s-MoveAsRename" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Moving .
pg:Page ipo:coversChapterSection pg:MoveAsRename .
pg:MoveCollision a ipo:ChapterSection ; rdfs:label "Move collision"@en ;
    skos:definition "The chapter says that a file1.txt already in the destination folder would be overwritten (Sweigart, 2025); under Python 3.14.6 shutil.move of file1.txt into a folder that already held a file1.txt raised shutil.Error with a message naming the existing destination path, the old file kept its own content, 'old', and the source file was left exactly where it started, which matches the documentation's own statement that the destination path inside the folder must not already exist, while a move onto an existing path that is not a folder did replace that file on this system (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_MoveCollision> ;
    sen0414:anchor "#s-MoveCollision" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Moving .
pg:Page ipo:coversChapterSection pg:MoveCollision .
pg:PathlibCopyMove a ipo:ChapterSection ; rdfs:label "Pathlib copy move"@en ;
    skos:definition "The chapter uses shutil for every copy and every move (Sweigart, 2025); Python 3.14 added Path.copy, Path.copy_into, Path.move and Path.move_into directly on the path object, and run under 3.14.6 copy returned a Path and left the original file in place, move left the old name missing entirely, and copy_into and move_into each placed the file into an existing folder under its own unchanged name (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_PathlibCopyMove> ;
    sen0414:anchor "#s-PathlibCopyMove" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Moving .
pg:Page ipo:coversChapterSection pg:PathlibCopyMove .
pg:Deleting a ipo:ChapterSection ; rdfs:label "Deleting"@en ;
    skos:definition "Deleting is where the chapter warns the most, because every one of its own three functions removes something for good, and its answer to that risk is the dry run and the recycle bin, not a safer delete function (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_Deleting> ;
    sen0414:anchor "#s-Deleting" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Deleting .
pg:PermanentDeletion a ipo:ChapterSection ; rdfs:label "Permanent deletion"@en ;
    skos:definition "os.unlink, os.rmdir and shutil.rmtree delete for good, and the three differ only in how much they are willing to remove in one call (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_PermanentDeletion> ;
    sen0414:anchor "#s-PermanentDeletion" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Deleting .
pg:Page ipo:coversChapterSection pg:PermanentDeletion .
pg:DeleteFile a ipo:ChapterSection ; rdfs:label "Delete file"@en ;
    skos:definition "os.unlink(path) deletes a single file permanently (Sweigart, 2025); run under 3.14.6 it removed a file and a second call on the same now-missing path raised FileNotFoundError, and on this Linux system the same call aimed at a folder instead raised IsADirectoryError (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_DeleteFile> ;
    sen0414:anchor "#s-DeleteFile" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PermanentDeletion .
pg:Page ipo:coversChapterSection pg:DeleteFile .
pg:DeleteEmptyFolder a ipo:ChapterSection ; rdfs:label "Delete empty folder"@en ;
    skos:definition "os.rmdir(path) deletes a folder, and only if it is empty (Sweigart, 2025); run under 3.14.6 a folder that still held one file raised OSError, errno 39 on this system, and the identical call succeeded once that file was removed with os.unlink first (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_DeleteEmptyFolder> ;
    sen0414:anchor "#s-DeleteEmptyFolder" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PermanentDeletion .
pg:Page ipo:coversChapterSection pg:DeleteEmptyFolder .
pg:DeleteFolderTree a ipo:ChapterSection ; rdfs:label "Delete folder tree"@en ;
    skos:definition "shutil.rmtree(path) deletes a folder with all its files and subfolders in one call (Sweigart, 2025); run under 3.14.6 it removed a tree holding one nested file, raised FileNotFoundError for a path no longer there, and raised nothing at all with ignore_errors=True, and the documentation states that, where the platform allows it, a version resistant to symlink attacks is used, which rmtree.avoids_symlink_attacks confirmed as True on this machine (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_DeleteFolderTree> ;
    sen0414:anchor "#s-DeleteFolderTree" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PermanentDeletion .
pg:Page ipo:coversChapterSection pg:DeleteFolderTree .
pg:DeletionErrors a ipo:ChapterSection ; rdfs:label "Deletion errors"@en ;
    skos:definition "The chapter gives rmtree no error handler at all (Sweigart, 2025); since Python 3.12 the onexc parameter names a function that receives the failing function, the path and the exception itself, replacing the deprecated onerror, whose own third argument was instead the tuple sys.exc_info() returns, and a handler run on a missing folder here received that folder's own name together with FileNotFoundError (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_DeletionErrors> ;
    sen0414:anchor "#s-DeletionErrors" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PermanentDeletion .
pg:Page ipo:coversChapterSection pg:DeletionErrors .
pg:SaferDeletion a ipo:ChapterSection ; rdfs:label "Safer deletion"@en ;
    skos:definition "The chapter offers two protections against a bug that quietly deletes the wrong files: a dry run and the recycle bin (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_SaferDeletion> ;
    sen0414:anchor "#s-SaferDeletion" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Deleting .
pg:Page ipo:coversChapterSection pg:SaferDeletion .
pg:DryRun a ipo:ChapterSection ; rdfs:label "Dry run"@en ;
    skos:definition "The chapter's own program, with the typo glob('*.rxt') in place of '*.txt', would delete the wrong files, and a version with the delete commented out and a print added in its place shows exactly this before any harm is done (Sweigart, 2025); run against a folder holding a.txt and b.txt, the *.rxt pattern matched zero files and printed nothing, where the pattern *.txt would have printed both names, which is precisely how the dry run exposes a typo nobody would otherwise notice until the files were already gone (Python Software Foundation, 2026); the chapter advises the identical dry run before a copy, a rename or a move as well, not only before a delete."@en ; dcterms:source <http://example.org/sen0414/ch11#S_DryRun> ;
    sen0414:anchor "#s-DryRun" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SaferDeletion .
pg:Page ipo:coversChapterSection pg:DryRun .
pg:RecycleBin a ipo:ChapterSection ; rdfs:label "Recycle bin"@en ;
    skos:definition "The third-party send2trash module moves a file or folder to the recycle bin or trash instead of deleting it, so it can be restored, but it frees no disk space and cannot take anything back out of the bin on its own (Sweigart, 2025); send2trash is not installed on this machine, Python's own importlib found no such module here, so nothing about it was executed, unlike every other concept of this chapter (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_RecycleBin> ;
    sen0414:anchor "#s-RecycleBin" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SaferDeletion .
pg:Page ipo:coversChapterSection pg:RecycleBin .
pg:FolderTrees a ipo:ChapterSection ; rdfs:label "Folder trees"@en ;
    skos:definition "Listing one folder and walking a whole tree of folders are the two ways the chapter reaches the files it then acts on, and every function of the earlier two branches needs one of these two to find its targets in the first place (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_FolderTrees> ;
    sen0414:anchor "#s-FolderTrees" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:FolderTrees .
pg:Listing a ipo:ChapterSection ; rdfs:label "Listing"@en ;
    skos:definition "os.listdir and Path.iterdir list one folder and do not enter its subfolders at all (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_Listing> ;
    sen0414:anchor "#s-Listing" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:FolderTrees .
pg:Page ipo:coversChapterSection pg:Listing .
pg:ListDirectory a ipo:ChapterSection ; rdfs:label "List directory"@en ;
    skos:definition "os.listdir(path) returns a list of the names inside one folder (Sweigart, 2025); for a spam folder holding eggs, eggs2 and file1.txt, sorting the result gave exactly ['eggs', 'eggs2', 'file1.txt'], and the documentation promises no particular order on its own (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ListDirectory> ;
    sen0414:anchor "#s-ListDirectory" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Listing .
pg:Page ipo:coversChapterSection pg:ListDirectory .
pg:IterateDirectory a ipo:ChapterSection ; rdfs:label "Iterate directory"@en ;
    skos:definition "Path.iterdir() gives a Path object for every entry of one folder (Sweigart, 2025); for a spam folder holding eggs, a subfolder, and file1.txt, a file, sorting the pairs of name and is_dir() gave [('eggs', True), ('file1.txt', False)] (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_IterateDirectory> ;
    sen0414:anchor "#s-IterateDirectory" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Listing .
pg:Page ipo:coversChapterSection pg:IterateDirectory .
pg:GlobPattern a ipo:ChapterSection ; rdfs:label "Glob pattern"@en ;
    skos:definition "The chapter finds files with Path.glob('*.rxt') inside its own deletion example (Sweigart, 2025); glob searches one folder alone and rglob the whole tree of subfolders beneath it as well, so against a.txt, b.pdf and a subfolder's own c.txt, the pattern '*.txt' found only a.txt with glob and both a.txt and c.txt with rglob (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_GlobPattern> ;
    sen0414:anchor "#s-GlobPattern" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Listing .
pg:Page ipo:coversChapterSection pg:GlobPattern .
pg:Walking a ipo:ChapterSection ; rdfs:label "Walking"@en ;
    skos:definition "os.walk is the chapter's own tool for doing something to every file in a folder and every folder beneath it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_Walking> ;
    sen0414:anchor "#s-Walking" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:FolderTrees .
pg:Page ipo:coversChapterSection pg:Walking .
pg:WalkTree a ipo:ChapterSection ; rdfs:label "Walk tree"@en ;
    skos:definition "for folder_name, subfolders, filenames in os.walk(top) hands back, on every pass, the current folder's name as a string, a list of its own subfolder names and a list of its own file names (Sweigart, 2025); for a tree built as spam holding eggs, eggs2 and file1.txt, with eggs holding bacon and file2.txt and bacon holding file4.txt, the sorted passes were spam with eggs and eggs2 and file1.txt, spam/eggs with bacon and file2.txt, spam/eggs/bacon with file4.txt and spam/eggs2 with nothing at all (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_WalkTree> ;
    sen0414:anchor "#s-WalkTree" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Walking .
pg:Page ipo:coversChapterSection pg:WalkTree .
pg:WalkOrder a ipo:ChapterSection ; rdfs:label "Walk order"@en ;
    skos:definition "The chapter shows one order of output and leaves the rule behind it unstated (Sweigart, 2025); the documentation says that the order of names inside one folder depends on the file system itself, that a folder is given before its own subfolders by default, and that topdown=False reverses that, which a test on a folder a holding a subfolder b gave as ['.', 'a', 'a/b'] top-down and ['a/b', 'a', '.'] bottom-up; bottom-up is the exact order in which os.rmdir could empty a whole tree by hand, as the documentation's own rmtree example notes (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_WalkOrder> ;
    sen0414:anchor "#s-WalkOrder" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Walking .
pg:Page ipo:coversChapterSection pg:WalkOrder .
pg:PruneWalk a ipo:ChapterSection ; rdfs:label "Prune walk"@en ;
    skos:definition "The chapter's own program does not prune a walk at all (Sweigart, 2025); walking top-down, the loop can remove a name from the subfolder list in place, with remove or del, and os.walk then skips that folder entirely on its very next pass, so against three folders named keep, skip and keep's own subfolder inner, the visited folders were only ['.', 'keep', 'keep/inner'], and skip was never entered at all (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_PruneWalk> ;
    sen0414:anchor "#s-PruneWalk" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Walking .
pg:Page ipo:coversChapterSection pg:PruneWalk .
pg:WalkAndRename a ipo:ChapterSection ; rdfs:label "Walk and rename"@en ;
    skos:definition "The chapter's own program renames every file to upper case while it is still walking over them (Sweigart, 2025); run under 3.14.6 against a tree of spam holding file1.txt and eggs holding file2.txt, it renamed both to FILE1.TXT and FILE2.TXT while os.walk was still running, and the documentation itself says that adding or removing a file during a walk leaves it unspecified whether that one name is still listed (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_WalkAndRename> ;
    sen0414:anchor "#s-WalkAndRename" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Walking .
pg:Page ipo:coversChapterSection pg:WalkAndRename .
pg:PathWalk a ipo:ChapterSection ; rdfs:label "Path walk"@en ;
    skos:definition "Path.walk is not in the chapter at all; added in Python 3.12, it gives the current folder as a Path object and the subfolder and file names as strings, where os.walk's own first value is a plain string instead (Python Software Foundation, 2026); run under 3.14.6 against a spam folder holding a nested eggs folder and one file, the first value was a str from os.walk and a PosixPath from Path.walk for the identical folder (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_PathWalk> ;
    sen0414:anchor "#s-PathWalk" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Walking .
pg:Page ipo:coversChapterSection pg:PathWalk .
pg:ZipArchives a ipo:ChapterSection ; rdfs:label "Zip archives"@en ;
    skos:definition "The zipfile module creates, reads and extracts ZIP archives, and every one of its own operations is reached through a single ZipFile object opened in one of several modes (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ZipArchives> ;
    sen0414:anchor "#s-ZipArchives" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:ZipArchives .
pg:WritingZip a ipo:ChapterSection ; rdfs:label "Writing zip"@en ;
    skos:definition "Writing an archive means opening a ZipFile in a mode and writing files into it, one at a time (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_WritingZip> ;
    sen0414:anchor "#s-WritingZip" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ZipArchives .
pg:Page ipo:coversChapterSection pg:WritingZip .
pg:CreateZip a ipo:ChapterSection ; rdfs:label "Create zip"@en ;
    skos:definition "zipfile.ZipFile('example.zip', 'w') creates the archive, erasing one that already exists, and write() adds a file from the disk under its own path (Sweigart, 2025); the chapter's own file1.txt, holding 'Hello' repeated ten thousand times, fifty thousand characters, produced an archive whose own is_zipfile() check passed True and whose namelist() held exactly ['file1.txt'] (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_CreateZip> ;
    sen0414:anchor "#s-CreateZip" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WritingZip .
pg:Page ipo:coversChapterSection pg:CreateZip .
pg:CompressionMethod a ipo:ChapterSection ; rdfs:label "Compression method"@en ;
    skos:definition "write() compresses only when compress_type=zipfile.ZIP_DEFLATED is passed; without it the file is stored at its own regular size (Sweigart, 2025); run under 3.14.6, ZIP_STORED is the integer 0 and ZIP_DEFLATED is 8, a member of fifty thousand bytes stayed fifty thousand bytes stored and shrank once deflated, and the standard library also offers ZIP_BZIP2 (12), ZIP_LZMA (14) and, new in Python 3.14, ZIP_ZSTANDARD (93) (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_CompressionMethod> ;
    sen0414:anchor "#s-CompressionMethod" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WritingZip .
pg:Page ipo:coversChapterSection pg:CompressionMethod .
pg:CompressionLevel a ipo:ChapterSection ; rdfs:label "Compression level"@en ;
    skos:definition "compresslevel is a value from 0 to 9, added in Python 3.7, and the chapter says 9 is the slowest and most compressed level and that the default is 6 (Sweigart, 2025); on the chapter's own repeated text, the compressed sizes under 3.14.6 were 50010 bytes at level 0, 293 at level 1, 97 at level 6 and 97 at level 9, which matches the documentation's own statement that the default level of zlib, which deflate uses, currently is level 6 (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_CompressionLevel> ;
    sen0414:anchor "#s-CompressionLevel" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WritingZip .
pg:Page ipo:coversChapterSection pg:CompressionLevel .
pg:AppendToZip a ipo:ChapterSection ; rdfs:label "Append to zip"@en ;
    skos:definition "Mode 'a' adds to an existing archive and mode 'w' erases it first (Sweigart, 2025); run under 3.14.6, after mode 'a' an archive held both one.txt and two.txt, mode 'x' on that same existing file raised FileExistsError, and mode 'w' afterward left only the newest member in an archive that had held two (Python Software Foundation, 2026); the exclusive mode 'x' is not in the chapter's own prose at all."@en ; dcterms:source <http://example.org/sen0414/ch11#S_AppendToZip> ;
    sen0414:anchor "#s-AppendToZip" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WritingZip .
pg:Page ipo:coversChapterSection pg:AppendToZip .
pg:ReadingZip a ipo:ChapterSection ; rdfs:label "Reading zip"@en ;
    skos:definition "Reading an archive starts with a ZipFile object opened on its own file name, not on a mode for writing at all (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ReadingZip> ;
    sen0414:anchor "#s-ReadingZip" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ZipArchives .
pg:Page ipo:coversChapterSection pg:ReadingZip .
pg:NameList a ipo:ChapterSection ; rdfs:label "Name list"@en ;
    skos:definition "zipfile.ZipFile('example.zip') opens the archive and namelist() returns its own member names (Sweigart, 2025); for the chapter's own archive it gave ['file1.txt'], and a folder entry appears in that same list with a closing slash, as in 'emptydir/' made by ZipFile.mkdir(), added in Python 3.11 (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_NameList> ;
    sen0414:anchor "#s-NameList" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReadingZip .
pg:Page ipo:coversChapterSection pg:NameList .
pg:ZipInfoSizes a ipo:ChapterSection ; rdfs:label "Zip info sizes"@en ;
    skos:definition "getinfo('file1.txt') returns a ZipInfo whose file_size and compress_size hold the member's own original and compressed size (Sweigart, 2025); run under 3.14.6 they were 50000 and 97 for the chapter's own file at compression level 9 (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ZipInfoSizes> ;
    sen0414:anchor "#s-ZipInfoSizes" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReadingZip .
pg:Page ipo:coversChapterSection pg:ZipInfoSizes .
pg:CompressionRatio a ipo:ChapterSection ; rdfs:label "Compression ratio"@en ;
    skos:definition "The chapter divides the two sizes and prints 'Compressed file is 515.46x smaller!' (Sweigart, 2025); that exact output reproduced under 3.14.6 for the identical fifty thousand bytes stored in ninety-seven, but the chapter's own prose separately puts the compressed size at about 213 bytes, a number that neither compresslevel 9 nor the default level 6 actually gave, both 97 bytes, so the prose and the chapter's own printed listing disagree with each other, and only the listing's own number, 97, reproduces (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_CompressionRatio> ;
    sen0414:anchor "#s-CompressionRatio" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReadingZip .
pg:Page ipo:coversChapterSection pg:CompressionRatio .
pg:ExtractingZip a ipo:ChapterSection ; rdfs:label "Extracting zip"@en ;
    skos:definition "extractall and extract both take files back out of an archive, the first all at once and the second one member at a time (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ExtractingZip> ;
    sen0414:anchor "#s-ExtractingZip" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ZipArchives .
pg:Page ipo:coversChapterSection pg:ExtractingZip .
pg:ExtractAll a ipo:ChapterSection ; rdfs:label "Extract all"@en ;
    skos:definition "extractall() extracts everything into the current folder, or into a named folder that is created when missing (Sweigart, 2025); run under 3.14.6, extracting an archive of a.txt and sub/b.txt gave back a.txt, sub and sub/b.txt in the target folder, and the documentation notes that extracting the identical archive twice overwrites without asking first (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ExtractAll> ;
    sen0414:anchor "#s-ExtractAll" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExtractingZip .
pg:Page ipo:coversChapterSection pg:ExtractAll .
pg:ExtractOne a ipo:ChapterSection ; rdfs:label "Extract one"@en ;
    skos:definition "extract('file1.txt', folder) takes out one member, whose own name must already be one namelist() returns (Sweigart, 2025); run under 3.14.6 it returned the path it had written, created the missing folders needed along the way, and a name that was not actually in the archive raised KeyError instead (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ExtractOne> ;
    sen0414:anchor "#s-ExtractOne" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExtractingZip .
pg:Page ipo:coversChapterSection pg:ExtractOne .
pg:ExtractionSafety a ipo:ChapterSection ; rdfs:label "Extraction safety"@en ;
    skos:definition "The chapter does not warn about an untrusted archive at all (Sweigart, 2025); the documentation says to inspect one before extracting it, and run under 3.14.6 an archive whose own members were named '../../evil.txt' and '/abs.txt' extracted to safe/evil.txt and safe/abs.txt rather than climbing out of the target folder, so nothing landed outside the folder named at all (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ExtractionSafety> ;
    sen0414:anchor "#s-ExtractionSafety" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExtractingZip .
pg:Page ipo:coversChapterSection pg:ExtractionSafety .
pg:ArchiveHelpers a ipo:ChapterSection ; rdfs:label "Archive helpers"@en ;
    skos:definition "shutil has its own archive functions that are not in the chapter at all (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ArchiveHelpers> ;
    sen0414:anchor "#s-ArchiveHelpers" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ZipArchives .
pg:Page ipo:coversChapterSection pg:ArchiveHelpers .
pg:MakeArchive a ipo:ChapterSection ; rdfs:label "Make archive"@en ;
    skos:definition "shutil.make_archive(base_name, 'zip', root_dir, base_dir) builds a ZIP archive of a folder in one call and returns the archive's own name (Python Software Foundation, 2026); run under 3.14.6 it made snap.zip holding spam/, spam/a.txt, spam/sub/ and spam/sub/b.txt, deflate for the files and stored for the folder entries, and the formats the function itself offers are bztar, gztar, tar, xztar, zip and zstdtar (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_MakeArchive> ;
    sen0414:anchor "#s-MakeArchive" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ArchiveHelpers .
pg:Page ipo:coversChapterSection pg:MakeArchive .
pg:UnpackArchive a ipo:ChapterSection ; rdfs:label "Unpack archive"@en ;
    skos:definition "shutil.unpack_archive(filename, extract_dir) extracts an archive, choosing the format from the file name's own extension (Python Software Foundation, 2026); run under 3.14.6 against a ZIP file it extracted a.txt, sub and sub/b.txt, using the zipfile module underneath for exactly that extension, and the documentation warns never to unpack an archive from an untrusted source without inspecting it first, adding that since Python 3.14 the defaults of both built-in formats already prevent the most dangerous cases on their own (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_UnpackArchive> ;
    sen0414:anchor "#s-UnpackArchive" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ArchiveHelpers .
pg:Page ipo:coversChapterSection pg:UnpackArchive .
pg:BackupProject a ipo:ChapterSection ; rdfs:label "Backup project"@en ;
    skos:definition "Project 5 of the chapter backs a folder up into numbered ZIP files, growing the archive's own name by one each time the program is run again against the same folder (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_BackupProject> ;
    sen0414:anchor "#s-BackupProject" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:BackupProject .
pg:ZipNaming a ipo:ChapterSection ; rdfs:label "Zip naming"@en ;
    skos:definition "The program first works out the name of the archive it is about to write, before a single file is touched at all (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ZipNaming> ;
    sen0414:anchor "#s-ZipNaming" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BackupProject .
pg:Page ipo:coversChapterSection pg:ZipNaming .
pg:NextZipName a ipo:ChapterSection ; rdfs:label "Next zip name"@en ;
    skos:definition "The name is the last part of the folder's own path, an underscore and a number starting at 1, growing until the first name that does not already exist (Sweigart, 2025); run under 3.14.6 against an empty working folder, three runs in a row gave spam_1.zip, spam_2.zip and spam_3.zip in turn, and the existence test itself looks in the current working directory, not next to the folder being backed up at all (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_NextZipName> ;
    sen0414:anchor "#s-NextZipName" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ZipNaming .
pg:Page ipo:coversChapterSection pg:NextZipName .
pg:ZipBuilding a ipo:ChapterSection ; rdfs:label "Zip building"@en ;
    skos:definition "Once the name is settled, the program walks the folder and writes every file it finds into the archive, one loop inside another (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ZipBuilding> ;
    sen0414:anchor "#s-ZipBuilding" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BackupProject .
pg:Page ipo:coversChapterSection pg:ZipBuilding .
pg:WalkIntoZip a ipo:ChapterSection ; rdfs:label "Walk into zip"@en ;
    skos:definition "The program opens the ZipFile in write mode and, inside os.walk, writes every file it finds with backup_zip.write(folder_name / filename) (Sweigart, 2025); the run printed 'Creating spam_1.zip...', 'Adding files in folder', 'Adding file file1.txt...' and 'Done.' exactly as the chapter shows, and a second run made spam_2.zip instead, the next number next zip name's own logic had already worked out; an empty folder with no files of its own is never recorded in the archive at all, because only files are written, never folder entries on their own (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_WalkIntoZip> ;
    sen0414:anchor "#s-WalkIntoZip" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ZipBuilding .
pg:Page ipo:coversChapterSection pg:WalkIntoZip .
pg:ArchiveNames a ipo:ChapterSection ; rdfs:label "Archive names"@en ;
    skos:definition "The chapter's own program passes absolute paths straight to write() (Sweigart, 2025); run under 3.14.6 the member name ended up holding the file's whole absolute path, less only its leading slash, ending in 'spam/file1.txt', and the documentation explains that write() stores a file's own name less any drive letter and any leading separators unless an arcname is given instead (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_ArchiveNames> ;
    sen0414:anchor "#s-ArchiveNames" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ZipBuilding .
pg:Page ipo:coversChapterSection pg:ArchiveNames .
pg:StoredByDefault a ipo:ChapterSection ; rdfs:label "Stored by default"@en ;
    skos:definition "The chapter opens its own archive with zipfile.ZipFile(zip_filename, 'w') and calls write() with no compression type named at all (Sweigart, 2025); run under 3.14.6 its own members had compress type 0, stored, and a five-byte test file was stored as exactly five bytes, so the finished snapshot is never actually compressed at all, where a file of 'Hello' repeated a thousand times stored at over five thousand bytes and deflated at under five hundred (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_StoredByDefault> ;
    sen0414:anchor "#s-StoredByDefault" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ZipBuilding .
pg:Page ipo:coversChapterSection pg:StoredByDefault .
pg:SelfInclusion a ipo:ChapterSection ; rdfs:label "Self inclusion"@en ;
    skos:definition "The chapter's own program places the archive inside the very folder it backs up (Sweigart, 2025); with the working folder set inside the folder being backed up, os.walk itself listed both file1.txt and the new spam_1.zip, and the program wrote the archive into itself; separately, with the folder given as Path('.'), the expression folder.parts[-1] raised 'IndexError: tuple index out of range', because Path('.').parts is an empty tuple on this system (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_SelfInclusion> ;
    sen0414:anchor "#s-SelfInclusion" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ZipBuilding .
pg:Page ipo:coversChapterSection pg:SelfInclusion .
pg:PracticeWork a ipo:ChapterSection ; rdfs:label "Practice work"@en ;
    skos:definition "Chapter 11 ends with a summary, four practice questions and four practice programs, each one applying a tool from an earlier branch to a small, concrete problem (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_PracticeWork> ;
    sen0414:anchor "#s-PracticeWork" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:PracticeWork .
pg:Questions a ipo:ChapterSection ; rdfs:label "Questions"@en ;
    skos:definition "The four practice questions test the vocabulary of the chapter rather than ask for a program to be written (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_Questions> ;
    sen0414:anchor "#s-Questions" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:PracticeWork .
pg:Page ipo:coversChapterSection pg:Questions .
pg:PracticeQuestions a ipo:ChapterSection ; rdfs:label "Practice questions"@en ;
    skos:definition "The questions ask how shutil.copy differs from shutil.copytree, which function renames a file, how the delete functions of send2trash and shutil differ, and which ZipFile method is the equivalent of open() on a plain file (Sweigart, 2025); run under 3.14.6, shutil.copy aimed at a folder raised IsADirectoryError on this system where shutil.copytree copied it correctly, and the equivalent of a plain open() is the ZipFile constructor itself, not the method ZipFile.open, which instead opens one single member already inside an archive (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_PracticeQuestions> ;
    sen0414:anchor "#s-PracticeQuestions" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Questions .
pg:Page ipo:coversChapterSection pg:PracticeQuestions .
pg:Programs a ipo:ChapterSection ; rdfs:label "Programs"@en ;
    skos:definition "The four practice programs apply walking, copying, sizes, renumbering and regular expressions, one technique from an earlier branch per program (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_Programs> ;
    sen0414:anchor "#s-Programs" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:PracticeWork .
pg:Page ipo:coversChapterSection pg:Programs .
pg:SelectiveCopy a ipo:ChapterSection ; rdfs:label "Selective copy"@en ;
    skos:definition "The first program walks a tree and copies files of one chosen extension into a new folder (Sweigart, 2025); a solution written for this study walked a tree of one.pdf, a/two.PDF, b/three.txt and b/four.pdf and copied one.pdf, four.pdf and two.PDF, three files, into the destination, because it compared the lower-cased name rather than the plain extension, which is exactly why two.PDF with capital letters still matched (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_SelectiveCopy> ;
    sen0414:anchor "#s-SelectiveCopy" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Programs .
pg:Page ipo:coversChapterSection pg:SelectiveCopy .
pg:LargeFiles a ipo:ChapterSection ; rdfs:label "Large files"@en ;
    skos:definition "The second program prints every file larger than 100MB, found with os.path.getsize (Sweigart, 2025); a solution written for this study used 100 * 1024 * 1024 bytes as that exact limit, created one file of precisely 100MB and a second one byte larger, and printed only the second, 104857601 bytes, since the chapter itself never says whether its own MB means a power of ten or of two (Python Software Foundation, 2026); the identical code, shown on this chapter's own slides with a limit of 1000 bytes instead, is this concept's own worked example."@en ; dcterms:source <http://example.org/sen0414/ch11#S_LargeFiles> ;
    sen0414:anchor "#s-LargeFiles" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Programs .
pg:Page ipo:coversChapterSection pg:LargeFiles .
pg:RenumberFiles a ipo:ChapterSection ; rdfs:label "Renumber files"@en ;
    skos:definition "The third program closes gaps in a run of numbered file names, with the chapter's own 117 files, spam001.txt to spam120.txt, missing numbers 42, 86 and 103 (Sweigart, 2025); a solution written for this study renamed every file to the next number in sorted order, and the result ran from spam001.txt to spam117.txt with no gap left at all, spam042.txt in the result being the file that had been spam043.txt before the renumbering ran (Python Software Foundation, 2026); the chapter's own added challenge, inserting a deliberate gap for a new file instead of only closing one, was not built for this study."@en ; dcterms:source <http://example.org/sen0414/ch11#S_RenumberFiles> ;
    sen0414:anchor "#s-RenumberFiles" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Programs .
pg:Page ipo:coversChapterSection pg:RenumberFiles .
pg:DateRenaming a ipo:ChapterSection ; rdfs:label "Date renaming"@en ;
    skos:definition "The fourth program swaps the month and the day inside names carrying an American MM-DD-YYYY date (Sweigart, 2025); a solution written for this study walked a folder, matched the pattern '(\\d\\d)-(\\d\\d)-(\\d\\d\\d\\d)' and called re.sub with its own three groups reordered 2, 1, 3, which turned spam12-31-1900.txt into spam31-12-1900.txt and report01-02-2020.txt into report02-01-2020.txt, while notes.txt, carrying no date at all, was correctly left alone (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch11#S_DateRenaming> ;
    sen0414:anchor "#s-DateRenaming" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Programs .
pg:Page ipo:coversChapterSection pg:DateRenaming .
pg:Copying sen0414:hasPanel pg:CopyFile, pg:CopyFolderTree, pg:CopyWithMetadata, pg:ExistingDestination .
pg:Moving sen0414:hasPanel pg:MoveFileOrFolder, pg:MoveAsRename, pg:MoveCollision, pg:PathlibCopyMove .
pg:PermanentDeletion sen0414:hasPanel pg:DeleteFile, pg:DeleteEmptyFolder, pg:DeleteFolderTree, pg:DeletionErrors .
pg:SaferDeletion sen0414:hasPanel pg:DryRun, pg:RecycleBin .
pg:Listing sen0414:hasPanel pg:ListDirectory, pg:IterateDirectory, pg:GlobPattern .
pg:Walking sen0414:hasPanel pg:WalkTree, pg:WalkOrder, pg:PruneWalk, pg:WalkAndRename, pg:PathWalk .
pg:WritingZip sen0414:hasPanel pg:CreateZip, pg:CompressionMethod, pg:CompressionLevel, pg:AppendToZip .
pg:ReadingZip sen0414:hasPanel pg:NameList, pg:ZipInfoSizes, pg:CompressionRatio .
pg:ExtractingZip sen0414:hasPanel pg:ExtractAll, pg:ExtractOne, pg:ExtractionSafety .
pg:ArchiveHelpers sen0414:hasPanel pg:MakeArchive, pg:UnpackArchive .
pg:ZipNaming sen0414:hasPanel pg:NextZipName .
pg:ZipBuilding sen0414:hasPanel pg:WalkIntoZip, pg:ArchiveNames, pg:StoredByDefault, pg:SelfInclusion .
pg:Questions sen0414:hasPanel pg:PracticeQuestions .
pg:Programs sen0414:hasPanel pg:SelectiveCopy, pg:LargeFiles, pg:RenumberFiles, pg:DateRenaming .
pg:CE_01 a ipo:CodeExample ; rdfs:label "shutil.copy: one file"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 6 of the deck and runs 8 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 6 ; sen0414:orderInTab 1 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('a.txt').write_text('Hello')\nPath('box').mkdir()\nprint(shutil.copy('a.txt', 'box'))\nprint(shutil.copy('a.txt', 'box/b.txt'))\nprint(sorted(os.listdir('box')))" ; sen0414:expectedOutput "box/a.txt\nbox/b.txt\n['a.txt', 'b.txt']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "shutil.copytree: a whole folder"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 7 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 2 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('box/inner').mkdir(parents=True)\nPath('box/y.txt').write_text('y')\nprint(shutil.copytree('box', 'bak'))\ntry:\n    shutil.copytree('box', 'bak')\nexcept FileExistsError:\n    print('second copy refused: the folder exists')\nprint(shutil.copytree('box', 'bak', dirs_exist_ok=True))" ; sen0414:expectedOutput "bak\nsecond copy refused: the folder exists\nbak\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "copy2 keeps the time stamp"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 8 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 3 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('a.txt').write_text('Hello')\nPath('box').mkdir()\nos.utime('a.txt', (1000000000, 1000000000))\nshutil.copy2('a.txt', 'box/c.txt')\nshutil.copy('a.txt', 'box/d.txt')\nt = lambda n: int(Path(n).stat().st_mtime)\nprint('copy2 keeps the time:', t('box/c.txt'))\nprint('copy gives a new time:', t('box/d.txt') == t('a.txt'))" ; sen0414:expectedOutput "copy2 keeps the time: 1000000000\ncopy gives a new time: False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "shutil.move: move and rename"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 9 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 4 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('spam').mkdir(); Path('spam2').mkdir()\nPath('spam/file1.txt').write_text('Hello')\nprint(shutil.move('spam/file1.txt', 'spam2'))\nprint(shutil.move('spam2/file1.txt', 'spam/new_name.txt'))\nPath('spam2/f.txt').write_text('old')\nPath('spam/f.txt').write_text('new')\nshutil.move('spam/f.txt', 'spam2/f.txt')\nprint(Path('spam2/f.txt').read_text(), Path('spam/f.txt').exists())" ; sen0414:expectedOutput "spam2/file1.txt\nspam/new_name.txt\nnew False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "os.unlink and os.rmdir"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 12 of the deck and runs 13 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 12 ; sen0414:orderInTab 5 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('a.txt').write_text('x')\nos.unlink('a.txt')\nprint('a.txt exists:', Path('a.txt').exists())\nPath('d').mkdir(); Path('d/f.txt').write_text('x')\ntry:\n    os.rmdir('d')\nexcept OSError:\n    print('rmdir refused: the folder d is not empty')\nos.unlink('d/f.txt'); os.rmdir('d')\nprint('d exists:', Path('d').exists())" ; sen0414:expectedOutput "a.txt exists: False\nrmdir refused: the folder d is not empty\nd exists: False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "shutil.rmtree"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 13 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 13 ; sen0414:orderInTab 6 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('spam/eggs').mkdir(parents=True)\nPath('spam/eggs/f.txt').write_text('x')\nprint(sorted(str(p) for p in Path('spam').rglob('*')))\nshutil.rmtree('spam')\nprint('spam exists:', Path('spam').exists())\nshutil.rmtree('spam', ignore_errors=True)\nprint('a missing folder is ignored')" ; sen0414:expectedOutput "['spam/eggs', 'spam/eggs/f.txt']\nspam exists: False\na missing folder is ignored\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "A dry run before deleting"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 14 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 7 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nfor n in ('a.txt', 'b.txt', 'c.rxt'):\n    Path(n).write_text(n)\nnames = sorted(p.name for p in Path('.').glob('*.rxt'))\nprint('typo *.rxt would delete:', names)\nfor p in sorted(Path('.').glob('*.txt')):\n    print('would delete', p)   # os.unlink(p)" ; sen0414:expectedOutput "typo *.rxt would delete: ['c.rxt']\nwould delete a.txt\nwould delete b.txt\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Listing one folder"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 19 of the deck and runs 12 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 8 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('spam/eggs').mkdir(parents=True)\nPath('spam/b.pdf').write_text('x')\nPath('spam/file1.txt').write_text('x')\nPath('spam/eggs/f2.txt').write_text('x')\nprint(sorted(os.listdir('spam')))\nprint(sorted((p.name, p.is_dir())\n             for p in Path('spam').iterdir()))\nprint(sorted(p.name for p in Path('spam').glob('*.txt')))\nprint(sorted(p.name for p in Path('spam').rglob('*.txt')))" ; sen0414:expectedOutput "['b.pdf', 'eggs', 'file1.txt']\n[('b.pdf', False), ('eggs', True), ('file1.txt', False)]\n['file1.txt']\n['f2.txt', 'file1.txt']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "os.walk visits every folder"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 20 of the deck and runs 12 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 20 ; sen0414:orderInTab 9 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('spam/eggs/bacon').mkdir(parents=True)\nPath('spam/eggs2').mkdir()\nPath('spam/file1.txt').write_text('x')\nPath('spam/eggs/file2.txt').write_text('x')\nfor folder, subs, files in os.walk('spam'):\n    subs.sort()\n    print(folder, subs, sorted(files))\nlast = [f for f, s, fl in os.walk('spam', topdown=False)][-1]\nprint('bottom-up ends at:', last)" ; sen0414:expectedOutput "spam ['eggs', 'eggs2'] ['file1.txt']\nspam/eggs ['bacon'] ['file2.txt']\nspam/eggs/bacon [] []\nspam/eggs2 [] []\nbottom-up ends at: spam\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "Folder sizes with os.walk"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 21 of the deck and runs 13 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 21 ; sen0414:orderInTab 10 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('spam/eggs').mkdir(parents=True)\nPath('spam/a.txt').write_text('x' * 300)\nPath('spam/eggs/b.txt').write_text('x' * 120)\nPath('spam/eggs/c.txt').write_text('x' * 80)\nsizes = {}\nfor folder, subs, files in os.walk('spam'):\n    sizes[folder] = sum(os.path.getsize(Path(folder, f))\n                        for f in files)\nprint(dict(sorted(sizes.items())))\nprint('total:', sum(sizes.values()))" ; sen0414:expectedOutput "{'spam': 300, 'spam/eggs': 200}\ntotal: 500\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "Path.mkdir with parents"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 22 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 11 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\ntry:\n    Path('x/y').mkdir()\nexcept FileNotFoundError:\n    print('refused: the parent x is missing')\nPath('x/y').mkdir(parents=True)\nPath('x/y').mkdir(parents=True, exist_ok=True)\nprint(sorted(str(p) for p in Path('x').rglob('*')))" ; sen0414:expectedOutput "refused: the parent x is missing\n['x/y']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "Writing a ZIP file"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 26 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 12 ;
    sen0414:code "import os, shutil, tempfile, zipfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('file1.txt').write_text('Hello' * 10000)\nwith zipfile.ZipFile('example.zip', 'w') as z:\n    z.write('file1.txt', compress_type=zipfile.ZIP_DEFLATED)\nwith zipfile.ZipFile('example.zip') as z:\n    info = z.getinfo('file1.txt')\nprint(info.filename, info.file_size)\nsmall = info.compress_size < info.file_size / 100\nprint('squeezed to under 1 percent:', small)" ; sen0414:expectedOutput "file1.txt 50000\nsqueezed to under 1 percent: True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "ZIP modes: append and refuse"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 27 of the deck and runs 14 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 27 ; sen0414:orderInTab 13 ;
    sen0414:code "import os, shutil, tempfile, zipfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('a.txt').write_text('A')\nwith zipfile.ZipFile('x.zip', 'w') as z:\n    z.write('a.txt')\nwith zipfile.ZipFile('x.zip', 'a') as z:\n    z.writestr('two.txt', '2')\nwith zipfile.ZipFile('x.zip') as z:\n    print(sorted(z.namelist()))\ntry:\n    zipfile.ZipFile('x.zip', 'x')\nexcept FileExistsError:\n    print('mode 'x' refused: x.zip exists')" ; sen0414:expectedOutput "['a.txt', 'two.txt']\nmode 'x' refused: x.zip exists\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "Extracting from a ZIP"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 28 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 28 ; sen0414:orderInTab 14 ;
    sen0414:code "import os, shutil, tempfile, zipfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nwith zipfile.ZipFile('z.zip', 'w') as z:\n    z.writestr('a.txt', 'A')\n    z.writestr('sub/b.txt', 'B')\nwith zipfile.ZipFile('z.zip') as z:\n    z.extractall('out')\nprint(sorted(str(p) for p in Path('out').rglob('*')))\nwith zipfile.ZipFile('z.zip') as z:\n    print(z.extract('a.txt', 'new/folder'))" ; sen0414:expectedOutput "['out/a.txt', 'out/sub', 'out/sub/b.txt']\nnew/folder/a.txt\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "make_archive and unpack_archive"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 29 of the deck and runs 12 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 15 ;
    sen0414:code "import os, shutil, tempfile, zipfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('spam/sub').mkdir(parents=True)\nPath('spam/a.txt').write_text('x')\nPath('spam/sub/b.txt').write_text('y')\nname = shutil.make_archive('snap', 'zip', '.', 'spam')\nprint(Path(name).name)\nwith zipfile.ZipFile(name) as z:\n    print(sorted(z.namelist()))\nshutil.unpack_archive(name, 'un')\nprint(sorted(str(p) for p in Path('un').rglob('*')))" ; sen0414:expectedOutput "snap.zip\n['spam/', 'spam/a.txt', 'spam/sub/', 'spam/sub/b.txt']\n['un/spam', 'un/spam/a.txt', 'un/spam/sub', 'un/spam/sub/b.txt']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "Project 5: backupToZip"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 34 of the deck and runs 17 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 34 ; sen0414:orderInTab 16 ;
    sen0414:code "import os, tempfile, zipfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\ndef backup_to_zip(folder):\n    n = 1\n    while Path(f'{folder}_{n}.zip').exists(): n += 1\n# continued\n    with zipfile.ZipFile(f'{folder}_{n}.zip', 'w') as z:\n        for root, subs, files in os.walk(folder):\n            for f in files: z.write(Path(root, f))\n    return f'{folder}_{n}.zip'\nPath('spam/eggs').mkdir(parents=True)\nPath('spam/file1.txt').write_text('Hello')\nPath('spam/eggs/file2.txt').write_text('Hi')\nprint(backup_to_zip('spam'), backup_to_zip('spam'))\nwith zipfile.ZipFile('spam_1.zip') as z:\n    print(sorted(z.namelist()))" ; sen0414:expectedOutput "spam_1.zip spam_2.zip\n['spam/eggs/file2.txt', 'spam/file1.txt']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "Practice 1: copy by extension"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 35 of the deck and runs 14 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 17 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nfor d in ('src/a', 'src/b', 'dest'):\n    Path(d).mkdir(parents=True)\nfiles = ('src/one.pdf', 'src/a/two.PDF',\n         'src/b/three.txt', 'src/b/four.pdf')\nfor f in files: Path(f).write_text(f)\nfor folder, subs, files in os.walk('src'):\n    for f in files:\n        if f.lower().endswith('.pdf'):\n            shutil.copy(Path(folder, f), 'dest')\nprint(sorted(os.listdir('dest')))\nprint(sorted(f for _, _, fs in os.walk('src') for f in fs))" ; sen0414:expectedOutput "['four.pdf', 'one.pdf', 'two.PDF']\n['four.pdf', 'one.pdf', 'three.txt', 'two.PDF']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "Practice 2: the big files"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 36 of the deck and runs 16 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 36 ; sen0414:orderInTab 18 ;
    sen0414:code "import os, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nPath('sub').mkdir()\nsizes = {'big.bin': 3000, 'mid.bin': 1200,\n         'tiny.txt': 40, 'sub/huge.bin': 9000}\nfor name, size in sizes.items():\n    Path(name).write_bytes(b'x' * size)\nfound = {}\nfor folder, subs, files in os.walk('.'):\n    for f in files:\n        path = Path(folder, f)\n# continued\n        if os.path.getsize(path) > 1000:\n            found[str(path)] = os.path.getsize(path)\nprint(dict(sorted(found.items(), key=lambda kv: -kv[1])))" ; sen0414:expectedOutput "{'sub/huge.bin': 9000, 'big.bin': 3000, 'mid.bin': 1200}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "Practice 3: swap day and month"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 37 of the deck and runs 13 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch11/page/chapter_code_ch11_v1_0_0.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 19 ;
    sen0414:code "import os, re, shutil, tempfile\nfrom pathlib import Path\nos.chdir(tempfile.mkdtemp())\nnames = ('spam12-31-1900.txt', 'report01-02-2020.txt',\n         'notes.txt')\nfor name in names: Path(name).write_text('')\npattern = re.compile(r'(\\d\\d)-(\\d\\d)-(\\d\\d\\d\\d)')\nbefore = sorted(os.listdir('.'))\nfor old in before:\n    if pattern.search(old):\n        new = pattern.sub(r'\\2-\\1-\\3', old)\n        shutil.move(old, new)\nprint(sorted(os.listdir('.')))" ; sen0414:expectedOutput "['notes.txt', 'report02-01-2020.txt', 'spam31-12-1900.txt']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
