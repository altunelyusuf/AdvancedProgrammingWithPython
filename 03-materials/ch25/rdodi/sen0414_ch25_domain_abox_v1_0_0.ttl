chx:X_DefaultStartMethod a owl:NamedIndividual, chx:DefaultStartMethod ; rdfs:label "multiprocessing.get_start_method()"@en ; skos:definition "The default start method of multiprocessing on Linux with Python 3.14.6 was forkserver, not fork; the documentation says the default was changed from fork to forkserver in 3.14 (True: the recorded run agrees with this process), so code that relied on a child inheriting the parent's variables breaks."@en ; dcterms:source <http://example.org/sen0414/ch25/research> .
chx:IO_DefaultStartMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, tempfile, warnings, subprocess, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH25_LATEST\\', \\'/home/claude/venv314_ch25_latest/bin/python\\')\\nFT = os.environ.get(\\'CH25_FT\\', \\'/root/.local/share/uv/python/cpython-3.14.6+freethreaded-linux-x86_64-gnu/bin/python3.14t\\')\\nP313 = os.environ.get(\\'CH25_P313\\', \\'/root/.local/share/uv/python/cpython-3.13-linux-x86_64-gnu/bin/python3.13\\')\\nP312 = os.environ.get(\\'CH25_P312\\', \\'/root/.local/share/uv/python/cpython-3.12-linux-x86_64-gnu/bin/python3.12\\')\\nP311 = os.environ.get(\\'CH25_P311\\', \\'/root/.local/share/uv/python/cpython-3.11-linux-x86_64-gnu/bin/python3.11\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch25-page/\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    # runs code in a new interpreter: (return code, stdout, last stderr line)\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', \\'\\')\\n    return (r.returncode, r.stdout.strip(), (r.stderr.strip().splitlines() or [\\'\\'])[-1][:160])\\ndef pyf(code, exe=None, limit=120):\\n    # like py(), but the code is run from a file, which multiprocessing needs\\n    fd, p = tempfile.mkstemp(suffix=\\'.py\\'); os.write(fd, code.encode()); os.close(fd)\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', p], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', \\'\\')\\n    return (r.returncode, r.stdout.strip(), (r.stderr.strip().splitlines() or [\\'\\'])[-1][:160])\\ndef lines(code, exe=None, limit=120): return py(code, exe, limit)[1].splitlines()\\ndef quiet(limit=1.0, wait=60):\\n    # waits until the one-minute load average is below limit (a quiet machine) and returns the load seen\\n    t0 = time.time()\\n    while os.getloadavg()[0] > limit and time.time() - t0 < wait: time.sleep(2)\\n    return round(os.getloadavg()[0], 1)\\ndef cpu(n): return \\'x = 0\\\\nfor i in range(%d): x += i * i\\\\n\\' % n\\n\\nimport threading, http.server\\ndef serve(delay=0.0, n=999):\\n    # a local stand-in for xkcd.com (127.0.0.1, not the real site): page /N has one comic image, /img/N.png is 100 bytes; every request waits delay seconds; hits records the paths served\\n    hits = []\\n    class H(http.server.BaseHTTPRequestHandler):\\n        def log_message(self, *a): pass\\n        def do_GET(self):\\n            hits.append(self.path); time.sleep(delay)\\n            if self.path.startswith(\\'/img/\\'): body, ct = b\\'x\\' * 100, \\'image/png\\'\\n            else: body, ct = (\\'<html><body><div id=\\x22comic\\x22><img src=\\x22http://127.0.0.1:%d/img/%s.png\\x22></div></body></html>\\' % (self.server.server_port, self.path.strip(\\'/\\'))).encode(), \\'text/html\\'\\n            self.send_response(200); self.send_header(\\'Content-Type\\', ct); self.send_header(\\'Content-Length\\', str(len(body))); self.end_headers(); self.wfile.write(body)\\n    h = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), H); h.daemon_threads = True\\n    threading.Thread(target=h.serve_forever, daemon=True).start()\\n    return h, h.server_port, hits\\nBOOK = \\x22\\x22\\x22import requests, os, bs4, threading, sys\\nBASE = sys.argv[1]\\nos.makedirs(\\'xkcd\\', exist_ok=True)\\ndef downloadXkcd(startComic, endComic):\\n    for urlNumber in range(startComic, endComic):\\n        res = requests.get(BASE + \\'/%s\\' % (urlNumber))\\n        res.raise_for_status()\\n        soup = bs4.BeautifulSoup(res.text, \\'html.parser\\')\\n        comicElem = soup.select(\\'#comic img\\')\\n        if comicElem == []:\\n            print(\\'Could not find comic image.\\')\\n        else:\\n            comicUrl = comicElem[0].get(\\'src\\')\\n            res = requests.get(comicUrl)\\n            res.raise_for_status()\\n            imageFile = open(os.path.join(\\'xkcd\\', os.path.basename(comicUrl)), \\'wb\\')\\n            for chunk in res.iter_content(100000):\\n                imageFile.write(chunk)\\n            imageFile.close()\\ndownloadThreads = []\\nfor i in range(0, 140, 10):\\n    start = i\\n    end = i + 9\\n    if start == 0:\\n        start = 1\\n    downloadThread = threading.Thread(target=downloadXkcd, args=(start, end))\\n    downloadThreads.append(downloadThread)\\n    START\\nfor downloadThread in downloadThreads:\\n    downloadThread.join()\\nprint(\\'Done.\\')\\n\\x22\\x22\\x22\\ndef bookrun(variant, delay=0.0):\\n    # runs the book\\'s downloader against the local stand-in; variant \\'printed\\' has no start() call, \\'fixed\\' calls start(); returns (seconds, comic pages requested, image requests, files saved, stdout, last stderr line, return code)\\n    h, port, hits = serve(delay); d = tempfile.mkdtemp(); code = BOOK.replace(\\'    START\\', \\'    downloadThread.start()\\' if variant == \\'fixed\\' else \\'    pass\\')\\n    t0 = time.time(); r = subprocess.run([LATEST, \\'-c\\', code, \\'http://127.0.0.1:%d\\' % port], capture_output=True, text=True, cwd=d, timeout=250); el = time.time() - t0\\n    h.shutdown(); pages = sorted(int(p.strip(\\'/\\')) for p in hits if not p.startswith(\\'/img/\\')); imgs = [p for p in hits if p.startswith(\\'/img/\\')]\\n    return el, pages, len(imgs), len(os.listdir(d + \\'/xkcd\\')) if os.path.isdir(d + \\'/xkcd\\') else 0, r.stdout.strip(), (r.stderr.strip().splitlines() or [\\'\\'])[-1], r.returncode\\nrec = J(\\'timing_record\\')[\\'runs\\']\\nimport multiprocessing as mp\\nout = (mp.get_start_method(), rec[\\'multiprocessing_3.14.6\\'][\\'result\\'][\\'start_method\\'] == mp.get_start_method())', g), g['out'])[1])({}) evaluates to ('forkserver', True)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, tempfile, warnings, subprocess, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH25_LATEST\\', \\'/home/claude/venv314_ch25_latest/bin/python\\')\\nFT = os.environ.get(\\'CH25_FT\\', \\'/root/.local/share/uv/python/cpython-3.14.6+freethreaded-linux-x86_64-gnu/bin/python3.14t\\')\\nP313 = os.environ.get(\\'CH25_P313\\', \\'/root/.local/share/uv/python/cpython-3.13-linux-x86_64-gnu/bin/python3.13\\')\\nP312 = os.environ.get(\\'CH25_P312\\', \\'/root/.local/share/uv/python/cpython-3.12-linux-x86_64-gnu/bin/python3.12\\')\\nP311 = os.environ.get(\\'CH25_P311\\', \\'/root/.local/share/uv/python/cpython-3.11-linux-x86_64-gnu/bin/python3.11\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch25-page/\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    # runs code in a new interpreter: (return code, stdout, last stderr line)\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', \\'\\')\\n    return (r.returncode, r.stdout.strip(), (r.stderr.strip().splitlines() or [\\'\\'])[-1][:160])\\ndef pyf(code, exe=None, limit=120):\\n    # like py(), but the code is run from a file, which multiprocessing needs\\n    fd, p = tempfile.mkstemp(suffix=\\'.py\\'); os.write(fd, code.encode()); os.close(fd)\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', p], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', \\'\\')\\n    return (r.returncode, r.stdout.strip(), (r.stderr.strip().splitlines() or [\\'\\'])[-1][:160])\\ndef lines(code, exe=None, limit=120): return py(code, exe, limit)[1].splitlines()\\ndef quiet(limit=1.0, wait=60):\\n    # waits until the one-minute load average is below limit (a quiet machine) and returns the load seen\\n    t0 = time.time()\\n    while os.getloadavg()[0] > limit and time.time() - t0 < wait: time.sleep(2)\\n    return round(os.getloadavg()[0], 1)\\ndef cpu(n): return \\'x = 0\\\\nfor i in range(%d): x += i * i\\\\n\\' % n\\n\\nimport threading, http.server\\ndef serve(delay=0.0, n=999):\\n    # a local stand-in for xkcd.com (127.0.0.1, not the real site): page /N has one comic image, /img/N.png is 100 bytes; every request waits delay seconds; hits records the paths served\\n    hits = []\\n    class H(http.server.BaseHTTPRequestHandler):\\n        def log_message(self, *a): pass\\n        def do_GET(self):\\n            hits.append(self.path); time.sleep(delay)\\n            if self.path.startswith(\\'/img/\\'): body, ct = b\\'x\\' * 100, \\'image/png\\'\\n            else: body, ct = (\\'<html><body><div id=\\x22comic\\x22><img src=\\x22http://127.0.0.1:%d/img/%s.png\\x22></div></body></html>\\' % (self.server.server_port, self.path.strip(\\'/\\'))).encode(), \\'text/html\\'\\n            self.send_response(200); self.send_header(\\'Content-Type\\', ct); self.send_header(\\'Content-Length\\', str(len(body))); self.end_headers(); self.wfile.write(body)\\n    h = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), H); h.daemon_threads = True\\n    threading.Thread(target=h.serve_forever, daemon=True).start()\\n    return h, h.server_port, hits\\nBOOK = \\x22\\x22\\x22import requests, os, bs4, threading, sys\\nBASE = sys.argv[1]\\nos.makedirs(\\'xkcd\\', exist_ok=True)\\ndef downloadXkcd(startComic, endComic):\\n    for urlNumber in range(startComic, endComic):\\n        res = requests.get(BASE + \\'/%s\\' % (urlNumber))\\n        res.raise_for_status()\\n        soup = bs4.BeautifulSoup(res.text, \\'html.parser\\')\\n        comicElem = soup.select(\\'#comic img\\')\\n        if comicElem == []:\\n            print(\\'Could not find comic image.\\')\\n        else:\\n            comicUrl = comicElem[0].get(\\'src\\')\\n            res = requests.get(comicUrl)\\n            res.raise_for_status()\\n            imageFile = open(os.path.join(\\'xkcd\\', os.path.basename(comicUrl)), \\'wb\\')\\n            for chunk in res.iter_content(100000):\\n                imageFile.write(chunk)\\n            imageFile.close()\\ndownloadThreads = []\\nfor i in range(0, 140, 10):\\n    start = i\\n    end = i + 9\\n    if start == 0:\\n        start = 1\\n    downloadThread = threading.Thread(target=downloadXkcd, args=(start, end))\\n    downloadThreads.append(downloadThread)\\n    START\\nfor downloadThread in downloadThreads:\\n    downloadThread.join()\\nprint(\\'Done.\\')\\n\\x22\\x22\\x22\\ndef bookrun(variant, delay=0.0):\\n    # runs the book\\'s downloader against the local stand-in; variant \\'printed\\' has no start() call, \\'fixed\\' calls start(); returns (seconds, comic pages requested, image requests, files saved, stdout, last stderr line, return code)\\n    h, port, hits = serve(delay); d = tempfile.mkdtemp(); code = BOOK.replace(\\'    START\\', \\'    downloadThread.start()\\' if variant == \\'fixed\\' else \\'    pass\\')\\n    t0 = time.time(); r = subprocess.run([LATEST, \\'-c\\', code, \\'http://127.0.0.1:%d\\' % port], capture_output=True, text=True, cwd=d, timeout=250); el = time.time() - t0\\n    h.shutdown(); pages = sorted(int(p.strip(\\'/\\')) for p in hits if not p.startswith(\\'/img/\\')); imgs = [p for p in hits if p.startswith(\\'/img/\\')]\\n    return el, pages, len(imgs), len(os.listdir(d + \\'/xkcd\\')) if os.path.isdir(d + \\'/xkcd\\') else 0, r.stdout.strip(), (r.stderr.strip().splitlines() or [\\'\\'])[-1], r.returncode\\nrec = J(\\'timing_record\\')[\\'runs\\']\\nimport multiprocessing as mp\\nout = (mp.get_start_method(), rec[\\'multiprocessing_3.14.6\\'][\\'result\\'][\\'start_method\\'] == mp.get_start_method())', g), g['out'])[1])({})" ; chx:output "('forkserver', True)" .
