chx:X_JoinBeforeStart a owl:NamedIndividual, chx:JoinBeforeStart ; rdfs:label "threadObj.join()  # never started"@en ; skos:definition "join() on a thread that was never started raised RuntimeError: cannot join thread before it is started."@en ; dcterms:source <http://example.org/sen0414/ch25/research> .
