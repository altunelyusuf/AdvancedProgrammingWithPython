chx:X_CrossReferenceTable a owl:NamedIndividual, chx:CrossReferenceTable ; rdfs:label "xref 0 8 / 0000000015 00000 n"@en ; skos:definition "The cross-reference table lists the byte offset of every numbered object: the table of the two-page file had 8 entries, the first (object 0) free, and the offsets of the first three used entries pointed at the text 1 0 obj, 2 0 obj and 3 0 obj."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_CrossReferenceTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, zipfile, zlib, struct, tempfile, warnings\\nimport pypdf\\ndef mk(*t):\\n    o = [\\'<</Type/Catalog/Pages 2 0 R>>\\', None, \\'<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>\\']; k = []\\n    for s in t:\\n        n = len(o) + 1; k.append(n); c = s if s.startswith(\\'BT\\') else \\'BT /F1 18 Tf 72 720 Td (%s) Tj ET\\' % s\\n        o.append(\\'<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 3 0 R>>>>/Contents %d 0 R>>\\' % (n + 1)); o.append(\\'<</Length %d>>\\\\nstream\\\\n%s\\\\nendstream\\' % (len(c), c))\\n    o[1] = \\'<</Type/Pages/Kids[%s]/Count %d>>\\' % (\\' \\'.join(\\'%d 0 R\\' % i for i in k), len(k))\\n    b = b\\'%PDF-1.4\\\\n\\'; f = []\\n    for i, s in enumerate(o, 1): f.append(len(b)); b += (\\'%d 0 obj\\\\n%s\\\\nendobj\\\\n\\' % (i, s)).encode()\\n    x = len(b); b += (\\'xref\\\\n0 %d\\\\n0000000000 65535 f \\\\n\\' % (len(o) + 1)).encode() + \\'\\'.join(\\'%010d 00000 n \\\\n\\' % i for i in f).encode()\\n    return b + (\\'trailer\\\\n<</Size %d/Root 1 0 R>>\\\\nstartxref\\\\n%d\\\\n%%%%EOF\\\\n\\' % (len(o) + 1, x)).encode()\\ndef rd(b, pw=None):\\n    r = pypdf.PdfReader(io.BytesIO(b))\\n    if pw is not None: r.decrypt(pw)\\n    return r\\ndef six():\\n    return mk(*[\\'Page %d\\' % i for i in range(1, 7)])\\ndef txts(w):\\n    b = io.BytesIO(); w.write(b); return [p.extract_text() for p in pypdf.PdfReader(b).pages]\\ndef png(w, h):\\n    raw = b\\'\\'.join(b\\'\\\\x00\\' + b\\'\\\\xff\\\\x00\\\\x00\\' * w for _ in range(h))\\n    ch = lambda t, d: struct.pack(\\'>I\\', len(d)) + t + d + struct.pack(\\'>I\\', zlib.crc32(t + d))\\n    return b\\'\\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n\\' + ch(b\\'IHDR\\', struct.pack(\\'>IIBBBBB\\', w, h, 8, 2, 0, 0, 0)) + ch(b\\'IDAT\\', zlib.compress(raw)) + ch(b\\'IEND\\', b\\'\\')\\nb = mk(\\'Page one\\', \\'Page two\\')\\nsx = int(re.search(rb\\'startxref\\\\n(\\\\d+)\\', b).group(1))\\nrows = re.findall(rb\\'(\\\\d{10}) (\\\\d{5}) ([nf]) \\\\n\\', b[sx:])\\noffs = [int(o) for o, g, t in rows if t == b\\'n\\']\\nout = (len(rows), [b[o:o + 7] for o in offs[:3]], rows[0][2])', g), g['out'])[1])({}) evaluates to (8, [b'1 0 obj', b'2 0 obj', b'3 0 obj'], b'f')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, zipfile, zlib, struct, tempfile, warnings\\nimport pypdf\\ndef mk(*t):\\n    o = [\\'<</Type/Catalog/Pages 2 0 R>>\\', None, \\'<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>\\']; k = []\\n    for s in t:\\n        n = len(o) + 1; k.append(n); c = s if s.startswith(\\'BT\\') else \\'BT /F1 18 Tf 72 720 Td (%s) Tj ET\\' % s\\n        o.append(\\'<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 3 0 R>>>>/Contents %d 0 R>>\\' % (n + 1)); o.append(\\'<</Length %d>>\\\\nstream\\\\n%s\\\\nendstream\\' % (len(c), c))\\n    o[1] = \\'<</Type/Pages/Kids[%s]/Count %d>>\\' % (\\' \\'.join(\\'%d 0 R\\' % i for i in k), len(k))\\n    b = b\\'%PDF-1.4\\\\n\\'; f = []\\n    for i, s in enumerate(o, 1): f.append(len(b)); b += (\\'%d 0 obj\\\\n%s\\\\nendobj\\\\n\\' % (i, s)).encode()\\n    x = len(b); b += (\\'xref\\\\n0 %d\\\\n0000000000 65535 f \\\\n\\' % (len(o) + 1)).encode() + \\'\\'.join(\\'%010d 00000 n \\\\n\\' % i for i in f).encode()\\n    return b + (\\'trailer\\\\n<</Size %d/Root 1 0 R>>\\\\nstartxref\\\\n%d\\\\n%%%%EOF\\\\n\\' % (len(o) + 1, x)).encode()\\ndef rd(b, pw=None):\\n    r = pypdf.PdfReader(io.BytesIO(b))\\n    if pw is not None: r.decrypt(pw)\\n    return r\\ndef six():\\n    return mk(*[\\'Page %d\\' % i for i in range(1, 7)])\\ndef txts(w):\\n    b = io.BytesIO(); w.write(b); return [p.extract_text() for p in pypdf.PdfReader(b).pages]\\ndef png(w, h):\\n    raw = b\\'\\'.join(b\\'\\\\x00\\' + b\\'\\\\xff\\\\x00\\\\x00\\' * w for _ in range(h))\\n    ch = lambda t, d: struct.pack(\\'>I\\', len(d)) + t + d + struct.pack(\\'>I\\', zlib.crc32(t + d))\\n    return b\\'\\\\x89PNG\\\\r\\\\n\\\\x