chx:X_RemovedNames a owl:NamedIndividual, chx:RemovedNames ; rdfs:label "pypdf.PdfFileReader"@en ; skos:definition "PdfFileReader, PdfFileWriter and PdfMerger are not attributes of pypdf 6.20.1 (False) while PdfReader and PdfWriter are (True), so tutorials written for older versions raise AttributeError."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_RemovedNames a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, zipfile, zlib, struct, tempfile, warnings\\nimport pypdf\\ndef mk(*t):\\n    o = [\\'<</Type/Catalog/Pages 2 0 R>>\\', None, \\'<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>\\']; k = []\\n    for s in t:\\n        n = len(o) + 1; k.append(n); c = s if s.startswith(\\'BT\\') else \\'BT /F1 18 Tf 72 720 Td (%s) Tj ET\\' % s\\n        o.append(\\'<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 3 0 R>>>>/Contents %d 0 R>>\\' % (n + 1)); o.append(\\'<</Length %d>>\\\\nstream\\\\n%s\\\\nendstream\\' % (len(c), c))\\n    o[1] = \\'<</Type/Pages/Kids[%s]/Count %d>>\\' % (\\' \\'.join(\\'%d 0 R\\' % i for i in k), len(k))\\n    b = b\\'%PDF-1.4\\\\n\\'; f = []\\n    for i, s in enumerate(o, 1): f.append(len(b)); b += (\\'%d 0 obj\\\\n%s\\\\nendobj\\\\n\\' % (i, s)).encode()\\n    x = len(b); b += (\\'xref\\\\n0 %d\\\\n0000000000 65535 f \\\\n\\' % (len(o) + 1)).encode() + \\'\\'.join(\\'%010d 00000 n \\\\n\\' % i for i in f).encode()\\n    return b + (\\'trailer\\\\n<</Size %d/Root 1 0 R>>\\\\nstartxref\\\\n%d\\\\n%%%%EOF\\\\n\\' % (len(o) + 1, x)).encode()\\ndef rd(b, pw=None):\\n    r = pypdf.PdfReader(io.BytesIO(b))\\n    if pw is not None: r.decrypt(pw)\\n    return r\\ndef six():\\n    return mk(*[\\'Page %d\\' % i for i in range(1, 7)])\\ndef txts(w):\\n    b = io.BytesIO(); w.write(b); return [p.extract_text() for p in pypdf.PdfReader(b).pages]\\ndef png(w, h):\\n    raw = b\\'\\'.join(b\\'\\\\x00\\' + b\\'\\\\xff\\\\x00\\\\x00\\' * w for _ in range(h))\\n    ch = lambda t, d: struct.pack(\\'>I\\', len(d)) + t + d + struct.pack(\\'>I\\', zlib.crc32(t + d))\\n    return b\\'\\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n\\' + ch(b\\'IHDR\\', struct.pack(\\'>IIBBBBB\\', w, h, 8, 2, 0, 0, 0)) + ch(b\\'IDAT\\', zlib.compress(raw)) + ch(b\\'IEND\\', b\\'\\')\\nres = {}\\nfor n in (\\'PdfFileReader\\', \\'PdfFileWriter\\', \\'PdfMerger\\', \\'PdfReader\\', \\'PdfWriter\\'):\\n    res[n] = hasattr(pypdf, n)\\nout = res', g), g['out'])[1])({}) evaluates to {'PdfFileReader': False, 'PdfFileWriter': False, 'PdfMerger': False, 'PdfReader': True, 'PdfWriter': True}"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, zipfile, zlib, struct, tempfile, warnings\\nimport pypdf\\ndef mk(*t):\\n    o = [\\'<</Type/Catalog/Pages 2 0 R>>\\', None, \\'<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>\\']; k = []\\n    for s in t:\\n        n = len(o) + 1; k.append(n); c = s if s.startswith(\\'BT\\') else \\'BT /F1 18 Tf 72 720 Td (%s) Tj ET\\' % s\\n        o.append(\\'<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 3 0 R>>>>/Contents %d 0 R>>\\' % (n + 1)); o.append(\\'<</Length %d>>\\\\nstream\\\\n%s\\\\nendstream\\' % (len(c), c))\\n    o[1] = \\'<</Type/Pages/Kids[%s]/Count %d>>\\' % (\\' \\'.join(\\'%d 0 R\\' % i for i in k), len(k))\\n    b = b\\'%PDF-1.4\\\\n\\'; f = []\\n    for i, s in enumerate(o, 1): f.append(len(b)); b += (\\'%d 0 obj\\\\n%s\\\\nendobj\\\\n\\' % (i, s)).encode()\\n    x = len(b); b += (\\'xref\\\\n0 %d\\\\n0000000000 65535 f \\\\n\\' % (len(o) + 1)).encode() + \\'\\'.join(\\'%010d 00000 n \\\\n\\' % i for i in f).encode()\\n    return b + (\\'trailer\\\\n<</Size %d/Root 1 0 R>>\\\\nstartxref\\\\n%d\\\\n%%%%EOF\\\\n\\' % (len(o) + 1, x)).encode()\\ndef rd(b, pw=None):\\n    r = pypdf.PdfReader(io.BytesIO(b))\\n    if pw is not None: r.decrypt(pw)\\n    return r\\ndef six():\\n    return mk(*[\\'Page %d\\' % i for i in range(1, 7)])\\ndef txts(w):\\n    b = io.BytesIO(); w.write(b); return [p.extract_text() for p in pypdf.PdfReader(b).pages]\\ndef png(w, h):\\n    raw = b\\'\\'.join(b\\'\\\\x00\\' + b\\'\\\\xff\\\\x00\\\\x00\\' * w for _ in range(h))\\n    ch = lambda t, d: struct.pack(\\'>I\\', len(d)) + t + d + struct.pack(\\'>I\\', zlib.crc32(t + d))\\n    return b\\'\\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n\\' + ch(b\\'IHDR\\', struct.pack(\\'>IIBBBBB\\', w, h, 8, 2, 0, 0, 0)) + ch(b\\'IDAT\\', zlib.compress(raw)) + ch(b\\'IEND\\', b\\'\\')\\nres = {}\\nfor n in (\\'PdfFileReader\\', \\'PdfFileWriter\\', \\'PdfMerger\\', \\'PdfReader\\', \\'PdfWriter\\'):\\n    res[n] = hasattr(pypdf, n)\\nout = res', g), g['out'])[1])({})" ; chx:output "{'PdfFileReader': False, 'PdfFileWriter': False, 'PdfMerger': False, 'PdfReader': True, 'PdfWriter': True}" .
