chx:X_PdfReaderObject a owl:NamedIndividual, chx:PdfReaderObject ; rdfs:label "reader = pypdf.PdfReader('Recursion_Chapter1.pdf')"@en ; skos:definition "A PdfReader object stands for one PDF file, and its pages attribute is a list-like collection of page objects whose length is the page count: a six-page stand-in file gave 6 in the chapter 17 library run, and the book's 18-page sample file was not opened."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_TextExtraction a owl:NamedIndividual, chx:TextExtraction ; rdfs:label "text += page.extract_text()"@en ; skos:definition "A page's extract_text() returns that page's text as one string, and adding the strings one after another joins the last word of a page to the first of the next with no separator; the stand-in below finds the text-showing operator of a content stream with a regular expression instead of with pypdf."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_TextExtraction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: __import__('re').findall(rb'\\((.*?)\\) Tj', s))(b'BT /F1 18 Tf 72 720 Td (Hello) Tj ET') evaluates to [b'Hello']"@en ; chx:input "(lambda s: __import__('re').findall(rb'\\((.*?)\\) Tj', s))(b'BT /F1 18 Tf 72 720 Td (Hello) Tj ET')" ; chx:output "[b'Hello']" .
chx:X_TextExtraction rd:hasIOExample chx:IO_TextExtraction .
chx:X_ExtractionFallback a owl:NamedIndividual, chx:ExtractionFallback ; rdfs:label "pdfminer.high_level.extract_text(PDF_FILENAME)"@en ; skos:definition "When pypdf raises on a file, the chapter falls back on the pdfminer.six package, whose extract_text() function returns the whole file as one string; on the stand-in file it separated the pages with a form feed."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_TextPostProcessing a owl:NamedIndividual, chx:TextPostProcessing ; rdfs:label "follow -\\ning the execution"@en ; skos:definition "Extracted text keeps a newline after every printed row and hyphenated words at row ends, and cleaning that up is a separate natural language task that pypdf leaves to the program; a regular expression joins the chapter's split word, while the pypdf documentation recipe leaves a space in it."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_TextPostProcessing a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('re').sub(r' ?-\\n(\\w+)', r'\\1', 'follow -\\ning the execution') evaluates to 'following the execution'"@en ; chx:input "__import__('re').sub(r' ?-\\n(\\w+)', r'\\1', 'follow -\\ning the execution')" ; chx:output "'following the execution'" .
chx:X_TextPostProcessing rd:hasIOExample chx:IO_TextPostProcessing .
chx:X_ImageExtraction a owl:NamedIndividual, chx:ImageExtraction ; rdfs:label "for image in page.images: file.write(image.data)"@en ; skos:definition "Each page has an images collection of image objects with a name and the bytes of the image, which the chapter writes to files opened in binary write mode; the names are not unique, may hold arbitrary characters, and need the optional Pillow package, so the chapter counts them with image_num and a page number."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_PdfWriterObject a owl:NamedIndividual, chx:PdfWriterObject ; rdfs:label "writer = pypdf.PdfWriter()"@en ; skos:definition "A PdfWriter object stands for a new PDF that starts with no pages and gets pages copied from other files, never text typed in; its write() method saves it to a file opened in binary write mode, and an empty writer cannot add a blank page because it has no page size to copy."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_PageSelection a owl:NamedIndividual, chx:PageSelection ; rdfs:label "writer.append('Recursion_Chapter1.pdf', (0, 5))"@en ; skos:definition "A tuple of two or three integers given to append() selects pages the way range() does, counting from page index 0 and stopping before the last number, so (0, 5) copies the first five pages and (0, 5, 2) every second one."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_PageSelection a owl:NamedIndividual, rd:IOExample ; rdfs:label "(list(range(0, 5)), list(range(0, 5, 2))) evaluates to ([0, 1, 2, 3, 4], [0, 2, 4])"@en ; chx:input "(list(range(0, 5)), list(range(0, 5, 2)))" ; chx:output "([0, 1, 2, 3, 4], [0, 2, 4])" .
chx:X_PageSelection rd:hasIOExample chx:IO_PageSelection .
chx:X_TupleVersusList a owl:NamedIndividual, chx:TupleVersusList ; rdfs:label "writer.append(file, [0, 5])"@en ; skos:definition "For append() a tuple means a range of page indexes and a list means exactly the pages it names, so [0, 5] copies page index 0 and page index 5 only (2 pages in the library run) and a list may repeat a page."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_TupleVersusList a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda sel: list(range(*sel)) if isinstance(sel, tuple) else list(sel))([0, 5]) evaluates to [0, 5]"@en ; chx:input "(lambda sel: list(range(*sel)) if isinstance(sel, tuple) else list(sel))([0, 5])" ; chx:output "[0, 5]" .
chx:X_TupleVersusList rd:hasIOExample chx:IO_TupleVersusList .
chx:X_AppendVersusMerge a owl:NamedIndividual, chx:AppendVersusMerge ; rdfs:label "writer.merge(2, 'Recursion_Chapter1.pdf', (0, 5))"@en ; skos:definition "append() adds the copied pages at the end of the writer, while merge() takes a position first and inserts them there, shifting the pages that were at and after that position back; the list method append() of the same name only adds one item."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_AppendVersusMerge a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda pages: pages[:2] + ['new'] + pages[2:])(['p0', 'p1', 'p2']) evaluates to ['p0', 'p1', 'new', 'p2']"@en ; chx:input "(lambda pages: pages[:2] + ['new'] + pages[2:])(['p0', 'p1', 'p2'])" ; chx:output "['p0', 'p1', 'new', 'p2']" .
chx:X_AppendVersusMerge rd:hasIOExample chx:IO_AppendVersusMerge .
chx:X_PageRotation a owl:NamedIndividual, chx:PageRotation ; rdfs:label "writer.pages[i].rotate(90)"@en ; skos:definition "A page's rotate() takes a multiple of 90, positive for clockwise and negative for counterclockwise, and raises ValueError for any other angle; successive calls add, so 90 and then 270 left the stored rotation at 360 in the library run."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_PageRotation a owl:NamedIndividual, rd:IOExample ; rdfs:label "[a % 90 == 0 for a in (90, 180, 270, -90, 45)] evaluates to [True, True, True, True, False]"@en ; chx:input "[a % 90 == 0 for a in (90, 180, 270, -90, 45)]" ; chx:output "[True, True, True, True, False]" .
chx:X_PageRotation rd:hasIOExample chx:IO_PageRotation .
chx:X_BlankPages a owl:NamedIndividual, chx:BlankPages ; rdfs:label "writer.insert_blank_page(index=2)"@en ; skos:definition "add_blank_page() appends and insert_blank_page() inserts a page of the same size as the preceding page, and insert_blank_page wants its index given by name in the chapter's example; a blank page can later receive an overlay or a watermark."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_WatermarkAndStamp a owl:NamedIndividual, chx:WatermarkAndStamp ; rdfs:label "page.merge_page(watermark_page, over=False)"@en ; skos:definition "merge_page() lays the content of one page on another: over=True puts it on top as a stamp or overlay and over=False underneath as a watermark or underlay, and on the stand-in file the underlay text came first in the extracted text ('DRAFTPage one text') and the overlay text last."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_PdfEncryption a owl:NamedIndividual, chx:PdfEncryption ; rdfs:label "writer.encrypt('swordfish', algorithm='AES-256')"@en ; skos:definition "encrypt() makes the written file unreadable without a password; with algorithm='AES-256' the library run wrote encryption version 5 revision 6, while a call without an algorithm wrote the older RC4 encryption, version 2 revision 3, and AES needs the cryptography package to be installed."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_PdfDecryption a owl:NamedIndividual, chx:PdfDecryption ; rdfs:label "reader.decrypt('swordfish').name"@en ; skos:definition "A reader reports is_encrypted, refuses to give pages until decrypt() succeeds, and decrypt() returns a password type whose name is NOT_DECRYPTED for a wrong password, USER_PASSWORD or OWNER_PASSWORD for a right one; the two passwords are the first and second arguments of encrypt(), and one argument serves for both."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_PasswordStrength a owl:NamedIndividual, chx:PasswordStrength ; rdfs:label "a password of around 14 to 16 characters that is not a dictionary word"@en ; skos:definition "The encryption is only as strong as the password, a PDF has no password-reset mechanism, and the chapter's own swordfish is named as a poor password because it is a dictionary word, which is what the practice program that tries 88,000 forms of 44,000 words exploits."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_PasswordStrength a owl:NamedIndividual, rd:IOExample ; rdfs:label "2 * 44000 evaluates to 88000"@en ; chx:input "2 * 44000" ; chx:output "88000" .
chx:X_PasswordStrength rd:hasIOExample chx:IO_PasswordStrength .
chx:X_DocxPackage a owl:NamedIndividual, chx:DocxPackage ; rdfs:label "zipfile.ZipFile('demo.docx')"@en ; skos:definition "A .docx file is a ZIP archive of XML parts, and a zip archive is recognised by the signature PK at the start of its records; the stand-in below checks the 22 bytes of an empty archive, and Document() on a PDF raises PackageNotFoundError in python-docx 1.2.0."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_DocxPackage a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('zipfile').is_zipfile(__import__('io').BytesIO(b'PK\\x05\\x06' + bytes(18))) evaluates to True"@en ; chx:input "__import__('zipfile').is_zipfile(__import__('io').BytesIO(b'PK\\x05\\x06' + bytes(18)))" ; chx:output "True" .
chx:X_DocxPackage rd:hasIOExample chx:IO_DocxPackage .
chx:X_DocumentObject a owl:NamedIndividual, chx:DocumentObject ; rdfs:label "doc = docx.Document('demo.docx')"@en ; skos:definition "A Document object stands for the whole .docx file, opened from a filename or, when the filename is omitted, a blank document built on the default template, and it holds the list of its paragraphs and the methods that add to its end."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_ParagraphObject a owl:NamedIndividual, chx:ParagraphObject ; rdfs:label "doc.paragraphs[1].text"@en ; skos:definition "A Paragraph object is one block of text that begins where the user pressed Enter, with a text attribute holding its text without styling, a style, and a list of runs."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_RunObject a owl:NamedIndividual, chx:RunObject ; rdfs:label "doc.paragraphs[1].runs[1].text"@en ; skos:definition "A Run object is a contiguous stretch of text in one style inside a paragraph, so a paragraph holding plain, bold, plain and italic text has four runs; the stand-in below builds such a paragraph in XML and counts its runs with the standard library."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_ParagraphList a owl:NamedIndividual, chx:ParagraphList ; rdfs:label "len(doc.paragraphs)"@en ; skos:definition "The paragraphs attribute of a document is a list of Paragraph objects in order, so len() counts them and an index picks one, and each paragraph's runs attribute lists its Run objects the same way."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_RunText a owl:NamedIndividual, chx:RunText ; rdfs:label "doc.paragraphs[1].runs[0].text"@en ; skos:definition "A Run object's text attribute holds only the text of that run, which is why text that changes style is split over several runs and why a search for a phrase in a paragraph's text is safer than a search in single runs."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_FullText a owl:NamedIndividual, chx:FullText ; rdfs:label "'\\n'.join(full_text)"@en ; skos:definition "The chapter's get_text() collects every paragraph's text in a list and joins it with newlines; indenting each paragraph or joining with two newlines changes the spacing, and the styling is lost."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_FullText a owl:NamedIndividual, rd:IOExample ; rdfs:label "'\\n'.join(['Document Title', 'A plain paragraph']) evaluates to 'Document Title\\nA plain paragraph'"@en ; chx:input "'\\n'.join(['Document Title', 'A plain paragraph'])" ; chx:output "'Document Title\\nA plain paragraph'" .
chx:X_FullText rd:hasIOExample chx:IO_FullText .
chx:X_StyleKinds a owl:NamedIndividual, chx:StyleKinds ; rdfs:label "doc.paragraphs[0].style = 'Normal'"@en ; skos:definition "A style is a named set of text attributes, and there are paragraph styles for Paragraph objects, character styles for Run objects and linked styles that exist in both forms; setting style to None associates none, and python-docx refuses a name the file does not define with KeyError."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_LinkedStyle a owl:NamedIndividual, chx:LinkedStyle ; rdfs:label "doc.paragraphs[1].runs[0].style = 'Quote Char'"@en ; skos:definition "A linked style has a paragraph form and a character form, and the character form for a run is named with ' Char' added, so the paragraph style Quote is applied to a run as Quote Char; giving a run the paragraph style itself raised ValueError in the library run."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_DefaultStyleNames a owl:NamedIndividual, chx:DefaultStyleNames ; rdfs:label "'Heading 1', 'List Bullet', 'Quote', 'Title'"@en ; skos:definition "The default template of python-docx 1.2.0 defines 36 paragraph styles, 27 character styles and 100 table styles; most names of the chapter's list exist, but List Number with a trailing space and MacroText do not (List Number and macro do)."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_CustomStyles a owl:NamedIndividual, chx:CustomStyles ; rdfs:label "doc.styles.add_style('Citation', WD_STYLE_TYPE.PARAGRAPH)"@en ; skos:definition "The chapter says custom styles must be made in Word and then read from the style attribute, while python-docx can also add a style to the document in code with styles.add_style; a style that is not in the file is not applied."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_RunAttributes a owl:NamedIndividual, chx:RunAttributes ; rdfs:label "doc.paragraphs[1].runs[1].underline = True"@en ; skos:definition "A run's text attributes such as bold, italic and underline are set directly on the Run object in python-docx, while strike, double_strike, all_caps, small_caps, shadow, outline, rtl, imprint and emboss are set on its font attribute, because assigning them to the Run itself raises no error and changes nothing."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_TriStateAttribute a owl:NamedIndividual, chx:TriStateAttribute ; rdfs:label "run.bold = None"@en ; skos:definition "A text attribute is True (always on), False (always off) or None (taken from the run's style), so None is the way to hand the decision back to the style."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_TriStateAttribute a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(lambda r, s: s if r is None else r)(v, True) for v in (True, False, None)] evaluates to [True, False, True]"@en ; chx:input "[(lambda r, s: s if r is None else r)(v, True) for v in (True, False, None)]" ; chx:output "[True, False, True]" .
chx:X_TriStateAttribute rd:hasIOExample chx:IO_TriStateAttribute .
chx:X_NewDocument a owl:NamedIndividual, chx:NewDocument ; rdfs:label "doc = docx.Document()"@en ; skos:definition "Calling Document() without a filename returns a blank document built on the default template, and save() writes it to a file named by a string."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_AddParagraph a owl:NamedIndividual, chx:AddParagraph ; rdfs:label "doc.add_paragraph('Hello, world!', 'Title')"@en ; skos:definition "add_paragraph() adds a paragraph at the end of the document and returns it, add_run() on that paragraph adds more text to its end and returns the Run, and both accept a style name as an optional second argument."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_AddHeading a owl:NamedIndividual, chx:AddHeading ; rdfs:label "doc.add_heading('Header 1', 1)"@en ; skos:definition "add_heading() adds a paragraph in a heading style: level 0 is the Title style and 1 to 9 are Heading 1 to Heading 9, and python-docx raises ValueError outside 0 to 9, although the chapter names 0 to 4 and then 1 to 9."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_AddHeading a owl:NamedIndividual, rd:IOExample ; rdfs:label "['Title' if n == 0 else 'Heading %d' % n for n in (0, 1, 4, 9)] evaluates to ['Title', 'Heading 1', 'Heading 4', 'Heading 9']"@en ; chx:input "['Title' if n == 0 else 'Heading %d' % n for n in (0, 1, 4, 9)]" ; chx:output "['Title', 'Heading 1', 'Heading 4', 'Heading 9']" .
chx:X_AddHeading rd:hasIOExample chx:IO_AddHeading .
chx:X_BreaksInDocument a owl:NamedIndividual, chx:BreaksInDocument ; rdfs:label "doc.paragraphs[0].runs[0].add_break(docx.enum.text.WD_BREAK.PAGE)"@en ; skos:definition "add_break() on a Run adds a line break by default and a page break when given WD_BREAK.PAGE, which becomes one w:br element of type page after that run; python-docx also has add_page_break() on the document."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_AddPicture a owl:NamedIndividual, chx:AddPicture ; rdfs:label "doc.add_picture('zophie.png', width=docx.shared.Inches(1), height=docx.shared.Cm(4))"@en ; skos:definition "add_picture() adds an image at the end of the document at its native size or at the width and height given, and Inches() and Cm() give lengths that Word stores in English metric units, 914400 to the inch and 360000 to the centimetre."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_AddPicture a owl:NamedIndividual, rd:IOExample ; rdfs:label "(914400 * 1, 360000 * 4) evaluates to (914400, 1440000)"@en ; chx:input "(914400 * 1, 360000 * 4)" ; chx:output "(914400, 1440000)" .
chx:X_AddPicture rd:hasIOExample chx:IO_AddPicture .
chx:X_FindPdfFiles a owl:NamedIndividual, chx:FindPdfFiles ; rdfs:label "pdf_filenames.sort(key=str.lower)"@en ; skos:definition "The project lists the working folder with os.listdir, keeps names that end in .pdf and sorts them with key=str.lower because a plain sort puts every uppercase name before every lowercase one; the documentation says listdir returns names in arbitrary order."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_FindPdfFiles a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(['alpha.pdf', 'Zeta.pdf'], key=str.lower) == ['alpha.pdf', 'Zeta.pdf'] and sorted(['alpha.pdf', 'Zeta.pdf']) == ['Zeta.pdf', 'alpha.pdf'] evaluates to True"@en ; chx:input "sorted(['alpha.pdf', 'Zeta.pdf'], key=str.lower) == ['alpha.pdf', 'Zeta.pdf'] and sorted(['alpha.pdf', 'Zeta.pdf']) == ['Zeta.pdf', 'alpha.pdf']" ; chx:output "True" .
chx:X_FindPdfFiles rd:hasIOExample chx:IO_FindPdfFiles .
chx:X_CopyAfterFirstPage a owl:NamedIndividual, chx:CopyAfterFirstPage ; rdfs:label "writer.append(pdf_filename, (1, len(reader.pages)))"@en ; skos:definition "To drop each cover sheet the project copies page indexes 1 up to the page count, so a three-page file adds pages 1 and 2, and a one-page file adds none."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_CopyAfterFirstPage a owl:NamedIndividual, rd:IOExample ; rdfs:label "[list(range(1, n)) for n in (3, 2, 1)] evaluates to [[1, 2], [1], []]"@en ; chx:input "[list(range(1, n)) for n in (3, 2, 1)]" ; chx:output "[[1, 2], [1], []]" .
chx:X_CopyAfterFirstPage rd:hasIOExample chx:IO_CopyAfterFirstPage .
chx:X_RerunTrap a owl:NamedIndividual, chx:RerunTrap ; rdfs:label "combined.pdf"@en ; skos:definition "The project writes combined.pdf into the same folder it reads, so a second run lists that file as an input and copies its pages after the first into the new result; in the library run the result grew from 3 to 5 pages until the output name was skipped."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_PdfParanoia a owl:NamedIndividual, chx:PdfParanoia ; rdfs:label "os.walk('.') then name_encrypted.pdf"@en ; skos:definition "The first practice program walks a folder and its subfolders with os.walk, encrypts each PDF to a new name with _encrypted.pdf added before the extension, reads and decrypts the copy to check it, and only then deletes the original."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_PdfParanoia a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('os').path.splitext('sub/c.pdf')[0] + '_encrypted.pdf' evaluates to 'sub/c_encrypted.pdf'"@en ; chx:input "__import__('os').path.splitext('sub/c.pdf')[0] + '_encrypted.pdf'" ; chx:output "'sub/c_encrypted.pdf'" .
chx:X_PdfParanoia rd:hasIOExample chx:IO_PdfParanoia .
chx:X_CustomInvitations a owl:NamedIndividual, chx:CustomInvitations ; rdfs:label "add_break() after each invitation"@en ; skos:definition "The second program writes one invitation per guest to a Word document from a styled blank file and puts a page break after each one; a break after every invitation, the last included, makes one page more than the guests need, which the stand-in below counts and the library run confirmed as 5 breaks for 5 guests."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_PasswordBreaker a owl:NamedIndividual, chx:PasswordBreaker ; rdfs:label "for word in words: decrypt(word.lower()), decrypt(word.upper())"@en ; skos:definition "The third program tries the lower and upper case of each of over 44,000 dictionary words in decrypt(), 88,000 tries in all, which is a brute-force password attack and is why a dictionary word makes a poor password; the book's dictionary.txt and a real encrypted file were not used here."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:IO_PasswordBreaker a owl:NamedIndividual, rd:IOExample ; rdfs:label "2 * 44000 evaluates to 88000"@en ; chx:input "2 * 44000" ; chx:output "88000" .
chx:X_PasswordBreaker rd:hasIOExample chx:IO_PasswordBreaker .
chx:X_PresentationFormat a owl:NamedIndividual, chx:PresentationFormat ; rdfs:label "PDF: a page description, .docx: a zip of XML"@en ; skos:definition "PDF was made for printing and displaying pages and Word for editing by people, so neither is designed to be parsed into paragraphs, tables and reading order by a program, which is the reason the chapter gives for its limits and the one that the next chapter's CSV, JSON and XML formats answer."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_HumanReview a owl:NamedIndividual, chx:HumanReview ; rdfs:label "a human must always review the output"@en ; skos:definition "The chapter suggests a large language model to clean up extracted text and insists that a person reviews the result, since its own trial removed a chapter number that was meant to stay; the model step was not run here."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_OtherPdfLibraries a owl:NamedIndividual, chx:OtherPdfLibraries ; rdfs:label "pdfplumber, ReportLab, pdfrw, PyMuPDF, pdfkit, borb"@en ; skos:definition "The chapter's summary names six other PDF packages to search for on PyPI, and all six were found there with their current release: pdfplumber 0.11.10, reportlab 5.0.1, pdfrw 0.4, PyMuPDF 1.28.2, pdfkit 1.0.0 and borb 3.0.9."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:X_PackageNames a owl:NamedIndividual, chx:PackageNames ; rdfs:label "pip install python-docx, import docx"@en ; skos:definition "The package to install is python-docx (1.2.0) and the module to import is docx; a different, older package named docx exists on PyPI (0.2.4), and pypdf is installed as pypdf and, for AES or images, with its crypto or image extras."@en ; dcterms:source <http://example.org/sen0414/ch17/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 17 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch17/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 17 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which operations read a document, which build a new one from parts of others, and which can be done at all, given that PDF and Word files are made for people to read and not for programs to parse?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, names and programs of the chapter differ in current releases of the packages, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 17 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 17 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch17/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-01."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

