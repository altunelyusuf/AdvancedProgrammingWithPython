pg:CE_01 a ipo:CodeExample ; rdfs:label "Inside a small PDF"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 7 of the deck and runs 14 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 1 ;
    sen0414:code "import base64, zlib\nblob = ('eNq1kF9PgzAUxd/5FPdliT5oW6DAzMLD/sVEjcvAp2UP3SjIgtS0nW5+etsNRx'\n        'BfLUlJT8+95/46WEznN+TWdwhgEJudMxqh9PjO0YRpVokCLVjBFbjmdhnHDq8z'\n        'a3J/mU8m9FBmauVbJwR2X6OJ2Nca3LbQ+1U4F7VGyX6j7cEqBI2Z4if5nlcfXJ'\n        'db1pb7f+SaTXKbYiPRE89KNhaHFTZHD2OI8BotuRJ7ueXK1NnW9kfAOzPFsRmz'\n        '1qaFAtrFpG3cI68L/QqhZVFacvbmjFOwbUgEaQ6EYvAxpBlcfQpZZdeQ7mCWQs'\n        'fkXjyGrRKNx6Y1LZvc4J8xwy5m2MekfUy/S5CwisnjHRAXmwUvyfQHGZ8+WZg3'\n        'MaOB69oJQXLI+6QHyXPHTO/gy4KAUo9CDq02hPNN3WrU72mEkL4W9n1uRHuaj/'\n        'saJUGracnKikv7Rkn5xSFCSyE0kOYllWZSn2ACb+gMBrPnufMNU9nkUQ==')\ndata = zlib.decompress(base64.b64decode(blob))\nprint(data[:8], data.rstrip().endswith(b'%%EOF'))\ntext = data.decode()\nstart = text.split('startxref')[1].split()[0]\nprint(text.count(' obj'), 'objects; table at byte', start)" ; sen0414:expectedOutput "b'%PDF-1.4' True\n7 objects; table at byte 639\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "PdfReader, pages and page size"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 8 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 2 ;
    sen0414:code "import io, pypdf\nwriter = pypdf.PdfWriter()\nfor width in (100, 200, 300): writer.add_blank_page(width, 100)\nbuf = io.BytesIO()\nwriter.write(buf)\nreader = pypdf.PdfReader(buf)\nprint(len(reader.pages), 'pages; locked:', reader.is_encrypted)\nwidths = [float(p.mediabox.width) for p in reader.pages]\nprint('width of each page in points:', widths)" ; sen0414:expectedOutput "3 pages; locked: False\nwidth of each page in points: [100.0, 200.0, 300.0]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "Extracting text: stream order and the black box"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 9 of the deck and runs 15 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 3 ;
    sen0414:code "import base64, io, zlib, pypdf\nblob = ('eNq1kF9PgzAUxd/5FPdliT5oW6DAzMLD/sVEjcvAp2UP3SjIgtS0nW5+etsNRx'\n        'BfLUlJT8+95/46WEznN+TWdwhgEJudMxqh9PjO0YRpVokCLVjBFbjmdhnHDq8z'\n        'a3J/mU8m9FBmauVbJwR2X6OJ2Nca3LbQ+1U4F7VGyX6j7cEqBI2Z4if5nlcfXJ'\n        'db1pb7f+SaTXKbYiPRE89KNhaHFTZHD2OI8BotuRJ7ueXK1NnW9kfAOzPFsRmz'\n        '1qaFAtrFpG3cI68L/QqhZVFacvbmjFOwbUgEaQ6EYvAxpBlcfQpZZdeQ7mCWQs'\n        'fkXjyGrRKNx6Y1LZvc4J8xwy5m2MekfUy/S5CwisnjHRAXmwUvyfQHGZ8+WZg3'\n        'MaOB69oJQXLI+6QHyXPHTO/gy4KAUo9CDq02hPNN3WrU72mEkL4W9n1uRHuaj/'\n        'saJUGracnKikv7Rkn5xSFCSyE0kOYllWZSn2ACb+gMBrPnufMNU9nkUQ==')\npdf = zlib.decompress(base64.b64decode(blob))\nreader = pypdf.PdfReader(io.BytesIO(pdf))\nprint('stream order:', repr(reader.pages[0].extract_text()))\nlayout = reader.pages[0].extract_text(extraction_mode='layout')\nprint('layout mode:', layout.split())\nprint('under the black box:', reader.pages[1].extract_text())" ; sen0414:expectedOutput "stream order: 'worldHello'\nlayout mode: ['Hello', 'world']\nunder the black box: Salary: 120000 USD\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Post-processing extracted text"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 11 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 11 ; sen0414:orderInTab 4 ;
    sen0414:code "import re\nraw = 'The ﬁrst chap-\\nter was long.\\nIt had two\\nlines.'\nprint(repr(raw))\ntext = raw.replace('ﬁ', 'fi')\ntext = re.sub(r'-\\n', '', text)\ntext = re.sub(r'(?<!\\.)\\n', ' ', text)\nprint(repr(text))\nprompt = 'Fix the line breaks of this text:\\n' + raw\nn = len(prompt.split())\nprint(len(raw.split()), 'words in; a prompt of', n, 'words')" ; sen0414:expectedOutput "'The ﬁrst chap-\\nter was long.\\nIt had two\\nlines.'\n'The first chapter was long.\\nIt had two lines.'\n10 words in; a prompt of 17 words\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "Extracting images, and a page with no text"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 12 of the deck and runs 12 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 12 ; sen0414:orderInTab 5 ;
    sen0414:code "import io, os, tempfile, pypdf\nfrom PIL import Image\nbuf = io.BytesIO()\nImage.new('RGB', (60, 40), 'red').save(buf, 'PDF')\npage = pypdf.PdfReader(buf).pages[0]\nprint('text found:', repr(page.extract_text()))\nprint('images found:', len(page.images))\nos.chdir(tempfile.mkdtemp())\nfor i, image in enumerate(page.images, 1):\n    open('page1_%d.bin' % i, 'wb').write(image.data)\nsize = Image.open(io.BytesIO(page.images[0].data)).size\nprint(os.listdir('.'), size)" ; sen0414:expectedOutput "text found: ''\nimages found: 1\n['page1_1.bin'] (60, 40)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Copying pages: a tuple is a range"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 16 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 6 ;
    sen0414:code "import io, pypdf\nsrc = pypdf.PdfWriter()\nfor n in range(1, 7): src.add_blank_page(100 * n, 100)\nbuf = io.BytesIO()\nsrc.write(buf)\ndef pick(pages):\n    w = pypdf.PdfWriter()\n    w.append(io.BytesIO(buf.getvalue()), pages)\n    return [int(p.mediabox.width) // 100 for p in w.pages]\nfor pages in ((0, 5), (0, 5, 2), [0, 5]):\n    print(pages, '->', pick(pages))" ; sen0414:expectedOutput "(0, 5) -> [1, 2, 3, 4, 5]\n(0, 5, 2) -> [1, 3, 5]\n[0, 5] -> [1, 6]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "merge() and blank pages"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 17 of the deck and runs 12 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 17 ; sen0414:orderInTab 7 ;
    sen0414:code "import io, pypdf\nw = pypdf.PdfWriter()\nfor n in (1, 2, 3): w.add_blank_page(100 * n, 100)\nother = pypdf.PdfWriter()\nfor n in (7, 8): other.add_blank_page(100 * n, 100)\nbuf = io.BytesIO()\nother.write(buf)\ndef sizes(): return [int(p.mediabox.width) for p in w.pages]\nw.merge(1, buf, pages=(0, 2))\nprint('after merge at 1:', sizes())\nw.insert_blank_page(index=2)\nprint('after insert_blank_page:', sizes())" ; sen0414:expectedOutput "after merge at 1: [100, 700, 800, 200, 300]\nafter insert_blank_page: [100, 700, 800, 800, 200, 300]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Rotating pages"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 18 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 18 ; sen0414:orderInTab 8 ;
    sen0414:code "import pypdf\npage = pypdf.PdfWriter().add_blank_page(100, 100)\nprint('start:', page.rotation)\nseen = [page.rotate(angle).rotation for angle in (90, 270, -90, 180)]\nprint('rotation after each turn:', seen)\ntry:\n    page.rotate(45)\nexcept ValueError:\n    print('45 degrees refused: use multiples of 90')" ; sen0414:expectedOutput "start: 0\nrotation after each turn: [90, 360, 270, 450]\n45 degrees refused: use multiples of 90\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Watermarks and overlays"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 20 of the deck and runs 12 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 20 ; sen0414:orderInTab 9 ;
    sen0414:code "import io, pypdf\nfrom PIL import Image\ndef page_with(size, color):\n    buf = io.BytesIO()\n    Image.new('RGB', size, color).save(buf, 'PDF')\n    return pypdf.PdfReader(buf).pages[0]\nbase = page_with((60, 40), 'blue')\ntop = page_with((30, 20), 'red')\nbefore = len(base.images)\nbase.merge_page(top)\nprint('images:', before, '->', len(base.images))\nprint('drawn first to last:', [im.image.size for im in base.images])" ; sen0414:expectedOutput "images: 1 -> 2\ndrawn first to last: [(60, 40), (30, 20)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "Encrypt and decrypt"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 21 of the deck and runs 13 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 21 ; sen0414:orderInTab 10 ;
    sen0414:code "import io, pypdf\nwriter = pypdf.PdfWriter()\nwriter.add_blank_page(100, 100)\nwriter.encrypt('userpw', algorithm='AES-256')\nbuf = io.BytesIO()\nwriter.write(buf)\nreader = pypdf.PdfReader(buf)\nprint('locked:', reader.is_encrypted)\ntry: reader.pages[0]\nexcept Exception as e: print('refused:', type(e).__name__)\nfor guess in ('wrong', 'userpw'):\n    print(repr(guess), '->', reader.decrypt(guess).name)\nprint(len(reader.pages), 'page after decrypt')" ; sen0414:expectedOutput "locked: True\nrefused: FileNotDecryptedError\n'wrong' -> NOT_DECRYPTED\n'userpw' -> OWNER_PASSWORD\n1 page after decrypt\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "User and owner passwords"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 23 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 11 ;
    sen0414:code "import io, pypdf\nwriter = pypdf.PdfWriter()\nwriter.add_blank_page(100, 100)\nwriter.encrypt(user_password='open-me', owner_password='boss',\n               algorithm='AES-256')\nbuf = io.BytesIO()\nwriter.write(buf)\nfor pw in ('open-me', 'boss', 'guess'):\n    reader = pypdf.PdfReader(io.BytesIO(buf.getvalue()))\n    print(pw, '->', reader.decrypt(pw).name)" ; sen0414:expectedOutput "open-me -> USER_PASSWORD\nboss -> OWNER_PASSWORD\nguess -> NOT_DECRYPTED\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "Which lock was used"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 24 of the deck and runs 12 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 12 ;
    sen0414:code "import io, pypdf\ndef lock(**options):\n    w = pypdf.PdfWriter()\n    w.add_blank_page(100, 100)\n    w.encrypt('pw', **options)\n    b = io.BytesIO()\n    w.write(b)\n    return pypdf.PdfReader(b).trailer['/Encrypt']\nfor algo in (None, 'AES-128', 'AES-256'):\n    e = lock(algorithm=algo)\n    v, r, bits = e['/V'], e['/R'], e['/Length']\n    print('%s: V=%d R=%d bits=%d' % (algo, v, r, bits))" ; sen0414:expectedOutput "None: V=2 R=3 bits=128\nAES-128: V=4 R=4 bits=128\nAES-256: V=5 R=6 bits=256\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Project 12, step 1: find the PDF files"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 26 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 13 ;
    sen0414:code "import os, tempfile\nos.chdir(tempfile.mkdtemp())\nfor name in ('b.pdf', 'A.pdf', 'c.PDF', 'notes.txt'):\n    open(name, 'w').close()\npdf_filenames = []\nfor filename in os.listdir('.'):\n    if filename.lower().endswith('.pdf'):\n        pdf_filenames.append(filename)\npdf_filenames.sort(key=str.lower)\nprint(pdf_filenames)" ; sen0414:expectedOutput "['A.pdf', 'b.pdf', 'c.PDF']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "Project 12, steps 2 and 3: combine and save"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 27 of the deck and runs 14 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 27 ; sen0414:orderInTab 14 ;
    sen0414:code "import os, tempfile, pypdf\nos.chdir(tempfile.mkdtemp())\nw = pypdf.PdfWriter()\nw.add_blank_page(100, 100)\nfor name in ('b.pdf', 'A.pdf', 'c.PDF'):\n    w.add_blank_page(100, 100)\n    w.write(name)\npdf_filenames = ['A.pdf', 'b.pdf', 'c.PDF']\nwriter = pypdf.PdfWriter()\nfor name in pdf_filenames:\n    writer.append(name, (1, len(pypdf.PdfReader(name).pages)))\nwriter.write('combined.pdf')\nsizes = [len(pypdf.PdfReader(n).pages) for n in pdf_filenames]\nprint(sizes, 'pages ->', len(pypdf.PdfReader('combined.pdf').pages))" ; sen0414:expectedOutput "[3, 2, 4] pages -> 6\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "A .docx file is a ZIP of XML"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 31 of the deck and runs 12 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 31 ; sen0414:orderInTab 15 ;
    sen0414:code "import io, zipfile, docx\ndoc = docx.Document()\ndoc.add_paragraph('Hello, world!')\nbuf = io.BytesIO()\ndoc.save(buf)\nprint(buf.getvalue()[:2], 'starts every ZIP file')\nz = zipfile.ZipFile(buf)\nnames = z.namelist()\npart = 'word/document.xml'\nprint(len(names), 'parts;', part, 'in names:', part in names)\nbody = z.read(part).decode().split('<w:body>')[1]\nprint(body[:46])" ; sen0414:expectedOutput "b'PK' starts every ZIP file\n17 parts; word/document.xml in names: True\n<w:p><w:r><w:t>Hello, world!</w:t></w:r></w:p>\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "Paragraphs and runs"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 32 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 16 ;
    sen0414:code "import docx\ndoc = docx.Document()\np = doc.add_paragraph('A plain ')\np.add_run('bold').bold = True\np.add_run(' word.')\ntable = doc.add_table(rows=1, cols=1)\ntable.cell(0, 0).text = 'in a table'\nprint([x.text for x in doc.paragraphs])\nprint([(r.text, r.bold) for r in p.runs])\nprint('table text is kept apart:', doc.tables[0].cell(0, 0).text)" ; sen0414:expectedOutput "['A plain bold word.']\n[('A plain ', None), ('bold', True), (' word.', None)]\ntable text is kept apart: in a table\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "Getting the full text of a .docx file"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 33 of the deck and runs 12 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 33 ; sen0414:orderInTab 17 ;
    sen0414:code "import io, docx\ndoc = docx.Document()\nfor line in ('Title line', 'First paragraph.', 'Second paragraph.'):\n    doc.add_paragraph(line)\nbuf = io.BytesIO()\ndoc.save(buf)\ndef get_text(source):\n    doc = docx.Document(source)\n    return '\\n'.join(p.text for p in doc.paragraphs)\ntext = get_text(io.BytesIO(buf.getvalue()))\nprint(text)\nprint(len(text.split('\\n')), 'lines,', len(text.split()), 'words')" ; sen0414:expectedOutput "Title line\nFirst paragraph.\nSecond paragraph.\n3 lines, 6 words\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "Styles: paragraph kind and run kind"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 35 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 18 ;
    sen0414:code "import docx\ndoc = docx.Document()\np = doc.add_paragraph('Quoted words')\np.style = 'Quote'\nprint('paragraph style:', p.style.name)\nrun = p.add_run(' and a run')\nrun.style = 'Quote Char'\nprint('run style:', run.style.name)\nprint(len(doc.styles), 'styles in a new document')" ; sen0414:expectedOutput "paragraph style: Quote\nrun style: Quote Char\n164 styles in a new document\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "Styles: the kind and the exact name"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 36 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 36 ; sen0414:orderInTab 19 ;
    sen0414:code "import docx\ndoc = docx.Document()\np = doc.add_paragraph('Quoted words')\ntry: p.style = 'Quote Char'\nexcept ValueError: print('a paragraph refuses a character style')\ntry: doc.add_paragraph('x', 'List Number ')\nexcept KeyError: print('style not found: names match exactly')\ndoc.add_paragraph('x', 'List Number')\nprint('List Number found:', doc.paragraphs[-1].style.name)" ; sen0414:expectedOutput "a paragraph refuses a character style\nstyle not found: names match exactly\nList Number found: List Number\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "Run attributes: three states"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 38 of the deck and runs 12 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 38 ; sen0414:orderInTab 20 ;
    sen0414:code "import docx\ndoc = docx.Document()\nrun = doc.add_paragraph().add_run('text')\nfor value in (True, False, None):\n    run.bold = value\n    print('bold =', value, '-> reads back', run.bold)\nrun.italic, run.underline = True, True\nprint('italic:', run.italic, '| underline:', run.underline)\nrun.strike = True\nprint('run.strike ->', run.font.strike)\nrun.font.strike = True\nprint('run.font.strike ->', run.font.strike)" ; sen0414:expectedOutput "bold = True -> reads back True\nbold = False -> reads back False\nbold = None -> reads back None\nitalic: True | underline: True\nrun.strike -> None\nrun.font.strike -> True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "Writing paragraphs and runs"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 42 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 42 ; sen0414:orderInTab 21 ;
    sen0414:code "import io, docx\ndoc = docx.Document()\np = doc.add_paragraph('Hello world!')\nr = p.add_run(' A second run.')\nr.italic = True\nprint(type(p).__name__, type(r).__name__)\nbuf = io.BytesIO()\ndoc.save(buf)\nagain = docx.Document(buf)\ntexts = [r.text for r in again.paragraphs[0].runs]\nprint(len(again.paragraphs), 'paragraph; runs:', texts)" ; sen0414:expectedOutput "Paragraph Run\n1 paragraph; runs: ['Hello world!', ' A second run.']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
pg:CE_22 a ipo:CodeExample ; rdfs:label "Adding headings"@en ;
    skos:definition "Example 22 of the chapter-code tab comes from slide 43 of the deck and runs 7 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 43 ; sen0414:orderInTab 22 ;
    sen0414:code "import docx\ndoc = docx.Document()\nfor level in (0, 1, 9):\n    h = doc.add_heading('Heading %d' % level, level)\n    print('level', level, '->', h.style.name)\ntry: doc.add_heading('Too deep', 10)\nexcept ValueError: print('level 10 refused: levels are 0 to 9')" ; sen0414:expectedOutput "level 0 -> Title\nlevel 1 -> Heading 1\nlevel 9 -> Heading 9\nlevel 10 refused: levels are 0 to 9\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_22 .
pg:CE_23 a ipo:CodeExample ; rdfs:label "Line and page breaks"@en ;
    skos:definition "Example 23 of the chapter-code tab comes from slide 44 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 44 ; sen0414:orderInTab 23 ;
    sen0414:code "import docx\nfrom docx.enum.text import WD_BREAK\ndoc = docx.Document()\np = doc.add_paragraph('First line')\np.add_run().add_break(WD_BREAK.LINE)\np.add_run('second line, same paragraph')\ndoc.add_page_break()\ndoc.add_paragraph('Second page')\nxml = doc.element.xml\npages = xml.count('w:type='page'')\nprint(pages, 'page break;', xml.count('<w:br'), 'breaks in all')" ; sen0414:expectedOutput "1 page break; 2 breaks in all\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_23 .
pg:CE_24 a ipo:CodeExample ; rdfs:label "Adding pictures"@en ;
    skos:definition "Example 24 of the chapter-code tab comes from slide 46 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 46 ; sen0414:orderInTab 24 ;
    sen0414:code "import io, docx\nfrom PIL import Image\nfrom docx.shared import Cm, Inches\npng = io.BytesIO()\nImage.new('RGB', (60, 80), 'red').save(png, 'PNG')\ndoc = docx.Document()\nsizes = {'as is': {}, '1 inch wide': {'width': Inches(1)},\n         '2 cm high': {'height': Cm(2)}}\nfor label, kw in sizes.items():\n    shape = doc.add_picture(io.BytesIO(png.getvalue()), **kw)\n    print(label, '->', int(shape.width), 'x', int(shape.height), 'EMU')" ; sen0414:expectedOutput "as is -> 762000 x 1016000 EMU\n1 inch wide -> 914400 x 1219200 EMU\n2 cm high -> 540000 x 720000 EMU\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_24 .
pg:CE_25 a ipo:CodeExample ; rdfs:label "Practice program: PDF Paranoia, walk the tree"@en ;
    skos:definition "Example 25 of the chapter-code tab comes from slide 50 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 50 ; sen0414:orderInTab 25 ;
    sen0414:code "import os, tempfile\nos.chdir(tempfile.mkdtemp())\nos.makedirs('tree/sub')\nfor path in ('tree/a.pdf', 'tree/sub/B.PDF', 'tree/c.txt'):\n    open(path, 'w').close()\nfound = []\nfor folder, dirs, names in os.walk('tree'):\n    for name in names:\n        if name.lower().endswith('.pdf'):\n            found.append(os.path.join(folder, name))\nprint(sorted(found))" ; sen0414:expectedOutput "['tree/a.pdf', 'tree/sub/B.PDF']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_25 .
pg:CE_26 a ipo:CodeExample ; rdfs:label "Practice program: PDF Paranoia, lock and check"@en ;
    skos:definition "Example 26 of the chapter-code tab comes from slide 51 of the deck and runs 12 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 51 ; sen0414:orderInTab 26 ;
    sen0414:code "import os, tempfile, pypdf\nos.chdir(tempfile.mkdtemp())\nw = pypdf.PdfWriter()\nw.add_blank_page(100, 100)\nw.write('a.pdf')\nw = pypdf.PdfWriter(clone_from='a.pdf')\nw.encrypt('swordfish', algorithm='AES-256')\nw.write('a_encrypted.pdf')\nr = pypdf.PdfReader('a_encrypted.pdf')\nok = r.is_encrypted and r.decrypt('swordfish').name != 'NOT_DECRYPTED'\nif ok: os.remove('a.pdf')\nprint(ok, os.listdir('.'))" ; sen0414:expectedOutput "True ['a_encrypted.pdf']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_26 .
pg:CE_27 a ipo:CodeExample ; rdfs:label "Practice program: Custom Invitations"@en ;
    skos:definition "Example 27 of the chapter-code tab comes from slide 52 of the deck and runs 12 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 52 ; sen0414:orderInTab 27 ;
    sen0414:code "import docx\ndoc = docx.Document()\nguests = ['Prof. Plum', 'Miss Scarlet', 'Col. Mustard']\nfor i, guest in enumerate(guests):\n    doc.add_paragraph('You are invited,')\n    doc.add_paragraph(guest, 'Title')\n    if i < len(guests) - 1:\n        doc.add_page_break()\nnames = [p.text for p in doc.paragraphs if p.style.name == 'Title']\nxml = doc.element.xml\nprint(len(names), 'guests;', xml.count('w:type='page''), 'page breaks')\nprint(names)" ; sen0414:expectedOutput "3 guests; 2 page breaks\n['Prof. Plum', 'Miss Scarlet', 'Col. Mustard']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_27 .
pg:CE_28 a ipo:CodeExample ; rdfs:label "Practice program: PDF Password Breaker"@en ;
    skos:definition "Example 28 of the chapter-code tab comes from slide 53 of the deck and runs 12 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch17/page/chapter_code_ch17_v1_0_0.json" ;
    sen0414:slideNumber 53 ; sen0414:orderInTab 28 ;
    sen0414:code "import io, pypdf\nwords = ['apple', 'banana', 'cherry', 'dragonfruit']\nw = pypdf.PdfWriter()\nw.add_blank_page(100, 100)\nw.encrypt('CHERRY', algorithm='AES-256')\nbuf = io.BytesIO()\nw.write(buf)\nreader = pypdf.PdfReader(buf)\ntries = [g for x in words for g in (x, x.upper())]\nfor attempts, guess in enumerate(tries, 1):\n    if reader.decrypt(guess).name != 'NOT_DECRYPTED': break\nprint('found', guess, 'after', attempts, 'of at most', len(tries))" ; sen0414:expectedOutput "found CHERRY after 6 of at most 8\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_28 .
