= re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\nimport time\\nsleeps = []\\ntime.sleep = sleeps.append\\ng = install()\\nezsheets.IGNORE_QUOTA = False\\ng.fail = [(429, \\'RESOURCE_EXHAUSTED\\')] * 20\\ntry:\\n    ezsheets.Spreadsheet()\\nexcept Exception as e:\\n    err = type(e).__name__\\nout = (err, len(g.log), sleeps)') evaluates to ('HttpError', 9, [10, 15, 20, 25, 30, 35, 40, 45])"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\nimport time\\nsleeps = []\\ntime.sleep = sleeps.append\\ng = install()\\nezsheets.IGNORE_QUOTA = False\\ng.fail = [(429, \\'RESOURCE_EXHAUSTED\\')] * 20\\ntry:\\n    ezsheets.Spreadsheet()\\nexcept Exception as e:\\n    err = type(e).__name__\\nout = (err, len(g.log), sleeps)')" ; chx:output "('HttpError', 9, [10, 15, 20, 25, 30, 35, 40, 45])" .
chx:X_RetryOnQuota rd:hasIOExample chx:IO_RetryOnQuota .
chx:X_IgnoreQuotaFlag a owl:NamedIndividual, chx:IgnoreQuotaFlag ; rdfs:label "ezsheets.IGNORE_QUOTA = True"@en ; skos:definition "IGNORE_QUOTA switches off only the library's own throttle; the retry on RESOURCE_EXHAUSTED is the same whether it is True or False, so it does not make Google's quota go away."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_IgnoreQuotaFlag a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\nimport time\\nsleeps = []\\ntime.sleep = sleeps.append\\nres = []\\nfor flag in (False, True):\\n    g = install(); ezsheets.IGNORE_QUOTA = flag; sleeps.clear()\\n    g.fail = [(429, \\'RESOURCE_EXHAUSTED\\')] * 20\\n    try:\\n        ezsheets.Spreadsheet()\\n    except Exception as e:\\n        pass\\n    res.append((flag, len(g.log), list(sleeps)))\\nout = res') evaluates to [(False, 9, [10, 15, 20, 25, 30, 35, 40, 45]), (True, 9, [10, 15, 20, 25, 30, 35, 40, 45])]"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\nimport time\\nsleeps = []\\ntime.sleep = sleeps.append\\nres = []\\nfor flag in (False, True):\\n    g = install(); ezsheets.IGNORE_QUOTA = flag; sleeps.clear()\\n    g.fail = [(429, \\'RESOURCE_EXHAUSTED\\')] * 20\\n    try:\\n        ezsheets.Spreadsheet()\\n    except Exception as e:\\n        pass\\n    res.append((flag, len(g.log), list(sleeps)))\\nout = res')" ; chx:output "[(False, 9, [10, 15, 20, 25, 30, 35, 40, 45]), (True, 9, [10, 15, 20, 25, 30, 35, 40, 45])]" .
chx:X_IgnoreQuotaFlag rd:hasIOExample chx:IO_IgnoreQuotaFlag .
chx:X_CellLimit a owl:NamedIndividual, chx:CellLimit ; rdfs:label "Google Drive Help: files you can store in Drive"@en ; skos:definition "Google's Drive Help gives the limit of a Google Sheets spreadsheet as up to 20 million cells or 100 MB, where the chapter says 10 million cells. NOT EXECUTED: the limit is Google's, and filling a sheet to it was not tried."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_AuditProgram a owl:NamedIndividual, chx:AuditProgram ; rdfs:label "Project 11, Step 1: for row in ss.sheets[0].getRows(): ..."@en ; skos:definition "The audit program reads every row of the Boringcoin sheet into a dictionary of balances, treats the sender PRE-MINE as money made from nothing, and checks that the balances add up to the billion coins that were made."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_AuditProgram a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\nss = ezsheets.Spreadsheet(); ss.title = \\'Boringcoin\\'\\nsheet = ss.sheets[0]\\nsheet.updateRows([[\\'PRE-MINE\\', \\'Al Sweigart\\', \\'1000000000\\'], [\\'Al Sweigart\\', \\'Miles Bron\\', \\'19116\\'], [\\'Miles Bron\\', \\'not_a_scammer\\', \\'118\\'], [\\'Al Sweigart\\', \\'some hacker\\', \\'16273\\']])\\nsheet.rowCount = 4\\naccounts = {}\\nfor row in ss.sheets[0].getRows():\\n    sender, recipient, amount = row[0], row[1], int(row[2])\\n    if sender == \\'PRE-MINE\\':\\n        accounts.setdefault(recipient, 0)\\n        accounts[recipient] += amount\\n    else:\\n        accounts.setdefault(sender, 0)\\n        accounts.setdefault(recipient, 0)\\n        accounts[sender] -= amount\\n        accounts[recipient] += amount\\nout = (accounts, sum(accounts.values()))') evaluates to ({'Al Sweigart': 999964611, 'Miles Bron': 18998, 'not_a_scammer': 118, 'some hacker': 16273}, 1000000000)"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\nss = ezsheets.Spreadsheet(); ss.title = \\'Boringcoin\\'\\nsheet = ss.sheets[0]\\nsheet.updateRows([[\\'PRE-MINE\\', \\'Al Sweigart\\', \\'1000000000\\'], [\\'Al Sweigart\\', \\'Miles Bron\\', \\'19116\\'], [\\'Miles Bron\\', \\'not_a_scammer\\', \\'118\\'], [\\'Al Sweigart\\', \\'some hacker\\', \\'16273\\']])\\nsheet.rowCount = 4\\naccounts = {}\\nfor row in ss.sheets[0].getRows():\\n    sender, recipient, amount = row[0], row[1], int(row[2])\\n    if sender == \\'PRE-MINE\\':\\n        accounts.setdefault(recipient, 0)\\n        accounts[recipient] += amount\\n    else:\\n        accounts.setdefault(sender, 0)\\n        accounts.setdefault(recipient, 0)\\n        accounts[sender] -= amount\\n        accounts[recipient] += amount\\nout = (accounts, sum(accounts.values()))')" ; chx:output "({'Al Sweigart': 999964611, 'Miles Bron': 18998, 'not_a_scammer': 118, 'some hacker': 16273}, 1000000000)" .
