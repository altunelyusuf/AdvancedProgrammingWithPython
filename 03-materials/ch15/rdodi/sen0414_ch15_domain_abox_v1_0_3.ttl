chx:X_ColumnLetters a owl:NamedIndividual, chx:ColumnLetters ; rdfs:label "ezsheets.getColumnLetterOf(999)"@en ; skos:definition "getColumnLetterOf converts a column number to letters, 999 to ALK and 18278 to ZZZ, and raises ValueError for a number below 1 and TypeError for a value that is not an integer."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ColumnLetters a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nres = []\\nfor bad in (0, \\'A\\', 1.5):\\n    try:\\n        ezsheets.getColumnLetterOf(bad)\\n    except Exception as e:\\n        res.append(type(e).__name__)\\nout = ([ezsheets.getColumnLetterOf(n) for n in (1, 2, 26, 27, 52, 702, 703, 999, 18278)], res)') evaluates to (['A', 'B', 'Z', 'AA', 'AZ', 'ZZ', 'AAA', 'ALK', 'ZZZ'], ['ValueError', 'TypeError', 'TypeError'])"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nres = []\\nfor bad in (0, \\'A\\', 1.5):\\n    try:\\n        ezsheets.getColumnLetterOf(bad)\\n    except Exception as e:\\n        res.append(type(e).__name__)\\nout = ([ezsheets.getColumnLetterOf(n) for n in (1, 2, 26, 27, 52, 702, 703, 999, 18278)], res)')" ; chx:output "(['A', 'B', 'Z', 'AA', 'AZ', 'ZZ', 'AAA', 'ALK', 'ZZZ'], ['ValueError', 'TypeError', 'TypeError'])" .
chx:X_ColumnLetters rd:hasIOExample chx:IO_ColumnLetters .
chx:X_ColumnNumbers a owl:NamedIndividual, chx:ColumnNumbers ; rdfs:label "ezsheets.getColumnNumberOf('ZZZ')"@en ; skos:definition "getColumnNumberOf converts letters to a number, ignores case, and is the inverse of getColumnLetterOf for every number from 1 to 20000."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ColumnNumbers a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nres = []\\nfor bad in (\\'A1\\', \\'\\', 5):\\n    try:\\n        ezsheets.getColumnNumberOf(bad)\\n    except Exception as e:\\n        res.append(type(e).__name__)\\nout = ([ezsheets.getColumnNumberOf(s) for s in (\\'A\\', \\'B\\', \\'Z\\', \\'AA\\', \\'zz\\', \\'ZZZ\\')], all(ezsheets.getColumnNumberOf(ezsheets.getColumnLetterOf(n)) == n for n in range(1, 20001)), res)') evaluates to ([1, 2, 26, 27, 702, 18278], True, ['ValueError', 'ValueError', 'TypeError'])"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nres = []\\nfor bad in (\\'A1\\', \\'\\', 5):\\n    try:\\n        ezsheets.getColumnNumberOf(bad)\\n    except Exception as e:\\n        res.append(type(e).__name__)\\nout = ([ezsheets.getColumnNumberOf(s) for s in (\\'A\\', \\'B\\', \\'Z\\', \\'AA\\', \\'zz\\', \\'ZZZ\\')], all(ezsheets.getColumnNumberOf(ezsheets.getColumnLetterOf(n)) == n for n in range(1, 20001)), res)')" ; chx:output "([1, 2, 26, 27, 702, 18278], True, ['ValueError', 'ValueError', 'TypeError'])" .
chx:X_ColumnNumbers rd:hasIOExample chx:IO_ColumnNumbers .
chx:X_RangeNotation a owl:NamedIndividual, chx:RangeNotation ; rdfs:label "'Sheet1!A3:D3'"@en ; skos:definition "Every write names its range in A1 notation as the sheet title, an exclamation mark and two addresses, with no quotes around the title even when it holds a space; a row write names the whole width, A3:Z3, a column write the whole height, B1:B1000, and the major dimension is ROWS or COLUMNS."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_RangeNotation a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\nsheet = ezsheets.Spreadsheet().sheets[0]\\nsheet[\\'B2\\'] = \\'x\\'; sheet.updateRow(3, [\\'a\\', \\'b\\', \\'c\\', \\'d\\']); sheet.updateColumn(2, [\\'1\\', \\'2\\', \\'3\\'])\\nsheet.title = \\'My Sheet\\'; sheet[\\'A1\\'] = \\'y\\'\\nout = [(p.rsplit(\\'/\\', 1)[1], b[\\'majorDimension\\']) for m, p, q, b in g.log if m == \\'PUT\\']') evaluates to [('Sheet1!B2:B2', 'ROWS'), ('Sheet1!A3:Z3', 'ROWS'), ('Sheet1!B1:B1000', 'COLUMNS'), ('My Sheet!A1:A1', 'ROWS')]"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\nsheet = ezsheets.Spreadsheet().sheets[0]\\nsheet[\\'B2\\'] = \\'x\\'; sheet.updateRow(3, [\\'a\\', \\'b\\', \\'c\\', \\'d\\']); sheet.updateColumn(2, [\\'1\\', \\'2\\', \\'3\\'])\\nsheet.title = \\'My Sheet\\'; sheet[\\'A1\\'] = \\'y\\'\\nout = [(p.rsplit(\\'/\\', 1)[1], b[\\'majorDimension\\']) for m, p, q, b in g.log if m == \\'PUT\\']')" ; chx:output "[('Sheet1!B2:B2', 'ROWS'), ('Sheet1!A3:Z3', 'ROWS'), ('Sheet1!B1:B1000', 'COLUMNS'), ('My Sheet!A1:A1', 'ROWS')]" .
