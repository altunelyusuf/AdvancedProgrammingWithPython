chx:X_CloudProjectIds a owl:NamedIndividual, chx:CloudProjectIds ; rdfs:label "Google Cloud console: create a project; the project name can be changed, the project ID cannot"@en ; skos:definition "Every Google Cloud project has a name that may be changed and a project ID that may not; the chapter has the reader create one project to hold the API switches and the OAuth credentials of the scripts. NOT EXECUTED: it needs a Google account and the console."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_ApiEnablement a owl:NamedIndividual, chx:ApiEnablement ; rdfs:label "ezsheets.SHEETS_SERVICE._baseUrl"@en ; skos:definition "ezsheets builds a client for the Sheets API v4 at https://sheets.googleapis.com/ and one for the Drive API v3 at https://www.googleapis.com/drive/v3/, so a project must have both APIs switched on; the clients are built here without a network."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ApiEnablement a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\nout = (ezsheets.SHEETS_SERVICE._baseUrl, ezsheets.DRIVE_SERVICE._baseUrl)') evaluates to ('https://sheets.googleapis.com/', 'https://www.googleapis.com/drive/v3/')"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\nout = (ezsheets.SHEETS_SERVICE._baseUrl, ezsheets.DRIVE_SERVICE._baseUrl)')" ; chx:output "('https://sheets.googleapis.com/', 'https://www.googleapis.com/drive/v3/')" .
chx:X_ApiEnablement rd:hasIOExample chx:IO_ApiEnablement .
chx:X_ConsentScreenUi a owl:NamedIndividual, chx:ConsentScreenUi ; rdfs:label "Google Auth platform: Branding, Audience, Data Access"@en ; skos:definition "The consent-screen wizard that the chapter walks through is now three pages of the Google Auth platform in the console, Branding, Audience and Data Access. NOT EXECUTED: the console needs a Google account."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_ScopesChosen a owl:NamedIndividual, chx:ScopesChosen ; rdfs:label "ezsheets.SCOPES_SHEETS, ezsheets.SCOPES_DRIVE"@en ; skos:definition "ezsheets asks for the whole spreadsheets scope for the Sheets client and the whole drive scope for the Drive client; Google calls the first sensitive and the second restricted, and recommends the narrower drive.file scope where it is enough."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ScopesChosen a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nout = (ezsheets.SCOPES_SHEETS, ezsheets.SCOPES_DRIVE)') evaluates to (['https://www.googleapis.com/auth/spreadsheets'], ['https://www.googleapis.com/auth/drive'])"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nout = (ezsheets.SCOPES_SHEETS, ezsheets.SCOPES_DRIVE)')" ; chx:output "(['https://www.googleapis.com/auth/spreadsheets'], ['https://www.googleapis.com/auth/drive'])" .
chx:X_ScopesChosen rd:hasIOExample chx:IO_ScopesChosen .
chx:X_TestUsers a owl:NamedIndividual, chx:TestUsers ; rdfs:label "Audience: publishing status Testing, user type External, test users"@en ; skos:definition "An app whose publishing status is Testing is limited to 100 test users, and its authorizations expire after seven days. NOT EXECUTED: it needs a project and a consent screen."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_TokenLifetime a owl:NamedIndividual, chx:TokenLifetime ; rdfs:label "pickle.load(open('token-sheets.pickle', 'rb')).refresh(Request())"@en ; skos:definition "A token file whose access token has expired is refreshed with the refresh token at the first call; when Google refuses (a Testing app after seven days, a revoked grant) the library raises RefreshError and leaves the stale file in place. Google was not asked: in this example the refusal is played by a stand-in for Google's token endpoint (refresh() is replaced by a function that raises the error an invalid_grant answer makes it raise); the 3.14.6 study played it with a local server that answered invalid_grant."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_TokenLifetime a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import os, tempfile, json, pickle, datetime\\nos.chdir(tempfile.mkdtemp())\\njson.dump({\\'installed\\': {\\'client_id\\': \\'1-x.apps.googleusercontent.com\\', \\'project_id\\': \\'p\\', \\'auth_uri\\': \\'https://accounts.google.com/o/oauth2/auth\\', \\'token_uri\\': \\'https://oauth2.googleapis.com/token\\', \\'client_secret\\': \\'S\\', \\'redirect_uris\\': [\\'http://localhost\\']}}, open(\\'client_secret_1-x.apps.googleusercontent.com.json\\', \\'w\\'))\\nfrom google.oauth2.credentials import Credentials\\nfrom google.auth.exceptions import RefreshError\\n# Stand-in for Google: Google\\'s token endpoint is not asked; refresh() is replaced by a function that raises what an invalid_grant answer makes it raise\\nreal_refresh = Credentials.refresh\\ndef refuse(self, request):\\n    raise RefreshError(\\'invalid_grant: Token has been expired or revoked.\\', {\\'error\\': \\'invalid_grant\\', \\'error_description\\': \\'Token has been expired or revoked.\\'})\\nCredentials.refresh = refuse\\npickle.dump(Credentials(token=\\'old\\', refresh_token=\\'R\\', token_uri=\\'https://oauth2.googleapis.com/token\\', client_id=\\'1-x\\', client_secret=\\'S\\', expiry=datetime.datetime(2020, 1, 1)), open(\\'token-sheets.pickle\\', \\'wb\\'))\\nimport sys\\nsys.modules.pop(\\'ezsheets\\', None)\\nimport ezsheets\\ntry:\\n    ezsheets.init()\\nexcept Exception as e:\\n    out = (type(e).__name__, e.args[0], os.path.exists(\\'token-sheets.pickle\\'), os.path.exists(\\'token-drive.pickle\\'))\\nCredentials.refresh = real_refresh\\nsys.modules.pop(\\'ezsheets\\', None)') evaluates to ('RefreshError', 'invalid_grant: Token has been expired or revoked.', True, False)"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import os, tempfile, json, pickle, datetime\\nos.chdir(tempfile.mkdtemp())\\njson.dump({\\'installed\\': {\\'client_id\\': \\'1-x.apps.googleusercontent.com\\', \\'project_id\\': \\'p\\', \\'auth_uri\\': \\'https://accounts.google.com/o/oauth2/auth\\', \\'token_uri\\': \\'https://oauth2.googleapis.com/token\\', \\'client_secret\\': \\'S\\', \\'redirect_uris\\': [\\'http://localhost\\']}}, open(\\'client_secret_1-x.apps.googleusercontent.com.json\\', \\'w\\'))\\nfrom google.oauth2.credentials import Credentials\\nfrom google.auth.exceptions import RefreshError\\n# Stand-in for Google: Google\\'s token endpoint is not asked; refresh() is replaced by a function that raises what an invalid_grant answer makes it raise\\nreal_refresh = Credentials.refresh\\ndef refuse(self, request):\\n    raise RefreshError(\\'invalid_grant: Token has been expired or revoked.\\', {\\'error\\': \\'invalid_grant\\', \\'error_description\\': \\'Token has been expired or revoked.\\'})\\nCredentials.refresh = refuse\\npickle.dump(Credentials(token=\\'old\\', refresh_token=\\'R\\', token_uri=\\'https://oauth2.googleapis.com/token\\', client_id=\\'1-x\\', client_secret=\\'S\\', expiry=datetime.datetime(2020, 1, 1)), open(\\'token-sheets.pickle\\', \\'wb\\'))\\nimport sys\\nsys.modules.pop(\\'ezsheets\\', None)\\nimport ezsheets\\ntry:\\n    ezsheets.init()\\nexcept Exception as e:\\n    out = (type(e).__name__, e.args[0], os.path.exists(\\'token-sheets.pickle\\'), os.path.exists(\\'token-drive.pickle\\'))\\nCredentials.refresh = real_refresh\\nsys.modules.pop(\\'ezsheets\\', None)')" ; chx:output "('RefreshError', 'invalid_grant: Token has been expired or revoked.', True, False)" .
chx:X_TokenLifetime rd:hasIOExample chx:IO_TokenLifetime .
chx:X_CredentialsFile a owl:NamedIndividual, chx:CredentialsFile ; rdfs:label "ezsheets.init() with no, one or several client_secret files"@en ; skos:definition "init() looks in the current folder for the downloaded client_secret JSON file; with none it raises EZSheetsException naming the file it expected, and with several it raises EZSheetsException asking for the credentialsFile argument."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_CredentialsFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import os, tempfile, json\\nos.chdir(tempfile.mkdtemp())\\nimport ezsheets\\ntry:\\n    ezsheets.init()\\nexcept ezsheets.EZSheetsException as e:\\n    none = str(e)[:36]\\nfor n in (\\'client_secret_a.json\\', \\'client_secret_b.json\\'): open(n, \\'w\\').write(\\'{}\\')\\ntry:\\n    ezsheets.init()\\nexcept ezsheets.EZSheetsException as e:\\n    many = str(e)[:78]\\nout = (none, many)') evaluates to ('Can't find credentials file at /tmp/', 'You must specify a credentialsFile argument to init() because multiple possibl')"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import os, tempfile, json\\nos.chdir(tempfile.mkdtemp())\\nimport ezsheets\\ntry:\\n    ezsheets.init()\\nexcept ezsheets.EZSheetsException as e:\\n    none = str(e)[:36]\\nfor n in (\\'client_secret_a.json\\', \\'client_secret_b.json\\'): open(n, \\'w\\').write(\\'{}\\')\\ntry:\\n    ezsheets.init()\\nexcept ezsheets.EZSheetsException as e:\\n    many = str(e)[:78]\\nout = (none, many)')" ; chx:output "('Can't find credentials file at /tmp/', 'You must specify a credentialsFile argument to init() because multiple possibl')" .
chx:X_CredentialsFile rd:hasIOExample chx:IO_CredentialsFile .
chx:X_TokenFiles a owl:NamedIndividual, chx:TokenFiles ; rdfs:label "inspect.signature(ezsheets.init)"@en ; skos:definition "init() keeps the access and refresh tokens in two files of the current folder, token-sheets.pickle and token-drive.pickle, both defaults of its arguments sheetsTokenFile and driveTokenFile."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_TokenFiles a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets, inspect\\nout = str(inspect.signature(ezsheets.init))') evaluates to '(credentialsFile='.', sheetsTokenFile='token-sheets.pickle', driveTokenFile='token-drive.pickle', _raiseException=True)'"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets, inspect\\nout = str(inspect.signature(ezsheets.init))')" ; chx:output "'(credentialsFile='.', sheetsTokenFile='token-sheets.pickle', driveTokenFile='token-drive.pickle', _raiseException=True)'" .
chx:X_TokenFiles rd:hasIOExample chx:IO_TokenFiles .
chx:X_TokenPickle a owl:NamedIndividual, chx:TokenPickle ; rdfs:label "pickle.load(open('token-sheets.pickle', 'rb'))"@en ; skos:definition "A token file is a Python pickle that the library loads at import, and loading a pickle runs whatever code it holds, so a token file from another person is a program; a harmless marker file stands in for the code here."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_TokenPickle a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import os, tempfile, json, sys\\nos.chdir(tempfile.mkdtemp())\\nimport pickle\\nclass Evil:\\n    def __reduce__(self): return (exec, (\\'open(\\\\\\'PWNED.txt\\\\\\', \\\\\\'w\\\\\\').write(\\\\\\'ran\\\\\\')\\',))\\npickle.dump(Evil(), open(\\'token-sheets.pickle\\', \\'wb\\'))\\nopen(\\'credentials-sheets.json\\', \\'w\\').write(\\'{}\\')\\nsys.modules.pop(\\'ezsheets\\', None)\\nimport ezsheets\\nout = os.path.exists(\\'PWNED.txt\\')\\nsys.modules.pop(\\'ezsheets\\', None)') evaluates to True"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import os, tempfile, json, sys\\nos.chdir(tempfile.mkdtemp())\\nimport pickle\\nclass Evil:\\n    def __reduce__(self): return (exec, (\\'open(\\\\\\'PWNED.txt\\\\\\', \\\\\\'w\\\\\\').write(\\\\\\'ran\\\\\\')\\',))\\npickle.dump(Evil(), open(\\'token-sheets.pickle\\', \\'wb\\'))\\nopen(\\'credentials-sheets.json\\', \\'w\\').write(\\'{}\\')\\nsys.modules.pop(\\'ezsheets\\', None)\\nimport ezsheets\\nout = os.path.exists(\\'PWNED.txt\\')\\nsys.modules.pop(\\'ezsheets\\', None)')" ; chx:output "True" .
chx:X_TokenPickle rd:hasIOExample chx:IO_TokenPickle .
chx:X_RevokeCredentials a owl:NamedIndividual, chx:RevokeCredentials ; rdfs:label "Credentials page of the console: delete the OAuth 2.0 client of a shared credentials file"@en ; skos:definition "The chapter says that an accidentally shared credentials or token file is made useless by deleting its OAuth client in the console, after which new files must be made. NOT EXECUTED: it needs the console, and the Google pages read do not describe the step."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_LocalServerFlow a owl:NamedIndividual, chx:LocalServerFlow ; rdfs:label "InstalledAppFlow.run_local_server(port=8080)"@en ; skos:definition "The first sign-in builds an authorization URL at accounts.google.com with response_type code, a PKCE challenge (S256), access_type offline and a redirect to http://localhost:8080/, opens it in a browser, and waits on that port for the browser to be sent back with a code; the URL is built here without a network."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_LocalServerFlow a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import os, tempfile, json\\nos.chdir(tempfile.mkdtemp())\\njson.dump({\\'installed\\': {\\'client_id\\': \\'1-x.apps.googleusercontent.com\\', \\'project_id\\': \\'p\\', \\'auth_uri\\': \\'https://accounts.google.com/o/oauth2/auth\\', \\'token_uri\\': \\'https://oauth2.googleapis.com/token\\', \\'client_secret\\': \\'S\\', \\'redirect_uris\\': [\\'http://localhost\\']}}, open(\\'client_secret_1-x.apps.googleusercontent.com.json\\', \\'w\\'))\\nimport urllib.parse as up\\nfrom google_auth_oauthlib.flow import InstalledAppFlow\\nimport ezsheets\\nf = InstalledAppFlow.from_client_secrets_file(\\'client_secret_1-x.apps.googleusercontent.com.json\\', ezsheets.SCOPES_SHEETS)\\nf.redirect_uri = \\'http://localhost:8080/\\'\\nurl, state = f.authorization_url()\\nq = up.parse_qs(up.urlparse(url).query)\\nout = (up.urlparse(url).netloc, sorted(q), q[\\'scope\\'], q[\\'code_challenge_method\\'], q[\\'access_type\\'], q[\\'redirect_uri\\'])') evaluates to ('accounts.google.com', ['access_type', 'client_id', 'code_challenge', 'code_challenge_method', 'redirect_uri', 'response_type', 'scope', 'state'], ['https://www.googleapis.com/auth/spreadsheets'], ['S256'], ['offline'], ['http://localhost:8080/'])"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import os, tempfile, json\\nos.chdir(tempfile.mkdtemp())\\njson.dump({\\'installed\\': {\\'client_id\\': \\'1-x.apps.googleusercontent.com\\', \\'project_id\\': \\'p\\', \\'auth_uri\\': \\'https://accounts.google.com/o/oauth2/auth\\', \\'token_uri\\': \\'https://oauth2.googleapis.com/token\\', \\'client_secret\\': \\'S\\', \\'redirect_uris\\': [\\'http://localhost\\']}}, open(\\'client_secret_1-x.apps.googleusercontent.com.json\\', \\'w\\'))\\nimport urllib.parse as up\\nfrom google_auth_oauthlib.flow import InstalledAppFlow\\nimport ezsheets\\nf = InstalledAppFlow.from_client_secrets_file(\\'client_secret_1-x.apps.googleusercontent.com.json\\', ezsheets.SCOPES_SHEETS)\\nf.redirect_uri = \\'http://localhost:8080/\\'\\nurl, state = f.authorization_url()\\nq = up.parse_qs(up.urlparse(url).query)\\nout = (up.urlparse(url).netloc, sorted(q), q[\\'scope\\'], q[\\'code_challenge_method\\'], q[\\'access_type\\'], q[\\'redirect_uri\\'])')" ; chx:output "('accounts.google.com', ['access_type', 'client_id', 'code_challenge', 'code_challenge_method', 'redirect_uri', 'response_type', 'scope', 'state'], ['https://www.googleapis.com/auth/spreadsheets'], ['S256'], ['offline'], ['http://localhost:8080/'])" .
chx:X_LocalServerFlow rd:hasIOExample chx:IO_LocalServerFlow .
chx:X_NoBrowserFailure a owl:NamedIndividual, chx:NoBrowserFailure ; rdfs:label "webbrowser.get()"@en ; skos:definition "Where no browser can be found (a server, a container, an SSH session) webbrowser.get raises webbrowser.Error with the text could not locate runnable browser; ezsheets swallows it at import and raises it again at the first Spreadsheet(), and it prints no address to open by hand. The raising was executed under Python 3.14.6 (see the study of a credentials file and no browser); this example runs the first thing webbrowser.get does, the lookup of the program on the path, because the page's Python has a stub webbrowser without get()."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_NoBrowserFailure a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import shutil\\n# webbrowser.get() first looks for a program of that name on the path; the page\\'s Python has a stub webbrowser without get() and Error, so only that lookup is run here\\nout = shutil.which(\\'no-such-browser-zz\\') is None', g), g['out'])[1])({}) evaluates to True"@en ; chx:input "(lambda g: (exec('import shutil\\n# webbrowser.get() first looks for a program of that name on the path; the page\\'s Python has a stub webbrowser without get() and Error, so only that lookup is run here\\nout = shutil.which(\\'no-such-browser-zz\\') is None', g), g['out'])[1])({})" ; chx:output "True" .
chx:X_NoBrowserFailure rd:hasIOExample chx:IO_NoBrowserFailure .
chx:X_SpreadsheetId a owl:NamedIndividual, chx:SpreadsheetId ; rdfs:label "ezsheets.Spreadsheet('1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI')"@en ; skos:definition "ezsheets.Spreadsheet() takes the full URL, the bare id or the title of one spreadsheet, and the objects made from the three forms compare equal because == compares the ids."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_SpreadsheetId a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\ni = g.load(\\'1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI\\', \\'Education Data\\', [[\\'TITLE\\']])\\nss2 = ezsheets.Spreadsheet(\\'https://docs.google.com/spreadsheets/d/\\' + i + \\'/\\')\\nss3 = ezsheets.Spreadsheet(i)\\nss4 = ezsheets.Spreadsheet(\\'Education Data\\')\\nout = (ss2 == ss3 == ss4, ss4.title, ss2 is ss3)') evaluates to (True, 'Education Data', False)"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\ni = g.load(\\'1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI\\', \\'Education Data\\', [[\\'TITLE\\']])\\nss2 = ezsheets.Spreadsheet(\\'https://docs.google.com/spreadsheets/d/\\' + i + \\'/\\')\\nss3 = ezsheets.Spreadsheet(i)\\nss4 = ezsheets.Spreadsheet(\\'Education Data\\')\\nout = (ss2 == ss3 == ss4, ss4.title, ss2 is ss3)')" ; chx:output "(True, 'Education Data', False)" .
