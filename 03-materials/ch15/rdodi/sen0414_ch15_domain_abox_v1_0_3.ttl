chx:X_ReleaseState a owl:NamedIndividual, chx:ReleaseState ; rdfs:label "pip install ezsheets"@en ; skos:definition "The newest release is ezsheets 2026.4.28, licensed GPLv3+, which declares no Python requirement and depends on google-api-python-client, google-auth-httplib2 and google-auth-oauthlib; its code is that of 2025.11.11 apart from the version string."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ReleaseState a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets, importlib.metadata as m\\nmd = m.metadata(\\'ezsheets\\')\\nout = (ezsheets.__version__, md[\\'License\\'], sorted(r.split()[0] for r in m.requires(\\'ezsheets\\')), md[\\'Requires-Python\\'])') evaluates to ('2026.4.28', 'GPLv3+', ['google-api-python-client', 'google-auth-httplib2', 'google-auth-oauthlib'], None)"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets, importlib.metadata as m\\nmd = m.metadata(\\'ezsheets\\')\\nout = (ezsheets.__version__, md[\\'License\\'], sorted(r.split()[0] for r in m.requires(\\'ezsheets\\')), md[\\'Requires-Python\\'])')" ; chx:output "('2026.4.28', 'GPLv3+', ['google-api-python-client', 'google-auth-httplib2', 'google-auth-oauthlib'], None)" .
chx:X_ReleaseState rd:hasIOExample chx:IO_ReleaseState .
chx:X_DocumentationGap a owl:NamedIndividual, chx:DocumentationGap ; rdfs:label "ezsheets.readthedocs.io"@en ; skos:definition "The documentation page of ezsheets is dated November 2019 and names ten of the thirty-five public names of the installed library; it does not name getRow, downloadAsExcel, listSpreadsheets or delete. NOT EXECUTED here as a program; the count is in the live observations."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_ClientLibraries a owl:NamedIndividual, chx:ClientLibraries ; rdfs:label "google-api-python-client, google-auth-oauthlib"@en ; skos:definition "ezsheets is a thin layer over Google's own Python libraries: google-api-python-client builds the requests, google-auth-oauthlib runs the consent and google-auth-httplib2 sends them."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ClientLibraries a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import importlib.metadata as m\\nout = sorted(r.split()[0].split(\\'>\\')[0].split(\\'=\\')[0] for r in m.requires(\\'ezsheets\\'))') evaluates to ['google-api-python-client', 'google-auth-httplib2', 'google-auth-oauthlib']"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import importlib.metadata as m\\nout = sorted(r.split()[0].split(\\'>\\')[0].split(\\'=\\')[0] for r in m.requires(\\'ezsheets\\'))')" ; chx:output "['google-api-python-client', 'google-auth-httplib2', 'google-auth-oauthlib']" .
chx:X_ClientLibraries rd:hasIOExample chx:IO_ClientLibraries .
chx:X_RawRestCalls a owl:NamedIndividual, chx:RawRestCalls ; rdfs:label "ezsheets.SHEETS_SERVICE.spreadsheets().values().update(...)"@en ; skos:definition "The client that ezsheets builds can be used directly: values().update(...) makes the request object of the REST call, PUT .../values/Sheet1!A1:B1 with valueInputOption RAW, which stores =1+1 as the text it is and sends nothing until execute() is called."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_RawRestCalls a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\nreq = ezsheets.SHEETS_SERVICE.spreadsheets().values().update(spreadsheetId=\\'ABC\\', range=\\'Sheet1!A1:B1\\', valueInputOption=\\'RAW\\', body={\\'values\\': [[\\'=1+1\\', \\'1/2\\']]})\\nout = (req.method, req.uri, req.body, len(g.log))') evaluates to ('PUT', 'https://sheets.googleapis.com/v4/spreadsheets/ABC/values/Sheet1%21A1%3AB1?valueInputOption=RAW&alt=json', '{'values': [['=1+1', '1/2']]}', 0)"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import json, re, itertools, urllib.parse as up, httplib2, ezsheets\\nfrom googleapiclient.discovery import build\\nclass G:\\n  def __init__(s):\\n    s.ss = {}; s.n = itertools.count(1); s.sid = itertools.count(100); s.log = []; s.fail = []; s.files = {}; s.out = {}\\n  def sh(s, t, i, r=1000, c=26, sid=None): return {\\'p\\': {\\'sheetId\\': next(s.sid) if sid is None else sid, \\'title\\': t, \\'index\\': i, \\'gridProperties\\': {\\'rowCount\\': r, \\'columnCount\\': c}}, \\'c\\': {}}\\n  def new(s, t=\\'Untitled spreadsheet\\', id=None):\\n    i = id or \\'ID%03d\\' % next(s.n); s.ss[i] = {\\'t\\': t, \\'sh\\': [s.sh(\\'Sheet1\\', 0, sid=0)]}; return i\\n  def load(s, id, title, rows):\\n    i = s.new(title, id); h = s.ss[i][\\'sh\\'][0]; h[\\'p\\'][\\'gridProperties\\'] = {\\'rowCount\\': len(rows), \\'columnCount\\': max(map(len, rows))}\\n    for r, row in enumerate(rows, 1):\\n      for c, v in enumerate(row, 1): h[\\'c\\'][(c, r)] = str(v)\\n    return i\\n  def cell(s, h, t): return [x for x in s.ss[h][\\'sh\\'] if x[\\'p\\'][\\'title\\'] == t][0]\\n  def reply(s, d, st=200): return httplib2.Response({\\'status\\': str(st), \\'content-type\\': \\'application/json\\'}), json.dumps(d).encode()\\n  def request(s, uri, method=\\'GET\\', body=None, headers=None, **kw):\\n    u = up.urlparse(uri); p = up.unquote(u.path); q = up.parse_qs(u.query); b = json.loads(body) if body and body[:1] in (b\\'{\\', \\'{\\') else None\\n    s.log.append((method, p, u.query, b))\\n    if s.fail: st, nm = s.fail.pop(0); return s.reply({\\'error\\': {\\'code\\': st, \\'status\\': nm, \\'message\\': nm}}, st)\\n    if p == \\'/v4/spreadsheets\\': return s.reply({\\'spreadsheetId\\': s.new(b[\\'properties\\'][\\'title\\'])})\\n    if p.startswith(\\'/drive/v3/files\\') or p.startswith(\\'/upload/drive\\'): return s.drive(p, method, q, b, headers, body)\\n    m = re.match(r\\'/v4/spreadsheets/([^/:]+)(/values/(.+)|/sheets/(\\\\d+):copyTo|:batchUpdate)?$\\', p)\\n    if m[1] not in s.ss: return s.reply({\\'error\\': {\\'code\\': 404, \\'status\\': \\'NOT_FOUND\\', \\'message\\': \\'Requested entity was not found.\\'}}, 404)\\n    x = s.ss[m[1]]\\n    if m[3]:\\n      t, a = m[3].rsplit(\\'!\\', 1); c1, r1, c2, r2 = re.match(r\\'([A-Z]+)(\\\\d+):([A-Z]+)(\\\\d+)\\', a).groups(); c1, c2 = ezsheets.getColumnNumberOf(c1), ezsheets.getColumnNumberOf(c2); h = s.cell(m[1], t)\\n      if method == \\'PUT\\':\\n        for i, line in enumerate(b[\\'values\\']):\\n          for j, v in enumerate(line): h[\\'c\\'][(c1 + j, int(r1) + i) if b[\\'majorDimension\\'] == \\'ROWS\\' else (c1 + i, int(r1) + j)] = \\'\\' if v is None else str(v)\\n        return s.reply({\\'updatedRange\\': m[3]})\\n      rows = [[h[\\'c\\'].get((c, r), \\'\\') for c in range(c1, c2 + 1)] for r in range(int(r1), int(r2) + 1)]\\n      for r in rows:\\n        while r and r[-1] == \\'\\': r.pop()\\n      while rows and not rows[-1]: rows.pop()\\n      return s.reply(dict({\\'range\\': m[3], \\'majorDimension\\': \\'ROWS\\'}, **({\\'values\\': rows} if rows else {})))\\n    if m[4]:\\n      h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == int(m[4])][0]; d = s.ss[b[\\'destinationSpreadsheetId\\']]; n = json.loads(json.dumps(h[\\'p\\'])); n.update(sheetId=next(s.sid), title=\\'Copy of \\' + n[\\'title\\'], index=len(d[\\'sh\\']))\\n      d[\\'sh\\'].append({\\'p\\': n, \\'c\\': dict(h[\\'c\\'])}); return s.reply(n)\\n    if m[0].endswith(\\':batchUpdate\\'):\\n      for r in b[\\'requests\\']:\\n        (k, v), = r.items()\\n        if k == \\'updateSpreadsheetProperties\\': x[\\'t\\'] = v[\\'properties\\'][\\'title\\']\\n        elif k == \\'addSheet\\': x[\\'sh\\'].insert(v[\\'properties\\'][\\'index\\'], s.sh(v[\\'properties\\'][\\'title\\'], 0))\\n        elif k == \\'deleteSheet\\': x[\\'sh\\'] = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] != v[\\'sheetId\\']]\\n        else:\\n          pr = v[\\'properties\\']; h = [z for z in x[\\'sh\\'] if z[\\'p\\'][\\'sheetId\\'] == pr[\\'sheetId\\']][0]; h[\\'p\\'][\\'title\\'] = pr.get(\\'title\\', h[\\'p\\'][\\'title\\']); h[\\'p\\'][\\'gridProperties\\'].update(pr.get(\\'gridProperties\\', {}))\\n          if \\'index\\' in pr: x[\\'sh\\'].remove(h); x[\\'sh\\'].insert(pr[\\'index\\'] if pr[\\'index\\'] <= h[\\'p\\'][\\'index\\'] else pr[\\'index\\'] - 1, h)\\n        for i, z in enumerate(x[\\'sh\\']): z[\\'p\\'][\\'index\\'] = i\\n      return s.reply({\\'replies\\': [{} for _ in b[\\'requests\\']]})\\n    return s.reply({\\'properties\\': {\\'title\\': x[\\'t\\']}, \\'sheets\\': [{\\'properties\\': dict(z[\\'p\\'])} for z in x[\\'sh\\']]})\\n  def drive(s, p, method, q, b, headers, body):\\n    if p.startswith(\\'/upload\\'):\\n      s.out[\\'upload\\'] = (headers.get(\\'content-type\\', \\'\\').split(\\';\\')[0], re.findall(rb\\'\\\\x22name\\\\x22: ?\\\\x22([^\\\\x22]*)\\\\x22\\', body)[:1], len(body)); return s.reply({\\'id\\': s.new(s.out[\\'upload\\'][1][0].decode())})\\n    if p.endswith(\\'/export\\'):\\n      fid = p.split(\\'/\\')[4]; s.out[\\'export\\'] = (fid, q[\\'mimeType\\'][0]); return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': q[\\'mimeType\\'][0]}), b\\'EXPORT:\\' + fid.encode() + b\\':\\' + q[\\'mimeType\\'][0].encode()\\n    if p == \\'/drive/v3/files\\' and method == \\'GET\\': return s.reply({\\'files\\': [{\\'id\\': i, \\'name\\': v[\\'t\\']} for i, v in s.ss.items()]})\\n    fid = p.split(\\'/\\')[4]\\n    if method == \\'PATCH\\': s.ss[fid][\\'trashed\\'] = b[\\'trashed\\']; return s.reply({\\'id\\': fid})\\n    del s.ss[fid]; return httplib2.Response({\\'status\\': \\'204\\'}), b\\'\\'\\ndef install():\\n  g = G(); ezsheets.SHEETS_SERVICE = build(\\'sheets\\', \\'v4\\', http=g, static_discovery=True); ezsheets.DRIVE_SERVICE = build(\\'drive\\', \\'v3\\', http=g, static_discovery=True); ezsheets.IS_INITIALIZED = True; ezsheets.IGNORE_QUOTA = True; return g\\ng = install()\\nreq = ezsheets.SHEETS_SERVICE.spreadsheets().values().update(spreadsheetId=\\'ABC\\', range=\\'Sheet1!A1:B1\\', valueInputOption=\\'RAW\\', body={\\'values\\': [[\\'=1+1\\', \\'1/2\\']]})\\nout = (req.method, req.uri, req.body, len(g.log))')" ; chx:output "('PUT', 'https://sheets.googleapis.com/v4/spreadsheets/ABC/values/Sheet1%21A1%3AB1?valueInputOption=RAW&alt=json', '{'values': [['=1+1', '1/2']]}', 0)" .
chx:X_RawRestCalls rd:hasIOExample chx:IO_RawRestCalls .
chx:X_AlternativeLibrary a owl:NamedIndividual, chx:AlternativeLibrary ; rdfs:label "gspread"@en ; skos:definition "gspread is another Python library for Google Sheets, with its own documentation and releases, that a course may name beside ezsheets; it was read about and not run."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_PythonPatchReleases a owl:NamedIndividual, chx:PythonPatchReleases ; rdfs:label "python3.14.0 to python3.14.6"@en ; skos:definition "The same ezsheets program printed the same under 3.14.0 to 3.14.6, 3.13 and 3.12, except the default pickle protocol, which is 5 from Python 3.14 and 4 before, and is the protocol of the token files the library writes. The protocols a token file can use are the same everywhere (up to 5), which is what this example shows; the default's change is in the interpreter record."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_PythonPatchReleases a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import pickle\\nout = (pickle.HIGHEST_PROTOCOL, [p for p in (3, 4, 5) if p <= pickle.HIGHEST_PROTOCOL])', g), g['out'])[1])({}) evaluates to (5, [3, 4, 5])"@en ; chx:input "(lambda g: (exec('import pickle\\nout = (pickle.HIGHEST_PROTOCOL, [p for p in (3, 4, 5) if p <= pickle.HIGHEST_PROTOCOL])', g), g['out'])[1])({})" ; chx:output "(5, [3, 4, 5])" .
chx:X_PythonPatchReleases rd:hasIOExample chx:IO_PythonPatchReleases .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 15 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch15/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 15 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which object of EZSheets stands for which part of a Google account - the project and its tokens, a spreadsheet, a sheet, a row or column, a cell - and which request does each call of the library send to Google?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, programs, numbers and statements of the chapter differ in current Python, in the current library, in Google's pages or in the files the book ships, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 15 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 15 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch15/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-12."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py" .

