chx:X_IdFromUrl a owl:NamedIndividual, chx:IdFromUrl ; rdfs:label "ezsheets.getIdFromUrl('https://docs.google.com/spreadsheets/d/<id>/')"@en ; skos:definition "getIdFromUrl cuts the id out of a URL by position, from character 39 to the next slash, so a URL without a slash after the id loses its last character, and the /u/3/ form of a URL raises ValueError."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_IdFromUrl a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nb = \\'https://docs.google.com/spreadsheets/d/1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI\\'\\nres = [ezsheets.getIdFromUrl(b + \\'/\\'), ezsheets.getIdFromUrl(b), ezsheets.getIdFromUrl(b + \\'/edit#gid=0\\')]\\ntry:\\n    ezsheets.getIdFromUrl(\\'https://docs.google.com/spreadsheets/u/3/d/1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI/edit\\')\\nexcept ValueError as e:\\n    res.append(str(e))\\nout = (res[0] == res[2], len(res[0]), len(res[1]), res[3])') evaluates to (True, 44, 43, 'url argument must be an alphanumeric id or a full URL')"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nb = \\'https://docs.google.com/spreadsheets/d/1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI\\'\\nres = [ezsheets.getIdFromUrl(b + \\'/\\'), ezsheets.getIdFromUrl(b), ezsheets.getIdFromUrl(b + \\'/edit#gid=0\\')]\\ntry:\\n    ezsheets.getIdFromUrl(\\'https://docs.google.com/spreadsheets/u/3/d/1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI/edit\\')\\nexcept ValueError as e:\\n    res.append(str(e))\\nout = (res[0] == res[2], len(res[0]), len(res[1]), res[3])')" ; chx:output "(True, 44, 43, 'url argument must be an alphanumeric id or a full URL')" .
