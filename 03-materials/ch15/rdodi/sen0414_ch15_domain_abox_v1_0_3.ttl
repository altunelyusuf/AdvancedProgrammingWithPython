chx:X_ConvertAddress a owl:NamedIndividual, chx:ConvertAddress ; rdfs:label "ezsheets.convertAddress('A2')"@en ; skos:definition "convertAddress turns a string address into a (column, row) tuple and a column and row, or a tuple, into the string address."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ConvertAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nout = (ezsheets.convertAddress(\\'A2\\'), ezsheets.convertAddress(1, 2), ezsheets.convertAddress((2, 5)), ezsheets.convertAddress(\\'AA10\\'))') evaluates to ((1, 2), 'A2', 'B5', (27, 10))"@en ; chx:input "__import__('sen0414_ch15_isolated_env_v1_0_0').out('import ezsheets\\nout = (ezsheets.convertAddress(\\'A2\\'), ezsheets.convertAddress(1, 2), ezsheets.convertAddress((2, 5)), ezsheets.convertAddress(\\'AA10\\'))')" ; chx:output "((1, 2), 'A2', 'B5', (27, 10))" .
