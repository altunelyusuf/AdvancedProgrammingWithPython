chx:X_ArgvUnpacking a owl:NamedIndividual, chx:ArgvUnpacking ; rdfs:label "sender, recipient, amount = sys.argv[1:]"@en ; skos:definition "The transaction program unpacks three command line arguments, so a name with a space must be quoted; unquoted, Al Sweigart makes four arguments and the unpacking raises ValueError."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ArgvUnpacking a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import sys, shlex\\nres = []\\nfor line in (\\'addBoringcoinTransaction.py \\\\x22Al Sweigart\\\\x22 Eve 2000\\', \\'addBoringcoinTransaction.py Al Sweigart Eve 2000\\', \\'addBoringcoinTransaction.py Eve 2000\\'):\\n    sys.argv = shlex.split(line)\\n    if len(sys.argv) < 4:\\n        res.append(\\'usage\\'); continue\\n    try:\\n        sender, recipient, amount = sys.argv[1:]\\n        res.append((sender, recipient, amount))\\n    except ValueError as e:\\n        res.append(str(e).split(\\' (\\')[0])\\nout = res', g), g['out'])[1])({}) evaluates to [('Al Sweigart', 'Eve', '2000'), 'too many values to unpack', 'usage']"@en ; chx:input "(lambda g: (exec('import sys, shlex\\nres = []\\nfor line in (\\'addBoringcoinTransaction.py \\\\x22Al Sweigart\\\\x22 Eve 2000\\', \\'addBoringcoinTransaction.py Al Sweigart Eve 2000\\', \\'addBoringcoinTransaction.py Eve 2000\\'):\\n    sys.argv = shlex.split(line)\\n    if len(sys.argv) < 4:\\n        res.append(\\'usage\\'); continue\\n    try:\\n        sender, recipient, amount = sys.argv[1:]\\n        res.append((sender, recipient, amount))\\n    except ValueError as e:\\n        res.append(str(e).split(\\' (\\')[0])\\nout = res', g), g['out'])[1])({})" ; chx:output "[('Al Sweigart', 'Eve', '2000'), 'too many values to unpack', 'usage']" .
