chx:X_GoogleCloudProject a owl:NamedIndividual, chx:GoogleCloudProject ; rdfs:label "console.cloud.google.com, New Project"@en ; skos:definition "A Google Cloud project is the place in Google's console that owns a script's access to Google's APIs; the chapter makes one, leaves the location at No organization, and needs only one project for all its scripts."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_ApiEnablement a owl:NamedIndividual, chx:ApiEnablement ; rdfs:label "Enable the Google Sheets API and the Google Drive API"@en ; skos:definition "The project must have the Google Sheets API and the Google Drive API switched on, because the library uses the Drive API to upload and download spreadsheet files."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_OAuthConsentScreen a owl:NamedIndividual, chx:OAuthConsentScreen ; rdfs:label "External, App Name, Test users"@en ; skos:definition "The OAuth consent screen is the page Google shows a person when a script first asks for access; the chapter chooses External, names the app, lists the scopes and adds the account's Gmail address as a test user, since without Google's app approval a script may reach only the test users' accounts."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_AuthScope a owl:NamedIndividual, chx:AuthScope ; rdfs:label "auth/drive and auth/spreadsheets"@en ; skos:definition "A scope is one permission a project asks for; the chapter ticks the Drive scope and the Sheets scope, which Google's scope table classes as restricted and sensitive, and Google recommends the narrower non-sensitive drive.file where it is enough."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_AuthScope a owl:NamedIndividual, rd:IOExample ; rdfs:label "[s.rsplit('/', 1)[1] for s in ('https://www.googleapis.com/auth/drive', 'https://www.googleapis.com/auth/spreadsheets')] evaluates to ['drive', 'spreadsheets']"@en ; chx:input "[s.rsplit('/', 1)[1] for s in ('https://www.googleapis.com/auth/drive', 'https://www.googleapis.com/auth/spreadsheets')]" ; chx:output "['drive', 'spreadsheets']" .
chx:X_AuthScope rd:hasIOExample chx:IO_AuthScope .
chx:X_CredentialsFile a owl:NamedIndividual, chx:CredentialsFile ; rdfs:label "client_secret_*.json, credentials-sheets.json"@en ; skos:definition "The credentials file is the JSON file of an OAuth client of the type Desktop app that Google lets you download; the library looks in the folder for credentials-sheets.json or a name that matches client_secret_*.json, and needs it even for public spreadsheets."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_CredentialsFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "[n for n in ('client_secret_282792235794.apps.googleusercontent.com.json', 'credentials-sheets.json', 'notes.txt', 'client_secret_x.txt') if (n.startswith('client_secret_') and n.endswith('.json')) or n == 'credentials-sheets.json'] evaluates to ['client_secret_282792235794.apps.googleusercontent.com.json', 'credentials-sheets.json']"@en ; chx:input "[n for n in ('client_secret_282792235794.apps.googleusercontent.com.json', 'credentials-sheets.json', 'notes.txt', 'client_secret_x.txt') if (n.startswith('client_secret_') and n.endswith('.json')) or n == 'credentials-sheets.json']" ; chx:output "['client_secret_282792235794.apps.googleusercontent.com.json', 'credentials-sheets.json']" .
chx:X_CredentialsFile rd:hasIOExample chx:IO_CredentialsFile .
chx:X_TokenFile a owl:NamedIndividual, chx:TokenFile ; rdfs:label "token-sheets.pickle, token-drive.pickle"@en ; skos:definition "A token file holds the tokens that the first login obtained, one for Sheets and one for Drive, and the library writes it with the pickle module so that later runs need no login; the chapter says to treat such files like passwords."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_TokenFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(__import__('pickle').loads(__import__('pickle').dumps({'scopes': 2, 'refresh_token': 'x'})).items()) evaluates to [('refresh_token', 'x'), ('scopes', 2)]"@en ; chx:input "sorted(__import__('pickle').loads(__import__('pickle').dumps({'scopes': 2, 'refresh_token': 'x'})).items())" ; chx:output "[('refresh_token', 'x'), ('scopes', 2)]" .
chx:X_TokenFile rd:hasIOExample chx:IO_TokenFile .
chx:X_FirstRunLogin a owl:NamedIndividual, chx:FirstRunLogin ; rdfs:label "import ezsheets opens the browser"@en ; skos:definition "The first import with a credentials file in the folder opens the browser for the Google sign-in, the warning that Google has not verified the app, and the consent for Sheets and then for Drive; it is a one-time step that needs a browser and a real account and was not run."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_RevokingCredentials a owl:NamedIndividual, chx:RevokingCredentials ; rdfs:label "trash can in the OAuth 2.0 Client IDs table"@en ; skos:definition "If a credentials or token file is shared by accident, deleting the OAuth client in the console makes the files useless, and new ones must be made; this was not run."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_TokenFileSecurity a owl:NamedIndividual, chx:TokenFileSecurity ; rdfs:label "pickle.loads(data)"@en ; skos:definition "Because a token file is read back with pickle and unpickling can run code, a token file from another person must never be loaded and one's own must not be shared; the documentation says the pickle module is not secure."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_OpeningSpreadsheet a owl:NamedIndividual, chx:OpeningSpreadsheet ; rdfs:label "ezsheets.Spreadsheet(url or id)"@en ; skos:definition "A Spreadsheet object opens an existing spreadsheet from its id, its URL or a short URL that redirects to it, and has the attributes title, id, url, sheetTitles and sheets; the id is the part of the URL between spreadsheets/d/ and /edit."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_OpeningSpreadsheet a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda u: (lambda i: (i[:4], len(i)))(u.split('/d/')[1].split('/')[0]))('https://docs.google.com/spreadsheets/d/1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI/edit#gid=0/') evaluates to ('1TzO', 44)"@en ; chx:input "(lambda u: (lambda i: (i[:4], len(i)))(u.split('/d/')[1].split('/')[0]))('https://docs.google.com/spreadsheets/d/1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI/edit#gid=0/')" ; chx:output "('1TzO', 44)" .
chx:X_OpeningSpreadsheet rd:hasIOExample chx:IO_OpeningSpreadsheet .
chx:X_UrlSliceTrap a owl:NamedIndividual, chx:UrlSliceTrap ; rdfs:label "url[39:url.find('/', 39)]"@en ; skos:definition "Cutting an id out of a URL by position works only when a slash follows the id: in EZSheets 2026.4.28 a URL that ends right after the id loses the id's last character, while a pattern match on the id's characters does not."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_UrlSliceTrap a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda u: (len(u[39:u.find('/', 39)]), len(u.split('/d/')[1].split('/')[0])))('https://docs.google.com/spreadsheets/d/1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI') evaluates to (43, 44)"@en ; chx:input "(lambda u: (len(u[39:u.find('/', 39)]), len(u.split('/d/')[1].split('/')[0])))('https://docs.google.com/spreadsheets/d/1TzOJxhNKr15tzdZxTqtQ3EmDP6em_elnbtmZIcyu8vI')" ; chx:output "(43, 44)" .
chx:X_UrlSliceTrap rd:hasIOExample chx:IO_UrlSliceTrap .
chx:X_NewSpreadsheet a owl:NamedIndividual, chx:NewSpreadsheet ; rdfs:label "ss = ezsheets.Spreadsheet()"@en ; skos:definition "Spreadsheet() with no argument creates a blank spreadsheet, titled Untitled spreadsheet by the library and starting with one sheet, Sheet1; it needs the network and an account and was not run."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_UploadSpreadsheet a owl:NamedIndividual, chx:UploadSpreadsheet ; rdfs:label "ezsheets.upload('my_spreadsheet.xlsx')"@en ; skos:definition "upload sends a local .xlsx, .ods, .csv or .tsv file to Google Drive, where it becomes a Google Sheets spreadsheet, and returns the Spreadsheet object; the library raises ValueError for any other extension."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_UploadSpreadsheet a owl:NamedIndividual, rd:IOExample ; rdfs:label "[n for n in ('a.xlsx', 'b.ODS', 'c.csv', 'd.tsv', 'e.pdf') if n.lower().endswith(('.xlsx', '.ods', '.csv', '.tsv'))] evaluates to ['a.xlsx', 'b.ODS', 'c.csv', 'd.tsv']"@en ; chx:input "[n for n in ('a.xlsx', 'b.ODS', 'c.csv', 'd.tsv', 'e.pdf') if n.lower().endswith(('.xlsx', '.ods', '.csv', '.tsv'))]" ; chx:output "['a.xlsx', 'b.ODS', 'c.csv', 'd.tsv']" .
chx:X_UploadSpreadsheet rd:hasIOExample chx:IO_UploadSpreadsheet .
chx:X_ListSpreadsheets a owl:NamedIndividual, chx:ListSpreadsheets ; rdfs:label "ezsheets.listSpreadsheets()"@en ; skos:definition "listSpreadsheets returns a dictionary from spreadsheet id to title for the account, trashed spreadsheets included according to the chapter; titles need not be unique, so a search by title can find several ids."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ListSpreadsheets a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d, t: [i for i, n in d.items() if n == t])({'id1': 'Budget', 'id2': 'Budget', 'id3': 'Plan'}, 'Budget') evaluates to ['id1', 'id2']"@en ; chx:input "(lambda d, t: [i for i, n in d.items() if n == t])({'id1': 'Budget', 'id2': 'Budget', 'id3': 'Plan'}, 'Budget')" ; chx:output "['id1', 'id2']" .
chx:X_ListSpreadsheets rd:hasIOExample chx:IO_ListSpreadsheets .
chx:X_SpreadsheetRefresh a owl:NamedIndividual, chx:SpreadsheetRefresh ; rdfs:label "ss.refresh()"@en ; skos:definition "refresh reads the title, the list of sheets and the data of every sheet again; a loaded sheet is a local copy, so a change made in the browser meanwhile is not seen until refresh, and reading from the copy makes no request."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_SheetTitlesTuple a owl:NamedIndividual, chx:SheetTitlesTuple ; rdfs:label "ss.sheetTitles"@en ; skos:definition "sheetTitles and sheets are tuples, which can be read, indexed and looped over but not changed in place; the order and the names of sheets are changed through each sheet's index and title and through the spreadsheet's methods."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_SheetTitlesTuple a owl:NamedIndividual, rd:IOExample ; rdfs:label "(type(('Sheet1', 'Spam')).__name__, ('Sheet1', 'Spam') + ('Eggs',)) evaluates to ('tuple', ('Sheet1', 'Spam', 'Eggs'))"@en ; chx:input "(type(('Sheet1', 'Spam')).__name__, ('Sheet1', 'Spam') + ('Eggs',))" ; chx:output "('tuple', ('Sheet1', 'Spam', 'Eggs'))" .
chx:X_SheetTitlesTuple rd:hasIOExample chx:IO_SheetTitlesTuple .
chx:X_DownloadFormats a owl:NamedIndividual, chx:DownloadFormats ; rdfs:label "ss.downloadAsExcel()"@en ; skos:definition "Six methods download a spreadsheet as Excel, OpenOffice, CSV, TSV, PDF or a ZIP of HTML files and return the file name; CSV and TSV hold only the first sheet, and the default name is the title with space, slash, backslash, colon, asterisk, question mark, quote, angle brackets and bar replaced by underscores, plus the extension."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_DownloadFormats a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t: ''.join('_' if c in ' /:*?<>|' + chr(92) + chr(34) else c for c in t))('Sweigart Books (DO NOT DELETE)') + '.xlsx' evaluates to 'Sweigart_Books_(DO_NOT_DELETE).xlsx'"@en ; chx:input "(lambda t: ''.join('_' if c in ' /:*?<>|' + chr(92) + chr(34) else c for c in t))('Sweigart Books (DO NOT DELETE)') + '.xlsx'" ; chx:output "'Sweigart_Books_(DO_NOT_DELETE).xlsx'" .
chx:X_DownloadFormats rd:hasIOExample chx:IO_DownloadFormats .
chx:X_TrashAndPermanentDelete a owl:NamedIndividual, chx:TrashAndPermanentDelete ; rdfs:label "ss.delete(permanent=True)"@en ; skos:definition "delete() moves a spreadsheet to the Drive trash and delete(permanent=True) removes it for good; the chapter advises against permanent deletion in scripts, since a bug cannot be undone; this was not run."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_OneBasedAddressing a owl:NamedIndividual, chx:OneBasedAddressing ; rdfs:label "sheet['A1'], sheet[1, 1]"@en ; skos:definition "Columns and rows of a sheet are counted from 1 and columns also have letters, so A1 is column 1 of row 1 and is the item rows[0][0] of a list of rows; the library raises IndexError for column 0 or row 0."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_OneBasedAddressing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda rows, col, row: rows[row - 1][col - 1])([['Name', 'Age'], ['Alice', '30']], 2, 1) evaluates to 'Age'"@en ; chx:input "(lambda rows, col, row: rows[row - 1][col - 1])([['Name', 'Age'], ['Alice', '30']], 2, 1)" ; chx:output "'Age'" .
chx:X_OneBasedAddressing rd:hasIOExample chx:IO_OneBasedAddressing .
chx:X_AddressConversion a owl:NamedIndividual, chx:AddressConversion ; rdfs:label "ezsheets.convertAddress('A2')"@en ; skos:definition "convertAddress turns the text 'A2' into the pair (1, 2) and the pair back into 'A2'; the text form suits addresses typed into code and the number form suits loops over columns."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_AddressConversion a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a: (ord(a[0]) - 64, int(a[1:])))('A2') evaluates to (1, 2)"@en ; chx:input "(lambda a: (ord(a[0]) - 64, int(a[1:])))('A2')" ; chx:output "(1, 2)" .
chx:X_AddressConversion rd:hasIOExample chx:IO_AddressConversion .
chx:X_ColumnLetters a owl:NamedIndividual, chx:ColumnLetters ; rdfs:label "ezsheets.getColumnLetterOf(999)"@en ; skos:definition "Column letters are a base-26 numbering without a zero digit, so 26 is Z, 27 is AA, 999 is ALK and ZZZ is column 18278; getColumnLetterOf and getColumnNumberOf convert between letters and numbers."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ColumnLetters a owl:NamedIndividual, rd:IOExample ; rdfs:label "((lambda f: f(f, 999))(lambda f, n: '' if n == 0 else f(f, (n - 1) // 26) + chr(65 + (n - 1) % 26)), __import__('functools').reduce(lambda n, c: n * 26 + ord(c) - 64, 'ZZZ', 0)) evaluates to ('ALK', 18278)"@en ; chx:input "((lambda f: f(f, 999))(lambda f, n: '' if n == 0 else f(f, (n - 1) // 26) + chr(65 + (n - 1) % 26)), __import__('functools').reduce(lambda n, c: n * 26 + ord(c) - 64, 'ZZZ', 0))" ; chx:output "('ALK', 18278)" .
chx:X_ColumnLetters rd:hasIOExample chx:IO_ColumnLetters .
chx:X_ReadWriteCell a owl:NamedIndividual, chx:ReadWriteCell ; rdfs:label "sheet['B1'] = 'Age'"@en ; skos:definition "Square brackets read and write one cell by its text address or by (column, row); an empty cell reads as an empty string, and every write is a web request."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ReadWriteCell a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda cells: (cells.get((1, 1), ''), cells.get((1, 2), '')))({(1, 1): 'Name'}) evaluates to ('Name', '')"@en ; chx:input "(lambda cells: (cells.get((1, 1), ''), cells.get((1, 2), '')))({(1, 1): 'Name'})" ; chx:output "('Name', '')" .
chx:X_ReadWriteCell rd:hasIOExample chx:IO_ReadWriteCell .
chx:X_StringValues a owl:NamedIndividual, chx:StringValues ; rdfs:label "sheet['B2']"@en ; skos:definition "A sheet returns cell values as strings, so '30' + '1' is '301' and arithmetic needs int or float first; in EZSheets 2026.4.28 a number just written is held as given until the next refresh, after which it reads as text."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_StringValues a owl:NamedIndividual, rd:IOExample ; rdfs:label "('30' + '1', int('30') + 1) evaluates to ('301', 31)"@en ; chx:input "('30' + '1', int('30') + 1)" ; chx:output "('301', 31)" .
chx:X_StringValues rd:hasIOExample chx:IO_StringValues .
chx:X_RowAndColumnRead a owl:NamedIndividual, chx:RowAndColumnRead ; rdfs:label "sheet.getRow(1)"@en ; skos:definition "getRow(n) and getColumn(n or letter) return a whole row or column as a list with one item per cell and an empty string for an empty cell; they read the loaded copy and make no request, and a row is as long as the sheet's column count."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_RowAndColumnRead a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda cells, ncol: [cells.get((c, 1), '') for c in range(1, ncol + 1)])({(1, 1): 'PRODUCE', (2, 1): 'COST PER POUND'}, 6) evaluates to ['PRODUCE', 'COST PER POUND', '', '', '', '']"@en ; chx:input "(lambda cells, ncol: [cells.get((c, 1), '') for c in range(1, ncol + 1)])({(1, 1): 'PRODUCE', (2, 1): 'COST PER POUND'}, 6)" ; chx:output "['PRODUCE', 'COST PER POUND', '', '', '', '']" .
chx:X_RowAndColumnRead rd:hasIOExample chx:IO_RowAndColumnRead .
chx:X_RowAndColumnWrite a owl:NamedIndividual, chx:RowAndColumnWrite ; rdfs:label "sheet.updateRow(3, [...])"@en ; skos:definition "updateRow and updateColumn overwrite a whole row or column from a list in one request; the library pads the list with empty strings to the size of the sheet and does so in place, so the list the caller passed has grown afterwards."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_RowAndColumnWrite a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda vals, n: vals + [''] * (n - len(vals)))(['Pumpkin', '11.50', '20', '230'], 6) evaluates to ['Pumpkin', '11.50', '20', '230', '', '']"@en ; chx:input "(lambda vals, n: vals + [''] * (n - len(vals)))(['Pumpkin', '11.50', '20', '230'], 6)" ; chx:output "['Pumpkin', '11.50', '20', '230', '', '']" .
chx:X_RowAndColumnWrite rd:hasIOExample chx:IO_RowAndColumnWrite .
chx:X_WholeSheetRead a owl:NamedIndividual, chx:WholeSheetRead ; rdfs:label "rows = sheet.getRows()"@en ; skos:definition "getRows returns a list with one list per row for the whole sheet, empty rows included, and updateRows writes such a list back in one request."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_WholeSheetRead a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda rows: [r[0] for r in rows[1:]])([['PRODUCE', 'COST'], ['Potatoes', '0.86'], ['Okra', '2.26']]) evaluates to ['Potatoes', 'Okra']"@en ; chx:input "(lambda rows: [r[0] for r in rows[1:]])([['PRODUCE', 'COST'], ['Potatoes', '0.86'], ['Okra', '2.26']])" ; chx:output "['Potatoes', 'Okra']" .
chx:X_WholeSheetRead rd:hasIOExample chx:IO_WholeSheetRead .
chx:X_SheetSize a owl:NamedIndividual, chx:SheetSize ; rdfs:label "sheet.columnCount = 4"@en ; skos:definition "rowCount and columnCount give the size of a sheet and can be assigned to resize it, dropping the columns beyond a smaller count; assigning one of them makes the library read the sheet again and then send one write."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_SheetSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda row, n: (len(row), len(row[:n])))(['PRODUCE', 'COST PER POUND', 'POUNDS SOLD', 'TOTAL', '', ''], 4) evaluates to (6, 4)"@en ; chx:input "(lambda row, n: (len(row), len(row[:n])))(['PRODUCE', 'COST PER POUND', 'POUNDS SOLD', 'TOTAL', '', ''], 4)" ; chx:output "(6, 4)" .
chx:X_SheetSize rd:hasIOExample chx:IO_SheetSize .
chx:X_CreateSheet a owl:NamedIndividual, chx:CreateSheet ; rdfs:label "ss.Sheet('Bacon', 0)"@en ; skos:definition "A new sheet is added with the Sheet method, at the end or at a given index, much as list.insert places an item; in EZSheets 2026.4.28 Sheet returns nothing, while createSheet returns the new Sheet object."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_CreateSheet a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t: (t.insert(0, 'Bacon'), tuple(t))[1])(['Sheet1', 'Spam', 'Eggs']) evaluates to ('Bacon', 'Sheet1', 'Spam', 'Eggs')"@en ; chx:input "(lambda t: (t.insert(0, 'Bacon'), tuple(t))[1])(['Sheet1', 'Spam', 'Eggs'])" ; chx:output "('Bacon', 'Sheet1', 'Spam', 'Eggs')" .
chx:X_CreateSheet rd:hasIOExample chx:IO_CreateSheet .
chx:X_ReorderSheet a owl:NamedIndividual, chx:ReorderSheet ; rdfs:label "ss.sheets[0].index = 2"@en ; skos:definition "Assigning an index to a sheet moves it so that it ends at that index, as list.insert(2, list.pop(0)) would move an item, and the spreadsheet's sheets are read again."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_ReorderSheet a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t: (t.insert(2, t.pop(0)), tuple(t))[1])(['Bacon', 'Sheet1', 'Spam', 'Eggs']) evaluates to ('Sheet1', 'Spam', 'Bacon', 'Eggs')"@en ; chx:input "(lambda t: (t.insert(2, t.pop(0)), tuple(t))[1])(['Bacon', 'Sheet1', 'Spam', 'Eggs'])" ; chx:output "('Sheet1', 'Spam', 'Bacon', 'Eggs')" .
chx:X_ReorderSheet rd:hasIOExample chx:IO_ReorderSheet .
chx:X_DeleteAndClear a owl:NamedIndividual, chx:DeleteAndClear ; rdfs:label "sheet.delete(), sheet.clear()"@en ; skos:definition "delete removes a sheet for good and clear empties its cells but keeps the sheet; a spreadsheet cannot lose its last sheet, for which the library raises ValueError."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_DeleteAndClear a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t: (t.remove('Bacon'), tuple(t))[1])(['Bacon', 'Sheet1', 'Spam', 'Eggs']) evaluates to ('Sheet1', 'Spam', 'Eggs')"@en ; chx:input "(lambda t: (t.remove('Bacon'), tuple(t))[1])(['Bacon', 'Sheet1', 'Spam', 'Eggs'])" ; chx:output "('Sheet1', 'Spam', 'Eggs')" .
chx:X_DeleteAndClear rd:hasIOExample chx:IO_DeleteAndClear .
chx:X_CopySheet a owl:NamedIndividual, chx:CopySheet ; rdfs:label "ss1[0].copyTo(ss2)"@en ; skos:definition "copyTo copies a sheet into another Spreadsheet object, where the copy is titled Copy of and the old title and comes last; the chapter offers copying as the way to back up a sheet."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_CopySheet a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, name: t + ['Copy of ' + name])(['Eggs'], 'Spam') evaluates to ['Eggs', 'Copy of Spam']"@en ; chx:input "(lambda t, name: t + ['Copy of ' + name])(['Eggs'], 'Spam')" ; chx:output "['Eggs', 'Copy of Spam']" .
chx:X_CopySheet rd:hasIOExample chx:IO_CopySheet .
chx:X_AuditLedger a owl:NamedIndividual, chx:AuditLedger ; rdfs:label "auditBoringcoin.py"@en ; skos:definition "The audit program loops over the ledger's rows, reads sender, recipient and amount, converts the amount with int and keeps a dictionary of balances; run on the public ledger exported on 2026-10-01 it gives the chapter's 20 balances and the total 1000000000."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_AuditLedger a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda rows: dict(sorted((n, sum(int(a) if r == n else -int(a) if s == n else 0 for s, r, a in rows)) for n in {x for s, r, a in rows for x in (s, r)} if n != 'PRE-MINE')))([('PRE-MINE', 'Alice', '1000'), ('Alice', 'Bob', '300'), ('Bob', 'Carol', '50')]) evaluates to {'Alice': 700, 'Bob': 250, 'Carol': 50}"@en ; chx:input "(lambda rows: dict(sorted((n, sum(int(a) if r == n else -int(a) if s == n else 0 for s, r, a in rows)) for n in {x for s, r, a in rows for x in (s, r)} if n != 'PRE-MINE')))([('PRE-MINE', 'Alice', '1000'), ('Alice', 'Bob', '300'), ('Bob', 'Carol', '50')])" ; chx:output "{'Alice': 700, 'Bob': 250, 'Carol': 50}" .
chx:X_AuditLedger rd:hasIOExample chx:IO_AuditLedger .
chx:X_SetdefaultAccumulate a owl:NamedIndividual, chx:SetdefaultAccumulate ; rdfs:label "accounts.setdefault(recipient, 0)"@en ; skos:definition "dict.setdefault inserts a key with a start value only when the key is missing and returns the value, so an account is created at 0 when it first appears and is then added to."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_SetdefaultAccumulate a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.setdefault('Eve', 0), d.__setitem__('Eve', d['Eve'] + 2000), d)[2])({}) evaluates to {'Eve': 2000}"@en ; chx:input "(lambda d: (d.setdefault('Eve', 0), d.__setitem__('Eve', d['Eve'] + 2000), d)[2])({})" ; chx:output "{'Eve': 2000}" .
chx:X_SetdefaultAccumulate rd:hasIOExample chx:IO_SetdefaultAccumulate .
chx:X_AppendTransaction a owl:NamedIndividual, chx:AppendTransaction ; rdfs:label "addBoringcoinTransaction.py"@en ; skos:definition "The second program takes sender, recipient and amount from sys.argv, raises the row count by one and writes the three texts into the last row; its check len(sys.argv) < 4 lets extra arguments through, which then fail at the unpacking with ValueError, and a name with a space is one argument only when quoted."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_AppendTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda argv: argv[1:])(['addBoringcoinTransaction.py', 'Al Sweigart', 'Eve', '2000']) evaluates to ['Al Sweigart', 'Eve', '2000']"@en ; chx:input "(lambda argv: argv[1:])(['addBoringcoinTransaction.py', 'Al Sweigart', 'Eve', '2000'])" ; chx:output "['Al Sweigart', 'Eve', '2000']" .
chx:X_AppendTransaction rd:hasIOExample chx:IO_AppendTransaction .
chx:X_GoogleForms a owl:NamedIndividual, chx:GoogleForms ; rdfs:label "forms.google.com"@en ; skos:definition "Google Forms collects answers into a Google Sheets spreadsheet that a script reads like any other; the chapter points to chapters 19 and 20 for running such a script on a schedule and for sending a text when a form is filled."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_FormsResponses a owl:NamedIndividual, chx:FormsResponses ; rdfs:label "collect the e-mail addresses of the responses"@en ; skos:definition "Practice program 1 makes a form, creates its response spreadsheet and collects the e-mail addresses from it, which is the e-mail column without its header; no form was made for this study and the row handling was run on example rows."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_FormsResponses a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda rows: [r[2] for r in rows[1:]])([['Timestamp', 'Name', 'Email'], ['t1', 'Ann', 'ann@example.org'], ['t2', 'Bo', 'bo@example.org']]) evaluates to ['ann@example.org', 'bo@example.org']"@en ; chx:input "(lambda rows: [r[2] for r in rows[1:]])([['Timestamp', 'Name', 'Email'], ['t1', 'Ann', 'ann@example.org'], ['t2', 'Bo', 'bo@example.org']])" ; chx:output "['ann@example.org', 'bo@example.org']" .
chx:X_FormsResponses rd:hasIOExample chx:IO_FormsResponses .
chx:X_FormatConversion a owl:NamedIndividual, chx:FormatConversion ; rdfs:label "upload() then downloadAsExcel() and the others"@en ; skos:definition "Practice program 2 uploads a file and downloads it in the other formats with the six download methods; it needs Google's servers and was not run."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_FormatConversion a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted({'xlsx': 'downloadAsExcel', 'ods': 'downloadAsODS', 'csv': 'downloadAsCSV', 'tsv': 'downloadAsTSV', 'pdf': 'downloadAsPDF', 'zip': 'downloadAsHTML'}) evaluates to ['csv', 'ods', 'pdf', 'tsv', 'xlsx', 'zip']"@en ; chx:input "sorted({'xlsx': 'downloadAsExcel', 'ods': 'downloadAsODS', 'csv': 'downloadAsCSV', 'tsv': 'downloadAsTSV', 'pdf': 'downloadAsPDF', 'zip': 'downloadAsHTML'})" ; chx:output "['csv', 'ods', 'pdf', 'tsv', 'xlsx', 'zip']" .
chx:X_FormatConversion rd:hasIOExample chx:IO_FormatConversion .
chx:X_FindingMistakes a owl:NamedIndividual, chx:FindingMistakes ; rdfs:label "int(a) * int(b) != int(t)"@en ; skos:definition "Practice program 3 checks a product column over the 15000 rows of the Bean Count sheet with row numbers counted from 1 and a header in row 1; run on the export of 2026-10-01 it finds row 14399, where 804 times 623 is 500892 and the sheet shows 500891."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_FindingMistakes a owl:NamedIndividual, rd:IOExample ; rdfs:label "[n for n, (a, b, t) in enumerate([('3', '4', '12'), ('804', '623', '500891'), ('2', '5', '10')], 2) if int(a) * int(b) != int(t)] evaluates to [3]"@en ; chx:input "[n for n, (a, b, t) in enumerate([('3', '4', '12'), ('804', '623', '500891'), ('2', '5', '10')], 2) if int(a) * int(b) != int(t)]" ; chx:output "[3]" .
chx:X_FindingMistakes rd:hasIOExample chx:IO_FindingMistakes .
chx:X_RequestQuota a owl:NamedIndividual, chx:RequestQuota ; rdfs:label "Quota exceeded for quota group"@en ; skos:definition "Google limits the requests a project and a user may make per minute: its page read on 2026-10-01 gives 300 reads and 300 writes a minute per project and 60 of each per user per project, and asks for exponential backoff after HTTP 429; the chapter's 250 new spreadsheets a day is not on that page."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_RequestQuota a owl:NamedIndividual, rd:IOExample ; rdfs:label "-(-1000 // 60) evaluates to 17"@en ; chx:input "-(-1000 // 60)" ; chx:output "17" .
chx:X_RequestQuota rd:hasIOExample chx:IO_RequestQuota .
chx:X_QuotaRetry a owl:NamedIndividual, chx:QuotaRetry ; rdfs:label "HttpError, RESOURCE_EXHAUSTED"@en ; skos:definition "When Google answers that a quota is used up, EZSheets 2026.4.28 waits 10 seconds and tries again, adding 5 seconds each time, and raises the HttpError after the ninth attempt, 220 seconds of waiting in all; any other HTTP error is raised at once."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_QuotaRetry a owl:NamedIndividual, rd:IOExample ; rdfs:label "(list(range(10, 50, 5)), sum(range(10, 50, 5))) evaluates to ([10, 15, 20, 25, 30, 35, 40, 45], 220)"@en ; chx:input "(list(range(10, 50, 5)), sum(range(10, 50, 5)))" ; chx:output "([10, 15, 20, 25, 30, 35, 40, 45], 220)" .
chx:X_QuotaRetry rd:hasIOExample chx:IO_QuotaRetry .
chx:X_IgnoreQuota a owl:NamedIndividual, chx:IgnoreQuota ; rdfs:label "ezsheets.IGNORE_QUOTA = True"@en ; skos:definition "The chapter says that setting this name to True makes the methods raise the quota exception; in EZSheets 2026.4.28 it only switches off the library's own throttle of 90 requests in a window of 101 seconds, and the retry on a quota error stays, as executed with the setting False and True."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_BatchingRequests a owl:NamedIndividual, chx:BatchingRequests ; rdfs:label "updateColumn instead of 100 single writes"@en ; skos:definition "Every write is a web request, so 100 single-cell writes are 100 requests and one updateColumn is one; against a stand-in service, reading from a loaded sheet made no request and setting rowCount made three."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_SeparateAccount a owl:NamedIndividual, chx:SeparateAccount ; rdfs:label "a new Google account for scripts"@en ; skos:definition "The chapter recommends a separate Google account for scripts, so that a bug cannot touch personal spreadsheets, and warns that a deleted spreadsheet cannot be recovered; it is advice, not something a program can check."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:X_UserEnteredParsing a owl:NamedIndividual, chx:UserEnteredParsing ; rdfs:label "valueInputOption USER_ENTERED"@en ; skos:definition "The library writes every value with the USER_ENTERED option, which the API reference says parses the value as if typed into the interface, so a text can become a number or a date; what this does to a text that starts with = was not run."@en ; dcterms:source <http://example.org/sen0414/ch15/research> .
chx:IO_UserEnteredParsing a owl:NamedIndividual, rd:IOExample ; rdfs:label "[v for v in ('=SUM(A1:A2)', 'Alice', '30') if v.startswith('=')] evaluates to ['=SUM(A1:A2)']"@en ; chx:input "[v for v in ('=SUM(A1:A2)', 'Alice', '30') if v.startswith('=')]" ; chx:output "['=SUM(A1:A2)']" .
chx:X_UserEnteredParsing rd:hasIOExample chx:IO_UserEnteredParsing .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 15 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch15/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 15 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which objects, addresses and requests make up a script's conversation with a spreadsheet kept on Google's servers, and which of them cost a web request?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which statements of the chapter differ in the newest EZSheets and in Google's current pages, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 15 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 15 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch15/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-01."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

