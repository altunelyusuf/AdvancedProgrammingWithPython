pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain what a script needs before it can use a Google Sheets spreadsheet - a project, two APIs, a consent screen, scopes, a credentials file and token files - and why the token files must stay private"@en ;
    skos:definition "The objective is met when the reader can explain what a script needs before it can use a Google Sheets spreadsheet - a project, two APIs, a consent screen, scopes, a credentials file and token files - and why the token files must stay private, at the understand level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter15.html> ;
    ld:bloomLevel ld:Understand  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Address cells and columns with the 1-based numbers and the letters of a sheet, convert between them, and map them to list positions"@en ;
    skos:definition "The objective is met when the reader can address cells and columns with the 1-based numbers and the letters of a sheet, convert between them, and map them to list positions, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter15.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Read and write cells, rows, columns and whole sheets through a Sheet object, knowing that values are text and that some calls change the list they are given"@en ;
    skos:definition "The objective is met when the reader can read and write cells, rows, columns and whole sheets through a Sheet object, knowing that values are text and that some calls change the list they are given, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter15.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Open, create, upload, download, delete, reorder and copy spreadsheets and sheets, and tell which steps were read and not run here"@en ;
    skos:definition "The objective is met when the reader can open, create, upload, download, delete, reorder and copy spreadsheets and sheets, and tell which steps were read and not run here, at the understand level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter15.html> ;
    ld:bloomLevel ld:Understand  .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Analyze how many web requests a script makes, what a quota error does in the newest library, and why a script should batch its writes"@en ;
    skos:definition "The objective is met when the reader can analyze how many web requests a script makes, what a quota error does in the newest library, and why a script should batch its writes, at the analyze level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter15.html> ;
    ld:bloomLevel ld:Analyze  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why must a token-sheets.pickle file from another person never be loaded with pickle.load?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Size is not the issue; the danger is in what loading does." ;
    ld:distractorRationale "A pickle file is not encrypted; it is a recipe for building objects, and the recipe can call functions." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "Unpickling can run code chosen by whoever made the file" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "The file is too large to load" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "Pickle files are encrypted and cannot be read" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which scope does Google's scope table recommend when access to only the files an app itself uses is enough?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "The Drive scope is classed as restricted and gives access to all of the user's Drive files." ;
    ld:distractorRationale "The Sheets scope is classed as sensitive and covers all the user's spreadsheets." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "auth/drive.file" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "auth/drive" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "auth/spreadsheets" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which column number is the column with the letters ZZZ?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "17576 is 26 cubed, the number of three-letter columns; ZZZ is the last of them and comes after the 702 columns of one and two letters, so it is 702 + 17576 = 18278." ;
    ld:distractorRationale "702 is the column ZZ, with two letters." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "18278" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "17576" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "702" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A sheet is read into rows = [['Name', 'Age'], ['Alice', '30']]. Which list position holds the cell B2?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "Cells count from 1 and lists from 0, so the row and the column are both one less than the cell's numbers." ;
    ld:distractorRationale "Row 2 is rows[1] and column B is item 1, not 2." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "rows[1][1]" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "rows[2][2]" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "rows[2][1]" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does ezsheets.getColumnLetterOf(703) return?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "ZZ is column 702; 703 is the first three-letter column." ;
    ld:distractorRationale "AAB is column 704." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "'AAA'" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "'ZZ'" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "'AAB'" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A cell holds no text. What does int(row[4]) do when row[4] is the empty string ''?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "int of an empty string is an error and not 0; the audit program of the chapter stops on a blank row for that reason." ;
    ld:distractorRationale "int never returns None." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "It raises ValueError: invalid literal for int() with base 10: ''" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "It gives 0" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "It gives None" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "addBoringcoinTransaction.py checks len(sys.argv) < 4 and then runs sender, recipient, amount = sys.argv[1:]. What happens for python addBoringcoinTransaction.py Al Sweigart Eve 2000, without quotes?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "Without quotes the shell makes four arguments, Al, Sweigart, Eve and 2000, not three." ;
    ld:distractorRationale "There are five items in sys.argv, which is not fewer than 4, so the usage message is not printed." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "ValueError: too many values to unpack (expected 3, got 4)" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "It adds a transaction from 'Al Sweigart' to 'Eve'" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "It prints the usage message" .
pg:Q8 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "ss.sheetTitles is the tuple ('Sheet1', 'Spam', 'Eggs'). What does ss.sheetTitles[0] = 'X' do?"@en ; ld:hasOption pg:Q8_O0, pg:Q8_O1, pg:Q8_O2 ; ld:hasCorrectOption pg:Q8_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "A tuple is immutable, so nothing is renamed; a sheet is renamed by assigning to its own title." ;
    ld:distractorRationale "Assignment to a tuple item never inserts anything." .
pg:Q8_O0 a ld:AnswerOption ; rdfs:label "It raises TypeError: 'tuple' object does not support item assignment" .
pg:Q8_O1 a ld:AnswerOption ; rdfs:label "It renames the first sheet" .
pg:Q8_O2 a ld:AnswerOption ; rdfs:label "It inserts a sheet called X" .
pg:Q9 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A script has loaded a sheet. Someone changes cell A1 in the browser. What does sheet['A1'] show in the script before sheet.refresh() is called? (The library keeps a loaded copy; a stand-in for Google showed it.)"@en ; ld:hasOption pg:Q9_O0, pg:Q9_O1, pg:Q9_O2 ; ld:hasCorrectOption pg:Q9_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "The script does not see the change until it refreshes." ;
    ld:distractorRationale "Reading the loaded copy is not an error." .
pg:Q9_O0 a ld:AnswerOption ; rdfs:label "The old text, read from the script's loaded copy" .
pg:Q9_O1 a ld:AnswerOption ; rdfs:label "The new text" .
pg:Q9_O2 a ld:AnswerOption ; rdfs:label "An error" .
pg:Q10 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A script writes 100 cells of one column, first with 100 single-cell writes and then with one updateColumn call. How many web requests does the library send for the two ways? (Counted against a stand-in for Google, which shows what is sent, not what Google answers.)"@en ; ld:hasOption pg:Q10_O0, pg:Q10_O1, pg:Q10_O2 ; ld:hasCorrectOption pg:Q10_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "Each single-cell write is its own request, which is what makes a long loop slow and quota-hungry." ;
    ld:distractorRationale "updateColumn sends its whole list in one request, so it is not 100." .
pg:Q10_O0 a ld:AnswerOption ; rdfs:label "100 and 1" .
pg:Q10_O1 a ld:AnswerOption ; rdfs:label "1 and 1" .
pg:Q10_O2 a ld:AnswerOption ; rdfs:label "100 and 100" .
pg:Q11 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "In EZSheets 2026.4.28, a quota error (HTTP 429, RESOURCE_EXHAUSTED) is answered to a write while ezsheets.IGNORE_QUOTA is True. What does the library do? (The study played Google's answer with a stand-in; Google itself was never asked.)"@en ; ld:hasOption pg:Q11_O0, pg:Q11_O1, pg:Q11_O2 ; ld:hasCorrectOption pg:Q11_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "That is what the chapter says, but in this library the setting only switches off the library's own throttle, and the retry stays." ;
    ld:distractorRationale "The library raises the error in the end and never drops a request silently." .
pg:Q11_O0 a ld:AnswerOption ; rdfs:label "The request is retried after growing pauses, nine attempts in all, and then the HttpError is raised" .
pg:Q11_O1 a ld:AnswerOption ; rdfs:label "The HttpError is raised at once" .
pg:Q11_O2 a ld:AnswerOption ; rdfs:label "The request is dropped without an error" .
pg:Q12 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "The script sets sheet.rowCount = sheet.rowCount + 1. How many web requests does the library send? (Counted against a stand-in for Google.)"@en ; ld:hasOption pg:Q12_O0, pg:Q12_O1, pg:Q12_O2 ; ld:hasCorrectOption pg:Q12_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "Reading rowCount and the update are separate requests, and the library also reads the values it must send back." ;
    ld:distractorRationale "Assigning rowCount sends an update to the sheet, so something is sent." .
pg:Q12_O0 a ld:AnswerOption ; rdfs:label "3: it reads the sheet's size, reads its values and then sends the update" .
pg:Q12_O1 a ld:AnswerOption ; rdfs:label "1: only the update" .
pg:Q12_O2 a ld:AnswerOption ; rdfs:label "0: the size is kept in the loaded copy" .
pg:GoogleAccess a ipo:ChapterSection ; rdfs:label "Google access"@en ;
    skos:definition "Before a script can touch a spreadsheet, chapter 15 has the reader build the access by hand: a Google Cloud project, the Sheets and Drive APIs switched on, an OAuth consent screen, a credentials file and, at the first run, two token files that the library writes after a sign-in in a browser (Sweigart, 2025). The chapter calls this a one-time setup that is free, and advises a new Google account for the scripts (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_GoogleAccess> ;
    sen0414:anchor "#s-GoogleAccess" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:GoogleAccess .
pg:CloudProject a ipo:ChapterSection ; rdfs:label "Cloud project"@en ;
    skos:definition "The chapter begins in the Google Cloud console: create a project, which gets a name that can be changed and a project ID that cannot, and switch on the Google Sheets API and the Google Drive API (Sweigart, 2025). Google's own page on projects says the same of the ID and that after creation the ID is permanent, and adds that the number of projects an account may create is limited (Google Cloud documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CloudProject> ;
    sen0414:anchor "#s-CloudProject" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:GoogleAccess .
pg:Page ipo:coversChapterSection pg:CloudProject .
pg:CloudProjectIds a ipo:ChapterSection ; rdfs:label "Cloud project ids"@en ;
    skos:definition "The chapter has the reader create a Google Cloud project and notes that it generates a name such as My Project 23135 and a random project ID such as macro-nuance-362516, that neither is seen by the users of the scripts, and that the name can be changed but the ID cannot (Sweigart, 2025). Google's page on projects agrees: the name can be edited at any time, and after creation the project ID is permanent (Google Cloud documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CloudProjectIds> ;
    sen0414:anchor "#s-CloudProjectIds" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CloudProject .
pg:Page ipo:coversChapterSection pg:CloudProjectIds .
pg:ApiEnablement a ipo:ChapterSection ; rdfs:label "Api enablement"@en ;
    skos:definition "The chapter has the reader switch on the Google Sheets API and the Google Drive API in the project, because EZSheets uses both (Sweigart, 2025). Google's pages name them as the Sheets API v4 and the Drive API v3 and document the methods the library calls (Google Sheets API documentation, 2026)(Google Drive API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ApiEnablement> ;
    sen0414:anchor "#s-ApiEnablement" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CloudProject .
pg:Page ipo:coversChapterSection pg:ApiEnablement .
pg:ConsentScreen a ipo:ChapterSection ; rdfs:label "Consent screen"@en ;
    skos:definition "The consent screen is the page Google shows when a person is asked to let the script use a spreadsheet. The chapter describes a wizard with an app name, a user type, scopes and test users, and says nothing of how long the permission lasts (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ConsentScreen> ;
    sen0414:anchor "#s-ConsentScreen" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:GoogleAccess .
pg:Page ipo:coversChapterSection pg:ConsentScreen .
pg:ConsentScreenUi a ipo:ChapterSection ; rdfs:label "Consent screen ui"@en ;
    skos:definition "The chapter walks through a consent-screen wizard in the console, choosing a user type, an app name, scopes and test users, and shows it in pictures (Sweigart, 2025). Google's current guide for Workspace developers describes the same work as three pages of the Google Auth platform, Branding, Audience and Data Access (Google Identity documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ConsentScreenUi> ;
    sen0414:anchor "#s-ConsentScreenUi" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ConsentScreen .
pg:Page ipo:coversChapterSection pg:ConsentScreenUi .
pg:ScopesChosen a ipo:ChapterSection ; rdfs:label "Scopes chosen"@en ;
    skos:definition "A scope is the permission an app asks for. The chapter does not name the scopes; the library asks for https://www.googleapis.com/auth/spreadsheets for the Sheets client and https://www.googleapis.com/auth/drive for the Drive client (Sweigart, 2025)(Google API Client Library documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ScopesChosen> ;
    sen0414:anchor "#s-ScopesChosen" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ConsentScreen .
pg:Page ipo:coversChapterSection pg:ScopesChosen .
pg:TestUsers a ipo:ChapterSection ; rdfs:label "Test users"@en ;
    skos:definition "The chapter has the reader add their own address as a test user in the third step of the consent screen and later sign in with that same address; it does not say that a test app has limits (Sweigart, 2025). Google's help on the app audience says an app in Testing status is limited to 100 test users and that authorizations expire after seven days (Google Help, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_TestUsers> ;
    sen0414:anchor "#s-TestUsers" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ConsentScreen .
pg:Page ipo:coversChapterSection pg:TestUsers .
pg:TokenLifetime a ipo:ChapterSection ; rdfs:label "Token lifetime"@en ;
    skos:definition "The chapter calls the token files a one-time setup that will not happen again (Sweigart, 2025). Google's identity page says that for an app with the Testing status and the External user type the refresh token expires in seven days, and RFC 6749 names the error invalid_grant for a refresh token that is invalid, expired or revoked (Google Identity documentation, 2026)(IETF, 2012)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_TokenLifetime> ;
    sen0414:anchor "#s-TokenLifetime" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ConsentScreen .
pg:Page ipo:coversChapterSection pg:TokenLifetime .
pg:CredentialFiles a ipo:ChapterSection ; rdfs:label "Credential files"@en ;
    skos:definition "The chapter names a credentials file and two token files and warns that whoever gets them can read the spreadsheets, though not change the password (Sweigart, 2025). The credentials file is the client secret that Google lets the reader download; the token files are written by the library after the first sign-in (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CredentialFiles> ;
    sen0414:anchor "#s-CredentialFiles" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:GoogleAccess .
pg:Page ipo:coversChapterSection pg:CredentialFiles .
pg:CredentialsFile a ipo:ChapterSection ; rdfs:label "Credentials file"@en ;
    skos:definition "The chapter tells the reader to download the credentials JSON file, put it in the folder of the script and call ezsheets.init() or just import the library, which looks for it (Sweigart, 2025). The file is the OAuth client secret of an installed-app client in the project (Google Identity documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CredentialsFile> ;
    sen0414:anchor "#s-CredentialsFile" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CredentialFiles .
pg:Page ipo:coversChapterSection pg:CredentialsFile .
pg:TokenFiles a ipo:ChapterSection ; rdfs:label "Token files"@en ;
    skos:definition "The chapter says the library writes two token files, token-drive.pickle and token-sheets.pickle, beside the credentials file; the text of the page has a stray space in one of the names, token-sheets .pickle, and the paragraph above it speaks of two token JSON files although both are pickles (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_TokenFiles> ;
    sen0414:anchor "#s-TokenFiles" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CredentialFiles .
pg:Page ipo:coversChapterSection pg:TokenFiles .
pg:TokenPickle a ipo:ChapterSection ; rdfs:label "Token pickle"@en ;
    skos:definition "Python's documentation says the pickle module is not secure and that only data one trusts should be unpickled; OWASP and MITRE list deserialization of untrusted data as a class of weakness, CWE-502 (Python Software Foundation, 2026)(OWASP, 2026)(MITRE, 2026). The library loads its token files with pickle.load when it is imported (EZSheets documentation, 2019)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_TokenPickle> ;
    sen0414:anchor "#s-TokenPickle" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CredentialFiles .
pg:Page ipo:coversChapterSection pg:TokenPickle .
pg:RevokeCredentials a ipo:ChapterSection ; rdfs:label "Revoke credentials"@en ;
    skos:definition "The chapter tells the reader that if the credentials or token files are shared by accident the OAuth client can be removed in the console, after which the files are useless and new ones must be made (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_RevokeCredentials> ;
    sen0414:anchor "#s-RevokeCredentials" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CredentialFiles .
pg:Page ipo:coversChapterSection pg:RevokeCredentials .
pg:SignInFlow a ipo:ChapterSection ; rdfs:label "Sign in flow"@en ;
    skos:definition "At the first call the library opens the browser on Google's consent page, as the chapter says, and the reader clicks through warnings and allows the access (Sweigart, 2025). This is the installed-app flow of OAuth 2.0: an authorization request in the browser and a redirect to a port on the local machine, which the IETF describes for native apps (IETF, 2017)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SignInFlow> ;
    sen0414:anchor "#s-SignInFlow" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:GoogleAccess .
pg:Page ipo:coversChapterSection pg:SignInFlow .
pg:LocalServerFlow a ipo:ChapterSection ; rdfs:label "Local server flow"@en ;
    skos:definition "At the first run the library opens the browser on Google's consent page and listens for the redirect on the local machine, the loopback flow Google recommends for desktop apps and the IETF describes for native apps, with a PKCE code challenge to protect the code (Google Identity documentation, 2026)(IETF, 2017)(IETF, 2015)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_LocalServerFlow> ;
    sen0414:anchor "#s-LocalServerFlow" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SignInFlow .
pg:Page ipo:coversChapterSection pg:LocalServerFlow .
pg:NoBrowserFailure a ipo:ChapterSection ; rdfs:label "No browser failure"@en ;
    skos:definition "The chapter assumes a desktop with a browser: the library launches it and the reader clicks through the consent (Sweigart, 2025). Python's webbrowser module raises webbrowser.Error when it finds no browser, and takes the program named in the BROWSER environment variable first (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_NoBrowserFailure> ;
    sen0414:anchor "#s-NoBrowserFailure" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SignInFlow .
pg:Page ipo:coversChapterSection pg:NoBrowserFailure .
pg:SpreadsheetObjects a ipo:ChapterSection ; rdfs:label "Spreadsheet objects"@en ;
    skos:definition "A Spreadsheet object stands for one file in Google Sheets: the chapter opens it from a URL, an id or a title, creates one, uploads one from a file, reads its attributes, downloads it as Excel, OpenOffice, CSV, TSV, PDF or HTML, lists the account's spreadsheets and deletes them (Sweigart, 2025). EZSheets sends each of these as a request to the Sheets or the Drive API, which the library's own documentation, last dated November 2019, hardly describes (EZSheets documentation, 2019)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SpreadsheetObjects> ;
    sen0414:anchor "#s-SpreadsheetObjects" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:SpreadsheetObjects .
pg:OpeningSpreadsheets a ipo:ChapterSection ; rdfs:label "Opening spreadsheets"@en ;
    skos:definition "The chapter opens a spreadsheet by a short link, by the long URL and by the bare id, and shows that the three give objects that compare equal; it makes a new one with ezsheets.Spreadsheet() and gives it a title (Sweigart, 2025). The library adds a fourth way, a title, which it looks up among the account's spreadsheets (EZSheets documentation, 2019)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_OpeningSpreadsheets> ;
    sen0414:anchor "#s-OpeningSpreadsheets" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SpreadsheetObjects .
pg:Page ipo:coversChapterSection pg:OpeningSpreadsheets .
pg:SpreadsheetId a ipo:ChapterSection ; rdfs:label "Spreadsheet id"@en ;
    skos:definition "The chapter opens the same spreadsheet by a short link, by its long URL and by its id and shows ss1 == ss2 == ss3 giving True (Sweigart, 2025). Google's spreadsheet id is the string between /d/ and the next slash in the address (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SpreadsheetId> ;
    sen0414:anchor "#s-SpreadsheetId" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OpeningSpreadsheets .
pg:Page ipo:coversChapterSection pg:SpreadsheetId .
pg:IdFromUrl a ipo:ChapterSection ; rdfs:label "Id from url"@en ;
    skos:definition "The chapter does not show how the id is taken from a URL; Google's API addresses a spreadsheet by its spreadsheetId, and the id is the part of the address after /spreadsheets/d/ (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_IdFromUrl> ;
    sen0414:anchor "#s-IdFromUrl" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OpeningSpreadsheets .
pg:Page ipo:coversChapterSection pg:IdFromUrl .
pg:OpenByTitle a ipo:ChapterSection ; rdfs:label "Open by title"@en ;
    skos:definition "The chapter gives titles only as something to set; the library lets a title open a spreadsheet by a search among all spreadsheets of the account (Sweigart, 2025)(EZSheets documentation, 2019)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_OpenByTitle> ;
    sen0414:anchor "#s-OpenByTitle" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OpeningSpreadsheets .
pg:Page ipo:coversChapterSection pg:OpenByTitle .
pg:NewSpreadsheet a ipo:ChapterSection ; rdfs:label "New spreadsheet"@en ;
    skos:definition "The chapter makes a spreadsheet with ezsheets.Spreadsheet() and then gives it a title; the first sheet of the new file is called Sheet1 (Sweigart, 2025). Google creates a spreadsheet from a request that carries its properties (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_NewSpreadsheet> ;
    sen0414:anchor "#s-NewSpreadsheet" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OpeningSpreadsheets .
pg:Page ipo:coversChapterSection pg:NewSpreadsheet .
pg:SpreadsheetAttributes a ipo:ChapterSection ; rdfs:label "Spreadsheet attributes"@en ;
    skos:definition "The chapter shows the attributes title, id, url, sheetTitles and sheets of a Spreadsheet, says some are read-only and mentions refresh() once, for changes made by someone else (Sweigart, 2025). The sheets of a spreadsheet are Google's sheets, each with an id of its own (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SpreadsheetAttributes> ;
    sen0414:anchor "#s-SpreadsheetAttributes" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SpreadsheetObjects .
pg:Page ipo:coversChapterSection pg:SpreadsheetAttributes .
pg:TitleAttribute a ipo:ChapterSection ; rdfs:label "Title attribute"@en ;
    skos:definition "The chapter assigns ss.title = 'Title of My New Spreadsheet' and reads it back (Sweigart, 2025). In Google's API a title is a property of the spreadsheet changed by an updateSpreadsheetProperties request inside batchUpdate (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_TitleAttribute> ;
    sen0414:anchor "#s-TitleAttribute" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SpreadsheetAttributes .
pg:Page ipo:coversChapterSection pg:TitleAttribute .
pg:ReadOnlyAttributes a ipo:ChapterSection ; rdfs:label "Read only attributes"@en ;
    skos:definition "The chapter marks the id and the url as read-only attributes in its comments (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ReadOnlyAttributes> ;
    sen0414:anchor "#s-ReadOnlyAttributes" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SpreadsheetAttributes .
pg:Page ipo:coversChapterSection pg:ReadOnlyAttributes .
pg:SheetsTuple a ipo:ChapterSection ; rdfs:label "Sheets tuple"@en ;
    skos:definition "The chapter prints ss.sheets as a tuple of Sheet objects and uses ss.sheets[0], ss['Copy of Books'] and sheetTitles (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SheetsTuple> ;
    sen0414:anchor "#s-SheetsTuple" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SpreadsheetAttributes .
pg:Page ipo:coversChapterSection pg:SheetsTuple .
pg:RefreshMethod a ipo:ChapterSection ; rdfs:label "Refresh method"@en ;
    skos:definition "The chapter shows ss.refresh() on its own and explains that it re-reads the spreadsheet, for when someone else has changed it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_RefreshMethod> ;
    sen0414:anchor "#s-RefreshMethod" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SpreadsheetAttributes .
pg:Page ipo:coversChapterSection pg:RefreshMethod .
pg:FileTransfer a ipo:ChapterSection ; rdfs:label "File transfer"@en ;
    skos:definition "A Google spreadsheet can be exported by Drive in several formats and made from several kinds of file, and EZSheets wraps both: upload() takes a file and the six downloadAs methods return a file name (Sweigart, 2025). Drive limits an export to 10 MB and marks the CSV and TSV exports as first-sheet only (Google Drive API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_FileTransfer> ;
    sen0414:anchor "#s-FileTransfer" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SpreadsheetObjects .
pg:Page ipo:coversChapterSection pg:FileTransfer .
pg:UploadSpreadsheet a ipo:ChapterSection ; rdfs:label "Upload spreadsheet"@en ;
    skos:definition "The chapter uploads my_spreadsheet.xlsx with ezsheets.upload and prints the title my_spreadsheet, and in a practice program asks for a converter that uploads a file and downloads it in another format (Sweigart, 2025). Drive accepts a file with metadata in a multipart request (Google Drive API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_UploadSpreadsheet> ;
    sen0414:anchor "#s-UploadSpreadsheet" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FileTransfer .
pg:Page ipo:coversChapterSection pg:UploadSpreadsheet .
pg:DownloadFormats a ipo:ChapterSection ; rdfs:label "Download formats"@en ;
    skos:definition "The chapter lists six methods and the files they save: Excel, OpenOffice, CSV, TSV, PDF and a zip of HTML (Sweigart, 2025). Drive's list of export formats marks the CSV and TSV exports as first-sheet only, and files.export limits the exported content to 10 MB (Google Drive API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_DownloadFormats> ;
    sen0414:anchor "#s-DownloadFormats" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FileTransfer .
pg:Page ipo:coversChapterSection pg:DownloadFormats .
pg:DownloadFileName a ipo:ChapterSection ; rdfs:label "Download file name"@en ;
    skos:definition "The chapter prints Sweigart_Books.xlsx for a spreadsheet titled Sweigart Books (DO NOT DELETE), and gives the name a_different_filename.xlsx as an example of the optional argument (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_DownloadFileName> ;
    sen0414:anchor "#s-DownloadFileName" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FileTransfer .
pg:Page ipo:coversChapterSection pg:DownloadFileName .
pg:DownloadFileHandle a ipo:ChapterSection ; rdfs:label "Download file handle"@en ;
    skos:definition "The chapter does not mention the file the download methods write; Python's warnings module defines ResourceWarning for a resource that is not closed and ignores it by default (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_DownloadFileHandle> ;
    sen0414:anchor "#s-DownloadFileHandle" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FileTransfer .
pg:Page ipo:coversChapterSection pg:DownloadFileHandle .
pg:ListingDeleting a ipo:ChapterSection ; rdfs:label "Listing deleting"@en ;
    skos:definition "The chapter lists the account's spreadsheets as a dictionary from id to title, deletes one to the Trash, notes that it is still listed there and deletes one for good with permanent=True (Sweigart, 2025). Google's Drive guide says a trashed file can be restored within 30 days and that deleting removes it permanently (Google Drive API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ListingDeleting> ;
    sen0414:anchor "#s-ListingDeleting" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SpreadsheetObjects .
pg:Page ipo:coversChapterSection pg:ListingDeleting .
pg:ListSpreadsheets a ipo:ChapterSection ; rdfs:label "List spreadsheets"@en ;
    skos:definition "The chapter lists the account's spreadsheets as a dictionary of id to title and points out that a deleted one is still listed (Sweigart, 2025). Google's files.list returns trashed files unless the query says trashed = false (Google Drive API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ListSpreadsheets> ;
    sen0414:anchor "#s-ListSpreadsheets" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ListingDeleting .
pg:Page ipo:coversChapterSection pg:ListSpreadsheets .
pg:TrashAndDelete a ipo:ChapterSection ; rdfs:label "Trash and delete"@en ;
    skos:definition "The chapter deletes with ss.delete(), which moves the spreadsheet to the Trash, and with ss.delete(permanent=True), which cannot be undone, and advises against permanent deletion in scripts (Sweigart, 2025). Google's guide says a trashed file can be restored within 30 days and that delete removes a file permanently (Google Drive API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_TrashAndDelete> ;
    sen0414:anchor "#s-TrashAndDelete" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ListingDeleting .
pg:Page ipo:coversChapterSection pg:TrashAndDelete .
pg:SheetObjects a ipo:ChapterSection ; rdfs:label "Sheet objects"@en ;
    skos:definition "A Sheet object is one tab of a spreadsheet, and most of the chapter is about reading and writing its cells: by A1 address or by column and row, by row or column as a list, by all rows at once, and by changing its size, its place among the tabs, copying it elsewhere and clearing it (Sweigart, 2025). Google's own API speaks in ranges written in A1 notation, and EZSheets builds them for each call (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SheetObjects> ;
    sen0414:anchor "#s-SheetObjects" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:SheetObjects .
pg:CellAccess a ipo:ChapterSection ; rdfs:label "Cell access"@en ;
    skos:definition "The chapter reads and writes cells like dictionary items, sheet['A1'] and sheet[1, 1], says an empty cell is an empty string, that indices start at 1 and that all values come back as strings (Sweigart, 2025). Google's API reads values in a rendering that by default is the formatted text of the cell (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CellAccess> ;
    sen0414:anchor "#s-CellAccess" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SheetObjects .
pg:Page ipo:coversChapterSection pg:CellAccess .
pg:CellByAddress a ipo:ChapterSection ; rdfs:label "Cell by address"@en ;
    skos:definition "The chapter reads and writes a cell by its address in square brackets, sheet['A1'] = 'Name', after taking the first sheet with ss.sheets[0] (Sweigart, 2025). Google addresses a cell in A1 notation, a column letter and a row number (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CellByAddress> ;
    sen0414:anchor "#s-CellByAddress" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CellAccess .
pg:Page ipo:coversChapterSection pg:CellByAddress .
pg:CellByColumnRow a ipo:ChapterSection ; rdfs:label "Cell by column row"@en ;
    skos:definition "The chapter shows sheet[2, 1] as the same cell as B1, column first and then row (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CellByColumnRow> ;
    sen0414:anchor "#s-CellByColumnRow" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CellAccess .
pg:Page ipo:coversChapterSection pg:CellByColumnRow .
pg:EmptyCell a ipo:ChapterSection ; rdfs:label "Empty cell"@en ;
    skos:definition "The chapter says that empty cells return a blank string (Sweigart, 2025). Google's values.get leaves out trailing empty cells and rows from its answer (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_EmptyCell> ;
    sen0414:anchor "#s-EmptyCell" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CellAccess .
pg:Page ipo:coversChapterSection pg:EmptyCell .
pg:ValuesAsText a ipo:ChapterSection ; rdfs:label "Values as text"@en ;
    skos:definition "The chapter writes sheet['B2'] = 30 and shows the read-back as '30', with the comment that all data is returned as strings (Sweigart, 2025). Google parses a value sent with USER_ENTERED as if a person had typed it into the cell, and values.get returns the formatted value by default (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ValuesAsText> ;
    sen0414:anchor "#s-ValuesAsText" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CellAccess .
pg:Page ipo:coversChapterSection pg:ValuesAsText .
pg:OneBasedIndex a ipo:ChapterSection ; rdfs:label "One based index"@en ;
    skos:definition "The chapter stresses that the first row is row 1 and not row 0 and that the first column is A (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_OneBasedIndex> ;
    sen0414:anchor "#s-OneBasedIndex" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CellAccess .
pg:Page ipo:coversChapterSection pg:OneBasedIndex .
pg:AddressConversion a ipo:ChapterSection ; rdfs:label "Address conversion"@en ;
    skos:definition "The chapter converts between a column letter and a number, getColumnLetterOf(999) giving 'ALK' and getColumnNumberOf('ZZZ') giving 18278, and between a string address and a tuple (Sweigart, 2025). Google writes ranges in A1 notation, a sheet name, an exclamation mark and two cell addresses, and requires single quotes round a name that has spaces or special characters (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_AddressConversion> ;
    sen0414:anchor "#s-AddressConversion" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SheetObjects .
pg:Page ipo:coversChapterSection pg:AddressConversion .
pg:ConvertAddress a ipo:ChapterSection ; rdfs:label "Convert address"@en ;
    skos:definition "The chapter converts 'A2' to (1, 2) and (1, 2) back to 'A2' (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ConvertAddress> ;
    sen0414:anchor "#s-ConvertAddress" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:AddressConversion .
pg:Page ipo:coversChapterSection pg:ConvertAddress .
pg:ColumnLetters a ipo:ChapterSection ; rdfs:label "Column letters"@en ;
    skos:definition "The chapter converts a column number to its letters, 999 giving ALK, and notes that the columns of a sheet can go beyond Z (Sweigart, 2025). The letters continue past Z as AA, AB and so on (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ColumnLetters> ;
    sen0414:anchor "#s-ColumnLetters" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:AddressConversion .
pg:Page ipo:coversChapterSection pg:ColumnLetters .
pg:ColumnNumbers a ipo:ChapterSection ; rdfs:label "Column numbers"@en ;
    skos:definition "The chapter converts 'ZZZ' to 18278 (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ColumnNumbers> ;
    sen0414:anchor "#s-ColumnNumbers" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:AddressConversion .
pg:Page ipo:coversChapterSection pg:ColumnNumbers .
pg:RangeNotation a ipo:ChapterSection ; rdfs:label "Range notation"@en ;
    skos:definition "The chapter does not show the ranges the library sends; Google's concepts page says A1 notation is a sheet name, an exclamation mark and a range, and that single quotes are required for sheet names with spaces or special characters (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_RangeNotation> ;
    sen0414:anchor "#s-RangeNotation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:AddressConversion .
pg:Page ipo:coversChapterSection pg:RangeNotation .
pg:RowsColumns a ipo:ChapterSection ; rdfs:label "Rows columns"@en ;
    skos:definition "The chapter reads a row or a column as a list, changes the list and writes it back, does the same for all rows with getRows and updateRows, and shrinks the produce sheet by setting columnCount to 4 (Sweigart, 2025). The lists are as wide and as tall as the grid of the sheet, 23,758 rows by 6 columns for the produce sheet (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_RowsColumns> ;
    sen0414:anchor "#s-RowsColumns" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SheetObjects .
pg:Page ipo:coversChapterSection pg:RowsColumns .
pg:GetRowColumn a ipo:ChapterSection ; rdfs:label "Get row column"@en ;
    skos:definition "The chapter reads a row with getRow and a column with getColumn, by number or by letter, and the lists it prints end in empty strings (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_GetRowColumn> ;
    sen0414:anchor "#s-GetRowColumn" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:RowsColumns .
pg:Page ipo:coversChapterSection pg:GetRowColumn .
pg:UpdateRowColumn a ipo:ChapterSection ; rdfs:label "Update row column"@en ;
    skos:definition "The chapter updates a row with a list of four values, then upper-cases a whole column in a loop and writes it back with one updateColumn call (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_UpdateRowColumn> ;
    sen0414:anchor "#s-UpdateRowColumn" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:RowsColumns .
pg:Page ipo:coversChapterSection pg:UpdateRowColumn .
pg:UpdateAllRows a ipo:ChapterSection ; rdfs:label "Update all rows"@en ;
    skos:definition "The chapter gets every row with getRows, changes the lists in place and writes them all back with updateRows, noting that the update takes a moment (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_UpdateAllRows> ;
    sen0414:anchor "#s-UpdateAllRows" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:RowsColumns .
pg:Page ipo:coversChapterSection pg:UpdateAllRows .
pg:SheetSize a ipo:ChapterSection ; rdfs:label "Sheet size"@en ;
    skos:definition "The chapter reads rowCount 23758 and columnCount 6 of the produce sheet and sets columnCount to 4, which removes the two empty columns E and F (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SheetSize> ;
    sen0414:anchor "#s-SheetSize" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:RowsColumns .
pg:Page ipo:coversChapterSection pg:SheetSize .
pg:SheetLifecycle a ipo:ChapterSection ; rdfs:label "Sheet lifecycle"@en ;
    skos:definition "The chapter creates sheets with Sheet() and prints a Sheet object for each, moves them with index, deletes them and clears one, then copies a sheet into another spreadsheet and sees the copy named Copy of the title (Sweigart, 2025). Google's copyTo method names the destination spreadsheet and returns the properties of the new sheet (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SheetLifecycle> ;
    sen0414:anchor "#s-SheetLifecycle" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SheetObjects .
pg:Page ipo:coversChapterSection pg:SheetLifecycle .
pg:CreateSheet a ipo:ChapterSection ; rdfs:label "Create sheet"@en ;
    skos:definition "The chapter creates sheets with ss.Sheet('Spam') and shows the Sheet object printed for each, with a sheetId and the title (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CreateSheet> ;
    sen0414:anchor "#s-CreateSheet" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SheetLifecycle .
pg:Page ipo:coversChapterSection pg:CreateSheet .
pg:SheetIndex a ipo:ChapterSection ; rdfs:label "Sheet index"@en ;
    skos:definition "The chapter moves a sheet by assigning to its index, from 0 to 2 and back, and creates one at index 0 with ss.Sheet('Bacon', 0) (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SheetIndex> ;
    sen0414:anchor "#s-SheetIndex" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SheetLifecycle .
pg:Page ipo:coversChapterSection pg:SheetIndex .
pg:DeleteSheet a ipo:ChapterSection ; rdfs:label "Delete sheet"@en ;
    skos:definition "The chapter deletes sheets with sheet.delete(), by index and by name, and ends with a spreadsheet that has one sheet (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_DeleteSheet> ;
    sen0414:anchor "#s-DeleteSheet" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SheetLifecycle .
pg:Page ipo:coversChapterSection pg:DeleteSheet .
pg:ClearSheet a ipo:ChapterSection ; rdfs:label "Clear sheet"@en ;
    skos:definition "The chapter clears Sheet1 and shows that the sheet still exists (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ClearSheet> ;
    sen0414:anchor "#s-ClearSheet" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SheetLifecycle .
pg:Page ipo:coversChapterSection pg:ClearSheet .
pg:CopySheet a ipo:ChapterSection ; rdfs:label "Copy sheet"@en ;
    skos:definition "The chapter copies a sheet to another spreadsheet and shows the copy named Copy of Spam (Sweigart, 2025). Google's copyTo takes the id of the destination spreadsheet and the new sheet is named Copy of and the title (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CopySheet> ;
    sen0414:anchor "#s-CopySheet" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SheetLifecycle .
pg:Page ipo:coversChapterSection pg:CopySheet .
pg:SheetQuirks a ipo:ChapterSection ; rdfs:label "Sheet quirks"@en ;
    skos:definition "The chapter does not say how two sheets, two spreadsheets or a sheet and a value compare; its Spreadsheet equality test is the only one it shows (Sweigart, 2025). Python lets a class define == through __eq__ and in through __contains__ as it likes (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SheetQuirks> ;
    sen0414:anchor "#s-SheetQuirks" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SheetObjects .
pg:Page ipo:coversChapterSection pg:SheetQuirks .
pg:SheetEquality a ipo:ChapterSection ; rdfs:label "Sheet equality"@en ;
    skos:definition "The chapter shows ss1 == ss2 == ss3 for the three ways of opening one spreadsheet and says nothing of Sheet objects (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_SheetEquality> ;
    sen0414:anchor "#s-SheetEquality" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SheetQuirks .
pg:Page ipo:coversChapterSection pg:SheetEquality .
pg:ContainsOperator a ipo:ChapterSection ; rdfs:label "Contains operator"@en ;
    skos:definition "The chapter does not use the in operator on a sheet; a reader would expect 'Alice' in sheet to look at values, as in does for a list (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ContainsOperator> ;
    sen0414:anchor "#s-ContainsOperator" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SheetQuirks .
pg:Page ipo:coversChapterSection pg:ContainsOperator .
pg:RequestsAndQuotas a ipo:ChapterSection ; rdfs:label "Requests and quotas"@en ;
    skos:definition "Because every call goes over the web, the chapter ends on quotas: it says Google limits a user to 250 new spreadsheets a day and a few hundred requests a minute, that the library catches the quota exception and retries, and that the flag ezsheets.IGNORE_QUOTA exists (Sweigart, 2025). Google's pages give per-minute limits for reads and for writes, ask for exponential backoff on a 429 and recommend a payload of at most 2 MB (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_RequestsAndQuotas> ;
    sen0414:anchor "#s-RequestsAndQuotas" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:RequestsAndQuotas .
pg:RequestCost a ipo:ChapterSection ; rdfs:label "Request cost"@en ;
    skos:definition "The chapter says of speed only that updating a spreadsheet takes a few seconds because it is a web request (Sweigart, 2025). Google counts every request, a batch as one, and recommends batching (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_RequestCost> ;
    sen0414:anchor "#s-RequestCost" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:RequestsAndQuotas .
pg:Page ipo:coversChapterSection pg:RequestCost .
pg:RequestPerWrite a ipo:ChapterSection ; rdfs:label "Request per write"@en ;
    skos:definition "The chapter says the program may wait a few seconds for a web request and that cell-by-cell writing is slow (Sweigart, 2025). Google bills a request, not a cell, and a batch is one request (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_RequestPerWrite> ;
    sen0414:anchor "#s-RequestPerWrite" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:RequestCost .
pg:Page ipo:coversChapterSection pg:RequestPerWrite .
pg:RequestsPerCall a ipo:ChapterSection ; rdfs:label "Requests per call"@en ;
    skos:definition "The chapter's Project 11, Step 2, raises rowCount by one and then writes three cells (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_RequestsPerCall> ;
    sen0414:anchor "#s-RequestsPerCall" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:RequestCost .
pg:Page ipo:coversChapterSection pg:RequestsPerCall .
pg:BatchedUpdate a ipo:ChapterSection ; rdfs:label "Batched update"@en ;
    skos:definition "Google's guide says to combine changes into fewer requests, and a batch counts as one request against the quota (Google Sheets API documentation, 2026). The chapter's updateRow, updateColumn and updateRows are the library's way to do that (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_BatchedUpdate> ;
    sen0414:anchor "#s-BatchedUpdate" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:RequestCost .
pg:Page ipo:coversChapterSection pg:BatchedUpdate .
pg:PayloadSize a ipo:ChapterSection ; rdfs:label "Payload size"@en ;
    skos:definition "Google's usage page recommends a maximum payload of 2 MB and lets a request run for at most 180 seconds before it times out (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_PayloadSize> ;
    sen0414:anchor "#s-PayloadSize" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:RequestCost .
pg:Page ipo:coversChapterSection pg:PayloadSize .
pg:QuotaRules a ipo:ChapterSection ; rdfs:label "Quota rules"@en ;
    skos:definition "The chapter says Google allows 250 new spreadsheets a day and a few hundred requests a minute, and that EZSheets catches the quota exception and retries for up to a minute or two before it raises again (Sweigart, 2025). Google's page gives 300 read and 300 write requests a minute per project and 60 a minute per user, and says exceeding them is planned to incur charges later in 2026 (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_QuotaRules> ;
    sen0414:anchor "#s-QuotaRules" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:RequestsAndQuotas .
pg:Page ipo:coversChapterSection pg:QuotaRules .
pg:GoogleQuotas a ipo:ChapterSection ; rdfs:label "Google quotas"@en ;
    skos:definition "The chapter says users are restricted to 250 new spreadsheets a day and that free accounts can make a few hundred requests a minute, and links Google's usage-limits page (Sweigart, 2025). That page gives 300 read and 300 write requests a minute per project and 60 of each a minute per user, answers excess with 429 and recommends truncated exponential backoff; it says exceeding the quotas is planned to incur charges later in 2026 (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_GoogleQuotas> ;
    sen0414:anchor "#s-GoogleQuotas" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:QuotaRules .
pg:Page ipo:coversChapterSection pg:GoogleQuotas .
pg:LibraryThrottle a ipo:ChapterSection ; rdfs:label "Library throttle"@en ;
    skos:definition "The chapter says EZSheets will take longer to return when requests are many (Sweigart, 2025). The library's constants are READ_QUOTA and WRITE_QUOTA, both 90, and its comment still says 50 requests per 100 seconds (EZSheets documentation, 2019)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_LibraryThrottle> ;
    sen0414:anchor "#s-LibraryThrottle" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:QuotaRules .
pg:Page ipo:coversChapterSection pg:LibraryThrottle .
pg:RetryOnQuota a ipo:ChapterSection ; rdfs:label "Retry on quota"@en ;
    skos:definition "The chapter says the library catches the Quota exceeded exception and retries, with calls that may take several seconds or even a minute or two, and re-raises if the request keeps failing (Sweigart, 2025). Google says to retry a 429 with truncated exponential backoff (Google Sheets API documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_RetryOnQuota> ;
    sen0414:anchor "#s-RetryOnQuota" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:QuotaRules .
pg:Page ipo:coversChapterSection pg:RetryOnQuota .
pg:IgnoreQuotaFlag a ipo:ChapterSection ; rdfs:label "Ignore quota flag"@en ;
    skos:definition "The chapter names ezsheets.IGNORE_QUOTA as the way to turn the quota handling off (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_IgnoreQuotaFlag> ;
    sen0414:anchor "#s-IgnoreQuotaFlag" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:QuotaRules .
pg:Page ipo:coversChapterSection pg:IgnoreQuotaFlag .
pg:CellLimit a ipo:ChapterSection ; rdfs:label "Cell limit"@en ;
    skos:definition "The chapter says Google Sheets spreadsheets can have up to 10 million cells and advises sizing sheets to what is needed (Sweigart, 2025). Google's Drive Help says a spreadsheet can have up to 20 million cells or 100 MB (Google Help, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_CellLimit> ;
    sen0414:anchor "#s-CellLimit" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:QuotaRules .
pg:Page ipo:coversChapterSection pg:CellLimit .
pg:LedgerProjects a ipo:ChapterSection ; rdfs:label "Ledger projects"@en ;
    skos:definition "The chapter's one project, Project 11, uses a public Google Sheet as a fake blockchain of a made-up currency, Boringcoin: Step 1 audits the ledger and Step 2 appends a transaction, and the online materials ship both programs (Sweigart, 2025). The practice programs add three more tasks on Google Forms responses, on format conversion and on checking the totals of a sheet of bean counts (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_LedgerProjects> ;
    sen0414:anchor "#s-LedgerProjects" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:LedgerProjects .
pg:BlockchainLedger a ipo:ChapterSection ; rdfs:label "Blockchain ledger"@en ;
    skos:definition "Project 11 reads the ledger of Boringcoin, a sheet of sender, recipient and amount in which the sender PRE-MINE invents money, sums the balances and adds a transaction by appending a row from three command line arguments (Sweigart, 2025). The sheet was made public by the author and is the subject of an audit that must end at the pre-mined billion (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_BlockchainLedger> ;
    sen0414:anchor "#s-BlockchainLedger" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:LedgerProjects .
pg:Page ipo:coversChapterSection pg:BlockchainLedger .
pg:AuditProgram a ipo:ChapterSection ; rdfs:label "Audit program"@en ;
    skos:definition "The chapter's Step 1 opens the Boringcoin sheet, loops over getRows, sums balances in a dictionary with the sender PRE-MINE creating money, and prints the dictionary and the total (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_AuditProgram> ;
    sen0414:anchor "#s-AuditProgram" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:BlockchainLedger .
pg:Page ipo:coversChapterSection pg:AuditProgram .
pg:TransactionProgram a ipo:ChapterSection ; rdfs:label "Transaction program"@en ;
    skos:definition "The chapter's Step 2 reads three command line arguments, opens the sheet, adds one to rowCount and writes the sender, recipient and amount into the three cells (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_TransactionProgram> ;
    sen0414:anchor "#s-TransactionProgram" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:BlockchainLedger .
pg:Page ipo:coversChapterSection pg:TransactionProgram .
pg:AppendRace a ipo:ChapterSection ; rdfs:label "Append race"@en ;
    skos:definition "The chapter's Step 2 appends a row by raising rowCount and writing to that row (Sweigart, 2025). Two programs doing this together read the same count, as in any read-modify-write on shared data."@en ; dcterms:source <http://example.org/sen0414/ch15#S_AppendRace> ;
    sen0414:anchor "#s-AppendRace" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:BlockchainLedger .
pg:Page ipo:coversChapterSection pg:AppendRace .
pg:BlankRowError a ipo:ChapterSection ; rdfs:label "Blank row error"@en ;
    skos:definition "The chapter's audit loops over getRows and converts the third column of each row to an integer (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_BlankRowError> ;
    sen0414:anchor "#s-BlankRowError" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:BlockchainLedger .
pg:Page ipo:coversChapterSection pg:BlankRowError .
pg:ArgvUnpacking a ipo:ChapterSection ; rdfs:label "Argv unpacking"@en ;
    skos:definition "The chapter runs python addBoringcoinTransaction.py 'Al Sweigart' Eve 2000, with the quotes, and unpacks sys.argv[1:] into three names (Sweigart, 2025). Python's shlex module splits a command line the way a shell does (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ArgvUnpacking> ;
    sen0414:anchor "#s-ArgvUnpacking" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:BlockchainLedger .
pg:Page ipo:coversChapterSection pg:ArgvUnpacking .
pg:PracticePrograms a ipo:ChapterSection ; rdfs:label "Practice programs"@en ;
    skos:definition "The three practice programs ask for the email addresses on a Google Forms response sheet, a converter between spreadsheet formats and a check of the totals on a public sheet of bean counts (Sweigart, 2025). Google Forms stores its answers in a spreadsheet when the owner picks a destination for the responses, a new one or an existing one (Google Help, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_PracticePrograms> ;
    sen0414:anchor "#s-PracticePrograms" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:LedgerProjects .
pg:Page ipo:coversChapterSection pg:PracticePrograms .
pg:FormsResponses a ipo:ChapterSection ; rdfs:label "Forms responses"@en ;
    skos:definition "The first practice program asks for the email addresses on a Google Forms response spreadsheet (Sweigart, 2025). Google says a form can store responses in a new or an existing spreadsheet (Google Help, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_FormsResponses> ;
    sen0414:anchor "#s-FormsResponses" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticePrograms .
pg:Page ipo:coversChapterSection pg:FormsResponses .
pg:FormatConverter a ipo:ChapterSection ; rdfs:label "Format converter"@en ;
    skos:definition "The second practice program uploads a file and downloads it in other formats (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_FormatConverter> ;
    sen0414:anchor "#s-FormatConverter" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticePrograms .
pg:Page ipo:coversChapterSection pg:FormatConverter .
pg:BeanCountCheck a ipo:ChapterSection ; rdfs:label "Bean count check"@en ;
    skos:definition "The third practice program asks for a check of a public sheet of bean totals, rows of beans per jar, jars and total beans (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_BeanCountCheck> ;
    sen0414:anchor "#s-BeanCountCheck" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticePrograms .
pg:Page ipo:coversChapterSection pg:BeanCountCheck .
pg:LibraryContext a ipo:ChapterSection ; rdfs:label "Library context"@en ;
    skos:definition "EZSheets is the work of one author, first uploaded to the Python Package Index on 2019-02-08, and its newest release is 2026.4.28 under GPLv3 or later (Python Package Index, 2026). The chapter presents it as the simpler way to use the Google Sheets API, which is built on Google's own Python client libraries (Sweigart, 2025)(Google API Client Library documentation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_LibraryContext> ;
    sen0414:anchor "#s-LibraryContext" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:LibraryContext .
pg:LibraryStatus a ipo:ChapterSection ; rdfs:label "Library status"@en ;
    skos:definition "The documentation the chapter points to is the page on Read the Docs, which says it is as of November 2019 (EZSheets documentation, 2019). The Python Package Index lists 18 releases between 2019-02-08 and 2026-04-28, licensed GPLv3 or later (Python Package Index, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_LibraryStatus> ;
    sen0414:anchor "#s-LibraryStatus" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:LibraryContext .
pg:Page ipo:coversChapterSection pg:LibraryStatus .
pg:ReleaseState a ipo:ChapterSection ; rdfs:label "Release state"@en ;
    skos:definition "The Python Package Index lists ezsheets 2026.4.28, uploaded 2026-04-28, under GPLv3 or later, with dependencies on google-api-python-client, google-auth-httplib2 and google-auth-oauthlib and no Python requirement (Python Package Index, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ReleaseState> ;
    sen0414:anchor "#s-ReleaseState" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LibraryStatus .
pg:Page ipo:coversChapterSection pg:ReleaseState .
pg:DocumentationGap a ipo:ChapterSection ; rdfs:label "Documentation gap"@en ;
    skos:definition "The documentation page of ezsheets is dated November 2019 and describes the library in a few paragraphs (EZSheets documentation, 2019)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_DocumentationGap> ;
    sen0414:anchor "#s-DocumentationGap" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LibraryStatus .
pg:Page ipo:coversChapterSection pg:DocumentationGap .
pg:GoogleClients a ipo:ChapterSection ; rdfs:label "Google clients"@en ;
    skos:definition "EZSheets does not speak to Google itself: it depends on google-api-python-client, which builds each request from Google's discovery document, google-auth-httplib2 and google-auth-oauthlib, which runs the consent (Google API Client Library documentation, 2026)(Python Package Index, 2026). The chapter calls the Google API confusing and EZSheets the simpler way (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_GoogleClients> ;
    sen0414:anchor "#s-GoogleClients" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:LibraryContext .
pg:Page ipo:coversChapterSection pg:GoogleClients .
pg:ClientLibraries a ipo:ChapterSection ; rdfs:label "Client libraries"@en ;
    skos:definition "The library depends on Google's client for Python, which is built from Google's discovery documents, and on the OAuth libraries for the sign-in (Google API Client Library documentation, 2026)(Python Package Index, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch15#S_ClientLibraries> ;
    sen0414:anchor "#s-ClientLibraries" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GoogleClients .
pg:Page ipo:coversChapterSection pg:ClientLibraries .
