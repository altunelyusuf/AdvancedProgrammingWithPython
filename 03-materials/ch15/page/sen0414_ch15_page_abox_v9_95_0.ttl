pg:CE_01 a ipo:CodeExample ; rdfs:label "Before the sign-in: version, state, scopes"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 7 of the deck and runs 6 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 1 ;
    sen0414:code "import ezsheets, google_standin\ngoogle_standin.uninstall()\nprint('ezsheets', ezsheets.__version__)\nprint('signed in:', ezsheets.IS_INITIALIZED)\nprint('sheets scope:', ezsheets.SCOPES_SHEETS[0])\nprint('drive scope:', ezsheets.SCOPES_DRIVE[0])" ; sen0414:expectedOutput "ezsheets 2026.4.28\nsigned in: False\nsheets scope: https://www.googleapis.com/auth/spreadsheets\ndrive scope: https://www.googleapis.com/auth/drive\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "What a token file holds"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 8 of the deck and runs 8 lines of Python that print 7 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 2 ;
    sen0414:code "import json, pickle\nfrom google.oauth2.credentials import Credentials\ncreds = Credentials(token='FAKE-access', refresh_token='FAKE-refresh',\n    token_uri='https://oauth2.googleapis.com/token',\n    scopes=['https://www.googleapis.com/auth/spreadsheets'])\nfor key, value in json.loads(creds.to_json()).items():\n    print(key, '=', value)\nprint(type(pickle.loads(pickle.dumps(creds))).__name__)" ; sen0414:expectedOutput "token = FAKE-access\nrefresh_token = FAKE-refresh\ntoken_uri = https://oauth2.googleapis.com/token\nscopes = ['https://www.googleapis.com/auth/spreadsheets']\nuniverse_domain = googleapis.com\naccount = \nCredentials\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "The sign-in address the library builds"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 10 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 3 ;
    sen0414:code "from google_auth_oauthlib.flow import Flow\nSCOPE = 'https://www.googleapis.com/auth/spreadsheets'\ncfg = {'installed': {'client_id': 'FAKE', 'client_secret': 'FAKE',\n    'auth_uri': 'https://accounts.google.com/o/oauth2/auth',\n    'token_uri': 'https://oauth2.googleapis.com/token'}}\nflow = Flow.from_client_config(cfg, [SCOPE],\n    redirect_uri='http://localhost:8080/')\nurl, state = flow.authorization_url(access_type='offline')\nq = dict(p.split('=') for p in url.split('?')[1].split('&'))\nfor k in ('response_type', 'access_type', 'code_challenge_method'):\n    print(k, '=', q[k])" ; sen0414:expectedOutput "response_type = code\naccess_type = offline\ncode_challenge_method = S256\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "The challenge: a hash of a secret"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 12 of the deck and runs 6 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 12 ; sen0414:orderInTab 4 ;
    sen0414:code "import hashlib, base64\nverifier = b'dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk'\ndigest = hashlib.sha256(verifier).digest()\nchallenge = base64.urlsafe_b64encode(digest).rstrip(b'=')\nprint('verifier :', verifier.decode())\nprint('challenge:', challenge.decode())" ; sen0414:expectedOutput "verifier : dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk\nchallenge: E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "Loading a pickle can run code"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 13 of the deck and runs 7 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 13 ; sen0414:orderInTab 5 ;
    sen0414:code "import pickle\nclass Trap:\n    def __reduce__(self):\n        return (print, ('this line ran while loading',))\ndata = pickle.dumps(Trap())\nprint('file written:', len(data), 'bytes')\npickle.loads(data)" ; sen0414:expectedOutput "file written: 67 bytes\nthis line ran while loading\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Valid, expired and renewable tokens"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 14 of the deck and runs 6 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 6 ;
    sen0414:code "import datetime as dt\nfrom google.oauth2.credentials import Credentials\nnow = dt.datetime.now(dt.timezone.utc).replace(tzinfo=None)\nfor name, h in (('fresh', 1), ('stale', -1), ('week old', -168)):\n    c = Credentials('X', 'X', expiry=now + dt.timedelta(hours=h))\n    print(name, '| valid:', c.valid, '| expired:', c.expired)" ; sen0414:expectedOutput "fresh | valid: True | expired: False\nstale | valid: False | expired: True\nweek old | valid: False | expired: True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "Create a spreadsheet and list spreadsheets"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 17 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 17 ; sen0414:orderInTab 7 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nss = ezsheets.Spreadsheet()\nother = ezsheets.createSpreadsheet('Boringcoin')\nprint(ss.title, '|', other.title)\nprint(ezsheets.listSpreadsheets())\nprint(len(g.log), 'requests so far')" ; sen0414:expectedOutput "Untitled spreadsheet | Boringcoin\n{'ID001': 'Untitled spreadsheet', 'ID002': 'Boringcoin'}\n14 requests so far\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Open one spreadsheet by id and by address"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 18 of the deck and runs 8 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 18 ; sen0414:orderInTab 8 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nss = ezsheets.Spreadsheet(g.load('SHEET123', 'Boringcoin', [['A']]))\nurl = 'https://docs.google.com/spreadsheets/d/SHEET123/edit#gid=0'\nprint(ezsheets.Spreadsheet('SHEET123').title)\nprint(ezsheets.Spreadsheet(url).title)\nprint(ezsheets.getIdFromUrl(url))\nprint(ezsheets.getIdFromUrl('https://docs.google.com/spreadsheets/d/SHEET123'))" ; sen0414:expectedOutput "Boringcoin\nBoringcoin\nSHEET123\nSHEET12\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Spreadsheet attributes you can and cannot set"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 19 of the deck and runs 8 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 9 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nss = ezsheets.Spreadsheet()\nss.title = 'Sweigart Books'\nprint(ss.title, ss.sheetTitles, ss.id, ss.url)\nfor name in ('id', 'url', 'sheetTitles'):\n    try: setattr(ss, name, 'x')\n    except AttributeError as e: print(name, '->', e)" ; sen0414:expectedOutput "Sweigart Books ('Sheet1',) ID001 https://docs.google.com/spreadsheets/d/ID001/\nid -> property 'id' of 'Spreadsheet' object has no setter\nurl -> property 'url' of 'Spreadsheet' object has no setter\nsheetTitles -> property 'sheetTitles' of 'Spreadsheet' object has no setter\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "Upload a file and download in six formats"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 22 of the deck and runs 8 lines of Python that print 7 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 10 ;
    sen0414:code "import ezsheets, google_standin, os, tempfile\ng = google_standin.install()\nos.chdir(tempfile.mkdtemp())\nopen('data.csv', 'w').write('a,b\\n1,2\\n')\nprint(ezsheets.upload('data.csv').title)\nss = ezsheets.Spreadsheet(g.load('X', 'Sweigart Books (DO NOT DELETE)', [['T']]))\nfor fmt in ('Excel', 'CSV', 'TSV', 'PDF', 'ODS', 'HTML'):\n    print(fmt, '->', getattr(ss, 'downloadAs' + fmt)())" ; sen0414:expectedOutput "data.csv\nExcel -> Sweigart_Books_(DO_NOT_DELETE).xlsx\nCSV -> Sweigart_Books_(DO_NOT_DELETE).csv\nTSV -> Sweigart_Books_(DO_NOT_DELETE).tsv\nPDF -> Sweigart_Books_(DO_NOT_DELETE).pdf\nODS -> Sweigart_Books_(DO_NOT_DELETE).ods\nHTML -> Sweigart_Books_(DO_NOT_DELETE).zip\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "Delete: to the Trash, or for good"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 23 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 11 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nss = ezsheets.Spreadsheet()\nkeep = ezsheets.createSpreadsheet('Keep me')\nss.delete()\nprint(g.log[-1][0], g.log[-1][3])\nprint(ezsheets.listSpreadsheets())\nss.delete(permanent=True)\nprint(g.log[-1][0], 'then', list(ezsheets.listSpreadsheets().values()))" ; sen0414:expectedOutput "PATCH {'trashed': True}\n{'ID001': 'Untitled spreadsheet', 'ID002': 'Keep me'}\nDELETE then ['Keep me']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "Read and write a cell"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 26 of the deck and runs 11 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 12 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nrows = [['PRODUCE', 'COST', 'POUNDS'], ['Okra', '2.26', '38.6']]\nsheet = ezsheets.Spreadsheet(g.load('P', 'produce', rows)).sheets[0]\ng.log.clear()\nprint(sheet['A1'], sheet[1, 1], sheet['B2'], sheet[2, 2])\nprint(len(g.log), 'requests to read four cells')\nsheet['B2'] = 30\nprint(repr(sheet['B2']), '|', g.log[-1][0], g.log[-1][2].split('&')[0])\nsheet.refresh()\nprint(repr(sheet['B2']))" ; sen0414:expectedOutput "PRODUCE PRODUCE 2.26 2.26\n0 requests to read four cells\n30 | PUT valueInputOption=USER_ENTERED\n'30'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Addresses and column letters"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 27 of the deck and runs 6 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 27 ; sen0414:orderInTab 13 ;
    sen0414:code "import ezsheets\nprint(ezsheets.convertAddress('A2'), ezsheets.convertAddress(1, 2))\nprint(ezsheets.convertAddress((2, 5)))\nL, N = ezsheets.getColumnLetterOf, ezsheets.getColumnNumberOf\nprint(L(2), L(27), L(999))\nprint(N('B'), N('ZZZ'))" ; sen0414:expectedOutput "(1, 2) A2\nB5\nB AA ALK\n2 18278\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "Rows and columns: getRow, getColumn, updateRow"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 29 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 14 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nrows = [['PRODUCE', 'COST', 'POUNDS'], ['Okra', '2.26', '38.6'],\n        ['Garlic', '1.19', '10']]\nsheet = ezsheets.Spreadsheet(g.load('P', 'produce', rows)).sheets[0]\nprint(sheet.getRow(2))\nprint(sheet.getColumn('A') == sheet.getColumn(1), sheet.getColumn(1)[:3])\nsheet.updateRow(3, ['Pumpkin', '11.50', '20'])\nsheet.updateColumn(1, [v.upper() for v in sheet.getColumn(1)])\nprint(sheet.getRows())" ; sen0414:expectedOutput "['Okra', '2.26', '38.6']\nTrue ['PRODUCE', 'Okra', 'Garlic']\n[['PRODUCE', 'COST', 'POUNDS'], ['OKRA', '2.26', '38.6'], ['PUMPKIN', '11.50', '20']]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "One request per cell, or one for the column"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 30 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 30 ; sen0414:orderInTab 15 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nvalues = [str(n) for n in range(1, 9)]\nsheet = ezsheets.Spreadsheet(g.load('S', 'Counts', [['']] * 8)).sheets[0]\ng.log.clear()\nfor row, value in enumerate(values, 1): sheet[1, row] = value\nprint('cell by cell:', len(g.log), 'requests')\ng.log.clear()\nsheet.updateColumn(1, values)\nprint('whole column:', len(g.log), 'request')" ; sen0414:expectedOutput "cell by cell: 8 requests\nwhole column: 1 request\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "Create, move and delete sheets"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 33 of the deck and runs 11 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 33 ; sen0414:orderInTab 16 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nss = ezsheets.Spreadsheet()\nprint(ss.Sheet('Spam'))\nss.createSheet('Eggs')\nss.createSheet('Bacon', 0)\nprint(ss.sheetTitles)\nss.sheets[0].index = 2\nprint(ss.sheetTitles)\nss.sheets[1].delete()\nprint(ss.sheetTitles)" ; sen0414:expectedOutput "None\n('Bacon', 'Sheet1', 'Spam', 'Eggs')\n('Sheet1', 'Spam', 'Bacon', 'Eggs')\n('Sheet1', 'Bacon', 'Eggs')\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "Copy a sheet and clear a sheet"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 34 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 34 ; sen0414:orderInTab 17 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nrows = [['PRODUCE', 'COST', 'POUNDS'], ['Okra', '2.26', '38.6']]\nsource = ezsheets.Spreadsheet(g.load('P', 'produce', rows)).sheets[0]\ntarget = ezsheets.Spreadsheet()\nsource.copyTo(target)\ntarget.refresh()\nprint(target.sheetTitles, target.sheets[1].getRows())\nsource.clear()\nprint(source.getRows(), source.rowCount, source.columnCount)" ; sen0414:expectedOutput "('Sheet1', 'Copy of Sheet1') [['PRODUCE', 'COST', 'POUNDS'], ['Okra', '2.26', '38.6']]\n[['', '', ''], ['', '', '']] 2 3\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "Surprises of the library"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 35 of the deck and runs 8 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 18 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\na = ezsheets.Spreadsheet().sheets[0]\nb = ezsheets.Spreadsheet().sheets[0]\nprint('equal:', a == b, '| ids', a.sheetId, b.sheetId)\nnames = ezsheets.Spreadsheet(g.load('Q', 'Q', [['Alice', '1']])).sheets[0]\nprint('Alice in sheet:', 'Alice' in names)\nprint('empty cell is', repr(names['C1']))" ; sen0414:expectedOutput "equal: True | ids 0 0\nAlice in sheet: False\nempty cell is ''\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "Collect e-mail addresses from form answers"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 38 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 38 ; sen0414:orderInTab 19 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nanswers = [['Timestamp', 'Name', 'Email address'],\n           ['10:00', 'Ada', 'ada@example.org'],\n           ['10:05', 'Alan', 'alan@example.org'],\n           ['10:09', 'Ada', 'ada@example.org']]\nsheet = ezsheets.Spreadsheet(g.load('F', 'Responses', answers)).sheets[0]\nemails = sheet.getColumn(3)[1:]\nprint(emails)\nprint(sorted(set(emails)))" ; sen0414:expectedOutput "['ada@example.org', 'alan@example.org', 'ada@example.org']\n['ada@example.org', 'alan@example.org']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "Quota errors: the library waits and retries"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 40 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 40 ; sen0414:orderInTab 20 ;
    sen0414:code "import ezsheets, google_standin, time, types\ng = google_standin.install()\npauses = []\nezsheets.time = types.SimpleNamespace(sleep=pauses.append, time=time.time)\ng.fail = [(429, 'RESOURCE_EXHAUSTED')] * 20\ntry:\n    ezsheets.Spreadsheet()\nexcept Exception as e:\n    print(len(g.log), 'tries,', sum(pauses), 'seconds,', type(e).__name__)\nezsheets.time = time" ; sen0414:expectedOutput "9 tries, 220 seconds, HttpError\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "Project 11, step 1: audit the ledger"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 43 of the deck and runs 12 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 43 ; sen0414:orderInTab 21 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nledger = [['PRE-MINE', 'Alice', '1000'], ['PRE-MINE', 'Bob', '500'],\n          ['Alice', 'Bob', '200'], ['Bob', 'Carol', '150']]\nsheet = ezsheets.Spreadsheet(g.load('B', 'Boringcoin', ledger)).sheets[0]\naccounts = {}\nfor sender, recipient, amount in sheet.getRows():\n    if sender != 'PRE-MINE':\n        accounts[sender] = accounts.get(sender, 0) - int(amount)\n    accounts[recipient] = accounts.get(recipient, 0) + int(amount)\nprint(accounts)\nprint('Total Boringcoins:', sum(accounts.values()))" ; sen0414:expectedOutput "{'Alice': 800, 'Bob': 550, 'Carol': 150}\nTotal Boringcoins: 1500\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
pg:CE_22 a ipo:CodeExample ; rdfs:label "The audit stops at an empty row"@en ;
    skos:definition "Example 22 of the chapter-code tab comes from slide 44 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 44 ; sen0414:orderInTab 22 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nledger = [['PRE-MINE', 'Alice', '1000'], ['Alice', 'Bob', '200']]\nsheet = ezsheets.Spreadsheet(g.load('B', 'Boringcoin', ledger)).sheets[0]\nsheet.rowCount += 1\nprint('audit of', len(sheet.getRows()), 'rows')\ntry: total = sum(int(row[2]) for row in sheet.getRows())\nexcept ValueError as e: print('stopped:', e)" ; sen0414:expectedOutput "audit of 3 rows\nstopped: invalid literal for int() with base 10: ''\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_22 .
pg:CE_23 a ipo:CodeExample ; rdfs:label "Project 11, step 2: add a transaction"@en ;
    skos:definition "Example 23 of the chapter-code tab comes from slide 45 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 45 ; sen0414:orderInTab 23 ;
    sen0414:code "import ezsheets, google_standin, sys\ng = google_standin.install()\nsys.argv = ['add.py', 'Al Sweigart', 'Eve', '2000']\nsender, recipient, amount = sys.argv[1:]\nledger = [['PRE-MINE', 'Alice', '1000'], ['Alice', 'Bob', '200']]\nsheet = ezsheets.Spreadsheet(g.load('B', 'Boringcoin', ledger)).sheets[0]\ng.log.clear()\nsheet.rowCount += 1\nfor col, value in enumerate((sender, recipient, amount), 1):\n    sheet[col, sheet.rowCount] = value\nprint(sheet.getRow(sheet.rowCount), '|', len(g.log), 'requests')" ; sen0414:expectedOutput "['Al Sweigart', 'Eve', '2000'] | 6 requests\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_23 .
pg:CE_24 a ipo:CodeExample ; rdfs:label "Two programs add a row at the same time"@en ;
    skos:definition "Example 24 of the chapter-code tab comes from slide 46 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 46 ; sen0414:orderInTab 24 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nledger = [['PRE-MINE', 'Alice', '1000'], ['Alice', 'Bob', '200']]\nfirst = ezsheets.Spreadsheet(g.load('B', 'Boringcoin', ledger)).sheets[0]\nsecond = ezsheets.Spreadsheet('B').sheets[0]\nfor who, sheet in (('first', first), ('second', second)):\n    sheet.rowCount += 1; sheet[1, sheet.rowCount] = who\n    print(who, 'writes to row', sheet.rowCount)\nfirst.refresh()\nprint(first.rowCount, first.getRow(3))" ; sen0414:expectedOutput "first writes to row 3\nsecond writes to row 3\n3 ['second', '', '']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_24 .
pg:CE_25 a ipo:CodeExample ; rdfs:label "Finding mistakes: check the totals"@en ;
    skos:definition "Example 25 of the chapter-code tab comes from slide 48 of the deck and runs 8 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch15/page/chapter_code_ch15_v1_0_0.json" ;
    sen0414:slideNumber 48 ; sen0414:orderInTab 25 ;
    sen0414:code "import ezsheets, google_standin\ng = google_standin.install()\nbeans = [['Qty', 'Price', 'Total'], ['4', '25', '100'],\n         ['3', '40', '130'], ['10', '12', '120']]\nrows = ezsheets.Spreadsheet(g.load('BEAN', 'Beans', beans)).sheets[0].getRows()\nfor n, (qty, price, total) in enumerate(rows[1:], 2):\n    if int(qty) * int(price) != int(total):\n        print('row', n, 'says', total, 'is', int(qty) * int(price))" ; sen0414:expectedOutput "row 3 says 130 is 120\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_25 .
