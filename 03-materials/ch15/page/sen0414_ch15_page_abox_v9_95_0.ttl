    skos:definition "The sidebar is the chapter explorer, a tree of the 95 sections of the chapter whose choice opens the matching tab."@en ; dcterms:source "03-materials/ch15/page/sen0414_ch15_page_v9_96_1.html" .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en ;
