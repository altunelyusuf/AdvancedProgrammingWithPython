chx:X_QuoteStyles a owl:NamedIndividual, chx:QuoteStyles ; rdfs:label "'Bob\\'s'"@en ; skos:definition "A string literal may begin and end with single or double quotes; the quote that opens it also closes it, so a literal in double quotes can hold a single quote, and inside a single-quoted literal the escape \\' does the same."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_QuoteStyles a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('ast').literal_eval('\\x22Alice\\'s cat\\x22') == 'Alice\\'s cat', len('Bob\\'s'), '\\x22' == chr(34)) evaluates to (True, 5, True)"@en ; chx:input "(__import__('ast').literal_eval('\\x22Alice\\'s cat\\x22') == 'Alice\\'s cat', len('Bob\\'s'), '\\x22' == chr(34))" ; chx:output "(True, 5, True)" .
chx:X_QuoteStyles rd:hasIOExample chx:IO_QuoteStyles .
chx:X_EscapeSequences a owl:NamedIndividual, chx:EscapeSequences ; rdfs:label "'Hello there!\\nHow are you?'"@en ; skos:definition "An escape sequence is a backslash followed by a character that stands for one character that is hard to type, such as \\n for a newline, \\t for a tab, \\' for a single quote and \\\\ for a backslash; it counts as one character of the string."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_EscapeSequences a owl:NamedIndividual, rd:IOExample ; rdfs:label "('a\\tb', 'a\\\\b', 'line1\\nline2'.split('\\n'), len('\\\\'), len('\\n')) evaluates to ('a\\tb', 'a\\\\b', ['line1', 'line2'], 1, 1)"@en ; chx:input "('a\\tb', 'a\\\\b', 'line1\\nline2'.split('\\n'), len('\\\\'), len('\\n'))" ; chx:output "('a\\tb', 'a\\\\b', ['line1', 'line2'], 1, 1)" .
chx:X_EscapeSequences rd:hasIOExample chx:IO_EscapeSequences .
chx:X_StringPrefixes a owl:NamedIndividual, chx:StringPrefixes ; rdfs:label "rb'\\n'"@en ; skos:definition "A letter before the opening quote changes how the literal is read: r for raw, f for formatted, b for bytes, u with no effect, and since Python 3.14 t for template strings; r can be combined with f, t and b."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_StringPrefixes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(type(b'a').__name__, type(r'a').__name__, type(u'a').__name__, b'A'[0], len(rb'\\n')) evaluates to ('bytes', 'str', 'str', 65, 2)"@en ; chx:input "(type(b'a').__name__, type(r'a').__name__, type(u'a').__name__, b'A'[0], len(rb'\\n'))" ; chx:output "('bytes', 'str', 'str', 65, 2)" .
chx:X_StringPrefixes rd:hasIOExample chx:IO_StringPrefixes .
chx:X_UnrecognizedEscapes a owl:NamedIndividual, chx:UnrecognizedEscapes ; rdfs:label "'\\q'"@en ; skos:definition "A backslash followed by a character that forms no escape sequence stays in the string as a backslash, and since Python 3.12 the compiler draws a SyntaxWarning; writing the backslash twice or using a raw string avoids it."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_UnrecognizedEscapes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda cw: (cw.__enter__(), __import__('warnings').simplefilter('ignore'), list(__import__('ast').literal_eval('\\'\\\\q\\'')), cw.__exit__(None, None, None))[2])(__import__('warnings').catch_warnings()) evaluates to ['\\\\', 'q']"@en ; chx:input "(lambda cw: (cw.__enter__(), __import__('warnings').simplefilter('ignore'), list(__import__('ast').literal_eval('\\'\\\\q\\'')), cw.__exit__(None, None, None))[2])(__import__('warnings').catch_warnings())" ; chx:output "['\\\\', 'q']" .
chx:X_UnrecognizedEscapes rd:hasIOExample chx:IO_UnrecognizedEscapes .
chx:X_RawStrings a owl:NamedIndividual, chx:RawStrings ; rdfs:label "r'C:\\Users\\Alice\\Desktop'"@en ; skos:definition "A raw string literal, written with an r before the opening quote, treats every backslash as an ordinary character and ignores escape sequences, which suits Windows file paths and regular expressions."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_RawStrings a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len(r'\\n'), len('\\n'), r'C:\\Users\\Al' == 'C:\\\\Users\\\\Al') evaluates to (2, 1, True)"@en ; chx:input "(len(r'\\n'), len('\\n'), r'C:\\Users\\Al' == 'C:\\\\Users\\\\Al')" ; chx:output "(2, 1, True)" .
chx:X_RawStrings rd:hasIOExample chx:IO_RawStrings .
chx:X_MultilineStrings a owl:NamedIndividual, chx:MultilineStrings ; rdfs:label "'''Dear Alice,\\n\\nBob'''"@en ; skos:definition "A multiline string begins and ends with three single or three double quotes and keeps every quote, tab and newline between them as part of the string; the indentation rules of blocks do not apply inside it."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_MultilineStrings a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('ast').literal_eval('\\'\\'\\'Dear Al,\\n\\nBob\\'\\'\\'').split('\\n') evaluates to ['Dear Al,', '', 'Bob']"@en ; chx:input "__import__('ast').literal_eval('\\'\\'\\'Dear Al,\\n\\nBob\\'\\'\\'').split('\\n')" ; chx:output "['Dear Al,', '', 'Bob']" .
chx:X_MultilineStrings rd:hasIOExample chx:IO_MultilineStrings .
chx:X_MultilineComments a owl:NamedIndividual, chx:MultilineComments ; rdfs:label "def say_hello():\\n    '''This function prints hello.'''"@en ; skos:definition "A multiline string used as a comment is an ordinary string expression that is evaluated and dropped, except that the string which opens a function body is kept as the function's documentation string."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_MultilineComments a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ns: (exec('def f():\\n    \\'\\'\\'Says hi.\\'\\'\\'\\n', ns), ns['f'].__doc__)[1])({}) evaluates to 'Says hi.'"@en ; chx:input "(lambda ns: (exec('def f():\\n    \\'\\'\\'Says hi.\\'\\'\\'\\n', ns), ns['f'].__doc__)[1])({})" ; chx:output "'Says hi.'" .
chx:X_MultilineComments rd:hasIOExample chx:IO_MultilineComments .
chx:X_StringIndexing a owl:NamedIndividual, chx:StringIndexing ; rdfs:label "greeting[-1]"@en ; skos:definition "An index in square brackets picks one character, counting from 0 at the front and from -1 at the back; a character is a string of length one, and an index past the end raises IndexError."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_StringIndexing a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Hello, world!'[0], 'Hello, world!'[4], 'Hello, world!'[-1], len('Hello, world!')) evaluates to ('H', 'o', '!', 13)"@en ; chx:input "('Hello, world!'[0], 'Hello, world!'[4], 'Hello, world!'[-1], len('Hello, world!'))" ; chx:output "('H', 'o', '!', 13)" .
chx:X_StringIndexing rd:hasIOExample chx:IO_StringIndexing .
chx:X_StringSlicing a owl:NamedIndividual, chx:StringSlicing ; rdfs:label "greeting[7:-1]"@en ; skos:definition "A slice string[start:end] is a new string of the characters from start up to but not including end; omitted ends mean the front or the back, an end past the string is cut short, a step is allowed, and the original string is left as it was."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_StringSlicing a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Hello, world!'[0:5], 'Hello, world!'[:5], 'Hello, world!'[7:-1], 'Hello, world!'[7:], 'Hello, world!'[::-1]) evaluates to ('Hello', 'Hello', 'world', 'world!', '!dlrow ,olleH')"@en ; chx:input "('Hello, world!'[0:5], 'Hello, world!'[:5], 'Hello, world!'[7:-1], 'Hello, world!'[7:], 'Hello, world!'[::-1])" ; chx:output "('Hello', 'Hello', 'world', 'world!', '!dlrow ,olleH')" .
chx:X_StringSlicing rd:hasIOExample chx:IO_StringSlicing .
chx:X_StringImmutability a owl:NamedIndividual, chx:StringImmutability ; rdfs:label "name[7] = 'the'"@en ; skos:definition "A string cannot be changed after it is made: assigning to an index raises TypeError, and methods such as upper() return a new string, so a changed text is built from slices or assigned back to the name."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_StringImmutability a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.upper(), s))('abc') evaluates to ('ABC', 'abc')"@en ; chx:input "(lambda s: (s.upper(), s))('abc')" ; chx:output "('ABC', 'abc')" .
chx:X_StringImmutability rd:hasIOExample chx:IO_StringImmutability .
chx:X_InOperator a owl:NamedIndividual, chx:InOperator ; rdfs:label "'Hello' in 'Hello, World'"@en ; skos:definition "The in and not in operators test whether the first string occurs as a run of characters inside the second, with capitalisation counted, and give True or False; the empty string is in every string."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_InOperator a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Hello' in 'Hello, World', 'HELLO' in 'Hello, World', '' in 'spam', 'cats' not in 'cats and dogs') evaluates to (True, False, True, False)"@en ; chx:input "('Hello' in 'Hello, World', 'HELLO' in 'Hello, World', '' in 'spam', 'cats' not in 'cats and dogs')" ; chx:output "(True, False, True, False)" .
chx:X_InOperator rd:hasIOExample chx:IO_InOperator .
chx:X_FStrings a owl:NamedIndividual, chx:FStrings ; rdfs:label "f'My name is {name}. I am {age} years old.'"@en ; skos:definition "An f-string is a literal with an f before the opening quote in which each expression between curly brackets is evaluated and its value put into the text; doubled brackets stand for one literal bracket."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_FStrings a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda name, age: f'My name is {name}. I am {age} years old. In ten years I will be {age + 10}. {{name}}')('Al', 4000) evaluates to 'My name is Al. I am 4000 years old. In ten years I will be 4010. {name}'"@en ; chx:input "(lambda name, age: f'My name is {name}. I am {age} years old. In ten years I will be {age + 10}. {{name}}')('Al', 4000)" ; chx:output "'My name is Al. I am 4000 years old. In ten years I will be 4010. {name}'" .
chx:X_FStrings rd:hasIOExample chx:IO_FStrings .
chx:X_FormatSpecifiers a owl:NamedIndividual, chx:FormatSpecifiers ; rdfs:label "f'{3.14159:.2f}'"@en ; skos:definition "After a colon in a replacement field comes a format specifier passed to format(), which sets fill, alignment with <, > or ^, width, sign, thousands separator and precision, so it does the work of rjust(), ljust() and center() and more."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_FormatSpecifiers a owl:NamedIndividual, rd:IOExample ; rdfs:label "f'{3.14159:.2f}|{42:>6}|{42:^6}|{42:06}|{1234567:,}|{255:#x}|{0.256:.1%}' evaluates to '3.14|    42|  42  |000042|1,234,567|0xff|25.6%'"@en ; chx:input "f'{3.14159:.2f}|{42:>6}|{42:^6}|{42:06}|{1234567:,}|{255:#x}|{0.256:.1%}'" ; chx:output "'3.14|    42|  42  |000042|1,234,567|0xff|25.6%'" .
chx:X_FormatSpecifiers rd:hasIOExample chx:IO_FormatSpecifiers .
chx:X_DebugAndConversions a owl:NamedIndividual, chx:DebugAndConversions ; rdfs:label "f'{name=}'"@en ; skos:definition "An equals sign after the expression prints the expression text, the sign and the value, and the conversions !s, !r and !a apply str(), repr() or ascii() before formatting; since Python 3.12 a field may also reuse the f-string's own quote and hold a backslash."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_DebugAndConversions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s, n: (f'{s=}', f'{n + 1 = }', f'{s!r} {s!s}', f'{chr(233)!a}'))('Al', 41) evaluates to ('s='Al'', 'n + 1 = 42', ''Al' Al', ''\\\\xe9'')"@en ; chx:input "(lambda s, n: (f'{s=}', f'{n + 1 = }', f'{s!r} {s!s}', f'{chr(233)!a}'))('Al', 41)" ; chx:output "('s='Al'', 'n + 1 = 42', ''Al' Al', ''\\\\xe9'')" .
chx:X_DebugAndConversions rd:hasIOExample chx:IO_DebugAndConversions .
chx:X_TemplateStrings a owl:NamedIndividual, chx:TemplateStrings ; rdfs:label "t'Hello {name}'"@en ; skos:definition "A template string, written with a t prefix since Python 3.14, has the syntax of an f-string but evaluates to a Template object that keeps the literal parts and the interpolations separate, so code can process them, for instance to escape HTML, before making a string."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:X_Concatenation a owl:NamedIndividual, chx:Concatenation ; rdfs:label "'Hello, my name is ' + name + '. I am ' + str(age) + ' years old.'"@en ; skos:definition "Strings are joined with + and repeated with *, and a number must first be turned into a string with str(); two literals written next to each other are joined at compile time."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_Concatenation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda name, age: ('Hello, my name is ' + name + '. I am ' + str(age) + ' years old.', 'Py' 'thon', 3 * 'un' + 'ium'))('Al', 4000) evaluates to ('Hello, my name is Al. I am 4000 years old.', 'Python', 'unununium')"@en ; chx:input "(lambda name, age: ('Hello, my name is ' + name + '. I am ' + str(age) + ' years old.', 'Py' 'thon', 3 * 'un' + 'ium'))('Al', 4000)" ; chx:output "('Hello, my name is Al. I am 4000 years old.', 'Python', 'unununium')" .
chx:X_Concatenation rd:hasIOExample chx:IO_Concatenation .
chx:X_PercentFormatting a owl:NamedIndividual, chx:PercentFormatting ; rdfs:label "'My name is %s. I am %s years old.' % (name, age)"@en ; skos:definition "The % operator on a string replaces conversion specifiers such as %s, %d and %f with the values of a tuple or a mapping; it still works, but a single tuple operand is read as the list of arguments and the documentation names f-strings and format() as alternatives."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_PercentFormatting a owl:NamedIndividual, rd:IOExample ; rdfs:label "('My name is %s. I am %s years old.' % ('Al', 4000), '%05.1f|%-4s|%3d%%' % (3.14159, 'ab', 7)) evaluates to ('My name is Al. I am 4000 years old.', '003.1|ab  |  7%')"@en ; chx:input "('My name is %s. I am %s years old.' % ('Al', 4000), '%05.1f|%-4s|%3d%%' % (3.14159, 'ab', 7))" ; chx:output "('My name is Al. I am 4000 years old.', '003.1|ab  |  7%')" .
chx:X_PercentFormatting rd:hasIOExample chx:IO_PercentFormatting .
chx:X_FormatMethod a owl:NamedIndividual, chx:FormatMethod ; rdfs:label "'{1} years ago, {0} was born and named {0}.'.format(name, age)"@en ; skos:definition "The format() method replaces curly-bracket fields with its arguments, by position, by index or by name, and accepts the same format specifiers as an f-string."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_FormatMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "('{1} years ago, {0} was born and named {0}.'.format('Al', 4000), '{name} is {age}'.format(name='Al', age=4000)) evaluates to ('4000 years ago, Al was born and named Al.', 'Al is 4000')"@en ; chx:input "('{1} years ago, {0} was born and named {0}.'.format('Al', 4000), '{name} is {age}'.format(name='Al', age=4000))" ; chx:output "('4000 years ago, Al was born and named Al.', 'Al is 4000')" .
chx:X_FormatMethod rd:hasIOExample chx:IO_FormatMethod .
chx:X_ChangingCase a owl:NamedIndividual, chx:ChangingCase ; rdfs:label "spam = spam.upper()"@en ; skos:definition "The upper() and lower() methods return a new string with every letter converted and leave other characters alone; the original is unchanged, so the result is assigned back or compared at once, as in a case-insensitive check."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_ChangingCase a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Hello, world!'.upper(), 'Hello, world!'.lower(), 'great' == 'GREat'.lower()) evaluates to ('HELLO, WORLD!', 'hello, world!', True)"@en ; chx:input "('Hello, world!'.upper(), 'Hello, world!'.lower(), 'great' == 'GREat'.lower())" ; chx:output "('HELLO, WORLD!', 'hello, world!', True)" .
chx:X_ChangingCase rd:hasIOExample chx:IO_ChangingCase .
chx:X_CaseTests a owl:NamedIndividual, chx:CaseTests ; rdfs:label "'HELLO'.isupper()"@en ; skos:definition "isupper() and islower() return True when the string has at least one cased letter and all its cased letters are upper or lower case, and False for an empty string or one with no letters."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_CaseTests a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Hello, world!'.isupper(), 'HELLO'.isupper(), 'abc12345'.islower(), '12345'.islower(), ''.islower()) evaluates to (False, True, True, False, False)"@en ; chx:input "('Hello, world!'.isupper(), 'HELLO'.isupper(), 'abc12345'.islower(), '12345'.islower(), ''.islower())" ; chx:output "(False, True, True, False, False)" .
chx:X_CaseTests rd:hasIOExample chx:IO_CaseTests .
chx:X_CaseFolding a owl:NamedIndividual, chx:CaseFolding ; rdfs:label "'stra\\xdfe'.casefold() == 'strasse'"@en ; skos:definition "casefold() is a stronger lower() meant for caseless matching: it turns the German sharp s into ss, so text that differs only by case compares equal, where lower() leaves that letter alone and upper() makes the string longer."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_CaseFolding a owl:NamedIndividual, rd:IOExample ; rdfs:label "('stra\\xdfe'.lower() == 'strasse', 'stra\\xdfe'.casefold() == 'strasse', len('stra\\xdfe'.upper())) evaluates to (False, True, 7)"@en ; chx:input "('stra\\xdfe'.lower() == 'strasse', 'stra\\xdfe'.casefold() == 'strasse', len('stra\\xdfe'.upper()))" ; chx:output "(False, True, 7)" .
chx:X_CaseFolding rd:hasIOExample chx:IO_CaseFolding .
chx:X_MethodChaining a owl:NamedIndividual, chx:MethodChaining ; rdfs:label "'Hello'.upper().lower().upper()"@en ; skos:definition "A method that returns a string can be followed by another method call on the result, forming a chain; a method that returns a Boolean or a number ends the chain."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_MethodChaining a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Hello'.upper().lower().upper(), 'HELLO'.lower().islower(), 'a-b'.upper().replace('-', '+')) evaluates to ('HELLO', True, 'A+B')"@en ; chx:input "('Hello'.upper().lower().upper(), 'HELLO'.lower().islower(), 'a-b'.upper().replace('-', '+'))" ; chx:output "('HELLO', True, 'A+B')" .
chx:X_MethodChaining rd:hasIOExample chx:IO_MethodChaining .
chx:X_CharacterTests a owl:NamedIndividual, chx:CharacterTests ; rdfs:label "'hello123'.isalnum()"@en ; skos:definition "The methods isalpha(), isalnum(), isdecimal(), isspace() and istitle() return True only for a non-empty string whose characters all fit the kind named, so they validate input and are False for an empty string."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_CharacterTests a owl:NamedIndividual, rd:IOExample ; rdfs:label "('hello'.isalpha(), 'hello123'.isalpha(), 'hello123'.isalnum(), '123'.isdecimal(), '    '.isspace(), 'This Is Title Case'.istitle(), ''.isalpha()) evaluates to (True, False, True, True, True, True, False)"@en ; chx:input "('hello'.isalpha(), 'hello123'.isalpha(), 'hello123'.isalnum(), '123'.isdecimal(), '    '.isspace(), 'This Is Title Case'.istitle(), ''.isalpha())" ; chx:output "(True, False, True, True, True, True, False)" .
chx:X_CharacterTests rd:hasIOExample chx:IO_CharacterTests .
chx:X_UnicodeDigits a owl:NamedIndividual, chx:UnicodeDigits ; rdfs:label "'\\u0663'.isdecimal()"@en ; skos:definition "The isX() methods use the Unicode database, not ASCII: isdecimal() is True for any decimal digit of any script, isdigit() also for a superscript digit, isspace() for U+3000, and isalpha() and isalnum() for accented letters; isascii() tests for ASCII only."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_UnicodeDigits a owl:NamedIndividual, rd:IOExample ; rdfs:label "('\\xb2'.isdecimal(), '\\xb2'.isdigit(), '\\u0663'.isdecimal(), int('\\u0663'), '\\u3000'.isspace(), '\\xe9'.isalpha() and not '\\xe9'.isascii()) evaluates to (False, True, True, 3, True, True)"@en ; chx:input "('\\xb2'.isdecimal(), '\\xb2'.isdigit(), '\\u0663'.isdecimal(), int('\\u0663'), '\\u3000'.isspace(), '\\xe9'.isalpha() and not '\\xe9'.isascii())" ; chx:output "(False, True, True, 3, True, True)" .
chx:X_UnicodeDigits rd:hasIOExample chx:IO_UnicodeDigits .
chx:X_StartsEndsWith a owl:NamedIndividual, chx:StartsEndsWith ; rdfs:label "'Hello, world!'.startswith('Hello') and 'abc'.endswith('c')"@en ; skos:definition "startswith() and endswith() test only the beginning or the end of a string and also accept a tuple of alternatives, which is shorter than slicing and comparing."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_StartsEndsWith a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Hello, world!'.startswith('Hello'), 'abc123'.endswith('12'), 'notes.txt'.endswith(('.py', '.txt'))) evaluates to (True, False, True)"@en ; chx:input "('Hello, world!'.startswith('Hello'), 'abc123'.endswith('12'), 'notes.txt'.endswith(('.py', '.txt')))" ; chx:output "(True, False, True)" .
chx:X_StartsEndsWith rd:hasIOExample chx:IO_StartsEndsWith .
chx:X_JoinMethod a owl:NamedIndividual, chx:JoinMethod ; rdfs:label "'-'.join(c for c in 'abc')"@en ; skos:definition "join() is called on the separator string and given an iterable of strings; it returns them concatenated with the separator between, and raises TypeError for an item that is not a string."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_JoinMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(', '.join(['cats', 'rats', 'bats']), 'ABC'.join(['My', 'name']), '-'.join('abc')) evaluates to ('cats, rats, bats', 'MyABCname', 'a-b-c')"@en ; chx:input "(', '.join(['cats', 'rats', 'bats']), 'ABC'.join(['My', 'name']), '-'.join('abc'))" ; chx:output "('cats, rats, bats', 'MyABCname', 'a-b-c')" .
chx:X_JoinMethod rd:hasIOExample chx:IO_JoinMethod .
chx:X_SplitMethod a owl:NamedIndividual, chx:SplitMethod ; rdfs:label "'My name is Simon'.split('m')"@en ; skos:definition "split(sep) cuts a string at each occurrence of the separator and returns a list; consecutive separators give empty strings, and splitting the empty string gives a list holding one empty string."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_SplitMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "('MyABCnameABCisABCSimon'.split('ABC'), 'My name is Simon'.split('m'), '1,,2'.split(','), ''.split(',')) evaluates to (['My', 'name', 'is', 'Simon'], ['My na', 'e is Si', 'on'], ['1', '', '2'], [''])"@en ; chx:input "('MyABCnameABCisABCSimon'.split('ABC'), 'My name is Simon'.split('m'), '1,,2'.split(','), ''.split(','))" ; chx:output "(['My', 'name', 'is', 'Simon'], ['My na', 'e is Si', 'on'], ['1', '', '2'], [''])" .
chx:X_SplitMethod rd:hasIOExample chx:IO_SplitMethod .
chx:X_WhitespaceSplit a owl:NamedIndividual, chx:WhitespaceSplit ; rdfs:label "'My name is Simon'.split()"@en ; skos:definition "split() with no argument cuts at runs of whitespace, ignores whitespace at the ends and gives an empty list for an empty or blank string, unlike split(' ')."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_WhitespaceSplit a owl:NamedIndividual, rd:IOExample ; rdfs:label "('My name is Simon'.split(), '  a \\t b\\n c  '.split(), ''.split(), '  a  b '.split(' ')) evaluates to (['My', 'name', 'is', 'Simon'], ['a', 'b', 'c'], [], ['', '', 'a', '', 'b', ''])"@en ; chx:input "('My name is Simon'.split(), '  a \\t b\\n c  '.split(), ''.split(), '  a  b '.split(' '))" ; chx:output "(['My', 'name', 'is', 'Simon'], ['a', 'b', 'c'], [], ['', '', 'a', '', 'b', ''])" .
chx:X_WhitespaceSplit rd:hasIOExample chx:IO_WhitespaceSplit .
chx:X_SplitLines a owl:NamedIndividual, chx:SplitLines ; rdfs:label "text.splitlines()"@en ; skos:definition "splitlines() cuts a string at every line boundary, including the carriage-return line feed of Windows text, and drops the final empty item that split('\\n') leaves after a trailing newline."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_SplitLines a owl:NamedIndividual, rd:IOExample ; rdfs:label "('one\\r\\ntwo\\nthree'.split('\\n'), 'one\\r\\ntwo\\nthree'.splitlines(), 'a\\n\\nb\\n'.split('\\n'), 'a\\n\\nb\\n'.splitlines()) evaluates to (['one\\r', 'two', 'three'], ['one', 'two', 'three'], ['a', '', 'b', ''], ['a', '', 'b'])"@en ; chx:input "('one\\r\\ntwo\\nthree'.split('\\n'), 'one\\r\\ntwo\\nthree'.splitlines(), 'a\\n\\nb\\n'.split('\\n'), 'a\\n\\nb\\n'.splitlines())" ; chx:output "(['one\\r', 'two', 'three'], ['one', 'two', 'three'], ['a', '', 'b', ''], ['a', '', 'b'])" .
chx:X_SplitLines rd:hasIOExample chx:IO_SplitLines .
chx:X_PartitionMethod a owl:NamedIndividual, chx:PartitionMethod ; rdfs:label "'Monty Python'.partition(' ')"@en ; skos:definition "partition(sep) cuts at the first occurrence and returns a tuple of the part before, the separator and the part after, or the string and two empty strings when the separator is absent; rpartition() cuts at the last."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_PartitionMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Monty Python'.partition(' '), 'Monty Python'.partition('-'), 'a.b.c'.rpartition('.')) evaluates to (('Monty', ' ', 'Python'), ('Monty Python', '', ''), ('a.b', '.', 'c'))"@en ; chx:input "('Monty Python'.partition(' '), 'Monty Python'.partition('-'), 'a.b.c'.rpartition('.'))" ; chx:output "(('Monty', ' ', 'Python'), ('Monty Python', '', ''), ('a.b', '.', 'c'))" .
chx:X_PartitionMethod rd:hasIOExample chx:IO_PartitionMethod .
chx:X_JustifyMethods a owl:NamedIndividual, chx:JustifyMethods ; rdfs:label "'Hello'.rjust(20, '*')"@en ; skos:definition "rjust(), ljust() and center() return a string padded to a given width with spaces or one fill character; a width no larger than the string changes nothing, and the padding is 15 spaces for 'Hello'.rjust(20)."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_JustifyMethods a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Hello'.rjust(10), 'Hello'.ljust(10, '-'), 'Hello'.center(20, '='), 'Hello'.rjust(20) == ' ' * 15 + 'Hello', 'Hello'.center(4)) evaluates to ('     Hello', 'Hello-----', '=======Hello========', True, 'Hello')"@en ; chx:input "('Hello'.rjust(10), 'Hello'.ljust(10, '-'), 'Hello'.center(20, '='), 'Hello'.rjust(20) == ' ' * 15 + 'Hello', 'Hello'.center(4))" ; chx:output "('     Hello', 'Hello-----', '=======Hello========', True, 'Hello')" .
chx:X_JustifyMethods rd:hasIOExample chx:IO_JustifyMethods .
chx:X_StripMethods a owl:NamedIndividual, chx:StripMethods ; rdfs:label "'SpamSpamBaconSpamEggsSpamSpam'.strip('ampS')"@en ; skos:definition "strip(), lstrip() and rstrip() remove whitespace from both ends, the left or the right, or, with an argument, any of the characters in that argument in any order, which is a set and not a prefix."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_StripMethods a owl:NamedIndividual, rd:IOExample ; rdfs:label "('    Hello, World    '.strip(), '    Hello, World    '.lstrip(), 'SpamSpamBaconSpamEggsSpamSpam'.strip('ampS'), 'SpamSpamBaconSpamEggsSpamSpam'.strip('Spam') == 'SpamSpamBaconSpamEggsSpamSpam'.strip('mapS')) evaluates to ('Hello, World', 'Hello, World    ', 'BaconSpamEggs', True)"@en ; chx:input "('    Hello, World    '.strip(), '    Hello, World    '.lstrip(), 'SpamSpamBaconSpamEggsSpamSpam'.strip('ampS'), 'SpamSpamBaconSpamEggsSpamSpam'.strip('Spam') == 'SpamSpamBaconSpamEggsSpamSpam'.strip('mapS'))" ; chx:output "('Hello, World', 'Hello, World    ', 'BaconSpamEggs', True)" .
chx:X_StripMethods rd:hasIOExample chx:IO_StripMethods .
chx:X_PrefixSuffixRemoval a owl:NamedIndividual, chx:PrefixSuffixRemoval ; rdfs:label "'Arthur: three!'.removeprefix('Arthur: ')"@en ; skos:definition "removeprefix() and removesuffix(), added in Python 3.9, remove one exact prefix or suffix if present and otherwise return the string unchanged, which is what a programmer who reaches for lstrip() with a word usually wants."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_PrefixSuffixRemoval a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Arthur: three!'.lstrip('Arthur: '), 'Arthur: three!'.removeprefix('Arthur: '), 'report.txt'.removesuffix('.txt'), 'report.txt'.removesuffix('.py')) evaluates to ('ee!', 'three!', 'report', 'report.txt')"@en ; chx:input "('Arthur: three!'.lstrip('Arthur: '), 'Arthur: three!'.removeprefix('Arthur: '), 'report.txt'.removesuffix('.txt'), 'report.txt'.removesuffix('.py'))" ; chx:output "('ee!', 'three!', 'report', 'report.txt')" .
chx:X_PrefixSuffixRemoval rd:hasIOExample chx:IO_PrefixSuffixRemoval .
chx:X_FindAndCount a owl:NamedIndividual, chx:FindAndCount ; rdfs:label "'spam eggs spam'.find('spam', 1) != -1"@en ; skos:definition "find() returns the index of the first occurrence at or after an optional start, or -1 when there is none, where index() raises ValueError; count() returns the number of non-overlapping occurrences."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_FindAndCount a owl:NamedIndividual, rd:IOExample ; rdfs:label "('spam eggs spam'.find('spam'), 'spam eggs spam'.find('spam', 1), 'spam'.find('x'), 'spam eggs spam'.count('spam'), 'aaaa'.count('aa')) evaluates to (0, 10, -1, 2, 2)"@en ; chx:input "('spam eggs spam'.find('spam'), 'spam eggs spam'.find('spam', 1), 'spam'.find('x'), 'spam eggs spam'.count('spam'), 'aaaa'.count('aa'))" ; chx:output "(0, 10, -1, 2, 2)" .
chx:X_FindAndCount rd:hasIOExample chx:IO_FindAndCount .
chx:X_ReplaceMethod a owl:NamedIndividual, chx:ReplaceMethod ; rdfs:label "'spam, spam'.replace('spam', 'eggs', 1)"@en ; skos:definition "replace(old, new) returns a new string with every occurrence of old replaced by new, or only the first count of them when count is given; an empty new deletes old."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_ReplaceMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "('spam, spam, spam'.replace('spam', 'eggs'), 'spam, spam, spam'.replace('spam', 'eggs', 1), 'abc'.replace('b', '')) evaluates to ('eggs, eggs, eggs', 'eggs, spam, spam', 'ac')"@en ; chx:input "('spam, spam, spam'.replace('spam', 'eggs'), 'spam, spam, spam'.replace('spam', 'eggs', 1), 'abc'.replace('b', ''))" ; chx:output "('eggs, eggs, eggs', 'eggs, spam, spam', 'ac')" .
chx:X_ReplaceMethod rd:hasIOExample chx:IO_ReplaceMethod .
chx:X_OrdAndChr a owl:NamedIndividual, chx:OrdAndChr ; rdfs:label "ord('A')"@en ; skos:definition "Every character has a Unicode code point, an integer from 0 to 0x10FFFF; ord() gives the code point of a one-character string and chr() gives the character of a code point, so ord('A') is 65 and chr(ord('A') + 1) is 'B'."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_OrdAndChr a owl:NamedIndividual, rd:IOExample ; rdfs:label "(ord('A'), ord('4'), ord('!'), chr(65), chr(ord('A') + 1), ord('A') < ord('B'), ord('\\u20ac'), chr(8364) == '\\u20ac', ord('\\U0001f40d')) evaluates to (65, 52, 33, 'A', 'B', True, 8364, True, 128013)"@en ; chx:input "(ord('A'), ord('4'), ord('!'), chr(65), chr(ord('A') + 1), ord('A') < ord('B'), ord('\\u20ac'), chr(8364) == '\\u20ac', ord('\\U0001f40d'))" ; chx:output "(65, 52, 33, 'A', 'B', True, 8364, True, 128013)" .
chx:X_OrdAndChr rd:hasIOExample chx:IO_OrdAndChr .
chx:X_Utf8Encoding a owl:NamedIndividual, chx:Utf8Encoding ; rdfs:label "len('caf\\xe9'.encode('utf-8')) == 5"@en ; skos:definition "Encoding turns text into bytes and decoding turns bytes back into text; in UTF-8 a character takes one to four bytes, so a string of four characters can be five bytes long, and encode() and decode() must use the same encoding."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_Utf8Encoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "('caf\\xe9'.encode('utf-8'), len('caf\\xe9'), len('caf\\xe9'.encode('utf-8')), 'caf\\xe9'.encode('utf-8').decode('utf-8') == 'caf\\xe9') evaluates to (b'caf\\xc3\\xa9', 4, 5, True)"@en ; chx:input "('caf\\xe9'.encode('utf-8'), len('caf\\xe9'), len('caf\\xe9'.encode('utf-8')), 'caf\\xe9'.encode('utf-8').decode('utf-8') == 'caf\\xe9')" ; chx:output "(b'caf\\xc3\\xa9', 4, 5, True)" .
chx:X_Utf8Encoding rd:hasIOExample chx:IO_Utf8Encoding .
chx:X_EncodeDecodeErrors a owl:NamedIndividual, chx:EncodeDecodeErrors ; rdfs:label "'caf\\xe9'.encode('ascii', errors='replace')"@en ; skos:definition "A character the encoding cannot represent raises UnicodeEncodeError and bytes that do not form valid text raise UnicodeDecodeError, unless the errors argument names another handler such as replace, backslashreplace or ignore; decoding with the wrong encoding can succeed and give wrong text."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_EncodeDecodeErrors a owl:NamedIndividual, rd:IOExample ; rdfs:label "(ascii(b'caf\\xc3\\xa9'.decode('latin-1')), 'caf\\xe9'.encode('ascii', errors='replace')) evaluates to (''caf\\\\xc3\\\\xa9'', b'caf?')"@en ; chx:input "(ascii(b'caf\\xc3\\xa9'.decode('latin-1')), 'caf\\xe9'.encode('ascii', errors='replace'))" ; chx:output "(''caf\\\\xc3\\\\xa9'', b'caf?')" .
chx:X_EncodeDecodeErrors rd:hasIOExample chx:IO_EncodeDecodeErrors .
chx:X_FileEncoding a owl:NamedIndividual, chx:FileEncoding ; rdfs:label "open('note.txt', 'w', encoding='utf-8')"@en ; skos:definition "A text file is turned into bytes by an encoding; open() called without one uses the locale encoding in Python 3.14, which is why a program should name encoding='utf-8' when it writes or reads text it means to share."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_FileEncoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda io, b: (lambda w: (w.write('caf\\xe9'), w.flush(), b.getvalue())[2])(io.TextIOWrapper(b, encoding='utf-8')))(__import__('io'), __import__('io').BytesIO()) evaluates to b'caf\\xc3\\xa9'"@en ; chx:input "(lambda io, b: (lambda w: (w.write('caf\\xe9'), w.flush(), b.getvalue())[2])(io.TextIOWrapper(b, encoding='utf-8')))(__import__('io'), __import__('io').BytesIO())" ; chx:output "b'caf\\xc3\\xa9'" .
chx:X_FileEncoding rd:hasIOExample chx:IO_FileEncoding .
chx:X_ClipboardModule a owl:NamedIndividual, chx:ClipboardModule ; rdfs:label "pyperclip.paste()"@en ; skos:definition "The third-party pyperclip module copies text to and from the computer's clipboard with copy() and paste(); it is not part of Python, so a program that imports it fails with ModuleNotFoundError where it is not installed."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:X_BulletPointAdder a owl:NamedIndividual, chx:BulletPointAdder ; rdfs:label "lines[i] = '* ' + lines[i]"@en ; skos:definition "The bullet program takes text from the clipboard, splits it into lines, puts a star and a space before each and joins the lines back, so the four lines of the chapter's list come back as four bulleted lines."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_BulletPointAdder a owl:NamedIndividual, rd:IOExample ; rdfs:label "'\\n'.join('* ' + line for line in 'Lists of animals\\nLists of cultivars'.split('\\n')) evaluates to '* Lists of animals\\n* Lists of cultivars'"@en ; chx:input "'\\n'.join('* ' + line for line in 'Lists of animals\\nLists of cultivars'.split('\\n'))" ; chx:output "'* Lists of animals\\n* Lists of cultivars'" .
chx:X_BulletPointAdder rd:hasIOExample chx:IO_BulletPointAdder .
chx:X_AlternatingText a owl:NamedIndividual, chx:AlternatingText ; rdfs:label "make_uppercase = not make_uppercase"@en ; skos:definition "The alternating-text program walks over the characters of a string and switches between lower and upper case on every character, spaces and punctuation included, so the pattern of a word depends on its position in the text."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_AlternatingText a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda text: ''.join(c.upper() if i % 2 else c.lower() for i, c in enumerate(text)))('Hello, world!') evaluates to 'hElLo, WoRlD!'"@en ; chx:input "(lambda text: ''.join(c.upper() if i % 2 else c.lower() for i, c in enumerate(text)))('Hello, world!')" ; chx:output "'hElLo, WoRlD!'" .
chx:X_AlternatingText rd:hasIOExample chx:IO_AlternatingText .
chx:X_InputValidation a owl:NamedIndividual, chx:InputValidation ; rdfs:label "if age.isdecimal(): break"@en ; skos:definition "The validation program repeats a question with a while loop until isdecimal() accepts the age and isalnum() accepts the password, and rejects 'forty two' and 'secr3t!'."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_InputValidation a owl:NamedIndividual, rd:IOExample ; rdfs:label "('42'.isdecimal(), 'forty two'.isdecimal(), 'secr3t'.isalnum(), 'secr3t!'.isalnum()) evaluates to (True, False, True, False)"@en ; chx:input "('42'.isdecimal(), 'forty two'.isdecimal(), 'secr3t'.isalnum(), 'secr3t!'.isalnum())" ; chx:output "(True, False, True, False)" .
chx:X_InputValidation rd:hasIOExample chx:IO_InputValidation .
chx:X_PigLatin a owl:NamedIndividual, chx:PigLatin ; rdfs:label "prefix_consonants += word[0]"@en ; skos:definition "The Pig Latin program splits a message into words, sets aside punctuation at both ends, moves leading consonants to the end followed by ay, adds yay to words that start with a vowel or y, and restores upper or title case."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_PigLatin a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(lambda w: (lambda i: w[i:] + (w[:i] + 'ay' if i else 'yay'))(next((k for k, c in enumerate(w) if c in 'aeiouy'), len(w))))(w) for w in ('sweigart', 'old', 'chair', 'years')] evaluates to ['eigartsway', 'oldyay', 'airchay', 'yearsyay']"@en ; chx:input "[(lambda w: (lambda i: w[i:] + (w[:i] + 'ay' if i else 'yay'))(next((k for k, c in enumerate(w) if c in 'aeiouy'), len(w))))(w) for w in ('sweigart', 'old', 'chair', 'years')]" ; chx:output "['eigartsway', 'oldyay', 'airchay', 'yearsyay']" .
chx:X_PigLatin rd:hasIOExample chx:IO_PigLatin .
chx:X_TablePrinter a owl:NamedIndividual, chx:TablePrinter ; rdfs:label "printTable(tableData)"@en ; skos:definition "The practice program prints a list of lists of strings as a table with right-justified columns, each as wide as its longest string, found first with a loop over the lists."@en ; dcterms:source <http://example.org/sen0414/ch08/research> .
chx:IO_TablePrinter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t: [''.join(' ' + col[r].rjust(max(map(len, col))) for col in t) for r in range(len(t[0]))])([['apples', 'oranges', 'cherries', 'banana'], ['Alice', 'Bob', 'Carol', 'David'], ['dogs', 'cats', 'moose', 'goose']]) evaluates to ['   apples Alice  dogs', '  oranges   Bob  cats', ' cherries Carol moose', '   banana David goose']"@en ; chx:input "(lambda t: [''.join(' ' + col[r].rjust(max(map(len, col))) for col in t) for r in range(len(t[0]))])([['apples', 'oranges', 'cherries', 'banana'], ['Alice', 'Bob', 'Carol', 'David'], ['dogs', 'cats', 'moose', 'goose']])" ; chx:output "['   apples Alice  dogs', '  oranges   Bob  cats', ' cherries Carol moose', '   banana David goose']" .
chx:X_TablePrinter rd:hasIOExample chx:IO_TablePrinter .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 8 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch08/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 8 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which operations on a string make a new string, which only test it and return a Boolean or a number, and why can none of them change it?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs and concepts of the chapter differ in current Python, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 8 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 8 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch08/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-01."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

