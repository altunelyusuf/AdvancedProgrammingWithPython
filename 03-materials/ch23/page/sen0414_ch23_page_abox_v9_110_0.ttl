pg:CE_01 a ipo:CodeExample ; rdfs:label "The packages and the display"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 7 of the deck and runs 6 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 1 ;
    sen0414:code "import importlib.metadata as md, platform\nprint(platform.python_version())\nprint([md.version(p) for p in ('pyautogui', 'pyscreeze', 'pillow', 'pymsgbox')])\nimport pyautogui\nprint(pyautogui.size())\nprint(pyautogui.position())" ; sen0414:expectedOutput "3.14.6\n['0.9.54', '1.0.1', '13.0.0', '2.0.1']\nSize(width=1920, height=1080)\nPoint(x=960, y=540)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "Without a display, and under Wayland"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 8 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 2 ;
    sen0414:code "code = 'import pyautogui; print(pyautogui.size())'\nenv = dict(d.env); env.pop('DISPLAY')\nprint(child(code, env=env)[2])\nenv = dict(d.env, XDG_SESSION_TYPE='wayland')\nshot = 'import pyautogui; pyautogui.screenshot()'\nprint(child(shot, env=env)[2].split(':')[0])\nprint(child(code, env=d.env)[1])" ; sen0414:expectedOutput "KeyError: 'DISPLAY'\npyscreeze.PyScreezeException\n['Size(width=1920, height=1080)']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "How a click reaches a window"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 9 of the deck and runs 9 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 3 ;
    sen0414:code "import pyautogui\nst = watch.state()\npyautogui.click(st['rootx'] + 50, st['rooty'] + 10)\nprint('click      :', btns(watch))\nwatch.clear(); pyautogui.press('w')\nprint('press w    :', keys(watch))\nwatch.clear(); sendkey(d, 'observer', 'q')\nprint('SendEvent q:', keys(watch))\nprint('both reached the entry:', repr(watch.entry()))" ; sen0414:expectedOutput "click      : [('Press', 1, False), ('Release', 1, False)]\npress w    : [('Press', 'w', False), ('Release', 'w', False)]\nSendEvent q: [('Press', 'q', True), ('Release', 'q', True)]\nboth reached the entry: 'wq'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Pauses"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 13 of the deck and runs 11 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 13 ; sen0414:orderInTab 4 ;
    sen0414:code "import time, pyautogui\nprint('PAUSE', pyautogui.PAUSE, '| FAILSAFE', pyautogui.FAILSAFE)\npyautogui.PAUSE = 0.3\ndef waits(f, *a):\n    t = time.perf_counter(); f(*a)\n    return time.perf_counter() - t > 0.25\ncalls = [(pyautogui.moveTo, (50, 60)), (pyautogui.click, ()),\n         (pyautogui.press, ('shift',)), (pyautogui.position, ()),\n         (pyautogui.onScreen, (5, 5))]\nfor f, a in calls:\n    print('%-9s waits after the call:' % f.__name__, waits(f, *a))" ; sen0414:expectedOutput "PAUSE 0.1 | FAILSAFE True\nmoveTo    waits after the call: True\nclick     waits after the call: True\npress     waits after the call: True\nposition  waits after the call: False\nonScreen  waits after the call: False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "The fail-safe corners"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 14 of the deck and runs 13 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 5 ;
    sen0414:code "import pyautogui; pyautogui.PAUSE = 0\nprint('FAILSAFE_POINTS', sorted(pyautogui.FAILSAFE_POINTS))\ndef fires(x, y):\n    pyautogui.FAILSAFE = False; pyautogui.moveTo(x, y)\n    pyautogui.FAILSAFE = True\n    try: pyautogui.moveTo(500, 500)\n    except pyautogui.FailSafeException: return True\n    return False\nfor xy in ((0, 0), (1919, 1079), (1, 1)):\n    print(xy, 'raises:', fires(*xy))\nd.sh('xrandr', '--fb', '1280x720'); time.sleep(0.3)\nprint('this process:', tuple(pyautogui.size()))\nprint('a new process:', child(CODE, env=d.env)[1][0])" ; sen0414:expectedOutput "FAILSAFE_POINTS [(0, 0), (0, 1079), (1919, 0), (1919, 1079)]\n(0, 0) raises: True\n(1919, 1079) raises: True\n(1, 1) raises: False\nthis process: (1920, 1080)\na new process: (1280, 720)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Moving the mouse"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 19 of the deck and runs 9 lines of Python that print 7 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 6 ;
    sen0414:code "import pyautogui\nfor dur in (0, 0.1, 0.25, 0.5, 1.0):\n    pyautogui.moveTo(500, 500); time.sleep(0.3); watch.clear()\n    pyautogui.moveTo(900, 700, duration=dur)\n    n = sum(e['type'] == 'Motion' for e in watch.events())\n    print('moveTo(900, 700, duration=%s): %2d motion events' % (dur, n))\nfor x, y in ((-50, -50), (5000, 5000)):\n    pyautogui.FAILSAFE = False; pyautogui.moveTo(x, y)\n    print('moveTo(%s, %s) ->' % (x, y), tuple(pyautogui.position()))" ; sen0414:expectedOutput "moveTo(900, 700, duration=0):  1 motion events\nmoveTo(900, 700, duration=0.1):  1 motion events\nmoveTo(900, 700, duration=0.25):  6 motion events\nmoveTo(900, 700, duration=0.5): 11 motion events\nmoveTo(900, 700, duration=1.0): 21 motion events\nmoveTo(-50, -50) -> (0, 0)\nmoveTo(5000, 5000) -> (1919, 1079)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "Clicking"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 20 of the deck and runs 7 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 20 ; sen0414:orderInTab 7 ;
    sen0414:code "import pyautogui\npyautogui.click(); show('click()')\npyautogui.click(button='middle'); show('click(button='middle')')\npyautogui.rightClick(); show('rightClick()')\npyautogui.doubleClick(); show('doubleClick()')\npyautogui.tripleClick(); show('tripleClick()')\npyautogui.click(clicks=2, interval=0.6); show('click(clicks=2, interval=0.6)')" ; sen0414:expectedOutput "click()                        [('Press', 1)]\nclick(button='middle')         [('Press', 2)]\nrightClick()                   [('Press', 3)]\ndoubleClick()                  [('Press', 1), ('DoubleClick', 1)]\ntripleClick()                  [('Press', 1), ('DoubleClick', 1), ('TripleClick', 1)]\nclick(clicks=2, interval=0.6)  [('Press', 1), ('Press', 1)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Dragging: the spiral"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 21 of the deck and runs 15 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 21 ; sen0414:orderInTab 8 ;
    sen0414:code "import pyautogui\nn = 0\ndistance, change = 300, 20\nwhile distance > 0:\n    pyautogui.drag(distance, 0, duration=0.05); distance -= change\n    pyautogui.drag(0, distance, duration=0.05)\n    pyautogui.drag(-distance, 0, duration=0.05); distance -= change\n    pyautogui.drag(0, -distance, duration=0.05); n += 4\nim = pyautogui.screenshot().crop((0, 0, 700, 500)).convert('L')\nink = im.point([255] * 128 + [0] * 128)\nprint('spiral:', n, 'drag calls, ink inside the box', ink.getbbox())\nev = [e['type'] for e in watch.events()]\nprint('presses', ev.count('ButtonPress'))\nprint('releases', ev.count('ButtonRelease'))\nim.convert('RGB').save('spiral.png'); done('spiral.png')" ; sen0414:expectedOutput "spiral: 32 drag calls, ink inside the box (200, 159, 501, 441)\npresses 30\nreleases 30\nsaved spiral.png: 2520 bytes, sha256 89420df3b4d7\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Scrolling"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 22 of the deck and runs 12 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 9 ;
    sen0414:code "import pyautogui\ndef lines_moved(py, name):\n    watch = text_window(py); st = watch.state(); row = {}\n    pyautogui.moveTo(st['rootx'] + 100, st['rooty'] + 150)\n    for n in (-1, -2, -3, -10):\n        pyautogui.scroll(60); time.sleep(0.4); before = top(watch)\n        pyautogui.scroll(n); watch.settle(); time.sleep(0.4)\n        row[n] = top(watch) - before\n    print('lines moved, %s %s:' % (name, st['tk']), row)\n    watch.close()\nlines_moved(LATEST, 'Tk 9')\nlines_moved(TK86, 'Tk 8.6')" ; sen0414:expectedOutput "lines moved, Tk 9 9.0.3: {-1: 1, -2: 3, -3: 5, -10: 19}\nlines moved, Tk 8.6 8.6.14: {-1: 2, -2: 5, -3: 8, -10: 29}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "Screenshots and pixels"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 27 of the deck and runs 13 lines of Python that print 8 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 27 ; sen0414:orderInTab 10 ;
    sen0414:code "import pyautogui\nim = pyautogui.screenshot(); inside = (210, 160)\nprint(type(im).__name__, im.size, im.mode)\nprint('pixel(210, 160) ->', pyautogui.pixel(*inside))\nprint('pixel (5, 5) ->', im.getpixel((5, 5)))\ncases = (((176, 176, 175), 0), ((177, 176, 175), 0),\n         ((177, 176, 175), 1))\nfor c, t in cases:\n    ok = pyautogui.pixelMatchesColor(*inside, c, tolerance=t)\n    print(c, t, ok)\ntry: pyautogui.pixel(inside)\nexcept TypeError as e: print('pixel((210, 160)):', e)\nim.resize((480, 270)).save('screen.png'); done('screen.png')" ; sen0414:expectedOutput "PngImageFile (1920, 1080) RGB\npixel(210, 160) -> RGB(red=176, green=176, blue=175)\npixel (5, 5) -> (0, 0, 0)\n(176, 176, 175) 0 True\n(177, 176, 175) 0 False\n(177, 176, 175) 1 True\npixel((210, 160)): pixel() missing 1 required positional argument: 'y'\nsaved screen.png: 1224 bytes, sha256 26b4a0b10893\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "Finding a button"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 28 of the deck and runs 12 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 28 ; sen0414:orderInTab 11 ;
    sen0414:code "import pyautogui\nshot = pyautogui.screenshot()\nbx, by, bw, bh = watch.state()['buttons'][0]\nshot.crop((bx, by, bx + bw, by + bh)).save('submit.png')\nbox = pyautogui.locateOnScreen('submit.png')\nboxes = list(pyautogui.locateAllOnScreen('submit.png'))\nprint('found', ints(box))\nprint('locateAll', [ints(b) for b in boxes])\nprint('center', ints(pyautogui.center(box)))\nwatch.clear(); pyautogui.click(boxes[1]); time.sleep(0.4)\nprint('click(boxes[1]) pressed button', cmds(watch))\nmark(shot, box, 'located.png')" ; sen0414:expectedOutput "found (300, 250, 84, 35)\nlocateAll [(300, 250, 84, 35), (300, 330, 84, 35)]\ncenter (342, 267)\nclick(boxes[1]) pressed button [1]\nsaved located.png: 1639 bytes, sha256 2cc7919e14a6\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "Exact matches and missing images"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 29 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 12 ;
    sen0414:code "import pyautogui\nbx, by, bw, bh = watch.state()['buttons'][0]\nbtn = pyautogui.screenshot().crop((bx, by, bx + bw, by + bh))\nbtn.save('exact.png'); btn.putpixel((5, 5), (0, 0, 0))\nbtn.save('off.png')\ncalls = [''exact.png'', ''off.png'', ''off.png', confidence=0.9',\n         ''off.png', grayscale=True']\nfor name, py in ENVS:\n    r = [child(PROBE % c, py=py, env=d.env)[1][0] for c in calls]\n    print('%-17s' % name, [short(x) for x in r])" ; sen0414:expectedOutput "OpenCV            ['Box', 'ImageNotFound', 'Box', 'ImageNotFound']\nno OpenCV         ['Box', 'ImageNotFound', 'NotImplemented', 'ImageNotFound']\nPyScreeze 0.1.28  ['Box', 'NoneType', 'Box', 'NoneType']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Typing into the right window"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 34 of the deck and runs 12 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 34 ; sen0414:orderInTab 13 ;
    sen0414:code "import pyautogui\npyautogui.write('Hello, world!'); print(repr(watch.text()))\npyautogui.write(['a', 'b', 'left', 'left', 'X', 'Y'])\nprint('write([a, b, left, left, X, Y]) ->', repr(watch.text()))\npyautogui.keyDown('shift'); pyautogui.press('4')\npyautogui.keyUp('shift')\nprint('shift down, 4, shift up ->', repr(watch.text()[-3:]))\npyautogui.hotkey('ctrl', 'a'); pyautogui.press('delete')\nprint('hotkey(ctrl, a), delete ->', repr(watch.text()))\npyautogui.write('Hello, world!')\npyautogui.click(1000, 800); time.sleep(0.6)\nshotof(watch, 'typed.png', 120)" ; sen0414:expectedOutput "'Hello, world!'\nwrite([a, b, left, left, X, Y]) -> 'Hello, world!XYab'\nshift down, 4, shift up -> '$ab'\nhotkey(ctrl, a), delete -> ''\nsaved typed.png: 838 bytes, sha256 917697bb1df4\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "Key names: mistakes are silent"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 35 of the deck and runs 9 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 14 ;
    sen0414:code "import pyautogui\nprint('KEYBOARD_KEYS:', len(pyautogui.KEYBOARD_KEYS), 'names')\nfor call in ('press', 'keyDown'):\n    try: getattr(pyautogui, call)('nokey'); r = 'raised nothing'\n    except Exception as e: r = type(e).__name__\n    print('%-8s nokey' % call, r, '| typed', repr(watch.text()))\npyautogui.write(['a', 'nokey', 'b']); pyautogui.write('café')\nprint('a, nokey, b, then café typed', repr(watch.text()))\nprint('A in the list:', 'A' in pyautogui.KEYBOARD_KEYS)" ; sen0414:expectedOutput "KEYBOARD_KEYS: 194 names\npress    nokey raised nothing | typed ''\nkeyDown  nokey raised nothing | typed ''\na, nokey, b, then café typed 'abcaf'\nA in the list: False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "Hotkeys and the clipboard"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 37 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch23/page/chapter_code_ch23_v1_1_0.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 15 ;
    sen0414:code "import pyautogui, pyperclip\npyautogui.write('Hello, world!\\nsecond line')\nwatch.clear()\npyautogui.hotkey('ctrl', 'alt', 'shift', 's')\nks = [k.split('_')[0] for t, k, s in keys(watch)]\nprint('down, then up:', *ks)\npyautogui.hotkey('ctrl', 'a'); pyautogui.hotkey('ctrl', 'c')\ntime.sleep(1); text = pyperclip.paste()\nprint('paste():', repr(text))\npyautogui.press('end'); pyautogui.hotkey('ctrl', 'v')\nprint('ctrl+v pasted it again:', watch.text() == text * 2)" ; sen0414:expectedOutput "down, then up: Control Alt Shift S S Shift Alt Control\npaste(): 'Hello, world!\\nsecond line'\nctrl+v pasted it again: True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
