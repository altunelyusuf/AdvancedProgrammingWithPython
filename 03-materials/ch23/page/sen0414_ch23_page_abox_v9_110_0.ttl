    ipo:demonstratesSubject <http://example.org/sen0414/ch23#SushiGoRound> ;
    wp:instantiatesPrimitive wp:Primitive_OverviewDetailBrushing ; ds:selectionWarrant "Feature_AsymmetricContrast: the exemplar of the concept is shown beside its definition, so that the reader sees what the code looks like and what it does" ;
    wp:demonstratesConcept <http://example.org/sen0414/ch23#SushiGoRound> ;
    wp:hasDesignTest "Exercised in headless Chromium by 08-tooling/sen0414_page_test_v9_42_0.py: static example shown; no step button" ; wp:designTestPassed true .
