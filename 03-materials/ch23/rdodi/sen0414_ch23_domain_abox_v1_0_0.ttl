chx:X_CoordinateOrigin a owl:NamedIndividual, chx:CoordinateOrigin ; rdfs:label "x, y = 0, 0"@en ; skos:definition "The origin (0, 0) is the upper-left pixel of the screen, x grows to the right and y grows downward, so on a screen 1920 pixels wide and 1080 high the lower-right pixel is (1919, 1079)."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_CoordinateOrigin a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda w, h: ((0, 0), (w - 1, h - 1)))(1920, 1080) evaluates to ((0, 0), (1919, 1079))"@en ; chx:input "(lambda w, h: ((0, 0), (w - 1, h - 1)))(1920, 1080)" ; chx:output "((0, 0), (1919, 1079))" .
chx:X_CoordinateOrigin rd:hasIOExample chx:IO_CoordinateOrigin .
chx:X_ScreenSize a owl:NamedIndividual, chx:ScreenSize ; rdfs:label "pyautogui.size()"@en ; skos:definition "size() returns a named tuple Size with the width and the height of the screen in pixels, readable by index or by attribute and unpackable into two names."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_ScreenSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda S: (S(1920, 1080)[0], S(1920, 1080).height, tuple(S(1920, 1080))))(__import__('collections').namedtuple('Size', 'width height')) evaluates to (1920, 1080, (1920, 1080))"@en ; chx:input "(lambda S: (S(1920, 1080)[0], S(1920, 1080).height, tuple(S(1920, 1080))))(__import__('collections').namedtuple('Size', 'width height'))" ; chx:output "(1920, 1080, (1920, 1080))" .
chx:X_ScreenSize rd:hasIOExample chx:IO_ScreenSize .
chx:X_PointAndBox a owl:NamedIndividual, chx:PointAndBox ; rdfs:label "box = pyautogui.locateOnScreen('submit.png')"@en ; skos:definition "position() gives a named tuple Point of x and y, and the locate functions give a named tuple Box of left, top, width and height; the middle of a Box is its left plus half its width and its top plus half its height."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_PointAndBox a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda B: (B(643, 745, 70, 29).left, (643 + 70 // 2, 745 + 29 // 2)))(__import__('collections').namedtuple('Box', 'left top width height')) evaluates to (643, (678, 759))"@en ; chx:input "(lambda B: (B(643, 745, 70, 29).left, (643 + 70 // 2, 745 + 29 // 2)))(__import__('collections').namedtuple('Box', 'left top width height'))" ; chx:output "(643, (678, 759))" .
chx:X_PointAndBox rd:hasIOExample chx:IO_PointAndBox .
chx:X_MoveTo a owl:NamedIndividual, chx:MoveTo ; rdfs:label "pyautogui.moveTo(100, 100, duration=0.25)"@en ; skos:definition "moveTo moves the pointer to absolute coordinates, at once or over the given number of seconds, and None for one coordinate keeps the present value of that coordinate."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_MoveTo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda pos, x, y: (pos[0] if x is None else x, pos[1] if y is None else y))((100, 200), None, 500) evaluates to (100, 500)"@en ; chx:input "(lambda pos, x, y: (pos[0] if x is None else x, pos[1] if y is None else y))((100, 200), None, 500)" ; chx:output "(100, 500)" .
chx:X_MoveTo rd:hasIOExample chx:IO_MoveTo .
chx:X_MoveRelative a owl:NamedIndividual, chx:MoveRelative ; rdfs:label "pyautogui.move(100, 0, duration=0.25)"@en ; skos:definition "move moves the pointer by an offset from where it is, to the right for a positive first number and downward for a positive second, so a negative number moves it left or up."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_MoveRelative a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda pos, dx, dy: (pos[0] + dx, pos[1] + dy))((200, 100), -100, 0) evaluates to (100, 100)"@en ; chx:input "(lambda pos, dx, dy: (pos[0] + dx, pos[1] + dy))((200, 100), -100, 0)" ; chx:output "(100, 100)" .
chx:X_MoveRelative rd:hasIOExample chx:IO_MoveRelative .
chx:X_ClampToScreen a owl:NamedIndividual, chx:ClampToScreen ; rdfs:label "pyautogui.onScreen(1920, 1080)"@en ; skos:definition "A point is on the screen when 0 <= x < width and 0 <= y < height, which onScreen tests; PyAutoGUI 0.9.54 does not clamp a target to the screen itself, so the display decides where a pointer sent off the screen stops."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_ClampToScreen a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(x, 0 <= x < 1920) for x in (-1, 0, 1919, 1920)] evaluates to [(-1, False), (0, True), (1919, True), (1920, False)]"@en ; chx:input "[(x, 0 <= x < 1920) for x in (-1, 0, 1919, 1920)]" ; chx:output "[(-1, False), (0, True), (1919, True), (1920, False)]" .
chx:X_ClampToScreen rd:hasIOExample chx:IO_ClampToScreen .
chx:X_ClickFunction a owl:NamedIndividual, chx:ClickFunction ; rdfs:label "pyautogui.click(10, 5)"@en ; skos:definition "click moves the pointer to the given coordinates if any and then sends a button press and a release for each click; doubleClick, rightClick and middleClick are the same call with other arguments, and mouseDown and mouseUp send the two halves alone."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_ClickFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(e, 'left') for _ in range(2) for e in ('down', 'up')] evaluates to [('down', 'left'), ('up', 'left'), ('down', 'left'), ('up', 'left')]"@en ; chx:input "[(e, 'left') for _ in range(2) for e in ('down', 'up')]" ; chx:output "[('down', 'left'), ('up', 'left'), ('down', 'left'), ('up', 'left')]" .
chx:X_ClickFunction rd:hasIOExample chx:IO_ClickFunction .
chx:X_ButtonChoice a owl:NamedIndividual, chx:ButtonChoice ; rdfs:label "pyautogui.click(200, 250, button='right')"@en ; skos:definition "The button argument names the button: 'left', 'middle' or 'right' (also 'primary', 'secondary' and the numbers 1 to 7 on Linux), and any other value raises PyAutoGUIException."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_ButtonChoice a owl:NamedIndividual, rd:IOExample ; rdfs:label "{'left': 1, 'middle': 2, 'right': 3}['right'] evaluates to 3"@en ; chx:input "{'left': 1, 'middle': 2, 'right': 3}['right']" ; chx:output "3" .
chx:X_ButtonChoice rd:hasIOExample chx:IO_ButtonChoice .
chx:X_ScrollWheel a owl:NamedIndividual, chx:ScrollWheel ; rdfs:label "pyautogui.scroll(200)"@en ; skos:definition "scroll sends wheel steps at the pointer, upward for a positive number and downward for a negative one; the size of a step depends on the system, and on the Linux backend every unit is one wheel click."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_ScrollWheel a owl:NamedIndividual, rd:IOExample ; rdfs:label "[('up' if n > 0 else 'down', abs(n)) for n in (3, -2)] evaluates to [('up', 3), ('down', 2)]"@en ; chx:input "[('up' if n > 0 else 'down', abs(n)) for n in (3, -2)]" ; chx:output "[('up', 3), ('down', 2)]" .
chx:X_ScrollWheel rd:hasIOExample chx:IO_ScrollWheel .
chx:X_DragFunctions a owl:NamedIndividual, chx:DragFunctions ; rdfs:label "pyautogui.drag(30, 0, duration=0.2)"@en ; skos:definition "drag and dragTo hold the left button (or the one named by button) down while the pointer moves by an offset or to a place, and release it there; a drag of (0, 0) sends nothing."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_DragFunctions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda pos, dx, dy: [('down', 'left'), ('move', pos[0] + dx, pos[1] + dy), ('up', 'left')])((100, 100), 30, 0) evaluates to [('down', 'left'), ('move', 130, 100), ('up', 'left')]"@en ; chx:input "(lambda pos, dx, dy: [('down', 'left'), ('move', pos[0] + dx, pos[1] + dy), ('up', 'left')])((100, 100), 30, 0)" ; chx:output "[('down', 'left'), ('move', 130, 100), ('up', 'left')]" .
chx:X_DragFunctions rd:hasIOExample chx:IO_DragFunctions .
chx:X_SpiralDrawProgram a owl:NamedIndividual, chx:SpiralDrawProgram ; rdfs:label "while distance > 0: pyautogui.drag(distance, 0, duration=0.2)"@en ; skos:definition "The chapter's spiralDraw.py drags right, down, left and up with a distance that shrinks by 20 after every second drag; starting from 300 it makes 32 drag calls, two of them with a zero distance, and the last one moves down because distance has turned negative."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_SpiralDrawProgram a owl:NamedIndividual, rd:IOExample ; rdfs:label "len([c for d in range(300, 0, -40) for c in ((d, 0), (0, d - 20), (-(d - 20), 0), (0, -(d - 40)))]) evaluates to 32"@en ; chx:input "len([c for d in range(300, 0, -40) for c in ((d, 0), (0, d - 20), (-(d - 20), 0), (0, -(d - 40)))])" ; chx:output "32" .
chx:X_SpiralDrawProgram rd:hasIOExample chx:IO_SpiralDrawProgram .
chx:X_WriteFunction a owl:NamedIndividual, chx:WriteFunction ; rdfs:label "pyautogui.write('Hello, world!')"@en ; skos:definition "write presses and releases one key for every character of a string, adds the shift key by itself for capitals and symbols such as ! and lets an optional interval pass between the characters."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_WriteFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "('H'.isupper(), '!' in '~!@#$%^&*()_+', 'h'.isupper()) evaluates to (True, True, False)"@en ; chx:input "('H'.isupper(), '!' in '~!@#$%^&*()_+', 'h'.isupper())" ; chx:output "(True, True, False)" .
chx:X_WriteFunction rd:hasIOExample chx:IO_WriteFunction .
chx:X_KeyListTyping a owl:NamedIndividual, chx:KeyListTyping ; rdfs:label "pyautogui.write(['a', 'b', 'left', 'left', 'X', 'Y'])"@en ; skos:definition "Given a list, write presses each named key in turn, so arrow keys move the text cursor and the list above types XYab."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_KeyListTyping a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda keys: __import__('functools').reduce(lambda st, k: (st[0][:st[1]] + k + st[0][st[1]:], st[1] + 1) if len(k) == 1 else (st[0], max(0, st[1] - 1)) if k == 'left' else st, keys, ('', 0))[0])(['a', 'b', 'left', 'left', 'X', 'Y']) evaluates to 'XYab'"@en ; chx:input "(lambda keys: __import__('functools').reduce(lambda st, k: (st[0][:st[1]] + k + st[0][st[1]:], st[1] + 1) if len(k) == 1 else (st[0], max(0, st[1] - 1)) if k == 'left' else st, keys, ('', 0))[0])(['a', 'b', 'left', 'left', 'X', 'Y'])" ; chx:output "'XYab'" .
chx:X_KeyListTyping rd:hasIOExample chx:IO_KeyListTyping .
chx:X_KeyNameTable a owl:NamedIndividual, chx:KeyNameTable ; rdfs:label "pyautogui.KEYBOARD_KEYS"@en ; skos:definition "A key that is not a single character has a short lowercase name such as 'enter', 'esc', 'left' or 'f1', listed in KEYBOARD_KEYS; names of more than one character are lowercased by the library, and 'shift', 'ctrl', 'alt' and 'win' mean the left-hand key."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_KeyNameTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "[k.lower() if len(k) > 1 else k for k in ('ENTER', 'A', 'Shift')] evaluates to ['enter', 'A', 'shift']"@en ; chx:input "[k.lower() if len(k) > 1 else k for k in ('ENTER', 'A', 'Shift')]" ; chx:output "['enter', 'A', 'shift']" .
chx:X_KeyNameTable rd:hasIOExample chx:IO_KeyNameTable .
chx:X_SilentInvalidKey a owl:NamedIndividual, chx:SilentInvalidKey ; rdfs:label "pyautogui.press('notakey')"@en ; skos:definition "A name that is not a valid key does not raise an error in press, keyDown or write; the call is ignored, so a script can test a name first with isValidKey."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_SilentInvalidKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "[k in {'enter', 'esc', 'left'} for k in ('left', 'leftt')] evaluates to [True, False]"@en ; chx:input "[k in {'enter', 'esc', 'left'} for k in ('left', 'leftt')]" ; chx:output "[True, False]" .
chx:X_SilentInvalidKey rd:hasIOExample chx:IO_SilentInvalidKey .
chx:X_PressAndRelease a owl:NamedIndividual, chx:PressAndRelease ; rdfs:label "pyautogui.keyDown('shift'); pyautogui.press('4'); pyautogui.keyUp('shift')"@en ; skos:definition "keyDown sends a key press and keyUp a release; press sends both, as often as presses says, and hold holds keys for the length of a with block."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_PressAndRelease a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(e, 'left') for _ in range(2) for e in ('keydown', 'keyup')] evaluates to [('keydown', 'left'), ('keyup', 'left'), ('keydown', 'left'), ('keyup', 'left')]"@en ; chx:input "[(e, 'left') for _ in range(2) for e in ('keydown', 'keyup')]" ; chx:output "[('keydown', 'left'), ('keyup', 'left'), ('keydown', 'left'), ('keyup', 'left')]" .
chx:X_PressAndRelease rd:hasIOExample chx:IO_PressAndRelease .
chx:X_HotkeyFunction a owl:NamedIndividual, chx:HotkeyFunction ; rdfs:label "pyautogui.hotkey('ctrl', 'alt', 'shift', 's')"@en ; skos:definition "hotkey presses its keys in the order given and releases them in the reverse order, so that a combination such as CTRL-C is one call instead of four."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_HotkeyFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ks: [('keydown', k) for k in ks] + [('keyup', k) for k in reversed(ks)])(('ctrl', 'c')) evaluates to [('keydown', 'ctrl'), ('keydown', 'c'), ('keyup', 'c'), ('keyup', 'ctrl')]"@en ; chx:input "(lambda ks: [('keydown', k) for k in ks] + [('keyup', k) for k in reversed(ks)])(('ctrl', 'c'))" ; chx:output "[('keydown', 'ctrl'), ('keydown', 'c'), ('keyup', 'c'), ('keyup', 'ctrl')]" .
chx:X_HotkeyFunction rd:hasIOExample chx:IO_HotkeyFunction .
chx:X_FailSafe a owl:NamedIndividual, chx:FailSafe ; rdfs:label "pyautogui.FailSafeException"@en ; skos:definition "While pyautogui.FAILSAFE is True, a pointer in one of the four corners of the screen makes the next PyAutoGUI call raise FailSafeException before it does anything, so a runaway script can be stopped by sliding the mouse into a corner."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_FailSafe a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda w, h: sorted({(0, 0), (w - 1, 0), (0, h - 1), (w - 1, h - 1)}))(1920, 1080) evaluates to [(0, 0), (0, 1079), (1919, 0), (1919, 1079)]"@en ; chx:input "(lambda w, h: sorted({(0, 0), (w - 1, 0), (0, h - 1), (w - 1, h - 1)}))(1920, 1080)" ; chx:output "[(0, 0), (0, 1079), (1919, 0), (1919, 1079)]" .
chx:X_FailSafe rd:hasIOExample chx:IO_FailSafe .
chx:X_PauseSetting a owl:NamedIndividual, chx:PauseSetting ; rdfs:label "pyautogui.PAUSE = 2"@en ; skos:definition "PAUSE is the number of seconds, 0.1 by default, that every PyAutoGUI call waits after it has finished; statements that are not PyAutoGUI calls are not slowed."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_PauseSetting a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(10 * 0.1, 6) evaluates to 1.0"@en ; chx:input "round(10 * 0.1, 6)" ; chx:output "1.0" .
chx:X_PauseSetting rd:hasIOExample chx:IO_PauseSetting .
chx:X_GuardedClick a owl:NamedIndividual, chx:GuardedClick ; rdfs:label "if not pyautogui.pixelMatchesColor(x, y, expected): raise SystemExit"@en ; skos:definition "A script that checks what is on the screen before each event, and stops at the first check that fails, does no harm when a window has moved or a pop-up covers a button."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_GuardedClick a owl:NamedIndividual, rd:IOExample ; rdfs:label "next((i for i, ok in enumerate([True, True, False, True]) if not ok), None) evaluates to 2"@en ; chx:input "next((i for i, ok in enumerate([True, True, False, True]) if not ok), None)" ; chx:output "2" .
chx:X_GuardedClick rd:hasIOExample chx:IO_GuardedClick .
chx:X_ScriptLogging a owl:NamedIndividual, chx:ScriptLogging ; rdfs:label "logging.info('typed row %d', i)"@en ; skos:definition "A script that logs each finished step to a file can be stopped halfway and restarted at the first step that the log does not show as done."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_ScriptLogging a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda lines: 1 + max(int(l.split()[-1]) for l in lines if l.startswith('INFO')))(['INFO typed row 0', 'INFO typed row 1', 'ERROR stopped before row 2']) evaluates to 2"@en ; chx:input "(lambda lines: 1 + max(int(l.split()[-1]) for l in lines if l.startswith('INFO')))(['INFO typed row 0', 'INFO typed row 1', 'ERROR stopped before row 2'])" ; chx:output "2" .
chx:X_ScriptLogging rd:hasIOExample chx:IO_ScriptLogging .
chx:X_CountdownAndSleep a owl:NamedIndividual, chx:CountdownAndSleep ; rdfs:label "pyautogui.countdown(3)"@en ; skos:definition "sleep is time.sleep without the import; countdown prints the numbers from the given one down to 1, each followed by a space and a one-second wait, and then ends the line."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_CountdownAndSleep a owl:NamedIndividual, rd:IOExample ; rdfs:label "''.join(str(i) + ' ' for i in range(3, 0, -1)) + '\\n' evaluates to '3 2 1 \\n'"@en ; chx:input "''.join(str(i) + ' ' for i in range(3, 0, -1)) + '\\n'" ; chx:output "'3 2 1 \\n'" .
chx:X_CountdownAndSleep rd:hasIOExample chx:IO_CountdownAndSleep .
chx:X_AutomationEthics a owl:NamedIndividual, chx:AutomationEthics ; rdfs:label "captcha"@en ; skos:definition "A captcha is a test that only a human should pass, there to stop scripts from signing up for accounts, flooding sites or guessing passwords; the chapter holds the programmer responsible for what a program does."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:X_ScreenshotFunction a owl:NamedIndividual, chx:ScreenshotFunction ; rdfs:label "im = pyautogui.screenshot()"@en ; skos:definition "screenshot returns a Pillow Image of the screen and can save it to a file; it needs Pillow, and on Linux a helper program for capturing the screen."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:X_PixelMatch a owl:NamedIndividual, chx:PixelMatch ; rdfs:label "pyautogui.pixelMatchesColor(50, 200, (130, 135, 144))"@en ; skos:definition "pixel(x, y) returns the RGB colour of one screen pixel, and pixelMatchesColor(x, y, rgb) is True when each of the three channels differs from the given colour by no more than tolerance, which is 0 by default, so the match is exact."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_PixelMatch a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda pix, exp, tol: all(abs(a - b) <= tol for a, b in zip(pix, exp)))((255, 255, 254), (255, 255, 255), 0) evaluates to False"@en ; chx:input "(lambda pix, exp, tol: all(abs(a - b) <= tol for a, b in zip(pix, exp)))((255, 255, 254), (255, 255, 255), 0)" ; chx:output "False" .
chx:X_PixelMatch rd:hasIOExample chx:IO_PixelMatch .
chx:X_LocateOnScreen a owl:NamedIndividual, chx:LocateOnScreen ; rdfs:label "pyautogui.locateOnScreen('submit.png')"@en ; skos:definition "locateOnScreen searches the screen from the upper-left corner, to the right and then down, for a picture that matches pixel for pixel and returns the Box of the first match or raises ImageNotFoundException; locateAllOnScreen yields every match."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_LocateOnScreen a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g, t: [(x, y) for y in range(len(g) - len(t) + 1) for x in range(len(g[0]) - len(t[0]) + 1) if all(g[y + j][x:x + len(t[0])] == t[j] for j in range(len(t)))])(['..##..', '..##..', '......'], ['##', '##']) evaluates to [(2, 0)]"@en ; chx:input "(lambda g, t: [(x, y) for y in range(len(g) - len(t) + 1) for x in range(len(g[0]) - len(t[0]) + 1) if all(g[y + j][x:x + len(t[0])] == t[j] for j in range(len(t)))])(['..##..', '..##..', '......'], ['##', '##'])" ; chx:output "[(2, 0)]" .
chx:X_LocateOnScreen rd:hasIOExample chx:IO_LocateOnScreen .
chx:X_MouseInfoTool a owl:NamedIndividual, chx:MouseInfoTool ; rdfs:label "pyautogui.mouseInfo()"@en ; skos:definition "mouseInfo opens a small window that shows the pointer's coordinates and the colour under it and can copy or log them, to help a script's author find the numbers to use."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:X_ActiveWindow a owl:NamedIndividual, chx:ActiveWindow ; rdfs:label "pyautogui.getActiveWindow()"@en ; skos:definition "getActiveWindow returns the window that receives the keyboard, as a Window object; with PyAutoGUI 0.9.54 this and the other window functions exist only on Windows."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:X_WindowGeometry a owl:NamedIndividual, chx:WindowGeometry ; rdfs:label "active_win.topleft"@en ; skos:definition "A Window has left, top, width and height that can be read and set, and derived attributes such as right, bottom, topleft, center, size, area and box, so a button at a fixed offset inside a window can be clicked wherever the window is."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_WindowGeometry a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda l, t, w, h: (l + w, t + h, (l + w // 2, t + h // 2)))(500, 300, 2070, 1208) evaluates to (2570, 1508, (1535, 904))"@en ; chx:input "(lambda l, t, w, h: (l + w, t + h, (l + w // 2, t + h // 2)))(500, 300, 2070, 1208)" ; chx:output "(2570, 1508, (1535, 904))" .
chx:X_WindowGeometry rd:hasIOExample chx:IO_WindowGeometry .
chx:X_WindowSearch a owl:NamedIndividual, chx:WindowSearch ; rdfs:label "pyautogui.getWindowsWithTitle('Notepad')"@en ; skos:definition "getWindowsWithTitle returns a list of the windows whose title contains the text, an empty list when there are none; getAllWindows, getWindowsAt and getAllTitles return all windows, those at a point and the titles."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_WindowSearch a owl:NamedIndividual, rd:IOExample ; rdfs:label "[t for t in ('Untitled - Notepad', 'Mu 1.0.1 - test1.py', 'Notepad++') if 'Notepad' in t] evaluates to ['Untitled - Notepad', 'Notepad++']"@en ; chx:input "[t for t in ('Untitled - Notepad', 'Mu 1.0.1 - test1.py', 'Notepad++') if 'Notepad' in t]" ; chx:output "['Untitled - Notepad', 'Notepad++']" .
chx:X_WindowSearch rd:hasIOExample chx:IO_WindowSearch .
chx:X_WindowState a owl:NamedIndividual, chx:WindowState ; rdfs:label "active_win.maximize()"@en ; skos:definition "A Window reports isMaximized, isMinimized and isActive and is changed by maximize, minimize, restore, activate and close; close may skip a dialog that asks to save work."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:X_MessageBoxFunctions a owl:NamedIndividual, chx:MessageBoxFunctions ; rdfs:label "pyautogui.confirm('Continue?')"@en ; skos:definition "alert, confirm, prompt and password show a message box, from PyMsgBox, because a script's own text window may be hidden by the windows it works on; confirm returns the text of the button clicked, and prompt and password return the text typed or None after Cancel."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "pyautogui.getWindowsWithTitle('Notepad')"@en ; skos:definition "Practice questions are the chapter's 13 review questions; one asks for the size of every Notepad window."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_PracticeQuestions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda W: [w.size for w in W if 'Notepad' in w.title])([type('W', (), {'title': 'Untitled - Notepad', 'size': (800, 600)})(), type('W', (), {'title': 'Mu', 'size': (2070, 1208)})()]) evaluates to [(800, 600)]"@en ; chx:input "(lambda W: [w.size for w in W if 'Notepad' in w.title])([type('W', (), {'title': 'Untitled - Notepad', 'size': (800, 600)})(), type('W', (), {'title': 'Mu', 'size': (2070, 1208)})()])" ; chx:output "[(800, 600)]" .
chx:X_PracticeQuestions rd:hasIOExample chx:IO_PracticeQuestions .
chx:X_LookingBusy a owl:NamedIndividual, chx:LookingBusy ; rdfs:label "pyautogui.move(-1, 0); pyautogui.sleep(10)"@en ; skos:definition "Looking Busy nudges the pointer one pixel left, waits ten seconds, nudges it one pixel right and repeats, so that a chat program sees mouse movement."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:IO_LookingBusy a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum(-1 if i % 2 == 0 else 1 for i in range(6)) evaluates to 0"@en ; chx:input "sum(-1 if i % 2 == 0 else 1 for i in range(6))" ; chx:output "0" .
chx:X_LookingBusy rd:hasIOExample chx:IO_LookingBusy .
chx:X_ClipboardReading a owl:NamedIndividual, chx:ClipboardReading ; rdfs:label "pyautogui.hotkey('ctrl', 'a'); pyautogui.hotkey('ctrl', 'c'); text = pyperclip.paste()"@en ; skos:definition "To read a text field, the program activates its window, clicks into it, selects all and copies with two hotkeys and reads the clipboard with pyperclip.paste(); PyAutoGUI alone cannot read text from another program."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:X_GameBot a owl:NamedIndividual, chx:GameBot ; rdfs:label "asweigart/sushigoroundbot"@en ; skos:definition "Writing a Game-Playing Bot points to a bot for the Flash game Sushi Go Round that watches the game window for pictures of orders and clicks ingredient buttons."@en ; dcterms:source <http://example.org/sen0414/ch23/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 23 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch23/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 23 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which PyAutoGUI calls send events to the computer, what exactly does each send, and what stops a script that goes wrong?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which statements and printed outputs of the chapter differ in the current library, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 23 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 23 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch23/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-01."@en ;
