chx:Provenance a rd:ResearchSubjectInput,
        owl:NamedIndividual ;
    rdfs:label "Derived from the chapter 2 research artefact"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 2 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en,
        "Concepts are corpus-derived from the 3rd edition's chapter 2 through the Stage 1 research artefact; the pattern-matching, style and expression-form branches are drawn from that artefact's secondary sources, not from the book; the supporting terms (keyword, statement, indentation, clause, identity, sequence and collection, the kinds of error and the traceback) come from the Python documentation read for version 1.1.0 of the research record."@en .

chx:X_Equality a chx:Equality,
        owl:NamedIndividual ;
    rdfs:label "42 == '42'"@en ;
    rd:hasIOExample chx:IO_Equality ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "== and != compare values; an integer never equals a string, so 42 == '42' is False."@en .

chx:X_IfStatement a chx:IfStatement,
        owl:NamedIndividual ;
    rdfs:label "if name == 'Alice':"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "if runs its block only when its condition is true."@en .

chx:X_Ordering a chx:Ordering,
        owl:NamedIndividual ;
    rdfs:label "5 <= 5"@en ;
    rd:hasErrorCondition chx:Err_Ordering ;
    rd:hasIOExample chx:IO_Ordering ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "<, >, <= and >= compare order and return a Boolean value."@en .

chx:X_BooleanValue a chx:BooleanValue,
        owl:NamedIndividual ;
    rdfs:label "the values True and False"@en ;
    rd:hasIOExample chx:IO_BooleanValue ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "The two Boolean values, written with a capital first letter and no quotation marks; every comparison produces one."@en .

chx:X_CasePattern a chx:CasePattern,
        owl:NamedIndividual ;
    rdfs:label "case 401 | 403 | 404:"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A pattern after case describes the values it matches; it can be a literal, a name that captures the value, or alternatives joined by |."@en .

