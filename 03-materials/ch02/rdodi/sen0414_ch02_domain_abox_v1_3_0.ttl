@prefix chx: <http://example.org/sen0414/ch02#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rd: <http://example.org/rdodi/domain-ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chx:Artifact a rd:DomainOntologyArtifact,
        owl:NamedIndividual ;
    rdfs:label "SEN0414 chapter 2 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch02/research> ;
    rd:hasCompetencyQuestion chx:CQs ;
    rd:hasResolutionEnvironment chx:Env ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ;
    rd:hasSourceProvenance chx:Provenance .

chx:X_AndOperator a chx:AndOperator,
        owl:NamedIndividual ;
    rdfs:label "True and False"@en ;
    rd:hasIOExample chx:IO_AndOperator ;
    chx:hasOwner chx:X_BooleanValue ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "and is true only when both operands are true."@en .

chx:X_AssignmentExpression a chx:AssignmentExpression,
        owl:NamedIndividual ;
    rdfs:label "(limit := 10) > 5"@en ;
    rd:hasIOExample chx:IO_AssignmentExpression ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "An assignment expression, written name := value, assigns the value to the name and also yields it."@en .

chx:X_Block a chx:Block,
        owl:NamedIndividual ;
    rdfs:label "an indented group of lines"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A block is a group of lines at the same indentation; Python uses indentation, not braces, to mark it."@en .

chx:X_BooleanComparisonStyle a chx:BooleanComparisonStyle,
        owl:NamedIndividual ;
    rdfs:label "if greeting: rather than if greeting == True:"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "PEP 8 advises testing a Boolean directly instead of comparing it to True or False with ==."@en .

chx:X_BooleanExpression a chx:BooleanExpression,
        owl:NamedIndividual ;
    rdfs:label "(1 == 2) or (2 == 2)"@en ;
    rd:hasIOExample chx:IO_BooleanExpression ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A comparison evaluates to a Boolean value, so comparisons and Boolean operators can be mixed in one expression."@en .

chx:X_BooleanPrecedence a chx:BooleanPrecedence,
        owl:NamedIndividual ;
    rdfs:label "not, then and, then or"@en ;
    rd:hasIOExample chx:IO_BooleanPrecedence ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "After arithmetic and comparison operators, not is applied first, then and, then or."@en .

chx:X_BranchChain a chx:BranchChain,
        owl:NamedIndividual ;
    rdfs:label "if, elif and else together"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A chain of if, elif and else clauses runs at most one block, and exactly one when it ends with else."@en .

chx:X_CaseInsensitiveTest a chx:CaseInsensitiveTest,
        owl:NamedIndividual ;
    rdfs:label "unit == 'TB' or unit == 'tb'"@en ;
    rd:hasIOExample chx:IO_CaseInsensitiveTest ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "Two comparisons joined by or make a test accept either spelling of an answer."@en .

chx:X_ChainedComparison a chx:ChainedComparison,
        owl:NamedIndividual ;
    rdfs:label "1 < 2 < 3"@en ;
    rd:hasIOExample chx:IO_ChainedComparison ;
    chx:hasOwner chx:X_Ordering ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "Comparisons chain: x < y <= z means x < y and y <= z, with y evaluated once."@en .

chx:X_Clause a chx:Clause,
        owl:NamedIndividual ;
    rdfs:label "the if clause"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A clause is a header that begins with a keyword and ends with a colon, together with the block of statements it controls."@en .

chx:X_Condition a chx:Condition,
        owl:NamedIndividual ;
    rdfs:label "the expression after if"@en ;
    rd:hasIOExample chx:IO_Condition ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A condition is an expression evaluated for truth to decide which block runs."@en .

chx:X_ConditionalExpression a chx:ConditionalExpression,
        owl:NamedIndividual ;
    rdfs:label "'even' if 10 % 2 == 0 else 'odd'"@en ;
    rd:hasIOExample chx:IO_ConditionalExpression ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "x if C else y chooses between two values in a single expression."@en .

chx:X_Container a chx:Container,
        owl:NamedIndividual ;
    rdfs:label "[], (), {} and set()"@en ;
    rd:hasIOExample chx:IO_Container ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A sequence or collection such as a string, list, tuple, dictionary or set; when it is empty it counts as false."@en .

chx:X_ElifClause a chx:ElifClause,
        owl:NamedIndividual ;
    rdfs:label "elif age < 12:"@en ;
    chx:hasOwner chx:X_IfStatement ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "elif tests a further condition only when every earlier one was false; at most one branch runs."@en .

chx:X_ElseClause a chx:ElseClause,
        owl:NamedIndividual ;
    rdfs:label "else:"@en ;
    chx:hasOwner chx:X_IfStatement ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "else runs its block when no earlier condition in the chain was true."@en .

chx:X_EmptinessTest a chx:EmptinessTest,
        owl:NamedIndividual ;
    rdfs:label "if seq: rather than if len(seq):"@en ;
    rd:hasIOExample chx:IO_EmptinessTest ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "PEP 8 says to use the fact that empty sequences are false instead of testing their length."@en .

chx:X_EqualsVersusAssign a chx:EqualsVersusAssign,
        owl:NamedIndividual ;
    rdfs:label "the symbols == and ="@en ;
    rd:hasIOExample chx:IO_EqualsVersusAssign ;
    chx:hasOwner chx:X_Equality ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "The operator == asks whether two values are the same; the operator = puts the value on its right into the variable on its left."@en .

chx:X_Exception a chx:Exception,
        owl:NamedIndividual ;
    rdfs:label "an error detected while a program runs"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "An exception is an error detected when a statement or expression is executed; unless the program handles it, the program stops with an error report."@en .

chx:X_FlowControlStatement a chx:FlowControlStatement,
        owl:NamedIndividual ;
    rdfs:label "an if statement"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A statement that decides which instructions run next, such as if, elif and else."@en .

chx:X_Flowchart a chx:Flowchart,
        owl:NamedIndividual ;
    rdfs:label "the flowchart of an if statement"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A diagram of a program's decisions: diamonds for branching points, rectangles for steps and rounded rectangles for the start and the end."@en .

chx:X_Guard a chx:Guard,
        owl:NamedIndividual ;
    rdfs:label "case (x, y) if x == y:"@en ;
    chx:hasOwner chx:X_CasePattern ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A guard is an if condition after a pattern; the case block is selected only when the pattern matches and the guard is true."@en .

chx:X_IdentityComparison a chx:IdentityComparison,
        owl:NamedIndividual ;
    rdfs:label "a is b"@en ;
    rd:hasIOExample chx:IO_IdentityComparison ;
    chx:hasOwner chx:X_Equality ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "The operators is and is not ask whether two expressions are the very same object, which is a different question from whether their values are equal."@en .

chx:X_Indentation a chx:Indentation,
        owl:NamedIndividual ;
    rdfs:label "four spaces in front of a line"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "Indentation is the whitespace at the start of a line; Python compares it between lines to find which lines form a block."@en .

chx:X_IndentationStyle a chx:IndentationStyle,
        owl:NamedIndividual ;
    rdfs:label "four spaces per indentation level"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "PEP 8 asks for four spaces per level, spaces rather than tabs, and one statement per line."@en .

chx:X_InputGuard a chx:InputGuard,
        owl:NamedIndividual ;
    rdfs:label "else: sys.exit('You must enter TB or GB')"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "An else clause can reject input that no earlier branch accepts, report a message and end the program with sys.exit."@en .

chx:X_Keyword a chx:Keyword,
        owl:NamedIndividual ;
    rdfs:label "the words if, else and True"@en ;
    rd:hasIOExample chx:IO_Keyword ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A keyword is a word reserved by the language; it has a fixed meaning and cannot be used as an ordinary name."@en .

chx:X_MatchStatement a chx:MatchStatement,
        owl:NamedIndividual ;
    rdfs:label "match command:"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "Since Python 3.10 a match statement compares a value against successive case patterns, an alternative to a long elif chain."@en .

chx:X_NameErrorKind a chx:NameErrorKind,
        owl:NamedIndividual ;
    rdfs:label "true"@en ;
    rd:hasErrorCondition chx:Err_NameErrorKind ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A NameError means that a name was used that has no value in the program: it was never assigned, or it is misspelled."@en .

chx:X_NoneValue a chx:NoneValue,
        owl:NamedIndividual ;
    rdfs:label "None"@en ;
    rd:hasIOExample chx:IO_NoneValue ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "The single built-in value that stands for the absence of a value; it counts as false but is not equal to False."@en .

chx:X_NotOperator a chx:NotOperator,
        owl:NamedIndividual ;
    rdfs:label "not True"@en ;
    rd:hasIOExample chx:IO_NotOperator ;
    chx:hasOwner chx:X_BooleanValue ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "not inverts a single Boolean value."@en .

chx:X_OperandResult a chx:OperandResult,
        owl:NamedIndividual ;
    rdfs:label "'' or 'default'"@en ;
    rd:hasIOExample chx:IO_OperandResult ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "and and or return one of their operands, which is not necessarily True or False; not always returns a Boolean value."@en .

chx:X_OperatorArity a chx:OperatorArity,
        owl:NamedIndividual ;
    rdfs:label "and versus not"@en ;
    rd:hasIOExample chx:IO_OperatorArity ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A binary operator takes two operands and a unary operator takes one; and and or are binary, not is unary."@en .

chx:X_OrOperator a chx:OrOperator,
        owl:NamedIndividual ;
    rdfs:label "True or False"@en ;
    rd:hasIOExample chx:IO_OrOperator ;
    chx:hasOwner chx:X_BooleanValue ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "or is true when either operand is true."@en .

chx:X_ProgramExecution a chx:ProgramExecution,
        owl:NamedIndividual ;
    rdfs:label "the finger on the current line"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "Program execution is the instruction that is being executed at a given moment; with flow control it jumps around the program."@en .

chx:X_SequencePattern a chx:SequencePattern,
        owl:NamedIndividual ;
    rdfs:label "case ['go', direction]:"@en ;
    chx:hasOwner chx:X_CasePattern ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A pattern that matches a sequence of a given length and binds names to its items."@en .

chx:X_ShortCircuit a chx:ShortCircuit,
        owl:NamedIndividual ;
    rdfs:label "False and 1 / 0"@en ;
    rd:hasErrorCondition chx:Err_ShortCircuit ;
    rd:hasIOExample chx:IO_ShortCircuit ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "and and or stop evaluating as soon as the answer is known, so the second operand is sometimes never evaluated."@en .

chx:X_SingletonComparison a chx:SingletonComparison,
        owl:NamedIndividual ;
    rdfs:label "x is None rather than x == None"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "PEP 8 asks that comparisons with singletons such as None use is or is not, never the equality operators."@en .

chx:X_SoftKeyword a chx:SoftKeyword,
        owl:NamedIndividual ;
    rdfs:label "match and case"@en ;
    rd:hasIOExample chx:IO_SoftKeyword ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A soft keyword is a word that acts as a keyword only in a particular context, so it can still be used as an ordinary name elsewhere."@en .

chx:X_StringOrdering a chx:StringOrdering,
        owl:NamedIndividual ;
    rdfs:label "'apple' < 'banana'"@en ;
    rd:hasIOExample chx:IO_StringOrdering ;
    chx:hasOwner chx:X_Ordering ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "Strings compare lexicographically by the code points of their characters, so every capital letter comes before every lowercase one."@en .

chx:X_SyntaxErrorKind a chx:SyntaxErrorKind,
        owl:NamedIndividual ;
    rdfs:label "if x = 3:"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A SyntaxError means that the text of the program is not valid Python; an IndentationError is a kind of SyntaxError."@en .

chx:X_Toggle a chx:Toggle,
        owl:NamedIndividual ;
    rdfs:label "say_it_is_opposite_day = not say_it_is_opposite_day"@en ;
    rd:hasIOExample chx:IO_Toggle ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "Toggling sets a Boolean variable to its opposite value with not."@en .

chx:X_Traceback a chx:Traceback,
        owl:NamedIndividual ;
    rdfs:label "Traceback (most recent call last):"@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A traceback is the report that Python prints for an uncaught error: the lines through which execution reached the failure, and last the kind and message of the error."@en .

chx:X_TruthTable a chx:TruthTable,
        owl:NamedIndividual ;
    rdfs:label "the truth table of and"@en ;
    rd:hasIOExample chx:IO_TruthTable ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A table that lists every possible combination of operand values for a Boolean operator and the result for each."@en .

chx:X_Truthiness a chx:Truthiness,
        owl:NamedIndividual ;
    rdfs:label "bool('') and bool('0')"@en ;
    rd:hasIOExample chx:IO_Truthiness ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "Any value can be tested for truth: None, False, zero and empty sequences are false, so bool('') is False while bool('0') is True."@en .

chx:X_TypeErrorKind a chx:TypeErrorKind,
        owl:NamedIndividual ;
    rdfs:label "3 < '4'"@en ;
    rd:hasErrorCondition chx:Err_TypeErrorKind ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A TypeError means that an operation was applied to a value of a type that does not support it."@en .

chx:X_UnassignedName a chx:UnassignedName,
        owl:NamedIndividual ;
    rdfs:label "discrepancy"@en ;
    rd:hasErrorCondition chx:Err_UnassignedName ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A variable that is assigned only inside the branches of a chain does not exist when no branch runs, and using it raises a NameError."@en .

chx:X_WildcardPattern a chx:WildcardPattern,
        owl:NamedIndividual ;
    rdfs:label "case _:"@en ;
    chx:hasOwner chx:X_CasePattern ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "The pattern _ matches anything and binds no name; as the last case it handles every value that no earlier case matched."@en .

chx:X_ZeroDivisionErrorKind a chx:ZeroDivisionErrorKind,
        owl:NamedIndividual ;
    rdfs:label "1 / 0"@en ;
    rd:hasErrorCondition chx:Err_ZeroDivisionErrorKind ;
    dcterms:source <http://example.org/sen0414/ch02/research> ;
    skos:definition "A ZeroDivisionError means that a division or remainder operation had zero as its second operand."@en .

<http://example.org/sen0414/ch02/abox> a owl:Ontology ;
    rdfs:label "SEN0414 chapter 2 domain ontology - ABox"@en ;
    dcterms:created "2026-09-24"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
