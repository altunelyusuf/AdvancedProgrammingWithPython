        owl:NamedIndividual ;
    rdfs:label "'apple' < 'banana' evaluates to True"@en ;
    chx:input "'apple' < 'banana'" ;
    chx:output "True" .

chx:IO_Toggle a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "not False evaluates to True"@en ;
    chx:input "not False" ;
    chx:output "True" .

chx:IO_TruthTable a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "False and False evaluates to False"@en ;
