chx:CQ1 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which constructs decide which block runs, and on what kind of value?"@en .

chx:CQ2 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which concepts reach beyond the 3rd edition into current Python, and on what source?"@en .

chx:CQ3 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which errors can the chapter's conditions and programs raise, and what does each message say?"@en .

chx:CQ4 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which terms do the explanations of this chapter rely on, and is each one a concept of this chapter or of chapter 1?"@en .

chx:CQs a rd:CompetencyQuestionSet,
        owl:NamedIndividual ;
    rdfs:label "Chapter 2 competency questions"@en ;
    rd:containsCompetencyQuestion chx:CQ1,
        chx:CQ2,
        chx:CQ3,
        chx:CQ4 .

chx:Env a rd:ResolutionEnvironment,
        owl:NamedIndividual ;
    rdfs:label "CPython 3.12.11 and CPython 3.14.4"@en,
        "CPython 3.14.4"@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py",
        "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch02_corpus_v1_0_0.py" ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (181 checks listed in sen0414_ch02_corpus_v1_0_0.py), executed under CPython 3.12.11 and CPython 3.14.4: identical output where more than one was used."@en,
        "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-24."@en .

chx:Err_NameErrorKind a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "true raises NameError: name 'true' is not defined"@en .

chx:Err_Ordering a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "3 < '4' raises TypeError: '<' not supported between instances of 'int' and 'str'"@en .

chx:Err_ShortCircuit a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "1 and 1 / 0 raises ZeroDivisionError: division by zero"@en .

chx:Err_TypeErrorKind a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "3 < '4' raises TypeError: '<' not supported between instances of 'int' and 'str'"@en .

chx:Err_UnassignedName a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "discrepancy raises NameError: name 'discrepancy' is not defined"@en .

chx:Err_ZeroDivisionErrorKind a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "1 / 0 raises ZeroDivisionError: division by zero"@en .

chx:IO_AndOperator a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "True and False evaluates to False"@en ;
    chx:input "True and False" ;
    chx:output "False" .

chx:IO_AssignmentExpression a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(limit := 10) > 5 evaluates to True"@en ;
    chx:input "(limit := 10) > 5" ;
    chx:output "True" .

chx:IO_BooleanExpression a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(1 == 2) or (2 == 2) evaluates to True"@en ;
    chx:input "(1 == 2) or (2 == 2)" ;
    chx:output "True" .

chx:IO_BooleanPrecedence a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "True or False and False evaluates to True"@en ;
    chx:input "True or False and False" ;
    chx:output "True" .

chx:IO_BooleanValue a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "42 == 42 evaluates to True"@en ;
    chx:input "42 == 42" ;
    chx:output "True" .

chx:IO_CaseInsensitiveTest a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "'tb' == 'TB' or 'tb' == 'tb' evaluates to True"@en ;
    chx:input "'tb' == 'TB' or 'tb' == 'tb'" ;
    chx:output "True" .

chx:IO_ChainedComparison a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "1 < 2 < 3 evaluates to True"@en ;
    chx:input "1 < 2 < 3" ;
    chx:output "True" .

chx:IO_Condition a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "3000 > 100 evaluates to True"@en ;
    chx:input "3000 > 100" ;
    chx:output "True" .

chx:IO_ConditionalExpression a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "'even' if 10 % 2 == 0 else 'odd' evaluates to 'even'"@en ;
    chx:input "'even' if 10 % 2 == 0 else 'odd'" ;
    chx:output "'even'" .

chx:IO_Container a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "len([10, 20, 30]) evaluates to 3"@en ;
    chx:input "len([10, 20, 30])" ;
    chx:output "3" .

chx:IO_EmptinessTest a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "bool([]) evaluates to False"@en ;
    chx:input "bool([])" ;
    chx:output "False" .

chx:IO_Equality a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "42 == '42' evaluates to False"@en ;
    chx:input "42 == '42'" ;
    chx:output "False" .

chx:IO_EqualsVersusAssign a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "4 == 2 + 2 evaluates to True"@en ;
    chx:input "4 == 2 + 2" ;
    chx:output "True" .

chx:IO_IdentityComparison a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "None is None evaluates to True"@en ;
    chx:input "None is None" ;
    chx:output "True" .

chx:IO_Keyword a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "__import__('keyword').iskeyword('if') evaluates to True"@en ;
    chx:input "__import__('keyword').iskeyword('if')" ;
    chx:output "True" .

chx:IO_NoneValue a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "bool(None) evaluates to False"@en ;
    chx:input "bool(None)" ;
    chx:output "False" .

chx:IO_NotOperator a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "not True evaluates to False"@en ;
    chx:input "not True" ;
    chx:output "False" .

