        owl:NamedIndividual ;
    rdfs:label "'' or 'default' evaluates to 'default'"@en ;
    chx:input "'' or 'default'" ;
    chx:output "'default'" .

chx:IO_OperatorArity a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "-(2 + 3) evaluates to -5"@en ;
    chx:input "-(2 + 3)" ;
    chx:output "-5" .

chx:IO_OrOperator a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "True or False evaluates to True"@en ;
    chx:input "True or False" ;
    chx:output "True" .

chx:IO_Ordering a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "5 <= 5 evaluates to True"@en ;
    chx:input "5 <= 5" ;
    chx:output "True" .

chx:IO_ShortCircuit a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "False and 1 / 0 evaluates to False"@en ;
    chx:input "False and 1 / 0" ;
    chx:output "False" .

