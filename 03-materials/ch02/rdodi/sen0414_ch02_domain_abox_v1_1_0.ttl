@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0414/ch02/abox> a owl:Ontology ;
    rdfs:label "SEN0414 chapter 2 domain ontology - ABox"@en ; owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0414/ch02/abox/1.1.0> ; rdfs:comment "1.1.0 adds the concepts that the text of 1.0.0 used or needed without explaining them (the keyword, the statement, program execution, the flowchart, indentation, the clause, None, sequences and collections, identity, binary and unary operators, the truth table, operand results, the kinds of error and the traceback, among others), keeps every earlier concept and its identifier, and rewrites every explanation as four to six paragraphs of continuous prose; added concepts and a rewrite of the text, so MINOR."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-24"^^xsd:date ; dcterms:modified "2026-10-01"^^xsd:date ;
    dcterms:identifier "sen0414_ch02_domain_abox_v1_1_0" ; prov:wasRevisionOf <http://example.org/sen0414/ch02/abox/1.0.0> ;
    prov:wasGeneratedBy <http://example.org/sen0414/activity/ch02-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

ch02:X_BooleanValue a owl:NamedIndividual, ch02:BooleanValue ; rdfs:label "the values True and False"@en ; skos:definition "The two Boolean values, written with a capital first letter and no quotation marks; every comparison produces one."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_BooleanValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "42 == 42 evaluates to True"@en ; ch02:input "42 == 42" ; ch02:output "True" .
ch02:X_BooleanValue rd:hasIOExample ch02:IO_BooleanValue .
ch02:X_Truthiness a owl:NamedIndividual, ch02:Truthiness ; rdfs:label "bool('') and bool('0')"@en ; skos:definition "Any value can be tested for truth: None, False, zero and empty sequences are false, so bool('') is False while bool('0') is True."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_Truthiness a owl:NamedIndividual, rd:IOExample ; rdfs:label "bool('0') evaluates to True"@en ; ch02:input "bool('0')" ; ch02:output "True" .
ch02:X_Truthiness rd:hasIOExample ch02:IO_Truthiness .
ch02:X_NoneValue a owl:NamedIndividual, ch02:NoneValue ; rdfs:label "None"@en ; skos:definition "The single built-in value that stands for the absence of a value; it counts as false but is not equal to False."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_NoneValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "bool(None) evaluates to False"@en ; ch02:input "bool(None)" ; ch02:output "False" .
ch02:X_NoneValue rd:hasIOExample ch02:IO_NoneValue .
ch02:X_Container a owl:NamedIndividual, ch02:Container ; rdfs:label "[], (), {} and set()"@en ; skos:definition "A sequence or collection such as a string, list, tuple, dictionary or set; when it is empty it counts as false."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_Container a owl:NamedIndividual, rd:IOExample ; rdfs:label "len([10, 20, 30]) evaluates to 3"@en ; ch02:input "len([10, 20, 30])" ; ch02:output "3" .
ch02:X_Container rd:hasIOExample ch02:IO_Container .
ch02:X_Equality a owl:NamedIndividual, ch02:Equality ; rdfs:label "42 == '42'"@en ; skos:definition "== and != compare values; an integer never equals a string, so 42 == '42' is False."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_Equality a owl:NamedIndividual, rd:IOExample ; rdfs:label "42 == '42' evaluates to False"@en ; ch02:input "42 == '42'" ; ch02:output "False" .
ch02:X_Equality rd:hasIOExample ch02:IO_Equality .
ch02:X_EqualsVersusAssign a owl:NamedIndividual, ch02:EqualsVersusAssign ; rdfs:label "the symbols == and ="@en ; skos:definition "The operator == asks whether two values are the same; the operator = puts the value on its right into the variable on its left."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_EqualsVersusAssign a owl:NamedIndividual, rd:IOExample ; rdfs:label "4 == 2 + 2 evaluates to True"@en ; ch02:input "4 == 2 + 2" ; ch02:output "True" .
ch02:X_EqualsVersusAssign rd:hasIOExample ch02:IO_EqualsVersusAssign .
ch02:X_IdentityComparison a owl:NamedIndividual, ch02:IdentityComparison ; rdfs:label "a is b"@en ; skos:definition "The operators is and is not ask whether two expressions are the very same object, which is a different question from whether their values are equal."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_IdentityComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "None is None evaluates to True"@en ; ch02:input "None is None" ; ch02:output "True" .
ch02:X_IdentityComparison rd:hasIOExample ch02:IO_IdentityComparison .
ch02:X_Ordering a owl:NamedIndividual, ch02:Ordering ; rdfs:label "5 <= 5"@en ; skos:definition "<, >, <= and >= compare order and return a Boolean value."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_Ordering a owl:NamedIndividual, rd:IOExample ; rdfs:label "5 <= 5 evaluates to True"@en ; ch02:input "5 <= 5" ; ch02:output "True" .
ch02:X_Ordering rd:hasIOExample ch02:IO_Ordering .
ch02:X_ChainedComparison a owl:NamedIndividual, ch02:ChainedComparison ; rdfs:label "1 < 2 < 3"@en ; skos:definition "Comparisons chain: x < y <= z means x < y and y <= z, with y evaluated once."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_ChainedComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "1 < 2 < 3 evaluates to True"@en ; ch02:input "1 < 2 < 3" ; ch02:output "True" .
ch02:X_ChainedComparison rd:hasIOExample ch02:IO_ChainedComparison .
ch02:X_StringOrdering a owl:NamedIndividual, ch02:StringOrdering ; rdfs:label "'apple' < 'banana'"@en ; skos:definition "Strings compare lexicographically by the code points of their characters, so every capital letter comes before every lowercase one."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_StringOrdering a owl:NamedIndividual, rd:IOExample ; rdfs:label "'apple' < 'banana' evaluates to True"@en ; ch02:input "'apple' < 'banana'" ; ch02:output "True" .
ch02:X_StringOrdering rd:hasIOExample ch02:IO_StringOrdering .
ch02:X_AndOperator a owl:NamedIndividual, ch02:AndOperator ; rdfs:label "True and False"@en ; skos:definition "and is true only when both operands are true."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_AndOperator a owl:NamedIndividual, rd:IOExample ; rdfs:label "True and False evaluates to False"@en ; ch02:input "True and False" ; ch02:output "False" .
ch02:X_AndOperator rd:hasIOExample ch02:IO_AndOperator .
ch02:X_OrOperator a owl:NamedIndividual, ch02:OrOperator ; rdfs:label "True or False"@en ; skos:definition "or is true when either operand is true."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_OrOperator a owl:NamedIndividual, rd:IOExample ; rdfs:label "True or False evaluates to True"@en ; ch02:input "True or False" ; ch02:output "True" .
ch02:X_OrOperator rd:hasIOExample ch02:IO_OrOperator .
ch02:X_NotOperator a owl:NamedIndividual, ch02:NotOperator ; rdfs:label "not True"@en ; skos:definition "not inverts a single Boolean value."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_NotOperator a owl:NamedIndividual, rd:IOExample ; rdfs:label "not True evaluates to False"@en ; ch02:input "not True" ; ch02:output "False" .
ch02:X_NotOperator rd:hasIOExample ch02:IO_NotOperator .
ch02:X_OperatorArity a owl:NamedIndividual, ch02:OperatorArity ; rdfs:label "and versus not"@en ; skos:definition "A binary operator takes two operands and a unary operator takes one; and and or are binary, not is unary."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_OperatorArity a owl:NamedIndividual, rd:IOExample ; rdfs:label "-(2 + 3) evaluates to -5"@en ; ch02:input "-(2 + 3)" ; ch02:output "-5" .
ch02:X_OperatorArity rd:hasIOExample ch02:IO_OperatorArity .
ch02:X_TruthTable a owl:NamedIndividual, ch02:TruthTable ; rdfs:label "the truth table of and"@en ; skos:definition "A table that lists every possible combination of operand values for a Boolean operator and the result for each."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_TruthTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "False and False evaluates to False"@en ; ch02:input "False and False" ; ch02:output "False" .
ch02:X_TruthTable rd:hasIOExample ch02:IO_TruthTable .
ch02:X_ShortCircuit a owl:NamedIndividual, ch02:ShortCircuit ; rdfs:label "False and 1 / 0"@en ; skos:definition "and and or stop evaluating as soon as the answer is known, so the second operand is sometimes never evaluated."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_ShortCircuit a owl:NamedIndividual, rd:IOExample ; rdfs:label "False and 1 / 0 evaluates to False"@en ; ch02:input "False and 1 / 0" ; ch02:output "False" .
ch02:X_ShortCircuit rd:hasIOExample ch02:IO_ShortCircuit .
ch02:X_OperandResult a owl:NamedIndividual, ch02:OperandResult ; rdfs:label "'' or 'default'"@en ; skos:definition "and and or return one of their operands, which is not necessarily True or False; not always returns a Boolean value."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_OperandResult a owl:NamedIndividual, rd:IOExample ; rdfs:label "'' or 'default' evaluates to 'default'"@en ; ch02:input "'' or 'default'" ; ch02:output "'default'" .
ch02:X_OperandResult rd:hasIOExample ch02:IO_OperandResult .
ch02:X_BooleanExpression a owl:NamedIndividual, ch02:BooleanExpression ; rdfs:label "(1 == 2) or (2 == 2)"@en ; skos:definition "A comparison evaluates to a Boolean value, so comparisons and Boolean operators can be mixed in one expression."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_BooleanExpression a owl:NamedIndividual, rd:IOExample ; rdfs:label "(1 == 2) or (2 == 2) evaluates to True"@en ; ch02:input "(1 == 2) or (2 == 2)" ; ch02:output "True" .
ch02:X_BooleanExpression rd:hasIOExample ch02:IO_BooleanExpression .
ch02:X_BooleanPrecedence a owl:NamedIndividual, ch02:BooleanPrecedence ; rdfs:label "not, then and, then or"@en ; skos:definition "After arithmetic and comparison operators, not is applied first, then and, then or."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_BooleanPrecedence a owl:NamedIndividual, rd:IOExample ; rdfs:label "True or False and False evaluates to True"@en ; ch02:input "True or False and False" ; ch02:output "True" .
ch02:X_BooleanPrecedence rd:hasIOExample ch02:IO_BooleanPrecedence .
ch02:X_FlowControlStatement a owl:NamedIndividual, ch02:FlowControlStatement ; rdfs:label "an if statement"@en ; skos:definition "A statement that decides which instructions run next, such as if, elif and else."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_ProgramExecution a owl:NamedIndividual, ch02:ProgramExecution ; rdfs:label "the finger on the current line"@en ; skos:definition "Program execution is the instruction that is being executed at a given moment; with flow control it jumps around the program."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_Flowchart a owl:NamedIndividual, ch02:Flowchart ; rdfs:label "the flowchart of an if statement"@en ; skos:definition "A diagram of a program's decisions: diamonds for branching points, rectangles for steps and rounded rectangles for the start and the end."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_Condition a owl:NamedIndividual, ch02:Condition ; rdfs:label "the expression after if"@en ; skos:definition "A condition is an expression evaluated for truth to decide which block runs."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_Condition a owl:NamedIndividual, rd:IOExample ; rdfs:label "3000 > 100 evaluates to True"@en ; ch02:input "3000 > 100" ; ch02:output "True" .
ch02:X_Condition rd:hasIOExample ch02:IO_Condition .
ch02:X_Block a owl:NamedIndividual, ch02:Block ; rdfs:label "an indented group of lines"@en ; skos:definition "A block is a group of lines at the same indentation; Python uses indentation, not braces, to mark it."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_Indentation a owl:NamedIndividual, ch02:Indentation ; rdfs:label "four spaces in front of a line"@en ; skos:definition "Indentation is the whitespace at the start of a line; Python compares it between lines to find which lines form a block."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_Clause a owl:NamedIndividual, ch02:Clause ; rdfs:label "the if clause"@en ; skos:definition "A clause is a header that begins with a keyword and ends with a colon, together with the block of statements it controls."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_Keyword a owl:NamedIndividual, ch02:Keyword ; rdfs:label "the words if, else and True"@en ; skos:definition "A keyword is a word reserved by the language; it has a fixed meaning and cannot be used as an ordinary name."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_Keyword a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('keyword').iskeyword('if') evaluates to True"@en ; ch02:input "__import__('keyword').iskeyword('if')" ; ch02:output "True" .
ch02:X_Keyword rd:hasIOExample ch02:IO_Keyword .
ch02:X_IfStatement a owl:NamedIndividual, ch02:IfStatement ; rdfs:label "if name == 'Alice':"@en ; skos:definition "if runs its block only when its condition is true."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_ElifClause a owl:NamedIndividual, ch02:ElifClause ; rdfs:label "elif age < 12:"@en ; skos:definition "elif tests a further condition only when every earlier one was false; at most one branch runs."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_ElseClause a owl:NamedIndividual, ch02:ElseClause ; rdfs:label "else:"@en ; skos:definition "else runs its block when no earlier condition in the chain was true."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_BranchChain a owl:NamedIndividual, ch02:BranchChain ; rdfs:label "if, elif and else together"@en ; skos:definition "A chain of if, elif and else clauses runs at most one block, and exactly one when it ends with else."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_ConditionalExpression a owl:NamedIndividual, ch02:ConditionalExpression ; rdfs:label "'even' if 10 % 2 == 0 else 'odd'"@en ; skos:definition "x if C else y chooses between two values in a single expression."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_ConditionalExpression a owl:NamedIndividual, rd:IOExample ; rdfs:label "'even' if 10 % 2 == 0 else 'odd' evaluates to 'even'"@en ; ch02:input "'even' if 10 % 2 == 0 else 'odd'" ; ch02:output "'even'" .
ch02:X_ConditionalExpression rd:hasIOExample ch02:IO_ConditionalExpression .
ch02:X_AssignmentExpression a owl:NamedIndividual, ch02:AssignmentExpression ; rdfs:label "(limit := 10) > 5"@en ; skos:definition "An assignment expression, written name := value, assigns the value to the name and also yields it."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_AssignmentExpression a owl:NamedIndividual, rd:IOExample ; rdfs:label "(limit := 10) > 5 evaluates to True"@en ; ch02:input "(limit := 10) > 5" ; ch02:output "True" .
ch02:X_AssignmentExpression rd:hasIOExample ch02:IO_AssignmentExpression .
ch02:X_MatchStatement a owl:NamedIndividual, ch02:MatchStatement ; rdfs:label "match command:"@en ; skos:definition "Since Python 3.10 a match statement compares a value against successive case patterns, an alternative to a long elif chain."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_CasePattern a owl:NamedIndividual, ch02:CasePattern ; rdfs:label "case 401 | 403 | 404:"@en ; skos:definition "A pattern after case describes the values it matches; it can be a literal, a name that captures the value, or alternatives joined by |."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_WildcardPattern a owl:NamedIndividual, ch02:WildcardPattern ; rdfs:label "case _:"@en ; skos:definition "The pattern _ matches anything and binds no name; as the last case it handles every value that no earlier case matched."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_SequencePattern a owl:NamedIndividual, ch02:SequencePattern ; rdfs:label "case ['go', direction]:"@en ; skos:definition "A pattern that matches a sequence of a given length and binds names to its items."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_Guard a owl:NamedIndividual, ch02:Guard ; rdfs:label "case (x, y) if x == y:"@en ; skos:definition "A guard is an if condition after a pattern; the case block is selected only when the pattern matches and the guard is true."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_SoftKeyword a owl:NamedIndividual, ch02:SoftKeyword ; rdfs:label "match and case"@en ; skos:definition "A soft keyword is a word that acts as a keyword only in a particular context, so it can still be used as an ordinary name elsewhere."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_SoftKeyword a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('keyword').issoftkeyword('match') evaluates to True"@en ; ch02:input "__import__('keyword').issoftkeyword('match')" ; ch02:output "True" .
ch02:X_SoftKeyword rd:hasIOExample ch02:IO_SoftKeyword .
ch02:X_BooleanComparisonStyle a owl:NamedIndividual, ch02:BooleanComparisonStyle ; rdfs:label "if greeting: rather than if greeting == True:"@en ; skos:definition "PEP 8 advises testing a Boolean directly instead of comparing it to True or False with ==."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_SingletonComparison a owl:NamedIndividual, ch02:SingletonComparison ; rdfs:label "x is None rather than x == None"@en ; skos:definition "PEP 8 asks that comparisons with singletons such as None use is or is not, never the equality operators."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_EmptinessTest a owl:NamedIndividual, ch02:EmptinessTest ; rdfs:label "if seq: rather than if len(seq):"@en ; skos:definition "PEP 8 says to use the fact that empty sequences are false instead of testing their length."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_EmptinessTest a owl:NamedIndividual, rd:IOExample ; rdfs:label "bool([]) evaluates to False"@en ; ch02:input "bool([])" ; ch02:output "False" .
ch02:X_EmptinessTest rd:hasIOExample ch02:IO_EmptinessTest .
ch02:X_IndentationStyle a owl:NamedIndividual, ch02:IndentationStyle ; rdfs:label "four spaces per indentation level"@en ; skos:definition "PEP 8 asks for four spaces per level, spaces rather than tabs, and one statement per line."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_Toggle a owl:NamedIndividual, ch02:Toggle ; rdfs:label "say_it_is_opposite_day = not say_it_is_opposite_day"@en ; skos:definition "Toggling sets a Boolean variable to its opposite value with not."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_Toggle a owl:NamedIndividual, rd:IOExample ; rdfs:label "not False evaluates to True"@en ; ch02:input "not False" ; ch02:output "True" .
ch02:X_Toggle rd:hasIOExample ch02:IO_Toggle .
ch02:X_CaseInsensitiveTest a owl:NamedIndividual, ch02:CaseInsensitiveTest ; rdfs:label "unit == 'TB' or unit == 'tb'"@en ; skos:definition "Two comparisons joined by or make a test accept either spelling of an answer."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:IO_CaseInsensitiveTest a owl:NamedIndividual, rd:IOExample ; rdfs:label "'tb' == 'TB' or 'tb' == 'tb' evaluates to True"@en ; ch02:input "'tb' == 'TB' or 'tb' == 'tb'" ; ch02:output "True" .
ch02:X_CaseInsensitiveTest rd:hasIOExample ch02:IO_CaseInsensitiveTest .
ch02:X_UnassignedName a owl:NamedIndividual, ch02:UnassignedName ; rdfs:label "discrepancy"@en ; skos:definition "A variable that is assigned only inside the branches of a chain does not exist when no branch runs, and using it raises a NameError."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_InputGuard a owl:NamedIndividual, ch02:InputGuard ; rdfs:label "else: sys.exit('You must enter TB or GB')"@en ; skos:definition "An else clause can reject input that no earlier branch accepts, report a message and end the program with sys.exit."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_Exception a owl:NamedIndividual, ch02:Exception ; rdfs:label "an error detected while a program runs"@en ; skos:definition "An exception is an error detected when a statement or expression is executed; unless the program handles it, the program stops with an error report."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_SyntaxErrorKind a owl:NamedIndividual, ch02:SyntaxErrorKind ; rdfs:label "if x = 3:"@en ; skos:definition "A SyntaxError means that the text of the program is not valid Python; an IndentationError is a kind of SyntaxError."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_NameErrorKind a owl:NamedIndividual, ch02:NameErrorKind ; rdfs:label "true"@en ; skos:definition "A NameError means that a name was used that has no value in the program: it was never assigned, or it is misspelled."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_TypeErrorKind a owl:NamedIndividual, ch02:TypeErrorKind ; rdfs:label "3 < '4'"@en ; skos:definition "A TypeError means that an operation was applied to a value of a type that does not support it."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_ZeroDivisionErrorKind a owl:NamedIndividual, ch02:ZeroDivisionErrorKind ; rdfs:label "1 / 0"@en ; skos:definition "A ZeroDivisionError means that a division or remainder operation had zero as its second operand."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_Traceback a owl:NamedIndividual, ch02:Traceback ; rdfs:label "Traceback (most recent call last):"@en ; skos:definition "A traceback is the report that Python prints for an uncaught error: the lines through which execution reached the failure, and last the kind and message of the error."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:X_AndOperator ch02:hasOwner ch02:X_BooleanValue .
ch02:X_OrOperator ch02:hasOwner ch02:X_BooleanValue .
ch02:X_NotOperator ch02:hasOwner ch02:X_BooleanValue .
ch02:X_ChainedComparison ch02:hasOwner ch02:X_Ordering .
ch02:X_StringOrdering ch02:hasOwner ch02:X_Ordering .
ch02:X_EqualsVersusAssign ch02:hasOwner ch02:X_Equality .
ch02:X_IdentityComparison ch02:hasOwner ch02:X_Equality .
ch02:X_ElifClause ch02:hasOwner ch02:X_IfStatement .
ch02:X_ElseClause ch02:hasOwner ch02:X_IfStatement .
ch02:X_WildcardPattern ch02:hasOwner ch02:X_CasePattern .
ch02:X_SequencePattern ch02:hasOwner ch02:X_CasePattern .
ch02:X_Guard ch02:hasOwner ch02:X_CasePattern .
ch02:Err_NameErrorKind a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "true raises NameError: name 'true' is not defined"@en .
ch02:X_NameErrorKind rd:hasErrorCondition ch02:Err_NameErrorKind .
ch02:Err_UnassignedName a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "discrepancy raises NameError: name 'discrepancy' is not defined"@en .
ch02:X_UnassignedName rd:hasErrorCondition ch02:Err_UnassignedName .
ch02:Err_TypeErrorKind a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "3 < '4' raises TypeError: '<' not supported between instances of 'int' and 'str'"@en .
ch02:X_TypeErrorKind rd:hasErrorCondition ch02:Err_TypeErrorKind .
ch02:Err_Ordering a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "3 < '4' raises TypeError: '<' not supported between instances of 'int' and 'str'"@en .
ch02:X_Ordering rd:hasErrorCondition ch02:Err_Ordering .
ch02:Err_ZeroDivisionErrorKind a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "1 / 0 raises ZeroDivisionError: division by zero"@en .
ch02:X_ZeroDivisionErrorKind rd:hasErrorCondition ch02:Err_ZeroDivisionErrorKind .
ch02:Err_ShortCircuit a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "1 and 1 / 0 raises ZeroDivisionError: division by zero"@en .
ch02:X_ShortCircuit rd:hasErrorCondition ch02:Err_ShortCircuit .

ch02:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 2 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch02/research> ;
    rd:hasCompetencyQuestion ch02:CQs ; rd:hasSourceProvenance ch02:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment ch02:Env .
ch02:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 2 competency questions"@en ;
    rd:containsCompetencyQuestion ch02:CQ1, ch02:CQ2, ch02:CQ3, ch02:CQ4 .
ch02:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which constructs decide which block runs, and on what kind of value?"@en .
ch02:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which concepts reach beyond the 3rd edition into current Python, and on what source?"@en .
ch02:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which errors can the chapter's conditions and programs raise, and what does each message say?"@en .
ch02:CQ4 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which terms do the explanations of this chapter rely on, and is each one a concept of this chapter or of chapter 1?"@en .
ch02:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 2 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 2 through the Stage 1 research artefact; the pattern-matching, style and expression-form branches are drawn from that artefact's secondary sources, not from the book; the supporting terms (keyword, statement, indentation, clause, identity, sequence and collection, the kinds of error and the traceback) come from the Python documentation read for version 1.1.0 of the research record."@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> .
ch02:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.12.11 and CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (181 checks listed in sen0414_ch02_corpus_v1_0_0.py), executed under CPython 3.12.11 and CPython 3.14.4: identical output where more than one was used."@en ;
    dcterms:source "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch02_corpus_v1_0_0.py" .

