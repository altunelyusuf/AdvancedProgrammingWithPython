chx:X_BooleanValue a owl:NamedIndividual, chx:BooleanValue ; rdfs:label "the values True and False"@en ; skos:definition "The two Boolean values, written with a capital letter; the result of every comparison."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_BooleanValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "42 == 42 evaluates to True"@en ; chx:input "42 == 42" ; chx:output "True" .
chx:X_BooleanValue rd:hasIOExample chx:IO_BooleanValue .
chx:X_Truthiness a owl:NamedIndividual, chx:Truthiness ; rdfs:label "bool('') and bool('0')"@en ; skos:definition "Any value can be tested for truth: None, False, zero and empty sequences are false, so bool('') is False while bool('0') is True."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_Truthiness a owl:NamedIndividual, rd:IOExample ; rdfs:label "bool('0') evaluates to True"@en ; chx:input "bool('0')" ; chx:output "True" .
chx:X_Truthiness rd:hasIOExample chx:IO_Truthiness .
chx:X_Equality a owl:NamedIndividual, chx:Equality ; rdfs:label "42 == '42'"@en ; skos:definition "== and != compare values; an integer never equals a string, so 42 == '42' is False."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_Equality a owl:NamedIndividual, rd:IOExample ; rdfs:label "42 == '42' evaluates to False"@en ; chx:input "42 == '42'" ; chx:output "False" .
chx:X_Equality rd:hasIOExample chx:IO_Equality .
chx:X_Ordering a owl:NamedIndividual, chx:Ordering ; rdfs:label "2 != 3 and 4 < 5"@en ; skos:definition "<, >, <= and >= compare order and return a Boolean value."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_Ordering a owl:NamedIndividual, rd:IOExample ; rdfs:label "(4 < 5) and (5 < 6) evaluates to True"@en ; chx:input "(4 < 5) and (5 < 6)" ; chx:output "True" .
chx:X_Ordering rd:hasIOExample chx:IO_Ordering .
chx:X_ChainedComparison a owl:NamedIndividual, chx:ChainedComparison ; rdfs:label "1 < 2 < 3"@en ; skos:definition "Comparisons chain: x < y <= z means x < y and y <= z, with y evaluated once."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_ChainedComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "1 < 2 < 3 evaluates to True"@en ; chx:input "1 < 2 < 3" ; chx:output "True" .
chx:X_ChainedComparison rd:hasIOExample chx:IO_ChainedComparison .
chx:X_AndOperator a owl:NamedIndividual, chx:AndOperator ; rdfs:label "True and False"@en ; skos:definition "and is true only when both operands are true."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_AndOperator a owl:NamedIndividual, rd:IOExample ; rdfs:label "True and False evaluates to False"@en ; chx:input "True and False" ; chx:output "False" .
chx:X_AndOperator rd:hasIOExample chx:IO_AndOperator .
chx:X_OrOperator a owl:NamedIndividual, chx:OrOperator ; rdfs:label "True or False"@en ; skos:definition "or is true when either operand is true."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_OrOperator a owl:NamedIndividual, rd:IOExample ; rdfs:label "True or False evaluates to True"@en ; chx:input "True or False" ; chx:output "True" .
chx:X_OrOperator rd:hasIOExample chx:IO_OrOperator .
chx:X_NotOperator a owl:NamedIndividual, chx:NotOperator ; rdfs:label "not True"@en ; skos:definition "not inverts a single Boolean value."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_NotOperator a owl:NamedIndividual, rd:IOExample ; rdfs:label "not True evaluates to False"@en ; chx:input "not True" ; chx:output "False" .
chx:X_NotOperator rd:hasIOExample chx:IO_NotOperator .
chx:X_ShortCircuit a owl:NamedIndividual, chx:ShortCircuit ; rdfs:label "'' or 'default'"@en ; skos:definition "and and or stop as soon as the answer is known and return an operand, so '' or 'default' returns 'default'."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_ShortCircuit a owl:NamedIndividual, rd:IOExample ; rdfs:label "'' or 'default' evaluates to 'default'"@en ; chx:input "'' or 'default'" ; chx:output "'default'" .
chx:X_ShortCircuit rd:hasIOExample chx:IO_ShortCircuit .
chx:X_Condition a owl:NamedIndividual, chx:Condition ; rdfs:label "the expression after if"@en ; skos:definition "A condition is an expression evaluated for truth to decide which block runs."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:X_Block a owl:NamedIndividual, chx:Block ; rdfs:label "an indented group of lines"@en ; skos:definition "A block is a group of lines at the same indentation; Python uses indentation, not braces, to mark it."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:X_IfStatement a owl:NamedIndividual, chx:IfStatement ; rdfs:label "if name == 'Alice':"@en ; skos:definition "if runs its block only when its condition is true."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:X_ElifClause a owl:NamedIndividual, chx:ElifClause ; rdfs:label "elif age < 12:"@en ; skos:definition "elif tests a further condition only when every earlier one was false; at most one branch runs."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:X_ElseClause a owl:NamedIndividual, chx:ElseClause ; rdfs:label "else:"@en ; skos:definition "else runs its block when no earlier condition in the chain was true."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:X_ConditionalExpression a owl:NamedIndividual, chx:ConditionalExpression ; rdfs:label "'even' if 10 % 2 == 0 else 'odd'"@en ; skos:definition "x if C else y chooses between two values in a single expression."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:IO_ConditionalExpression a owl:NamedIndividual, rd:IOExample ; rdfs:label "'even' if 10 % 2 == 0 else 'odd' evaluates to 'even'"@en ; chx:input "'even' if 10 % 2 == 0 else 'odd'" ; chx:output "'even'" .
chx:X_ConditionalExpression rd:hasIOExample chx:IO_ConditionalExpression .
chx:X_MatchStatement a owl:NamedIndividual, chx:MatchStatement ; rdfs:label "match command:"@en ; skos:definition "Since Python 3.10 a match statement compares a value against successive case patterns - the modern alternative to a long elif chain."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:X_BooleanComparisonStyle a owl:NamedIndividual, chx:BooleanComparisonStyle ; rdfs:label "if greeting: rather than if greeting == True:"@en ; skos:definition "PEP 8 advises testing a Boolean directly instead of comparing it to True or False with ==."@en ; dcterms:source <http://example.org/sen0414/ch02/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 2 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch02/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 2 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which constructs decide which block runs, and on what kind of value?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which concepts reach beyond the 3rd edition into current Python, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 2 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 2 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch02/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-24."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_0_0.py" .

