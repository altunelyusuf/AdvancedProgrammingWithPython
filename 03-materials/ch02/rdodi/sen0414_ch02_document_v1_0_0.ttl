chx:Document a doc:ReportSection ; rdfs:label "Flow control for an advanced course: chapter 2 of the 3rd edition and today's Python"@en ; skos:definition "This document renews chapter 2 of the 3rd edition for an advanced course (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02/research> ;
    doc:hasSection chx:S_Value, chx:S_Comparison, chx:S_BooleanOperation, chx:S_FlowControl, chx:S_ModernPractice .
chx:S_Value a doc:TaxonomicSection ; rdfs:label "Value"@en ; doc:sectionTitle "Value" ; doc:hierarchyLevel 1 ; doc:sectionOrder 1 ;
    skos:definition "Chapter 2 adds a new kind of value, the Boolean, and with it the idea that any value can be tested for truth (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#Value> .
chx:S_TruthValue a doc:TaxonomicSection ; rdfs:label "Truth value"@en ; doc:sectionTitle "Truth value" ; doc:hierarchyLevel 2 ; doc:sectionOrder 2 ;
    doc:hasParentSection chx:S_Value ;
    skos:definition "Truth is the currency of flow control: every decision a program makes reduces to a true or false value (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#TruthValue> .
chx:S_BooleanValue a doc:ConceptSection ; rdfs:label "Boolean value"@en ; doc:sectionTitle "Boolean value" ; doc:hierarchyLevel 3 ; doc:sectionOrder 3 ;
    doc:hasParentSection chx:S_TruthValue ;
    skos:definition "The Boolean values True and False are written with a capital letter, and every comparison produces one, so 42 == 42 evaluates to True (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#BooleanValue> .
chx:S_Truthiness a doc:ConceptSection ; rdfs:label "Truthiness"@en ; doc:sectionTitle "Truthiness" ; doc:hierarchyLevel 3 ; doc:sectionOrder 4 ;
    doc:hasParentSection chx:S_TruthValue ;
    skos:definition "Python tests any value for truth, not only Booleans: None, False, zero of any numeric type and empty sequences are false, so bool('') is False while bool('0') is True (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch02#Truthiness> .
chx:S_Comparison a doc:TaxonomicSection ; rdfs:label "Comparison"@en ; doc:sectionTitle "Comparison" ; doc:hierarchyLevel 1 ; doc:sectionOrder 5 ;
    skos:definition "Comparison operators ask a question about two values and answer with a Boolean value (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#Comparison> .
chx:S_EqualityComparison a doc:TaxonomicSection ; rdfs:label "Equality comparison"@en ; doc:sectionTitle "Equality comparison" ; doc:hierarchyLevel 2 ; doc:sectionOrder 6 ;
    doc:hasParentSection chx:S_Comparison ;
    skos:definition "Equality comparisons ask whether two values are the same, a different question from assignment's single equals sign (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#EqualityComparison> .
chx:S_Equality a doc:ConceptSection ; rdfs:label "Equality"@en ; doc:sectionTitle "Equality" ; doc:hierarchyLevel 3 ; doc:sectionOrder 7 ;
    doc:hasParentSection chx:S_EqualityComparison ;
    skos:definition "The == and != operators compare values, and an integer never equals a string, so 42 == '42' evaluates to False (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#Equality> .
chx:S_OrderingComparison a doc:TaxonomicSection ; rdfs:label "Ordering comparison"@en ; doc:sectionTitle "Ordering comparison" ; doc:hierarchyLevel 2 ; doc:sectionOrder 8 ;
    doc:hasParentSection chx:S_Comparison ;
    skos:definition "Ordering comparisons ask which of two values comes first, and they combine with Boolean operators into longer conditions (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#OrderingComparison> .
chx:S_Ordering a doc:ConceptSection ; rdfs:label "Ordering"@en ; doc:sectionTitle "Ordering" ; doc:hierarchyLevel 3 ; doc:sectionOrder 9 ;
    doc:hasParentSection chx:S_OrderingComparison ;
    skos:definition "The operators <, >, <= and >= compare order, so (4 < 5) and (5 < 6) evaluates to True (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#Ordering> .
chx:S_ChainedComparison a doc:ConceptSection ; rdfs:label "Chained comparison"@en ; doc:sectionTitle "Chained comparison" ; doc:hierarchyLevel 3 ; doc:sectionOrder 10 ;
    doc:hasParentSection chx:S_OrderingComparison ;
    skos:definition "Comparisons chain, so x < y <= z means x < y and y <= z with y evaluated only once; 1 < 2 < 3 evaluates to True (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch02#ChainedComparison> .
chx:S_BooleanOperation a doc:TaxonomicSection ; rdfs:label "Boolean operation"@en ; doc:sectionTitle "Boolean operation" ; doc:hierarchyLevel 1 ; doc:sectionOrder 11 ;
    skos:definition "The Boolean operators and, or and not combine truth values, and the chapter shows them mixed with comparisons in one expression (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#BooleanOperation> .
chx:S_LogicalOperator a doc:TaxonomicSection ; rdfs:label "Logical operator"@en ; doc:sectionTitle "Logical operator" ; doc:hierarchyLevel 2 ; doc:sectionOrder 12 ;
    doc:hasParentSection chx:S_BooleanOperation ;
    skos:definition "Each Boolean operator has a truth table the chapter sets out, and the three together can express any condition a program needs (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#LogicalOperator> .
chx:S_AndOperator a doc:ConceptSection ; rdfs:label "And operator"@en ; doc:sectionTitle "And operator" ; doc:hierarchyLevel 3 ; doc:sectionOrder 13 ;
    doc:hasParentSection chx:S_LogicalOperator ;
    skos:definition "The and operator is true only when both operands are true, so True and False evaluates to False (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#AndOperator> .
chx:S_OrOperator a doc:ConceptSection ; rdfs:label "Or operator"@en ; doc:sectionTitle "Or operator" ; doc:hierarchyLevel 3 ; doc:sectionOrder 14 ;
    doc:hasParentSection chx:S_LogicalOperator ;
    skos:definition "The or operator is true when either operand is true, so True or False evaluates to True (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#OrOperator> .
chx:S_NotOperator a doc:ConceptSection ; rdfs:label "Not operator"@en ; doc:sectionTitle "Not operator" ; doc:hierarchyLevel 3 ; doc:sectionOrder 15 ;
    doc:hasParentSection chx:S_LogicalOperator ;
    skos:definition "The not operator inverts one Boolean value, so not True evaluates to False (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#NotOperator> .
chx:S_Evaluation a doc:TaxonomicSection ; rdfs:label "Evaluation"@en ; doc:sectionTitle "Evaluation" ; doc:hierarchyLevel 2 ; doc:sectionOrder 16 ;
    doc:hasParentSection chx:S_BooleanOperation ;
    skos:definition "How Boolean operators evaluate matters as much as what they return, because the second operand is sometimes never evaluated at all (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch02#Evaluation> .
chx:S_ShortCircuit a doc:ConceptSection ; rdfs:label "Short circuit"@en ; doc:sectionTitle "Short circuit" ; doc:hierarchyLevel 3 ; doc:sectionOrder 17 ;
    doc:hasParentSection chx:S_Evaluation ;
    skos:definition "The and and or operators stop as soon as the answer is known and return one of their operands rather than a Boolean, so '' or 'default' returns 'default' - a common idiom for fallback values (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch02#ShortCircuit> .
chx:S_FlowControl a doc:TaxonomicSection ; rdfs:label "Flow control"@en ; doc:sectionTitle "Flow control" ; doc:hierarchyLevel 1 ; doc:sectionOrder 18 ;
    skos:definition "Flow control decides which lines run and in what order, built from conditions and blocks (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#FlowControl> .
chx:S_ControlStructure a doc:TaxonomicSection ; rdfs:label "Control structure"@en ; doc:sectionTitle "Control structure" ; doc:hierarchyLevel 2 ; doc:sectionOrder 19 ;
    doc:hasParentSection chx:S_FlowControl ;
    skos:definition "The chapter's Components of Flow Control section names the two parts every decision needs: a condition and a block (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#ControlStructure> .
chx:S_Condition a doc:ConceptSection ; rdfs:label "Condition"@en ; doc:sectionTitle "Condition" ; doc:hierarchyLevel 3 ; doc:sectionOrder 20 ;
    doc:hasParentSection chx:S_ControlStructure ;
    skos:definition "A condition is an expression evaluated for its truth value, and it decides which block of code runs next (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#Condition> .
chx:S_Block a doc:ConceptSection ; rdfs:label "Block"@en ; doc:sectionTitle "Block" ; doc:hierarchyLevel 3 ; doc:sectionOrder 21 ;
    doc:hasParentSection chx:S_ControlStructure ;
    skos:definition "A block is a group of lines at the same indentation; Python marks blocks with indentation rather than braces, so indentation is part of the program's meaning (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#Block> .
chx:S_Branching a doc:TaxonomicSection ; rdfs:label "Branching"@en ; doc:sectionTitle "Branching" ; doc:hierarchyLevel 2 ; doc:sectionOrder 22 ;
    doc:hasParentSection chx:S_FlowControl ;
    skos:definition "The Flow Control Statements section builds branches with if, else and elif, as the Opposite Day and Dishonest Capacity Calculator programs show (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#Branching> .
chx:S_IfStatement a doc:ConceptSection ; rdfs:label "If statement"@en ; doc:sectionTitle "If statement" ; doc:hierarchyLevel 3 ; doc:sectionOrder 23 ;
    doc:hasParentSection chx:S_Branching ;
    skos:definition "An if statement runs its block only when its condition is true, and skips it otherwise (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#IfStatement> .
chx:S_ElifClause a doc:ConceptSection ; rdfs:label "Elif clause"@en ; doc:sectionTitle "Elif clause" ; doc:hierarchyLevel 3 ; doc:sectionOrder 24 ;
    doc:hasParentSection chx:S_Branching ;
    skos:definition "An elif clause tests a further condition only when every earlier condition was false, so at most one branch of the chain runs (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#ElifClause> .
chx:S_ElseClause a doc:ConceptSection ; rdfs:label "Else clause"@en ; doc:sectionTitle "Else clause" ; doc:hierarchyLevel 3 ; doc:sectionOrder 25 ;
    doc:hasParentSection chx:S_Branching ;
    skos:definition "An else clause runs its block when no earlier condition in the chain was true (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch02#ElseClause> .
chx:S_ExpressionForm a doc:TaxonomicSection ; rdfs:label "Expression form"@en ; doc:sectionTitle "Expression form" ; doc:hierarchyLevel 2 ; doc:sectionOrder 26 ;
    doc:hasParentSection chx:S_FlowControl ;
    skos:definition "Some decisions choose a value rather than run a block, and Python has an expression form for that case (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch02#ExpressionForm> .
chx:S_ConditionalExpression a doc:ConceptSection ; rdfs:label "Conditional expression"@en ; doc:sectionTitle "Conditional expression" ; doc:hierarchyLevel 3 ; doc:sectionOrder 27 ;
    doc:hasParentSection chx:S_ExpressionForm ;
    skos:definition "The conditional expression x if C else y evaluates the condition first and returns one of two values, so 'even' if 10 % 2 == 0 else 'odd' gives 'even' (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch02#ConditionalExpression> .
chx:S_ModernPractice a doc:TaxonomicSection ; rdfs:label "Modern practice"@en ; doc:sectionTitle "Modern practice" ; doc:hierarchyLevel 1 ; doc:sectionOrder 28 ;
    skos:definition "An advanced course pairs the chapter's if-elif chains with the forms current Python offers for the same decisions (Bucher and Van Rossum, 2020)." ; dcterms:source <http://example.org/sen0414/ch02#ModernPractice> .
chx:S_PatternMatching a doc:TaxonomicSection ; rdfs:label "Pattern matching"@en ; doc:sectionTitle "Pattern matching" ; doc:hierarchyLevel 2 ; doc:sectionOrder 29 ;
    doc:hasParentSection chx:S_ModernPractice ;
    skos:definition "Pattern matching tests a value's shape as well as its value, which elif chains can only imitate (Bucher and Van Rossum, 2020)." ; dcterms:source <http://example.org/sen0414/ch02#PatternMatching> .
chx:S_MatchStatement a doc:ConceptSection ; rdfs:label "Match statement"@en ; doc:sectionTitle "Match statement" ; doc:hierarchyLevel 3 ; doc:sectionOrder 30 ;
    doc:hasParentSection chx:S_PatternMatching ;
    skos:definition "Since Python 3.10 a match statement compares a value against successive case patterns - closer to pattern matching than to the switch statement of C or Java - and replaces long elif chains (Bucher and Van Rossum, 2020)." ; dcterms:source <http://example.org/sen0414/ch02#MatchStatement> .
chx:S_Style a doc:TaxonomicSection ; rdfs:label "Style"@en ; doc:sectionTitle "Style" ; doc:hierarchyLevel 2 ; doc:sectionOrder 31 ;
    doc:hasParentSection chx:S_ModernPractice ;
    skos:definition "Style guidance keeps conditions readable, and the conventions for Boolean tests are among the most often broken (Van Rossum et al., 2001)." ; dcterms:source <http://example.org/sen0414/ch02#Style> .
chx:S_BooleanComparisonStyle a doc:ConceptSection ; rdfs:label "Boolean comparison style"@en ; doc:sectionTitle "Boolean comparison style" ; doc:hierarchyLevel 3 ; doc:sectionOrder 32 ;
    doc:hasParentSection chx:S_Style ;
    skos:definition "PEP 8 advises testing a Boolean directly - if greeting: - instead of comparing it to True with == (Van Rossum et al., 2001); Python 3.14 also tightened flow control by adopting PEP 765, which disallows return, break and continue that exit a finally block (Katriel and Coghlan, 2024)." ; dcterms:source <http://example.org/sen0414/ch02#BooleanComparisonStyle> .
