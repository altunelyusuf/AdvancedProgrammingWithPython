pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Chapter 2 interactive page"@en ;
    dcterms:source <http://example.org/sen0414/ch02/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 ;
    sen0414:navigationRule "BP-D34: 32 sections falls in 26-50, so a grouped permanent top bar with a sub-section sidebar; the named single flowing anchor-page variation of procedure v1.6.0 section 5.3." ;
    sen0414:pythonUsed "Python 3.14.4" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Sidebar and main content"@en .
pg:Header a ipo:Header ; rdfs:label "Sticky header with grouped section bar"@en .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Section tree"@en .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Grouped permanent top bar"@en .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 2 Stage 3 document"@en ; dcterms:source <http://example.org/sen0414/ch02/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Predict the truth value of comparisons and Boolean expressions, including the truthiness of non-Boolean values"@en ; ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain short-circuit evaluation and use and and or to supply fallback values"@en ; ld:bloomLevel ld:Understand  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Write decisions with if, elif and else, and with the conditional expression"@en ; ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Choose between an elif chain and a match statement for a given decision"@en ; ld:bloomLevel ld:Analyze  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does 42 == '42' evaluate to?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "An integer never equals a string, even one with the same digits." ; ld:distractorRationale "== between different types is allowed; it simply answers False." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "False" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "True" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "It raises a TypeError" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does bool('0') evaluate to?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Only the empty string is false; '0' is a non-empty string." ; ld:distractorRationale "bool always returns True or False, never the original value." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "True" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "False" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "0" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does '' or 'default' return?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "or returns one of its operands, not a Boolean." ; ld:distractorRationale "The empty string is false, so or moves on to the second operand." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "'default'" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "True" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "''" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "In an if-elif-else chain, how many branches can run?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "Separate if statements would test every condition; elif stops at the first true one." ; ld:distractorRationale "Nothing forces two; with no true condition and no else, none runs." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "At most one" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "All whose conditions are true" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "Exactly two" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "When is a match statement the better choice over an elif chain?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "A single condition is clearest as a plain if." ; ld:distractorRationale "match has existed since Python 3.10." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "When one value is compared against many possible shapes or values" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "When there is a single yes-or-no condition" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "Never; match is only for Python 3.14" .
