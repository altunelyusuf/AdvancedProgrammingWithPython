pg:w_BooleanValue a ipo:InstructionalWidget, ipo:CoupledVariableDemonstrator ; rdfs:label "predict widget for BooleanValue"@en ;
    skos:definition "The widget for Boolean value lets the reader edit the expression 42 == 42, predict its value and run it, and the value it prints is the value on the concept card."@en ; dcterms:source <http://example.org/sen0414/ch02#S_BooleanValue> ; dcterms:isPartOf pg:BooleanValue ;
    ipo:demonstratesSubject <http://example.org/sen0414/ch02#BooleanValue> ;
    ipo:enforcesDomainConstraint <http://example.org/sen0414/ch02#BooleanValue> ;
    mp:numericModelStatus mp:Validated ; mp:hasValidationDerivation "The value of the expression was produced by executing it under Python 3.14.6, and the page test requires the value the widget prints to equal the value on the concept card" ; mp:hasConformanceTest "The browser design test requires the printed value to equal the executed one" ;
    wp:instantiatesPrimitive wp:Primitive_CoupledVariableExplorer ; ds:selectionWarrant "Feature_AsymmetricContrast: the learner edits and predicts 42 == 42, then Pyodide shows what Python actually does" ;
