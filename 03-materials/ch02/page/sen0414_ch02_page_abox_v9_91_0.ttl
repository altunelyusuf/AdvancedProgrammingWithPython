pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Predict the truth value of comparisons and Boolean expressions, including the truthiness of non-Boolean values"@en ;
    skos:definition "The objective is met when the reader can predict the truth value of comparisons and Boolean expressions, including the truthiness of non-Boolean values, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter2.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain short-circuit evaluation and use and and or to supply fallback values"@en ;
    skos:definition "The objective is met when the reader can explain short-circuit evaluation and use and and or to supply fallback values, at the understand level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter2.html> ;
    ld:bloomLevel ld:Understand  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Write decisions with if, elif and else, and with the conditional expression"@en ;
    skos:definition "The objective is met when the reader can write decisions with if, elif and else, and with the conditional expression, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter2.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Choose between an elif chain and a match statement for a given decision"@en ;
    skos:definition "The objective is met when the reader can choose between an elif chain and a match statement for a given decision, at the analyze level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter2.html> ;
    ld:bloomLevel ld:Analyze  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does 42 == '42' evaluate to?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "An integer never equals a string, even one with the same digits." ;
    ld:distractorRationale "== between different types is allowed; it simply answers False." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "False" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "True" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "It raises a TypeError" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does bool('0') evaluate to?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Only the empty string is false; '0' is a non-empty string." ;
    ld:distractorRationale "bool always returns True or False, never the original value." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "True" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "False" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "0" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does '' or 'default' return?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "or returns one of its operands, not a Boolean." ;
    ld:distractorRationale "The empty string is false, so or moves on to the second operand." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "'default'" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "True" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "''" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "In an if-elif-else chain, how many branches can run?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "Separate if statements would test every condition; elif stops at the first true one." ;
    ld:distractorRationale "Nothing forces two; with no true condition and no else, none runs." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "At most one" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "All whose conditions are true" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "Exactly two" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "When is a match statement the better choice over an elif chain?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "A single condition is clearest as a plain if." ;
    ld:distractorRationale "match has existed since Python 3.10." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "When one value is compared against many possible shapes or values" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "When there is a single yes-or-no condition" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "Never; match is only for Python 3.14" .
pg:Value a ipo:ChapterSection ; rdfs:label "Value"@en ;
    skos:definition "Chapter 1 introduced the value as a piece of data that a program can compute with, and it named three kinds of value: integers, floating-point numbers and strings. Chapter 2 adds a fourth kind, the Boolean value, which has only two members, True and False, and which answers a yes-or-no question (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Value> ;
    sen0414:anchor "#s-Value" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Value .
pg:TruthValue a ipo:ChapterSection ; rdfs:label "Truth value"@en ;
    skos:definition "Truth values are the values that answer a yes-or-no question. They include the two Boolean values True and False, the special value None that stands for the absence of a value, and the rule by which every other value can also be read as true or false."@en ; dcterms:source <http://example.org/sen0414/ch02#S_TruthValue> ;
    sen0414:anchor "#s-TruthValue" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Value .
pg:Page ipo:coversChapterSection pg:TruthValue .
pg:BooleanValue a ipo:ChapterSection ; rdfs:label "Boolean value"@en ;
    skos:definition "A Boolean value is a value of the data type bool, and that type has exactly two members, True and False. Where the integer, floating-point and string types have an unlimited number of possible values, the Boolean type has only these two (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_BooleanValue> ;
    sen0414:anchor "#s-BooleanValue" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TruthValue .
pg:Page ipo:coversChapterSection pg:BooleanValue .
pg:Truthiness a ipo:ChapterSection ; rdfs:label "Truthiness"@en ;
    skos:definition "Truthiness is the property of every Python value of being counted as true or as false when a Boolean value is needed. The documentation states the principle directly: any object can be tested for truth value, for use in a condition or as an operand of the Boolean operations (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Truthiness> ;
    sen0414:anchor "#s-Truthiness" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TruthValue .
pg:Page ipo:coversChapterSection pg:Truthiness .
pg:NoneValue a ipo:ChapterSection ; rdfs:label "None value"@en ;
    skos:definition "None is a built-in value that represents the absence of a value. The documentation describes it as an object frequently used to represent the absence of a value, and as the sole instance of the type NoneType, which means that it is the only object of that type (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_NoneValue> ;
    sen0414:anchor "#s-NoneValue" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TruthValue .
pg:Page ipo:coversChapterSection pg:NoneValue .
pg:Container a ipo:ChapterSection ; rdfs:label "Sequence and collection"@en ;
    skos:definition "A sequence is an ordered group of items that can be reached by position and that has a length. The string of Chapter 1 is a sequence of characters, and the glossary names list, str, tuple and bytes (a sequence of byte values) as the built-in sequence types (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Container> ;
    sen0414:anchor "#s-Container" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TruthValue .
pg:Page ipo:coversChapterSection pg:Container .
pg:Comparison a ipo:ChapterSection ; rdfs:label "Comparison"@en ;
    skos:definition "A comparison is an expression that asks a question about two values and answers with a Boolean value. The textbook calls the operators that write such questions comparison operators or, by a second name, relational operators, and it lists six of them: ==, !=, <, >, <= and >= (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Comparison> ;
    sen0414:anchor "#s-Comparison" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Comparison .
pg:EqualityComparison a ipo:ChapterSection ; rdfs:label "Equality comparison"@en ;
    skos:definition "Equality comparisons ask whether two values are the same. The two operators for the purpose are == and !=, which compare the values of their operands, and the identity operators is and is not, which ask the different question of whether two expressions refer to one and the same object (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_EqualityComparison> ;
    sen0414:anchor "#s-EqualityComparison" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Comparison .
pg:Page ipo:coversChapterSection pg:EqualityComparison .
pg:Equality a ipo:ChapterSection ; rdfs:label "Equality"@en ;
    skos:definition "The equality operators compare two values. The operator == (equal to) evaluates to True when the values on both sides are the same, and the operator != (not equal to) evaluates to True when the two values are different (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Equality> ;
    sen0414:anchor "#s-Equality" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:EqualityComparison .
pg:Page ipo:coversChapterSection pg:Equality .
pg:EqualsVersusAssign a ipo:ChapterSection ; rdfs:label "Equality versus assignment"@en ;
    skos:definition "The symbols == and = look alike and do entirely different things. The textbook states the difference in two sentences: the == operator asks whether two values are the same as each other, and the = operator puts the value on the right into the variable on the left (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_EqualsVersusAssign> ;
    sen0414:anchor "#s-EqualsVersusAssign" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:EqualityComparison .
pg:Page ipo:coversChapterSection pg:EqualsVersusAssign .
pg:IdentityComparison a ipo:ChapterSection ; rdfs:label "Identity comparison"@en ;
    skos:definition "An identity comparison asks whether two expressions refer to one and the same object, not merely to equal values. The operator is evaluates to True for the same object and is not evaluates to True for different objects; the documentation lists them as object identity and negated object identity (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_IdentityComparison> ;
    sen0414:anchor "#s-IdentityComparison" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:EqualityComparison .
pg:Page ipo:coversChapterSection pg:IdentityComparison .
pg:OrderingComparison a ipo:ChapterSection ; rdfs:label "Ordering comparison"@en ;
    skos:definition "Ordering comparisons ask which of two values comes first. The four operators are < (less than), > (greater than), <= (less than or equal to) and >= (greater than or equal to) (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_OrderingComparison> ;
    sen0414:anchor "#s-OrderingComparison" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Comparison .
pg:Page ipo:coversChapterSection pg:OrderingComparison .
pg:Ordering a ipo:ChapterSection ; rdfs:label "Ordering"@en ;
    skos:definition "The ordering operators compare two values by size. The operator < is true when the first value is smaller, > when it is larger, <= when it is smaller or equal, and >= when it is larger or equal (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Ordering> ;
    sen0414:anchor "#s-Ordering" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OrderingComparison .
pg:Page ipo:coversChapterSection pg:Ordering .
pg:ChainedComparison a ipo:ChapterSection ; rdfs:label "Chained comparison"@en ;
    skos:definition "A chained comparison joins several comparison operators in one expression, so that x < y <= z asks both questions at once. The reference documentation defines it as equivalent to x < y and y <= z, except that y is evaluated only once (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ChainedComparison> ;
    sen0414:anchor "#s-ChainedComparison" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OrderingComparison .
pg:Page ipo:coversChapterSection pg:ChainedComparison .
pg:StringOrdering a ipo:ChapterSection ; rdfs:label "String ordering"@en ;
    skos:definition "String ordering is the use of <, >, <= and >= on text. The reference documentation says that strings compare lexicographically, that is, character by character from the left as in a dictionary, using the numerical Unicode code points of their characters (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_StringOrdering> ;
    sen0414:anchor "#s-StringOrdering" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OrderingComparison .
pg:Page ipo:coversChapterSection pg:StringOrdering .
pg:BooleanOperation a ipo:ChapterSection ; rdfs:label "Boolean operation"@en ;
    skos:definition "Boolean operations combine truth values into new truth values. Python has three Boolean operators, and, or and not."@en ; dcterms:source <http://example.org/sen0414/ch02#S_BooleanOperation> ;
    sen0414:anchor "#s-BooleanOperation" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:BooleanOperation .
pg:LogicalOperator a ipo:ChapterSection ; rdfs:label "Logical operator"@en ;
    skos:definition "The logical operators are and, or and not. The first two join two truth values, and the third reverses one."@en ; dcterms:source <http://example.org/sen0414/ch02#S_LogicalOperator> ;
    sen0414:anchor "#s-LogicalOperator" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BooleanOperation .
pg:Page ipo:coversChapterSection pg:LogicalOperator .
pg:AndOperator a ipo:ChapterSection ; rdfs:label "And operator"@en ;
    skos:definition "The and operator joins two Boolean values or expressions and evaluates to True only if both of them are True; otherwise it evaluates to False (Sweigart, 2025). Because it always takes two operands, the textbook calls it a binary Boolean operator."@en ; dcterms:source <http://example.org/sen0414/ch02#S_AndOperator> ;
    sen0414:anchor "#s-AndOperator" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LogicalOperator .
pg:Page ipo:coversChapterSection pg:AndOperator .
pg:OrOperator a ipo:ChapterSection ; rdfs:label "Or operator"@en ;
    skos:definition "The or operator joins two Boolean values or expressions and evaluates to True if either of them is True. Only when both are False does it evaluate to False (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_OrOperator> ;
    sen0414:anchor "#s-OrOperator" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LogicalOperator .
pg:Page ipo:coversChapterSection pg:OrOperator .
pg:NotOperator a ipo:ChapterSection ; rdfs:label "Not operator"@en ;
    skos:definition "The not operator reverses a truth value. Unlike and and or, it operates on only one Boolean value or expression, which makes it a unary operator, and it evaluates to the opposite Boolean value (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_NotOperator> ;
    sen0414:anchor "#s-NotOperator" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LogicalOperator .
pg:Page ipo:coversChapterSection pg:NotOperator .
pg:OperatorArity a ipo:ChapterSection ; rdfs:label "Binary and unary operators"@en ;
    skos:definition "The arity of an operator is the number of operands that it takes. A binary operator takes two, one on each side, and a unary operator takes one."@en ; dcterms:source <http://example.org/sen0414/ch02#S_OperatorArity> ;
    sen0414:anchor "#s-OperatorArity" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LogicalOperator .
pg:Page ipo:coversChapterSection pg:OperatorArity .
pg:TruthTable a ipo:ChapterSection ; rdfs:label "Truth table"@en ;
    skos:definition "A truth table shows every possible result of a Boolean operator (Sweigart, 2025). Each row lists one combination of values for the operands and the value to which the operator evaluates for that combination."@en ; dcterms:source <http://example.org/sen0414/ch02#S_TruthTable> ;
    sen0414:anchor "#s-TruthTable" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LogicalOperator .
pg:Page ipo:coversChapterSection pg:TruthTable .
pg:Evaluation a ipo:ChapterSection ; rdfs:label "Evaluation"@en ;
    skos:definition "Evaluation is the process by which Python works out the value of an expression (Python Software Foundation, 2026). For compound Boolean expressions it follows four rules that this branch explains: the operands are evaluated from left to right and evaluation stops as soon as the answer is known, the result can be one of the operands, comparisons and Boolean operators can be mixed freely, and the three Boolean operators have a fixed order of priority."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Evaluation> ;
    sen0414:anchor "#s-Evaluation" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BooleanOperation .
pg:Page ipo:coversChapterSection pg:Evaluation .
pg:ShortCircuit a ipo:ChapterSection ; rdfs:label "Short circuit"@en ;
    skos:definition "Short-circuit evaluation means that the operators and and or evaluate their second operand only when the first operand has not already decided the result. The documentation states it in two notes: or only evaluates the second argument if the first one is false, and and only evaluates the second argument if the first one is true (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ShortCircuit> ;
    sen0414:anchor "#s-ShortCircuit" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Evaluation .
pg:Page ipo:coversChapterSection pg:ShortCircuit .
pg:OperandResult a ipo:ChapterSection ; rdfs:label "Operand result"@en ;
    skos:definition "The result of and and or is one of their operands. The reference documentation says that neither operator restricts the value and type it returns to False and True, but rather returns the last evaluated argument (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_OperandResult> ;
    sen0414:anchor "#s-OperandResult" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Evaluation .
pg:Page ipo:coversChapterSection pg:OperandResult .
pg:BooleanExpression a ipo:ChapterSection ; rdfs:label "Boolean expression"@en ;
    skos:definition "A Boolean expression is an expression whose value is True or False, built from comparisons and Boolean operators. The textbook explains that an expression such as 4 < 5 is not itself a Boolean value, but it is an expression that evaluates down to one, so comparison operators can be used inside expressions with the Boolean operators (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_BooleanExpression> ;
    sen0414:anchor "#s-BooleanExpression" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Evaluation .
pg:Page ipo:coversChapterSection pg:BooleanExpression .
pg:BooleanPrecedence a ipo:ChapterSection ; rdfs:label "Boolean precedence"@en ;
    skos:definition "Boolean precedence is the order in which a Python expression applies not, and and or when it contains several of them. The Boolean operators have an order of operations just like the math operators do: after any math and comparison operators evaluate, Python evaluates the not operators first, then the and operators, and then the or operators (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_BooleanPrecedence> ;
    sen0414:anchor "#s-BooleanPrecedence" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Evaluation .
pg:Page ipo:coversChapterSection pg:BooleanPrecedence .
pg:FlowControl a ipo:ChapterSection ; rdfs:label "Flow control"@en ;
    skos:definition "Flow control is the part of a program that decides which instructions run, in what order and how often. The textbook puts it plainly: based on how expressions evaluate, a program can decide to skip instructions, repeat them, or choose one of several instructions to run, and flow control statements decide which Python instructions to execute under which conditions (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_FlowControl> ;
    sen0414:anchor "#s-FlowControl" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:FlowControl .
pg:ExecutionFlow a ipo:ChapterSection ; rdfs:label "Execution flow"@en ;
    skos:definition "Execution flow is the path that execution takes through a program: which statement runs first, which runs next and which are skipped. Three ideas belong to it."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ExecutionFlow> ;
    sen0414:anchor "#s-ExecutionFlow" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:FlowControl .
pg:Page ipo:coversChapterSection pg:ExecutionFlow .
pg:FlowControlStatement a ipo:ChapterSection ; rdfs:label "Flow control statement"@en ;
    skos:definition "A statement is the unit of a program that Python executes. The glossary defines it as part of a suite, a block of code, and as either an expression or one of several constructs with a keyword, such as if, while or for (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_FlowControlStatement> ;
    sen0414:anchor "#s-FlowControlStatement" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExecutionFlow .
pg:Page ipo:coversChapterSection pg:FlowControlStatement .
pg:ProgramExecution a ipo:ChapterSection ; rdfs:label "Program execution"@en ;
    skos:definition "Program execution, or simply execution, is a term for the current instruction being executed (Sweigart, 2025). It is not a property of the text of a program but of a particular run: the same program can follow different paths on different occasions."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ProgramExecution> ;
    sen0414:anchor "#s-ProgramExecution" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExecutionFlow .
pg:Page ipo:coversChapterSection pg:ProgramExecution .
pg:Flowchart a ipo:ChapterSection ; rdfs:label "Flowchart"@en ;
    skos:definition "A flowchart is a diagram of the steps of a process and the decisions between them. The textbook states that flow control statements directly correspond to the symbols in a flowchart, and it draws a flowchart for every statement that it introduces (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Flowchart> ;
    sen0414:anchor "#s-Flowchart" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExecutionFlow .
pg:Page ipo:coversChapterSection pg:Flowchart .
pg:ControlStructure a ipo:ChapterSection ; rdfs:label "Control structure"@en ;
    skos:definition "A control structure is the set of parts out of which a flow control statement is built. A statement of this kind starts with a keyword and a condition, ends its first line with a colon, and is followed by a block of indented lines, which is called its clause (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ControlStructure> ;
    sen0414:anchor "#s-ControlStructure" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:FlowControl .
pg:Page ipo:coversChapterSection pg:ControlStructure .
pg:Condition a ipo:ChapterSection ; rdfs:label "Condition"@en ;
    skos:definition "A condition is an expression that a flow control statement evaluates to decide what to do. The textbook explains that the Boolean expressions seen so far could all be considered conditions, which are the same thing as expressions; condition is just a more specific name in the context of flow control statements (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Condition> ;
    sen0414:anchor "#s-Condition" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ControlStructure .
pg:Page ipo:coversChapterSection pg:Condition .
pg:Block a ipo:ChapterSection ; rdfs:label "Block"@en ;
    skos:definition "A block is a group of lines of code that are treated together. The textbook explains that lines of Python code can be grouped together in blocks, and that you can tell when a block begins and ends from the indentation of the lines of code (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Block> ;
    sen0414:anchor "#s-Block" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ControlStructure .
pg:Page ipo:coversChapterSection pg:Block .
pg:Indentation a ipo:ChapterSection ; rdfs:label "Indentation"@en ;
    skos:definition "Indentation is the whitespace at the beginning of a line of code. The language reference says that leading whitespace at the beginning of a logical line (one statement, even when it is written over several physical lines) is used to compute the indentation level of the line, which in turn is used to determine the grouping of statements (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Indentation> ;
    sen0414:anchor "#s-Indentation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ControlStructure .
pg:Page ipo:coversChapterSection pg:Indentation .
pg:Clause a ipo:ChapterSection ; rdfs:label "Clause"@en ;
    skos:definition "A clause is one part of a compound statement. In the textbook's wording, flow control statements are always followed by a block of code called the clause; the block after an if statement is the if clause, and the block after else is the else clause (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Clause> ;
    sen0414:anchor "#s-Clause" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ControlStructure .
pg:Page ipo:coversChapterSection pg:Clause .
pg:Keyword a ipo:ChapterSection ; rdfs:label "Keyword"@en ;
    skos:definition "A keyword is a word that the language reserves for its own use. The language reference states that keywords cannot be used as ordinary identifiers, and that they must be spelled exactly as written; its list includes False, None, True, and, or, not, if, elif and else (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Keyword> ;
    sen0414:anchor "#s-Keyword" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ControlStructure .
pg:Page ipo:coversChapterSection pg:Keyword .
pg:Branching a ipo:ChapterSection ; rdfs:label "Branching"@en ;
    skos:definition "Branching is the choice between alternative blocks of code. In Python it is done with the if statement and with the elif and else clauses that may follow it."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Branching> ;
    sen0414:anchor "#s-Branching" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:FlowControl .
pg:Page ipo:coversChapterSection pg:Branching .
pg:IfStatement a ipo:ChapterSection ; rdfs:label "If statement"@en ;
    skos:definition "The if statement is the most common flow control statement. Its block, the if clause, executes when the condition of the statement is True, and the block is skipped when the condition is False (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_IfStatement> ;
    sen0414:anchor "#s-IfStatement" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Branching .
pg:Page ipo:coversChapterSection pg:IfStatement .
pg:ElifClause a ipo:ChapterSection ; rdfs:label "Elif clause"@en ;
    skos:definition "The elif clause is an else-if clause. It always follows an if statement or another elif clause, and it provides another condition that is checked only if all of the previous conditions were False (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ElifClause> ;
    sen0414:anchor "#s-ElifClause" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Branching .
pg:Page ipo:coversChapterSection pg:ElifClause .
pg:ElseClause a ipo:ChapterSection ; rdfs:label "Else clause"@en ;
    skos:definition "The else clause is the part of an if statement that runs when nothing else has. An if clause can optionally be followed by an else statement, and the else clause is executed only when the condition of the if statement is False (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ElseClause> ;
    sen0414:anchor "#s-ElseClause" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Branching .
pg:Page ipo:coversChapterSection pg:ElseClause .
pg:BranchChain a ipo:ChapterSection ; rdfs:label "Branch chain"@en ;
    skos:definition "A branch chain is an if statement together with the elif clauses and the else clause that follow it. The textbook states two rules for putting them together: there is always exactly one if statement, with any elif statements following it, and if you want to be sure that at least one clause is executed, you close the structure with an else statement (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_BranchChain> ;
    sen0414:anchor "#s-BranchChain" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Branching .
pg:Page ipo:coversChapterSection pg:BranchChain .
pg:ExpressionForm a ipo:ChapterSection ; rdfs:label "Expression form"@en ;
    skos:definition "An expression form is a construct that brings a choice or a naming into a single expression, so that it has a value and can be used inside larger expressions. The chapter has two: the conditional expression, which chooses between two values, and the assignment expression, which gives a name to a value while it is being used."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ExpressionForm> ;
    sen0414:anchor "#s-ExpressionForm" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:FlowControl .
pg:Page ipo:coversChapterSection pg:ExpressionForm .
pg:ConditionalExpression a ipo:ChapterSection ; rdfs:label "Conditional expression"@en ;
    skos:definition "A conditional expression, sometimes called a ternary operator because it combines three operands, is an alternative to the if-else statement. Because it is an expression, it returns a value and can appear as a sub-expression (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ConditionalExpression> ;
    sen0414:anchor "#s-ConditionalExpression" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExpressionForm .
pg:Page ipo:coversChapterSection pg:ConditionalExpression .
pg:AssignmentExpression a ipo:ChapterSection ; rdfs:label "Assignment expression"@en ;
    skos:definition "An assignment expression, also called a named expression or, informally, the walrus operator (the symbol := looks like the eyes and tusks of a walrus), assigns an expression to an identifier while also returning the value of the expression (Python Software Foundation, 2026). It is written with the operator :=."@en ; dcterms:source <http://example.org/sen0414/ch02#S_AssignmentExpression> ;
    sen0414:anchor "#s-AssignmentExpression" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExpressionForm .
pg:Page ipo:coversChapterSection pg:AssignmentExpression .
pg:ModernPractice a ipo:ChapterSection ; rdfs:label "Modern practice"@en ;
    skos:definition "Modern practice is the way Python programmers work today: the constructs that current Python offers beyond the textbook and the conventions that experienced developers follow when they write conditions. An advanced course teaches this practice next to the basics of the book, so that students do not have to unlearn habits later."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ModernPractice> ;
    sen0414:anchor "#s-ModernPractice" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:ModernPractice .
pg:PatternMatching a ipo:ChapterSection ; rdfs:label "Pattern matching"@en ;
    skos:definition "Pattern matching is a way of choosing between alternatives by comparing a value with patterns that describe its shape. Python 3.10 added it as the match statement, specified in PEP 634 and explained for learners in PEP 636 (Bucher and van Rossum, 2020) (Moisset, 2020)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_PatternMatching> ;
    sen0414:anchor "#s-PatternMatching" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ModernPractice .
pg:Page ipo:coversChapterSection pg:PatternMatching .
pg:MatchStatement a ipo:ChapterSection ; rdfs:label "Match statement"@en ;
    skos:definition "A match statement takes an expression and compares its value with successive patterns given as one or more case blocks. The tutorial says that this is superficially similar to a switch statement in C, Java or JavaScript, but more similar to pattern matching in languages like Rust or Haskell (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_MatchStatement> ;
    sen0414:anchor "#s-MatchStatement" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PatternMatching .
pg:Page ipo:coversChapterSection pg:MatchStatement .
pg:CasePattern a ipo:ChapterSection ; rdfs:label "Case pattern"@en ;
    skos:definition "A case pattern is the description that follows the word case. According to the reference documentation, pattern matching takes a pattern as input, following case, and a subject value, following match; the pattern, which may contain subpatterns (patterns inside a pattern), is matched against the subject value, and the outcome is a success or a failure and possibly the binding of matched values to names (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_CasePattern> ;
    sen0414:anchor "#s-CasePattern" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PatternMatching .
pg:Page ipo:coversChapterSection pg:CasePattern .
pg:WildcardPattern a ipo:ChapterSection ; rdfs:label "Wildcard pattern"@en ;
    skos:definition "The wildcard pattern is written with a single underscore. The reference documentation says that a wildcard pattern always succeeds, matching anything, and binds no name (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_WildcardPattern> ;
    sen0414:anchor "#s-WildcardPattern" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PatternMatching .
pg:Page ipo:coversChapterSection pg:WildcardPattern .
pg:SequencePattern a ipo:ChapterSection ; rdfs:label "Sequence pattern"@en ;
    skos:definition "A sequence pattern describes a sequence by listing patterns for its items. The reference documentation states that it contains several subpatterns to be matched against sequence elements, and that the syntax is similar to the unpacking of a list or tuple, that is, the assignment of its items to several names in one statement; there is no difference whether parentheses or square brackets are used (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_SequencePattern> ;
    sen0414:anchor "#s-SequencePattern" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PatternMatching .
pg:Page ipo:coversChapterSection pg:SequencePattern .
pg:Guard a ipo:ChapterSection ; rdfs:label "Guard"@en ;
    skos:definition "A guard is an extra condition that is attached to a case. It takes the form of the word if followed by an expression, and the reference documentation says that it must succeed for the code inside the case block to execute (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Guard> ;
    sen0414:anchor "#s-Guard" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PatternMatching .
pg:Page ipo:coversChapterSection pg:Guard .
pg:SoftKeyword a ipo:ChapterSection ; rdfs:label "Soft keyword"@en ;
    skos:definition "A soft keyword is a name that is reserved only in specific contexts. The language reference lists match, case and _ as soft keywords when they are used in the match statement, and it adds that the distinction is made by the parser and not when the text is split into tokens (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_SoftKeyword> ;
    sen0414:anchor "#s-SoftKeyword" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PatternMatching .
pg:Page ipo:coversChapterSection pg:SoftKeyword .
pg:Style a ipo:ChapterSection ; rdfs:label "Style"@en ;
    skos:definition "Style is the set of conventions for writing code that other people can read easily. For Python the main reference is PEP 8, the style guide for Python code, written by Guido van Rossum, Barry Warsaw and Alyssa Coghlan (Van Rossum et al., 2001)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Style> ;
    sen0414:anchor "#s-Style" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ModernPractice .
pg:Page ipo:coversChapterSection pg:Style .
pg:BooleanComparisonStyle a ipo:ChapterSection ; rdfs:label "Boolean comparison style"@en ;
    skos:definition "PEP 8 recommends that a Boolean value not be compared to True or False with the equality operator. Its example reads: correct is if greeting:, wrong is if greeting == True:, and the form if greeting is True: is called worse (Van Rossum et al., 2001)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_BooleanComparisonStyle> ;
    sen0414:anchor "#s-BooleanComparisonStyle" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Style .
pg:Page ipo:coversChapterSection pg:BooleanComparisonStyle .
pg:SingletonComparison a ipo:ChapterSection ; rdfs:label "Singleton comparison"@en ;
    skos:definition "The style guide says that comparisons to singletons like None should always be done with is or is not, never the equality operators (Van Rossum et al., 2001). The reference documentation repeats the advice when it describes None as a singleton (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_SingletonComparison> ;
    sen0414:anchor "#s-SingletonComparison" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Style .
pg:Page ipo:coversChapterSection pg:SingletonComparison .
pg:EmptinessTest a ipo:ChapterSection ; rdfs:label "Emptiness test"@en ;
    skos:definition "PEP 8 advises that, for sequences such as strings, lists and tuples, the program should use the fact that empty sequences are false. Its example shows if not seq: and if seq: as correct and if len(seq): and if not len(seq): as wrong (Van Rossum et al., 2001)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_EmptinessTest> ;
    sen0414:anchor "#s-EmptinessTest" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Style .
pg:Page ipo:coversChapterSection pg:EmptinessTest .
pg:IndentationStyle a ipo:ChapterSection ; rdfs:label "Indentation style"@en ;
    skos:definition "The style guide's rules about indentation are short. It says to use four spaces per indentation level, that spaces are the preferred indentation method, that tabs should be used solely to remain consistent with code that is already indented with tabs, and that Python disallows mixing tabs and spaces for indentation (Van Rossum et al., 2001)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_IndentationStyle> ;
    sen0414:anchor "#s-IndentationStyle" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Style .
pg:Page ipo:coversChapterSection pg:IndentationStyle .
pg:WorkedProgram a ipo:ChapterSection ; rdfs:label "Worked program"@en ;
    skos:definition "A worked program is a complete short program in which the ideas of a chapter are used together. Chapter 2 ends with two of them."@en ; dcterms:source <http://example.org/sen0414/ch02#S_WorkedProgram> ;
    sen0414:anchor "#s-WorkedProgram" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:WorkedProgram .
pg:DecisionPattern a ipo:ChapterSection ; rdfs:label "Decision pattern"@en ;
    skos:definition "A decision pattern is a way of using the flow control statements that recurs in many programs. The two worked programs of the textbook (Sweigart, 2025) contain four: the toggle, which reverses a Boolean variable; the case-insensitive test, which accepts several spellings of one answer; the unassigned name, which is a bug that appears when no branch runs; and the input guard, which is the cure for that bug."@en ; dcterms:source <http://example.org/sen0414/ch02#S_DecisionPattern> ;
    sen0414:anchor "#s-DecisionPattern" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:WorkedProgram .
pg:Page ipo:coversChapterSection pg:DecisionPattern .
pg:Toggle a ipo:ChapterSection ; rdfs:label "Toggle"@en ;
    skos:definition "To toggle a Boolean variable is to set it to its opposite Boolean value (Sweigart, 2025). In Python the idiom assigns the negation of the variable to the variable itself: flag = not flag."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Toggle> ;
    sen0414:anchor "#s-Toggle" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:DecisionPattern .
pg:Page ipo:coversChapterSection pg:Toggle .
pg:CaseInsensitiveTest a ipo:ChapterSection ; rdfs:label "Case-insensitive test"@en ;
    skos:definition "A case-insensitive test is a condition that accepts an answer whether it is typed in uppercase or in lowercase. The textbook builds it from the Boolean operator or: the if and elif statements of the Dishonest Capacity Calculator use or so that the program works no matter whether the user enters the unit in lowercase or uppercase (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_CaseInsensitiveTest> ;
    sen0414:anchor "#s-CaseInsensitiveTest" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:DecisionPattern .
pg:Page ipo:coversChapterSection pg:CaseInsensitiveTest .
pg:UnassignedName a ipo:ChapterSection ; rdfs:label "Unassigned name"@en ;
    skos:definition "An unassigned name is a variable that the program uses without any assignment to it having been executed. In the Dishonest Capacity Calculator the variable discrepancy is assigned inside the if clause and the elif clause only."@en ; dcterms:source <http://example.org/sen0414/ch02#S_UnassignedName> ;
    sen0414:anchor "#s-UnassignedName" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:DecisionPattern .
pg:Page ipo:coversChapterSection pg:UnassignedName .
pg:InputGuard a ipo:ChapterSection ; rdfs:label "Input guard"@en ;
    skos:definition "An input guard is a branch that deals with input which none of the expected cases accept. The textbook identifies the true origin of the unassigned variable as the fact that the program does not handle the case where the user enters an invalid unit, and says that the simplest remedy is an else clause that displays a message such as You must enter TB or GB and then calls the sys.exit() function to quit the program (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_InputGuard> ;
    sen0414:anchor "#s-InputGuard" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:DecisionPattern .
pg:Page ipo:coversChapterSection pg:InputGuard .
pg:ErrorReport a ipo:ChapterSection ; rdfs:label "Error report"@en ;
    skos:definition "An error report is what Python prints when it cannot carry out a line of a program. The report names the kind of error and gives a message about it, and for errors that happen while the program runs it also shows the lines through which execution arrived."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ErrorReport> ;
    sen0414:anchor "#s-ErrorReport" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:ErrorReport .
pg:ErrorKind a ipo:ChapterSection ; rdfs:label "Kind of error"@en ;
    skos:definition "A kind of error is the type that Python prints at the start of the last line of an error report. The tutorial distinguishes syntax errors, which the parser finds when it reads the text, from exceptions, which are errors detected during execution in a statement or expression that is syntactically correct (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ErrorKind> ;
    sen0414:anchor "#s-ErrorKind" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ErrorReport .
pg:Page ipo:coversChapterSection pg:ErrorKind .
pg:Exception a ipo:ChapterSection ; rdfs:label "Exception"@en ;
    skos:definition "An exception is an error that is detected while a program runs. The tutorial explains that even if a statement or expression is syntactically correct, it may cause an error when an attempt is made to execute it, and that errors detected during execution are called exceptions and are not unconditionally fatal (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Exception> ;
    sen0414:anchor "#s-Exception" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ErrorKind .
pg:Page ipo:coversChapterSection pg:Exception .
pg:SyntaxErrorKind a ipo:ChapterSection ; rdfs:label "SyntaxError"@en ;
    skos:definition "A SyntaxError is raised when the parser, the part of Python that reads the text of a program, encounters a syntax error, that is, text that does not follow the grammar, the set of rules that say how correct Python text is written (Python Software Foundation, 2026). The tutorial calls such errors parsing errors and says that they are perhaps the most common kind of complaint while one is still learning the language."@en ; dcterms:source <http://example.org/sen0414/ch02#S_SyntaxErrorKind> ;
    sen0414:anchor "#s-SyntaxErrorKind" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ErrorKind .
pg:Page ipo:coversChapterSection pg:SyntaxErrorKind .
pg:NameErrorKind a ipo:ChapterSection ; rdfs:label "NameError"@en ;
    skos:definition "A NameError is raised when a local or global name is not found. The documentation adds that the associated value is an error message that includes the name that could not be found (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_NameErrorKind> ;
    sen0414:anchor "#s-NameErrorKind" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ErrorKind .
pg:Page ipo:coversChapterSection pg:NameErrorKind .
pg:TypeErrorKind a ipo:ChapterSection ; rdfs:label "TypeError"@en ;
    skos:definition "A TypeError is raised when an operation or function is applied to an object of inappropriate type. The associated value is a string giving details about the type mismatch (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_TypeErrorKind> ;
    sen0414:anchor "#s-TypeErrorKind" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ErrorKind .
pg:Page ipo:coversChapterSection pg:TypeErrorKind .
pg:ZeroDivisionErrorKind a ipo:ChapterSection ; rdfs:label "ZeroDivisionError"@en ;
    skos:definition "A ZeroDivisionError is raised when the second argument of a division or modulo operation (the remainder of a division) is zero. The documentation adds that the associated value is a string indicating the type of the operands and the operation (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_ZeroDivisionErrorKind> ;
    sen0414:anchor "#s-ZeroDivisionErrorKind" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ErrorKind .
pg:Page ipo:coversChapterSection pg:ZeroDivisionErrorKind .
pg:Traceback a ipo:ChapterSection ; rdfs:label "Traceback"@en ;
    skos:definition "A traceback is the report that Python prints when an error stops a program. The tutorial explains that the last line of the report indicates what happened, that the rest of that line gives details based on the kind of error, and that the preceding part shows the context where the exception occurred, in the form of a list of the lines of source code through which the program reached the error (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch02#S_Traceback> ;
    sen0414:anchor "#s-Traceback" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ErrorKind .
pg:Page ipo:coversChapterSection pg:Traceback .
