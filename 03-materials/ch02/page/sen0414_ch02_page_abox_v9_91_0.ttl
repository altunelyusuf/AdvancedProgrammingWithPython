pg:Evaluation sen0414:hasPanel pg:ShortCircuit, pg:OperandResult, pg:BooleanExpression, pg:BooleanPrecedence .
pg:ExecutionFlow sen0414:hasPanel pg:FlowControlStatement, pg:ProgramExecution, pg:Flowchart .
pg:ControlStructure sen0414:hasPanel pg:Condition, pg:Block, pg:Indentation, pg:Clause, pg:Keyword .
pg:Branching sen0414:hasPanel pg:IfStatement, pg:ElifClause, pg:ElseClause, pg:BranchChain .
pg:ExpressionForm sen0414:hasPanel pg:ConditionalExpression, pg:AssignmentExpression .
pg:PatternMatching sen0414:hasPanel pg:MatchStatement, pg:CasePattern, pg:WildcardPattern, pg:SequencePattern, pg:Guard, pg:SoftKeyword .
pg:Style sen0414:hasPanel pg:BooleanComparisonStyle, pg:SingletonComparison, pg:EmptinessTest, pg:IndentationStyle .
