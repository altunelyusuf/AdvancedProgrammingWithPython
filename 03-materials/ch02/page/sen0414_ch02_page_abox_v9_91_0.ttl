pg:ErrorKind sen0414:hasPanel pg:Exception, pg:SyntaxErrorKind, pg:NameErrorKind, pg:TypeErrorKind, pg:ZeroDivisionErrorKind, pg:Traceback .
pg:CE_01 a ipo:CodeExample ; rdfs:label "The two Boolean values"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 6 of the deck and runs 3 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 6 ; sen0414:orderInTab 1 ;
    sen0414:code "print(type(True), type(False))\nprint(True + True, int(False), True == 1)\nprint(bool(0), bool(1), bool(-3.5))" ; sen0414:expectedOutput "<class 'bool'> <class 'bool'>\n2 0 True\nFalse True True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "The six comparison operators"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 7 of the deck and runs 3 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 2 ;
    sen0414:code "x, y = 7, 9\nprint(x == y, x != y, x < y)\nprint(x <= y, x > y, x >= y)" ; sen0414:expectedOutput "False True True\nTrue False False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "Equality across types and strings"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 8 of the deck and runs 2 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 3 ;
    sen0414:code "print(42 == 42.0, 42 == '42', 'hello' == 'Hello')\nprint(0.1 + 0.2 == 0.3, 'apple' < 'banana', 'Z' < 'a')" ; sen0414:expectedOutput "True False False\nFalse True True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Chained comparisons"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 10 of the deck and runs 3 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 4 ;
    sen0414:code "age = 15\nprint(10 < age < 20, 10 < age < 12)\nprint(1 < 2 > 1.5, 3 > 2 > 5)" ; sen0414:expectedOutput "True False\nTrue False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "The truth table of and, or"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 13 of the deck and runs 3 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 13 ; sen0414:orderInTab 5 ;
    sen0414:code "for a in (True, False):\n    for b in (True, False):\n        print(a, b, a and b, a or b)" ; sen0414:expectedOutput "True True True True\nTrue False False True\nFalse True False True\nFalse False False False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "not and the order of the operators"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 14 of the deck and runs 3 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 6 ;
    sen0414:code "print(not True, not False, not not True)\nprint(not 4 == 5, True or False and False)\nprint((True or False) and False, not (True and False))" ; sen0414:expectedOutput "False True True\nTrue True\nFalse True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "Mixing Boolean and comparison operators"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 15 of the deck and runs 4 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 15 ; sen0414:orderInTab 7 ;
    sen0414:code "age, member = 25, True\nprint(age >= 18 and member)\nprint(age < 13 or age > 65)\nprint(not (age >= 18 and member))" ; sen0414:expectedOutput "True\nFalse\nFalse\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Short-circuit and operand values"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 16 of the deck and runs 3 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 8 ;
    sen0414:code "print(1 or 1 / 0, 0 and 1 / 0)\nprint('hi' and 'there', '' or 'default')\nprint(0 or [] or None, 1 and 2 and 3)" ; sen0414:expectedOutput "1 0\nthere default\nNone 3\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Truthiness of values"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 17 of the deck and runs 5 lines of Python that print 9 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 17 ; sen0414:orderInTab 9 ;
    sen0414:code "values = [0, 1, 0.0, '', 'a', [], [0], None]\nfor v in values:\n    print(repr(v), bool(v))\ngreeting = 'hello'\nprint(greeting == True, bool(greeting))" ; sen0414:expectedOutput "0 False\n1 True\n0.0 False\n'' False\n'a' True\n[] False\n[0] True\nNone False\nFalse True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "A block of statements"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 21 of the deck and runs 5 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 21 ; sen0414:orderInTab 10 ;
    sen0414:code "age = 70\nif age > 65:\n    print('senior')\n    print('discount')\nprint('end')" ; sen0414:expectedOutput "senior\ndiscount\nend\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "Indentation decides the block"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 22 of the deck and runs 5 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 11 ;
    sen0414:code "x = 1\nif x > 3:\n    print('big')\n    print('inside the block')\nprint('outside the block')" ; sen0414:expectedOutput "outside the block\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "if and else: the password check"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 23 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 12 ;
    sen0414:code "username = 'Mary'\npassword = 'swordfish'\nif username == 'Mary':\n    print('Hello, Mary')\n    if password == 'swordfish':\n        print('Access granted.')\n    else:\n        print('Wrong password.')" ; sen0414:expectedOutput "Hello, Mary\nAccess granted.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "elif: the ladder with one exit"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 24 of the deck and runs 9 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 13 ;
    sen0414:code "name, age = 'Carol', 3000\nif name == 'Alice':\n    print('Hi, Alice.')\nelif age < 12:\n    print('You are not Alice, kiddo.')\nelif age > 2000:\n    print('Alice is not an undead vampire.')\nelif age > 100:\n    print('You are not Alice, grannie.')" ; sen0414:expectedOutput "Alice is not an undead vampire.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "Order of the elif rungs"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 25 of the deck and runs 9 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 14 ;
    sen0414:code "for age in (5, 50, 150, 3000):\n    if age < 12:\n        print(age, 'kiddo')\n    elif age > 100:\n        print(age, 'grannie')\n    elif age > 2000:\n        print(age, 'vampire')\n    else:\n        print(age, 'stranger')" ; sen0414:expectedOutput "5 kiddo\n50 stranger\n150 grannie\n3000 grannie\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "Short program: Opposite Day"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 28 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 28 ; sen0414:orderInTab 15 ;
    sen0414:code "opposite_day = True\nif opposite_day == True:\n    say_it = True\nelse:\n    say_it = False\nif opposite_day == True:\n    say_it = not say_it\nif say_it == True:\n    print('Today is Opposite Day.')\nelse:\n    print('Today is not Opposite Day.')" ; sen0414:expectedOutput "Today is not Opposite Day.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "Short program: Dishonest Capacity Calculator"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 29 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 16 ;
    sen0414:code "advertised = 10\nunit = 'TB'\nif unit == 'TB' or unit == 'tb':\n    discrepancy = 10**12 / 2**40\nelif unit == 'GB' or unit == 'gb':\n    discrepancy = 10**9 / 2**30\nelse:\n    discrepancy = 1\nreal = advertised * discrepancy\nprint('Real capacity:', round(real, 2), unit)" ; sen0414:expectedOutput "Real capacity: 9.09 TB\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "The conditional expression"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 32 of the deck and runs 3 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 17 ;
    sen0414:code "for n in (7, 10):\n    print(n, 'even' if n % 2 == 0 else 'odd')\nprint('adult' if 20 >= 18 else 1 / 0)" ; sen0414:expectedOutput "7 odd\n10 even\nadult\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "match and case"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 34 of the deck and runs 8 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 34 ; sen0414:orderInTab 18 ;
    sen0414:code "for status in (200, 403, 418):\n    match status:\n        case 200:\n            print(status, 'ok')\n        case 401 | 403 | 404:\n            print(status, 'not allowed')\n        case _:\n            print(status, 'other')" ; sen0414:expectedOutput "200 ok\n403 not allowed\n418 other\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "match with sequences"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 35 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 19 ;
    sen0414:code "commands = [['go', 'north'], ['quit'], ['dance']]\nfor command in commands:\n    match command:\n        case ['go', direction]:\n            print('going', direction)\n        case ['quit']:\n            print('bye')\n        case _:\n            print('unknown', command)" ; sen0414:expectedOutput "going north\nbye\nunknown ['dance']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "match with a guard"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 36 of the deck and runs 6 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 36 ; sen0414:orderInTab 20 ;
    sen0414:code "for point in ((3, 3), (3, 4)):\n    match point:\n        case (x, y) if x == y:\n            print('diagonal at', x)\n        case (x, y):\n            print('elsewhere', x, y)" ; sen0414:expectedOutput "diagonal at 3\nelsewhere 3 4\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "The walrus operator"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 38 of the deck and runs 4 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch02/page/chapter_code_ch02_v1_0_0.json" ;
    sen0414:slideNumber 38 ; sen0414:orderInTab 21 ;
    sen0414:code "names = ['Al', 'Alice', 'Bartholomew']\nfor name in names:\n    if (size := len(name)) > 3:\n        print(name, 'has', size, 'letters')" ; sen0414:expectedOutput "Alice has 5 letters\nBartholomew has 11 letters\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
