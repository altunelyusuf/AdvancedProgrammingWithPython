chx:X_UrlAnatomy a owl:NamedIndividual, chx:UrlAnatomy ; rdfs:label "https://api.openweathermap.org/geo/1.0/direct?q=..."@en ; skos:definition "A URL is written as a scheme, a host, a path, an optional query after a question mark and an optional fragment after a number sign; urllib.parse.urlsplit cuts it into those parts."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_UrlAnatomy a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('urllib.parse', fromlist=['x']).urlsplit('https://api.openweathermap.org/geo/1.0/direct?q=San,CA,US&appid=KEY')[:4] evaluates to ('https', 'api.openweathermap.org', '/geo/1.0/direct', 'q=San,CA,US&appid=KEY')"@en ; chx:input "__import__('urllib.parse', fromlist=['x']).urlsplit('https://api.openweathermap.org/geo/1.0/direct?q=San,CA,US&appid=KEY')[:4]" ; chx:output "('https', 'api.openweathermap.org', '/geo/1.0/direct', 'q=San,CA,US&appid=KEY')" .
chx:X_UrlAnatomy rd:hasIOExample chx:IO_UrlAnatomy .
chx:X_QueryString a owl:NamedIndividual, chx:QueryString ; rdfs:label "?q={city_name},{state_code}&appid={API_key}"@en ; skos:definition "The query string of a URL is a list of name=value pairs joined by ampersands; parse_qs reads the pairs back into a dictionary of lists and turns a plus sign or a percent code back into the character."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_QueryString a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('urllib.parse', fromlist=['x']).parse_qs('q=San+Francisco%2CCA&appid=KEY') evaluates to {'q': ['San Francisco,CA'], 'appid': ['KEY']}"@en ; chx:input "__import__('urllib.parse', fromlist=['x']).parse_qs('q=San+Francisco%2CCA&appid=KEY')" ; chx:output "{'q': ['San Francisco,CA'], 'appid': ['KEY']}" .
chx:X_QueryString rd:hasIOExample chx:IO_QueryString .
chx:X_PercentEncoding a owl:NamedIndividual, chx:PercentEncoding ; rdfs:label "%20 for a space, %2C for a comma"@en ; skos:definition "Percent-encoding writes a character that a URL may not carry as a percent sign and two hexadecimal digits, a space as %20 and a comma as %2C; urllib.parse.quote does it for a program, as the browser does for the address typed into its bar."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_PercentEncoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('urllib.parse', fromlist=['x']).quote('777 Valencia St, San Francisco, CA 94110') evaluates to '777%20Valencia%20St%2C%20San%20Francisco%2C%20CA%2094110'"@en ; chx:input "__import__('urllib.parse', fromlist=['x']).quote('777 Valencia St, San Francisco, CA 94110')" ; chx:output "'777%20Valencia%20St%2C%20San%20Francisco%2C%20CA%2094110'" .
chx:X_PercentEncoding rd:hasIOExample chx:IO_PercentEncoding .
chx:X_FragmentPart a owl:NamedIndividual, chx:FragmentPart ; rdfs:label "#map=19/37.75897/-122.42142"@en ; skos:definition "The fragment of a URL, after the number sign, names a place inside the page and is handled by the browser; it is not sent to the server, which is why the chapter can cut it from the OpenStreetMap address and still load the page."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_FragmentPart a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('urllib.parse', fromlist=['x']).urlsplit('https://www.openstreetmap.org/search?query=777%20Valencia%20St%2C%20San%20Francisco%2C%20CA%2094110#map=19/37.75897/-122.42142')[3:] evaluates to ('query=777%20Valencia%20St%2C%20San%20Francisco%2C%20CA%2094110', 'map=19/37.75897/-122.42142')"@en ; chx:input "__import__('urllib.parse', fromlist=['x']).urlsplit('https://www.openstreetmap.org/search?query=777%20Valencia%20St%2C%20San%20Francisco%2C%20CA%2094110#map=19/37.75897/-122.42142')[3:]" ; chx:output "('query=777%20Valencia%20St%2C%20San%20Francisco%2C%20CA%2094110', 'map=19/37.75897/-122.42142')" .
chx:X_FragmentPart rd:hasIOExample chx:IO_FragmentPart .
chx:X_HttpsEncryption a owl:NamedIndividual, chx:HttpsEncryption ; rdfs:label "https://"@en ; skos:definition "HTTPS is HTTP over an encrypted connection: the content of the pages and what is submitted are hidden from the network, but the name of the site visited can still be seen."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_StatusCode a owl:NamedIndividual, chx:StatusCode ; rdfs:label "200 OK, 404 Not Found"@en ; skos:definition "Every HTTP response carries a three-digit status code whose first digit gives its class, 2xx success, 3xx redirection, 4xx client error and 5xx server error; http.HTTPStatus names the codes and their phrases."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_StatusCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('http').HTTPStatus(404).phrase, int(__import__('http').HTTPStatus.OK), __import__('http').HTTPStatus(429).phrase) evaluates to ('Not Found', 200, 'Too Many Requests')"@en ; chx:input "(__import__('http').HTTPStatus(404).phrase, int(__import__('http').HTTPStatus.OK), __import__('http').HTTPStatus(429).phrase)" ; chx:output "('Not Found', 200, 'Too Many Requests')" .
chx:X_StatusCode rd:hasIOExample chx:IO_StatusCode .
chx:X_UserAgent a owl:NamedIndividual, chx:UserAgent ; rdfs:label "python-requests/2.34.2"@en ; skos:definition "The user-agent header of a request names the client program; requests sends python-requests and its version and urllib sends Python-urllib and its version, so a server can tell a script from a browser."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_UserAgent a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import urllib.request\\nout = urllib.request.build_opener().addheaders[0]', g), g['out'])[1])({}) evaluates to ('User-agent', 'Python-urllib/3.14')"@en ; chx:input "(lambda g: (exec('import urllib.request\\nout = urllib.request.build_opener().addheaders[0]', g), g['out'])[1])({})" ; chx:output "('User-agent', 'Python-urllib/3.14')" .
chx:X_UserAgent rd:hasIOExample chx:IO_UserAgent .
chx:X_RobotsTxt a owl:NamedIndividual, chx:RobotsTxt ; rdfs:label "https://pypi.org/robots.txt"@en ; skos:definition "A robots.txt file at the root of a site lists the paths that crawlers are asked not to fetch; it is a request and not an access control, urllib.robotparser reads it and answers can_fetch, and since Python 3.14.5 it reads the wildcard * and the end mark $ of RFC 9309."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_RobotsTxt a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import urllib.robotparser as rp\\nr = rp.RobotFileParser()\\nr.parse([\\'User-agent: *\\', \\'Disallow: /search*\\', \\'Disallow: /account/\\'])\\nout = [r.can_fetch(\\'*\\', \\'https://pypi.org/project/pyautogui/\\'), r.can_fetch(\\'*\\', \\'https://pypi.org/search/?q=boring+stuff\\'), r.can_fetch(\\'*\\', \\'https://pypi.org/account/login/\\')]', g), g['out'])[1])({}) evaluates to [True, False, False]"@en ; chx:input "(lambda g: (exec('import urllib.robotparser as rp\\nr = rp.RobotFileParser()\\nr.parse([\\'User-agent: *\\', \\'Disallow: /search*\\', \\'Disallow: /account/\\'])\\nout = [r.can_fetch(\\'*\\', \\'https://pypi.org/project/pyautogui/\\'), r.can_fetch(\\'*\\', \\'https://pypi.org/search/?q=boring+stuff\\'), r.can_fetch(\\'*\\', \\'https://pypi.org/account/login/\\')]', g), g['out'])[1])({})" ; chx:output "[True, False, False]" .
chx:X_RobotsTxt rd:hasIOExample chx:IO_RobotsTxt .
chx:X_PoliteDelay a owl:NamedIndividual, chx:PoliteDelay ; rdfs:label "time.sleep(1)"@en ; skos:definition "A crawler that loads many pages pauses between requests so that it does not hammer the server; the comic downloader sleeps one second after each comic, and a site can state its own pace in robots.txt with Crawl-delay and Request-rate."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_PoliteDelay a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import urllib.robotparser as rp\\nr = rp.RobotFileParser()\\nr.parse([\\'User-agent: *\\', \\'Crawl-delay: 10\\', \\'Request-rate: 3/20\\'])\\nout = (r.crawl_delay(\\'*\\'), tuple(r.request_rate(\\'*\\')))', g), g['out'])[1])({}) evaluates to (10, (3, 20))"@en ; chx:input "(lambda g: (exec('import urllib.robotparser as rp\\nr = rp.RobotFileParser()\\nr.parse([\\'User-agent: *\\', \\'Crawl-delay: 10\\', \\'Request-rate: 3/20\\'])\\nout = (r.crawl_delay(\\'*\\'), tuple(r.request_rate(\\'*\\')))', g), g['out'])[1])({})" ; chx:output "(10, (3, 20))" .
chx:X_PoliteDelay rd:hasIOExample chx:IO_PoliteDelay .
chx:X_WebbrowserOpen a owl:NamedIndividual, chx:WebbrowserOpen ; rdfs:label "webbrowser.open('https://inventwithpython.com/')"@en ; skos:definition "webbrowser.open asks the user's default browser to show a URL and returns True if a browser was launched and False if not; it cannot read the page."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_WebbrowserOpen a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import webbrowser\\nopened = []\\nclass Stub(webbrowser.BaseBrowser):\\n    def open(self, url, new=0, autoraise=True):\\n        opened.append(url)\\n        return True\\nwebbrowser.register(\\'stub\\', None, Stub(\\'stub\\'), preferred=True)\\nout = (webbrowser.open(\\'https://inventwithpython.com/\\'), opened)', g), g['out'])[1])({}) evaluates to (True, ['https://inventwithpython.com/'])"@en ; chx:input "(lambda g: (exec('import webbrowser\\nopened = []\\nclass Stub(webbrowser.BaseBrowser):\\n    def open(self, url, new=0, autoraise=True):\\n        opened.append(url)\\n        return True\\nwebbrowser.register(\\'stub\\', None, Stub(\\'stub\\'), preferred=True)\\nout = (webbrowser.open(\\'https://inventwithpython.com/\\'), opened)', g), g['out'])[1])({})" ; chx:output "(True, ['https://inventwithpython.com/'])" .
chx:X_WebbrowserOpen rd:hasIOExample chx:IO_WebbrowserOpen .
chx:X_CommandLineArguments a owl:NamedIndividual, chx:CommandLineArguments ; rdfs:label "sys.argv[1:]"@en ; skos:definition "sys.argv is the list of words typed after python and the script name, with the script name first, so joining sys.argv[1:] with spaces rebuilds an address typed without quotes."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_CommandLineArguments a owl:NamedIndividual, rd:IOExample ; rdfs:label "' '.join(['showmap.py', '777', 'Valencia', 'St,', 'San', 'Francisco,', 'CA', '94110'][1:]) evaluates to '777 Valencia St, San Francisco, CA 94110'"@en ; chx:input "' '.join(['showmap.py', '777', 'Valencia', 'St,', 'San', 'Francisco,', 'CA', '94110'][1:])" ; chx:output "'777 Valencia St, San Francisco, CA 94110'" .
chx:X_CommandLineArguments rd:hasIOExample chx:IO_CommandLineArguments .
chx:X_ShowmapProgram a owl:NamedIndividual, chx:ShowmapProgram ; rdfs:label "showmap.py"@en ; skos:definition "showmap.py takes an address from the command line, or from the clipboard when there is none, puts it into an OpenStreetMap search URL and opens that URL with webbrowser.open; the address should be percent-encoded with urllib.parse.quote."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_ShowmapProgram a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda argv, clip: 'https://www.openstreetmap.org/search?query=' + __import__('urllib.parse', fromlist=['x']).quote(' '.join(argv[1:]) if len(argv) > 1 else clip))(['showmap.py'], '1 Main St & 2nd Ave') evaluates to 'https://www.openstreetmap.org/search?query=1%20Main%20St%20%26%202nd%20Ave'"@en ; chx:input "(lambda argv, clip: 'https://www.openstreetmap.org/search?query=' + __import__('urllib.parse', fromlist=['x']).quote(' '.join(argv[1:]) if len(argv) > 1 else clip))(['showmap.py'], '1 Main St & 2nd Ave')" ; chx:output "'https://www.openstreetmap.org/search?query=1%20Main%20St%20%26%202nd%20Ave'" .
chx:X_ShowmapProgram rd:hasIOExample chx:IO_ShowmapProgram .
chx:X_LocalHelpFile a owl:NamedIndividual, chx:LocalHelpFile ; rdfs:label "file:///Users/al/Desktop/help.html"@en ; skos:definition "A local .html file can be opened in the browser with the file:// prefix instead of https://, which suits a help page with fonts, colour and images; Path.as_uri() builds the URL and percent-encodes a space in the name."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_LocalHelpFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import pathlib\\nout = (pathlib.Path(\\'/Users/al/Desktop/help.html\\').as_uri(), pathlib.Path(\\'/Users/al/Desktop/my help.html\\').as_uri())', g), g['out'])[1])({}) evaluates to ('file:///Users/al/Desktop/help.html', 'file:///Users/al/Desktop/my%20help.html')"@en ; chx:input "(lambda g: (exec('import pathlib\\nout = (pathlib.Path(\\'/Users/al/Desktop/help.html\\').as_uri(), pathlib.Path(\\'/Users/al/Desktop/my help.html\\').as_uri())', g), g['out'])[1])({})" ; chx:output "('file:///Users/al/Desktop/help.html', 'file:///Users/al/Desktop/my%20help.html')" .
chx:X_LocalHelpFile rd:hasIOExample chx:IO_LocalHelpFile .
chx:X_GetRequest a owl:NamedIndividual, chx:GetRequest ; rdfs:label "requests.get(url)"@en ; skos:definition "requests.get downloads the page or file at a URL and returns a Response object; the requests package is installed separately, it does not come with Python."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_ResponseBody a owl:NamedIndividual, chx:ResponseBody ; rdfs:label "response.text, response.content"@en ; skos:definition "A Response holds the body both as bytes, in content, and as a string decoded with the response's encoding, in text; the download contains only the HTML, and images and other media must be fetched separately."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_RequestTimeout a owl:NamedIndividual, chx:RequestTimeout ; rdfs:label "requests.get(url, timeout=10)"@en ; skos:definition "A call of requests.get without a timeout argument waits for ever for a server that does not answer; the timeout argument, in seconds, makes it raise a Timeout exception instead, and the documentation asks for it in nearly all production code."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_StatusCheck a owl:NamedIndividual, chx:StatusCheck ; rdfs:label "response.status_code == requests.codes.ok"@en ; skos:definition "A response is checked through its status_code, which equals requests.codes.ok (200) on success; the ok attribute is true for every code below 400, so a redirect counts as ok."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_StatusCheck a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(s, s < 400) for s in (200, 301, 404, 500)] evaluates to [(200, True), (301, True), (404, False), (500, False)]"@en ; chx:input "[(s, s < 400) for s in (200, 301, 404, 500)]" ; chx:output "[(200, True), (301, True), (404, False), (500, False)]" .
chx:X_StatusCheck rd:hasIOExample chx:IO_StatusCheck .
chx:X_RaiseForStatus a owl:NamedIndividual, chx:RaiseForStatus ; rdfs:label "response.raise_for_status()"@en ; skos:definition "raise_for_status does nothing when the download worked and raises an HTTPError when the status is 4xx or 5xx; it is called right after every get so that a program stops on a bad download, or its exception is caught and printed."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_BinaryWrite a owl:NamedIndividual, chx:BinaryWrite ; rdfs:label "open('RomeoAndJuliet.txt', 'wb')"@en ; skos:definition "A downloaded body is written to a file opened in write binary mode, because the bytes are the file's content whatever its text encoding; write returns the number of bytes written, and writing bytes to a text file raises TypeError."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_BinaryWrite a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io\\nf = io.BytesIO()\\nn = f.write(\\'caf\\\\u00e9\\'.encode(\\'utf-8\\'))\\ntry:\\n    io.StringIO().write(b\\'abc\\')\\nexcept TypeError as e:\\n    err = str(e)\\nout = (n, f.getvalue().decode(\\'utf-8\\'), \\'bytes\\' in err)', g), g['out'])[1])({}) evaluates to (5, 'café', True)"@en ; chx:input "(lambda g: (exec('import io\\nf = io.BytesIO()\\nn = f.write(\\'caf\\\\u00e9\\'.encode(\\'utf-8\\'))\\ntry:\\n    io.StringIO().write(b\\'abc\\')\\nexcept TypeError as e:\\n    err = str(e)\\nout = (n, f.getvalue().decode(\\'utf-8\\'), \\'bytes\\' in err)', g), g['out'])[1])({})" ; chx:output "(5, 'café', True)" .
chx:X_BinaryWrite rd:hasIOExample chx:IO_BinaryWrite .
chx:X_ChunkedDownload a owl:NamedIndividual, chx:ChunkedDownload ; rdfs:label "for chunk in response.iter_content(100000):"@en ; skos:definition "iter_content yields the body in chunks of the size asked for, the last one shorter; the chapter writes each chunk to the file, and requests advises stream=True for a download so that the body is not read whole into memory first."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_ChunkedDownload a owl:NamedIndividual, rd:IOExample ; rdfs:label "[len(c) for c in (lambda b: [b[i:i + 100000] for i in range(0, len(b), 100000)])(b'x' * 178978)] evaluates to [100000, 78978]"@en ; chx:input "[len(c) for c in (lambda b: [b[i:i + 100000] for i in range(0, len(b), 100000)])(b'x' * 178978)]" ; chx:output "[100000, 78978]" .
chx:X_ChunkedDownload rd:hasIOExample chx:IO_ChunkedDownload .
chx:X_ServiceEndpoint a owl:NamedIndividual, chx:ServiceEndpoint ; rdfs:label "https://api.openweathermap.org/geo/1.0/direct"@en ; skos:definition "An API is the way one program is asked for data by another, and an endpoint is the URL at which one request is answered; services put a version number into it, such as /geo/1.0/ and /data/2.5/, so that an old version can be retired."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_ServiceEndpoint a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('city_name = \\'San Francisco\\'; state_code = \\'CA\\'; country_code = \\'US\\'; API_key = \\'30ee784a80d81480dab1749d33980112\\'\\nurl = f\\'https://api.openweathermap.org/geo/1.0/direct?q={city_name},{state_code},{country_code}&appid={API_key}\\'\\nimport urllib.parse\\nout = (url, urllib.parse.urlsplit(url).path)', g), g['out'])[1])({}) evaluates to ('https://api.openweathermap.org/geo/1.0/direct?q=San Francisco,CA,US&appid=30ee784a80d81480dab1749d33980112', '/geo/1.0/direct')"@en ; chx:input "(lambda g: (exec('city_name = \\'San Francisco\\'; state_code = \\'CA\\'; country_code = \\'US\\'; API_key = \\'30ee784a80d81480dab1749d33980112\\'\\nurl = f\\'https://api.openweathermap.org/geo/1.0/direct?q={city_name},{state_code},{country_code}&appid={API_key}\\'\\nimport urllib.parse\\nout = (url, urllib.parse.urlsplit(url).path)', g), g['out'])[1])({})" ; chx:output "('https://api.openweathermap.org/geo/1.0/direct?q=San Francisco,CA,US&appid=30ee784a80d81480dab1749d33980112', '/geo/1.0/direct')" .
chx:X_ServiceEndpoint rd:hasIOExample chx:IO_ServiceEndpoint .
chx:X_AccessKey a owl:NamedIndividual, chx:AccessKey ; rdfs:label "appid={API_key}"@en ; skos:definition "An API key identifies the account that is making the requests and is sent in the query string; it is kept secret and read from a file, not written in the source, and a key that is not valid is answered with a 401 error."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_AccessKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile\\nwith tempfile.TemporaryDirectory() as d:\\n    p = os.path.join(d, \\'openweather_key.txt\\')\\n    open(p, \\'w\\').write(\\'30ee784a80d81480dab1749d33980112\\\\n\\')\\n    raw = open(p).read()\\n    API_key = raw.strip()\\nout = (len(raw), len(API_key), API_key[:4])', g), g['out'])[1])({}) evaluates to (33, 32, '30ee')"@en ; chx:input "(lambda g: (exec('import os, tempfile\\nwith tempfile.TemporaryDirectory() as d:\\n    p = os.path.join(d, \\'openweather_key.txt\\')\\n    open(p, \\'w\\').write(\\'30ee784a80d81480dab1749d33980112\\\\n\\')\\n    raw = open(p).read()\\n    API_key = raw.strip()\\nout = (len(raw), len(API_key), API_key[:4])', g), g['out'])[1])({})" ; chx:output "(33, 32, '30ee')" .
chx:X_AccessKey rd:hasIOExample chx:IO_AccessKey .
chx:X_ErrorAnswer a owl:NamedIndividual, chx:ErrorAnswer ; rdfs:label "[] and {'cod': '400', 'message': 'wrong latitude'}"@en ; skos:definition "A call that finds nothing or is wrong is still answered, with an empty list for an unknown city and a dictionary with a cod and a message for a wrong latitude, so the program checks the shape of the decoded data before indexing it."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_ErrorAnswer a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import json\\nout = (json.loads(\\'[]\\'), json.loads(\\'{#cod#:#400#,#message#:#wrong latitude#}\\'.replace(\\'#\\', chr(34)))[\\'message\\'])', g), g['out'])[1])({}) evaluates to ([], 'wrong latitude')"@en ; chx:input "(lambda g: (exec('import json\\nout = (json.loads(\\'[]\\'), json.loads(\\'{#cod#:#400#,#message#:#wrong latitude#}\\'.replace(\\'#\\', chr(34)))[\\'message\\'])', g), g['out'])[1])({})" ; chx:output "([], 'wrong latitude')" .
chx:X_ErrorAnswer rd:hasIOExample chx:IO_ErrorAnswer .
chx:X_JsonDecoding a owl:NamedIndividual, chx:JsonDecoding ; rdfs:label "json.loads(response.text)"@en ; skos:definition "json.loads turns JSON text into lists, dictionaries, strings, numbers and None; response.json() does the same for a response, and text that is not JSON, such as a challenge page in HTML, raises JSONDecodeError."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_JsonDecoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import json\\ntext = \\'[{#name#: #San Francisco#, #lat#: 37.7790262, #lon#: -122.419906, #country#: #US#, #state#: #California#}]\\'.replace(\\'#\\', chr(34))\\ndata = json.loads(text)\\nout = (type(data).__name__, data[0][\\'lat\\'], data[0][\\'lon\\'])', g), g['out'])[1])({}) evaluates to ('list', 37.7790262, -122.419906)"@en ; chx:input "(lambda g: (exec('import json\\ntext = \\'[{#name#: #San Francisco#, #lat#: 37.7790262, #lon#: -122.419906, #country#: #US#, #state#: #California#}]\\'.replace(\\'#\\', chr(34))\\ndata = json.loads(text)\\nout = (type(data).__name__, data[0][\\'lat\\'], data[0][\\'lon\\'])', g), g['out'])[1])({})" ; chx:output "('list', 37.7790262, -122.419906)" .
chx:X_JsonDecoding rd:hasIOExample chx:IO_JsonDecoding .
chx:X_UnitConversion a owl:NamedIndividual, chx:UnitConversion ; rdfs:label "round(285.44 - 273.15, 1)"@en ; skos:definition "A value from an API is often in a unit the program must convert: the temperature arrives in Kelvin and is turned into Celsius by subtracting 273.15 and into Fahrenheit with 9/5 and 459.67."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_UnitConversion a owl:NamedIndividual, rd:IOExample ; rdfs:label "(round(285.44 - 273.15, 1), round(285.44 * (9 / 5) - 459.67, 1)) evaluates to (12.3, 54.1)"@en ; chx:input "(round(285.44 - 273.15, 1), round(285.44 * (9 / 5) - 459.67, 1))" ; chx:output "(12.3, 54.1)" .
chx:X_UnitConversion rd:hasIOExample chx:IO_UnitConversion .
chx:X_ForecastTimestamps a owl:NamedIndividual, chx:ForecastTimestamps ; rdfs:label "datetime.datetime.fromtimestamp(dt)"@en ; skos:definition "The dt field of a forecast is a Unix timestamp, the seconds since 1 January 1970 in UTC, and datetime.fromtimestamp turns it into a datetime in a stated time zone; without a zone it uses the machine's, and the forecast holds 40 entries three hours apart, five days."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_ForecastTimestamps a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import datetime\\nstamp = 1790000000\\nwhen = datetime.datetime.fromtimestamp(stamp, tz=datetime.timezone.utc)\\nout = (when.isoformat(), 40 * 3 / 24)', g), g['out'])[1])({}) evaluates to ('2026-09-21T14:13:20+00:00', 5.0)"@en ; chx:input "(lambda g: (exec('import datetime\\nstamp = 1790000000\\nwhen = datetime.datetime.fromtimestamp(stamp, tz=datetime.timezone.utc)\\nout = (when.isoformat(), 40 * 3 / 24)', g), g['out'])[1])({})" ; chx:output "('2026-09-21T14:13:20+00:00', 5.0)" .
chx:X_ForecastTimestamps rd:hasIOExample chx:IO_ForecastTimestamps .
chx:X_WeatherServices a owl:NamedIndividual, chx:WeatherServices ; rdfs:label "https://api.weather.gov"@en ; skos:definition "Other weather services publish their own APIs, and every API works differently; the National Weather Service answers without a key but requires a User-Agent header that identifies the application, and a third-party Python package may already wrap an API."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_HtmlElement a owl:NamedIndividual, chx:HtmlElement ; rdfs:label "<b>Hello</b>, world!"@en ; skos:definition "An HTML element is a starting tag, its content and a closing tag, such as <b>Hello</b>, and elements nest inside one another to form the tree of the page; a parser reports each start, each piece of text and each end as it reads."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_HtmlElement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('from html.parser import HTMLParser\\nclass Events(HTMLParser):\\n    def __init__(self):\\n        super().__init__()\\n        self.seen = []\\n    def handle_starttag(self, tag, attrs): self.seen.append((\\'start\\', tag))\\n    def handle_data(self, data): self.seen.append((\\'text\\', data))\\n    def handle_endtag(self, tag): self.seen.append((\\'end\\', tag))\\np = Events()\\np.feed(\\'<b>Hello</b>, world!\\')\\nout = p.seen', g), g['out'])[1])({}) evaluates to [('start', 'b'), ('text', 'Hello'), ('end', 'b'), ('text', ', world!')]"@en ; chx:input "(lambda g: (exec('from html.parser import HTMLParser\\nclass Events(HTMLParser):\\n    def __init__(self):\\n        super().__init__()\\n        self.seen = []\\n    def handle_starttag(self, tag, attrs): self.seen.append((\\'start\\', tag))\\n    def handle_data(self, data): self.seen.append((\\'text\\', data))\\n    def handle_endtag(self, tag): self.seen.append((\\'end\\', tag))\\np = Events()\\np.feed(\\'<b>Hello</b>, world!\\')\\nout = p.seen', g), g['out'])[1])({})" ; chx:output "[('start', 'b'), ('text', 'Hello'), ('end', 'b'), ('text', ', world!')]" .
chx:X_HtmlElement rd:hasIOExample chx:IO_HtmlElement .
chx:X_HtmlAttribute a owl:NamedIndividual, chx:HtmlAttribute ; rdfs:label "<a href='https://inventwithpython.com'>"@en ; skos:definition "A tag can carry attributes written as name=value inside the angle brackets, such as href of a link, id that names one element and class that names a group; a parser hands them to the program as name-value pairs."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_HtmlAttribute a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('from html.parser import HTMLParser\\nclass Tags(HTMLParser):\\n    got = []\\n    def handle_starttag(self, tag, attrs): self.got.append((tag, attrs))\\nTags().feed(\\'<a href=#https://inventwithpython.com# id=k>text</a>\\'.replace(\\'#\\', chr(34)))\\nout = Tags.got', g), g['out'])[1])({}) evaluates to [('a', [('href', 'https://inventwithpython.com'), ('id', 'k')])]"@en ; chx:input "(lambda g: (exec('from html.parser import HTMLParser\\nclass Tags(HTMLParser):\\n    got = []\\n    def handle_starttag(self, tag, attrs): self.got.append((tag, attrs))\\nTags().feed(\\'<a href=#https://inventwithpython.com# id=k>text</a>\\'.replace(\\'#\\', chr(34)))\\nout = Tags.got', g), g['out'])[1])({})" ; chx:output "[('a', [('href', 'https://inventwithpython.com'), ('id', 'k')])]" .
chx:X_HtmlAttribute rd:hasIOExample chx:IO_HtmlAttribute .
chx:X_CharacterReferences a owl:NamedIndividual, chx:CharacterReferences ; rdfs:label "&lt;p&gt;"@en ; skos:definition "A character reference such as &lt; stands for a character that would otherwise be read as markup; html.unescape turns the references back into characters and html.escape writes them."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_CharacterReferences a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import html\\nout = (html.unescape(\\'&lt;p&gt; &amp; &copy;\\'), html.escape(\\'<p> & #q#\\'.replace(\\'#\\', chr(34))))', g), g['out'])[1])({}) evaluates to ('<p> & ©', '&lt;p&gt; &amp; &quot;q&quot;')"@en ; chx:input "(lambda g: (exec('import html\\nout = (html.unescape(\\'&lt;p&gt; &amp; &copy;\\'), html.escape(\\'<p> & #q#\\'.replace(\\'#\\', chr(34))))', g), g['out'])[1])({})" ; chx:output "('<p> & ©', '&lt;p&gt; &amp; &quot;q&quot;')" .
chx:X_CharacterReferences rd:hasIOExample chx:IO_CharacterReferences .
chx:X_ViewSource a owl:NamedIndividual, chx:ViewSource ; rdfs:label "right-click, View page source"@en ; skos:definition "The source of a page is the HTML text the browser actually received, which is what requests downloads; the page on the screen may differ from it when scripts have changed it afterwards."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_DeveloperTools a owl:NamedIndividual, chx:DeveloperTools ; rdfs:label "F12, Inspect Element"@en ; skos:definition "The Developer Tools of Firefox, Chrome and Edge open with F12 and show the HTML behind the element that was right-clicked and Inspect Element chosen, where its tag, id, class and a copy of its CSS selector are found."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_CssSelector a owl:NamedIndividual, chx:CssSelector ; rdfs:label "div.row-odd:nth-child(1) > div:nth-child(2)"@en ; skos:definition "A CSS selector names the elements to pick by tag, by # and id, by . and class, by attribute in square brackets, by a space for any descendant and by > for a direct child; the Developer Tools can copy one, and XPath is another syntax."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_RegexPitfall a owl:NamedIndividual, chx:RegexPitfall ; rdfs:label "re.findall('<a href=...>', html)"@en ; skos:definition "A regular expression for a tag fails on the many equivalent ways HTML can be written, so the chapter advises a parser such as Beautiful Soup; a pattern that needs href right after a does not match an a tag that has a class first."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_RegexPitfall a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import re\\nlinks = [\\'<a href=#https://a.example/x#>one</a>\\', \\'<a class=#b# href=#https://b.example/y#>two</a>\\', \\'<A HREF=https://c.example/z>three</A>\\']\\npattern = \\'<a href=#(.*?)#>\\'.replace(\\'#\\', chr(34))\\nout = [re.findall(pattern, t.replace(\\'#\\', chr(34))) for t in links]', g), g['out'])[1])({}) evaluates to [['https://a.example/x'], [], []]"@en ; chx:input "(lambda g: (exec('import re\\nlinks = [\\'<a href=#https://a.example/x#>one</a>\\', \\'<a class=#b# href=#https://b.example/y#>two</a>\\', \\'<A HREF=https://c.example/z>three</A>\\']\\npattern = \\'<a href=#(.*?)#>\\'.replace(\\'#\\', chr(34))\\nout = [re.findall(pattern, t.replace(\\'#\\', chr(34))) for t in links]', g), g['out'])[1])({})" ; chx:output "[['https://a.example/x'], [], []]" .
chx:X_RegexPitfall rd:hasIOExample chx:IO_RegexPitfall .
chx:X_SoupObject a owl:NamedIndividual, chx:SoupObject ; rdfs:label "bs4.BeautifulSoup(res.text, 'html.parser')"@en ; skos:definition "bs4.BeautifulSoup takes the HTML, as a string or an open file, and the name of a parser and returns an object holding the parsed page; the name html.parser selects the parser of Python's standard library, the others must be installed."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_SelectMethod a owl:NamedIndividual, chx:SelectMethod ; rdfs:label "soup.select('#author')"@en ; skos:definition "select takes a CSS selector and returns a list of the matching Tag objects, an empty list when nothing matches, and never None; select_one returns the first match or None."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_SelectorPatterns a owl:NamedIndividual, chx:SelectorPatterns ; rdfs:label "div span, div > span, input[name], p #author"@en ; skos:definition "The chapter's patterns combine: a tag name, #id, .class, a space for a descendant, > for a direct child and [attribute] or [attribute=value]; p #author needs the element to be inside a p element while p#author needs the p element to be the author."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_TagText a owl:NamedIndividual, chx:TagText ; rdfs:label "elems[0].get_text()"@en ; skos:definition "get_text returns the text between a tag's opening and closing tags with the nested tags removed and character references such as &lt; turned back into characters, while str of the tag returns its HTML."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_TagAttributes a owl:NamedIndividual, chx:TagAttributes ; rdfs:label "span_elem.get('id'), span_elem.attrs"@en ; skos:definition "get returns the value of one attribute, or None for an attribute the tag does not have, and attrs is the dictionary of all its attributes."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_SearchResultLinks a owl:NamedIndividual, chx:SearchResultLinks ; rdfs:label "min(5, len(link_elems))"@en ; skos:definition "searchpypi.py downloads a search page, selects the links of the results with a class selector, and opens the first five in browser tabs, the count being the smaller of five and the number of links found."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_SearchResultLinks a owl:NamedIndividual, rd:IOExample ; rdfs:label "[min(5, n) for n in (0, 3, 12)] evaluates to [0, 3, 5]"@en ; chx:input "[min(5, n) for n in (0, 3, 12)]" ; chx:output "[0, 3, 5]" .
chx:X_SearchResultLinks rd:hasIOExample chx:IO_SearchResultLinks .
chx:X_ChallengePage a owl:NamedIndividual, chx:ChallengePage ; rdfs:label "Client Challenge"@en ; skos:definition "A site may answer a script with a page that asks for proof of a browser, status 200 and a title such as Client Challenge, instead of the page asked for; the selector then finds nothing and the program must say so rather than open zero tabs in silence."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_ComicCrawler a owl:NamedIndividual, chx:ComicCrawler ; rdfs:label "while not url.endswith('#') and num_downloads < MAX_DOWNLOADS:"@en ; skos:definition "downloadXkcdComics.py loops over the pages of a comic site: it downloads a page, saves the image inside the element with id comic, follows the link whose rel is prev and stops when that link ends in # or after ten downloads."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_ComicCrawler a owl:NamedIndividual, rd:IOExample ; rdfs:label "[u.endswith('#') for u in ('https://xkcd.com/2/', 'https://xkcd.com/#')] evaluates to [False, True]"@en ; chx:input "[u.endswith('#') for u in ('https://xkcd.com/2/', 'https://xkcd.com/#')]" ; chx:output "[False, True]" .
chx:X_ComicCrawler rd:hasIOExample chx:IO_ComicCrawler .
chx:X_ComicFileNames a owl:NamedIndividual, chx:ComicFileNames ; rdfs:label "os.path.basename(comic_URL)"@en ; skos:definition "os.path.basename returns the last part of a path or URL, which names the image file on disk, and os.path.join puts it in the xkcd folder with the separator of the system."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_ComicFileNames a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os\\nurl = \\'https://imgs.xkcd.com/comics/heartbleed_explanation.png\\'\\nout = (os.path.basename(url), os.path.join(\\'xkcd\\', os.path.basename(url)))', g), g['out'])[1])({}) evaluates to ('heartbleed_explanation.png', 'xkcd/heartbleed_explanation.png')"@en ; chx:input "(lambda g: (exec('import os\\nurl = \\'https://imgs.xkcd.com/comics/heartbleed_explanation.png\\'\\nout = (os.path.basename(url), os.path.join(\\'xkcd\\', os.path.basename(url)))', g), g['out'])[1])({})" ; chx:output "('heartbleed_explanation.png', 'xkcd/heartbleed_explanation.png')" .
chx:X_ComicFileNames rd:hasIOExample chx:IO_ComicFileNames .
chx:X_IndentedListing a owl:NamedIndividual, chx:IndentedListing ; rdfs:label "image_file = open(...) at 8 spaces, for chunk at 12"@en ; skos:definition "Python takes the meaning of a block from its indentation, so the Step 4 listing of the comic downloader, whose lines are indented 8, 12, 15, 12 and then 6 spaces, is rejected with an IndentationError and must be re-indented to run."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_PoliteCrawler a owl:NamedIndividual, chx:PoliteCrawler ; rdfs:label "robots.txt read first, Crawl-delay obeyed"@en ; skos:definition "A crawler that wants to be polite reads the robots.txt of the site first, skips the paths it disallows and waits the Crawl-delay between pages, which the standard library hands to the program."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_LinkVerification a owl:NamedIndividual, chx:LinkVerification ; rdfs:label "find every a link and test for 404"@en ; skos:definition "The link-verification practice program finds every a element of a page, turns each href into an absolute URL, asks for it and prints the links whose status is 404."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_ImageDownloader a owl:NamedIndividual, chx:ImageDownloader ; rdfs:label "download every photo of a results page"@en ; skos:definition "The image site downloader finds the img elements of a search results page, turns each src into an absolute URL and saves the files with iter_content, one request for the page and one for each image."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_GameKeystrokes a owl:NamedIndividual, chx:GameKeystrokes ; rdfs:label "up, right, down, left sent to play2048.co"@en ; skos:definition "The 2048 practice program opens the game in a browser driver and sends arrow keystrokes in a loop, which is browser automation, not downloading, because the game runs in the page's script."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "#main and #highlight"@en ; skos:definition "Questions 9 and 10 of the chapter ask for the CSS selector of the element with the id main and of the elements with the id highlight, which is #main and #highlight; an id should be unique in a page, but a browser and a parser accept a page that repeats one."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:IO_PracticeQuestions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('from html.parser import HTMLParser\\nclass Ids(HTMLParser):\\n    def __init__(self):\\n        super().__init__()\\n        self.ids = []\\n    def handle_starttag(self, tag, attrs): self.ids.append(dict(attrs).get(\\'id\\'))\\np = Ids()\\np.feed(\\'<div id=main></div><p id=highlight>x</p><span id=highlight>y</span>\\')\\nout = (p.ids.count(\\'main\\'), p.ids.count(\\'highlight\\'))', g), g['out'])[1])({}) evaluates to (1, 2)"@en ; chx:input "(lambda g: (exec('from html.parser import HTMLParser\\nclass Ids(HTMLParser):\\n    def __init__(self):\\n        super().__init__()\\n        self.ids = []\\n    def handle_starttag(self, tag, attrs): self.ids.append(dict(attrs).get(\\'id\\'))\\np = Ids()\\np.feed(\\'<div id=main></div><p id=highlight>x</p><span id=highlight>y</span>\\')\\nout = (p.ids.count(\\'main\\'), p.ids.count(\\'highlight\\'))', g), g['out'])[1])({})" ; chx:output "(1, 2)" .
chx:X_PracticeQuestions rd:hasIOExample chx:IO_PracticeQuestions .
chx:X_WebDriverStart a owl:NamedIndividual, chx:WebDriverStart ; rdfs:label "browser = webdriver.Firefox()"@en ; skos:definition "Selenium starts a real browser that the program controls; it is imported with from selenium import webdriver, and since Selenium Manager finds the driver itself, no separate download is needed."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_BrowserButtons a owl:NamedIndividual, chx:BrowserButtons ; rdfs:label "browser.back(), forward(), refresh(), quit()"@en ; skos:definition "Selenium clicks the buttons of the browser itself with back, forward, refresh and quit, and get loads a URL; the page keeps a history that back and forward walk along."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_ByLocators a owl:NamedIndividual, chx:ByLocators ; rdfs:label "By.ID, By.CSS_SELECTOR, By.LINK_TEXT"@en ; skos:definition "The By constants say how an element is looked for: by class name, CSS selector, id, link text, partial link text, name or tag name, and XPath in the library; the constants are plain strings such as 'css selector' and 'link text'."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_ElementLookup a owl:NamedIndividual, chx:ElementLookup ; rdfs:label "find_element() and find_elements()"@en ; skos:definition "find_element returns the first matching WebElement and raises NoSuchElementException when there is none, while find_elements returns a list that is empty when there is none."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_ElementProperties a owl:NamedIndividual, chx:ElementProperties ; rdfs:label "elems[0].text, elems[0].get_property('innerHTML')"@en ; skos:definition "A WebElement gives its rendered text in text, its source through get_property('innerHTML'), a property or attribute through get_attribute, and whether it is displayed, enabled or selected; the text of an element hidden from view is empty."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_ClickAndSubmit a owl:NamedIndividual, chx:ClickAndSubmit ; rdfs:label "click(), send_keys(), submit()"@en ; skos:definition "click follows a link or presses a button, send_keys types into a field, and submit sends the form that contains the element; the login fields of the chapter's page are found by id, and a password belongs in a file, not in the source."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_SpecialKeys a owl:NamedIndividual, chx:SpecialKeys ; rdfs:label "Keys.END, Keys.HOME"@en ; skos:definition "send_keys also takes the constants of Keys, such as Keys.END and Keys.HOME, which scroll the page when the cursor is in no field, and the arrow keys, which reach the script of a page."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_SyncPlaywright a owl:NamedIndividual, chx:SyncPlaywright ; rdfs:label "with sync_playwright() as playwright:"@en ; skos:definition "Playwright is used in its synchronous form inside a with block, which starts and stops it; the block launches a browser, makes a page and closes both, and the page methods return when the operation is complete."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_HeadlessMode a owl:NamedIndividual, chx:HeadlessMode ; rdfs:label "playwright.firefox.launch(headless=False, slow_mo=50)"@en ; skos:definition "A browser launched by Playwright runs headless by default, without a window, and headless=False with slow_mo shows the steps; a headed launch needs a display, and the browsers are installed with the command playwright install."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_PlaywrightButtons a owl:NamedIndividual, chx:PlaywrightButtons ; rdfs:label "page.go_back(), go_forward(), reload(), close()"@en ; skos:definition "Playwright clicks the buttons of the browser with the Page methods go_back, go_forward, reload and close, and goto loads a URL and returns the Response."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_PageLocators a owl:NamedIndividual, chx:PageLocators ; rdfs:label "page.get_by_role('checkbox'), page.locator('p')"@en ; skos:definition "A Page offers get_by_role, get_by_text, get_by_label, get_by_placeholder, get_by_alt_text and locator for a CSS or XPath selector, each returning a Locator that stands for the elements that may match."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_LocatorMethods a owl:NamedIndividual, chx:LocatorMethods ; rdfs:label "elems.nth(0).inner_text(), count()"@en ; skos:definition "A Locator counts its matches, picks one with nth, first or last, reads inner_text and inner_html, and acts with click, fill, press, check and uncheck; it is strict, so an action on a locator that matches several elements raises an error."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_AutoWaiting a owl:NamedIndividual, chx:AutoWaiting ; rdfs:label "page.is_visible() and the 30 second pause"@en ; skos:definition "Playwright waits for an element to exist and be ready before it acts, up to a default timeout of 30 seconds, so a mistyped selector makes the program pause that long; is_visible and query_selector answer at once."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_CheckBoxes a owl:NamedIndividual, chx:CheckBoxes ; rdfs:label "click(), check(), uncheck(), set_checked()"@en ; skos:definition "click toggles a checkbox to the opposite of its state, while check, uncheck and set_checked leave it checked or unchecked whatever it was before, which is why the chapter calls them more reliable."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_FillAndPress a owl:NamedIndividual, chx:FillAndPress ; rdfs:label "fill(), clear(), press('End')"@en ; skos:definition "fill types text into an input or textarea, clear erases it, and press sends a key such as End or Control+A to the element; there is no submit method, so the Submit button is clicked."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_DynamicPages a owl:NamedIndividual, chx:DynamicPages ; rdfs:label "requests or a browser"@en ; skos:definition "A page whose content is built by scripts, or that needs a login, cannot be read from the text requests downloads; the program then needs a browser driver, which is slower, and an API is preferable whenever the service offers one."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:X_AutomationTells a owl:NamedIndividual, chx:AutomationTells ; rdfs:label "navigator.webdriver, the user agent"@en ; skos:definition "A site can recognise a script by its user-agent string and by flags that a driven browser reveals, such as navigator.webdriver, so a driven browser passes for human only in part and a ticketing or shopping site may still refuse it."@en ; dcterms:source <http://example.org/sen0414/ch13/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 13 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch13/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 13 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which tool reaches which kind of page - a browser launcher, a downloader, an HTML parser or a browser driver - and what decides the choice?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, programs and concepts of the chapter differ in current Python, libraries or web sites, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 13 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 13 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch13/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-12."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py" .

