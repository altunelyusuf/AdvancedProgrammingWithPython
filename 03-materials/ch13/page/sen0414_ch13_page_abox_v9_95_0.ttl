pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Chapter 13 interactive page"@en ;
    skos:definition "The interactive page sen0414_ch13_page_v9_95_0.html teaches chapter 13 of the book, Web scraping for an advanced course: chapter 13 and today's web, through 94 sections and 94 widgets that run or draw the chapter's examples."@en ; dcterms:source <http://example.org/sen0414/ch13/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4, pg:CO5 ;
    sen0414:navigationRule "One top menu of 8 items, with one row of tabs under the item that is open, a chapter explorer tree on the left and a detail card on the right that opens only when a reader asks for it." ;
    sen0414:pageFile "03-materials/ch13/page/sen0414_ch13_page_v9_95_0.html" ;
    sen0414:pythonUsed "Python 3.13.16" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Explorer, main area and detail card"@en ;
    skos:definition "The layout puts the chapter explorer tree on the left, the main area with the open tab in the middle and the detail card on the right, which opens only on request."@en ; dcterms:source "03-materials/ch13/page/sen0414_ch13_page_v9_95_0.html" .
pg:Header a ipo:Header ; rdfs:label "Header with the chapter title and the main menu"@en ;
    skos:definition "The header holds the chapter title, the buttons to go back and forward, the search, the progress badge, the text-size control and the main menu with 8 items."@en ; dcterms:source "03-materials/ch13/page/sen0414_ch13_page_v9_95_0.html" .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Chapter explorer tree"@en ;
    skos:definition "The sidebar is the chapter explorer, a tree of the 94 sections of the chapter whose choice opens the matching tab."@en ; dcterms:source "03-materials/ch13/page/sen0414_ch13_page_v9_95_0.html" .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en ;
    skos:definition "The main area shows the open tab of the open menu item, with the widgets of the chapter's concepts placed in the text they explain."@en ; dcterms:source "03-materials/ch13/page/sen0414_ch13_page_v9_95_0.html" .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Main menu"@en ;
    skos:definition "The main menu is the permanent top bar with the items Start, Learn, Maps, Lab, Agents, Practice, Reference, About, and a click on an item changes the main area first."@en ; dcterms:source "03-materials/ch13/page/sen0414_ch13_page_v9_95_0.html" .
