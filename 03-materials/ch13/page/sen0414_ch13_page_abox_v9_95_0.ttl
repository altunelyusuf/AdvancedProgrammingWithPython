pg:CE_01 a ipo:CodeExample ; rdfs:label "A URL cut into its parts"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 6 of the deck and runs 6 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 6 ; sen0414:orderInTab 1 ;
    sen0414:code "from urllib.parse import urlsplit\nurl = ('https://api.openweathermap.org/geo/1.0/direct'\n       '?q=Boston&appid=KEY#top')\nparts = urlsplit(url)\nfor name in ('scheme', 'netloc', 'path', 'query', 'fragment'):\n    print(name.ljust(8), getattr(parts, name))" ; sen0414:expectedOutput "scheme   https\nnetloc   api.openweathermap.org\npath     /geo/1.0/direct\nquery    q=Boston&appid=KEY\nfragment top\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "quote and parse_qs"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 7 of the deck and runs 4 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 2 ;
    sen0414:code "from urllib.parse import parse_qs, quote\nprint(quote('777 Valencia St, San Francisco'))\nquery = parse_qs('q=San+Francisco%2CCA&appid=KEY')\nprint(query)" ; sen0414:expectedOutput "777%20Valencia%20St%2C%20San%20Francisco\n{'q': ['San Francisco,CA'], 'appid': ['KEY']}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "HTTP status codes and their classes"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 8 of the deck and runs 4 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 3 ;
    sen0414:code "from http import HTTPStatus\nfor code in (200, 301, 404, 429, 500):\n    status = HTTPStatus(code)\n    print(code, status.phrase, '| class', code // 100)" ; sen0414:expectedOutput "200 OK | class 2\n301 Moved Permanently | class 3\n404 Not Found | class 4\n429 Too Many Requests | class 4\n500 Internal Server Error | class 5\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "The user-agent header"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 9 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 4 ;
    sen0414:code "import urllib.request\nopener = urllib.request.build_opener()\nname, value = opener.addheaders[0]\nprint(name, '->', value.split('/')[0])\nurl = 'https://example.com/'\nheaders = {'User-Agent': 'MyBot/1.0'}\nrequest = urllib.request.Request(url, headers=headers)\nprint(request.get_header('User-agent'))" ; sen0414:expectedOutput "User-agent -> Python-urllib\nMyBot/1.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "robots.txt rules with can_fetch"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 10 of the deck and runs 6 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 5 ;
    sen0414:code "import urllib.robotparser as rp\nrobots = rp.RobotFileParser()\nrobots.parse(['User-agent: *', 'Disallow: /simple/',\n              'Disallow: /account/'])\nfor path in ('/project/x/', '/simple/x/', '/account/login/'):\n    print(path, robots.can_fetch('*', 'https://pypi.org' + path))" ; sen0414:expectedOutput "/project/x/ True\n/simple/x/ False\n/account/login/ False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Crawl-delay and a polite pause"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 12 of the deck and runs 9 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 12 ; sen0414:orderInTab 6 ;
    sen0414:code "import urllib.robotparser as rp\nrobots = rp.RobotFileParser()\nrobots.parse(['User-agent: *', 'Crawl-delay: 2',\n              'Request-rate: 3/20'])\npause = robots.crawl_delay('*')\nrate = robots.request_rate('*')\nprint('wait', pause, 'seconds; rate', tuple(rate))\nfor page, clock in zip('abc', range(0, 6, pause)):\n    print('t =', clock, 'fetch page', page)" ; sen0414:expectedOutput "wait 2 seconds; rate (3, 20)\nt = 0 fetch page a\nt = 2 fetch page b\nt = 4 fetch page c\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "webbrowser.open with a recording stand-in"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 17 of the deck and runs 5 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 17 ; sen0414:orderInTab 7 ;
    sen0414:code "import webbrowser\nopened = []\nwebbrowser.open = lambda url: opened.append(url) or True\nprint(webbrowser.open('https://inventwithpython.com/'))\nprint(opened)" ; sen0414:expectedOutput "True\n['https://inventwithpython.com/']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "showmap.py builds a map address"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 18 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 18 ; sen0414:orderInTab 8 ;
    sen0414:code "from urllib.parse import quote\nargv = ['showmap.py', '777', 'Valencia', 'St,',\n        'San', 'Francisco,', 'CA', '94110']\naddress = ' '.join(argv[1:])\nsearch = 'https://www.openstreetmap.org/search?query='\nurl = search + quote(address)\nprint(address)\nprint(url)" ; sen0414:expectedOutput "777 Valencia St, San Francisco, CA 94110\nhttps://www.openstreetmap.org/search?query=777%20Valencia%20St%2C%20San%20Francisco%2C%20CA%2094110\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "urlopen on a data address"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 19 of the deck and runs 5 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 9 ;
    sen0414:code "from urllib.request import urlopen\nreply = urlopen('data:text/plain,Romeo%20and%20Juliet')\nprint(reply.headers.get_content_type())\nbody = reply.read()\nprint(len(body), 'bytes:', body.decode('utf-8'))" ; sen0414:expectedOutput "text/plain\n16 bytes: Romeo and Juliet\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "A raise_for_status stand-in"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 21 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 21 ; sen0414:orderInTab 10 ;
    sen0414:code "from http import HTTPStatus\ndef raise_for_status(code):\n    if code >= 400:\n        phrase = HTTPStatus(code).phrase\n        raise RuntimeError('%d %s' % (code, phrase))\nfor code in (200, 404, 500):\n    try:\n        raise_for_status(code)\n        print(code, 'fine')\n    except RuntimeError as err:\n        print(code, 'stopped:', err)" ; sen0414:expectedOutput "200 fine\n404 stopped: 404 Not Found\n500 stopped: 500 Internal Server Error\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "iter_content writes in chunks"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 22 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 11 ;
    sen0414:code "import os, tempfile\nbody = b'To be, or not to be, that is the question.'\ndef iter_content(data, size):\n    for start in range(0, len(data), size):\n        yield data[start:start + size]\nwith tempfile.TemporaryDirectory() as folder:\n    with open(os.path.join(folder, 'speech.txt'), 'wb') as file:\n        for chunk in iter_content(body, 16):\n            print(file.write(chunk))" ; sen0414:expectedOutput "16\n16\n10\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "json.loads reads an API reply"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 25 of the deck and runs 6 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 12 ;
    sen0414:code "import json\nreply = ('{'name': 'Boston', 'main': {'temp': 285.44},'\n         ' 'weather': [{'main': 'Clouds'}]}')\ndata = json.loads(reply)\nprint(data['name'], data['weather'][0]['main'])\nprint(type(data).__name__, list(data))" ; sen0414:expectedOutput "Boston Clouds\ndict ['name', 'main', 'weather']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Kelvin to Celsius and Fahrenheit"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 26 of the deck and runs 4 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 13 ;
    sen0414:code "kelvin = 285.44\ncelsius = kelvin - 273.15\nfahrenheit = celsius * 9 / 5 + 32\nprint('Result: %.1f C and %.1f F' % (celsius, fahrenheit))" ; sen0414:expectedOutput "Result: 12.3 C and 54.1 F\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "An endpoint with an API key"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 27 of the deck and runs 6 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 27 ; sen0414:orderInTab 14 ;
    sen0414:code "from urllib.parse import urlencode\nendpoint = 'https://api.openweathermap.org/data/2.5/forecast'\nparams = {'lat': 42.36, 'lon': -71.06, 'appid': 'KEY'}\nurl = endpoint + '?' + urlencode(params)\nprint(url)\nprint(url.replace('KEY', '***'))" ; sen0414:expectedOutput "https://api.openweathermap.org/data/2.5/forecast?lat=42.36&lon=-71.06&appid=KEY\nhttps://api.openweathermap.org/data/2.5/forecast?lat=42.36&lon=-71.06&appid=***\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "HTMLParser lists the tags and attributes"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 31 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 31 ; sen0414:orderInTab 15 ;
    sen0414:code "from html.parser import HTMLParser\nclass Outline(HTMLParser):\n    def handle_starttag(self, tag, attrs):\n        print(tag, dict(attrs))\npage = ('<p id='a'>Hello, <b>world</b>!</p>'\n        '<a class='s' href='/x'>link</a>')\nOutline().feed(page)" ; sen0414:expectedOutput "p {'id': 'a'}\nb {}\na {'class': 's', 'href': '/x'}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "select, get_text and get with ElementTree"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 32 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 16 ;
    sen0414:code "import xml.etree.ElementTree as ET\npage = ('<div><p id='a'>Hello, <b>world</b>!</p>'\n        '<p class='s'><a href='/x'>link</a></p></div>')\nroot = ET.fromstring(page)\nby_id = root.findall('.//*[@id='a']')\nprint(len(by_id), repr(''.join(by_id[0].itertext())))\nlink = root.find('.//p[@class='s']/a')\nprint(link.get('href'), link.attrib)\nprint(root.findall('.//*[@class='nope']'))" ; sen0414:expectedOutput "1 'Hello, world!'\n/x {'href': '/x'}\n[]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "A regular expression against a parser"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 34 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 34 ; sen0414:orderInTab 17 ;
    sen0414:code "import re\nhtml = '<a href='/x'>x</a> <a class='k' href='/y'>y</a>'\nprint(re.findall('<a href='(.*?)'>', html))\nfrom html.parser import HTMLParser\nclass Links(HTMLParser):\n    found = []\n    def handle_starttag(self, tag, attrs):\n        if tag == 'a':\n            self.found.append(dict(attrs)['href'])\nLinks().feed(html)\nprint(Links.found)" ; sen0414:expectedOutput "['/x']\n['/x', '/y']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "Resolve, defragment and de-duplicate links"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 35 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 18 ;
    sen0414:code "from urllib.parse import urljoin, urldefrag\nsite = 'https://example.com'\npage = site + '/guide/index.html'\nhrefs = ['intro.html', 'intro.html#top', '/about',\n         'https://other.org/x']\nseen = []\nfor href in hrefs:\n    full, fragment = urldefrag(urljoin(page, href))\n    if full.startswith(site) and full not in seen:\n        seen.append(full)\nprint(seen)" ; sen0414:expectedOutput "['https://example.com/guide/intro.html', 'https://example.com/about']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "The comic image and the Prev link"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 36 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 36 ; sen0414:orderInTab 19 ;
    sen0414:code "import xml.etree.ElementTree as ET\nfrom urllib.parse import urljoin\npage = ('<body><div id='comic'>'\n        '<img src='//imgs.xkcd.com/comics/x.png'/></div>'\n        '<a rel='prev' href='/2/'>Prev</a></body>')\nroot = ET.fromstring(page)\nsrc = root.find('.//*[@id='comic']/img').get('src')\nprev = root.find('.//a[@rel='prev']').get('href')\nprint(urljoin('https://xkcd.com/3/', src))\nprint(urljoin('https://xkcd.com/3/', prev))" ; sen0414:expectedOutput "https://imgs.xkcd.com/comics/x.png\nhttps://xkcd.com/2/\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "Open the first search results"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 37 of the deck and runs 9 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 20 ;
    sen0414:code "import webbrowser, xml.etree.ElementTree as ET\nopened = []\nwebbrowser.open = opened.append\npage = ('<ul><a href='/p/one'/><a href='/p/two'/>'\n        '<a href='/p/three'/></ul>')\nlinks = ET.fromstring(page).findall('.//a')\nfor link in links[:2]:\n    webbrowser.open('https://pypi.org' + link.get('href'))\nprint(len(links), 'found;', opened)" ; sen0414:expectedOutput "3 found; ['https://pypi.org/p/one', 'https://pypi.org/p/two']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "A page built by a script"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 41 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 41 ; sen0414:orderInTab 21 ;
    sen0414:code "import xml.etree.ElementTree as ET\nsource = ('<body><div id='app'></div>'\n          '<script>show('Built by a script')</script></body>')\nroot = ET.fromstring(source)\napp = root.find('.//*[@id='app']')\nprint('text in the source:', repr(app.text))\nscript = root.find('.//script').text\napp.text = script.split(''')[1]\nprint('after the script ran:', repr(app.text))" ; sen0414:expectedOutput "text in the source: None\nafter the script ran: 'Built by a script'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
pg:CE_22 a ipo:CodeExample ; rdfs:label "find_element and find_elements"@en ;
    skos:definition "Example 22 of the chapter-code tab comes from slide 43 of the deck and runs 12 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 43 ; sen0414:orderInTab 22 ;
    sen0414:code "import xml.etree.ElementTree as ET\nroot = ET.fromstring('<body><p>one</p><p>two</p></body>')\ndef find_elements(path):\n    return root.findall(path)\ndef find_element(path):\n    return find_elements(path)[0]\nprint(len(find_elements('.//p')), find_element('.//p').text)\nprint(find_elements('.//h1'))\ntry:\n    find_element('.//h1')\nexcept IndexError:\n    print('Result: find_element fails when nothing matches')" ; sen0414:expectedOutput "2 one\n[]\nResult: find_element fails when nothing matches\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_22 .
pg:CE_23 a ipo:CodeExample ; rdfs:label "The shape of a Playwright program"@en ;
    skos:definition "Example 23 of the chapter-code tab comes from slide 44 of the deck and runs 13 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 44 ; sen0414:orderInTab 23 ;
    sen0414:code "from contextlib import nullcontext\nclass Page:\n    def goto(self, url):\n        print('visiting', url)\n    def locator(self, css):\n        return 'element ' + css\nclass Playwright:\n    def new_page(self):\n        return Page()\nwith nullcontext(Playwright()) as p:\n    page = p.new_page()\n    page.goto('https://example.com/')\n    print(page.locator('h1'))" ; sen0414:expectedOutput "visiting https://example.com/\nelement h1\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_23 .
pg:CE_24 a ipo:CodeExample ; rdfs:label "Auto-waiting for an element"@en ;
    skos:definition "Example 24 of the chapter-code tab comes from slide 46 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch13/page/chapter_code_ch13_v1_0_0.json" ;
    sen0414:slideNumber 46 ; sen0414:orderInTab 24 ;
    sen0414:code "looks = [None, None, 'Hello']  # what each look sees\ndef locator_text(limit):\n    for look, text in enumerate(looks[:limit], 1):\n        if text is not None:\n            return 'found %r on look %d' % (text, look)\n    return 'timeout after %d looks' % limit\nprint(locator_text(5))\nprint(locator_text(2))" ; sen0414:expectedOutput "found 'Hello' on look 3\ntimeout after 2 looks\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_24 .
