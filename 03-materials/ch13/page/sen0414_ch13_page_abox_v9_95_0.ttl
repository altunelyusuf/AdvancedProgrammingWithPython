pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 13 Stage 3 document"@en ;
    skos:definition "The source document is the Stage 3 document of chapter 13, which has one section for each of the 94 concepts of the chapter."@en ; dcterms:source <http://example.org/sen0414/ch13/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4, pg:CO5 .
