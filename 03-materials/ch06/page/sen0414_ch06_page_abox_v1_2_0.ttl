    sen0414:pythonUsed "Python 3.14.4" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Sidebar and main content"@en .
pg:Header a ipo:Header ; rdfs:label "Sticky header with grouped section bar"@en .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Section tree"@en .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Grouped permanent top bar"@en .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 6 Stage 3 document"@en ; dcterms:source <http://example.org/sen0414/ch06/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4, pg:CO5 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Read items and runs of items from a list with indexes, negative indexes and slices, and predict what an index or slice past the end does"@en ; ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Change a list in place with append, insert, item and slice assignment, remove, pop and del, and tell which of them return None"@en ; ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Search, join and order lists with in, index, + and *, sort and sorted, and predict which operations change the list and which give a new one"@en ; ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Take a list apart with for loops, enumerate, list comprehensions and unpacking, and explain why removing items during a loop skips some"@en ; ld:bloomLevel ld:Apply  .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Analyze how names, function arguments and copies share list objects, and choose between a shallow and a deep copy"@en ; ld:bloomLevel ld:Analyze  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "For spam = ['cat', 'bat', 'rat', 'elephant'], what does spam[1:10] give?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "" ; ld:distractorRationale "A slice that runs past the end is cut short and does not raise; only a single index that is out of range raises IndexError." ; ld:distractorRationale "The slice stops at the end of the list, not at index 3." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "['bat', 'rat', 'elephant']" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "IndexError: list index out of range" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "['bat', 'rat']" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What is len([1, [2, 3], 4])?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "4 counts the items of the inner list as well." ; ld:distractorRationale "" ; ld:distractorRationale "2 is the length of the inner list, not of the outer one." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "4" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "3" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "2" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "spam = [3, 4, 5] and x = spam.append(6) are run. What are x and spam?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "append() returns None, not the item it added." ; ld:distractorRationale "" ; ld:distractorRationale "append() changes the list but does not return it." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "6 and [3, 4, 5, 6]" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "None and [3, 4, 5, 6]" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "[3, 4, 5, 6] and [3, 4, 5, 6]" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "spam = ['cat', 'bat', 'rat', 'cat']. After spam.remove('cat') and then spam.pop(0), what is spam?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "remove() deletes only the first match, so the last 'cat' is still there." ; ld:distractorRationale "pop(0) removes the first item, which is 'bat' by then, and not the last one." ; ld:distractorRationale "" .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "['rat']" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "['bat', 'rat']" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "['rat', 'cat']" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "spam = [2, 1, 3]. After eggs = sorted(spam) and spam.reverse(), what are spam and eggs?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "" ; ld:distractorRationale "sorted() made a separate list, so reversing spam does not reorder eggs, and spam was never sorted." ; ld:distractorRationale "spam was never sorted, so reversing it gives [3, 1, 2]." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "spam is [3, 1, 2] and eggs is [1, 2, 3]" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "spam is [3, 2, 1] and eggs is [3, 2, 1]" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "spam is [1, 2, 3] and eggs is [3, 2, 1]" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why does sorted(['b', 'A', 'c']) put 'A' first?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "" ; ld:distractorRationale "Without a key function the comparison is by code point, so case is not ignored." ; ld:distractorRationale "Length plays no part in the order of strings." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "Capital letters sort before lowercase ones" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "sorted() ignores the case of letters" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "'A' is the shortest item" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does [n * 2 for n in [1, 2, 3] if n != 2] give?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "The condition drops the item 2 before the doubling." ; ld:distractorRationale "The items are doubled as well as filtered." ; ld:distractorRationale "" .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "[2, 4, 6]" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "[1, 3]" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "[2, 6]" .
pg:Q8 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "After first, *rest = [1, 2, 3], what is rest?"@en ; ld:hasOption pg:Q8_O0, pg:Q8_O1, pg:Q8_O2 ; ld:hasCorrectOption pg:Q8_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "" ; ld:distractorRationale "A starred name always receives a list, never a tuple." ; ld:distractorRationale "The starred name collects every remaining item, not only the next one." .
pg:Q8_O0 a ld:AnswerOption ; rdfs:label "[2, 3]" .
pg:Q8_O1 a ld:AnswerOption ; rdfs:label "(2, 3)" .
pg:Q8_O2 a ld:AnswerOption ; rdfs:label "2" .
pg:Q9 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "a = [1, 2] and b = a and b.append(3) are run. What is a?"@en ; ld:hasOption pg:Q9_O0, pg:Q9_O1, pg:Q9_O2 ; ld:hasCorrectOption pg:Q9_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "b = a copied nothing, so a is the same list as b." ; ld:distractorRationale "" ; ld:distractorRationale "Nothing here raises an exception." .
pg:Q9_O0 a ld:AnswerOption ; rdfs:label "[1, 2]" .
pg:Q9_O1 a ld:AnswerOption ; rdfs:label "[1, 2, 3]" .
pg:Q9_O2 a ld:AnswerOption ; rdfs:label "An error" .
pg:Q10 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "rows = [[0] * 2] * 2 and then rows[0][0] = 1 are run. What is rows?"@en ; ld:hasOption pg:Q10_O0, pg:Q10_O1, pg:Q10_O2 ; ld:hasCorrectOption pg:Q10_O1 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "This is what [[0] * 2 for _ in range(2)] would give; the product shares one inner list." ; ld:distractorRationale "" ; ld:distractorRationale "The assignment does change an item, in the shared inner list." .
pg:Q10_O0 a ld:AnswerOption ; rdfs:label "[[1, 0], [0, 0]]" .
pg:Q10_O1 a ld:AnswerOption ; rdfs:label "[[1, 0], [1, 0]]" .
pg:Q10_O2 a ld:AnswerOption ; rdfs:label "[[0, 0], [0, 0]]" .
pg:Q11 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A function runs spam = spam + ['x'] on the list it received. Why does the caller's list not change?"@en ; ld:hasOption pg:Q11_O0, pg:Q11_O1, pg:Q11_O2 ; ld:hasCorrectOption pg:Q11_O1 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "A function that calls append() on its parameter does change the caller's list, so no copy is made." ; ld:distractorRationale "" ; ld:distractorRationale "The function does receive a reference to the caller's list, which is why append() would change it." .
pg:Q11_O0 a ld:AnswerOption ; rdfs:label "Lists passed to a function are always copied" .
pg:Q11_O1 a ld:AnswerOption ; rdfs:label "+ builds a new list, and only the function's own name is rebound to it" .
pg:Q11_O2 a ld:AnswerOption ; rdfs:label "A function cannot see the caller's lists" .
