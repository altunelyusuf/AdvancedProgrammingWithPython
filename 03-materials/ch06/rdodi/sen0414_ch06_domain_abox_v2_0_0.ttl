ch06:Err_Index a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "[1, 2, 3][10] raises IndexError: list index out of range"@en .
ch06:X_Index rd:hasErrorCondition ch06:Err_Index .
ch06:Err_IndexMethod a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "['a'].index('b') raises ValueError: list.index(x): x not in list (Python 3.14; 'b' is not in list in 3.12 and 3.13)"@en .
ch06:X_IndexMethod rd:hasErrorCondition ch06:Err_IndexMethod .
ch06:Err_SortMethod a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "[1, 'a'].sort() raises TypeError: '<' not supported between instances of 'str' and 'int'"@en .
ch06:X_SortMethod rd:hasErrorCondition ch06:Err_SortMethod .
ch06:Err_MultipleAssignment a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "[a for a, b in [[1, 2, 3]]] raises ValueError: too many values to unpack (expected 2, got 3)"@en .
ch06:X_MultipleAssignment rd:hasErrorCondition ch06:Err_MultipleAssignment .
ch06:Err_MutableImmutable a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "exec('t = (1, 2); t[0] = 9') raises TypeError: 'tuple' object does not support item assignment"@en .
ch06:X_MutableImmutable rd:hasErrorCondition ch06:Err_MutableImmutable .
ch06:Err_RandomChoice a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('random').choice([]) raises IndexError: Cannot choose from an empty sequence"@en .
ch06:X_RandomChoice rd:hasErrorCondition ch06:Err_RandomChoice .

ch06:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 6 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch06/research> ;
    rd:hasCompetencyQuestion ch06:CQs ; rd:hasSourceProvenance ch06:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment ch06:Env .
ch06:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 6 competency questions"@en ;
    rd:containsCompetencyQuestion ch06:CQ1, ch06:CQ2, ch06:CQ3 .
ch06:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which operations of the list data type read, replace, add, remove, find, order and combine items, and which of them change the list in place and which give a new value?"@en .
ch06:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How do names, references, copies and function arguments decide whether a change to a list is seen elsewhere in a program, and when must a program copy?"@en .
ch06:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs and error messages of the chapter differ in current Python, and which forms that current practice uses (enumerate, comprehensions, starred unpacking, sorted) does the chapter leave out?"@en .
ch06:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 6 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 6 through the Stage 1 research artefact; the concepts for list comprehensions, starred unpacking, the sorted function, hashing and the history of the shuffle, and the version differences, come from that artefact's secondary sources (the Python documentation and PEPs, Fisher and Yates, Durstenfeld, Knuth), not from the book."@en ;
    dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.12.3, CPython 3.13.16 and CPython 3.14.6"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (283 checks listed in sen0414_ch06_corpus_v1_0_0.py), executed under CPython 3.12.3, CPython 3.13.16 and CPython 3.14.6: identical output where more than one was used."@en ;
    dcterms:source "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch06_corpus_v1_0_0.py" .

