ch06:X_List a owl:NamedIndividual, ch06:List ; rdfs:label "['hello', 3.1415, True, None, 42]"@en ; skos:definition "A list is a value that holds an ordered sequence of items between square brackets, separated by commas; the items can be of any type, and the list [] holds none."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_List a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(['hello', 3.1415, True, None, 42]) evaluates to 5"@en ; ch06:input "len(['hello', 3.1415, True, None, 42])" ; ch06:output "5" .
ch06:X_List rd:hasIOExample ch06:IO_List .
ch06:X_ListLength a owl:NamedIndividual, ch06:ListLength ; rdfs:label "len(['cat', 'dog', 'moose'])"@en ; skos:definition "The len function returns the number of items in a list; the last valid index of a list is its length minus one."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_ListLength a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(['cat', 'dog', 'moose']) evaluates to 3"@en ; ch06:input "len(['cat', 'dog', 'moose'])" ; ch06:output "3" .
ch06:X_ListLength rd:hasIOExample ch06:IO_ListLength .
ch06:X_Index a owl:NamedIndividual, ch06:Index ; rdfs:label "spam[3] for ['cat', 'bat', 'rat', 'elephant']"@en ; skos:definition "An index is the integer in square brackets after a list that selects the item at that position; the first item is at index 0, and an index beyond the list raises an IndexError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_Index a owl:NamedIndividual, rd:IOExample ; rdfs:label "['cat', 'bat', 'rat', 'elephant'][3] evaluates to 'elephant'"@en ; ch06:input "['cat', 'bat', 'rat', 'elephant'][3]" ; ch06:output "'elephant'" .
ch06:X_Index rd:hasIOExample ch06:IO_Index .
ch06:X_NegativeIndex a owl:NamedIndividual, ch06:NegativeIndex ; rdfs:label "spam[-1] for ['cat', 'bat', 'rat', 'elephant']"@en ; skos:definition "A negative index counts from the end of the list: -1 is the last item, -2 the one before it, and so on."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_NegativeIndex a owl:NamedIndividual, rd:IOExample ; rdfs:label "['cat', 'bat', 'rat', 'elephant'][-3] evaluates to 'bat'"@en ; ch06:input "['cat', 'bat', 'rat', 'elephant'][-3]" ; ch06:output "'bat'" .
ch06:X_NegativeIndex rd:hasIOExample ch06:IO_NegativeIndex .
ch06:X_NestedList a owl:NamedIndividual, ch06:NestedList ; rdfs:label "spam[1][4] for [['cat', 'bat'], [10, 20, 30, 40, 50]]"@en ; skos:definition "A list can contain other lists, and an item of an inner list is reached with two indexes in a row: the first picks the inner list, the second the item inside it."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_NestedList a owl:NamedIndividual, rd:IOExample ; rdfs:label "[['cat', 'bat'], [10, 20, 30, 40, 50]][1][4] evaluates to 50"@en ; ch06:input "[['cat', 'bat'], [10, 20, 30, 40, 50]][1][4]" ; ch06:output "50" .
ch06:X_NestedList rd:hasIOExample ch06:IO_NestedList .
ch06:X_Slice a owl:NamedIndividual, ch06:Slice ; rdfs:label "spam[1:3] for ['cat', 'bat', 'rat', 'elephant']"@en ; skos:definition "A slice spam[i:j] is a new list of the items from index i up to but not including index j."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_Slice a owl:NamedIndividual, rd:IOExample ; rdfs:label "['cat', 'bat', 'rat', 'elephant'][1:3] evaluates to ['bat', 'rat']"@en ; ch06:input "['cat', 'bat', 'rat', 'elephant'][1:3]" ; ch06:output "['bat', 'rat']" .
ch06:X_Slice rd:hasIOExample ch06:IO_Slice .
ch06:X_SliceDefaults a owl:NamedIndividual, ch06:SliceDefaults ; rdfs:label "spam[:2], spam[1:], spam[:]"@en ; skos:definition "Leaving out the first number of a slice means 0 and leaving out the second means the length of the list; spam[:] is a copy of the whole list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_SliceDefaults a owl:NamedIndividual, rd:IOExample ; rdfs:label "['cat', 'bat', 'rat', 'elephant'][:2] evaluates to ['cat', 'bat']"@en ; ch06:input "['cat', 'bat', 'rat', 'elephant'][:2]" ; ch06:output "['cat', 'bat']" .
ch06:X_SliceDefaults rd:hasIOExample ch06:IO_SliceDefaults .
ch06:X_SliceStep a owl:NamedIndividual, ch06:SliceStep ; rdfs:label "list(range(10))[::3]"@en ; skos:definition "A slice can carry a third number, the step: s[i:j:k] takes every kth item, and a negative step walks backwards, so s[::-1] is a reversed copy."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_SliceStep a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(10))[::3] evaluates to [0, 3, 6, 9]"@en ; ch06:input "list(range(10))[::3]" ; ch06:output "[0, 3, 6, 9]" .
ch06:X_SliceStep rd:hasIOExample ch06:IO_SliceStep .
ch06:X_ItemAssignment a owl:NamedIndividual, ch06:ItemAssignment ; rdfs:label "spam[1] = 'aardvark'"@en ; skos:definition "Assigning to an index replaces the item at that position, in place; the length of the list does not change."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_ItemAssignment a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'bat', 'rat', 'elephant'], s.__setitem__(1, 'aardvark'), s)[2] evaluates to ['cat', 'aardvark', 'rat', 'elephant']"@en ; ch06:input "(s := ['cat', 'bat', 'rat', 'elephant'], s.__setitem__(1, 'aardvark'), s)[2]" ; ch06:output "['cat', 'aardvark', 'rat', 'elephant']" .
ch06:X_ItemAssignment rd:hasIOExample ch06:IO_ItemAssignment .
ch06:X_AppendMethod a owl:NamedIndividual, ch06:AppendMethod ; rdfs:label "spam.append('moose')"@en ; skos:definition "The append method adds its argument as one item to the end of the list, changes the list in place and returns None."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_AppendMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'dog', 'bat'], s.append('moose'), s)[2] evaluates to ['cat', 'dog', 'bat', 'moose']"@en ; ch06:input "(s := ['cat', 'dog', 'bat'], s.append('moose'), s)[2]" ; ch06:output "['cat', 'dog', 'bat', 'moose']" .
ch06:X_AppendMethod rd:hasIOExample ch06:IO_AppendMethod .
ch06:X_InsertMethod a owl:NamedIndividual, ch06:InsertMethod ; rdfs:label "spam.insert(1, 'chicken')"@en ; skos:definition "The insert method puts an item at a chosen index and moves the items from that index on one place along; like append it changes the list and returns None."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_InsertMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'dog', 'bat'], s.insert(1, 'chicken'), s)[2] evaluates to ['cat', 'chicken', 'dog', 'bat']"@en ; ch06:input "(s := ['cat', 'dog', 'bat'], s.insert(1, 'chicken'), s)[2]" ; ch06:output "['cat', 'chicken', 'dog', 'bat']" .
ch06:X_InsertMethod rd:hasIOExample ch06:IO_InsertMethod .
ch06:X_ExtendMethod a owl:NamedIndividual, ch06:ExtendMethod ; rdfs:label "spam.extend(['A', 'B'])"@en ; skos:definition "The extend method adds every item of an iterable to the end of the list, one by one, in place; unlike append it does not nest a list argument."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_ExtendMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := [1, 2, 3], s.extend(['A', 'B']), s)[2] evaluates to [1, 2, 3, 'A', 'B']"@en ; ch06:input "(s := [1, 2, 3], s.extend(['A', 'B']), s)[2]" ; ch06:output "[1, 2, 3, 'A', 'B']" .
ch06:X_ExtendMethod rd:hasIOExample ch06:IO_ExtendMethod .
ch06:X_DelStatement a owl:NamedIndividual, ch06:DelStatement ; rdfs:label "del spam[2]"@en ; skos:definition "The del statement deletes the item at an index, or a slice, or a whole variable; the items after a deleted item move up one place."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_DelStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'bat', 'rat', 'elephant'], s.__delitem__(2), s)[2] evaluates to ['cat', 'bat', 'elephant']"@en ; ch06:input "(s := ['cat', 'bat', 'rat', 'elephant'], s.__delitem__(2), s)[2]" ; ch06:output "['cat', 'bat', 'elephant']" .
ch06:X_DelStatement rd:hasIOExample ch06:IO_DelStatement .
ch06:X_RemoveMethod a owl:NamedIndividual, ch06:RemoveMethod ; rdfs:label "spam.remove('bat')"@en ; skos:definition "The remove method deletes the first item equal to its argument and raises a ValueError when there is none; it returns None."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_RemoveMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'bat', 'rat', 'cat', 'hat', 'cat'], s.remove('cat'), s)[2] evaluates to ['bat', 'rat', 'cat', 'hat', 'cat']"@en ; ch06:input "(s := ['cat', 'bat', 'rat', 'cat', 'hat', 'cat'], s.remove('cat'), s)[2]" ; ch06:output "['bat', 'rat', 'cat', 'hat', 'cat']" .
ch06:X_RemoveMethod rd:hasIOExample ch06:IO_RemoveMethod .
ch06:X_PopMethod a owl:NamedIndividual, ch06:PopMethod ; rdfs:label "spam.pop()"@en ; skos:definition "The pop method removes the item at an index, by default the last one, and returns it; it raises an IndexError on an empty list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_PopMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := [3, 4, 5], s.pop(), s)[1:] evaluates to (5, [3, 4])"@en ; ch06:input "(s := [3, 4, 5], s.pop(), s)[1:]" ; ch06:output "(5, [3, 4])" .
ch06:X_PopMethod rd:hasIOExample ch06:IO_PopMethod .
ch06:X_Concatenation a owl:NamedIndividual, ch06:Concatenation ; rdfs:label "[1, 2, 3] + ['A', 'B', 'C']"@en ; skos:definition "The + operator joins two lists into a new list and leaves both operands unchanged; both operands must be lists."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_Concatenation a owl:NamedIndividual, rd:IOExample ; rdfs:label "[1, 2, 3] + ['A', 'B', 'C'] evaluates to [1, 2, 3, 'A', 'B', 'C']"@en ; ch06:input "[1, 2, 3] + ['A', 'B', 'C']" ; ch06:output "[1, 2, 3, 'A', 'B', 'C']" .
ch06:X_Concatenation rd:hasIOExample ch06:IO_Concatenation .
ch06:X_Replication a owl:NamedIndividual, ch06:Replication ; rdfs:label "['X', 'Y', 'Z'] * 3"@en ; skos:definition "The * operator repeats a list the given number of times in a new list; the repeated items are the same objects, not copies."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_Replication a owl:NamedIndividual, rd:IOExample ; rdfs:label "['X', 'Y', 'Z'] * 3 evaluates to ['X', 'Y', 'Z', 'X', 'Y', 'Z', 'X', 'Y', 'Z']"@en ; ch06:input "['X', 'Y', 'Z'] * 3" ; ch06:output "['X', 'Y', 'Z', 'X', 'Y', 'Z', 'X', 'Y', 'Z']" .
ch06:X_Replication rd:hasIOExample ch06:IO_Replication .
ch06:X_AugmentedAssignment a owl:NamedIndividual, ch06:AugmentedAssignment ; rdfs:label "spam += 1, bacon *= 3"@en ; skos:definition "An augmented assignment such as += or *= combines an operator with an assignment; for a list it changes the list in place."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_AugmentedAssignment a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['Zophie'], s.__imul__(3))[1] evaluates to ['Zophie', 'Zophie', 'Zophie']"@en ; ch06:input "(s := ['Zophie'], s.__imul__(3))[1]" ; ch06:output "['Zophie', 'Zophie', 'Zophie']" .
ch06:X_AugmentedAssignment rd:hasIOExample ch06:IO_AugmentedAssignment .
ch06:X_Method a owl:NamedIndividual, ch06:Method ; rdfs:label "spam.index('hello')"@en ; skos:definition "A method is a function that is called on a value, written value.name(arguments); each data type has its own methods, and calling a list method on a string raises an AttributeError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_Method a owl:NamedIndividual, rd:IOExample ; rdfs:label "['hello', 'hi'].index('hello') evaluates to 0"@en ; ch06:input "['hello', 'hi'].index('hello')" ; ch06:output "0" .
ch06:X_Method rd:hasIOExample ch06:IO_Method .
ch06:X_Membership a owl:NamedIndividual, ch06:Membership ; rdfs:label "'howdy' in ['hello', 'hi', 'howdy', 'heyas']"@en ; skos:definition "The in operator gives True if a value equals an item of the list and False otherwise, and not in gives the opposite."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_Membership a owl:NamedIndividual, rd:IOExample ; rdfs:label "'howdy' in ['hello', 'hi', 'howdy', 'heyas'] evaluates to True"@en ; ch06:input "'howdy' in ['hello', 'hi', 'howdy', 'heyas']" ; ch06:output "True" .
ch06:X_Membership rd:hasIOExample ch06:IO_Membership .
ch06:X_IndexMethod a owl:NamedIndividual, ch06:IndexMethod ; rdfs:label "spam.index('Pooka')"@en ; skos:definition "The index method returns the index of the first item equal to the value and raises a ValueError if there is none."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_IndexMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "['Zophie', 'Pooka', 'Fat-tail', 'Pooka'].index('Pooka') evaluates to 1"@en ; ch06:input "['Zophie', 'Pooka', 'Fat-tail', 'Pooka'].index('Pooka')" ; ch06:output "1" .
ch06:X_IndexMethod rd:hasIOExample ch06:IO_IndexMethod .
ch06:X_ShortCircuit a owl:NamedIndividual, ch06:ShortCircuit ; rdfs:label "len(spam) > 0 and spam[0] == 'cat'"@en ; skos:definition "The operators and and or stop as soon as the left operand decides the result and do not evaluate the right operand, so a test on the left can guard an expression on the right."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_ShortCircuit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: len(spam) > 0 and spam[0] == 'cat')([]) evaluates to False"@en ; ch06:input "(lambda spam: len(spam) > 0 and spam[0] == 'cat')([])" ; ch06:output "False" .
ch06:X_ShortCircuit rd:hasIOExample ch06:IO_ShortCircuit .
ch06:X_SortMethod a owl:NamedIndividual, ch06:SortMethod ; rdfs:label "spam.sort()"@en ; skos:definition "The sort method orders the items of the list in place, from small to large, and returns None; it cannot compare numbers with strings and orders strings by character code."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_SortMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := [2, 5, 3.14, 1, -7], s.sort(), s)[2] evaluates to [-7, 1, 2, 3.14, 5]"@en ; ch06:input "(s := [2, 5, 3.14, 1, -7], s.sort(), s)[2]" ; ch06:output "[-7, 1, 2, 3.14, 5]" .
ch06:X_SortMethod rd:hasIOExample ch06:IO_SortMethod .
ch06:X_SortKeyReverse a owl:NamedIndividual, ch06:SortKeyReverse ; rdfs:label "spam.sort(key=str.lower)"@en ; skos:definition "The keyword arguments reverse and key change how sort and sorted compare: reverse=True gives descending order and key names a function applied to each item before the comparison."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_SortKeyReverse a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(['a', 'z', 'A', 'Z'], key=str.lower) evaluates to ['a', 'A', 'z', 'Z']"@en ; ch06:input "sorted(['a', 'z', 'A', 'Z'], key=str.lower)" ; ch06:output "['a', 'A', 'z', 'Z']" .
ch06:X_SortKeyReverse rd:hasIOExample ch06:IO_SortKeyReverse .
ch06:X_ReverseMethod a owl:NamedIndividual, ch06:ReverseMethod ; rdfs:label "spam.reverse()"@en ; skos:definition "The reverse method turns the order of the items around in place and returns None; the slice with step -1 gives a reversed copy and leaves the list unchanged."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_ReverseMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'dog', 'moose'], s.reverse(), s)[2] evaluates to ['moose', 'dog', 'cat']"@en ; ch06:input "(s := ['cat', 'dog', 'moose'], s.reverse(), s)[2]" ; ch06:output "['moose', 'dog', 'cat']" .
ch06:X_ReverseMethod rd:hasIOExample ch06:IO_ReverseMethod .
ch06:X_SortedFunction a owl:NamedIndividual, ch06:SortedFunction ; rdfs:label "sorted(spam)"@en ; skos:definition "The built-in function sorted returns a new ordered list from any iterable and leaves the original unchanged; it takes the same key and reverse arguments as the sort method."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_SortedFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (sorted(s), s))([3, 1, 2]) evaluates to ([1, 2, 3], [3, 1, 2])"@en ; ch06:input "(lambda s: (sorted(s), s))([3, 1, 2])" ; ch06:output "([1, 2, 3], [3, 1, 2])" .
ch06:X_SortedFunction rd:hasIOExample ch06:IO_SortedFunction .
ch06:X_RangeLenLoop a owl:NamedIndividual, ch06:RangeLenLoop ; rdfs:label "for i in range(len(supplies)):"@en ; skos:definition "Writing range(len(some_list)) in a for loop visits every index of the list from 0 to len minus 1, whatever the length, so the body can use both i and some_list[i]."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_RangeLenLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(i, s) for i, s in enumerate(['pens', 'staplers', 'flamethrowers', 'binders'])] evaluates to [(0, 'pens'), (1, 'staplers'), (2, 'flamethrowers'), (3, 'binders')]"@en ; ch06:input "[(i, s) for i, s in enumerate(['pens', 'staplers', 'flamethrowers', 'binders'])]" ; ch06:output "[(0, 'pens'), (1, 'staplers'), (2, 'flamethrowers'), (3, 'binders')]" .
ch06:X_RangeLenLoop rd:hasIOExample ch06:IO_RangeLenLoop .
ch06:X_EnumerateLoop a owl:NamedIndividual, ch06:EnumerateLoop ; rdfs:label "for index, item in enumerate(supplies):"@en ; skos:definition "The built-in function enumerate yields a pair of the index and the item on each pass of the loop, so the body needs no index arithmetic."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_EnumerateLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(enumerate(['pens', 'staplers'])) evaluates to [(0, 'pens'), (1, 'staplers')]"@en ; ch06:input "list(enumerate(['pens', 'staplers']))" ; ch06:output "[(0, 'pens'), (1, 'staplers')]" .
ch06:X_EnumerateLoop rd:hasIOExample ch06:IO_EnumerateLoop .
ch06:X_MutationWhileIterating a owl:NamedIndividual, ch06:MutationWhileIterating ; rdfs:label "for x in items: items.remove(x)"@en ; skos:definition "A list iterator counts positions, so removing items during a for loop moves later items into positions the loop has passed and skips them; loop over a copy or build a new list instead."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_MutationWhileIterating a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda items: ([items.remove(x) for x in items], items)[1])(['a', 'b', 'c', 'd']) evaluates to ['b', 'd']"@en ; ch06:input "(lambda items: ([items.remove(x) for x in items], items)[1])(['a', 'b', 'c', 'd'])" ; ch06:output "['b', 'd']" .
ch06:X_MutationWhileIterating rd:hasIOExample ch06:IO_MutationWhileIterating .
ch06:X_ListComprehension a owl:NamedIndividual, ch06:ListComprehension ; rdfs:label "[x**2 for x in range(10)]"@en ; skos:definition "A list comprehension builds a new list in one expression from an expression, a for clause and an optional if clause, in place of a loop that appends to an empty list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_ListComprehension a owl:NamedIndividual, rd:IOExample ; rdfs:label "[x**2 for x in range(10)] evaluates to [0, 1, 4, 9, 16, 25, 36, 49, 64, 81]"@en ; ch06:input "[x**2 for x in range(10)]" ; ch06:output "[0, 1, 4, 9, 16, 25, 36, 49, 64, 81]" .
ch06:X_ListComprehension rd:hasIOExample ch06:IO_ListComprehension .
ch06:X_MultipleAssignment a owl:NamedIndividual, ch06:MultipleAssignment ; rdfs:label "size, color, disposition = cat"@en ; skos:definition "Assigning a list to several names assigns its items to the names from left to right; the number of names and the length of the list must be equal or Python raises a ValueError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_MultipleAssignment a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(size, color, disposition) for size, color, disposition in [['fat', 'gray', 'loud']]][0] evaluates to ('fat', 'gray', 'loud')"@en ; ch06:input "[(size, color, disposition) for size, color, disposition in [['fat', 'gray', 'loud']]][0]" ; ch06:output "('fat', 'gray', 'loud')" .
ch06:X_MultipleAssignment rd:hasIOExample ch06:IO_MultipleAssignment .
ch06:X_StarredUnpacking a owl:NamedIndividual, ch06:StarredUnpacking ; rdfs:label "first, *rest = cat"@en ; skos:definition "One starred name in an unpacking collects the leftover items into a list, so the counts always agree; the starred name receives an empty list when nothing is left."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_StarredUnpacking a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(first, rest) for first, *rest in [[1, 2, 3, 4]]][0] evaluates to (1, [2, 3, 4])"@en ; ch06:input "[(first, rest) for first, *rest in [[1, 2, 3, 4]]][0]" ; ch06:output "(1, [2, 3, 4])" .
ch06:X_StarredUnpacking rd:hasIOExample ch06:IO_StarredUnpacking .
ch06:X_StringSequence a owl:NamedIndividual, ch06:StringSequence ; rdfs:label "name[0], name[-2], name[0:4], 'Zo' in name"@en ; skos:definition "Strings and range objects are sequences like lists: they can be indexed, sliced, looped over, measured with len and searched with in and not in."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_StringSequence a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Zophie'[0], 'Zophie'[-2], 'Zophie'[0:4], 'Zo' in 'Zophie') evaluates to ('Z', 'i', 'Zoph', True)"@en ; ch06:input "('Zophie'[0], 'Zophie'[-2], 'Zophie'[0:4], 'Zo' in 'Zophie')" ; ch06:output "('Z', 'i', 'Zoph', True)" .
ch06:X_StringSequence rd:hasIOExample ch06:IO_StringSequence .
ch06:X_MutableImmutable a owl:NamedIndividual, ch06:MutableImmutable ; rdfs:label "name[7] = 'the'"@en ; skos:definition "A list is mutable: its items can be added, removed and replaced in place; a string is immutable and an attempt to change one of its characters raises a TypeError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_MutableImmutable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda eggs: (lambda before: (eggs.__setitem__(0, 'x'), id(eggs) == before)[1])(id(eggs)))(['A', 'B', 'C']) evaluates to True"@en ; ch06:input "(lambda eggs: (lambda before: (eggs.__setitem__(0, 'x'), id(eggs) == before)[1])(id(eggs)))(['A', 'B', 'C'])" ; ch06:output "True" .
ch06:X_MutableImmutable rd:hasIOExample ch06:IO_MutableImmutable .
ch06:X_TupleType a owl:NamedIndividual, ch06:TupleType ; rdfs:label "eggs = ('hello', 42, 0.5)"@en ; skos:definition "A tuple is an immutable sequence written with commas, usually in parentheses; it supports indexing, slicing and len like a list but raises a TypeError on item assignment."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_TupleType a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda eggs: (eggs[0], eggs[1:3], len(eggs)))(('hello', 42, 0.5)) evaluates to ('hello', (42, 0.5), 3)"@en ; ch06:input "(lambda eggs: (eggs[0], eggs[1:3], len(eggs)))(('hello', 42, 0.5))" ; ch06:output "('hello', (42, 0.5), 3)" .
ch06:X_TupleType rd:hasIOExample ch06:IO_TupleType .
ch06:X_Aliasing a owl:NamedIndividual, ch06:Aliasing ; rdfs:label "eggs = spam"@en ; skos:definition "Assigning one variable to another copies the reference, not the value, so for a list both names refer to the same list and a change made through either shows through both."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_Aliasing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: (lambda eggs: (eggs.__setitem__(1, 'Hello!'), spam, eggs is spam))(spam))([0, 1, 2, 3])[1:] evaluates to ([0, 'Hello!', 2, 3], True)"@en ; ch06:input "(lambda spam: (lambda eggs: (eggs.__setitem__(1, 'Hello!'), spam, eggs is spam))(spam))([0, 1, 2, 3])[1:]" ; ch06:output "([0, 'Hello!', 2, 3], True)" .
ch06:X_Aliasing rd:hasIOExample ch06:IO_Aliasing .
ch06:X_ListArguments a owl:NamedIndividual, ch06:ListArguments ; rdfs:label "def eggs(some_parameter): some_parameter.append('Hello')"@en ; skos:definition "A function receives a copy of the reference, so a function that changes a list argument in place changes the caller's list, while rebinding the parameter has no effect outside."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_ListArguments a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda eggs: (lambda spam: (eggs(spam), spam)[1])([1, 2, 3]))(lambda p: p.append('Hello')) evaluates to [1, 2, 3, 'Hello']"@en ; ch06:input "(lambda eggs: (lambda spam: (eggs(spam), spam)[1])([1, 2, 3]))(lambda p: p.append('Hello'))" ; ch06:output "[1, 2, 3, 'Hello']" .
ch06:X_ListArguments rd:hasIOExample ch06:IO_ListArguments .
ch06:X_ReplicationAliasing a owl:NamedIndividual, ch06:ReplicationAliasing ; rdfs:label "[[0] * 3] * 2"@en ; skos:definition "Repeating a list with * repeats references to the same items, so a list of lists built this way holds several references to one inner list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_ReplicationAliasing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (g[0].__setitem__(0, 9), g, g[0] is g[1])[1:])([[0] * 3] * 2) evaluates to ([[9, 0, 0], [9, 0, 0]], True)"@en ; ch06:input "(lambda g: (g[0].__setitem__(0, 9), g, g[0] is g[1])[1:])([[0] * 3] * 2)" ; ch06:output "([[9, 0, 0], [9, 0, 0]], True)" .
ch06:X_ReplicationAliasing rd:hasIOExample ch06:IO_ReplicationAliasing .
ch06:X_ShallowCopy a owl:NamedIndividual, ch06:ShallowCopy ; rdfs:label "cheese = copy.copy(spam)"@en ; skos:definition "The function copy.copy makes a new list that holds references to the same items as the original; changing an item of the copy does not change the original, but changing a shared inner list shows through both."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_ShallowCopy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (lambda c: (c.__setitem__(1, 42), s, c))(__import__('copy').copy(s)))(['A', 'B', 'C'])[1:] evaluates to (['A', 'B', 'C'], ['A', 42, 'C'])"@en ; ch06:input "(lambda s: (lambda c: (c.__setitem__(1, 42), s, c))(__import__('copy').copy(s)))(['A', 'B', 'C'])[1:]" ; ch06:output "(['A', 'B', 'C'], ['A', 42, 'C'])" .
ch06:X_ShallowCopy rd:hasIOExample ch06:IO_ShallowCopy .
ch06:X_DeepCopy a owl:NamedIndividual, ch06:DeepCopy ; rdfs:label "copy.deepcopy(spam)"@en ; skos:definition "The function copy.deepcopy copies the list and, recursively, the lists inside it, so nothing is shared between the original and the copy."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_DeepCopy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (lambda c: (c[0].append(9), s, c))(__import__('copy').deepcopy(s)))([[1], [2]])[1:] evaluates to ([[1], [2]], [[1, 9], [2]])"@en ; ch06:input "(lambda s: (lambda c: (c[0].append(9), s, c))(__import__('copy').deepcopy(s)))([[1], [2]])[1:]" ; ch06:output "([[1], [2]], [[1, 9], [2]])" .
ch06:X_DeepCopy rd:hasIOExample ch06:IO_DeepCopy .
ch06:X_RandomChoice a owl:NamedIndividual, ch06:RandomChoice ; rdfs:label "random.choice(pets)"@en ; skos:definition "The function random.choice returns one randomly selected item of a non-empty sequence without changing it; on an empty sequence it raises an IndexError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_RandomChoice a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('random').choice(['Dog', 'Cat', 'Moose']) in ['Dog', 'Cat', 'Moose'] evaluates to True"@en ; ch06:input "__import__('random').choice(['Dog', 'Cat', 'Moose']) in ['Dog', 'Cat', 'Moose']" ; ch06:output "True" .
ch06:X_RandomChoice rd:hasIOExample ch06:IO_RandomChoice .
ch06:X_RandomShuffle a owl:NamedIndividual, ch06:RandomShuffle ; rdfs:label "random.shuffle(people)"@en ; skos:definition "The function random.shuffle reorders the items of a list in place into a random order and returns None; it raises a TypeError for a tuple or a string."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_RandomShuffle a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda people: (__import__('random').shuffle(people), sorted(people))[1])(['Alice', 'Bob', 'Carol', 'David']) evaluates to ['Alice', 'Bob', 'Carol', 'David']"@en ; ch06:input "(lambda people: (__import__('random').shuffle(people), sorted(people))[1])(['Alice', 'Bob', 'Carol', 'David'])" ; ch06:output "['Alice', 'Bob', 'Carol', 'David']" .
ch06:X_RandomShuffle rd:hasIOExample ch06:IO_RandomShuffle .
ch06:X_MagicEightBall a owl:NamedIndividual, ch06:MagicEightBall ; rdfs:label "messages[random.randint(0, len(messages) - 1)]"@en ; skos:definition "The program keeps its nine answers in a list and prints the item at a random index from 0 to len(messages) - 1, so answers can be added or removed without changing any other line."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_MagicEightBall a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(['It is certain', 'It is decidedly so', 'Yes definitely', 'Reply hazy try again', 'Ask again later', 'Concentrate and ask again', 'My reply is no', 'Outlook not so good', 'Very doubtful']) evaluates to 9"@en ; ch06:input "len(['It is certain', 'It is decidedly so', 'Yes definitely', 'Reply hazy try again', 'Ask again later', 'Concentrate and ask again', 'My reply is no', 'Outlook not so good', 'Very doubtful'])" ; ch06:output "9" .
ch06:X_MagicEightBall rd:hasIOExample ch06:IO_MagicEightBall .
ch06:X_MatrixScreensaver a owl:NamedIndividual, ch06:MatrixScreensaver ; rdfs:label "columns = [0] * WIDTH"@en ; skos:definition "The program keeps one counter per output column in a list of WIDTH zeros: a counter above zero means that a stream of binary digits is running in that column and counts the digits left to print."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_MatrixScreensaver a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda W: (len([0] * W), set([0] * W)))(70) evaluates to (70, {0})"@en ; ch06:input "(lambda W: (len([0] * W), set([0] * W)))(70)" ; ch06:output "(70, {0})" .
ch06:X_MatrixScreensaver rd:hasIOExample ch06:IO_MatrixScreensaver .
ch06:X_CommaCode a owl:NamedIndividual, ch06:CommaCode ; rdfs:label "comma_code(['apples', 'bananas', 'tofu', 'cats'])"@en ; skos:definition "The Comma Code function joins the items of any list into one string, separated by commas, with and before the last item, and must work for the empty list and the one-item list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_CommaCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda items: ', '.join(items[:-1]) + ', and ' + items[-1])(['apples', 'bananas', 'tofu', 'cats']) evaluates to 'apples, bananas, tofu, and cats'"@en ; ch06:input "(lambda items: ', '.join(items[:-1]) + ', and ' + items[-1])(['apples', 'bananas', 'tofu', 'cats'])" ; ch06:output "'apples, bananas, tofu, and cats'" .
ch06:X_CommaCode rd:hasIOExample ch06:IO_CommaCode .
ch06:X_CoinFlipStreaks a owl:NamedIndividual, ch06:CoinFlipStreaks ; rdfs:label "some_list[i:i + 6] == ['H'] * 6"@en ; skos:definition "The Coin Flip Streaks program simulates 10,000 experiments of 100 coin flips and counts those with a streak of six equal results, found by comparing slices of six items with a list of six H or six T."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
ch06:IO_CoinFlipStreaks a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: [c.append(sum(c[-5:])) for _ in range(95)] and round(100 * (1 - c[-1] / 2**100), 2))([2, 4, 8, 16, 32]) evaluates to 80.68"@en ; ch06:input "(lambda c: [c.append(sum(c[-5:])) for _ in range(95)] and round(100 * (1 - c[-1] / 2**100), 2))([2, 4, 8, 16, 32])" ; ch06:output "80.68" .
ch06:X_CoinFlipStreaks rd:hasIOExample ch06:IO_CoinFlipStreaks .
