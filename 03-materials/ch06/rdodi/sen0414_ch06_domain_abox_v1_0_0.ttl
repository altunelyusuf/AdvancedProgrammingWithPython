chx:IO_MagicEightBall a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(['It is certain', 'It is decidedly so', 'Yes definitely', 'Reply hazy try again', 'Ask again later', 'Concentrate and ask again', 'My reply is no', 'Outlook not so good', 'Very doubtful']) evaluates to 9"@en ; chx:input "len(['It is certain', 'It is decidedly so', 'Yes definitely', 'Reply hazy try again', 'Ask again later', 'Concentrate and ask again', 'My reply is no', 'Outlook not so good', 'Very doubtful'])" ; chx:output "9" .
chx:X_MagicEightBall rd:hasIOExample chx:IO_MagicEightBall .
