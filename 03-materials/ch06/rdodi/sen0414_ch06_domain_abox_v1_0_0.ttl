chx:IO_MatrixScreensaver a owl:NamedIndividual, rd:IOExample ; rdfs:label "[0] * 5 evaluates to [0, 0, 0, 0, 0]"@en ; chx:input "[0] * 5" ; chx:output "[0, 0, 0, 0, 0]" .
chx:X_MatrixScreensaver rd:hasIOExample chx:IO_MatrixScreensaver .
