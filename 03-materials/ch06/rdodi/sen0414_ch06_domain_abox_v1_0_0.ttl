chx:X_ListType a owl:NamedIndividual, chx:ListType ; rdfs:label "spam = ['cat', 'bat', 'rat', 'elephant']"@en ; skos:definition "A list is an ordered sequence of values written between square brackets and separated by commas; its items may have different types and may be lists themselves."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ListType a owl:NamedIndividual, rd:IOExample ; rdfs:label "[['cat', 'bat'], [10, 20, 30, 40, 50]][1][4] evaluates to 50"@en ; chx:input "[['cat', 'bat'], [10, 20, 30, 40, 50]][1][4]" ; chx:output "50" .
chx:X_ListType rd:hasIOExample chx:IO_ListType .
chx:X_ListLength a owl:NamedIndividual, chx:ListLength ; rdfs:label "len(spam)"@en ; skos:definition "len returns the number of items in a list, and the length of an empty list is 0."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ListLength a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(['cat', 'dog', 'moose']) evaluates to 3"@en ; chx:input "len(['cat', 'dog', 'moose'])" ; chx:output "3" .
chx:X_ListLength rd:hasIOExample chx:IO_ListLength .
chx:X_Indexing a owl:NamedIndividual, chx:Indexing ; rdfs:label "spam[-1]"@en ; skos:definition "An index in square brackets picks one item, counting from 0 at the front and from -1 at the back, so spam[-3] is the third item from the end; an index outside the list raises IndexError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_Indexing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(['cat', 'bat', 'rat', 'elephant'][0], ['cat', 'bat', 'rat', 'elephant'][-3]) evaluates to ('cat', 'bat')"@en ; chx:input "(['cat', 'bat', 'rat', 'elephant'][0], ['cat', 'bat', 'rat', 'elephant'][-3])" ; chx:output "('cat', 'bat')" .
chx:X_Indexing rd:hasIOExample chx:IO_Indexing .
chx:X_Slicing a owl:NamedIndividual, chx:Slicing ; rdfs:label "spam[1:3]"@en ; skos:definition "A slice spam[start:end] is a new list of the items from start up to but not including end; an omitted end is the front or the back, and an end outside the list is clipped instead of raising an error."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_Slicing a owl:NamedIndividual, rd:IOExample ; rdfs:label "['cat', 'bat', 'rat', 'elephant'][1:10] evaluates to ['bat', 'rat', 'elephant']"@en ; chx:input "['cat', 'bat', 'rat', 'elephant'][1:10]" ; chx:output "['bat', 'rat', 'elephant']" .
chx:X_Slicing rd:hasIOExample chx:IO_Slicing .
chx:X_AppendMethod a owl:NamedIndividual, chx:AppendMethod ; rdfs:label "spam.append('moose')"@en ; skos:definition "append adds one item at the end of the list itself and returns None, so writing spam = spam.append(x) loses the list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_AppendMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.append('moose'), s))(['cat', 'dog', 'bat']) evaluates to (None, ['cat', 'dog', 'bat', 'moose'])"@en ; chx:input "(lambda s: (s.append('moose'), s))(['cat', 'dog', 'bat'])" ; chx:output "(None, ['cat', 'dog', 'bat', 'moose'])" .
chx:X_AppendMethod rd:hasIOExample chx:IO_AppendMethod .
chx:X_InsertMethod a owl:NamedIndividual, chx:InsertMethod ; rdfs:label "spam.insert(1, 'chicken')"@en ; skos:definition "insert puts a value before the item at the given index and moves the later items along; inserting at len(spam) has the same effect as append."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_InsertMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.insert(1, 'chicken'), s)[1])(['cat', 'dog', 'bat']) evaluates to ['cat', 'chicken', 'dog', 'bat']"@en ; chx:input "(lambda s: (s.insert(1, 'chicken'), s)[1])(['cat', 'dog', 'bat'])" ; chx:output "['cat', 'chicken', 'dog', 'bat']" .
chx:X_InsertMethod rd:hasIOExample chx:IO_InsertMethod .
chx:X_ItemAssignment a owl:NamedIndividual, chx:ItemAssignment ; rdfs:label "spam[1] = 'aardvark'"@en ; skos:definition "Assigning to an index replaces that item in the same list, and a negative index counts from the end."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ItemAssignment a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.__setitem__(-1, 12345), s)[1])(['cat', 'bat', 'rat', 'elephant']) evaluates to ['cat', 'bat', 'rat', 12345]"@en ; chx:input "(lambda s: (s.__setitem__(-1, 12345), s)[1])(['cat', 'bat', 'rat', 'elephant'])" ; chx:output "['cat', 'bat', 'rat', 12345]" .
chx:X_ItemAssignment rd:hasIOExample chx:IO_ItemAssignment .
chx:X_SliceAssignment a owl:NamedIndividual, chx:SliceAssignment ; rdfs:label "letters[2:5] = ['C', 'D', 'E']"@en ; skos:definition "Assigning a list to a slice replaces those items and may change the length of the list; assigning an empty list to a slice removes them and letters[:] = [] empties the list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:X_RemoveMethod a owl:NamedIndividual, chx:RemoveMethod ; rdfs:label "spam.remove('cat')"@en ; skos:definition "remove deletes the first item equal to the value and returns None; it raises ValueError when there is no such item."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_RemoveMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.remove('cat'), s)[1])(['cat', 'bat', 'rat', 'cat', 'hat', 'cat']) evaluates to ['bat', 'rat', 'cat', 'hat', 'cat']"@en ; chx:input "(lambda s: (s.remove('cat'), s)[1])(['cat', 'bat', 'rat', 'cat', 'hat', 'cat'])" ; chx:output "['bat', 'rat', 'cat', 'hat', 'cat']" .
chx:X_RemoveMethod rd:hasIOExample chx:IO_RemoveMethod .
chx:X_PopMethod a owl:NamedIndividual, chx:PopMethod ; rdfs:label "spam.pop()"@en ; skos:definition "pop removes the item at an index, by default the last one, and returns it; it raises IndexError on an empty list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_PopMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.pop(), s.pop(0), s))([3, 4, 5, 6]) evaluates to (6, 3, [4, 5])"@en ; chx:input "(lambda s: (s.pop(), s.pop(0), s))([3, 4, 5, 6])" ; chx:output "(6, 3, [4, 5])" .
chx:X_PopMethod rd:hasIOExample chx:IO_PopMethod .
chx:X_DelStatement a owl:NamedIndividual, chx:DelStatement ; rdfs:label "del spam[2]"@en ; skos:definition "The del statement removes the item at an index, or a slice, and returns nothing; the items after it move up one index."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_DelStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.__delitem__(2), s)[1])(['cat', 'bat', 'rat', 'elephant']) evaluates to ['cat', 'bat', 'elephant']"@en ; chx:input "(lambda s: (s.__delitem__(2), s)[1])(['cat', 'bat', 'rat', 'elephant'])" ; chx:output "['cat', 'bat', 'elephant']" .
chx:X_DelStatement rd:hasIOExample chx:IO_DelStatement .
chx:X_ConcatenationReplication a owl:NamedIndividual, chx:ConcatenationReplication ; rdfs:label "[1, 2, 3] + ['A', 'B', 'C']"@en ; skos:definition "The + operator joins two lists into a new list and the * operator with an integer repeats a list into a new list; neither changes its operands."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ConcatenationReplication a owl:NamedIndividual, rd:IOExample ; rdfs:label "([1, 2, 3] + ['A', 'B', 'C'], ['X', 'Y'] * 3) evaluates to ([1, 2, 3, 'A', 'B', 'C'], ['X', 'Y', 'X', 'Y', 'X', 'Y'])"@en ; chx:input "([1, 2, 3] + ['A', 'B', 'C'], ['X', 'Y'] * 3)" ; chx:output "([1, 2, 3, 'A', 'B', 'C'], ['X', 'Y', 'X', 'Y', 'X', 'Y'])" .
chx:X_ConcatenationReplication rd:hasIOExample chx:IO_ConcatenationReplication .
chx:X_AugmentedAssignment a owl:NamedIndividual, chx:AugmentedAssignment ; rdfs:label "spam += 1"@en ; skos:definition "An augmented operator such as += combines an operation and an assignment; for a list, += extends the same list object in place, unlike spam = spam + other, which makes a new list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_AugmentedAssignment a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a: a.__iadd__([2]) is a)([1]) evaluates to True"@en ; chx:input "(lambda a: a.__iadd__([2]) is a)([1])" ; chx:output "True" .
chx:X_AugmentedAssignment rd:hasIOExample chx:IO_AugmentedAssignment .
chx:X_MembershipOperators a owl:NamedIndividual, chx:MembershipOperators ; rdfs:label "'howdy' in spam"@en ; skos:definition "The in and not in operators test whether a value equals an item of a list and give True or False; on a string they test for a substring, on a list of strings only for a whole item."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_MembershipOperators a owl:NamedIndividual, rd:IOExample ; rdfs:label "('gg' in 'eggs', 'gg' in ['eggs']) evaluates to (True, False)"@en ; chx:input "('gg' in 'eggs', 'gg' in ['eggs'])" ; chx:output "(True, False)" .
chx:X_MembershipOperators rd:hasIOExample chx:IO_MembershipOperators .
chx:X_IndexMethod a owl:NamedIndividual, chx:IndexMethod ; rdfs:label "spam.index('Pooka')"@en ; skos:definition "index returns the position of the first item equal to the value and raises ValueError when there is none; optional start and stop arguments limit the search, so a later duplicate can be found."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_IndexMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(['Zophie', 'Pooka', 'Fat-tail', 'Pooka'].index('Pooka'), ['Zophie', 'Pooka', 'Fat-tail', 'Pooka'].index('Pooka', 2)) evaluates to (1, 3)"@en ; chx:input "(['Zophie', 'Pooka', 'Fat-tail', 'Pooka'].index('Pooka'), ['Zophie', 'Pooka', 'Fat-tail', 'Pooka'].index('Pooka', 2))" ; chx:output "(1, 3)" .
chx:X_IndexMethod rd:hasIOExample chx:IO_IndexMethod .
chx:X_ShortCircuitGuard a owl:NamedIndividual, chx:ShortCircuitGuard ; rdfs:label "len(spam) > 0 and spam[0] == 'cat'"@en ; skos:definition "The operators and and or stop as soon as the left operand decides the result and return that operand, so a test that the list is not empty can guard an index that would raise IndexError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ShortCircuitGuard a owl:NamedIndividual, rd:IOExample ; rdfs:label "([] and 'not evaluated', 'x' or 1 / 0) evaluates to ([], 'x')"@en ; chx:input "([] and 'not evaluated', 'x' or 1 / 0)" ; chx:output "([], 'x')" .
chx:X_ShortCircuitGuard rd:hasIOExample chx:IO_ShortCircuitGuard .
chx:X_SortMethod a owl:NamedIndividual, chx:SortMethod ; rdfs:label "spam.sort()"@en ; skos:definition "sort orders the list in place and returns None, so spam = spam.sort() leaves None; items that cannot be compared, such as numbers and strings, raise TypeError, and strings sort with uppercase letters before lowercase ones."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_SortMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.sort(), s))([2, 5, 3.14, 1, -7]) evaluates to (None, [-7, 1, 2, 3.14, 5])"@en ; chx:input "(lambda s: (s.sort(), s))([2, 5, 3.14, 1, -7])" ; chx:output "(None, [-7, 1, 2, 3.14, 5])" .
chx:X_SortMethod rd:hasIOExample chx:IO_SortMethod .
chx:X_SortKeyAndReverse a owl:NamedIndividual, chx:SortKeyAndReverse ; rdfs:label "spam.sort(key=str.lower)"@en ; skos:definition "The keyword-only arguments key and reverse change how sort and sorted compare: key names a function applied once to each item to give its sort key, and reverse=True sorts as if each comparison were reversed."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_SortKeyAndReverse a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(['a', 'z', 'A', 'Z'], key=str.lower) evaluates to ['a', 'A', 'z', 'Z']"@en ; chx:input "sorted(['a', 'z', 'A', 'Z'], key=str.lower)" ; chx:output "['a', 'A', 'z', 'Z']" .
chx:X_SortKeyAndReverse rd:hasIOExample chx:IO_SortKeyAndReverse .
chx:X_ReverseMethod a owl:NamedIndividual, chx:ReverseMethod ; rdfs:label "spam.reverse()"@en ; skos:definition "reverse reverses the order of the items in place and returns None; a slice with step -1 gives a reversed copy and leaves the list alone."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ReverseMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.reverse(), s))(['cat', 'dog', 'moose']) evaluates to (None, ['moose', 'dog', 'cat'])"@en ; chx:input "(lambda s: (s.reverse(), s))(['cat', 'dog', 'moose'])" ; chx:output "(None, ['moose', 'dog', 'cat'])" .
chx:X_ReverseMethod rd:hasIOExample chx:IO_ReverseMethod .
chx:X_SortedFunction a owl:NamedIndividual, chx:SortedFunction ; rdfs:label "sorted(spam)"@en ; skos:definition "sorted returns a new sorted list from any iterable and leaves the original unchanged, where sort changes a list in place; both sorts are stable, so items that compare equal keep their order."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_SortedFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (sorted(s), s))([3, 1, 2]) evaluates to ([1, 2, 3], [3, 1, 2])"@en ; chx:input "(lambda s: (sorted(s), s))([3, 1, 2])" ; chx:output "([1, 2, 3], [3, 1, 2])" .
chx:X_SortedFunction rd:hasIOExample chx:IO_SortedFunction .
chx:X_RangeLenLoop a owl:NamedIndividual, chx:RangeLenLoop ; rdfs:label "for i in range(len(supplies)):"@en ; skos:definition "range(len(supplies)) yields every index from 0 to len - 1, so the loop body can use both i and supplies[i]; assigning to i inside the body does not change which index comes next."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_RangeLenLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(len(['pens', 'staplers', 'flamethrowers', 'binders']))) evaluates to [0, 1, 2, 3]"@en ; chx:input "list(range(len(['pens', 'staplers', 'flamethrowers', 'binders'])))" ; chx:output "[0, 1, 2, 3]" .
chx:X_RangeLenLoop rd:hasIOExample chx:IO_RangeLenLoop .
chx:X_EnumerateLoop a owl:NamedIndividual, chx:EnumerateLoop ; rdfs:label "for index, item in enumerate(supplies):"@en ; skos:definition "enumerate yields a pair of index and item on each pass, so the loop needs neither len nor range; its start argument sets the first number."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_EnumerateLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "(list(enumerate(['pens', 'staplers'])), list(enumerate(['pens', 'staplers'], start=1))) evaluates to ([(0, 'pens'), (1, 'staplers')], [(1, 'pens'), (2, 'staplers')])"@en ; chx:input "(list(enumerate(['pens', 'staplers'])), list(enumerate(['pens', 'staplers'], start=1)))" ; chx:output "([(0, 'pens'), (1, 'staplers')], [(1, 'pens'), (2, 'staplers')])" .
chx:X_EnumerateLoop rd:hasIOExample chx:IO_EnumerateLoop .
chx:X_MutationWhileIterating a owl:NamedIndividual, chx:MutationWhileIterating ; rdfs:label "for x in items: items.remove(x)"@en ; skos:definition "A list iterator counts positions, so removing an item during a for loop moves the next item into the position just passed and it is never visited; looping over a copy or building a new list avoids this."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_MutationWhileIterating a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda l: ([l.remove(x) for x in l if x < 3], l)[1])([1, 2, 3, 4]) evaluates to [2, 3, 4]"@en ; chx:input "(lambda l: ([l.remove(x) for x in l if x < 3], l)[1])([1, 2, 3, 4])" ; chx:output "[2, 3, 4]" .
chx:X_MutationWhileIterating rd:hasIOExample chx:IO_MutationWhileIterating .
chx:X_ListComprehension a owl:NamedIndividual, chx:ListComprehension ; rdfs:label "[x**2 for x in range(10)]"@en ; skos:definition "A list comprehension builds a new list from an expression, a for clause and optional if clauses, without an append loop, and its loop variable does not remain in the enclosing scope."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ListComprehension a owl:NamedIndividual, rd:IOExample ; rdfs:label "[x for x in [-4, -2, 0, 2, 4] if x >= 0] evaluates to [0, 2, 4]"@en ; chx:input "[x for x in [-4, -2, 0, 2, 4] if x >= 0]" ; chx:output "[0, 2, 4]" .
chx:X_ListComprehension rd:hasIOExample chx:IO_ListComprehension .
chx:X_MultipleAssignment a owl:NamedIndividual, chx:MultipleAssignment ; rdfs:label "size, color, disposition = cat"@en ; skos:definition "Assigning a list to several names assigns its items left to right and needs exactly as many names as items, otherwise ValueError; the same syntax swaps two values with a, b = b, a."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_MultipleAssignment a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(b, a) for a, b in [(1, 2)]] evaluates to [(2, 1)]"@en ; chx:input "[(b, a) for a, b in [(1, 2)]]" ; chx:output "[(2, 1)]" .
chx:X_MultipleAssignment rd:hasIOExample chx:IO_MultipleAssignment .
chx:X_StarredUnpacking a owl:NamedIndividual, chx:StarredUnpacking ; rdfs:label "first, *rest = cat"@en ; skos:definition "One starred target collects the leftover items of an unpacking into a list, so the number of names need not match the number of items; a star inside a list display splices an iterable into the new list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_StarredUnpacking a owl:NamedIndividual, rd:IOExample ; rdfs:label "([(a, b, c) for a, *b, c in [range(5)]], [*[1, 2], *[3]]) evaluates to ([(0, [1, 2, 3], 4)], [1, 2, 3])"@en ; chx:input "([(a, b, c) for a, *b, c in [range(5)]], [*[1, 2], *[3]])" ; chx:output "([(0, [1, 2, 3], 4)], [1, 2, 3])" .
chx:X_StarredUnpacking rd:hasIOExample chx:IO_StarredUnpacking .
chx:X_MutableVersusImmutable a owl:NamedIndividual, chx:MutableVersusImmutable ; rdfs:label "name[7] = 'the'"@en ; skos:definition "Lists are mutable, so their items can be replaced, added and removed; strings and tuples are immutable sequences, and a changed string is built from slices of the old one; among list, str, tuple and range only list is a mutable sequence."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_MutableVersusImmutable a owl:NamedIndividual, rd:IOExample ; rdfs:label "[isinstance(x, __import__('collections.abc').abc.MutableSequence) for x in ([], 'a', (1,), range(2))] evaluates to [True, False, False, False]"@en ; chx:input "[isinstance(x, __import__('collections.abc').abc.MutableSequence) for x in ([], 'a', (1,), range(2))]" ; chx:output "[True, False, False, False]" .
chx:X_MutableVersusImmutable rd:hasIOExample chx:IO_MutableVersusImmutable .
chx:X_TupleType a owl:NamedIndividual, chx:TupleType ; rdfs:label "eggs = ('hello', 42, 0.5)"@en ; skos:definition "A tuple is an immutable sequence written with commas, usually in parentheses; one item needs a trailing comma, and list() and tuple() convert between the two types."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_TupleType a owl:NamedIndividual, rd:IOExample ; rdfs:label "(type(('hello',)), type(('hello'))) evaluates to (<class 'tuple'>, <class 'str'>)"@en ; chx:input "(type(('hello',)), type(('hello')))" ; chx:output "(<class 'tuple'>, <class 'str'>)" .
chx:X_TupleType rd:hasIOExample chx:IO_TupleType .
chx:X_ReferencesAndAliasing a owl:NamedIndividual, chx:ReferencesAndAliasing ; rdfs:label "eggs = spam"@en ; skos:definition "A variable holds a reference to a value; assigning one variable to another copies the reference, so two names for one list see each other's changes, while assigning a new value to a name only rebinds that name."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ReferencesAndAliasing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: (lambda eggs: (eggs.__setitem__(1, 'Hello!'), spam)[1])(spam))([0, 1, 2, 3]) evaluates to [0, 'Hello!', 2, 3]"@en ; chx:input "(lambda spam: (lambda eggs: (eggs.__setitem__(1, 'Hello!'), spam)[1])(spam))([0, 1, 2, 3])" ; chx:output "[0, 'Hello!', 2, 3]" .
chx:X_ReferencesAndAliasing rd:hasIOExample chx:IO_ReferencesAndAliasing .
chx:X_ListArguments a owl:NamedIndividual, chx:ListArguments ; rdfs:label "def eggs(some_parameter): some_parameter.append('Hello')"@en ; skos:definition "A function receives a reference to the list it is called with, so a method that changes the list inside the function changes the caller's list, while assigning a new value to the parameter only rebinds the local name."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ListArguments a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda f: (lambda s: (f(s), s)[1])([1, 2, 3]))(lambda p: p.append('Hello')) evaluates to [1, 2, 3, 'Hello']"@en ; chx:input "(lambda f: (lambda s: (f(s), s)[1])([1, 2, 3]))(lambda p: p.append('Hello'))" ; chx:output "[1, 2, 3, 'Hello']" .
chx:X_ListArguments rd:hasIOExample chx:IO_ListArguments .
chx:X_ReplicationAliasing a owl:NamedIndividual, chx:ReplicationAliasing ; rdfs:label "[[]] * 3"@en ; skos:definition "Replicating a list repeats references to the same items, so [[]] * 3 holds one inner list three times, while [[] for i in range(3)] makes three separate lists."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ReplicationAliasing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, b: (a[0].append(3), b[0].append(3), a, b)[2:])([[]] * 3, [[] for _ in range(3)]) evaluates to ([[3], [3], [3]], [[3], [], []])"@en ; chx:input "(lambda a, b: (a[0].append(3), b[0].append(3), a, b)[2:])([[]] * 3, [[] for _ in range(3)])" ; chx:output "([[3], [3], [3]], [[3], [], []])" .
chx:X_ReplicationAliasing rd:hasIOExample chx:IO_ReplicationAliasing .
chx:X_ShallowCopy a owl:NamedIndividual, chx:ShallowCopy ; rdfs:label "cheese = copy.copy(spam)"@en ; skos:definition "copy.copy makes a new list that holds references to the same items; the slice spam[:], spam.copy() and list(spam) make the same kind of shallow copy, independent for a flat list but sharing any inner lists."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ShallowCopy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a: (a[:] is a, a.copy() == a, list(a) is a, a[:][0] is a[0]))([[1]]) evaluates to (False, True, False, True)"@en ; chx:input "(lambda a: (a[:] is a, a.copy() == a, list(a) is a, a[:][0] is a[0]))([[1]])" ; chx:output "(False, True, False, True)" .
chx:X_ShallowCopy rd:hasIOExample chx:IO_ShallowCopy .
chx:X_DeepCopy a owl:NamedIndividual, chx:DeepCopy ; rdfs:label "copy.deepcopy(spam)"@en ; skos:definition "copy.deepcopy copies the inner lists as well, recursively, so nothing is shared with the original; it may copy too much, such as data meant to be shared."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_DeepCopy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c, a: (c.copy(a)[0] is a[0], c.deepcopy(a)[0] is a[0]))(__import__('copy'), [[1]]) evaluates to (True, False)"@en ; chx:input "(lambda c, a: (c.copy(a)[0] is a[0], c.deepcopy(a)[0] is a[0]))(__import__('copy'), [[1]])" ; chx:output "(True, False)" .
chx:X_DeepCopy rd:hasIOExample chx:IO_DeepCopy .
chx:X_RandomChoice a owl:NamedIndividual, chx:RandomChoice ; rdfs:label "random.choice(pets)"@en ; skos:definition "random.choice returns one random item of a non-empty sequence without changing it, and raises IndexError for an empty one."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_RandomChoice a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('random').choice(['Dog', 'Cat', 'Moose']) in ['Dog', 'Cat', 'Moose'] evaluates to True"@en ; chx:input "__import__('random').choice(['Dog', 'Cat', 'Moose']) in ['Dog', 'Cat', 'Moose']" ; chx:output "True" .
chx:X_RandomChoice rd:hasIOExample chx:IO_RandomChoice .
chx:X_RandomShuffle a owl:NamedIndividual, chx:RandomShuffle ; rdfs:label "random.shuffle(people)"@en ; skos:definition "random.shuffle reorders a list in place and returns None; random.sample with k equal to the length returns a shuffled new list instead."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_RandomShuffle a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p: (__import__('random').shuffle(p), sorted(p)))([3, 1, 2]) evaluates to (None, [1, 2, 3])"@en ; chx:input "(lambda p: (__import__('random').shuffle(p), sorted(p)))([3, 1, 2])" ; chx:output "(None, [1, 2, 3])" .
chx:X_RandomShuffle rd:hasIOExample chx:IO_RandomShuffle .
