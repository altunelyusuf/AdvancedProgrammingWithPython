chx:X_List a owl:NamedIndividual, chx:List ; rdfs:label "['hello', 3.1415, True, None, 42]"@en ; skos:definition "A list is a value that holds an ordered sequence of items between square brackets, separated by commas; the items can be of any type, and the list [] holds none."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_List a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(['hello', 3.1415, True, None, 42]) evaluates to 5"@en ; chx:input "len(['hello', 3.1415, True, None, 42])" ; chx:output "5" .
chx:X_List rd:hasIOExample chx:IO_List .
chx:X_ListLength a owl:NamedIndividual, chx:ListLength ; rdfs:label "len(['cat', 'dog', 'moose'])"@en ; skos:definition "The len function returns the number of items in a list; the last valid index of a list is its length minus one."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ListLength a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(['cat', 'dog', 'moose']) evaluates to 3"@en ; chx:input "len(['cat', 'dog', 'moose'])" ; chx:output "3" .
chx:X_ListLength rd:hasIOExample chx:IO_ListLength .
chx:X_Index a owl:NamedIndividual, chx:Index ; rdfs:label "spam[3] for ['cat', 'bat', 'rat', 'elephant']"@en ; skos:definition "An index is the integer in square brackets after a list that selects the item at that position; the first item is at index 0, and an index beyond the list raises an IndexError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_Index a owl:NamedIndividual, rd:IOExample ; rdfs:label "['cat', 'bat', 'rat', 'elephant'][3] evaluates to 'elephant'"@en ; chx:input "['cat', 'bat', 'rat', 'elephant'][3]" ; chx:output "'elephant'" .
chx:X_Index rd:hasIOExample chx:IO_Index .
chx:X_NegativeIndex a owl:NamedIndividual, chx:NegativeIndex ; rdfs:label "spam[-1] for ['cat', 'bat', 'rat', 'elephant']"@en ; skos:definition "A negative index counts from the end of the list: -1 is the last item, -2 the one before it, and so on."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_NegativeIndex a owl:NamedIndividual, rd:IOExample ; rdfs:label "['cat', 'bat', 'rat', 'elephant'][-3] evaluates to 'bat'"@en ; chx:input "['cat', 'bat', 'rat', 'elephant'][-3]" ; chx:output "'bat'" .
chx:X_NegativeIndex rd:hasIOExample chx:IO_NegativeIndex .
chx:X_NestedList a owl:NamedIndividual, chx:NestedList ; rdfs:label "spam[1][4] for [['cat', 'bat'], [10, 20, 30, 40, 50]]"@en ; skos:definition "A list can contain other lists, and an item of an inner list is reached with two indexes in a row: the first picks the inner list, the second the item inside it."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_NestedList a owl:NamedIndividual, rd:IOExample ; rdfs:label "[['cat', 'bat'], [10, 20, 30, 40, 50]][1][4] evaluates to 50"@en ; chx:input "[['cat', 'bat'], [10, 20, 30, 40, 50]][1][4]" ; chx:output "50" .
chx:X_NestedList rd:hasIOExample chx:IO_NestedList .
chx:X_Slice a owl:NamedIndividual, chx:Slice ; rdfs:label "spam[1:3] for ['cat', 'bat', 'rat', 'elephant']"@en ; skos:definition "A slice spam[i:j] is a new list of the items from index i up to but not including index j."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_Slice a owl:NamedIndividual, rd:IOExample ; rdfs:label "['cat', 'bat', 'rat', 'elephant'][1:3] evaluates to ['bat', 'rat']"@en ; chx:input "['cat', 'bat', 'rat', 'elephant'][1:3]" ; chx:output "['bat', 'rat']" .
chx:X_Slice rd:hasIOExample chx:IO_Slice .
chx:X_SliceDefaults a owl:NamedIndividual, chx:SliceDefaults ; rdfs:label "spam[:2], spam[1:], spam[:]"@en ; skos:definition "Leaving out the first number of a slice means 0 and leaving out the second means the length of the list; spam[:] is a copy of the whole list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_SliceDefaults a owl:NamedIndividual, rd:IOExample ; rdfs:label "['cat', 'bat', 'rat', 'elephant'][:2] evaluates to ['cat', 'bat']"@en ; chx:input "['cat', 'bat', 'rat', 'elephant'][:2]" ; chx:output "['cat', 'bat']" .
chx:X_SliceDefaults rd:hasIOExample chx:IO_SliceDefaults .
chx:X_SliceStep a owl:NamedIndividual, chx:SliceStep ; rdfs:label "list(range(10))[::3]"@en ; skos:definition "A slice can carry a third number, the step: s[i:j:k] takes every kth item, and a negative step walks backwards, so s[::-1] is a reversed copy."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_SliceStep a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(10))[::3] evaluates to [0, 3, 6, 9]"@en ; chx:input "list(range(10))[::3]" ; chx:output "[0, 3, 6, 9]" .
chx:X_SliceStep rd:hasIOExample chx:IO_SliceStep .
chx:X_ItemAssignment a owl:NamedIndividual, chx:ItemAssignment ; rdfs:label "spam[1] = 'aardvark'"@en ; skos:definition "Assigning to an index replaces the item at that position, in place; the length of the list does not change."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ItemAssignment a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'bat', 'rat', 'elephant'], s.__setitem__(1, 'aardvark'), s)[2] evaluates to ['cat', 'aardvark', 'rat', 'elephant']"@en ; chx:input "(s := ['cat', 'bat', 'rat', 'elephant'], s.__setitem__(1, 'aardvark'), s)[2]" ; chx:output "['cat', 'aardvark', 'rat', 'elephant']" .
chx:X_ItemAssignment rd:hasIOExample chx:IO_ItemAssignment .
chx:X_AppendMethod a owl:NamedIndividual, chx:AppendMethod ; rdfs:label "spam.append('moose')"@en ; skos:definition "The append method adds its argument as one item to the end of the list, changes the list in place and returns None."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_AppendMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'dog', 'bat'], s.append('moose'), s)[2] evaluates to ['cat', 'dog', 'bat', 'moose']"@en ; chx:input "(s := ['cat', 'dog', 'bat'], s.append('moose'), s)[2]" ; chx:output "['cat', 'dog', 'bat', 'moose']" .
chx:X_AppendMethod rd:hasIOExample chx:IO_AppendMethod .
chx:X_InsertMethod a owl:NamedIndividual, chx:InsertMethod ; rdfs:label "spam.insert(1, 'chicken')"@en ; skos:definition "The insert method puts an item at a chosen index and moves the items from that index on one place along; like append it changes the list and returns None."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_InsertMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'dog', 'bat'], s.insert(1, 'chicken'), s)[2] evaluates to ['cat', 'chicken', 'dog', 'bat']"@en ; chx:input "(s := ['cat', 'dog', 'bat'], s.insert(1, 'chicken'), s)[2]" ; chx:output "['cat', 'chicken', 'dog', 'bat']" .
chx:X_InsertMethod rd:hasIOExample chx:IO_InsertMethod .
chx:X_ExtendMethod a owl:NamedIndividual, chx:ExtendMethod ; rdfs:label "spam.extend(['A', 'B'])"@en ; skos:definition "The extend method adds every item of an iterable to the end of the list, one by one, in place; unlike append it does not nest a list argument."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ExtendMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := [1, 2, 3], s.extend(['A', 'B']), s)[2] evaluates to [1, 2, 3, 'A', 'B']"@en ; chx:input "(s := [1, 2, 3], s.extend(['A', 'B']), s)[2]" ; chx:output "[1, 2, 3, 'A', 'B']" .
chx:X_ExtendMethod rd:hasIOExample chx:IO_ExtendMethod .
chx:X_DelStatement a owl:NamedIndividual, chx:DelStatement ; rdfs:label "del spam[2]"@en ; skos:definition "The del statement deletes the item at an index, or a slice, or a whole variable; the items after a deleted item move up one place."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_DelStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'bat', 'rat', 'elephant'], s.__delitem__(2), s)[2] evaluates to ['cat', 'bat', 'elephant']"@en ; chx:input "(s := ['cat', 'bat', 'rat', 'elephant'], s.__delitem__(2), s)[2]" ; chx:output "['cat', 'bat', 'elephant']" .
chx:X_DelStatement rd:hasIOExample chx:IO_DelStatement .
chx:X_RemoveMethod a owl:NamedIndividual, chx:RemoveMethod ; rdfs:label "spam.remove('bat')"@en ; skos:definition "The remove method deletes the first item equal to its argument and raises a ValueError when there is none; it returns None."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_RemoveMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'bat', 'rat', 'cat', 'hat', 'cat'], s.remove('cat'), s)[2] evaluates to ['bat', 'rat', 'cat', 'hat', 'cat']"@en ; chx:input "(s := ['cat', 'bat', 'rat', 'cat', 'hat', 'cat'], s.remove('cat'), s)[2]" ; chx:output "['bat', 'rat', 'cat', 'hat', 'cat']" .
chx:X_RemoveMethod rd:hasIOExample chx:IO_RemoveMethod .
chx:X_PopMethod a owl:NamedIndividual, chx:PopMethod ; rdfs:label "spam.pop()"@en ; skos:definition "The pop method removes the item at an index, by default the last one, and returns it; it raises an IndexError on an empty list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_PopMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := [3, 4, 5], s.pop(), s)[1:] evaluates to (5, [3, 4])"@en ; chx:input "(s := [3, 4, 5], s.pop(), s)[1:]" ; chx:output "(5, [3, 4])" .
chx:X_PopMethod rd:hasIOExample chx:IO_PopMethod .
chx:X_Concatenation a owl:NamedIndividual, chx:Concatenation ; rdfs:label "[1, 2, 3] + ['A', 'B', 'C']"@en ; skos:definition "The + operator joins two lists into a new list and leaves both operands unchanged; both operands must be lists."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_Concatenation a owl:NamedIndividual, rd:IOExample ; rdfs:label "[1, 2, 3] + ['A', 'B', 'C'] evaluates to [1, 2, 3, 'A', 'B', 'C']"@en ; chx:input "[1, 2, 3] + ['A', 'B', 'C']" ; chx:output "[1, 2, 3, 'A', 'B', 'C']" .
chx:X_Concatenation rd:hasIOExample chx:IO_Concatenation .
chx:X_Replication a owl:NamedIndividual, chx:Replication ; rdfs:label "['X', 'Y', 'Z'] * 3"@en ; skos:definition "The * operator repeats a list the given number of times in a new list; the repeated items are the same objects, not copies."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_Replication a owl:NamedIndividual, rd:IOExample ; rdfs:label "['X', 'Y', 'Z'] * 3 evaluates to ['X', 'Y', 'Z', 'X', 'Y', 'Z', 'X', 'Y', 'Z']"@en ; chx:input "['X', 'Y', 'Z'] * 3" ; chx:output "['X', 'Y', 'Z', 'X', 'Y', 'Z', 'X', 'Y', 'Z']" .
chx:X_Replication rd:hasIOExample chx:IO_Replication .
chx:X_AugmentedAssignment a owl:NamedIndividual, chx:AugmentedAssignment ; rdfs:label "spam += 1, bacon *= 3"@en ; skos:definition "An augmented assignment such as += or *= combines an operator with an assignment; for a list it changes the list in place."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_AugmentedAssignment a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['Zophie'], s.__imul__(3))[1] evaluates to ['Zophie', 'Zophie', 'Zophie']"@en ; chx:input "(s := ['Zophie'], s.__imul__(3))[1]" ; chx:output "['Zophie', 'Zophie', 'Zophie']" .
chx:X_AugmentedAssignment rd:hasIOExample chx:IO_AugmentedAssignment .
chx:X_Method a owl:NamedIndividual, chx:Method ; rdfs:label "spam.index('hello')"@en ; skos:definition "A method is a function that is called on a value, written value.name(arguments); each data type has its own methods, and calling a list method on a string raises an AttributeError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_Method a owl:NamedIndividual, rd:IOExample ; rdfs:label "['hello', 'hi'].index('hello') evaluates to 0"@en ; chx:input "['hello', 'hi'].index('hello')" ; chx:output "0" .
chx:X_Method rd:hasIOExample chx:IO_Method .
chx:X_Membership a owl:NamedIndividual, chx:Membership ; rdfs:label "'howdy' in ['hello', 'hi', 'howdy', 'heyas']"@en ; skos:definition "The in operator gives True if a value equals an item of the list and False otherwise, and not in gives the opposite."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_Membership a owl:NamedIndividual, rd:IOExample ; rdfs:label "'howdy' in ['hello', 'hi', 'howdy', 'heyas'] evaluates to True"@en ; chx:input "'howdy' in ['hello', 'hi', 'howdy', 'heyas']" ; chx:output "True" .
chx:X_Membership rd:hasIOExample chx:IO_Membership .
chx:X_IndexMethod a owl:NamedIndividual, chx:IndexMethod ; rdfs:label "spam.index('Pooka')"@en ; skos:definition "The index method returns the index of the first item equal to the value and raises a ValueError if there is none."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_IndexMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "['Zophie', 'Pooka', 'Fat-tail', 'Pooka'].index('Pooka') evaluates to 1"@en ; chx:input "['Zophie', 'Pooka', 'Fat-tail', 'Pooka'].index('Pooka')" ; chx:output "1" .
chx:X_IndexMethod rd:hasIOExample chx:IO_IndexMethod .
chx:X_ShortCircuit a owl:NamedIndividual, chx:ShortCircuit ; rdfs:label "len(spam) > 0 and spam[0] == 'cat'"@en ; skos:definition "The operators and and or stop as soon as the left operand decides the result and do not evaluate the right operand, so a test on the left can guard an expression on the right."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ShortCircuit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: len(spam) > 0 and spam[0] == 'cat')([]) evaluates to False"@en ; chx:input "(lambda spam: len(spam) > 0 and spam[0] == 'cat')([])" ; chx:output "False" .
chx:X_ShortCircuit rd:hasIOExample chx:IO_ShortCircuit .
chx:X_SortMethod a owl:NamedIndividual, chx:SortMethod ; rdfs:label "spam.sort()"@en ; skos:definition "The sort method orders the items of the list in place, from small to large, and returns None; it cannot compare numbers with strings and orders strings by character code."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_SortMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := [2, 5, 3.14, 1, -7], s.sort(), s)[2] evaluates to [-7, 1, 2, 3.14, 5]"@en ; chx:input "(s := [2, 5, 3.14, 1, -7], s.sort(), s)[2]" ; chx:output "[-7, 1, 2, 3.14, 5]" .
chx:X_SortMethod rd:hasIOExample chx:IO_SortMethod .
chx:X_SortKeyReverse a owl:NamedIndividual, chx:SortKeyReverse ; rdfs:label "spam.sort(key=str.lower)"@en ; skos:definition "The keyword arguments reverse and key change how sort and sorted compare: reverse=True gives descending order and key names a function applied to each item before the comparison."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_SortKeyReverse a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(['a', 'z', 'A', 'Z'], key=str.lower) evaluates to ['a', 'A', 'z', 'Z']"@en ; chx:input "sorted(['a', 'z', 'A', 'Z'], key=str.lower)" ; chx:output "['a', 'A', 'z', 'Z']" .
chx:X_SortKeyReverse rd:hasIOExample chx:IO_SortKeyReverse .
chx:X_ReverseMethod a owl:NamedIndividual, chx:ReverseMethod ; rdfs:label "spam.reverse()"@en ; skos:definition "The reverse method turns the order of the items around in place and returns None; the slice with step -1 gives a reversed copy and leaves the list unchanged."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ReverseMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(s := ['cat', 'dog', 'moose'], s.reverse(), s)[2] evaluates to ['moose', 'dog', 'cat']"@en ; chx:input "(s := ['cat', 'dog', 'moose'], s.reverse(), s)[2]" ; chx:output "['moose', 'dog', 'cat']" .
chx:X_ReverseMethod rd:hasIOExample chx:IO_ReverseMethod .
chx:X_SortedFunction a owl:NamedIndividual, chx:SortedFunction ; rdfs:label "sorted(spam)"@en ; skos:definition "The built-in function sorted returns a new ordered list from any iterable and leaves the original unchanged; it takes the same key and reverse arguments as the sort method."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_SortedFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (sorted(s), s))([3, 1, 2]) evaluates to ([1, 2, 3], [3, 1, 2])"@en ; chx:input "(lambda s: (sorted(s), s))([3, 1, 2])" ; chx:output "([1, 2, 3], [3, 1, 2])" .
chx:X_SortedFunction rd:hasIOExample chx:IO_SortedFunction .
chx:X_RangeLenLoop a owl:NamedIndividual, chx:RangeLenLoop ; rdfs:label "for i in range(len(supplies)):"@en ; skos:definition "Writing range(len(some_list)) in a for loop visits every index of the list from 0 to len minus 1, whatever the length, so the body can use both i and some_list[i]."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_RangeLenLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(i, s) for i, s in enumerate(['pens', 'staplers', 'flamethrowers', 'binders'])] evaluates to [(0, 'pens'), (1, 'staplers'), (2, 'flamethrowers'), (3, 'binders')]"@en ; chx:input "[(i, s) for i, s in enumerate(['pens', 'staplers', 'flamethrowers', 'binders'])]" ; chx:output "[(0, 'pens'), (1, 'staplers'), (2, 'flamethrowers'), (3, 'binders')]" .
chx:X_RangeLenLoop rd:hasIOExample chx:IO_RangeLenLoop .
chx:X_EnumerateLoop a owl:NamedIndividual, chx:EnumerateLoop ; rdfs:label "for index, item in enumerate(supplies):"@en ; skos:definition "The built-in function enumerate yields a pair of the index and the item on each pass of the loop, so the body needs no index arithmetic."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_EnumerateLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(enumerate(['pens', 'staplers'])) evaluates to [(0, 'pens'), (1, 'staplers')]"@en ; chx:input "list(enumerate(['pens', 'staplers']))" ; chx:output "[(0, 'pens'), (1, 'staplers')]" .
chx:X_EnumerateLoop rd:hasIOExample chx:IO_EnumerateLoop .
chx:X_MutationWhileIterating a owl:NamedIndividual, chx:MutationWhileIterating ; rdfs:label "for x in items: items.remove(x)"@en ; skos:definition "A list iterator counts positions, so removing items during a for loop moves later items into positions the loop has passed and skips them; loop over a copy or build a new list instead."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_MutationWhileIterating a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda items: ([items.remove(x) for x in items], items)[1])(['a', 'b', 'c', 'd']) evaluates to ['b', 'd']"@en ; chx:input "(lambda items: ([items.remove(x) for x in items], items)[1])(['a', 'b', 'c', 'd'])" ; chx:output "['b', 'd']" .
chx:X_MutationWhileIterating rd:hasIOExample chx:IO_MutationWhileIterating .
chx:X_ListComprehension a owl:NamedIndividual, chx:ListComprehension ; rdfs:label "[x**2 for x in range(10)]"@en ; skos:definition "A list comprehension builds a new list in one expression from an expression, a for clause and an optional if clause, in place of a loop that appends to an empty list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ListComprehension a owl:NamedIndividual, rd:IOExample ; rdfs:label "[x**2 for x in range(10)] evaluates to [0, 1, 4, 9, 16, 25, 36, 49, 64, 81]"@en ; chx:input "[x**2 for x in range(10)]" ; chx:output "[0, 1, 4, 9, 16, 25, 36, 49, 64, 81]" .
chx:X_ListComprehension rd:hasIOExample chx:IO_ListComprehension .
chx:X_MultipleAssignment a owl:NamedIndividual, chx:MultipleAssignment ; rdfs:label "size, color, disposition = cat"@en ; skos:definition "Assigning a list to several names assigns its items to the names from left to right; the number of names and the length of the list must be equal or Python raises a ValueError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_MultipleAssignment a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(size, color, disposition) for size, color, disposition in [['fat', 'gray', 'loud']]][0] evaluates to ('fat', 'gray', 'loud')"@en ; chx:input "[(size, color, disposition) for size, color, disposition in [['fat', 'gray', 'loud']]][0]" ; chx:output "('fat', 'gray', 'loud')" .
chx:X_MultipleAssignment rd:hasIOExample chx:IO_MultipleAssignment .
chx:X_StarredUnpacking a owl:NamedIndividual, chx:StarredUnpacking ; rdfs:label "first, *rest = cat"@en ; skos:definition "One starred name in an unpacking collects the leftover items into a list, so the counts always agree; the starred name receives an empty list when nothing is left."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_StarredUnpacking a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(first, rest) for first, *rest in [[1, 2, 3, 4]]][0] evaluates to (1, [2, 3, 4])"@en ; chx:input "[(first, rest) for first, *rest in [[1, 2, 3, 4]]][0]" ; chx:output "(1, [2, 3, 4])" .
chx:X_StarredUnpacking rd:hasIOExample chx:IO_StarredUnpacking .
chx:X_StringSequence a owl:NamedIndividual, chx:StringSequence ; rdfs:label "name[0], name[-2], name[0:4], 'Zo' in name"@en ; skos:definition "Strings and range objects are sequences like lists: they can be indexed, sliced, looped over, measured with len and searched with in and not in."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_StringSequence a owl:NamedIndividual, rd:IOExample ; rdfs:label "('Zophie'[0], 'Zophie'[-2], 'Zophie'[0:4], 'Zo' in 'Zophie') evaluates to ('Z', 'i', 'Zoph', True)"@en ; chx:input "('Zophie'[0], 'Zophie'[-2], 'Zophie'[0:4], 'Zo' in 'Zophie')" ; chx:output "('Z', 'i', 'Zoph', True)" .
chx:X_StringSequence rd:hasIOExample chx:IO_StringSequence .
chx:X_MutableImmutable a owl:NamedIndividual, chx:MutableImmutable ; rdfs:label "name[7] = 'the'"@en ; skos:definition "A list is mutable: its items can be added, removed and replaced in place; a string is immutable and an attempt to change one of its characters raises a TypeError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_MutableImmutable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda eggs: (lambda before: (eggs.__setitem__(0, 'x'), id(eggs) == before)[1])(id(eggs)))(['A', 'B', 'C']) evaluates to True"@en ; chx:input "(lambda eggs: (lambda before: (eggs.__setitem__(0, 'x'), id(eggs) == before)[1])(id(eggs)))(['A', 'B', 'C'])" ; chx:output "True" .
chx:X_MutableImmutable rd:hasIOExample chx:IO_MutableImmutable .
chx:X_TupleType a owl:NamedIndividual, chx:TupleType ; rdfs:label "eggs = ('hello', 42, 0.5)"@en ; skos:definition "A tuple is an immutable sequence written with commas, usually in parentheses; it supports indexing, slicing and len like a list but raises a TypeError on item assignment."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_TupleType a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda eggs: (eggs[0], eggs[1:3], len(eggs)))(('hello', 42, 0.5)) evaluates to ('hello', (42, 0.5), 3)"@en ; chx:input "(lambda eggs: (eggs[0], eggs[1:3], len(eggs)))(('hello', 42, 0.5))" ; chx:output "('hello', (42, 0.5), 3)" .
chx:X_TupleType rd:hasIOExample chx:IO_TupleType .
chx:X_Aliasing a owl:NamedIndividual, chx:Aliasing ; rdfs:label "eggs = spam"@en ; skos:definition "Assigning one variable to another copies the reference, not the value, so for a list both names refer to the same list and a change made through either shows through both."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_Aliasing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: (lambda eggs: (eggs.__setitem__(1, 'Hello!'), spam, eggs is spam))(spam))([0, 1, 2, 3])[1:] evaluates to ([0, 'Hello!', 2, 3], True)"@en ; chx:input "(lambda spam: (lambda eggs: (eggs.__setitem__(1, 'Hello!'), spam, eggs is spam))(spam))([0, 1, 2, 3])[1:]" ; chx:output "([0, 'Hello!', 2, 3], True)" .
chx:X_Aliasing rd:hasIOExample chx:IO_Aliasing .
chx:X_ListArguments a owl:NamedIndividual, chx:ListArguments ; rdfs:label "def eggs(some_parameter): some_parameter.append('Hello')"@en ; skos:definition "A function receives a copy of the reference, so a function that changes a list argument in place changes the caller's list, while rebinding the parameter has no effect outside."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ListArguments a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda eggs: (lambda spam: (eggs(spam), spam)[1])([1, 2, 3]))(lambda p: p.append('Hello')) evaluates to [1, 2, 3, 'Hello']"@en ; chx:input "(lambda eggs: (lambda spam: (eggs(spam), spam)[1])([1, 2, 3]))(lambda p: p.append('Hello'))" ; chx:output "[1, 2, 3, 'Hello']" .
chx:X_ListArguments rd:hasIOExample chx:IO_ListArguments .
chx:X_ReplicationAliasing a owl:NamedIndividual, chx:ReplicationAliasing ; rdfs:label "[[0] * 3] * 2"@en ; skos:definition "Repeating a list with * repeats references to the same items, so a list of lists built this way holds several references to one inner list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ReplicationAliasing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (g[0].__setitem__(0, 9), g, g[0] is g[1])[1:])([[0] * 3] * 2) evaluates to ([[9, 0, 0], [9, 0, 0]], True)"@en ; chx:input "(lambda g: (g[0].__setitem__(0, 9), g, g[0] is g[1])[1:])([[0] * 3] * 2)" ; chx:output "([[9, 0, 0], [9, 0, 0]], True)" .
chx:X_ReplicationAliasing rd:hasIOExample chx:IO_ReplicationAliasing .
chx:X_ShallowCopy a owl:NamedIndividual, chx:ShallowCopy ; rdfs:label "cheese = copy.copy(spam)"@en ; skos:definition "The function copy.copy makes a new list that holds references to the same items as the original; changing an item of the copy does not change the original, but changing a shared inner list shows through both."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_ShallowCopy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (lambda c: (c.__setitem__(1, 42), s, c))(__import__('copy').copy(s)))(['A', 'B', 'C'])[1:] evaluates to (['A', 'B', 'C'], ['A', 42, 'C'])"@en ; chx:input "(lambda s: (lambda c: (c.__setitem__(1, 42), s, c))(__import__('copy').copy(s)))(['A', 'B', 'C'])[1:]" ; chx:output "(['A', 'B', 'C'], ['A', 42, 'C'])" .
chx:X_ShallowCopy rd:hasIOExample chx:IO_ShallowCopy .
chx:X_DeepCopy a owl:NamedIndividual, chx:DeepCopy ; rdfs:label "copy.deepcopy(spam)"@en ; skos:definition "The function copy.deepcopy copies the list and, recursively, the lists inside it, so nothing is shared between the original and the copy."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_DeepCopy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (lambda c: (c[0].append(9), s, c))(__import__('copy').deepcopy(s)))([[1], [2]])[1:] evaluates to ([[1], [2]], [[1, 9], [2]])"@en ; chx:input "(lambda s: (lambda c: (c[0].append(9), s, c))(__import__('copy').deepcopy(s)))([[1], [2]])[1:]" ; chx:output "([[1], [2]], [[1, 9], [2]])" .
chx:X_DeepCopy rd:hasIOExample chx:IO_DeepCopy .
chx:X_RandomChoice a owl:NamedIndividual, chx:RandomChoice ; rdfs:label "random.choice(pets)"@en ; skos:definition "The function random.choice returns one randomly selected item of a non-empty sequence without changing it; on an empty sequence it raises an IndexError."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_RandomChoice a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('random').choice(['Dog', 'Cat', 'Moose']) in ['Dog', 'Cat', 'Moose'] evaluates to True"@en ; chx:input "__import__('random').choice(['Dog', 'Cat', 'Moose']) in ['Dog', 'Cat', 'Moose']" ; chx:output "True" .
chx:X_RandomChoice rd:hasIOExample chx:IO_RandomChoice .
chx:X_RandomShuffle a owl:NamedIndividual, chx:RandomShuffle ; rdfs:label "random.shuffle(people)"@en ; skos:definition "The function random.shuffle reorders the items of a list in place into a random order and returns None; it raises a TypeError for a tuple or a string."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_RandomShuffle a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda people: (__import__('random').shuffle(people), sorted(people))[1])(['Alice', 'Bob', 'Carol', 'David']) evaluates to ['Alice', 'Bob', 'Carol', 'David']"@en ; chx:input "(lambda people: (__import__('random').shuffle(people), sorted(people))[1])(['Alice', 'Bob', 'Carol', 'David'])" ; chx:output "['Alice', 'Bob', 'Carol', 'David']" .
chx:X_RandomShuffle rd:hasIOExample chx:IO_RandomShuffle .
chx:X_MagicEightBall a owl:NamedIndividual, chx:MagicEightBall ; rdfs:label "messages[random.randint(0, len(messages) - 1)]"@en ; skos:definition "The program keeps its nine answers in a list and prints the item at a random index from 0 to len(messages) - 1, so answers can be added or removed without changing any other line."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_MagicEightBall a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(['It is certain', 'It is decidedly so', 'Yes definitely', 'Reply hazy try again', 'Ask again later', 'Concentrate and ask again', 'My reply is no', 'Outlook not so good', 'Very doubtful']) evaluates to 9"@en ; chx:input "len(['It is certain', 'It is decidedly so', 'Yes definitely', 'Reply hazy try again', 'Ask again later', 'Concentrate and ask again', 'My reply is no', 'Outlook not so good', 'Very doubtful'])" ; chx:output "9" .
chx:X_MagicEightBall rd:hasIOExample chx:IO_MagicEightBall .
chx:X_MatrixScreensaver a owl:NamedIndividual, chx:MatrixScreensaver ; rdfs:label "columns = [0] * WIDTH"@en ; skos:definition "The program keeps one counter per output column in a list of WIDTH zeros: a counter above zero means that a stream of binary digits is running in that column and counts the digits left to print."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_MatrixScreensaver a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda W: (len([0] * W), set([0] * W)))(70) evaluates to (70, {0})"@en ; chx:input "(lambda W: (len([0] * W), set([0] * W)))(70)" ; chx:output "(70, {0})" .
chx:X_MatrixScreensaver rd:hasIOExample chx:IO_MatrixScreensaver .
chx:X_CommaCode a owl:NamedIndividual, chx:CommaCode ; rdfs:label "comma_code(['apples', 'bananas', 'tofu', 'cats'])"@en ; skos:definition "The Comma Code function joins the items of any list into one string, separated by commas, with and before the last item, and must work for the empty list and the one-item list."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_CommaCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda items: ', '.join(items[:-1]) + ', and ' + items[-1])(['apples', 'bananas', 'tofu', 'cats']) evaluates to 'apples, bananas, tofu, and cats'"@en ; chx:input "(lambda items: ', '.join(items[:-1]) + ', and ' + items[-1])(['apples', 'bananas', 'tofu', 'cats'])" ; chx:output "'apples, bananas, tofu, and cats'" .
chx:X_CommaCode rd:hasIOExample chx:IO_CommaCode .
chx:X_CoinFlipStreaks a owl:NamedIndividual, chx:CoinFlipStreaks ; rdfs:label "some_list[i:i + 6] == ['H'] * 6"@en ; skos:definition "The Coin Flip Streaks program simulates 10,000 experiments of 100 coin flips and counts those with a streak of six equal results, found by comparing slices of six items with a list of six H or six T."@en ; dcterms:source <http://example.org/sen0414/ch06/research> .
chx:IO_CoinFlipStreaks a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: [c.append(sum(c[-5:])) for _ in range(95)] and round(100 * (1 - c[-1] / 2**100), 2))([2, 4, 8, 16, 32]) evaluates to 80.68"@en ; chx:input "(lambda c: [c.append(sum(c[-5:])) for _ in range(95)] and round(100 * (1 - c[-1] / 2**100), 2))([2, 4, 8, 16, 32])" ; chx:output "80.68" .
chx:X_CoinFlipStreaks rd:hasIOExample chx:IO_CoinFlipStreaks .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 6 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch06/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 6 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which operations of the list data type read, replace, add, remove, find, order and combine items, and which of them change the list in place and which give a new value?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How do names, references, copies and function arguments decide whether a change to a list is seen elsewhere in a program, and when must a program copy?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 6 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 6 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch06/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-08."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py" .

