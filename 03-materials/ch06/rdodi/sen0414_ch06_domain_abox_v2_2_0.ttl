@prefix chx: <http://example.org/sen0414/ch06#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rd: <http://example.org/rdodi/domain-ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chx:Artifact a rd:DomainOntologyArtifact,
        owl:NamedIndividual ;
    rdfs:label "SEN0414 chapter 6 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch06/research> ;
    rd:hasCompetencyQuestion chx:CQs ;
    rd:hasResolutionEnvironment chx:Env ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ;
    rd:hasSourceProvenance chx:Provenance .

chx:X_AugmentedAssignment a chx:AugmentedAssignment,
        owl:NamedIndividual ;
    rdfs:label "spam += 1, bacon *= 3"@en ;
    rd:hasIOExample chx:IO_AugmentedAssignment ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "An augmented assignment such as += or *= combines an operator with an assignment; for a list it changes the list in place."@en .

chx:X_CoinFlipStreaks a chx:CoinFlipStreaks,
        owl:NamedIndividual ;
    rdfs:label "some_list[i:i + 6] == ['H'] * 6"@en ;
    rd:hasIOExample chx:IO_CoinFlipStreaks ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The Coin Flip Streaks program simulates 10,000 experiments of 100 coin flips and counts those with a streak of six equal results, found by comparing slices of six items with a list of six H or six T."@en .

chx:X_CommaCode a chx:CommaCode,
        owl:NamedIndividual ;
    rdfs:label "comma_code(['apples', 'bananas', 'tofu', 'cats'])"@en ;
    rd:hasIOExample chx:IO_CommaCode ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The Comma Code function joins the items of any list into one string, separated by commas, with and before the last item, and must work for the empty list and the one-item list."@en .

chx:X_Concatenation a chx:Concatenation,
        owl:NamedIndividual ;
    rdfs:label "[1, 2, 3] + ['A', 'B', 'C']"@en ;
    rd:hasIOExample chx:IO_Concatenation ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The + operator joins two lists into a new list and leaves both operands unchanged; both operands must be lists."@en .

chx:X_DeepCopy a chx:DeepCopy,
        owl:NamedIndividual ;
    rdfs:label "copy.deepcopy(spam)"@en ;
    rd:hasIOExample chx:IO_DeepCopy ;
    chx:hasOwner chx:X_ShallowCopy ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The function copy.deepcopy copies the list and, recursively, the lists inside it, so nothing is shared between the original and the copy."@en .

chx:X_DelStatement a chx:DelStatement,
        owl:NamedIndividual ;
    rdfs:label "del spam[2]"@en ;
    rd:hasIOExample chx:IO_DelStatement ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The del statement deletes the item at an index, or a slice, or a whole variable; the items after a deleted item move up one place."@en .

chx:X_EnumerateLoop a chx:EnumerateLoop,
        owl:NamedIndividual ;
    rdfs:label "for index, item in enumerate(supplies):"@en ;
    rd:hasIOExample chx:IO_EnumerateLoop ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The built-in function enumerate yields a pair of the index and the item on each pass of the loop, so the body needs no index arithmetic."@en .

chx:X_ExtendMethod a chx:ExtendMethod,
        owl:NamedIndividual ;
    rdfs:label "spam.extend(['A', 'B'])"@en ;
    rd:hasIOExample chx:IO_ExtendMethod ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The extend method adds every item of an iterable to the end of the list, one by one, in place; unlike append it does not nest a list argument."@en .

chx:X_IndexMethod a chx:IndexMethod,
        owl:NamedIndividual ;
    rdfs:label "spam.index('Pooka')"@en ;
    rd:hasErrorCondition chx:Err_IndexMethod ;
    rd:hasIOExample chx:IO_IndexMethod ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The index method returns the index of the first item equal to the value and raises a ValueError if there is none."@en .

chx:X_InsertMethod a chx:InsertMethod,
        owl:NamedIndividual ;
    rdfs:label "spam.insert(1, 'chicken')"@en ;
    rd:hasIOExample chx:IO_InsertMethod ;
    chx:hasOwner chx:X_AppendMethod ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The insert method puts an item at a chosen index and moves the items from that index on one place along; like append it changes the list and returns None."@en .

chx:X_ItemAssignment a chx:ItemAssignment,
        owl:NamedIndividual ;
    rdfs:label "spam[1] = 'aardvark'"@en ;
    rd:hasIOExample chx:IO_ItemAssignment ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "Assigning to an index replaces the item at that position, in place; the length of the list does not change."@en .

chx:X_List a chx:List,
        owl:NamedIndividual ;
    rdfs:label "['hello', 3.1415, True, None, 42]"@en ;
    rd:hasIOExample chx:IO_List ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A list is a value that holds an ordered sequence of items between square brackets, separated by commas; the items can be of any type, and the list [] holds none."@en .

chx:X_ListArguments a chx:ListArguments,
        owl:NamedIndividual ;
    rdfs:label "def eggs(some_parameter): some_parameter.append('Hello')"@en ;
    rd:hasIOExample chx:IO_ListArguments ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A function receives a copy of the reference, so a function that changes a list argument in place changes the caller's list, while rebinding the parameter has no effect outside."@en .

chx:X_ListComprehension a chx:ListComprehension,
        owl:NamedIndividual ;
    rdfs:label "[x**2 for x in range(10)]"@en ;
    rd:hasIOExample chx:IO_ListComprehension ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A list comprehension builds a new list in one expression from an expression, a for clause and an optional if clause, in place of a loop that appends to an empty list."@en .

chx:X_ListLength a chx:ListLength,
        owl:NamedIndividual ;
    rdfs:label "len(['cat', 'dog', 'moose'])"@en ;
    rd:hasIOExample chx:IO_ListLength ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The len function returns the number of items in a list; the last valid index of a list is its length minus one."@en .

chx:X_MagicEightBall a chx:MagicEightBall,
        owl:NamedIndividual ;
    rdfs:label "messages[random.randint(0, len(messages) - 1)]"@en ;
    rd:hasIOExample chx:IO_MagicEightBall ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The program keeps its nine answers in a list and prints the item at a random index from 0 to len(messages) - 1, so answers can be added or removed without changing any other line."@en .

chx:X_MatrixScreensaver a chx:MatrixScreensaver,
        owl:NamedIndividual ;
    rdfs:label "columns = [0] * WIDTH"@en ;
    rd:hasIOExample chx:IO_MatrixScreensaver ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The program keeps one counter per output column in a list of WIDTH zeros: a counter above zero means that a stream of binary digits is running in that column and counts the digits left to print."@en .

chx:X_Membership a chx:Membership,
        owl:NamedIndividual ;
    rdfs:label "'howdy' in ['hello', 'hi', 'howdy', 'heyas']"@en ;
    rd:hasIOExample chx:IO_Membership ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The in operator gives True if a value equals an item of the list and False otherwise, and not in gives the opposite."@en .

chx:X_Method a chx:Method,
        owl:NamedIndividual ;
    rdfs:label "spam.index('hello')"@en ;
    rd:hasIOExample chx:IO_Method ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A method is a function that is called on a value, written value.name(arguments); each data type has its own methods, and calling a list method on a string raises an AttributeError."@en .

chx:X_MutableImmutable a chx:MutableImmutable,
        owl:NamedIndividual ;
    rdfs:label "name[7] = 'the'"@en ;
    rd:hasErrorCondition chx:Err_MutableImmutable ;
    rd:hasIOExample chx:IO_MutableImmutable ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A list is mutable: its items can be added, removed and replaced in place; a string is immutable and an attempt to change one of its characters raises a TypeError."@en .

chx:X_MutationWhileIterating a chx:MutationWhileIterating,
        owl:NamedIndividual ;
    rdfs:label "for x in items: items.remove(x)"@en ;
    rd:hasIOExample chx:IO_MutationWhileIterating ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A list iterator counts positions, so removing items during a for loop moves later items into positions the loop has passed and skips them; loop over a copy or build a new list instead."@en .

chx:X_NegativeIndex a chx:NegativeIndex,
        owl:NamedIndividual ;
    rdfs:label "spam[-1] for ['cat', 'bat', 'rat', 'elephant']"@en ;
    rd:hasIOExample chx:IO_NegativeIndex ;
    chx:hasOwner chx:X_Index ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A negative index counts from the end of the list: -1 is the last item, -2 the one before it, and so on."@en .

chx:X_NestedList a chx:NestedList,
        owl:NamedIndividual ;
    rdfs:label "spam[1][4] for [['cat', 'bat'], [10, 20, 30, 40, 50]]"@en ;
    rd:hasIOExample chx:IO_NestedList ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A list can contain other lists, and an item of an inner list is reached with two indexes in a row: the first picks the inner list, the second the item inside it."@en .

chx:X_PopMethod a chx:PopMethod,
        owl:NamedIndividual ;
    rdfs:label "spam.pop()"@en ;
    rd:hasIOExample chx:IO_PopMethod ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The pop method removes the item at an index, by default the last one, and returns it; it raises an IndexError on an empty list."@en .

chx:X_RandomChoice a chx:RandomChoice,
        owl:NamedIndividual ;
    rdfs:label "random.choice(pets)"@en ;
    rd:hasErrorCondition chx:Err_RandomChoice ;
    rd:hasIOExample chx:IO_RandomChoice ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The function random.choice returns one randomly selected item of a non-empty sequence without changing it; on an empty sequence it raises an IndexError."@en .

chx:X_RandomShuffle a chx:RandomShuffle,
        owl:NamedIndividual ;
    rdfs:label "random.shuffle(people)"@en ;
    rd:hasIOExample chx:IO_RandomShuffle ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The function random.shuffle reorders the items of a list in place into a random order and returns None; it raises a TypeError for a tuple or a string."@en .

chx:X_RangeLenLoop a chx:RangeLenLoop,
        owl:NamedIndividual ;
    rdfs:label "for i in range(len(supplies)):"@en ;
    rd:hasIOExample chx:IO_RangeLenLoop ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "Writing range(len(some_list)) in a for loop visits every index of the list from 0 to len minus 1, whatever the length, so the body can use both i and some_list[i]."@en .

chx:X_RemoveMethod a chx:RemoveMethod,
        owl:NamedIndividual ;
    rdfs:label "spam.remove('bat')"@en ;
    rd:hasIOExample chx:IO_RemoveMethod ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The remove method deletes the first item equal to its argument and raises a ValueError when there is none; it returns None."@en .

chx:X_Replication a chx:Replication,
        owl:NamedIndividual ;
    rdfs:label "['X', 'Y', 'Z'] * 3"@en ;
    rd:hasIOExample chx:IO_Replication ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The * operator repeats a list the given number of times in a new list; the repeated items are the same objects, not copies."@en .

chx:X_ReplicationAliasing a chx:ReplicationAliasing,
        owl:NamedIndividual ;
    rdfs:label "[[0] * 3] * 2"@en ;
    rd:hasIOExample chx:IO_ReplicationAliasing ;
    chx:hasOwner chx:X_Aliasing ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "Repeating a list with * repeats references to the same items, so a list of lists built this way holds several references to one inner list."@en .

chx:X_ReverseMethod a chx:ReverseMethod,
        owl:NamedIndividual ;
    rdfs:label "spam.reverse()"@en ;
    rd:hasIOExample chx:IO_ReverseMethod ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The reverse method turns the order of the items around in place and returns None; the slice with step -1 gives a reversed copy and leaves the list unchanged."@en .

chx:X_ShortCircuit a chx:ShortCircuit,
        owl:NamedIndividual ;
    rdfs:label "len(spam) > 0 and spam[0] == 'cat'"@en ;
    rd:hasIOExample chx:IO_ShortCircuit ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The operators and and or stop as soon as the left operand decides the result and do not evaluate the right operand, so a test on the left can guard an expression on the right."@en .

chx:X_SliceDefaults a chx:SliceDefaults,
        owl:NamedIndividual ;
    rdfs:label "spam[:2], spam[1:], spam[:]"@en ;
    rd:hasIOExample chx:IO_SliceDefaults ;
    chx:hasOwner chx:X_Slice ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "Leaving out the first number of a slice means 0 and leaving out the second means the length of the list; spam[:] is a copy of the whole list."@en .

chx:X_SliceStep a chx:SliceStep,
        owl:NamedIndividual ;
    rdfs:label "list(range(10))[::3]"@en ;
    rd:hasIOExample chx:IO_SliceStep ;
    chx:hasOwner chx:X_Slice ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A slice can carry a third number, the step: s[i:j:k] takes every kth item, and a negative step walks backwards, so s[::-1] is a reversed copy."@en .

chx:X_SortKeyReverse a chx:SortKeyReverse,
        owl:NamedIndividual ;
    rdfs:label "spam.sort(key=str.lower)"@en ;
    rd:hasIOExample chx:IO_SortKeyReverse ;
    chx:hasOwner chx:X_SortMethod ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The keyword arguments reverse and key change how sort and sorted compare: reverse=True gives descending order and key names a function applied to each item before the comparison."@en .

chx:X_SortedFunction a chx:SortedFunction,
        owl:NamedIndividual ;
    rdfs:label "sorted(spam)"@en ;
    rd:hasIOExample chx:IO_SortedFunction ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The built-in function sorted returns a new ordered list from any iterable and leaves the original unchanged; it takes the same key and reverse arguments as the sort method."@en .

chx:X_StarredUnpacking a chx:StarredUnpacking,
        owl:NamedIndividual ;
    rdfs:label "first, *rest = cat"@en ;
    rd:hasIOExample chx:IO_StarredUnpacking ;
    chx:hasOwner chx:X_MultipleAssignment ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "One starred name in an unpacking collects the leftover items into a list, so the counts always agree; the starred name receives an empty list when nothing is left."@en .

chx:X_StringSequence a chx:StringSequence,
        owl:NamedIndividual ;
    rdfs:label "name[0], name[-2], name[0:4], 'Zo' in name"@en ;
    rd:hasIOExample chx:IO_StringSequence ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "Strings and range objects are sequences like lists: they can be indexed, sliced, looped over, measured with len and searched with in and not in."@en .

chx:X_TupleType a chx:TupleType,
        owl:NamedIndividual ;
    rdfs:label "eggs = ('hello', 42, 0.5)"@en ;
    rd:hasIOExample chx:IO_TupleType ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A tuple is an immutable sequence written with commas, usually in parentheses; it supports indexing, slicing and len like a list but raises a TypeError on item assignment."@en .

<http://example.org/sen0414/ch06/abox> a owl:Ontology ;
    rdfs:label "SEN0414 chapter 6 domain ontology - ABox"@en ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:identifier "sen0414_ch06_abox_v2_2_0" ;
