chx:Provenance a rd:ResearchSubjectInput,
        owl:NamedIndividual ;
    rdfs:label "Derived from the chapter 6 research artefact"@en ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 6 through the Stage 1 research artefact; the concepts for list comprehensions, starred unpacking, the sorted function, hashing and the history of the shuffle, and the version differences, come from that artefact's secondary sources (the Python documentation and PEPs, Fisher and Yates, Durstenfeld, Knuth), not from the book."@en,
        "Concepts are corpus-derived from the 3rd edition's chapter 6 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en .

chx:X_Aliasing a chx:Aliasing,
        owl:NamedIndividual ;
    rdfs:label "eggs = spam"@en ;
    rd:hasIOExample chx:IO_Aliasing ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "Assigning one variable to another copies the reference, not the value, so for a list both names refer to the same list and a change made through either shows through both."@en .

chx:X_AppendMethod a chx:AppendMethod,
        owl:NamedIndividual ;
    rdfs:label "spam.append('moose')"@en ;
    rd:hasIOExample chx:IO_AppendMethod ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The append method adds its argument as one item to the end of the list, changes the list in place and returns None."@en .

chx:X_Index a chx:Index,
        owl:NamedIndividual ;
    rdfs:label "spam[3] for ['cat', 'bat', 'rat', 'elephant']"@en ;
    rd:hasErrorCondition chx:Err_Index ;
    rd:hasIOExample chx:IO_Index ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "An index is the integer in square brackets after a list that selects the item at that position; the first item is at index 0, and an index beyond the list raises an IndexError."@en .

chx:X_MultipleAssignment a chx:MultipleAssignment,
        owl:NamedIndividual ;
    rdfs:label "size, color, disposition = cat"@en ;
    rd:hasErrorCondition chx:Err_MultipleAssignment ;
    rd:hasIOExample chx:IO_MultipleAssignment ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "Assigning a list to several names assigns its items to the names from left to right; the number of names and the length of the list must be equal or Python raises a ValueError."@en .

chx:X_ShallowCopy a chx:ShallowCopy,
        owl:NamedIndividual ;
    rdfs:label "cheese = copy.copy(spam)"@en ;
    rd:hasIOExample chx:IO_ShallowCopy ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The function copy.copy makes a new list that holds references to the same items as the original; changing an item of the copy does not change the original, but changing a shared inner list shows through both."@en .

chx:X_SortMethod a chx:SortMethod,
        owl:NamedIndividual ;
    rdfs:label "spam.sort()"@en ;
    rd:hasErrorCondition chx:Err_SortMethod ;
    rd:hasIOExample chx:IO_SortMethod ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "The sort method orders the items of the list in place, from small to large, and returns None; it cannot compare numbers with strings and orders strings by character code."@en .

chx:X_Slice a chx:Slice,
        owl:NamedIndividual ;
    rdfs:label "spam[1:3] for ['cat', 'bat', 'rat', 'elephant']"@en ;
    rd:hasIOExample chx:IO_Slice ;
    dcterms:source <http://example.org/sen0414/ch06/research> ;
    skos:definition "A slice spam[i:j] is a new list of the items from index i up to but not including index j."@en .

