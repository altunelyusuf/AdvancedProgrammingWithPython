    owl:versionIRI <http://example.org/sen0414/ch06/abox/2.2.0> ;
    owl:versionInfo "2.2.0" ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://example.org/sen0414/activity/ch06-rdodi-run> .

chx:CQ1 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which operations of the list data type read, replace, add, remove, find, order and combine items, and which of them change the list in place and which give a new value?"@en .

chx:CQ2 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "How do names, references, copies and function arguments decide whether a change to a list is seen elsewhere in a program, and when must a program copy?"@en .

chx:CQ3 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which printed outputs and error messages of the chapter differ in current Python, and which forms that current practice uses (enumerate, comprehensions, starred unpacking, sorted) does the chapter leave out?"@en .

chx:CQs a rd:CompetencyQuestionSet,
        owl:NamedIndividual ;
    rdfs:label "Chapter 6 competency questions"@en ;
    rd:containsCompetencyQuestion chx:CQ1,
        chx:CQ2,
        chx:CQ3 .

chx:Env a rd:ResolutionEnvironment,
        owl:NamedIndividual ;
    rdfs:label "CPython 3.12.3, CPython 3.13.16 and CPython 3.14.6"@en,
        "CPython 3.14.6"@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py",
        "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch06_corpus_v1_0_0.py" ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (283 checks listed in sen0414_ch06_corpus_v1_0_0.py), executed under CPython 3.12.3, CPython 3.13.16 and CPython 3.14.6: identical output where more than one was used."@en,
        "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-08."@en .

chx:Err_Index a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "[1, 2, 3][10] raises IndexError: list index out of range"@en .

chx:Err_IndexMethod a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "['a'].index('b') raises ValueError: list.index(x): x not in list (Python 3.14; 'b' is not in list in 3.12 and 3.13)"@en .

chx:Err_MultipleAssignment a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "[a for a, b in [[1, 2, 3]]] raises ValueError: too many values to unpack (expected 2, got 3)"@en .

chx:Err_MutableImmutable a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "exec('t = (1, 2); t[0] = 9') raises TypeError: 'tuple' object does not support item assignment"@en .

chx:Err_RandomChoice a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "__import__('random').choice([]) raises IndexError: Cannot choose from an empty sequence"@en .

chx:Err_SortMethod a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "[1, 'a'].sort() raises TypeError: '<' not supported between instances of 'str' and 'int'"@en .

chx:IO_Aliasing a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda spam: (lambda eggs: (eggs.__setitem__(1, 'Hello!'), spam, eggs is spam))(spam))([0, 1, 2, 3])[1:] evaluates to ([0, 'Hello!', 2, 3], True)"@en ;
    chx:input "(lambda spam: (lambda eggs: (eggs.__setitem__(1, 'Hello!'), spam, eggs is spam))(spam))([0, 1, 2, 3])[1:]" ;
    chx:output "([0, 'Hello!', 2, 3], True)" .

chx:IO_AppendMethod a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(s := ['cat', 'dog', 'bat'], s.append('moose'), s)[2] evaluates to ['cat', 'dog', 'bat', 'moose']"@en ;
    chx:input "(s := ['cat', 'dog', 'bat'], s.append('moose'), s)[2]" ;
    chx:output "['cat', 'dog', 'bat', 'moose']" .

chx:IO_AugmentedAssignment a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(s := ['Zophie'], s.__imul__(3))[1] evaluates to ['Zophie', 'Zophie', 'Zophie']"@en ;
    chx:input "(s := ['Zophie'], s.__imul__(3))[1]" ;
    chx:output "['Zophie', 'Zophie', 'Zophie']" .

chx:IO_CoinFlipStreaks a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda c: [c.append(sum(c[-5:])) for _ in range(95)] and round(100 * (1 - c[-1] / 2**100), 2))([2, 4, 8, 16, 32]) evaluates to 80.68"@en ;
    chx:input "(lambda c: [c.append(sum(c[-5:])) for _ in range(95)] and round(100 * (1 - c[-1] / 2**100), 2))([2, 4, 8, 16, 32])" ;
    chx:output "80.68" .

chx:IO_CommaCode a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda items: ', '.join(items[:-1]) + ', and ' + items[-1])(['apples', 'bananas', 'tofu', 'cats']) evaluates to 'apples, bananas, tofu, and cats'"@en ;
    chx:input "(lambda items: ', '.join(items[:-1]) + ', and ' + items[-1])(['apples', 'bananas', 'tofu', 'cats'])" ;
    chx:output "'apples, bananas, tofu, and cats'" .

chx:IO_Concatenation a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "[1, 2, 3] + ['A', 'B', 'C'] evaluates to [1, 2, 3, 'A', 'B', 'C']"@en ;
    chx:input "[1, 2, 3] + ['A', 'B', 'C']" ;
    chx:output "[1, 2, 3, 'A', 'B', 'C']" .

chx:IO_DeepCopy a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda s: (lambda c: (c[0].append(9), s, c))(__import__('copy').deepcopy(s)))([[1], [2]])[1:] evaluates to ([[1], [2]], [[1, 9], [2]])"@en ;
    chx:input "(lambda s: (lambda c: (c[0].append(9), s, c))(__import__('copy').deepcopy(s)))([[1], [2]])[1:]" ;
    chx:output "([[1], [2]], [[1, 9], [2]])" .

