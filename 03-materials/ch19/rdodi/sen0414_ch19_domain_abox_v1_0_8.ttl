chx:X_ClipboardAndSound a owl:NamedIndividual, chx:ClipboardAndSound ; rdfs:label "pyperclip.copy(text)"@en ; skos:definition "pyperclip 1.11.0 raises PyperclipException, a RuntimeError, when no copy and paste program such as xclip, xsel or wl-clipboard is installed, and playsound3 3.3.2, which replaces the book's pinned playsound3 2.4.0, exposes playsound(), backends and PlaysoundException."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ClipboardAndSound a owl:NamedIndividual, rd:IOExample ; rdfs:label "def err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nimport pyperclip, playsound3, importlib.metadata as md\ndef _e40():\n    return pyperclip.copy('x')\ne=err(_e40)\n(md.version('pyperclip'), e[0], e[1][:60], pyperclip.PyperclipException.__mro__[1].__name__, md.version('playsound3'), sorted(n for n in dir(playsound3) if not n.startswith('_'))[:8], hasattr(playsound3,'playsound'))"@en ; chx:input "def err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nimport pyperclip, playsound3, importlib.metadata as md\ndef _e40():\n    return pyperclip.copy('x')\ne=err(_e40)\n(md.version('pyperclip'), e[0], e[1][:60], pyperclip.PyperclipException.__mro__[1].__name__, md.version('playsound3'), sorted(n for n in dir(playsound3) if not n.startswith('_'))[:8], hasattr(playsound3,'playsound'))" ; chx:output "('1.11.0', 'PyperclipException', 'Pyperclip could not find a copy/paste mechanism for your sys', 'RuntimeError', '3.3.2', ['AVAILABLE_BACKENDS', 'DEFAULT_BACKEND', 'PlaysoundException', 'backends', 'playsound', 'playsound3', 'prefer_backends'], True)" .
chx:X_ClipboardAndSound rd:hasIOExample chx:IO_ClipboardAndSound .
chx:X_CronFields a owl:NamedIndividual, chx:CronFields ; rdfs:label "30 9 * * 1-5"@en ; skos:definition "A crontab entry has five time fields, minute, hour, day of month, month and day of week, and the command; '30 9 * * 1-5' runs at 09:30 on weekdays, '*/15 * * * *' every quarter hour, and when both day fields are restricted a day matches if either does, so '0 0 13 * 5' fires on every 13th and every Friday, not on Friday the 13th."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CronFields a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, timedelta as TD\ndef parse(f, lo, hi):\n    vals=set()\n    for part in f.split(','):\n        step=1\n        if '/' in part: part, s = part.split('/'); step=int(s)\n        if part=='*': a,b=lo,hi\n        elif '-' in part: a,b=map(int,part.split('-'))\n        else: a=b=int(part)\n        if '/' in f and '-' not in part and part!='*' : b=hi\n        vals.update(range(a,b+1,step))\n    return vals\ndef nxt(expr, start):\n    m,h,dom,mon,dow=expr.split()\n    M,H,DOM,MON=parse(m,0,59),parse(h,0,23),parse(dom,1,31),parse(mon,1,12)\n    DOW=parse(dow.replace('7','0'),0,6)\n    t=start.replace(second=0,microsecond=0)+TD(minutes=1)\n    while True:\n        cd=(t.weekday()+1)%7\n        ok=t.minute in M and t.hour in H and t.month in MON\n        dm=dom=='*'; dwm=dow=='*'\n        day=(t.day in DOM) if dwm else (cd in DOW) if dm else (t.day in DOM or cd in DOW)\n        if ok and day: return t\n        t+=TD(minutes=1)\ns=DT(2026,10,13,9,30)\n(nxt('30 9 * * 1-5', s), nxt('*/15 * * * *', s), nxt('0 0 13 * 5', s), nxt('0 4 * * *', s), nxt('0 0 29 2 *', s), sorted(parse('*/20',0,59)))"@en ; chx:input "from datetime import datetime as DT, timedelta as TD\ndef parse(f, lo, hi):\n    vals=set()\n    for part in f.split(','):\n        step=1\n        if '/' in part: part, s = part.split('/'); step=int(s)\n        if part=='*': a,b=lo,hi\n        elif '-' in part: a,b=map(int,part.split('-'))\n        else: a=b=int(part)\n        if '/' in f and '-' not in part and part!='*' : b=hi\n        vals.update(range(a,b+1,step))\n    return vals\ndef nxt(expr, start):\n    m,h,dom,mon,dow=expr.split()\n    M,H,DOM,MON=parse(m,0,59),parse(h,0,23),parse(dom,1,31),parse(mon,1,12)\n    DOW=parse(dow.replace('7','0'),0,6)\n    t=start.replace(second=0,microsecond=0)+TD(minutes=1)\n    while True:\n        cd=(t.weekday()+1)%7\n        ok=t.minute in M and t.hour in H and t.month in MON\n        dm=dom=='*'; dwm=dow=='*'\n        day=(t.day in DOM) if dwm else (cd in DOW) if dm else (t.day in DOM or cd in DOW)\n        if ok and day: return t\n        t+=TD(minutes=1)\ns=DT(2026,10,13,9,30)\n(nxt('30 9 * * 1-5', s), nxt('*/15 * * * *', s), nxt('0 0 13 * 5', s), nxt('0 4 * * *', s), nxt('0 0 29 2 *', s), sorted(parse('*/20',0,59)))" ; chx:output "(datetime.datetime(2026, 10, 14, 9, 30), datetime.datetime(2026, 10, 13, 9, 45), datetime.datetime(2026, 10, 16, 0, 0), datetime.datetime(2026, 10, 14, 4, 0), datetime.datetime(2028, 2, 29, 0, 0), [0, 20, 40])" .
chx:X_CronFields rd:hasIOExample chx:IO_CronFields .
chx:X_CronEnvironment a owl:NamedIndividual, chx:CronEnvironment ; rdfs:label "crontab -e"@en ; skos:definition "A job started by cron does not run in the shell that installed it: on this machine a Python job run by cron 3.0pl1 saw PATH=/usr/bin:/bin, the working directory /root, 6 environment variables, no terminal, sh as its parent and a clock in UTC while the shell's TZ was Europe/Istanbul; a TZ=Asia/Kolkata line reached the job and set its clock to IST, but the time an entry fires follows the zone of the cron daemon, not of the job, and a CRON_TZ line was passed to the job as a variable and did not move the schedule."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_LaunchdPlist a owl:NamedIndividual, chx:LaunchdPlist ; rdfs:label "StartCalendarInterval"@en ; skos:definition "launchd on macOS reads a property list in which StartCalendarInterval names the hour and minute of a daily job; plistlib writes and reads such a file as XML and the result reads back equal to the dictionary, but nothing here ran launchd."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_LaunchdPlist a owl:NamedIndividual, rd:IOExample ; rdfs:label "import plistlib\nd={'Label':'org.example.backup','ProgramArguments':['/usr/bin/python3','/Users/al/backup.py'],'StartCalendarInterval':{'Hour':4,'Minute':0}}\nb=plistlib.dumps(d); back=plistlib.loads(b)\n(back==d, b.decode().splitlines()[:3], len(b), b.count(b'<key>'), plistlib.FMT_XML.name)"@en ; chx:input "import plistlib\nd={'Label':'org.example.backup','ProgramArguments':['/usr/bin/python3','/Users/al/backup.py'],'StartCalendarInterval':{'Hour':4,'Minute':0}}\nb=plistlib.dumps(d); back=plistlib.loads(b)\n(back==d, b.decode().splitlines()[:3], len(b), b.count(b'<key>'), plistlib.FMT_XML.name)" ; chx:output "(True, ['<?xml version='1.0' encoding='UTF-8'?>', '<!DOCTYPE plist PUBLIC '-//Apple//DTD PLIST 1.0//EN' 'http://www.apple.com/DTDs/PropertyList-1.0.dtd'>', '<plist version='1.0'>'], 501, 5, 'FMT_XML')" .
chx:X_LaunchdPlist rd:hasIOExample chx:IO_LaunchdPlist .
chx:X_SystemdCalendar a owl:NamedIndividual, chx:SystemdCalendar ; rdfs:label "OnCalendar=Mon..Fri 09:00"@en ; skos:definition "A systemd timer takes an OnCalendar expression, and systemd-analyze calendar normalises it without running anything: 'Mon..Fri 09:00' becomes 'Mon..Fri *-*-* 09:00:00', 'daily' becomes '*-*-* 00:00:00' and 'weekly' becomes 'Mon *-*-* 00:00:00'; the container's PID 1 is not systemd, so no timer ran."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SystemdCalendar a owl:NamedIndividual, rd:IOExample ; rdfs:label "import os, subprocess\ndef cal(expr, tz):\n    r=subprocess.run(['systemd-analyze','calendar',expr],capture_output=True,text=True,env=dict(os.environ,TZ=tz)); return r.stdout.splitlines()[:2]\n(cal('Mon..Fri 09:00','UTC'), cal('*-*-* 04:00','Europe/Istanbul'), cal('daily','UTC'), cal('weekly','UTC'))"@en ; chx:input "import os, subprocess\ndef cal(expr, tz):\n    r=subprocess.run(['systemd-analyze','calendar',expr],capture_output=True,text=True,env=dict(os.environ,TZ=tz)); return r.stdout.splitlines()[:2]\n(cal('Mon..Fri 09:00','UTC'), cal('*-*-* 04:00','Europe/Istanbul'), cal('daily','UTC'), cal('weekly','UTC'))" ; chx:output "(['  Original form: Mon..Fri 09:00', 'Normalized form: Mon..Fri *-*-* 09:00:00'], ['  Original form: *-*-* 04:00', 'Normalized form: *-*-* 04:00:00'], ['  Original form: daily', 'Normalized form: *-*-* 00:00:00'], ['  Original form: weekly', 'Normalized form: Mon *-*-* 00:00:00'])" .
chx:X_SystemdCalendar rd:hasIOExample chx:IO_SystemdCalendar .
chx:X_SchedModule a owl:NamedIndividual, chx:SchedModule ; rdfs:label "sched.scheduler(time.monotonic, time.sleep)"@en ; skos:definition "sched.scheduler keeps events in a queue ordered by time and then priority and run() calls them in that order: with a fake clock, events at 0 s, 2 s and two at 5 s with priorities 1 and 0 ran as now, two, five with priority 0, five, and cancel() on an event that has run raises ValueError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SchedModule a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sched\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nclock=[0.0]; log=[]\ndef now():\n    return clock[0]\ndef pause(d):\n    clock[0] += d\ns=sched.scheduler(now, pause)\ns.enter(5, 1, log.append, ('five',)); s.enter(2, 1, log.append, ('two',)); s.enter(5, 0, log.append, ('five, priority 0',)); s.enter(0, 9, log.append, ('now',))\nn=len(s.queue); s.run()\nclock2=[100.0]; log2=[]\ndef now2():\n    return clock2[0]\ndef pause2(d):\n    clock2[0] += d\ns2=sched.scheduler(now2, pause2)\ne=s2.enterabs(130, 1, log2.append, ('thirty',)); s2.enterabs(110, 1, log2.append, ('ten',)); s2.cancel(e); s2.enterabs(90, 1, log2.append, ('past',))\ns2.run()\ndef _e41():\n    return s2.cancel(e)\n(n, log, clock[0], s.empty(), log2, clock2[0], err(_e41)[0])"@en ; chx:input "import sched\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nclock=[0.0]; log=[]\ndef now():\n    return clock[0]\ndef pause(d):\n    clock[0] += d\ns=sched.scheduler(now, pause)\ns.enter(5, 1, log.append, ('five',)); s.enter(2, 1, log.append, ('two',)); s.enter(5, 0, log.append, ('five, priority 0',)); s.enter(0, 9, log.append, ('now',))\nn=len(s.queue); s.run()\nclock2=[100.0]; log2=[]\ndef now2():\n    return clock2[0]\ndef pause2(d):\n    clock2[0] += d\ns2=sched.scheduler(now2, pause2)\ne=s2.enterabs(130, 1, log2.append, ('thirty',)); s2.enterabs(110, 1, log2.append, ('ten',)); s2.cancel(e); s2.enterabs(90, 1, log2.append, ('past',))\ns2.run()\ndef _e41():\n    return s2.cancel(e)\n(n, log, clock[0], s.empty(), log2, clock2[0], err(_e41)[0])" ; chx:output "(4, ['now', 'two', 'five, priority 0', 'five'], 5.0, True, ['past', 'ten'], 110.0, 'ValueError')" .
chx:X_SchedModule rd:hasIOExample chx:IO_SchedModule .
chx:X_TimerThread a owl:NamedIndividual, chx:TimerThread ; rdfs:label "threading.Timer(0.1, func)"@en ; skos:definition "threading.Timer is a Thread that calls a function once after a delay; nothing has run right after start(), the call has run after join(), and cancel() stops a timer that has not fired."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TimerThread a owl:NamedIndividual, rd:IOExample ; rdfs:label "import threading\nhits=[]\nt=threading.Timer(0.1, hits.append, args=('fired',)); t.start(); mid=list(hits); t.join()\nt2=threading.Timer(5, hits.append, args=('never',)); t2.start(); t2.cancel(); t2.join(1)\n(mid, hits, threading.Timer.__mro__[1].__name__, t.is_alive(), t2.is_alive(), t.daemon)"@en ; chx:input "import threading\nhits=[]\nt=threading.Timer(0.1, hits.append, args=('fired',)); t.start(); mid=list(hits); t.join()\nt2=threading.Timer(5, hits.append, args=('never',)); t2.start(); t2.cancel(); t2.join(1)\n(mid, hits, threading.Timer.__mro__[1].__name__, t.is_alive(), t2.is_alive(), t.daemon)" ; chx:output "([], ['fired'], 'Thread', False, False, False)" .
chx:X_TimerThread rd:hasIOExample chx:IO_TimerThread .
chx:X_AsyncioCallLater a owl:NamedIndividual, chx:AsyncioCallLater ; rdfs:label "loop.call_later(0.2, func)"@en ; skos:definition "An asyncio event loop runs a callback after a delay with call_later or at a loop time with call_at: callbacks scheduled with call_soon, then call_later 0.1 and 0.2, ran in the order soon, later 0.1, later 0.2."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_AsyncioCallLater a owl:NamedIndividual, rd:IOExample ; rdfs:label "import asyncio\nlog=[]\nasync def main():\n    loop=asyncio.get_running_loop(); loop.call_later(0.2, log.append, 'later 0.2'); loop.call_later(0.1, log.append, 'later 0.1'); loop.call_soon(log.append, 'soon')\n    await asyncio.sleep(0.3)\nasyncio.run(main())\nlog"@en ; chx:input "import asyncio\nlog=[]\nasync def main():\n    loop=asyncio.get_running_loop(); loop.call_later(0.2, log.append, 'later 0.2'); loop.call_later(0.1, log.append, 'later 0.1'); loop.call_soon(log.append, 'soon')\n    await asyncio.sleep(0.3)\nasyncio.run(main())\nlog" ; chx:output "['soon', 'later 0.1', 'later 0.2']" .
chx:X_AsyncioCallLater rd:hasIOExample chx:IO_AsyncioCallLater .
chx:X_ScheduleLibrary a owl:NamedIndividual, chx:ScheduleLibrary ; rdfs:label "schedule.every().day.at('10:30').do(job)"@en ; skos:definition "The third-party schedule 1.2.2 runs jobs written as every().day.at('10:30').do(job) inside a running Python process: the first run is set for 10:30:00 and an every(10).minutes job is more than 590 seconds away; the process must keep calling run_pending, so it is not an operating system scheduler."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ScheduleLibrary a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT\nimport schedule, importlib.metadata as md\ns=schedule.Scheduler(); j=s.every().day.at('10:30').do(print, 'job'); k=s.every(10).minutes.do(print, 'tick')\n(md.version('schedule'), j.next_run.strftime('%H:%M:%S'), (k.next_run-DT.now()).total_seconds()>590, str(j)[:30], s.idle_seconds is not None, len(s.jobs))"@en ; chx:input "from datetime import datetime as DT\nimport schedule, importlib.metadata as md\ns=schedule.Scheduler(); j=s.every().day.at('10:30').do(print, 'job'); k=s.every(10).minutes.do(print, 'tick')\n(md.version('schedule'), j.next_run.strftime('%H:%M:%S'), (k.next_run-DT.now()).total_seconds()>590, str(j)[:30], s.idle_seconds is not None, len(s.jobs))" ; chx:output "('1.2.2', '10:30:00', True, 'Job(interval=1, unit=days, do=', True, 2)" .
chx:X_ScheduleLibrary rd:hasIOExample chx:IO_ScheduleLibrary .
chx:X_EnDashListings a owl:NamedIndividual, chx:EnDashListings ; rdfs:label "end_time – start_time"@en ; skos:definition "Four places in three listings of the chapter, listings 2, 6 and 12 of the web page, write the en dash U+2013 where the minus sign belongs, and the compiler refuses the character with SyntaxError 'invalid character'; a minus sign compiles, and the en dash is not an identifier character either."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_EnDashListings a owl:NamedIndividual, rd:IOExample ; rdfs:label "def err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef _e44():\n    return compile('x = 5 - 3', 'f', 'exec')\ndef _e43():\n    return compile(\"print(f'{5 – 3}')\", 'f', 'exec')\ndef _e42():\n    return compile('x = 5 – 3', 'f', 'exec')\n(err(_e42), err(_e44)[0], err(_e43), ord('–'), '–'.isidentifier())"@en ; chx:input "def err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef _e44():\n    return compile('x = 5 - 3', 'f', 'exec')\ndef _e43():\n    return compile(\"print(f'{5 – 3}')\", 'f', 'exec')\ndef _e42():\n    return compile('x = 5 – 3', 'f', 'exec')\n(err(_e42), err(_e44)[0], err(_e43), ord('–'), '–'.isidentifier())" ; chx:output "(('SyntaxError', 'invalid character '–' (U+2013) (f, line 1)'), 'ok', ('SyntaxError', 'invalid character '–' (U+2013) (f, line 1)'), 8211, False)" .
chx:X_EnDashListings rd:hasIOExample chx:IO_EnDashListings .
chx:X_ShippedFiles a owl:NamedIndividual, chx:ShippedFiles ; rdfs:label "calcProd.py, stopwatch.py, simplecountdown.py"@en ; skos:definition "The online materials ship three files for the chapter and none of them is the printed listing: stopwatch.py has two en dashes, CRLF line ends and a print without the f prefix, calcProd.py loops to 99999, prints a digit count and has an en dash, and simplecountdown.py differs from the chapter only in spacing; the study fetched them and compared their SHA-256 hashes."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_ReplayOfListings a owl:NamedIndividual, chx:ReplayOfListings ; rdfs:label ">>> statements of the interactive sessions"@en ; skos:definition "The 75 statements of the 20 interactive sessions were replayed in a clean Python 3.14.6 in the author's zone, America/Los_Angeles: 54 printed what the book prints and 21 did not, of which 7 depend on the clock, 1 is the en dash and 13 need Windows or macOS or a program Linux lacks; with the dash repaired 55 match, and in the zone of Istanbul one more differs, fromtimestamp(1000000)."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_LapArithmetic a owl:NamedIndividual, chx:LapArithmetic ; rdfs:label "lap_time = round(time.time() - last_time, 2)"@en ; skos:definition "The stopwatch program rounds each difference to two digits, so for the readings 0, 3.56, 8.63, 17.68 and 19.11 it prints laps 3.56, 5.07, 9.05 and 1.43 with the totals 3.56, 8.63, 17.68 and 19.11, while the unrounded last lap is 1.4299999999999997."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_LapArithmetic a owl:NamedIndividual, rd:IOExample ; rdfs:label "seq=[0.0, 3.56, 8.63, 17.68, 19.11]; start=seq[0]; last=start; rows=[]\nfor i, now in enumerate(seq[1:], 1):\n    lap=round(now-last,2); total=round(now-start,2); rows.append((i,total,lap)); last=now\nprinted=[f'Lap #{n}: {tot}({lap})' for n,tot,lap in rows]\n(printed, round(8.63-3.56,2), 8.63-3.56, round(19.11-17.68,2), 19.11-17.68)"@en ; chx:input "seq=[0.0, 3.56, 8.63, 17.68, 19.11]; start=seq[0]; last=start; rows=[]\nfor i, now in enumerate(seq[1:], 1):\n    lap=round(now-last,2); total=round(now-start,2); rows.append((i,total,lap)); last=now\nprinted=[f'Lap #{n}: {tot}({lap})' for n,tot,lap in rows]\n(printed, round(8.63-3.56,2), 8.63-3.56, round(19.11-17.68,2), 19.11-17.68)" ; chx:output "(['Lap #1: 3.56(3.56)', 'Lap #2: 8.63(5.07)', 'Lap #3: 17.68(9.05)', 'Lap #4: 19.11(1.43)'], 5.07, 5.07, 1.43, 1.4299999999999997)" .
chx:X_LapArithmetic rd:hasIOExample chx:IO_LapArithmetic .
chx:X_ColumnFormatting a owl:NamedIndividual, chx:ColumnFormatting ; rdfs:label "str(lap_time).rjust(6)"@en ; skos:definition "The Prettified Stopwatch pads the lap number to 2 characters and the times to 6 with rjust, which produces the book's lines such as 'Lap # 1:   3.56 (  3.56)', and an f-string with >2 and >6 produces the same text; str(2.0).ljust(6) is '2.0   ' and a float is formatted without losing a trailing zero only by .2f."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ColumnFormatting a owl:NamedIndividual, rd:IOExample ; rdfs:label "expected=['Lap # 1:   3.56 (  3.56)','Lap # 2:   8.63 (  5.07)','Lap # 3:  17.68 (  9.05)','Lap # 4:  19.11 (  1.43)']\nrows=[(1,3.56,3.56),(2,8.63,5.07),(3,17.68,9.05),(4,19.11,1.43)]\ngot=['Lap #' + str(n).rjust(2) + ': ' + str(t).rjust(6) + ' (' + str(l).rjust(6) + ')' for n,t,l in rows]\ngot2=[f'Lap #{n:>2}: {t:>6} ({l:>6})' for n,t,l in rows]\n(got==expected, got2==expected, [str(x).ljust(6) for x in (2.0,)], str(2.0), str(round(2.004,2)), f'{round(2.004,2):.2f}', len(max(expected,key=len)))"@en ; chx:input "expected=['Lap # 1:   3.56 (  3.56)','Lap # 2:   8.63 (  5.07)','Lap # 3:  17.68 (  9.05)','Lap # 4:  19.11 (  1.43)']\nrows=[(1,3.56,3.56),(2,8.63,5.07),(3,17.68,9.05),(4,19.11,1.43)]\ngot=['Lap #' + str(n).rjust(2) + ': ' + str(t).rjust(6) + ' (' + str(l).rjust(6) + ')' for n,t,l in rows]\ngot2=[f'Lap #{n:>2}: {t:>6} ({l:>6})' for n,t,l in rows]\n(got==expected, got2==expected, [str(x).ljust(6) for x in (2.0,)], str(2.0), str(round(2.004,2)), f'{round(2.004,2):.2f}', len(max(expected,key=len)))" ; chx:output "(True, True, ['2.0   '], '2.0', '2.0', '2.00', 24)" .
chx:X_ColumnFormatting rd:hasIOExample chx:IO_ColumnFormatting .
chx:X_CountdownLoop a owl:NamedIndividual, chx:CountdownLoop ; rdfs:label "while time_left > 0:"@en ; skos:definition "The countdown loop prints the time left, sleeps one second and subtracts one; counted with a fake sleep, 3 seconds print 3, 2 and 1 and then Beep!, after 3.0 seconds of sleeping, and the real program takes slightly longer than the sum of its sleeps."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CountdownLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "lines=[]; left=3; t=[0.0]\ndef sleep(d): t[0]+=d\nwhile left>0:\n    lines.append(str(left)+' '); sleep(1); left-=1\nlines.append('Beep!')\n(lines, t[0])"@en ; chx:input "lines=[]; left=3; t=[0.0]\ndef sleep(d): t[0]+=d\nwhile left>0:\n    lines.append(str(left)+' '); sleep(1); left-=1\nlines.append('Beep!')\n(lines, t[0])" ; chx:output "(['3 ', '2 ', '1 ', 'Beep!'], 3.0)" .
chx:X_CountdownLoop rd:hasIOExample chx:IO_CountdownLoop .
chx:X_AlarmSound a owl:NamedIndividual, chx:AlarmSound ; rdfs:label "autbor.com/alarm.wav"@en ; skos:definition "autbor.com/alarm.wav answers 302 and redirects to automatetheboringstuff.com/src/alarm.wav, a 582,952-byte 16-bit stereo 44.1 kHz file of 3.30 seconds; the online materials do not hold it, and no sound could be played in the container, so the playing was not heard."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_FridayForward a owl:NamedIndividual, chx:FridayForward ; rdfs:label "while len(found) < 10: if d.day == 13 and d.weekday() == 4"@en ; skos:definition "Walking forward one day at a time from 13 October 2026 finds the next ten Friday the 13ths: 13 November 2026, 13 August 2027, 13 October 2028, 13 April 2029, 13 July 2029, 13 September 2030, 13 December 2030, 13 June 2031, 13 February 2032 and 13 August 2032."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_FridayForward a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import timedelta as TD, date as D\nd=D(2026,10,13); one=TD(days=1); found=[]\nwhile len(found)<10:\n    if d.day==13 and d.weekday()==4: found.append(d)\n    d+=one\n([x.isoformat() for x in found], [x.strftime('%B %Y') for x in found][:3], all(x.strftime('%A')=='Friday' for x in found))"@en ; chx:input "from datetime import timedelta as TD, date as D\nd=D(2026,10,13); one=TD(days=1); found=[]\nwhile len(found)<10:\n    if d.day==13 and d.weekday()==4: found.append(d)\n    d+=one\n([x.isoformat() for x in found], [x.strftime('%B %Y') for x in found][:3], all(x.strftime('%A')=='Friday' for x in found))" ; chx:output "(['2026-11-13', '2027-08-13', '2028-10-13', '2029-04-13', '2029-07-13', '2030-09-13', '2030-12-13', '2031-06-13', '2032-02-13', '2032-08-13'], ['November 2026', 'August 2027', 'October 2028'], True)" .
chx:X_FridayForward rd:hasIOExample chx:IO_FridayForward .
chx:X_FridayBackward a owl:NamedIndividual, chx:FridayBackward ; rdfs:label "d -= datetime.timedelta(days=1)"@en ; skos:definition "Walking backward from 13 October 2026 finds 3485 Friday the 13ths, the latest 13 March 2026 and the earliest 13 April of the year 1, then date arithmetic raises OverflowError at 1 January of the year 1, 739,901 days back; the 400-year Gregorian cycle of 146,097 days is a multiple of 7 and holds 688 Friday the 13ths, more than any other weekday's 13ths."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_FridayBackward a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import timedelta as TD, date as D\nfrom collections import Counter\nd=D(2026,10,13); one=TD(days=1); n=0; first=None; last=None\ntry:\n    while True:\n        if d.day==13 and d.weekday()==4:\n            n+=1; last=d\n            if first is None: first=d\n        d-=one\nexcept OverflowError as e: stop=(str(e), d)\nbyday=Counter(D(y,m,13).weekday() for y in range(2000,2400) for m in range(1,13))\n(first, last, n, stop, (D(2026,10,13)-D(1,1,1)).days, sorted(byday.items()), (400*365+97)%7, 400*365+97)"@en ; chx:input "from datetime import timedelta as TD, date as D\nfrom collections import Counter\nd=D(2026,10,13); one=TD(days=1); n=0; first=None; last=None\ntry:\n    while True:\n        if d.day==13 and d.weekday()==4:\n            n+=1; last=d\n            if first is None: first=d\n        d-=one\nexcept OverflowError as e: stop=(str(e), d)\nbyday=Counter(D(y,m,13).weekday() for y in range(2000,2400) for m in range(1,13))\n(first, last, n, stop, (D(2026,10,13)-D(1,1,1)).days, sorted(byday.items()), (400*365+97)%7, 400*365+97)" ; chx:output "(datetime.date(2026, 3, 13), datetime.date(1, 4, 13), 3485, ('date value out of range', datetime.date(1, 1, 1)), 739901, [(0, 685), (1, 685), (2, 687), (3, 684), (4, 688), (5, 684), (6, 687)], 0, 146097)" .
chx:X_FridayBackward rd:hasIOExample chx:IO_FridayBackward .
chx:X_AppendixBAnswers a owl:NamedIndividual, chx:AppendixBAnswers ; rdfs:label "round(2.5)"@en ; skos:definition "Appendix B answers question 3 with time.asctime(), which prints what ctime() prints for the current time, question 5 with 'the closest integer', which is incomplete because round(2.5) is 2 and round(x, 2) returns a float, and question 7 with weekday() equal to 0 for Monday, which is right."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_AppendixBAnswers a owl:NamedIndividual, rd:IOExample ; rdfs:label "import os, sys, time, subprocess\nfrom datetime import datetime as DT\ndef child(code, **env):\n    e = dict(os.environ)\n    e.update(env)\n    r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, env=e)\n    if r.returncode == 0:\n        return r.stdout.strip()\n    return r.stderr.strip().splitlines()[-1]\n(round(2.4), round(2.5), round(3.5), type(round(2.5)).__name__, type(round(2.5,2)).__name__, child(\"import time; print(time.asctime() == time.ctime())\"), child(\"import time; print(time.asctime(time.localtime(5)) == time.ctime(5))\"), time.asctime(time.gmtime(0)), DT(2019,1,7).weekday())"@en ; chx:input "import os, sys, time, subprocess\nfrom datetime import datetime as DT\ndef child(code, **env):\n    e = dict(os.environ)\n    e.update(env)\n    r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, env=e)\n    if r.returncode == 0:\n        return r.stdout.strip()\n    return r.stderr.strip().splitlines()[-1]\n(round(2.4), round(2.5), round(3.5), type(round(2.5)).__name__, type(round(2.5,2)).__name__, child(\"import time; print(time.asctime() == time.ctime())\"), child(\"import time; print(time.asctime(time.localtime(5)) == time.ctime(5))\"), time.asctime(time.gmtime(0)), DT(2019,1,7).weekday())" ; chx:output "(2, 2, 4, 'int', 'float', 'True', 'True', 'Thu Jan  1 00:00:00 1970', 0)" .
chx:X_AppendixBAnswers rd:hasIOExample chx:IO_AppendixBAnswers .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 19 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch19/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 19 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which clock answers which question, which moments and durations can a datetime hold and which does it refuse or misread, and how does a program launch, wait for, stop and schedule another program on an operating system where the commands of the book do not exist?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, programs, numbers and statements of the chapter differ in current releases of Python, in the zone and the clock of the author, in the files the book ships or in the pages it points to, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 19 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 19 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch19/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-13."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py" .

