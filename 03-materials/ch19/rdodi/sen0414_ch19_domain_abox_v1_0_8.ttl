chx:X_EpochZero a owl:NamedIndividual, chx:EpochZero ; rdfs:label "time.gmtime(0)"@en ; skos:definition "The epoch of the time module is 00:00:00 UTC on 1 January 1970: time.gmtime(0) gives (1970, 1, 1, 0, 0, 0), calendar.timegm returns 0 for that moment, and time.time() returns the seconds since then as a float, not an int."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_EpochZero a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time, calendar\nfrom datetime import datetime as DT, UTC\n(time.gmtime(0)[:6], time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime(0)), calendar.timegm((1970,1,1,0,0,0)), DT(1970,1,1,tzinfo=UTC).timestamp(), type(time.time()).__name__)"@en ; chx:input "import time, calendar\nfrom datetime import datetime as DT, UTC\n(time.gmtime(0)[:6], time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime(0)), calendar.timegm((1970,1,1,0,0,0)), DT(1970,1,1,tzinfo=UTC).timestamp(), type(time.time()).__name__)" ; chx:output "((1970, 1, 1, 0, 0, 0), '1970-01-01 00:00:00', 0, 0.0, 'float')" .
chx:X_EpochZero rd:hasIOExample chx:IO_EpochZero .
chx:X_PosixFormula a owl:NamedIndividual, chx:PosixFormula ; rdfs:label "tm_sec + tm_min*60 + tm_hour*3600 + tm_yday*86400 + ..."@en ; skos:definition "POSIX defines the seconds since the epoch by a formula of the broken-down UTC fields in which every day has 86,400 seconds, so a leap second has no number: the formula gives 1773813875 for 06:04:35 UTC on 18 March 2026, the same as calendar.timegm, 23:59:59 on 31 December 2016 and the next midnight are 1 second apart, and datetime refuses a 60th second."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PosixFormula a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time, calendar\nfrom datetime import datetime as DT\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef posix(y,mo,d,h,mi,s):\n    tm_year=y-1900; tm_yday=(DT(y,mo,d)-DT(y,1,1)).days\n    return s+mi*60+h*3600+tm_yday*86400+(tm_year-70)*31536000+((tm_year-69)//4)*86400-((tm_year-1)//100)*86400+((tm_year+299)//400)*86400\ndef _e1():\n    return DT(2016,12,31,23,59,60)\n(posix(2026,3,18,6,4,35), calendar.timegm((2026,3,18,6,4,35)), posix(2000,2,29,12,0,0)==calendar.timegm((2000,2,29,12,0,0)), calendar.timegm((2017,1,1,0,0,0)) - calendar.timegm((2016,12,31,23,59,59)), err(_e1), time.strptime('2016-12-31 23:59:60','%Y-%m-%d %H:%M:%S')[5])"@en ; chx:input "import time, calendar\nfrom datetime import datetime as DT\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef posix(y,mo,d,h,mi,s):\n    tm_year=y-1900; tm_yday=(DT(y,mo,d)-DT(y,1,1)).days\n    return s+mi*60+h*3600+tm_yday*86400+(tm_year-70)*31536000+((tm_year-69)//4)*86400-((tm_year-1)//100)*86400+((tm_year+299)//400)*86400\ndef _e1():\n    return DT(2016,12,31,23,59,60)\n(posix(2026,3,18,6,4,35), calendar.timegm((2026,3,18,6,4,35)), posix(2000,2,29,12,0,0)==calendar.timegm((2000,2,29,12,0,0)), calendar.timegm((2017,1,1,0,0,0)) - calendar.timegm((2016,12,31,23,59,59)), err(_e1), time.strptime('2016-12-31 23:59:60','%Y-%m-%d %H:%M:%S')[5])" ; chx:output "(1773813875, 1773813875, True, 1, ('ValueError', 'second must be in 0..59, not 60'), 60)" .
chx:X_PosixFormula rd:hasIOExample chx:IO_PosixFormula .
chx:X_FloatPrecision a owl:NamedIndividual, chx:FloatPrecision ; rdfs:label "time.time() and time.time_ns()"@en ; skos:definition "time.time() returns a float, a 64-bit double, which for a timestamp of 1773813875.35 has a spacing of 2.4e-07 seconds between neighbouring values, finer than a microsecond, while time.time_ns() returns an int of 19 digits that has no rounding at all."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_FloatPrecision a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time, math\nts=1773813875.3518236\n(type(ts).__name__, math.ulp(ts), math.ulp(ts)<1e-6, repr(ts), type(time.time_ns()).__name__, time.time_ns()>10**18, len(str(time.time_ns())))"@en ; chx:input "import time, math\nts=1773813875.3518236\n(type(ts).__name__, math.ulp(ts), math.ulp(ts)<1e-6, repr(ts), type(time.time_ns()).__name__, time.time_ns()>10**18, len(str(time.time_ns())))" ; chx:output "('float', 2.384185791015625e-07, True, '1773813875.3518236', 'int', True, 19)" .
chx:X_FloatPrecision rd:hasIOExample chx:IO_FloatPrecision .
chx:X_ClockInfoTable a owl:NamedIndividual, chx:ClockInfoTable ; rdfs:label "time.get_clock_info('monotonic')"@en ; skos:definition "time.get_clock_info reports for each clock whether it is monotonic and whether it is adjustable: on Linux time.time reads CLOCK_REALTIME and is adjustable but not monotonic, while monotonic and perf_counter read CLOCK_MONOTONIC and are monotonic and not adjustable; a difference of two monotonic readings across time.sleep(0.05) is at least 0.05."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ClockInfoTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time\na=time.monotonic(); b=time.perf_counter(); time.sleep(0.05); a2=time.monotonic(); b2=time.perf_counter()\n({n: (time.get_clock_info(n).monotonic, time.get_clock_info(n).adjustable, time.get_clock_info(n).implementation) for n in ('time','monotonic','perf_counter','process_time')}, a2-a >= 0.05, b2-b >= 0.05)"@en ; chx:input "import time\na=time.monotonic(); b=time.perf_counter(); time.sleep(0.05); a2=time.monotonic(); b2=time.perf_counter()\n({n: (time.get_clock_info(n).monotonic, time.get_clock_info(n).adjustable, time.get_clock_info(n).implementation) for n in ('time','monotonic','perf_counter','process_time')}, a2-a >= 0.05, b2-b >= 0.05)" ; chx:output "({'time': (False, True, 'clock_gettime(CLOCK_REALTIME)'), 'monotonic': (True, False, 'clock_gettime(CLOCK_MONOTONIC)'), 'perf_counter': (True, False, 'clock_gettime(CLOCK_MONOTONIC)'), 'process_time': (True, False, 'clock_gettime(CLOCK_PROCESS_CPUTIME_ID)')}, True, True)" .
chx:X_ClockInfoTable rd:hasIOExample chx:IO_ClockInfoTable .
chx:X_SteppedWallClock a owl:NamedIndividual, chx:SteppedWallClock ; rdfs:label "end_time - start_time"@en ; skos:definition "The difference of two readings of an adjustable clock is wrong when someone sets the clock between them: if the wall clock reads 1000.0 and then, set back, 990.0, the difference is -10.0 seconds, while the two readings of a monotonic clock 50.0 and 60.0 give the true +10.0."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SteppedWallClock a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time\nclass Fake:\n    def __init__(s, seq): s.seq=iter(seq)\n    def __call__(s): return next(s.seq)\nwall=Fake([1000.0, 990.0]); mono=Fake([50.0, 60.0])\nw0=wall(); m0=mono(); w1=wall(); m1=mono()\n(w1-w0, m1-m0, time.get_clock_info('time').adjustable, time.get_clock_info('monotonic').adjustable)"@en ; chx:input "import time\nclass Fake:\n    def __init__(s, seq): s.seq=iter(seq)\n    def __call__(s): return next(s.seq)\nwall=Fake([1000.0, 990.0]); mono=Fake([50.0, 60.0])\nw0=wall(); m0=mono(); w1=wall(); m1=mono()\n(w1-w0, m1-m0, time.get_clock_info('time').adjustable, time.get_clock_info('monotonic').adjustable)" ; chx:output "(-10.0, 10.0, True, False)" .
chx:X_SteppedWallClock rd:hasIOExample chx:IO_SteppedWallClock .
chx:X_RoundFunction a owl:NamedIndividual, chx:RoundFunction ; rdfs:label "round(time.time() - last_time, 2)"@en ; skos:definition "round(x) with no digits returns an int and rounds a tie to the even neighbour, so round(2.5) is 2 and round(3.5) is 4, while round(x, 2) returns a float and round(2.675, 2) is 2.67 because the float nearest 2.675 lies just below it."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_RoundFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(round(2.4), round(2.5), round(3.5), type(round(2.5)).__name__, round(2.675,2), type(round(2.0,2)).__name__, round(3.14159,2), round(0.5), round(-0.5), round(1773813875.3518236,2))"@en ; chx:input "(round(2.4), round(2.5), round(3.5), type(round(2.5)).__name__, round(2.675,2), type(round(2.0,2)).__name__, round(3.14159,2), round(0.5), round(-0.5), round(1773813875.3518236,2))" ; chx:output "(2, 2, 4, 'int', 2.67, 'float', 3.14, 0, 0, 1773813875.35)" .
chx:X_RoundFunction rd:hasIOExample chx:IO_RoundFunction .
chx:X_ProfilingByClock a owl:NamedIndividual, chx:ProfilingByClock ; rdfs:label "calcProd()"@en ; skos:definition "Profiling code by the time between two clock readings measures one run on one machine: the product of 1 to 100000 built by a loop equals math.factorial(100000), has 1,516,705 bits and 456,574 decimal digits, and converting it to a string raises ValueError under the default limit of 4300 digits."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ProfilingByClock a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, math\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef calc():\n    p=1\n    for i in range(1,100001): p=p*i\n    return p\nr=calc()\ndef _e2():\n    return str(r)\n(r==math.factorial(100000), r==math.prod(range(1,100001)), r.bit_length(), err(_e2)[0], sys.get_int_max_str_digits(), len(str(r)) if sys.set_int_max_str_digits(0) is None else 0)"@en ; chx:input "import sys, math\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef calc():\n    p=1\n    for i in range(1,100001): p=p*i\n    return p\nr=calc()\ndef _e2():\n    return str(r)\n(r==math.factorial(100000), r==math.prod(range(1,100001)), r.bit_length(), err(_e2)[0], sys.get_int_max_str_digits(), len(str(r)) if sys.set_int_max_str_digits(0) is None else 0)" ; chx:output "(True, True, 1516705, 'ValueError', 4300, 456574)" .
chx:X_ProfilingByClock rd:hasIOExample chx:IO_ProfilingByClock .
chx:X_SleepFunction a owl:NamedIndividual, chx:SleepFunction ; rdfs:label "time.sleep(5)"@en ; skos:definition "time.sleep(seconds) blocks the calling thread and returns None; a negative number raises ValueError and a string raises TypeError, and a monotonic clock shows that the pause lasted at least as long as asked."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SleepFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nt=time.monotonic(); r=time.sleep(0.2); e=time.monotonic()-t\ndef _e4():\n    return time.sleep('1')\ndef _e3():\n    return time.sleep(-1)\n(r, e>=0.2, e<0.5, err(_e3), err(_e4))"@en ; chx:input "import time\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nt=time.monotonic(); r=time.sleep(0.2); e=time.monotonic()-t\ndef _e4():\n    return time.sleep('1')\ndef _e3():\n    return time.sleep(-1)\n(r, e>=0.2, e<0.5, err(_e3), err(_e4))" ; chx:output "(None, True, True, ('ValueError', 'sleep length must be non-negative'), ('TypeError', ''str' object cannot be interpreted as an integer or float'))" .
chx:X_SleepFunction rd:hasIOExample chx:IO_SleepFunction .
chx:X_SleepAndSignals a owl:NamedIndividual, chx:SleepAndSignals ; rdfs:label "signal.setitimer(signal.ITIMER_REAL, 0.05)"@en ; skos:definition "Since Python 3.5 a signal handler that returns does not cut time.sleep short, because the call is retried for the time that remains, while a handler that raises an exception ends the sleep at once; KeyboardInterrupt, which Ctrl-C raises, derives from BaseException and not from Exception."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SleepAndSignals a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time, signal\nhits=[]\ndef on_alarm(s, f):\n    hits.append('handler ran')\nsignal.signal(signal.SIGALRM, on_alarm)\nsignal.setitimer(signal.ITIMER_REAL, 0.05)\nt=time.monotonic(); time.sleep(0.3); e=time.monotonic()-t\ndef h(s,f): raise RuntimeError('from handler')\nsignal.signal(signal.SIGALRM, h); signal.setitimer(signal.ITIMER_REAL, 0.05)\nt2=time.monotonic()\ntry: time.sleep(5)\nexcept RuntimeError as ex: r=str(ex)\n(hits, e>=0.3, r, time.monotonic()-t2<1, issubclass(KeyboardInterrupt, Exception), issubclass(KeyboardInterrupt, BaseException))"@en ; chx:input "import time, signal\nhits=[]\ndef on_alarm(s, f):\n    hits.append('handler ran')\nsignal.signal(signal.SIGALRM, on_alarm)\nsignal.setitimer(signal.ITIMER_REAL, 0.05)\nt=time.monotonic(); time.sleep(0.3); e=time.monotonic()-t\ndef h(s,f): raise RuntimeError('from handler')\nsignal.signal(signal.SIGALRM, h); signal.setitimer(signal.ITIMER_REAL, 0.05)\nt2=time.monotonic()\ntry: time.sleep(5)\nexcept RuntimeError as ex: r=str(ex)\n(hits, e>=0.3, r, time.monotonic()-t2<1, issubclass(KeyboardInterrupt, Exception), issubclass(KeyboardInterrupt, BaseException))" ; chx:output "(['handler ran'], True, 'from handler', True, False, True)" .
chx:X_SleepAndSignals rd:hasIOExample chx:IO_SleepAndSignals .
chx:X_PollingLoops a owl:NamedIndividual, chx:PollingLoops ; rdfs:label "while datetime.datetime.now() < halloween_2039:"@en ; skos:definition "A loop that sleeps one second between clock checks wakes about once a second and uses almost no processor time (under 0.05 s of CPU in 1.2 s), while the same loop without the sleep keeps a processor busy (over 0.1 s of CPU in 0.3 s)."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PollingLoops a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time\nfrom datetime import datetime as DT, timedelta as TD\nend=DT.now()+TD(seconds=1.2); c0=time.process_time(); t0=time.monotonic()\nwhile DT.now()<end: time.sleep(1)\nslept=time.process_time()-c0; w=time.monotonic()-t0\nc0=time.process_time(); end=DT.now()+TD(seconds=0.3)\nwhile DT.now()<end: pass\nbusy=time.process_time()-c0\n(round(w)>=1, slept<0.05, busy>0.1)"@en ; chx:input "import time\nfrom datetime import datetime as DT, timedelta as TD\nend=DT.now()+TD(seconds=1.2); c0=time.process_time(); t0=time.monotonic()\nwhile DT.now()<end: time.sleep(1)\nslept=time.process_time()-c0; w=time.monotonic()-t0\nc0=time.process_time(); end=DT.now()+TD(seconds=0.3)\nwhile DT.now()<end: pass\nbusy=time.process_time()-c0\n(round(w)>=1, slept<0.05, busy>0.1)" ; chx:output "(True, True, True)" .
chx:X_PollingLoops rd:hasIOExample chx:IO_PollingLoops .
chx:X_SleepDrift a owl:NamedIndividual, chx:SleepDrift ; rdfs:label "time.sleep(1) in a loop"@en ; skos:definition "A loop that sleeps a fixed second after work that takes 0.02 s starts its 3600th round 3670.98 s after the first, 71.98 s late, while a loop that sleeps until the next tick of the clock starts it at 3599.0 s, exactly on schedule."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SleepDrift a owl:NamedIndividual, rd:IOExample ; rdfs:label "class C:\n    def __init__(s): s.t=0.0\n    def now(s): return s.t\n    def sleep(s,d): s.t+=d\ndef drifting(c, n, work):\n    starts=[]\n    for _ in range(n): starts.append(c.now()); c.sleep(work); c.sleep(1.0)\n    return starts[-1]\ndef anchored(c, n, work):\n    t0=c.now(); starts=[]\n    for i in range(n): starts.append(c.now()); c.sleep(work); c.sleep(max(0.0, t0+(i+1)*1.0-c.now()))\n    return starts[-1]\n(round(drifting(C(),3600,0.02),2), round(anchored(C(),3600,0.02),2))"@en ; chx:input "class C:\n    def __init__(s): s.t=0.0\n    def now(s): return s.t\n    def sleep(s,d): s.t+=d\ndef drifting(c, n, work):\n    starts=[]\n    for _ in range(n): starts.append(c.now()); c.sleep(work); c.sleep(1.0)\n    return starts[-1]\ndef anchored(c, n, work):\n    t0=c.now(); starts=[]\n    for i in range(n): starts.append(c.now()); c.sleep(work); c.sleep(max(0.0, t0+(i+1)*1.0-c.now()))\n    return starts[-1]\n(round(drifting(C(),3600,0.02),2), round(anchored(C(),3600,0.02),2))" ; chx:output "(3670.98, 3599.0)" .
chx:X_SleepDrift rd:hasIOExample chx:IO_SleepDrift .
chx:X_DatetimeObject a owl:NamedIndividual, chx:DatetimeObject ; rdfs:label "datetime.datetime(2026, 10, 21, 16, 29, 0)"@en ; skos:definition "A datetime object holds a moment as year, month, day, hour, minute, second and microsecond; month, day and the fields are checked when it is made, so datetime(2026, 2, 30) raises ValueError and a call without the day raises TypeError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DatetimeObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndt=DT(2026,10,21,16,29,0)\ndef _e7():\n    return DT(2026,2,30)\ndef _e6():\n    return DT(2026,13,1)\ndef _e5():\n    return DT(2026,10)\n(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second, dt.microsecond, dt, DT(2026,10,21), err(_e5), err(_e6), err(_e7), dt.weekday(), dt.isoweekday())"@en ; chx:input "from datetime import datetime as DT\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndt=DT(2026,10,21,16,29,0)\ndef _e7():\n    return DT(2026,2,30)\ndef _e6():\n    return DT(2026,13,1)\ndef _e5():\n    return DT(2026,10)\n(dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second, dt.microsecond, dt, DT(2026,10,21), err(_e5), err(_e6), err(_e7), dt.weekday(), dt.isoweekday())" ; chx:output "(2026, 10, 21, 16, 29, 0, 0, datetime.datetime(2026, 10, 21, 16, 29), datetime.datetime(2026, 10, 21, 0, 0), ('TypeError', 'function missing required argument 'day' (pos 3)'), ('ValueError', 'month must be in 1..12, not 13'), ('ValueError', 'day 30 must be in range 1..28 for month 2 in year 2026'), 2, 3)" .
chx:X_DatetimeObject rd:hasIOExample chx:IO_DatetimeObject .
chx:X_CurrentMoment a owl:NamedIndividual, chx:CurrentMoment ; rdfs:label "datetime.datetime.now()"@en ; skos:definition "datetime.now() returns the current moment as a naive datetime in the local zone, within a second of datetime.fromtimestamp(time.time()) and of datetime.today(), and datetime.now(datetime.UTC) returns the same instant as an aware value with the offset 0."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CurrentMoment a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time\nfrom datetime import datetime as DT, UTC\na=DT.now(); b=DT.fromtimestamp(time.time()); c=DT.now(UTC)\n(abs((a-b).total_seconds())<1, a.tzinfo, c.tzinfo, c.utcoffset(), type(a).__name__, DT.today().tzinfo, abs((DT.now()-DT.today()).total_seconds())<1)"@en ; chx:input "import time\nfrom datetime import datetime as DT, UTC\na=DT.now(); b=DT.fromtimestamp(time.time()); c=DT.now(UTC)\n(abs((a-b).total_seconds())<1, a.tzinfo, c.tzinfo, c.utcoffset(), type(a).__name__, DT.today().tzinfo, abs((DT.now()-DT.today()).total_seconds())<1)" ; chx:output "(True, None, datetime.timezone.utc, datetime.timedelta(0), 'datetime', None, True)" .
chx:X_CurrentMoment rd:hasIOExample chx:IO_CurrentMoment .
chx:X_DatetimeComparison a owl:NamedIndividual, chx:DatetimeComparison ; rdfs:label "new_years_2027 > halloween_2026"@en ; skos:definition "Datetime values are compared with ==, <, > and sorted, the later moment is the greater, two separately made values of one moment are equal but not the same object, and subtracting gives a timedelta of 62 days between 31 October 2026 and 1 January 2027."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DatetimeComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT\nh=DT(2026,10,31,0,0,0); n=DT(2027,1,1,0,0,0); o=DT(2026,10,31,0,0,0)\n(h==o, h>n, n>h, n!=o, h is o, sorted([n,h]) == [h,n], max(n,h)==n, n-h)"@en ; chx:input "from datetime import datetime as DT\nh=DT(2026,10,31,0,0,0); n=DT(2027,1,1,0,0,0); o=DT(2026,10,31,0,0,0)\n(h==o, h>n, n>h, n!=o, h is o, sorted([n,h]) == [h,n], max(n,h)==n, n-h)" ; chx:output "(True, False, True, True, False, True, True, datetime.timedelta(days=62))" .
chx:X_DatetimeComparison rd:hasIOExample chx:IO_DatetimeComparison .
chx:X_WeekdayOfDate a owl:NamedIndividual, chx:WeekdayOfDate ; rdfs:label "datetime.date(2019, 1, 7).strftime('%A')"@en ; skos:definition "The weekday of a date comes from strftime('%A') as a name, from weekday() as a number in which Monday is 0, from isoweekday() in which Monday is 1, and from calendar.day_name; 7 January 2019 is a Monday, in ISO week 2."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_WeekdayOfDate a owl:NamedIndividual, rd:IOExample ; rdfs:label "import calendar\nfrom datetime import datetime as DT, date as D\nd=DT(2019,1,7)\n(d.weekday(), d.strftime('%A'), d.isoweekday(), calendar.day_name[d.weekday()], d.date().isocalendar(), D(2019,1,7).strftime('%w'))"@en ; chx:input "import calendar\nfrom datetime import datetime as DT, date as D\nd=DT(2019,1,7)\n(d.weekday(), d.strftime('%A'), d.isoweekday(), calendar.day_name[d.weekday()], d.date().isocalendar(), D(2019,1,7).strftime('%w'))" ; chx:output "(0, 'Monday', 1, 'Monday', datetime.IsoCalendarDate(year=2019, week=2, weekday=1), '1')" .
chx:X_WeekdayOfDate rd:hasIOExample chx:IO_WeekdayOfDate .
chx:X_TimedeltaObject a owl:NamedIndividual, chx:TimedeltaObject ; rdfs:label "datetime.timedelta(days=11, hours=10, minutes=9, seconds=8)"@en ; skos:definition "A timedelta holds a duration and keeps only days, seconds and microseconds: 11 days, 10 hours, 9 minutes and 8 seconds is days 11, seconds 36548, microseconds 0, 986948.0 seconds in all, and a negative duration is normalised so that timedelta(seconds=-1) has days -1 and seconds 86399."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TimedeltaObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import timedelta as TD\nd=TD(days=11, hours=10, minutes=9, seconds=8)\n(d.days, d.seconds, d.microseconds, d.total_seconds(), str(d), repr(d), TD(weeks=1,hours=24).days, TD(milliseconds=1500), TD(seconds=-1), (TD(seconds=-1).days, TD(seconds=-1).seconds), str(TD(seconds=-1)), abs(TD(days=-2)), TD.resolution)"@en ; chx:input "from datetime import timedelta as TD\nd=TD(days=11, hours=10, minutes=9, seconds=8)\n(d.days, d.seconds, d.microseconds, d.total_seconds(), str(d), repr(d), TD(weeks=1,hours=24).days, TD(milliseconds=1500), TD(seconds=-1), (TD(seconds=-1).days, TD(seconds=-1).seconds), str(TD(seconds=-1)), abs(TD(days=-2)), TD.resolution)" ; chx:output "(11, 36548, 0, 986948.0, '11 days, 10:09:08', 'datetime.timedelta(days=11, seconds=36548)', 8, datetime.timedelta(seconds=1, microseconds=500000), datetime.timedelta(days=-1, seconds=86399), (-1, 86399), '-1 day, 23:59:59', datetime.timedelta(days=2), datetime.timedelta(microseconds=1))" .
chx:X_TimedeltaObject rd:hasIOExample chx:IO_TimedeltaObject .
chx:X_NoMonthsOrYears a owl:NamedIndividual, chx:NoMonthsOrYears ; rdfs:label "datetime.timedelta(months=1)"@en ; skos:definition "timedelta takes weeks, days, hours, minutes, seconds, milliseconds and microseconds but no months or years, because a month has 28 to 31 days, so timedelta(months=1) raises TypeError and 31 January plus 30 days is 2 March 2026."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_NoMonthsOrYears a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, timedelta as TD\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef _e9():\n    return TD(years=1)\ndef _e8():\n    return TD(months=1)\n(err(_e8), err(_e9), DT(2026,1,31)+TD(days=30), DT(2026,1,31)+TD(days=31), (DT(2026,3,1)-DT(2026,2,1)).days, (DT(2027,3,1)-DT(2027,2,1)).days, (DT(2024,3,1)-DT(2024,2,1)).days)"@en ; chx:input "from datetime import datetime as DT, timedelta as TD\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef _e9():\n    return TD(years=1)\ndef _e8():\n    return TD(months=1)\n(err(_e8), err(_e9), DT(2026,1,31)+TD(days=30), DT(2026,1,31)+TD(days=31), (DT(2026,3,1)-DT(2026,2,1)).days, (DT(2027,3,1)-DT(2027,2,1)).days, (DT(2024,3,1)-DT(2024,2,1)).days)" ; chx:output "(('TypeError', '__new__() got an unexpected keyword argument 'months''), ('TypeError', '__new__() got an unexpected keyword argument 'years''), datetime.datetime(2026, 3, 2, 0, 0), datetime.datetime(2026, 3, 3, 0, 0), 28, 28, 29)" .
chx:X_NoMonthsOrYears rd:hasIOExample chx:IO_NoMonthsOrYears .
chx:X_DurationArithmetic a owl:NamedIndividual, chx:DurationArithmetic ; rdfs:label "now + thousand_days"@en ; skos:definition "A timedelta is added to or subtracted from a datetime, multiplied or divided by a number, divided by another timedelta to give a number, and added to another timedelta, but two durations cannot be multiplied and a timedelta plus an int raises TypeError; 1000 days after 2 December 2026 is 28 August 2029, a Tuesday."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DurationArithmetic a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, timedelta as TD\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nd=TD(days=1, hours=12); now=DT(2026,12,2,18,38,50,636181); t=TD(days=1000)\ndef _e11():\n    return d+1\ndef _e10():\n    return d*d\n(d*2, d/2, d*1.5, d//TD(hours=1), d/TD(hours=1), d%TD(hours=5), divmod(d, TD(hours=5)), err(_e10), err(_e11), now+t, (now+t).strftime('%B %d, %Y'), (now+t).weekday())"@en ; chx:input "from datetime import datetime as DT, timedelta as TD\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nd=TD(days=1, hours=12); now=DT(2026,12,2,18,38,50,636181); t=TD(days=1000)\ndef _e11():\n    return d+1\ndef _e10():\n    return d*d\n(d*2, d/2, d*1.5, d//TD(hours=1), d/TD(hours=1), d%TD(hours=5), divmod(d, TD(hours=5)), err(_e10), err(_e11), now+t, (now+t).strftime('%B %d, %Y'), (now+t).weekday())" ; chx:output "(datetime.timedelta(days=3), datetime.timedelta(seconds=64800), datetime.timedelta(days=2, seconds=21600), 36, 36.0, datetime.timedelta(seconds=3600), (7, datetime.timedelta(seconds=3600)), ('TypeError', 'unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.timedelta''), ('TypeError', 'unsupported operand type(s) for +: 'datetime.timedelta' and 'int''), datetime.datetime(2029, 8, 28, 18, 38, 50, 636181), 'August 28, 2029', 1)" .
chx:X_DurationArithmetic rd:hasIOExample chx:IO_DurationArithmetic .
chx:X_ThirtyYearsError a owl:NamedIndividual, chx:ThirtyYearsError ; rdfs:label "oct_21st - about_thirty_years"@en ; skos:definition "The chapter's about_thirty_years is 365 * 30 days, but the 30 years from 21 October 1996 to 21 October 2026 hold 7 leap days (29 February of 2000, 2004, 2008, 2012, 2016, 2020 and 2024), so subtracting 10,950 days from 21 October 2026 gives 28 October 1996, 7 days off, and twice that gives 5 November 1966, 15 days off; datetime.delta() raises AttributeError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ThirtyYearsError a owl:NamedIndividual, rd:IOExample ; rdfs:label "import datetime\nfrom datetime import datetime as DT, timedelta as TD\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nimport datetime\no=DT(2026,10,21,16,29,0); t=TD(days=365*30)\ndef _e12():\n    return datetime.delta(days=1)\n(o-t, o-2*t, (o-DT(1996,10,21,16,29)).days - 365*30, o.replace(year=1996), (o-2*t).strftime('%B %d, %Y'), (o.replace(year=1966)-(o-2*t)).days, err(_e12), hasattr(datetime,'timedelta'))"@en ; chx:input "import datetime\nfrom datetime import datetime as DT, timedelta as TD\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nimport datetime\no=DT(2026,10,21,16,29,0); t=TD(days=365*30)\ndef _e12():\n    return datetime.delta(days=1)\n(o-t, o-2*t, (o-DT(1996,10,21,16,29)).days - 365*30, o.replace(year=1996), (o-2*t).strftime('%B %d, %Y'), (o.replace(year=1966)-(o-2*t)).days, err(_e12), hasattr(datetime,'timedelta'))" ; chx:output "(datetime.datetime(1996, 10, 28, 16, 29), datetime.datetime(1966, 11, 5, 16, 29), 7, datetime.datetime(1996, 10, 21, 16, 29), 'November 05, 1966', -15, ('AttributeError', 'module 'datetime' has no attribute 'delta''), True)" .
chx:X_ThirtyYearsError rd:hasIOExample chx:IO_ThirtyYearsError .
chx:X_DirectiveTable a owl:NamedIndividual, chx:DirectiveTable ; rdfs:label "Table 19-1"@en ; skos:definition "Table 19-1 lists the strftime directives, and on 3 November 2026 at 16:29:07 they give %Y 2026, %y 26, %m 11, %B November, %b Nov, %d 03, %j 307, %w 2, %A Tuesday, %a Tue, %H 16, %I 04, %M 29, %S 07, %p PM and %% as one percent sign; %w counts Sunday as 0."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DirectiveTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, timedelta as TD\ndt=DT(2026,11,3,16,29,7)\ndirs='%Y %y %m %B %b %d %j %w %A %a %H %I %M %S %p %%'.split()\n({d: dt.strftime(d) for d in dirs}, {d.strftime('%a'): d.strftime('%w') for d in (DT(2026,11,1)+TD(days=i) for i in range(7))})"@en ; chx:input "from datetime import datetime as DT, timedelta as TD\ndt=DT(2026,11,3,16,29,7)\ndirs='%Y %y %m %B %b %d %j %w %A %a %H %I %M %S %p %%'.split()\n({d: dt.strftime(d) for d in dirs}, {d.strftime('%a'): d.strftime('%w') for d in (DT(2026,11,1)+TD(days=i) for i in range(7))})" ; chx:output "({'%Y': '2026', '%y': '26', '%m': '11', '%B': 'November', '%b': 'Nov', '%d': '03', '%j': '307', '%w': '2', '%A': 'Tuesday', '%a': 'Tue', '%H': '16', '%I': '04', '%M': '29', '%S': '07', '%p': 'PM', '%%': '%'}, {'Sun': '0', 'Mon': '1', 'Tue': '2', 'Wed': '3', 'Thu': '4', 'Fri': '5', 'Sat': '6'})" .
chx:X_DirectiveTable rd:hasIOExample chx:IO_DirectiveTable .
chx:X_StrftimeFormat a owl:NamedIndividual, chx:StrftimeFormat ; rdfs:label "oct_21st.strftime('%Y/%m/%d %H:%M:%S')"@en ; skos:definition "strftime returns text from a format of directives and other characters: '%Y/%m/%d %H:%M:%S' gives '2026/10/21 16:29:00', '%I:%M %p' gives '04:29 PM', the directives %e, %k and %-d are platform extensions, and %z and %Z are empty for a naive value."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_StrftimeFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, UTC\no=DT(2026,10,21,16,29,0)\n(o.strftime('%Y/%m/%d %H:%M:%S'), o.strftime('%I:%M %p'), o.strftime(\"%B of '%y\"), o.strftime('%-d %-m'), o.strftime('%e|%k|%l'), o.strftime('%f'), DT(2026,10,21,16,29,0,123).strftime('%f'), o.strftime('%z|%Z|'), o.replace(tzinfo=UTC).strftime('%z|%Z|%:z'))"@en ; chx:input "from datetime import datetime as DT, UTC\no=DT(2026,10,21,16,29,0)\n(o.strftime('%Y/%m/%d %H:%M:%S'), o.strftime('%I:%M %p'), o.strftime(\"%B of '%y\"), o.strftime('%-d %-m'), o.strftime('%e|%k|%l'), o.strftime('%f'), DT(2026,10,21,16,29,0,123).strftime('%f'), o.strftime('%z|%Z|'), o.replace(tzinfo=UTC).strftime('%z|%Z|%:z'))" ; chx:output "('2026/10/21 16:29:00', '04:29 PM', 'October of '26', '21 10', '21|16| 4', '000000', '000123', '||', '+0000|UTC|+00:00')" .
chx:X_StrftimeFormat rd:hasIOExample chx:IO_StrftimeFormat .
chx:X_StrptimeParse a owl:NamedIndividual, chx:StrptimeParse ; rdfs:label "datetime.datetime.strptime('October 21, 2026', '%B %d, %Y')"@en ; skos:definition "strptime reads a datetime from text by a format and raises ValueError when the text does not match, as '2026-10-21' does for '%Y/%m/%d'; it accepts '2026-1-5' for '%Y-%m-%d', refuses leading and trailing spaces, and since Python 3.14 date.strptime and time.strptime exist beside datetime.strptime."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_StrptimeParse a owl:NamedIndividual, rd:IOExample ; rdfs:label "import datetime\nfrom datetime import datetime as DT, date as D\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nimport datetime\np=DT.strptime\ndef _e16():\n    return p('2026-10-21T16:29:00Z','%Y-%m-%dT%H:%M:%S')\ndef _e15():\n    return p('2026 ','%Y')\ndef _e14():\n    return p('  2026','%Y')\ndef _e13():\n    return p('2026-10-21','%Y/%m/%d')\n(p('October 21, 2026','%B %d, %Y'), p('2026/10/21 16:29:00','%Y/%m/%d %H:%M:%S'), p(\"November of '63\",\"%B of '%y\"), err(_e13), p('2026-1-5','%Y-%m-%d'), err(_e14), err(_e15), err(_e16), p('2026-10-21T16:29:00Z','%Y-%m-%dT%H:%M:%S%z'), p('2026-10-21','%Y-%m-%d').date(), p('16:29','%H:%M').time())"@en ; chx:input "import datetime\nfrom datetime import datetime as DT, date as D\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nimport datetime\np=DT.strptime\ndef _e16():\n    return p('2026-10-21T16:29:00Z','%Y-%m-%dT%H:%M:%S')\ndef _e15():\n    return p('2026 ','%Y')\ndef _e14():\n    return p('  2026','%Y')\ndef _e13():\n    return p('2026-10-21','%Y/%m/%d')\n(p('October 21, 2026','%B %d, %Y'), p('2026/10/21 16:29:00','%Y/%m/%d %H:%M:%S'), p(\"November of '63\",\"%B of '%y\"), err(_e13), p('2026-1-5','%Y-%m-%d'), err(_e14), err(_e15), err(_e16), p('2026-10-21T16:29:00Z','%Y-%m-%dT%H:%M:%S%z'), p('2026-10-21','%Y-%m-%d').date(), p('16:29','%H:%M').time())" ; chx:output "(datetime.datetime(2026, 10, 21, 0, 0), datetime.datetime(2026, 10, 21, 16, 29), datetime.datetime(2063, 11, 1, 0, 0), ('ValueError', 'time data '2026-10-21' does not match format '%Y/%m/%d''), datetime.datetime(2026, 1, 5, 0, 0), ('ValueError', 'time data '  2026' does not match format '%Y''), ('ValueError', 'unconverted data remains:  '), ('ValueError', 'unconverted data remains: Z'), datetime.datetime(2026, 10, 21, 16, 29, tzinfo=datetime.timezone.utc), datetime.date(2026, 10, 21), datetime.time(16, 29))" .
chx:X_StrptimeParse rd:hasIOExample chx:IO_StrptimeParse .
chx:X_TwoDigitYear a owl:NamedIndividual, chx:TwoDigitYear ; rdfs:label "%y"@en ; skos:definition "The %y directive follows POSIX: 69 to 99 mean 1969 to 1999 and 00 to 68 mean 2000 to 2068, so '68' is 2068 and '69' is 1969, which is not the 1970 to 2069 that Table 19-1 prints; the book's two examples, 63 as 2063 and 73 as 1973, are right either way."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TwoDigitYear a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time\nfrom datetime import datetime as DT\n([(s, DT.strptime(s,'%y').year) for s in ('00','26','63','68','69','70','73','99')], [(s, time.strptime(s,'%y').tm_year) for s in ('68','69')], DT(2026,1,1).strftime('%y'), DT(1969,1,1).strftime('%y'), DT(2069,1,1).strftime('%y'))"@en ; chx:input "import time\nfrom datetime import datetime as DT\n([(s, DT.strptime(s,'%y').year) for s in ('00','26','63','68','69','70','73','99')], [(s, time.strptime(s,'%y').tm_year) for s in ('68','69')], DT(2026,1,1).strftime('%y'), DT(1969,1,1).strftime('%y'), DT(2069,1,1).strftime('%y'))" ; chx:output "([('00', 2000), ('26', 2026), ('63', 2063), ('68', 2068), ('69', 1969), ('70', 1970), ('73', 1973), ('99', 1999)], [('68', 2068), ('69', 1969)], '26', '69', '69')" .
chx:X_TwoDigitYear rd:hasIOExample chx:IO_TwoDigitYear .
chx:X_YearlessParsing a owl:NamedIndividual, chx:YearlessParsing ; rdfs:label "strptime('02/29', '%m/%d')"@en ; skos:definition "A format with a month and a day but no year uses the year 1900, which is not a leap year, so '02/29' raises ValueError and draws a DeprecationWarning from Python 3.13 on, '02/29;1984' with a year parses, and 21 October without a year silently becomes 1900-10-21."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_YearlessParsing a owl:NamedIndividual, rd:IOExample ; rdfs:label "import warnings\nfrom datetime import datetime as DT\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef warned(src):\n    with warnings.catch_warnings(record=True) as w:\n        warnings.simplefilter('always')\n        v = src()\n    return v, [(x.category.__name__, str(x.message)) for x in w]\ndef _e19():\n    return DT.strptime('10/21','%m/%d')\ndef _e18():\n    return DT.strptime('02/29;1984','%m/%d;%Y')\ndef _e17():\n    def _e20():\n        return DT.strptime('02/29','%m/%d')\n    return err(_e20)\n(warned(_e17), warned(_e18), warned(_e19))"@en ; chx:input "import warnings\nfrom datetime import datetime as DT\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef warned(src):\n    with warnings.catch_warnings(record=True) as w:\n        warnings.simplefilter('always')\n        v = src()\n    return v, [(x.category.__name__, str(x.message)) for x in w]\ndef _e19():\n    return DT.strptime('10/21','%m/%d')\ndef _e18():\n    return DT.strptime('02/29;1984','%m/%d;%Y')\ndef _e17():\n    def _e20():\n        return DT.strptime('02/29','%m/%d')\n    return err(_e20)\n(warned(_e17), warned(_e18), warned(_e19))" ; chx:output "((('ValueError', 'day 29 must be in range 1..28 for month 2 in year 1900'), [('DeprecationWarning', 'Parsing dates involving a day of month without a year specified is ambiguous\\nand fails to parse leap day. The default behavior will change in Python 3.15\\nto either always raise an exception or to use a different default year (TBD).\\nTo avoid trouble, add a specific year to the input & format.\\nSee https://github.com/python/cpython/issues/70647.')]), (datetime.datetime(1984, 2, 29, 0, 0), []), (datetime.datetime(1900, 10, 21, 0, 0), []))" .
chx:X_YearlessParsing rd:hasIOExample chx:IO_YearlessParsing .
chx:X_IsoFormats a owl:NamedIndividual, chx:IsoFormats ; rdfs:label "datetime.isoformat()"@en ; skos:definition "ISO 8601 and RFC 3339 write 2026-10-21T16:29:07+00:00 and with Z for zero offset; isoformat writes it and fromisoformat reads it, accepting Z since Python 3.11, the basic form 20261021T162907+0300 and the week date 2026-W43-3, and raising ValueError for 21/10/2026."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_IsoFormats a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, date as D, UTC\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndt=DT(2026,10,21,16,29,7,123456,tzinfo=UTC)\ndef _e21():\n    return DT.fromisoformat('21/10/2026')\n(dt.isoformat(), dt.isoformat(timespec='seconds'), DT.fromisoformat('2026-10-21T16:29:07Z'), DT.fromisoformat('20261021T162907+0300'), DT.fromisoformat('2026-10-21 16:29'), D.fromisoformat('2026-W43-3'), err(_e21), DT(2026,10,21,16,29).isoformat(), str(DT(2026,10,21,16,29)), DT(2026,10,21,16,29,7,tzinfo=UTC).isoformat().replace('+00:00','Z'))"@en ; chx:input "from datetime import datetime as DT, date as D, UTC\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndt=DT(2026,10,21,16,29,7,123456,tzinfo=UTC)\ndef _e21():\n    return DT.fromisoformat('21/10/2026')\n(dt.isoformat(), dt.isoformat(timespec='seconds'), DT.fromisoformat('2026-10-21T16:29:07Z'), DT.fromisoformat('20261021T162907+0300'), DT.fromisoformat('2026-10-21 16:29'), D.fromisoformat('2026-W43-3'), err(_e21), DT(2026,10,21,16,29).isoformat(), str(DT(2026,10,21,16,29)), DT(2026,10,21,16,29,7,tzinfo=UTC).isoformat().replace('+00:00','Z'))" ; chx:output "('2026-10-21T16:29:07.123456+00:00', '2026-10-21T16:29:07+00:00', datetime.datetime(2026, 10, 21, 16, 29, 7, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 10, 21, 16, 29, 7, tzinfo=datetime.timezone(datetime.timedelta(seconds=10800))), datetime.datetime(2026, 10, 21, 16, 29), datetime.date(2026, 10, 21), ('ValueError', 'Invalid isoformat string: '21/10/2026''), '2026-10-21T16:29:00', '2026-10-21 16:29:00', '2026-10-21T16:29:07Z')" .
chx:X_IsoFormats rd:hasIOExample chx:IO_IsoFormats .
chx:X_NaiveVersusAware a owl:NamedIndividual, chx:NaiveVersusAware ; rdfs:label "datetime.now(datetime.UTC)"@en ; skos:definition "A datetime without a tzinfo is naive and one with a tzinfo is aware; a naive and an aware value are never equal, comparing them or subtracting one from the other raises TypeError, 16:29 UTC equals 19:29 in Istanbul because they are one instant, and replace(tzinfo=UTC) labels a naive value without moving it."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_NaiveVersusAware a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, UTC\nfrom zoneinfo import ZoneInfo\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nn=DT(2026,10,21,16,29); a=DT(2026,10,21,16,29,tzinfo=UTC); a2=DT(2026,10,21,19,29,tzinfo=ZoneInfo('Europe/Istanbul'))\ndef _e23():\n    return n-a\ndef _e22():\n    return n<a\n(n==a, err(_e22), err(_e23), a==a2, a2.utcoffset(), n.replace(tzinfo=UTC)==a, n.tzinfo, a.tzinfo)"@en ; chx:input "from datetime import datetime as DT, UTC\nfrom zoneinfo import ZoneInfo\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nn=DT(2026,10,21,16,29); a=DT(2026,10,21,16,29,tzinfo=UTC); a2=DT(2026,10,21,19,29,tzinfo=ZoneInfo('Europe/Istanbul'))\ndef _e23():\n    return n-a\ndef _e22():\n    return n<a\n(n==a, err(_e22), err(_e23), a==a2, a2.utcoffset(), n.replace(tzinfo=UTC)==a, n.tzinfo, a.tzinfo)" ; chx:output "(False, ('TypeError', 'can't compare offset-naive and offset-aware datetimes'), ('TypeError', 'can't subtract offset-naive and offset-aware datetimes'), True, datetime.timedelta(seconds=10800), True, None, datetime.timezone.utc)" .
chx:X_NaiveVersusAware rd:hasIOExample chx:IO_NaiveVersusAware .
chx:X_UtcnowDeprecated a owl:NamedIndividual, chx:UtcnowDeprecated ; rdfs:label "datetime.utcnow()"@en ; skos:definition "datetime.utcnow() and utcfromtimestamp() return naive values and have drawn a DeprecationWarning since Python 3.12; because the result is naive, treating it as local time shifts it by the offset of the zone, here -3.0 hours in Istanbul, and datetime.now(datetime.UTC) is the aware replacement."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_UtcnowDeprecated a owl:NamedIndividual, rd:IOExample ; rdfs:label "import os, sys, subprocess, warnings\nfrom datetime import datetime as DT, timezone, UTC\ndef warned(src):\n    with warnings.catch_warnings(record=True) as w:\n        warnings.simplefilter('always')\n        v = src()\n    return v, [(x.category.__name__, str(x.message)) for x in w]\ndef child(code, **env):\n    e = dict(os.environ)\n    e.update(env)\n    r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, env=e)\n    if r.returncode == 0:\n        return r.stdout.strip()\n    return r.stderr.strip().splitlines()[-1]\ndef _e24():\n    return (DT.utcnow().tzinfo, DT.utcfromtimestamp(0))\nv=warned(_e24)\nb=child(\"import datetime,warnings; warnings.simplefilter('ignore'); u=datetime.datetime.utcnow(); print(u.timestamp()-datetime.datetime.now(datetime.UTC).timestamp())\", TZ='Europe/Istanbul')\ndef _e25():\n    return DT.now(UTC).tzinfo\n(v[0], v[1], warned(_e25)[1], DT.fromtimestamp(0, UTC), UTC is timezone.utc, round(float(b)/3600,2))"@en ; chx:input "import os, sys, subprocess, warnings\nfrom datetime import datetime as DT, timezone, UTC\ndef warned(src):\n    with warnings.catch_warnings(record=True) as w:\n        warnings.simplefilter('always')\n        v = src()\n    return v, [(x.category.__name__, str(x.message)) for x in w]\ndef child(code, **env):\n    e = dict(os.environ)\n    e.update(env)\n    r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, env=e)\n    if r.returncode == 0:\n        return r.stdout.strip()\n    return r.stderr.strip().splitlines()[-1]\ndef _e24():\n    return (DT.utcnow().tzinfo, DT.utcfromtimestamp(0))\nv=warned(_e24)\nb=child(\"import datetime,warnings; warnings.simplefilter('ignore'); u=datetime.datetime.utcnow(); print(u.timestamp()-datetime.datetime.now(datetime.UTC).timestamp())\", TZ='Europe/Istanbul')\ndef _e25():\n    return DT.now(UTC).tzinfo\n(v[0], v[1], warned(_e25)[1], DT.fromtimestamp(0, UTC), UTC is timezone.utc, round(float(b)/3600,2))" ; chx:output "((None, datetime.datetime(1970, 1, 1, 0, 0)), [('DeprecationWarning', 'datetime.datetime.utcnow() is deprecated and scheduled for removal in a future version. Use timezone-aware objects to represent datetimes in UTC: datetime.datetime.now(datetime.UTC).'), ('DeprecationWarning', 'datetime.datetime.utcfromtimestamp() is deprecated and scheduled for removal in a future version. Use timezone-aware objects to represent datetimes in UTC: datetime.datetime.fromtimestamp(timestamp, datetime.UTC).')], [], datetime.datetime(1970, 1, 1, 0, 0, tzinfo=datetime.timezone.utc), True, -3.0)" .
chx:X_UtcnowDeprecated rd:hasIOExample chx:IO_UtcnowDeprecated .
chx:X_ZoneInfoZones a owl:NamedIndividual, chx:ZoneInfoZones ; rdfs:label "ZoneInfo('America/Los_Angeles')"@en ; skos:definition "The zoneinfo module attaches an IANA zone with its daylight saving rules to a datetime: Los Angeles is -07:00 PDT on 1 July 2026 and -08:00 PST on 1 January, Istanbul is +03:00 all year since 2016, and the data come from the system's zoneinfo directory or from the tzdata package, so without both ZoneInfo raises ZoneInfoNotFoundError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ZoneInfoZones a owl:NamedIndividual, rd:IOExample ; rdfs:label "import os, sys, subprocess, zoneinfo\nfrom datetime import datetime as DT\nfrom zoneinfo import ZoneInfo\nimport importlib.metadata as md\nla=ZoneInfo('America/Los_Angeles'); ist=ZoneInfo('Europe/Istanbul')\nd=DT(2026,7,1,12,tzinfo=la)\nr=subprocess.run([sys.executable,'-S','-c',\"import zoneinfo; zoneinfo.ZoneInfo('Europe/Istanbul')\"],env=dict(os.environ,PYTHONTZPATH='/nonexistent'),capture_output=True,text=True)\n(d.utcoffset(), d.tzname(), DT(2026,1,1,12,tzinfo=la).utcoffset(), DT(2026,1,1,12,tzinfo=la).tzname(), ist.utcoffset(DT(2026,7,1)), ist.utcoffset(DT(2015,7,1)), ist.utcoffset(DT(2017,1,1)), la.key, md.version('tzdata'), zoneinfo.TZPATH[:2], len(zoneinfo.available_timezones())>400, r.stderr.strip().splitlines()[-1])"@en ; chx:input "import os, sys, subprocess, zoneinfo\nfrom datetime import datetime as DT\nfrom zoneinfo import ZoneInfo\nimport importlib.metadata as md\nla=ZoneInfo('America/Los_Angeles'); ist=ZoneInfo('Europe/Istanbul')\nd=DT(2026,7,1,12,tzinfo=la)\nr=subprocess.run([sys.executable,'-S','-c',\"import zoneinfo; zoneinfo.ZoneInfo('Europe/Istanbul')\"],env=dict(os.environ,PYTHONTZPATH='/nonexistent'),capture_output=True,text=True)\n(d.utcoffset(), d.tzname(), DT(2026,1,1,12,tzinfo=la).utcoffset(), DT(2026,1,1,12,tzinfo=la).tzname(), ist.utcoffset(DT(2026,7,1)), ist.utcoffset(DT(2015,7,1)), ist.utcoffset(DT(2017,1,1)), la.key, md.version('tzdata'), zoneinfo.TZPATH[:2], len(zoneinfo.available_timezones())>400, r.stderr.strip().splitlines()[-1])" ; chx:output "(datetime.timedelta(days=-1, seconds=61200), 'PDT', datetime.timedelta(days=-1, seconds=57600), 'PST', datetime.timedelta(seconds=10800), datetime.timedelta(seconds=10800), datetime.timedelta(seconds=10800), 'America/Los_Angeles', '2026.5', ('/usr/share/zoneinfo', '/usr/lib/zoneinfo'), True, 'zoneinfo._common.ZoneInfoNotFoundError: 'No time zone found with key Europe/Istanbul'')" .
chx:X_ZoneInfoZones rd:hasIOExample chx:IO_ZoneInfoZones .
chx:X_FromTimestampZones a owl:NamedIndividual, chx:FromTimestampZones ; rdfs:label "datetime.datetime.fromtimestamp(1000000)"@en ; skos:definition "fromtimestamp(1000000) with no zone uses the local zone of the process, so it prints 05:46:40 in Los Angeles, 13:46:40 in UTC and 15:46:40 in Istanbul, which was UTC+02:00 in 1970; the local zone is read from TZ or the system, and time.tzset() changes it while the program runs."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_FromTimestampZones a owl:NamedIndividual, rd:IOExample ; rdfs:label "import os, sys, time, subprocess\nfrom datetime import datetime as DT, UTC\nfrom zoneinfo import ZoneInfo\ndef child(code, **env):\n    e = dict(os.environ)\n    e.update(env)\n    r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, env=e)\n    if r.returncode == 0:\n        return r.stdout.strip()\n    return r.stderr.strip().splitlines()[-1]\nla=ZoneInfo('America/Los_Angeles'); ist=ZoneInfo('Europe/Istanbul')\nc=\"import time, datetime; print(time.strftime('%Z %z', time.localtime(1791841200)), datetime.datetime.fromtimestamp(1791841200).isoformat())\"\nos.environ['TZ']='Asia/Kolkata'; time.tzset(); t1=time.strftime('%H:%M %Z', time.localtime(1791841200)); os.environ['TZ']='UTC'; time.tzset(); t2=time.strftime('%H:%M %Z', time.localtime(1791841200))\n([DT.fromtimestamp(1000000, z).isoformat() for z in (UTC, la, ist)], [child(\"import datetime; print(repr(datetime.datetime.fromtimestamp(1000000)))\", TZ=z) for z in ('America/Los_Angeles','UTC','Europe/Istanbul')], [child(c, TZ=z) for z in ('UTC','Europe/Istanbul','America/Los_Angeles','Asia/Kolkata')], t1, t2)"@en ; chx:input "import os, sys, time, subprocess\nfrom datetime import datetime as DT, UTC\nfrom zoneinfo import ZoneInfo\ndef child(code, **env):\n    e = dict(os.environ)\n    e.update(env)\n    r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, env=e)\n    if r.returncode == 0:\n        return r.stdout.strip()\n    return r.stderr.strip().splitlines()[-1]\nla=ZoneInfo('America/Los_Angeles'); ist=ZoneInfo('Europe/Istanbul')\nc=\"import time, datetime; print(time.strftime('%Z %z', time.localtime(1791841200)), datetime.datetime.fromtimestamp(1791841200).isoformat())\"\nos.environ['TZ']='Asia/Kolkata'; time.tzset(); t1=time.strftime('%H:%M %Z', time.localtime(1791841200)); os.environ['TZ']='UTC'; time.tzset(); t2=time.strftime('%H:%M %Z', time.localtime(1791841200))\n([DT.fromtimestamp(1000000, z).isoformat() for z in (UTC, la, ist)], [child(\"import datetime; print(repr(datetime.datetime.fromtimestamp(1000000)))\", TZ=z) for z in ('America/Los_Angeles','UTC','Europe/Istanbul')], [child(c, TZ=z) for z in ('UTC','Europe/Istanbul','America/Los_Angeles','Asia/Kolkata')], t1, t2)" ; chx:output "(['1970-01-12T13:46:40+00:00', '1970-01-12T05:46:40-08:00', '1970-01-12T15:46:40+02:00'], ['datetime.datetime(1970, 1, 12, 5, 46, 40)', 'datetime.datetime(1970, 1, 12, 13, 46, 40)', 'datetime.datetime(1970, 1, 12, 15, 46, 40)'], ['UTC +0000 2026-10-12T21:40:00', '+03 +0300 2026-10-13T00:40:00', 'PDT -0700 2026-10-12T14:40:00', 'IST +0530 2026-10-13T03:10:00'], '03:10 IST', '21:40 UTC')" .
chx:X_FromTimestampZones rd:hasIOExample chx:IO_FromTimestampZones .
chx:X_PstVersusPdt a owl:NamedIndividual, chx:PstVersusPdt ; rdfs:label "time.ctime()"@en ; skos:definition "On 17 March 2026 Los Angeles keeps daylight saving time (since 8 March), so 06:04:35 UTC is 23:04:35 PDT at -07:00, not Pacific Standard Time as the chapter says, and time.ctime prints the same instant as 'Tue Mar 17 23:04:35 2026' in Los Angeles, 'Wed Mar 18 06:04:35 2026' in UTC and 'Wed Mar 18 09:04:35 2026' in Istanbul."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PstVersusPdt a owl:NamedIndividual, rd:IOExample ; rdfs:label "import os, sys, time, subprocess\nfrom datetime import datetime as DT\nfrom zoneinfo import ZoneInfo\ndef child(code, **env):\n    e = dict(os.environ)\n    e.update(env)\n    r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, env=e)\n    if r.returncode == 0:\n        return r.stdout.strip()\n    return r.stderr.strip().splitlines()[-1]\nla=ZoneInfo('America/Los_Angeles'); d=DT.fromtimestamp(1773813875.3518236, la)\ncc=\"import time; print(time.ctime(1773813875))\"\n(d.isoformat(timespec='seconds'), d.tzname(), d.utcoffset(), d.dst(), DT(2026,3,8,3,0,tzinfo=la).tzname(), DT(2026,3,8,1,59,tzinfo=la).tzname(), DT(2026,3,17).strftime('%A'), time.asctime(time.gmtime(1773813875)), child(cc, TZ='America/Los_Angeles'), child(cc, TZ='UTC'), child(cc, TZ='Europe/Istanbul'))"@en ; chx:input "import os, sys, time, subprocess\nfrom datetime import datetime as DT\nfrom zoneinfo import ZoneInfo\ndef child(code, **env):\n    e = dict(os.environ)\n    e.update(env)\n    r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, env=e)\n    if r.returncode == 0:\n        return r.stdout.strip()\n    return r.stderr.strip().splitlines()[-1]\nla=ZoneInfo('America/Los_Angeles'); d=DT.fromtimestamp(1773813875.3518236, la)\ncc=\"import time; print(time.ctime(1773813875))\"\n(d.isoformat(timespec='seconds'), d.tzname(), d.utcoffset(), d.dst(), DT(2026,3,8,3,0,tzinfo=la).tzname(), DT(2026,3,8,1,59,tzinfo=la).tzname(), DT(2026,3,17).strftime('%A'), time.asctime(time.gmtime(1773813875)), child(cc, TZ='America/Los_Angeles'), child(cc, TZ='UTC'), child(cc, TZ='Europe/Istanbul'))" ; chx:output "('2026-03-17T23:04:35-07:00', 'PDT', datetime.timedelta(days=-1, seconds=61200), datetime.timedelta(seconds=3600), 'PDT', 'PST', 'Tuesday', 'Wed Mar 18 06:04:35 2026', 'Tue Mar 17 23:04:35 2026', 'Wed Mar 18 06:04:35 2026', 'Wed Mar 18 09:04:35 2026')" .
chx:X_PstVersusPdt rd:hasIOExample chx:IO_PstVersusPdt .
chx:X_WallClockArithmetic a owl:NamedIndividual, chx:WallClockArithmetic ; rdfs:label "aware_datetime + timedelta(days=1)"@en ; skos:definition "Adding a timedelta to an aware datetime moves the wall-clock reading and keeps the zone: noon on 7 March 2026 in New York plus one day is noon on 8 March, but the two moments are 82800 seconds, 23 hours, apart in UTC, and the subtraction of two values in one zone ignores the change of offset."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_WallClockArithmetic a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, timedelta as TD, UTC\nfrom zoneinfo import ZoneInfo\nny=ZoneInfo('America/New_York'); a=DT(2026,3,7,12,0,tzinfo=ny); b=a+TD(days=1)\n(a.isoformat(), b.isoformat(), (b.astimezone(UTC)-a.astimezone(UTC)), (b-a), (a.astimezone(UTC)+TD(days=1)).astimezone(ny).isoformat(), (a+TD(hours=24)).isoformat())"@en ; chx:input "from datetime import datetime as DT, timedelta as TD, UTC\nfrom zoneinfo import ZoneInfo\nny=ZoneInfo('America/New_York'); a=DT(2026,3,7,12,0,tzinfo=ny); b=a+TD(days=1)\n(a.isoformat(), b.isoformat(), (b.astimezone(UTC)-a.astimezone(UTC)), (b-a), (a.astimezone(UTC)+TD(days=1)).astimezone(ny).isoformat(), (a+TD(hours=24)).isoformat())" ; chx:output "('2026-03-07T12:00:00-05:00', '2026-03-08T12:00:00-04:00', datetime.timedelta(seconds=82800), datetime.timedelta(days=1), '2026-03-08T13:00:00-04:00', '2026-03-08T12:00:00-04:00')" .
chx:X_WallClockArithmetic rd:hasIOExample chx:IO_WallClockArithmetic .
chx:X_GapAndFold a owl:NamedIndividual, chx:GapAndFold ; rdfs:label "datetime(2026, 11, 1, 1, 30, fold=1)"@en ; skos:definition "When clocks go forward, 02:30 on 8 March 2026 in New York does not exist and converts to 03:30 EDT; when they go back, 01:30 on 1 November 2026 happens twice, fold=0 meaning the first, 05:30 UTC, and fold=1 the second, 06:30 UTC, although the two values compare equal."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_GapAndFold a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, UTC\nfrom zoneinfo import ZoneInfo\nny=ZoneInfo('America/New_York')\ng=DT(2026,3,8,2,30,tzinfo=ny); f0=DT(2026,11,1,1,30,tzinfo=ny); f1=f0.replace(fold=1)\n(g.isoformat(), g.astimezone(UTC).isoformat(), g.astimezone(UTC).astimezone(ny).isoformat(), f0.isoformat(), f1.isoformat(), f0==f1, f0.astimezone(UTC).isoformat(), f1.astimezone(UTC).isoformat(), (f1.astimezone(UTC)-f0.astimezone(UTC)), (f1-f0))"@en ; chx:input "from datetime import datetime as DT, UTC\nfrom zoneinfo import ZoneInfo\nny=ZoneInfo('America/New_York')\ng=DT(2026,3,8,2,30,tzinfo=ny); f0=DT(2026,11,1,1,30,tzinfo=ny); f1=f0.replace(fold=1)\n(g.isoformat(), g.astimezone(UTC).isoformat(), g.astimezone(UTC).astimezone(ny).isoformat(), f0.isoformat(), f1.isoformat(), f0==f1, f0.astimezone(UTC).isoformat(), f1.astimezone(UTC).isoformat(), (f1.astimezone(UTC)-f0.astimezone(UTC)), (f1-f0))" ; chx:output "('2026-03-08T02:30:00-05:00', '2026-03-08T07:30:00+00:00', '2026-03-08T03:30:00-04:00', '2026-11-01T01:30:00-04:00', '2026-11-01T01:30:00-05:00', True, '2026-11-01T05:30:00+00:00', '2026-11-01T06:30:00+00:00', datetime.timedelta(seconds=3600), datetime.timedelta(0))" .
chx:X_GapAndFold rd:hasIOExample chx:IO_GapAndFold .
chx:X_Year2038 a owl:NamedIndividual, chx:Year2038 ; rdfs:label "2**31"@en ; skos:definition "A signed 32-bit time_t counts to 2147483647, 03:14:07 UTC on 19 January 2038, and 2**31 wraps to -2147483648, which is 20:45:52 UTC on 13 December 1901; a 64-bit value reaches datetime's year 9999 and negative timestamps are dates before 1970."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_Year2038 a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time, struct\nfrom datetime import datetime as DT, UTC\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nt=2**31\npacked=struct.pack('<I', t); wrapped=struct.unpack('<i', packed)[0]\ndef _e27():\n    return DT.fromtimestamp(-62135596801, UTC)\ndef _e26():\n    return DT.fromtimestamp(253402300800, UTC)\n(DT.fromtimestamp(t-1, UTC).isoformat(), DT.fromtimestamp(t, UTC).isoformat(), wrapped, DT.fromtimestamp(wrapped, UTC).isoformat(), time.gmtime(2**40)[0], DT.fromtimestamp(253402300799, UTC).isoformat(), err(_e26), struct.calcsize('l'), struct.calcsize('q'), DT.fromtimestamp(-1, UTC).isoformat(), DT.fromtimestamp(-86400*365*100, UTC).isoformat(), err(_e27))"@en ; chx:input "import time, struct\nfrom datetime import datetime as DT, UTC\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nt=2**31\npacked=struct.pack('<I', t); wrapped=struct.unpack('<i', packed)[0]\ndef _e27():\n    return DT.fromtimestamp(-62135596801, UTC)\ndef _e26():\n    return DT.fromtimestamp(253402300800, UTC)\n(DT.fromtimestamp(t-1, UTC).isoformat(), DT.fromtimestamp(t, UTC).isoformat(), wrapped, DT.fromtimestamp(wrapped, UTC).isoformat(), time.gmtime(2**40)[0], DT.fromtimestamp(253402300799, UTC).isoformat(), err(_e26), struct.calcsize('l'), struct.calcsize('q'), DT.fromtimestamp(-1, UTC).isoformat(), DT.fromtimestamp(-86400*365*100, UTC).isoformat(), err(_e27))" ; chx:output "('2038-01-19T03:14:07+00:00', '2038-01-19T03:14:08+00:00', -2147483648, '1901-12-13T20:45:52+00:00', 36812, '9999-12-31T23:59:59+00:00', ('ValueError', 'year must be in 1..9999, not 10000'), 8, 8, '1969-12-31T23:59:59+00:00', '1870-01-25T00:00:00+00:00', ('ValueError', 'year must be in 1..9999, not 0'))" .
chx:X_Year2038 rd:hasIOExample chx:IO_Year2038 .
chx:X_DatetimeRange a owl:NamedIndividual, chx:DatetimeRange ; rdfs:label "datetime.date.max"@en ; skos:definition "The datetime types run from 1 January of the year 1 to 31 December 9999, date.max is 9999-12-31, and arithmetic beyond either end raises OverflowError ('date value out of range') instead of wrapping."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DatetimeRange a owl:NamedIndividual, rd:IOExample ; rdfs:label "from datetime import datetime as DT, timedelta as TD, date as D\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef _e30():\n    return D(1,1,1)-TD(days=1)\ndef _e29():\n    return DT.min-TD(days=1)\ndef _e28():\n    return DT.max+TD(microseconds=1)\n(D.min, D.max, DT.max, err(_e28), err(_e29), err(_e30), D(1,1,1).weekday(), D(1,1,1).toordinal(), D.fromordinal(1))"@en ; chx:input "from datetime import datetime as DT, timedelta as TD, date as D\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef _e30():\n    return D(1,1,1)-TD(days=1)\ndef _e29():\n    return DT.min-TD(days=1)\ndef _e28():\n    return DT.max+TD(microseconds=1)\n(D.min, D.max, DT.max, err(_e28), err(_e29), err(_e30), D(1,1,1).weekday(), D(1,1,1).toordinal(), D.fromordinal(1))" ; chx:output "(datetime.date(1, 1, 1), datetime.date(9999, 12, 31), datetime.datetime(9999, 12, 31, 23, 59, 59, 999999), ('OverflowError', 'date value out of range'), ('OverflowError', 'date value out of range'), ('OverflowError', 'date value out of range'), 0, 1, datetime.date(1, 1, 1))" .
chx:X_DatetimeRange rd:hasIOExample chx:IO_DatetimeRange .
chx:X_GregorianCalendar a owl:NamedIndividual, chx:GregorianCalendar ; rdfs:label "datetime.date(1582, 10, 5)"@en ; skos:definition "Python's date uses the Gregorian rules for every year, so 5 October 1582, a day that did not exist in the countries that adopted the calendar then, is a Tuesday in Python, 1900 and 2100 are not leap years, 2000 is, the years 1 to 9999 hold 2424 leap years and 3,652,059 days."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_GregorianCalendar a owl:NamedIndividual, rd:IOExample ; rdfs:label "import calendar\nfrom datetime import date as D\n(D(1582,10,5).strftime('%A %d %B %Y'), D(1582,10,4).toordinal()+1==D(1582,10,5).toordinal(), calendar.isleap(1900), calendar.isleap(2000), calendar.isleap(2024), calendar.isleap(2100), calendar.monthrange(2026,2), sum(calendar.isleap(y) for y in range(1,10000)), 365*9999+sum(calendar.isleap(y) for y in range(1,10000)))"@en ; chx:input "import calendar\nfrom datetime import date as D\n(D(1582,10,5).strftime('%A %d %B %Y'), D(1582,10,4).toordinal()+1==D(1582,10,5).toordinal(), calendar.isleap(1900), calendar.isleap(2000), calendar.isleap(2024), calendar.isleap(2100), calendar.monthrange(2026,2), sum(calendar.isleap(y) for y in range(1,10000)), 365*9999+sum(calendar.isleap(y) for y in range(1,10000)))" ; chx:output "('Tuesday 05 October 1582', True, False, True, True, False, (calendar.SUNDAY, 28), 2424, 3652059)" .
chx:X_GregorianCalendar rd:hasIOExample chx:IO_GregorianCalendar .
chx:X_RunWaits a owl:NamedIndividual, chx:RunWaits ; rdfs:label "subprocess.run(['C:\\\\Windows\\\\System32\\\\calc.exe'])"@en ; skos:definition "subprocess.run starts the program, waits until it ends and returns a CompletedProcess that records the arguments and the return code, which prints as CompletedProcess(args=['sleep', '0.3'], returncode=0); capture_output adds stdout and stderr to the repr."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_RunWaits a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, time, subprocess\nt=time.monotonic(); r=subprocess.run(['sleep','0.3']); e=time.monotonic()-t\nr2=subprocess.run([sys.executable,'-c','print(\"hi\")'], capture_output=True, text=True)\n(r, r.returncode, r.args, e>=0.3, type(r).__name__, r.stdout, r.stderr, repr(r2).replace(sys.executable,'PY'), subprocess.run(['true']), subprocess.run(['false']))"@en ; chx:input "import sys, time, subprocess\nt=time.monotonic(); r=subprocess.run(['sleep','0.3']); e=time.monotonic()-t\nr2=subprocess.run([sys.executable,'-c','print(\"hi\")'], capture_output=True, text=True)\n(r, r.returncode, r.args, e>=0.3, type(r).__name__, r.stdout, r.stderr, repr(r2).replace(sys.executable,'PY'), subprocess.run(['true']), subprocess.run(['false']))" ; chx:output "(CompletedProcess(args=['sleep', '0.3'], returncode=0), 0, ['sleep', '0.3'], True, 'CompletedProcess', None, None, 'CompletedProcess(args=[\\'PY\\', \\'-c\\', \\'print('hi')\\'], returncode=0, stdout=\\'hi\\\\n\\', stderr=\\'\\')', CompletedProcess(args=['true'], returncode=0), CompletedProcess(args=['false'], returncode=1))" .
chx:X_RunWaits rd:hasIOExample chx:IO_RunWaits .
chx:X_PopenNoWait a owl:NamedIndividual, chx:PopenNoWait ; rdfs:label "calc_proc = subprocess.Popen([...])"@en ; skos:definition "subprocess.Popen returns at once with a Popen object; poll() returns None while the process runs and its return code after, wait() blocks until it ends, and wait(timeout=0.1) on a process that runs longer raises TimeoutExpired."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PopenNoWait a owl:NamedIndividual, rd:IOExample ; rdfs:label "import time, subprocess\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nt=time.monotonic(); p=subprocess.Popen(['sleep','0.4']); back=time.monotonic()-t\npolls=[p.poll()]; code=p.wait(); polls.append(p.poll())\nq=subprocess.Popen(['sleep','0.3']); first=q.poll() is None; n=0\nwhile q.poll() is None: n+=1; time.sleep(0.01)\ndef _e31():\n    return subprocess.Popen(['sleep','2']).wait(timeout=0.1)\n(back<0.2, polls, code, type(p).__name__, p.returncode, p.pid>0, first, n>3, q.wait(), err(_e31))"@en ; chx:input "import time, subprocess\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nt=time.monotonic(); p=subprocess.Popen(['sleep','0.4']); back=time.monotonic()-t\npolls=[p.poll()]; code=p.wait(); polls.append(p.poll())\nq=subprocess.Popen(['sleep','0.3']); first=q.poll() is None; n=0\nwhile q.poll() is None: n+=1; time.sleep(0.01)\ndef _e31():\n    return subprocess.Popen(['sleep','2']).wait(timeout=0.1)\n(back<0.2, polls, code, type(p).__name__, p.returncode, p.pid>0, first, n>3, q.wait(), err(_e31))" ; chx:output "(True, [None, 0], 0, 'Popen', 0, True, True, True, 0, ('TimeoutExpired', 'Command '['sleep', '2']' timed out after 0.1 seconds'))" .
chx:X_PopenNoWait rd:hasIOExample chx:IO_PopenNoWait .
chx:X_CheckAndTimeout a owl:NamedIndividual, chx:CheckAndTimeout ; rdfs:label "subprocess.run(cmd, check=True, timeout=10)"@en ; skos:definition "run() does not raise for a program that fails unless check=True, which raises CalledProcessError with the return code; timeout kills the child and raises TimeoutExpired; a missing program raises FileNotFoundError and a directory PermissionError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CheckAndTimeout a owl:NamedIndividual, rd:IOExample ; rdfs:label "import subprocess\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef _e36():\n    return subprocess.run(['sh','-c','exit 2'],check=True)\ndef _e35():\n    return subprocess.run(['/etc'])\ndef _e34():\n    return subprocess.run(['no-such-program-xyz'])\ndef _e33():\n    return subprocess.run(['sleep','5'],timeout=0.2)\ndef _e32():\n    return subprocess.run(['false'],check=True)\n(err(_e32), err(_e33), err(_e34), err(_e35), err(_e36), issubclass(subprocess.CalledProcessError, subprocess.SubprocessError), issubclass(FileNotFoundError, OSError))"@en ; chx:input "import subprocess\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ndef _e36():\n    return subprocess.run(['sh','-c','exit 2'],check=True)\ndef _e35():\n    return subprocess.run(['/etc'])\ndef _e34():\n    return subprocess.run(['no-such-program-xyz'])\ndef _e33():\n    return subprocess.run(['sleep','5'],timeout=0.2)\ndef _e32():\n    return subprocess.run(['false'],check=True)\n(err(_e32), err(_e33), err(_e34), err(_e35), err(_e36), issubclass(subprocess.CalledProcessError, subprocess.SubprocessError), issubclass(FileNotFoundError, OSError))" ; chx:output "(('CalledProcessError', 'Command '['false']' returned non-zero exit status 1.'), ('TimeoutExpired', 'Command '['sleep', '5']' timed out after 0.2 seconds'), ('FileNotFoundError', '[Errno 2] No such file or directory: 'no-such-program-xyz''), ('PermissionError', '[Errno 13] Permission denied: '/etc''), ('CalledProcessError', 'Command '['sh', '-c', 'exit 2']' returned non-zero exit status 2.'), True, True)" .
chx:X_CheckAndTimeout rd:hasIOExample chx:IO_CheckAndTimeout .
chx:X_ArgumentList a owl:NamedIndividual, chx:ArgumentList ; rdfs:label "subprocess.Popen(['notepad.exe', 'hello.txt'])"@en ; skos:definition "Each item of the list becomes one argument of the program with no shell in between, so 'my file.txt' with a space arrives as one argument and *.txt arrives as the text *.txt, unexpanded; shlex.split cuts a command line into such a list."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ArgumentList a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, subprocess, shlex\nimport ast\nc='import sys; print(sys.argv[1:])'\nr=subprocess.run([sys.executable,'-c','import sys; print(sys.argv)','one','two words'],capture_output=True,text=True)\n(subprocess.run([sys.executable,'-c',c,'my file.txt','a b','--x=1'],capture_output=True,text=True).stdout.strip(), shlex.split(\"notepad 'my file.txt' x\"), subprocess.run([sys.executable,'-c',c,'*.txt'],capture_output=True,text=True).stdout.strip(), r.stdout.strip(), len(ast.literal_eval(r.stdout)), subprocess.run(['sh','-c','echo \"$0|$1|$2\"','zero','one'],capture_output=True,text=True).stdout.strip())"@en ; chx:input "import sys, subprocess, shlex\nimport ast\nc='import sys; print(sys.argv[1:])'\nr=subprocess.run([sys.executable,'-c','import sys; print(sys.argv)','one','two words'],capture_output=True,text=True)\n(subprocess.run([sys.executable,'-c',c,'my file.txt','a b','--x=1'],capture_output=True,text=True).stdout.strip(), shlex.split(\"notepad 'my file.txt' x\"), subprocess.run([sys.executable,'-c',c,'*.txt'],capture_output=True,text=True).stdout.strip(), r.stdout.strip(), len(ast.literal_eval(r.stdout)), subprocess.run(['sh','-c','echo \"$0|$1|$2\"','zero','one'],capture_output=True,text=True).stdout.strip())" ; chx:output "('['my file.txt', 'a b', '--x=1']', ['notepad', 'my file.txt', 'x'], '['*.txt']', '['-c', 'one', 'two words']', 3, 'zero|one|')" .
chx:X_ArgumentList rd:hasIOExample chx:IO_ArgumentList .
chx:X_CaptureOutput a owl:NamedIndividual, chx:CaptureOutput ; rdfs:label "subprocess.run(['ping', '-n', '4', 'nostarch.com'], capture_output=True, text=True)"@en ; skos:definition "capture_output=True collects stdout and stderr, as bytes unless text=True makes them str, and cannot be combined with stdout=; the book's ping -n 4 is the Windows flag and exits 2 on Linux, where -c 2 sends two packets, here to 127.0.0.1 with no loss."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CaptureOutput a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, subprocess\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nr=subprocess.run([sys.executable,'-c','import sys; print(\"out\"); print(\"err\", file=sys.stderr)'],capture_output=True)\nt=subprocess.run([sys.executable,'-c','import sys; print(\"out\"); print(\"err\", file=sys.stderr)'],capture_output=True,text=True)\na=subprocess.run(['ping','-n','4','localhost'],capture_output=True,text=True); b=subprocess.run(['ping','-c','2','-W','2','127.0.0.1'],capture_output=True,text=True)\ndef _e37():\n    return subprocess.run(['echo'],capture_output=True,stdout=subprocess.PIPE)\n(r.stdout, r.stderr, t.stdout, t.stderr, type(r.stdout).__name__, type(t.stdout).__name__, err(_e37), a.returncode, b.returncode, '2 received' in b.stdout, b.stdout.splitlines()[0].split(' (')[0], '0% packet loss' in b.stdout)"@en ; chx:input "import sys, subprocess\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nr=subprocess.run([sys.executable,'-c','import sys; print(\"out\"); print(\"err\", file=sys.stderr)'],capture_output=True)\nt=subprocess.run([sys.executable,'-c','import sys; print(\"out\"); print(\"err\", file=sys.stderr)'],capture_output=True,text=True)\na=subprocess.run(['ping','-n','4','localhost'],capture_output=True,text=True); b=subprocess.run(['ping','-c','2','-W','2','127.0.0.1'],capture_output=True,text=True)\ndef _e37():\n    return subprocess.run(['echo'],capture_output=True,stdout=subprocess.PIPE)\n(r.stdout, r.stderr, t.stdout, t.stderr, type(r.stdout).__name__, type(t.stdout).__name__, err(_e37), a.returncode, b.returncode, '2 received' in b.stdout, b.stdout.splitlines()[0].split(' (')[0], '0% packet loss' in b.stdout)" ; chx:output "(b'out\\n', b'err\\n', 'out\\n', 'err\\n', 'bytes', 'str', ('ValueError', 'stdout and stderr arguments may not be used with capture_output.'), 2, 0, True, 'PING 127.0.0.1', True)" .
chx:X_CaptureOutput rd:hasIOExample chx:IO_CaptureOutput .
chx:X_ShellTrueList a owl:NamedIndividual, chx:ShellTrueList ; rdfs:label "subprocess.run(['start', 'hello.txt'], shell=True)"@en ; skos:definition "On Windows shell=True with a list hands the list to cmd.exe, whose start command opens the file; on POSIX the first item alone is the command string and the others become the shell's own arguments, so ['echo', 'hi', 'there'] prints an empty line and ['start', 'hello.txt'] exits 127 with 'start: not found'."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ShellTrueList a owl:NamedIndividual, rd:IOExample ; rdfs:label "import subprocess, shutil\n(subprocess.run(['echo','hi','there'],shell=True,capture_output=True,text=True).stdout, subprocess.run('echo hi there',shell=True,capture_output=True,text=True).stdout, subprocess.run(['start','hello.txt'],shell=True,capture_output=True,text=True).returncode, subprocess.run(['start','hello.txt'],shell=True,capture_output=True,text=True).stderr.strip().split(': ',1)[1], shutil.which('start'))"@en ; chx:input "import subprocess, shutil\n(subprocess.run(['echo','hi','there'],shell=True,capture_output=True,text=True).stdout, subprocess.run('echo hi there',shell=True,capture_output=True,text=True).stdout, subprocess.run(['start','hello.txt'],shell=True,capture_output=True,text=True).returncode, subprocess.run(['start','hello.txt'],shell=True,capture_output=True,text=True).stderr.strip().split(': ',1)[1], shutil.which('start'))" ; chx:output "('\\n', 'hi there\\n', 127, '1: start: not found', None)" .
chx:X_ShellTrueList rd:hasIOExample chx:IO_ShellTrueList .
chx:X_ShellInjection a owl:NamedIndividual, chx:ShellInjection ; rdfs:label "f'echo opening {name}' with shell=True"@en ; skos:definition "A command string built from a file name and run with shell=True lets the name carry shell syntax: a name of 'x; echo INJECTED' runs a second command, while shlex.quote makes it one word and a list with no shell never interprets it."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ShellInjection a owl:NamedIndividual, rd:IOExample ; rdfs:label "import subprocess, shlex\nname='x; echo INJECTED'\na=subprocess.run(f'echo opening {name}',shell=True,capture_output=True,text=True).stdout\nb=subprocess.run(f'echo opening {shlex.quote(name)}',shell=True,capture_output=True,text=True).stdout\nc=subprocess.run(['echo','opening',name],capture_output=True,text=True).stdout\n(a,b,c,shlex.quote(name),shlex.quote('plain.txt'))"@en ; chx:input "import subprocess, shlex\nname='x; echo INJECTED'\na=subprocess.run(f'echo opening {name}',shell=True,capture_output=True,text=True).stdout\nb=subprocess.run(f'echo opening {shlex.quote(name)}',shell=True,capture_output=True,text=True).stdout\nc=subprocess.run(['echo','opening',name],capture_output=True,text=True).stdout\n(a,b,c,shlex.quote(name),shlex.quote('plain.txt'))" ; chx:output "('opening x\\nINJECTED\\n', 'opening x; echo INJECTED\\n', 'opening x; echo INJECTED\\n', ''x; echo INJECTED'', 'plain.txt')" .
chx:X_ShellInjection rd:hasIOExample chx:IO_ShellInjection .
chx:X_ExitCodes a owl:NamedIndividual, chx:ExitCodes ; rdfs:label "proc.returncode"@en ; skos:definition "A program that ends normally returns 0, sys.exit(3) returns 3, an uncaught exception 1, sys.exit('msg') 1, os._exit(263) 7 because only the low 8 bits are kept, and a process killed by signal 9 or 15 shows as -9 or -15 in returncode."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ExitCodes a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, subprocess\ndef c(code):\n    return subprocess.run([sys.executable, '-c', code]).returncode\n(c('pass'), c('import sys; sys.exit(3)'), c('raise ValueError'), c('import sys; sys.exit(\"msg\")'), c('import os; os._exit(256+7)'), c('import os,signal; os.kill(os.getpid(), signal.SIGKILL)'), c('import os,signal; os.kill(os.getpid(), signal.SIGTERM)'))"@en ; chx:input "import sys, subprocess\ndef c(code):\n    return subprocess.run([sys.executable, '-c', code]).returncode\n(c('pass'), c('import sys; sys.exit(3)'), c('raise ValueError'), c('import sys; sys.exit(\"msg\")'), c('import os; os._exit(256+7)'), c('import os,signal; os.kill(os.getpid(), signal.SIGKILL)'), c('import os,signal; os.kill(os.getpid(), signal.SIGTERM)'))" ; chx:output "(0, 3, 1, 1, 7, -9, -15)" .
chx:X_ExitCodes rd:hasIOExample chx:IO_ExitCodes .
chx:X_TerminateVsKill a owl:NamedIndividual, chx:TerminateVsKill ; rdfs:label "proc.terminate(), proc.kill()"@en ; skos:definition "terminate() sends SIGTERM, which a program can handle to save its work and exit with 0, kill() sends SIGKILL, which cannot be handled and leaves return code -9, and signal.signal(SIGKILL, handler) raises OSError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TerminateVsKill a owl:NamedIndividual, rd:IOExample ; rdfs:label "import sys, subprocess, signal\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ncode=\"import signal,time,sys\\ndef stop(s,f):\\n    print('asked to stop, saving work', flush=True)\\n    sys.exit(0)\\nsignal.signal(signal.SIGTERM, stop)\\nprint('ready', flush=True)\\ntime.sleep(30)\"\np=subprocess.Popen([sys.executable,'-c',code], stdout=subprocess.PIPE, text=True); p.stdout.readline(); p.terminate(); o=p.communicate()[0]; a=(o.strip(), p.returncode)\np=subprocess.Popen([sys.executable,'-c',code], stdout=subprocess.PIPE, text=True); p.stdout.readline(); p.kill(); o=p.communicate()[0]; b=(o.strip(), p.returncode)\ndef ignore(*args):\n    return 0\ndef _e38():\n    return signal.signal(signal.SIGKILL, ignore)\n(a,b, signal.SIGKILL.value, signal.SIGTERM.value, err(_e38))"@en ; chx:input "import sys, subprocess, signal\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\ncode=\"import signal,time,sys\\ndef stop(s,f):\\n    print('asked to stop, saving work', flush=True)\\n    sys.exit(0)\\nsignal.signal(signal.SIGTERM, stop)\\nprint('ready', flush=True)\\ntime.sleep(30)\"\np=subprocess.Popen([sys.executable,'-c',code], stdout=subprocess.PIPE, text=True); p.stdout.readline(); p.terminate(); o=p.communicate()[0]; a=(o.strip(), p.returncode)\np=subprocess.Popen([sys.executable,'-c',code], stdout=subprocess.PIPE, text=True); p.stdout.readline(); p.kill(); o=p.communicate()[0]; b=(o.strip(), p.returncode)\ndef ignore(*args):\n    return 0\ndef _e38():\n    return signal.signal(signal.SIGKILL, ignore)\n(a,b, signal.SIGKILL.value, signal.SIGTERM.value, err(_e38))" ; chx:output "(('asked to stop, saving work', 0), ('', -9), 9, 15, ('OSError', '[Errno 22] Invalid argument'))" .
chx:X_TerminateVsKill rd:hasIOExample chx:IO_TerminateVsKill .
chx:X_OpenCommand a owl:NamedIndividual, chx:OpenCommand ; rdfs:label "subprocess.run(['open', 'hello.txt'])"@en ; skos:definition "open is a macOS command; on this Ubuntu machine /usr/bin/open exists only because the xdg-utils package registers an alternative that points to xdg-open, and for a file that does not exist it exits 2 with a message from xdg-open; os.startfile is defined on Windows only."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_OpenCommand a owl:NamedIndividual, rd:IOExample ; rdfs:label "import os, sys, subprocess, shutil\nr=subprocess.run(['open','/nonexistent-file'],capture_output=True,text=True)\n(shutil.which('open'), os.path.realpath(shutil.which('open')), shutil.which('xdg-open'), r.returncode, r.stderr.strip().splitlines()[-1], hasattr(os,'startfile'), sys.platform, os.name)"@en ; chx:input "import os, sys, subprocess, shutil\nr=subprocess.run(['open','/nonexistent-file'],capture_output=True,text=True)\n(shutil.which('open'), os.path.realpath(shutil.which('open')), shutil.which('xdg-open'), r.returncode, r.stderr.strip().splitlines()[-1], hasattr(os,'startfile'), sys.platform, os.name)" ; chx:output "('/usr/bin/open', '/usr/bin/xdg-open', '/usr/bin/xdg-open', 2, 'xdg-open: file '/nonexistent-file' does not exist', False, 'linux', 'posix')" .
chx:X_OpenCommand rd:hasIOExample chx:IO_OpenCommand .
chx:X_Webbrowser a owl:NamedIndividual, chx:Webbrowser ; rdfs:label "webbrowser.open(url)"@en ; skos:definition "webbrowser.open returns False and webbrowser.get() raises Error ('could not locate runnable browser') on a machine with no browser and no BROWSER variable, so the call must be checked on a server or in a container."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_Webbrowser a owl:NamedIndividual, rd:IOExample ; rdfs:label "import os\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nimport webbrowser\ndef _e39():\n    return webbrowser.get()\n(webbrowser.open('file:///nonexistent'), err(_e39), webbrowser.open_new_tab.__name__, os.environ.get('BROWSER'))"@en ; chx:input "import os\ndef err(src):\n    try:\n        return ('ok', src())\n    except Exception as e:\n        return (type(e).__name__, str(e))\nimport webbrowser\ndef _e39():\n    return webbrowser.get()\n(webbrowser.open('file:///nonexistent'), err(_e39), webbrowser.open_new_tab.__name__, os.environ.get('BROWSER'))" ; chx:output "(False, ('Error', 'could not locate runnable browser'), 'open_new_tab', None)" .
