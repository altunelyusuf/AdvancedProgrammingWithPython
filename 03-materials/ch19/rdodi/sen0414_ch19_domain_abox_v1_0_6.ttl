chx:X_EpochZero a owl:NamedIndividual, chx:EpochZero ; rdfs:label "time.gmtime(0)"@en ; skos:definition "The epoch of the time module is 00:00:00 UTC on 1 January 1970: time.gmtime(0) gives (1970, 1, 1, 0, 0, 0), calendar.timegm returns 0 for that moment, and time.time() returns the seconds since then as a float, not an int."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_EpochZero a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout = (time.gmtime(0)[:6], time.strftime(\\'%Y-%m-%d %H:%M:%S\\', time.gmtime(0)), calendar.timegm((1970,1,1,0,0,0)), DT(1970,1,1,tzinfo=UTC).timestamp(), type(time.time()).__name__)', g), g['out'])[1])({}) evaluates to ((1970, 1, 1, 0, 0, 0), '1970-01-01 00:00:00', 0, 0.0, 'float')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout = (time.gmtime(0)[:6], time.strftime(\\'%Y-%m-%d %H:%M:%S\\', time.gmtime(0)), calendar.timegm((1970,1,1,0,0,0)), DT(1970,1,1,tzinfo=UTC).timestamp(), type(time.time()).__name__)', g), g['out'])[1])({})" ; chx:output "((1970, 1, 1, 0, 0, 0), '1970-01-01 00:00:00', 0, 0.0, 'float')" .
chx:X_EpochZero rd:hasIOExample chx:IO_EpochZero .
chx:X_PosixFormula a owl:NamedIndividual, chx:PosixFormula ; rdfs:label "tm_sec + tm_min*60 + tm_hour*3600 + tm_yday*86400 + ..."@en ; skos:definition "POSIX defines the seconds since the epoch by a formula of the broken-down UTC fields in which every day has 86,400 seconds, so a leap second has no number: the formula gives 1773813875 for 06:04:35 UTC on 18 March 2026, the same as calendar.timegm, 23:59:59 on 31 December 2016 and the next midnight are 1 second apart, and datetime refuses a 60th second."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PosixFormula a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndef posix(y,mo,d,h,mi,s):\\n    tm_year=y-1900; tm_yday=(DT(y,mo,d)-DT(y,1,1)).days\\n    return s+mi*60+h*3600+tm_yday*86400+(tm_year-70)*31536000+((tm_year-69)//4)*86400-((tm_year-1)//100)*86400+((tm_year+299)//400)*86400\\nout = (posix(2026,3,18,6,4,35), calendar.timegm((2026,3,18,6,4,35)), posix(2000,2,29,12,0,0)==calendar.timegm((2000,2,29,12,0,0)), calendar.timegm((2017,1,1,0,0,0)) - calendar.timegm((2016,12,31,23,59,59)), err(lambda: DT(2016,12,31,23,59,60)), time.strptime(\\'2016-12-31 23:59:60\\',\\'%Y-%m-%d %H:%M:%S\\')[5])', g), g['out'])[1])({}) evaluates to (1773813875, 1773813875, True, 1, ('ValueError', 'second must be in 0..59, not 60'), 60)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndef posix(y,mo,d,h,mi,s):\\n    tm_year=y-1900; tm_yday=(DT(y,mo,d)-DT(y,1,1)).days\\n    return s+mi*60+h*3600+tm_yday*86400+(tm_year-70)*31536000+((tm_year-69)//4)*86400-((tm_year-1)//100)*86400+((tm_year+299)//400)*86400\\nout = (posix(2026,3,18,6,4,35), calendar.timegm((2026,3,18,6,4,35)), posix(2000,2,29,12,0,0)==calendar.timegm((2000,2,29,12,0,0)), calendar.timegm((2017,1,1,0,0,0)) - calendar.timegm((2016,12,31,23,59,59)), err(lambda: DT(2016,12,31,23,59,60)), time.strptime(\\'2016-12-31 23:59:60\\',\\'%Y-%m-%d %H:%M:%S\\')[5])', g), g['out'])[1])({})" ; chx:output "(1773813875, 1773813875, True, 1, ('ValueError', 'second must be in 0..59, not 60'), 60)" .
chx:X_PosixFormula rd:hasIOExample chx:IO_PosixFormula .
chx:X_FloatPrecision a owl:NamedIndividual, chx:FloatPrecision ; rdfs:label "time.time() and time.time_ns()"@en ; skos:definition "time.time() returns a float, a 64-bit double, which for a timestamp of 1773813875.35 has a spacing of 2.4e-07 seconds between neighbouring values, finer than a microsecond, while time.time_ns() returns an int of 19 digits that has no rounding at all."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_FloatPrecision a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nts=1773813875.3518236\\nout = (type(ts).__name__, math.ulp(ts), math.ulp(ts)<1e-6, repr(ts), type(time.time_ns()).__name__, time.time_ns()>10**18, len(str(time.time_ns())))', g), g['out'])[1])({}) evaluates to ('float', 2.384185791015625e-07, True, '1773813875.3518236', 'int', True, 19)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nts=1773813875.3518236\\nout = (type(ts).__name__, math.ulp(ts), math.ulp(ts)<1e-6, repr(ts), type(time.time_ns()).__name__, time.time_ns()>10**18, len(str(time.time_ns())))', g), g['out'])[1])({})" ; chx:output "('float', 2.384185791015625e-07, True, '1773813875.3518236', 'int', True, 19)" .
chx:X_FloatPrecision rd:hasIOExample chx:IO_FloatPrecision .
chx:X_ClockInfoTable a owl:NamedIndividual, chx:ClockInfoTable ; rdfs:label "time.get_clock_info('monotonic')"@en ; skos:definition "time.get_clock_info reports for each clock whether it is monotonic and whether it is adjustable: on Linux time.time reads CLOCK_REALTIME and is adjustable but not monotonic, while monotonic and perf_counter read CLOCK_MONOTONIC and are monotonic and not adjustable; a difference of two monotonic readings across time.sleep(0.05) is at least 0.05."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ClockInfoTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\na=time.monotonic(); b=time.perf_counter(); time.sleep(0.05); a2=time.monotonic(); b2=time.perf_counter()\\nout = ({n: (time.get_clock_info(n).monotonic, time.get_clock_info(n).adjustable, time.get_clock_info(n).implementation) for n in (\\'time\\',\\'monotonic\\',\\'perf_counter\\',\\'process_time\\')}, a2-a >= 0.05, b2-b >= 0.05)', g), g['out'])[1])({}) evaluates to ({'time': (False, True, 'clock_gettime(CLOCK_REALTIME)'), 'monotonic': (True, False, 'clock_gettime(CLOCK_MONOTONIC)'), 'perf_counter': (True, False, 'clock_gettime(CLOCK_MONOTONIC)'), 'process_time': (True, False, 'clock_gettime(CLOCK_PROCESS_CPUTIME_ID)')}, True, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\na=time.monotonic(); b=time.perf_counter(); time.sleep(0.05); a2=time.monotonic(); b2=time.perf_counter()\\nout = ({n: (time.get_clock_info(n).monotonic, time.get_clock_info(n).adjustable, time.get_clock_info(n).implementation) for n in (\\'time\\',\\'monotonic\\',\\'perf_counter\\',\\'process_time\\')}, a2-a >= 0.05, b2-b >= 0.05)', g), g['out'])[1])({})" ; chx:output "({'time': (False, True, 'clock_gettime(CLOCK_REALTIME)'), 'monotonic': (True, False, 'clock_gettime(CLOCK_MONOTONIC)'), 'perf_counter': (True, False, 'clock_gettime(CLOCK_MONOTONIC)'), 'process_time': (True, False, 'clock_gettime(CLOCK_PROCESS_CPUTIME_ID)')}, True, True)" .
chx:X_ClockInfoTable rd:hasIOExample chx:IO_ClockInfoTable .
chx:X_SteppedWallClock a owl:NamedIndividual, chx:SteppedWallClock ; rdfs:label "end_time - start_time"@en ; skos:definition "The difference of two readings of an adjustable clock is wrong when someone sets the clock between them: if the wall clock reads 1000.0 and then, set back, 990.0, the difference is -10.0 seconds, while the two readings of a monotonic clock 50.0 and 60.0 give the true +10.0."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SteppedWallClock a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nclass Fake:\\n    def __init__(s, seq): s.seq=iter(seq)\\n    def __call__(s): return next(s.seq)\\nwall=Fake([1000.0, 990.0]); mono=Fake([50.0, 60.0])\\nw0=wall(); m0=mono(); w1=wall(); m1=mono()\\nout=(w1-w0, m1-m0, time.get_clock_info(\\'time\\').adjustable, time.get_clock_info(\\'monotonic\\').adjustable)', g), g['out'])[1])({}) evaluates to (-10.0, 10.0, True, False)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nclass Fake:\\n    def __init__(s, seq): s.seq=iter(seq)\\n    def __call__(s): return next(s.seq)\\nwall=Fake([1000.0, 990.0]); mono=Fake([50.0, 60.0])\\nw0=wall(); m0=mono(); w1=wall(); m1=mono()\\nout=(w1-w0, m1-m0, time.get_clock_info(\\'time\\').adjustable, time.get_clock_info(\\'monotonic\\').adjustable)', g), g['out'])[1])({})" ; chx:output "(-10.0, 10.0, True, False)" .
chx:X_SteppedWallClock rd:hasIOExample chx:IO_SteppedWallClock .
chx:X_RoundFunction a owl:NamedIndividual, chx:RoundFunction ; rdfs:label "round(time.time() - last_time, 2)"@en ; skos:definition "round(x) with no digits returns an int and rounds a tie to the even neighbour, so round(2.5) is 2 and round(3.5) is 4, while round(x, 2) returns a float and round(2.675, 2) is 2.67 because the float nearest 2.675 lies just below it."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_RoundFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout = (round(2.4), round(2.5), round(3.5), type(round(2.5)).__name__, round(2.675,2), type(round(2.0,2)).__name__, round(3.14159,2), round(0.5), round(-0.5), round(1773813875.3518236,2))', g), g['out'])[1])({}) evaluates to (2, 2, 4, 'int', 2.67, 'float', 3.14, 0, 0, 1773813875.35)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout = (round(2.4), round(2.5), round(3.5), type(round(2.5)).__name__, round(2.675,2), type(round(2.0,2)).__name__, round(3.14159,2), round(0.5), round(-0.5), round(1773813875.3518236,2))', g), g['out'])[1])({})" ; chx:output "(2, 2, 4, 'int', 2.67, 'float', 3.14, 0, 0, 1773813875.35)" .
chx:X_RoundFunction rd:hasIOExample chx:IO_RoundFunction .
chx:X_ProfilingByClock a owl:NamedIndividual, chx:ProfilingByClock ; rdfs:label "calcProd()"@en ; skos:definition "Profiling code by the time between two clock readings measures one run on one machine: the product of 1 to 100000 built by a loop equals math.factorial(100000), has 1,516,705 bits and 456,574 decimal digits, and converting it to a string raises ValueError under the default limit of 4300 digits."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ProfilingByClock a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndef calc():\\n    p=1\\n    for i in range(1,100001): p=p*i\\n    return p\\nr=calc()\\nout = (r==math.factorial(100000), r==math.prod(range(1,100001)), r.bit_length(), err(lambda: str(r))[0], sys.get_int_max_str_digits(), len(str(r)) if sys.set_int_max_str_digits(0) is None else 0)', g), g['out'])[1])({}) evaluates to (True, True, 1516705, 'ValueError', 4300, 456574)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndef calc():\\n    p=1\\n    for i in range(1,100001): p=p*i\\n    return p\\nr=calc()\\nout = (r==math.factorial(100000), r==math.prod(range(1,100001)), r.bit_length(), err(lambda: str(r))[0], sys.get_int_max_str_digits(), len(str(r)) if sys.set_int_max_str_digits(0) is None else 0)', g), g['out'])[1])({})" ; chx:output "(True, True, 1516705, 'ValueError', 4300, 456574)" .
chx:X_ProfilingByClock rd:hasIOExample chx:IO_ProfilingByClock .
chx:X_SleepFunction a owl:NamedIndividual, chx:SleepFunction ; rdfs:label "time.sleep(5)"@en ; skos:definition "time.sleep(seconds) blocks the calling thread and returns None; a negative number raises ValueError and a string raises TypeError, and a monotonic clock shows that the pause lasted at least as long as asked."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SleepFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nt=time.monotonic(); r=time.sleep(0.2); e=time.monotonic()-t\\nout = (r, e>=0.2, e<0.5, err(lambda: time.sleep(-1)), err(lambda: time.sleep(\\'1\\')))', g), g['out'])[1])({}) evaluates to (None, True, True, ('ValueError', 'sleep length must be non-negative'), ('TypeError', ''str' object cannot be interpreted as an integer or float'))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nt=time.monotonic(); r=time.sleep(0.2); e=time.monotonic()-t\\nout = (r, e>=0.2, e<0.5, err(lambda: time.sleep(-1)), err(lambda: time.sleep(\\'1\\')))', g), g['out'])[1])({})" ; chx:output "(None, True, True, ('ValueError', 'sleep length must be non-negative'), ('TypeError', ''str' object cannot be interpreted as an integer or float'))" .
chx:X_SleepFunction rd:hasIOExample chx:IO_SleepFunction .
chx:X_SleepAndSignals a owl:NamedIndividual, chx:SleepAndSignals ; rdfs:label "signal.setitimer(signal.ITIMER_REAL, 0.05)"@en ; skos:definition "Since Python 3.5 a signal handler that returns does not cut time.sleep short, because the call is retried for the time that remains, while a handler that raises an exception ends the sleep at once; KeyboardInterrupt, which Ctrl-C raises, derives from BaseException and not from Exception."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SleepAndSignals a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nhits=[]\\nsignal.signal(signal.SIGALRM, lambda s,f: hits.append(\\'handler ran\\'))\\nsignal.setitimer(signal.ITIMER_REAL, 0.05)\\nt=time.monotonic(); time.sleep(0.3); e=time.monotonic()-t\\ndef h(s,f): raise RuntimeError(\\'from handler\\')\\nsignal.signal(signal.SIGALRM, h); signal.setitimer(signal.ITIMER_REAL, 0.05)\\nt2=time.monotonic()\\ntry: time.sleep(5)\\nexcept RuntimeError as ex: r=str(ex)\\nout = (hits, e>=0.3, r, time.monotonic()-t2<1, issubclass(KeyboardInterrupt, Exception), issubclass(KeyboardInterrupt, BaseException))', g), g['out'])[1])({}) evaluates to (['handler ran'], True, 'from handler', True, False, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nhits=[]\\nsignal.signal(signal.SIGALRM, lambda s,f: hits.append(\\'handler ran\\'))\\nsignal.setitimer(signal.ITIMER_REAL, 0.05)\\nt=time.monotonic(); time.sleep(0.3); e=time.monotonic()-t\\ndef h(s,f): raise RuntimeError(\\'from handler\\')\\nsignal.signal(signal.SIGALRM, h); signal.setitimer(signal.ITIMER_REAL, 0.05)\\nt2=time.monotonic()\\ntry: time.sleep(5)\\nexcept RuntimeError as ex: r=str(ex)\\nout = (hits, e>=0.3, r, time.monotonic()-t2<1, issubclass(KeyboardInterrupt, Exception), issubclass(KeyboardInterrupt, BaseException))', g), g['out'])[1])({})" ; chx:output "(['handler ran'], True, 'from handler', True, False, True)" .
chx:X_SleepAndSignals rd:hasIOExample chx:IO_SleepAndSignals .
chx:X_PollingLoops a owl:NamedIndividual, chx:PollingLoops ; rdfs:label "while datetime.datetime.now() < halloween_2039:"@en ; skos:definition "A loop that sleeps one second between clock checks wakes about once a second and uses almost no processor time (under 0.05 s of CPU in 1.2 s), while the same loop without the sleep keeps a processor busy (over 0.1 s of CPU in 0.3 s)."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PollingLoops a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nend=DT.now()+TD(seconds=1.2); c0=time.process_time(); t0=time.monotonic()\\nwhile DT.now()<end: time.sleep(1)\\nslept=time.process_time()-c0; w=time.monotonic()-t0\\nc0=time.process_time(); end=DT.now()+TD(seconds=0.3)\\nwhile DT.now()<end: pass\\nbusy=time.process_time()-c0\\nout=(round(w)>=1, slept<0.05, busy>0.1)', g), g['out'])[1])({}) evaluates to (True, True, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nend=DT.now()+TD(seconds=1.2); c0=time.process_time(); t0=time.monotonic()\\nwhile DT.now()<end: time.sleep(1)\\nslept=time.process_time()-c0; w=time.monotonic()-t0\\nc0=time.process_time(); end=DT.now()+TD(seconds=0.3)\\nwhile DT.now()<end: pass\\nbusy=time.process_time()-c0\\nout=(round(w)>=1, slept<0.05, busy>0.1)', g), g['out'])[1])({})" ; chx:output "(True, True, True)" .
chx:X_PollingLoops rd:hasIOExample chx:IO_PollingLoops .
chx:X_SleepDrift a owl:NamedIndividual, chx:SleepDrift ; rdfs:label "time.sleep(1) in a loop"@en ; skos:definition "A loop that sleeps a fixed second after work that takes 0.02 s starts its 3600th round 3670.98 s after the first, 71.98 s late, while a loop that sleeps until the next tick of the clock starts it at 3599.0 s, exactly on schedule."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SleepDrift a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nclass C:\\n    def __init__(s): s.t=0.0\\n    def now(s): return s.t\\n    def sleep(s,d): s.t+=d\\ndef drifting(c, n, work):\\n    starts=[]\\n    for _ in range(n): starts.append(c.now()); c.sleep(work); c.sleep(1.0)\\n    return starts[-1]\\ndef anchored(c, n, work):\\n    t0=c.now(); starts=[]\\n    for i in range(n): starts.append(c.now()); c.sleep(work); c.sleep(max(0.0, t0+(i+1)*1.0-c.now()))\\n    return starts[-1]\\nout=(round(drifting(C(),3600,0.02),2), round(anchored(C(),3600,0.02),2))', g), g['out'])[1])({}) evaluates to (3670.98, 3599.0)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nclass C:\\n    def __init__(s): s.t=0.0\\n    def now(s): return s.t\\n    def sleep(s,d): s.t+=d\\ndef drifting(c, n, work):\\n    starts=[]\\n    for _ in range(n): starts.append(c.now()); c.sleep(work); c.sleep(1.0)\\n    return starts[-1]\\ndef anchored(c, n, work):\\n    t0=c.now(); starts=[]\\n    for i in range(n): starts.append(c.now()); c.sleep(work); c.sleep(max(0.0, t0+(i+1)*1.0-c.now()))\\n    return starts[-1]\\nout=(round(drifting(C(),3600,0.02),2), round(anchored(C(),3600,0.02),2))', g), g['out'])[1])({})" ; chx:output "(3670.98, 3599.0)" .
chx:X_SleepDrift rd:hasIOExample chx:IO_SleepDrift .
chx:X_DatetimeObject a owl:NamedIndividual, chx:DatetimeObject ; rdfs:label "datetime.datetime(2026, 10, 21, 16, 29, 0)"@en ; skos:definition "A datetime object holds a moment as year, month, day, hour, minute, second and microsecond; month, day and the fields are checked when it is made, so datetime(2026, 2, 30) raises ValueError and a call without the day raises TypeError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DatetimeObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndt=DT(2026,10,21,16,29,0)\\nout = (dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second, dt.microsecond, dt, DT(2026,10,21), err(lambda: DT(2026,10)), err(lambda: DT(2026,13,1)), err(lambda: DT(2026,2,30)), dt.weekday(), dt.isoweekday())', g), g['out'])[1])({}) evaluates to (2026, 10, 21, 16, 29, 0, 0, datetime.datetime(2026, 10, 21, 16, 29), datetime.datetime(2026, 10, 21, 0, 0), ('TypeError', 'function missing required argument 'day' (pos 3)'), ('ValueError', 'month must be in 1..12, not 13'), ('ValueError', 'day 30 must be in range 1..28 for month 2 in year 2026'), 2, 3)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndt=DT(2026,10,21,16,29,0)\\nout = (dt.year, dt.month, dt.day, dt.hour, dt.minute, dt.second, dt.microsecond, dt, DT(2026,10,21), err(lambda: DT(2026,10)), err(lambda: DT(2026,13,1)), err(lambda: DT(2026,2,30)), dt.weekday(), dt.isoweekday())', g), g['out'])[1])({})" ; chx:output "(2026, 10, 21, 16, 29, 0, 0, datetime.datetime(2026, 10, 21, 16, 29), datetime.datetime(2026, 10, 21, 0, 0), ('TypeError', 'function missing required argument 'day' (pos 3)'), ('ValueError', 'month must be in 1..12, not 13'), ('ValueError', 'day 30 must be in range 1..28 for month 2 in year 2026'), 2, 3)" .
chx:X_DatetimeObject rd:hasIOExample chx:IO_DatetimeObject .
chx:X_CurrentMoment a owl:NamedIndividual, chx:CurrentMoment ; rdfs:label "datetime.datetime.now()"@en ; skos:definition "datetime.now() returns the current moment as a naive datetime in the local zone, within a second of datetime.fromtimestamp(time.time()) and of datetime.today(), and datetime.now(datetime.UTC) returns the same instant as an aware value with the offset 0."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CurrentMoment a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\na=DT.now(); b=DT.fromtimestamp(time.time()); c=DT.now(UTC)\\nout = (abs((a-b).total_seconds())<1, a.tzinfo, c.tzinfo, c.utcoffset(), type(a).__name__, DT.today().tzinfo, abs((DT.now()-DT.today()).total_seconds())<1)', g), g['out'])[1])({}) evaluates to (True, None, datetime.timezone.utc, datetime.timedelta(0), 'datetime', None, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\na=DT.now(); b=DT.fromtimestamp(time.time()); c=DT.now(UTC)\\nout = (abs((a-b).total_seconds())<1, a.tzinfo, c.tzinfo, c.utcoffset(), type(a).__name__, DT.today().tzinfo, abs((DT.now()-DT.today()).total_seconds())<1)', g), g['out'])[1])({})" ; chx:output "(True, None, datetime.timezone.utc, datetime.timedelta(0), 'datetime', None, True)" .
chx:X_CurrentMoment rd:hasIOExample chx:IO_CurrentMoment .
chx:X_DatetimeComparison a owl:NamedIndividual, chx:DatetimeComparison ; rdfs:label "new_years_2027 > halloween_2026"@en ; skos:definition "Datetime values are compared with ==, <, > and sorted, the later moment is the greater, two separately made values of one moment are equal but not the same object, and subtracting gives a timedelta of 62 days between 31 October 2026 and 1 January 2027."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DatetimeComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nh=DT(2026,10,31,0,0,0); n=DT(2027,1,1,0,0,0); o=DT(2026,10,31,0,0,0)\\nout = (h==o, h>n, n>h, n!=o, h is o, sorted([n,h]) == [h,n], max(n,h)==n, n-h)', g), g['out'])[1])({}) evaluates to (True, False, True, True, False, True, True, datetime.timedelta(days=62))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nh=DT(2026,10,31,0,0,0); n=DT(2027,1,1,0,0,0); o=DT(2026,10,31,0,0,0)\\nout = (h==o, h>n, n>h, n!=o, h is o, sorted([n,h]) == [h,n], max(n,h)==n, n-h)', g), g['out'])[1])({})" ; chx:output "(True, False, True, True, False, True, True, datetime.timedelta(days=62))" .
chx:X_DatetimeComparison rd:hasIOExample chx:IO_DatetimeComparison .
chx:X_WeekdayOfDate a owl:NamedIndividual, chx:WeekdayOfDate ; rdfs:label "datetime.date(2019, 1, 7).strftime('%A')"@en ; skos:definition "The weekday of a date comes from strftime('%A') as a name, from weekday() as a number in which Monday is 0, from isoweekday() in which Monday is 1, and from calendar.day_name; 7 January 2019 is a Monday, in ISO week 2."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_WeekdayOfDate a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nd=DT(2019,1,7)\\nout=(d.weekday(), d.strftime(\\'%A\\'), d.isoweekday(), calendar.day_name[d.weekday()], d.date().isocalendar(), D(2019,1,7).strftime(\\'%w\\'))', g), g['out'])[1])({}) evaluates to (0, 'Monday', 1, 'Monday', datetime.IsoCalendarDate(year=2019, week=2, weekday=1), '1')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nd=DT(2019,1,7)\\nout=(d.weekday(), d.strftime(\\'%A\\'), d.isoweekday(), calendar.day_name[d.weekday()], d.date().isocalendar(), D(2019,1,7).strftime(\\'%w\\'))', g), g['out'])[1])({})" ; chx:output "(0, 'Monday', 1, 'Monday', datetime.IsoCalendarDate(year=2019, week=2, weekday=1), '1')" .
chx:X_WeekdayOfDate rd:hasIOExample chx:IO_WeekdayOfDate .
chx:X_TimedeltaObject a owl:NamedIndividual, chx:TimedeltaObject ; rdfs:label "datetime.timedelta(days=11, hours=10, minutes=9, seconds=8)"@en ; skos:definition "A timedelta holds a duration and keeps only days, seconds and microseconds: 11 days, 10 hours, 9 minutes and 8 seconds is days 11, seconds 36548, microseconds 0, 986948.0 seconds in all, and a negative duration is normalised so that timedelta(seconds=-1) has days -1 and seconds 86399."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TimedeltaObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nd=TD(days=11, hours=10, minutes=9, seconds=8)\\nout=(d.days, d.seconds, d.microseconds, d.total_seconds(), str(d), repr(d), TD(weeks=1,hours=24).days, TD(milliseconds=1500), TD(seconds=-1), (TD(seconds=-1).days, TD(seconds=-1).seconds), str(TD(seconds=-1)), abs(TD(days=-2)), TD.resolution)', g), g['out'])[1])({}) evaluates to (11, 36548, 0, 986948.0, '11 days, 10:09:08', 'datetime.timedelta(days=11, seconds=36548)', 8, datetime.timedelta(seconds=1, microseconds=500000), datetime.timedelta(days=-1, seconds=86399), (-1, 86399), '-1 day, 23:59:59', datetime.timedelta(days=2), datetime.timedelta(microseconds=1))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nd=TD(days=11, hours=10, minutes=9, seconds=8)\\nout=(d.days, d.seconds, d.microseconds, d.total_seconds(), str(d), repr(d), TD(weeks=1,hours=24).days, TD(milliseconds=1500), TD(seconds=-1), (TD(seconds=-1).days, TD(seconds=-1).seconds), str(TD(seconds=-1)), abs(TD(days=-2)), TD.resolution)', g), g['out'])[1])({})" ; chx:output "(11, 36548, 0, 986948.0, '11 days, 10:09:08', 'datetime.timedelta(days=11, seconds=36548)', 8, datetime.timedelta(seconds=1, microseconds=500000), datetime.timedelta(days=-1, seconds=86399), (-1, 86399), '-1 day, 23:59:59', datetime.timedelta(days=2), datetime.timedelta(microseconds=1))" .
chx:X_TimedeltaObject rd:hasIOExample chx:IO_TimedeltaObject .
chx:X_NoMonthsOrYears a owl:NamedIndividual, chx:NoMonthsOrYears ; rdfs:label "datetime.timedelta(months=1)"@en ; skos:definition "timedelta takes weeks, days, hours, minutes, seconds, milliseconds and microseconds but no months or years, because a month has 28 to 31 days, so timedelta(months=1) raises TypeError and 31 January plus 30 days is 2 March 2026."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_NoMonthsOrYears a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout = (err(lambda: TD(months=1)), err(lambda: TD(years=1)), DT(2026,1,31)+TD(days=30), DT(2026,1,31)+TD(days=31), (DT(2026,3,1)-DT(2026,2,1)).days, (DT(2027,3,1)-DT(2027,2,1)).days, (DT(2024,3,1)-DT(2024,2,1)).days)', g), g['out'])[1])({}) evaluates to (('TypeError', '__new__() got an unexpected keyword argument 'months''), ('TypeError', '__new__() got an unexpected keyword argument 'years''), datetime.datetime(2026, 3, 2, 0, 0), datetime.datetime(2026, 3, 3, 0, 0), 28, 28, 29)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout = (err(lambda: TD(months=1)), err(lambda: TD(years=1)), DT(2026,1,31)+TD(days=30), DT(2026,1,31)+TD(days=31), (DT(2026,3,1)-DT(2026,2,1)).days, (DT(2027,3,1)-DT(2027,2,1)).days, (DT(2024,3,1)-DT(2024,2,1)).days)', g), g['out'])[1])({})" ; chx:output "(('TypeError', '__new__() got an unexpected keyword argument 'months''), ('TypeError', '__new__() got an unexpected keyword argument 'years''), datetime.datetime(2026, 3, 2, 0, 0), datetime.datetime(2026, 3, 3, 0, 0), 28, 28, 29)" .
chx:X_NoMonthsOrYears rd:hasIOExample chx:IO_NoMonthsOrYears .
chx:X_DurationArithmetic a owl:NamedIndividual, chx:DurationArithmetic ; rdfs:label "now + thousand_days"@en ; skos:definition "A timedelta is added to or subtracted from a datetime, multiplied or divided by a number, divided by another timedelta to give a number, and added to another timedelta, but two durations cannot be multiplied and a timedelta plus an int raises TypeError; 1000 days after 2 December 2026 is 28 August 2029, a Tuesday."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DurationArithmetic a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nd=TD(days=1, hours=12); now=DT(2026,12,2,18,38,50,636181); t=TD(days=1000)\\nout = (d*2, d/2, d*1.5, d//TD(hours=1), d/TD(hours=1), d%TD(hours=5), divmod(d, TD(hours=5)), err(lambda: d*d), err(lambda: d+1), now+t, (now+t).strftime(\\'%B %d, %Y\\'), (now+t).weekday())', g), g['out'])[1])({}) evaluates to (datetime.timedelta(days=3), datetime.timedelta(seconds=64800), datetime.timedelta(days=2, seconds=21600), 36, 36.0, datetime.timedelta(seconds=3600), (7, datetime.timedelta(seconds=3600)), ('TypeError', 'unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.timedelta''), ('TypeError', 'unsupported operand type(s) for +: 'datetime.timedelta' and 'int''), datetime.datetime(2029, 8, 28, 18, 38, 50, 636181), 'August 28, 2029', 1)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nd=TD(days=1, hours=12); now=DT(2026,12,2,18,38,50,636181); t=TD(days=1000)\\nout = (d*2, d/2, d*1.5, d//TD(hours=1), d/TD(hours=1), d%TD(hours=5), divmod(d, TD(hours=5)), err(lambda: d*d), err(lambda: d+1), now+t, (now+t).strftime(\\'%B %d, %Y\\'), (now+t).weekday())', g), g['out'])[1])({})" ; chx:output "(datetime.timedelta(days=3), datetime.timedelta(seconds=64800), datetime.timedelta(days=2, seconds=21600), 36, 36.0, datetime.timedelta(seconds=3600), (7, datetime.timedelta(seconds=3600)), ('TypeError', 'unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.timedelta''), ('TypeError', 'unsupported operand type(s) for +: 'datetime.timedelta' and 'int''), datetime.datetime(2029, 8, 28, 18, 38, 50, 636181), 'August 28, 2029', 1)" .
chx:X_DurationArithmetic rd:hasIOExample chx:IO_DurationArithmetic .
chx:X_ThirtyYearsError a owl:NamedIndividual, chx:ThirtyYearsError ; rdfs:label "oct_21st - about_thirty_years"@en ; skos:definition "The chapter's about_thirty_years is 365 * 30 days, but the 30 years from 21 October 1996 to 21 October 2026 hold 7 leap days (29 February of 2000, 2004, 2008, 2012, 2016, 2020 and 2024), so subtracting 10,950 days from 21 October 2026 gives 28 October 1996, 7 days off, and twice that gives 5 November 1966, 15 days off; datetime.delta() raises AttributeError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ThirtyYearsError a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport datetime\\no=DT(2026,10,21,16,29,0); t=TD(days=365*30)\\nout = (o-t, o-2*t, (o-DT(1996,10,21,16,29)).days - 365*30, o.replace(year=1996), (o-2*t).strftime(\\'%B %d, %Y\\'), (o.replace(year=1966)-(o-2*t)).days, err(lambda: datetime.delta(days=1)), hasattr(datetime,\\'timedelta\\'))', g), g['out'])[1])({}) evaluates to (datetime.datetime(1996, 10, 28, 16, 29), datetime.datetime(1966, 11, 5, 16, 29), 7, datetime.datetime(1996, 10, 21, 16, 29), 'November 05, 1966', -15, ('AttributeError', 'module 'datetime' has no attribute 'delta''), True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport datetime\\no=DT(2026,10,21,16,29,0); t=TD(days=365*30)\\nout = (o-t, o-2*t, (o-DT(1996,10,21,16,29)).days - 365*30, o.replace(year=1996), (o-2*t).strftime(\\'%B %d, %Y\\'), (o.replace(year=1966)-(o-2*t)).days, err(lambda: datetime.delta(days=1)), hasattr(datetime,\\'timedelta\\'))', g), g['out'])[1])({})" ; chx:output "(datetime.datetime(1996, 10, 28, 16, 29), datetime.datetime(1966, 11, 5, 16, 29), 7, datetime.datetime(1996, 10, 21, 16, 29), 'November 05, 1966', -15, ('AttributeError', 'module 'datetime' has no attribute 'delta''), True)" .
chx:X_ThirtyYearsError rd:hasIOExample chx:IO_ThirtyYearsError .
chx:X_DirectiveTable a owl:NamedIndividual, chx:DirectiveTable ; rdfs:label "Table 19-1"@en ; skos:definition "Table 19-1 lists the strftime directives, and on 3 November 2026 at 16:29:07 they give %Y 2026, %y 26, %m 11, %B November, %b Nov, %d 03, %j 307, %w 2, %A Tuesday, %a Tue, %H 16, %I 04, %M 29, %S 07, %p PM and %% as one percent sign; %w counts Sunday as 0."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DirectiveTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndt=DT(2026,11,3,16,29,7)\\ndirs=\\'%Y %y %m %B %b %d %j %w %A %a %H %I %M %S %p %%\\'.split()\\nout = ({d: dt.strftime(d) for d in dirs}, {d.strftime(\\'%a\\'): d.strftime(\\'%w\\') for d in (DT(2026,11,1)+TD(days=i) for i in range(7))})', g), g['out'])[1])({}) evaluates to ({'%Y': '2026', '%y': '26', '%m': '11', '%B': 'November', '%b': 'Nov', '%d': '03', '%j': '307', '%w': '2', '%A': 'Tuesday', '%a': 'Tue', '%H': '16', '%I': '04', '%M': '29', '%S': '07', '%p': 'PM', '%%': '%'}, {'Sun': '0', 'Mon': '1', 'Tue': '2', 'Wed': '3', 'Thu': '4', 'Fri': '5', 'Sat': '6'})"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndt=DT(2026,11,3,16,29,7)\\ndirs=\\'%Y %y %m %B %b %d %j %w %A %a %H %I %M %S %p %%\\'.split()\\nout = ({d: dt.strftime(d) for d in dirs}, {d.strftime(\\'%a\\'): d.strftime(\\'%w\\') for d in (DT(2026,11,1)+TD(days=i) for i in range(7))})', g), g['out'])[1])({})" ; chx:output "({'%Y': '2026', '%y': '26', '%m': '11', '%B': 'November', '%b': 'Nov', '%d': '03', '%j': '307', '%w': '2', '%A': 'Tuesday', '%a': 'Tue', '%H': '16', '%I': '04', '%M': '29', '%S': '07', '%p': 'PM', '%%': '%'}, {'Sun': '0', 'Mon': '1', 'Tue': '2', 'Wed': '3', 'Thu': '4', 'Fri': '5', 'Sat': '6'})" .
chx:X_DirectiveTable rd:hasIOExample chx:IO_DirectiveTable .
chx:X_StrftimeFormat a owl:NamedIndividual, chx:StrftimeFormat ; rdfs:label "oct_21st.strftime('%Y/%m/%d %H:%M:%S')"@en ; skos:definition "strftime returns text from a format of directives and other characters: '%Y/%m/%d %H:%M:%S' gives '2026/10/21 16:29:00', '%I:%M %p' gives '04:29 PM', the directives %e, %k and %-d are platform extensions, and %z and %Z are empty for a naive value."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_StrftimeFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\no=DT(2026,10,21,16,29,0)\\nout=(o.strftime(\\'%Y/%m/%d %H:%M:%S\\'), o.strftime(\\'%I:%M %p\\'), o.strftime(\\x22%B of \\'%y\\x22), o.strftime(\\'%-d %-m\\'), o.strftime(\\'%e|%k|%l\\'), o.strftime(\\'%f\\'), DT(2026,10,21,16,29,0,123).strftime(\\'%f\\'), o.strftime(\\'%z|%Z|\\'), o.replace(tzinfo=UTC).strftime(\\'%z|%Z|%:z\\'))', g), g['out'])[1])({}) evaluates to ('2026/10/21 16:29:00', '04:29 PM', 'October of '26', '21 10', '21|16| 4', '000000', '000123', '||', '+0000|UTC|+00:00')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\no=DT(2026,10,21,16,29,0)\\nout=(o.strftime(\\'%Y/%m/%d %H:%M:%S\\'), o.strftime(\\'%I:%M %p\\'), o.strftime(\\x22%B of \\'%y\\x22), o.strftime(\\'%-d %-m\\'), o.strftime(\\'%e|%k|%l\\'), o.strftime(\\'%f\\'), DT(2026,10,21,16,29,0,123).strftime(\\'%f\\'), o.strftime(\\'%z|%Z|\\'), o.replace(tzinfo=UTC).strftime(\\'%z|%Z|%:z\\'))', g), g['out'])[1])({})" ; chx:output "('2026/10/21 16:29:00', '04:29 PM', 'October of '26', '21 10', '21|16| 4', '000000', '000123', '||', '+0000|UTC|+00:00')" .
chx:X_StrftimeFormat rd:hasIOExample chx:IO_StrftimeFormat .
chx:X_StrptimeParse a owl:NamedIndividual, chx:StrptimeParse ; rdfs:label "datetime.datetime.strptime('October 21, 2026', '%B %d, %Y')"@en ; skos:definition "strptime reads a datetime from text by a format and raises ValueError when the text does not match, as '2026-10-21' does for '%Y/%m/%d'; it accepts '2026-1-5' for '%Y-%m-%d', refuses leading and trailing spaces, and since Python 3.14 date.strptime and time.strptime exist beside datetime.strptime."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_StrptimeParse a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport datetime\\np=DT.strptime\\nout=(p(\\'October 21, 2026\\',\\'%B %d, %Y\\'), p(\\'2026/10/21 16:29:00\\',\\'%Y/%m/%d %H:%M:%S\\'), p(\\x22November of \\'63\\x22,\\x22%B of \\'%y\\x22), err(lambda: p(\\'2026-10-21\\',\\'%Y/%m/%d\\')), p(\\'2026-1-5\\',\\'%Y-%m-%d\\'), err(lambda: p(\\'  2026\\',\\'%Y\\')), err(lambda: p(\\'2026 \\',\\'%Y\\')), err(lambda: p(\\'2026-10-21T16:29:00Z\\',\\'%Y-%m-%dT%H:%M:%S\\')), p(\\'2026-10-21T16:29:00Z\\',\\'%Y-%m-%dT%H:%M:%S%z\\'), hasattr(D,\\'strptime\\'), D.strptime(\\'2026-10-21\\',\\'%Y-%m-%d\\'), datetime.time.strptime(\\'16:29\\',\\'%H:%M\\'))', g), g['out'])[1])({}) evaluates to (datetime.datetime(2026, 10, 21, 0, 0), datetime.datetime(2026, 10, 21, 16, 29), datetime.datetime(2063, 11, 1, 0, 0), ('ValueError', 'time data '2026-10-21' does not match format '%Y/%m/%d''), datetime.datetime(2026, 1, 5, 0, 0), ('ValueError', 'time data '  2026' does not match format '%Y''), ('ValueError', 'unconverted data remains:  '), ('ValueError', 'unconverted data remains: Z'), datetime.datetime(2026, 10, 21, 16, 29, tzinfo=datetime.timezone.utc), True, datetime.date(2026, 10, 21), datetime.time(16, 29))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport datetime\\np=DT.strptime\\nout=(p(\\'October 21, 2026\\',\\'%B %d, %Y\\'), p(\\'2026/10/21 16:29:00\\',\\'%Y/%m/%d %H:%M:%S\\'), p(\\x22November of \\'63\\x22,\\x22%B of \\'%y\\x22), err(lambda: p(\\'2026-10-21\\',\\'%Y/%m/%d\\')), p(\\'2026-1-5\\',\\'%Y-%m-%d\\'), err(lambda: p(\\'  2026\\',\\'%Y\\')), err(lambda: p(\\'2026 \\',\\'%Y\\')), err(lambda: p(\\'2026-10-21T16:29:00Z\\',\\'%Y-%m-%dT%H:%M:%S\\')), p(\\'2026-10-21T16:29:00Z\\',\\'%Y-%m-%dT%H:%M:%S%z\\'), hasattr(D,\\'strptime\\'), D.strptime(\\'2026-10-21\\',\\'%Y-%m-%d\\'), datetime.time.strptime(\\'16:29\\',\\'%H:%M\\'))', g), g['out'])[1])({})" ; chx:output "(datetime.datetime(2026, 10, 21, 0, 0), datetime.datetime(2026, 10, 21, 16, 29), datetime.datetime(2063, 11, 1, 0, 0), ('ValueError', 'time data '2026-10-21' does not match format '%Y/%m/%d''), datetime.datetime(2026, 1, 5, 0, 0), ('ValueError', 'time data '  2026' does not match format '%Y''), ('ValueError', 'unconverted data remains:  '), ('ValueError', 'unconverted data remains: Z'), datetime.datetime(2026, 10, 21, 16, 29, tzinfo=datetime.timezone.utc), True, datetime.date(2026, 10, 21), datetime.time(16, 29))" .
chx:X_StrptimeParse rd:hasIOExample chx:IO_StrptimeParse .
chx:X_TwoDigitYear a owl:NamedIndividual, chx:TwoDigitYear ; rdfs:label "%y"@en ; skos:definition "The %y directive follows POSIX: 69 to 99 mean 1969 to 1999 and 00 to 68 mean 2000 to 2068, so '68' is 2068 and '69' is 1969, which is not the 1970 to 2069 that Table 19-1 prints; the book's two examples, 63 as 2063 and 73 as 1973, are right either way."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TwoDigitYear a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=([(s, DT.strptime(s,\\'%y\\').year) for s in (\\'00\\',\\'26\\',\\'63\\',\\'68\\',\\'69\\',\\'70\\',\\'73\\',\\'99\\')], [(s, time.strptime(s,\\'%y\\').tm_year) for s in (\\'68\\',\\'69\\')], DT(2026,1,1).strftime(\\'%y\\'), DT(1969,1,1).strftime(\\'%y\\'), DT(2069,1,1).strftime(\\'%y\\'))', g), g['out'])[1])({}) evaluates to ([('00', 2000), ('26', 2026), ('63', 2063), ('68', 2068), ('69', 1969), ('70', 1970), ('73', 1973), ('99', 1999)], [('68', 2068), ('69', 1969)], '26', '69', '69')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=([(s, DT.strptime(s,\\'%y\\').year) for s in (\\'00\\',\\'26\\',\\'63\\',\\'68\\',\\'69\\',\\'70\\',\\'73\\',\\'99\\')], [(s, time.strptime(s,\\'%y\\').tm_year) for s in (\\'68\\',\\'69\\')], DT(2026,1,1).strftime(\\'%y\\'), DT(1969,1,1).strftime(\\'%y\\'), DT(2069,1,1).strftime(\\'%y\\'))', g), g['out'])[1])({})" ; chx:output "([('00', 2000), ('26', 2026), ('63', 2063), ('68', 2068), ('69', 1969), ('70', 1970), ('73', 1973), ('99', 1999)], [('68', 2068), ('69', 1969)], '26', '69', '69')" .
chx:X_TwoDigitYear rd:hasIOExample chx:IO_TwoDigitYear .
chx:X_YearlessParsing a owl:NamedIndividual, chx:YearlessParsing ; rdfs:label "strptime('02/29', '%m/%d')"@en ; skos:definition "A format with a month and a day but no year uses the year 1900, which is not a leap year, so '02/29' raises ValueError and draws a DeprecationWarning from Python 3.13 on, '02/29;1984' with a year parses, and 21 October without a year silently becomes 1900-10-21."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_YearlessParsing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(warned(lambda: err(lambda: DT.strptime(\\'02/29\\',\\'%m/%d\\'))), warned(lambda: DT.strptime(\\'02/29;1984\\',\\'%m/%d;%Y\\')), warned(lambda: DT.strptime(\\'10/21\\',\\'%m/%d\\')))', g), g['out'])[1])({}) evaluates to ((('ValueError', 'day 29 must be in range 1..28 for month 2 in year 1900'), [('DeprecationWarning', 'Parsing dates involving a day of month without a year specified is ambiguous\\nand fails to parse leap day. The default behavior will change in Python 3.15\\nto either always raise an exception or to use a different default year (TBD).\\nTo avoid trouble, add a specific year to the input & format.\\nSee https://github.com/python/cpython/issues/70647.')]), (datetime.datetime(1984, 2, 29, 0, 0), []), (datetime.datetime(1900, 10, 21, 0, 0), []))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(warned(lambda: err(lambda: DT.strptime(\\'02/29\\',\\'%m/%d\\'))), warned(lambda: DT.strptime(\\'02/29;1984\\',\\'%m/%d;%Y\\')), warned(lambda: DT.strptime(\\'10/21\\',\\'%m/%d\\')))', g), g['out'])[1])({})" ; chx:output "((('ValueError', 'day 29 must be in range 1..28 for month 2 in year 1900'), [('DeprecationWarning', 'Parsing dates involving a day of month without a year specified is ambiguous\\nand fails to parse leap day. The default behavior will change in Python 3.15\\nto either always raise an exception or to use a different default year (TBD).\\nTo avoid trouble, add a specific year to the input & format.\\nSee https://github.com/python/cpython/issues/70647.')]), (datetime.datetime(1984, 2, 29, 0, 0), []), (datetime.datetime(1900, 10, 21, 0, 0), []))" .
chx:X_YearlessParsing rd:hasIOExample chx:IO_YearlessParsing .
chx:X_IsoFormats a owl:NamedIndividual, chx:IsoFormats ; rdfs:label "datetime.isoformat()"@en ; skos:definition "ISO 8601 and RFC 3339 write 2026-10-21T16:29:07+00:00 and with Z for zero offset; isoformat writes it and fromisoformat reads it, accepting Z since Python 3.11, the basic form 20261021T162907+0300 and the week date 2026-W43-3, and raising ValueError for 21/10/2026."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_IsoFormats a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndt=DT(2026,10,21,16,29,7,123456,tzinfo=UTC)\\nout=(dt.isoformat(), dt.isoformat(timespec=\\'seconds\\'), DT.fromisoformat(\\'2026-10-21T16:29:07Z\\'), DT.fromisoformat(\\'20261021T162907+0300\\'), DT.fromisoformat(\\'2026-10-21 16:29\\'), D.fromisoformat(\\'2026-W43-3\\'), err(lambda: DT.fromisoformat(\\'21/10/2026\\')), DT(2026,10,21,16,29).isoformat(), str(DT(2026,10,21,16,29)), DT(2026,10,21,16,29,7,tzinfo=UTC).isoformat().replace(\\'+00:00\\',\\'Z\\'))', g), g['out'])[1])({}) evaluates to ('2026-10-21T16:29:07.123456+00:00', '2026-10-21T16:29:07+00:00', datetime.datetime(2026, 10, 21, 16, 29, 7, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 10, 21, 16, 29, 7, tzinfo=datetime.timezone(datetime.timedelta(seconds=10800))), datetime.datetime(2026, 10, 21, 16, 29), datetime.date(2026, 10, 21), ('ValueError', 'Invalid isoformat string: '21/10/2026''), '2026-10-21T16:29:00', '2026-10-21 16:29:00', '2026-10-21T16:29:07Z')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndt=DT(2026,10,21,16,29,7,123456,tzinfo=UTC)\\nout=(dt.isoformat(), dt.isoformat(timespec=\\'seconds\\'), DT.fromisoformat(\\'2026-10-21T16:29:07Z\\'), DT.fromisoformat(\\'20261021T162907+0300\\'), DT.fromisoformat(\\'2026-10-21 16:29\\'), D.fromisoformat(\\'2026-W43-3\\'), err(lambda: DT.fromisoformat(\\'21/10/2026\\')), DT(2026,10,21,16,29).isoformat(), str(DT(2026,10,21,16,29)), DT(2026,10,21,16,29,7,tzinfo=UTC).isoformat().replace(\\'+00:00\\',\\'Z\\'))', g), g['out'])[1])({})" ; chx:output "('2026-10-21T16:29:07.123456+00:00', '2026-10-21T16:29:07+00:00', datetime.datetime(2026, 10, 21, 16, 29, 7, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 10, 21, 16, 29, 7, tzinfo=datetime.timezone(datetime.timedelta(seconds=10800))), datetime.datetime(2026, 10, 21, 16, 29), datetime.date(2026, 10, 21), ('ValueError', 'Invalid isoformat string: '21/10/2026''), '2026-10-21T16:29:00', '2026-10-21 16:29:00', '2026-10-21T16:29:07Z')" .
chx:X_IsoFormats rd:hasIOExample chx:IO_IsoFormats .
chx:X_NaiveVersusAware a owl:NamedIndividual, chx:NaiveVersusAware ; rdfs:label "datetime.now(datetime.UTC)"@en ; skos:definition "A datetime without a tzinfo is naive and one with a tzinfo is aware; a naive and an aware value are never equal, comparing them or subtracting one from the other raises TypeError, 16:29 UTC equals 19:29 in Istanbul because they are one instant, and replace(tzinfo=UTC) labels a naive value without moving it."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_NaiveVersusAware a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nn=DT(2026,10,21,16,29); a=DT(2026,10,21,16,29,tzinfo=UTC); a2=DT(2026,10,21,19,29,tzinfo=ZoneInfo(\\'Europe/Istanbul\\'))\\nout = (n==a, err(lambda: n<a), err(lambda: n-a), a==a2, a2.utcoffset(), n.replace(tzinfo=UTC)==a, n.tzinfo, a.tzinfo)', g), g['out'])[1])({}) evaluates to (False, ('TypeError', 'can't compare offset-naive and offset-aware datetimes'), ('TypeError', 'can't subtract offset-naive and offset-aware datetimes'), True, datetime.timedelta(seconds=10800), True, None, datetime.timezone.utc)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nn=DT(2026,10,21,16,29); a=DT(2026,10,21,16,29,tzinfo=UTC); a2=DT(2026,10,21,19,29,tzinfo=ZoneInfo(\\'Europe/Istanbul\\'))\\nout = (n==a, err(lambda: n<a), err(lambda: n-a), a==a2, a2.utcoffset(), n.replace(tzinfo=UTC)==a, n.tzinfo, a.tzinfo)', g), g['out'])[1])({})" ; chx:output "(False, ('TypeError', 'can't compare offset-naive and offset-aware datetimes'), ('TypeError', 'can't subtract offset-naive and offset-aware datetimes'), True, datetime.timedelta(seconds=10800), True, None, datetime.timezone.utc)" .
chx:X_NaiveVersusAware rd:hasIOExample chx:IO_NaiveVersusAware .
chx:X_UtcnowDeprecated a owl:NamedIndividual, chx:UtcnowDeprecated ; rdfs:label "datetime.utcnow()"@en ; skos:definition "datetime.utcnow() and utcfromtimestamp() return naive values and have drawn a DeprecationWarning since Python 3.12; because the result is naive, treating it as local time shifts it by the offset of the zone, here -3.0 hours in Istanbul, and datetime.now(datetime.UTC) is the aware replacement."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_UtcnowDeprecated a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nv=warned(lambda: (DT.utcnow().tzinfo, DT.utcfromtimestamp(0)))\\nb=child(\\x22import datetime,warnings; warnings.simplefilter(\\'ignore\\'); u=datetime.datetime.utcnow(); print(u.timestamp()-datetime.datetime.now(datetime.UTC).timestamp())\\x22, TZ=\\'Europe/Istanbul\\')\\nout=(v[0], v[1], warned(lambda: DT.now(UTC).tzinfo)[1], DT.fromtimestamp(0, UTC), UTC is timezone.utc, round(float(b)/3600,2))', g), g['out'])[1])({}) evaluates to ((None, datetime.datetime(1970, 1, 1, 0, 0)), [('DeprecationWarning', 'datetime.datetime.utcnow() is deprecated and scheduled for removal in a future version. Use timezone-aware objects to represent datetimes in UTC: datetime.datetime.now(datetime.UTC).'), ('DeprecationWarning', 'datetime.datetime.utcfromtimestamp() is deprecated and scheduled for removal in a future version. Use timezone-aware objects to represent datetimes in UTC: datetime.datetime.fromtimestamp(timestamp, datetime.UTC).')], [], datetime.datetime(1970, 1, 1, 0, 0, tzinfo=datetime.timezone.utc), True, -3.0)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nv=warned(lambda: (DT.utcnow().tzinfo, DT.utcfromtimestamp(0)))\\nb=child(\\x22import datetime,warnings; warnings.simplefilter(\\'ignore\\'); u=datetime.datetime.utcnow(); print(u.timestamp()-datetime.datetime.now(datetime.UTC).timestamp())\\x22, TZ=\\'Europe/Istanbul\\')\\nout=(v[0], v[1], warned(lambda: DT.now(UTC).tzinfo)[1], DT.fromtimestamp(0, UTC), UTC is timezone.utc, round(float(b)/3600,2))', g), g['out'])[1])({})" ; chx:output "((None, datetime.datetime(1970, 1, 1, 0, 0)), [('DeprecationWarning', 'datetime.datetime.utcnow() is deprecated and scheduled for removal in a future version. Use timezone-aware objects to represent datetimes in UTC: datetime.datetime.now(datetime.UTC).'), ('DeprecationWarning', 'datetime.datetime.utcfromtimestamp() is deprecated and scheduled for removal in a future version. Use timezone-aware objects to represent datetimes in UTC: datetime.datetime.fromtimestamp(timestamp, datetime.UTC).')], [], datetime.datetime(1970, 1, 1, 0, 0, tzinfo=datetime.timezone.utc), True, -3.0)" .
chx:X_UtcnowDeprecated rd:hasIOExample chx:IO_UtcnowDeprecated .
chx:X_ZoneInfoZones a owl:NamedIndividual, chx:ZoneInfoZones ; rdfs:label "ZoneInfo('America/Los_Angeles')"@en ; skos:definition "The zoneinfo module attaches an IANA zone with its daylight saving rules to a datetime: Los Angeles is -07:00 PDT on 1 July 2026 and -08:00 PST on 1 January, Istanbul is +03:00 all year since 2016, and the data come from the system's zoneinfo directory or from the tzdata package, so without both ZoneInfo raises ZoneInfoNotFoundError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ZoneInfoZones a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport importlib.metadata as md\\nla=ZoneInfo(\\'America/Los_Angeles\\'); ist=ZoneInfo(\\'Europe/Istanbul\\')\\nd=DT(2026,7,1,12,tzinfo=la)\\nr=subprocess.run([sys.executable,\\'-S\\',\\'-c\\',\\x22import zoneinfo; zoneinfo.ZoneInfo(\\'Europe/Istanbul\\')\\x22],env=dict(os.environ,PYTHONTZPATH=\\'/nonexistent\\'),capture_output=True,text=True)\\nout=(d.utcoffset(), d.tzname(), DT(2026,1,1,12,tzinfo=la).utcoffset(), DT(2026,1,1,12,tzinfo=la).tzname(), ist.utcoffset(DT(2026,7,1)), ist.utcoffset(DT(2015,7,1)), ist.utcoffset(DT(2017,1,1)), la.key, md.version(\\'tzdata\\'), zoneinfo.TZPATH[:2], len(zoneinfo.available_timezones())>400, r.stderr.strip().splitlines()[-1])', g), g['out'])[1])({}) evaluates to (datetime.timedelta(days=-1, seconds=61200), 'PDT', datetime.timedelta(days=-1, seconds=57600), 'PST', datetime.timedelta(seconds=10800), datetime.timedelta(seconds=10800), datetime.timedelta(seconds=10800), 'America/Los_Angeles', '2026.5', ('/usr/share/zoneinfo', '/usr/lib/zoneinfo'), True, 'zoneinfo._common.ZoneInfoNotFoundError: 'No time zone found with key Europe/Istanbul'')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport importlib.metadata as md\\nla=ZoneInfo(\\'America/Los_Angeles\\'); ist=ZoneInfo(\\'Europe/Istanbul\\')\\nd=DT(2026,7,1,12,tzinfo=la)\\nr=subprocess.run([sys.executable,\\'-S\\',\\'-c\\',\\x22import zoneinfo; zoneinfo.ZoneInfo(\\'Europe/Istanbul\\')\\x22],env=dict(os.environ,PYTHONTZPATH=\\'/nonexistent\\'),capture_output=True,text=True)\\nout=(d.utcoffset(), d.tzname(), DT(2026,1,1,12,tzinfo=la).utcoffset(), DT(2026,1,1,12,tzinfo=la).tzname(), ist.utcoffset(DT(2026,7,1)), ist.utcoffset(DT(2015,7,1)), ist.utcoffset(DT(2017,1,1)), la.key, md.version(\\'tzdata\\'), zoneinfo.TZPATH[:2], len(zoneinfo.available_timezones())>400, r.stderr.strip().splitlines()[-1])', g), g['out'])[1])({})" ; chx:output "(datetime.timedelta(days=-1, seconds=61200), 'PDT', datetime.timedelta(days=-1, seconds=57600), 'PST', datetime.timedelta(seconds=10800), datetime.timedelta(seconds=10800), datetime.timedelta(seconds=10800), 'America/Los_Angeles', '2026.5', ('/usr/share/zoneinfo', '/usr/lib/zoneinfo'), True, 'zoneinfo._common.ZoneInfoNotFoundError: 'No time zone found with key Europe/Istanbul'')" .
chx:X_ZoneInfoZones rd:hasIOExample chx:IO_ZoneInfoZones .
chx:X_FromTimestampZones a owl:NamedIndividual, chx:FromTimestampZones ; rdfs:label "datetime.datetime.fromtimestamp(1000000)"@en ; skos:definition "fromtimestamp(1000000) with no zone uses the local zone of the process, so it prints 05:46:40 in Los Angeles, 13:46:40 in UTC and 15:46:40 in Istanbul, which was UTC+02:00 in 1970; the local zone is read from TZ or the system, and time.tzset() changes it while the program runs."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_FromTimestampZones a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nla=ZoneInfo(\\'America/Los_Angeles\\'); ist=ZoneInfo(\\'Europe/Istanbul\\')\\nc=\\x22import time, datetime; print(time.strftime(\\'%Z %z\\', time.localtime(1791841200)), datetime.datetime.fromtimestamp(1791841200).isoformat())\\x22\\nos.environ[\\'TZ\\']=\\'Asia/Kolkata\\'; time.tzset(); t1=time.strftime(\\'%H:%M %Z\\', time.localtime(1791841200)); os.environ[\\'TZ\\']=\\'UTC\\'; time.tzset(); t2=time.strftime(\\'%H:%M %Z\\', time.localtime(1791841200))\\nout=([DT.fromtimestamp(1000000, z).isoformat() for z in (UTC, la, ist)], [child(\\x22import datetime; print(repr(datetime.datetime.fromtimestamp(1000000)))\\x22, TZ=z) for z in (\\'America/Los_Angeles\\',\\'UTC\\',\\'Europe/Istanbul\\')], [child(c, TZ=z) for z in (\\'UTC\\',\\'Europe/Istanbul\\',\\'America/Los_Angeles\\',\\'Asia/Kolkata\\')], t1, t2)', g), g['out'])[1])({}) evaluates to (['1970-01-12T13:46:40+00:00', '1970-01-12T05:46:40-08:00', '1970-01-12T15:46:40+02:00'], ['datetime.datetime(1970, 1, 12, 5, 46, 40)', 'datetime.datetime(1970, 1, 12, 13, 46, 40)', 'datetime.datetime(1970, 1, 12, 15, 46, 40)'], ['UTC +0000 2026-10-12T21:40:00', '+03 +0300 2026-10-13T00:40:00', 'PDT -0700 2026-10-12T14:40:00', 'IST +0530 2026-10-13T03:10:00'], '03:10 IST', '21:40 UTC')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nla=ZoneInfo(\\'America/Los_Angeles\\'); ist=ZoneInfo(\\'Europe/Istanbul\\')\\nc=\\x22import time, datetime; print(time.strftime(\\'%Z %z\\', time.localtime(1791841200)), datetime.datetime.fromtimestamp(1791841200).isoformat())\\x22\\nos.environ[\\'TZ\\']=\\'Asia/Kolkata\\'; time.tzset(); t1=time.strftime(\\'%H:%M %Z\\', time.localtime(1791841200)); os.environ[\\'TZ\\']=\\'UTC\\'; time.tzset(); t2=time.strftime(\\'%H:%M %Z\\', time.localtime(1791841200))\\nout=([DT.fromtimestamp(1000000, z).isoformat() for z in (UTC, la, ist)], [child(\\x22import datetime; print(repr(datetime.datetime.fromtimestamp(1000000)))\\x22, TZ=z) for z in (\\'America/Los_Angeles\\',\\'UTC\\',\\'Europe/Istanbul\\')], [child(c, TZ=z) for z in (\\'UTC\\',\\'Europe/Istanbul\\',\\'America/Los_Angeles\\',\\'Asia/Kolkata\\')], t1, t2)', g), g['out'])[1])({})" ; chx:output "(['1970-01-12T13:46:40+00:00', '1970-01-12T05:46:40-08:00', '1970-01-12T15:46:40+02:00'], ['datetime.datetime(1970, 1, 12, 5, 46, 40)', 'datetime.datetime(1970, 1, 12, 13, 46, 40)', 'datetime.datetime(1970, 1, 12, 15, 46, 40)'], ['UTC +0000 2026-10-12T21:40:00', '+03 +0300 2026-10-13T00:40:00', 'PDT -0700 2026-10-12T14:40:00', 'IST +0530 2026-10-13T03:10:00'], '03:10 IST', '21:40 UTC')" .
chx:X_FromTimestampZones rd:hasIOExample chx:IO_FromTimestampZones .
chx:X_PstVersusPdt a owl:NamedIndividual, chx:PstVersusPdt ; rdfs:label "time.ctime()"@en ; skos:definition "On 17 March 2026 Los Angeles keeps daylight saving time (since 8 March), so 06:04:35 UTC is 23:04:35 PDT at -07:00, not Pacific Standard Time as the chapter says, and time.ctime prints the same instant as 'Tue Mar 17 23:04:35 2026' in Los Angeles, 'Wed Mar 18 06:04:35 2026' in UTC and 'Wed Mar 18 09:04:35 2026' in Istanbul."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PstVersusPdt a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nla=ZoneInfo(\\'America/Los_Angeles\\'); d=DT.fromtimestamp(1773813875.3518236, la)\\ncc=\\x22import time; print(time.ctime(1773813875))\\x22\\nout=(d.isoformat(timespec=\\'seconds\\'), d.tzname(), d.utcoffset(), d.dst(), DT(2026,3,8,3,0,tzinfo=la).tzname(), DT(2026,3,8,1,59,tzinfo=la).tzname(), DT(2026,3,17).strftime(\\'%A\\'), time.asctime(time.gmtime(1773813875)), child(cc, TZ=\\'America/Los_Angeles\\'), child(cc, TZ=\\'UTC\\'), child(cc, TZ=\\'Europe/Istanbul\\'))', g), g['out'])[1])({}) evaluates to ('2026-03-17T23:04:35-07:00', 'PDT', datetime.timedelta(days=-1, seconds=61200), datetime.timedelta(seconds=3600), 'PDT', 'PST', 'Tuesday', 'Wed Mar 18 06:04:35 2026', 'Tue Mar 17 23:04:35 2026', 'Wed Mar 18 06:04:35 2026', 'Wed Mar 18 09:04:35 2026')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nla=ZoneInfo(\\'America/Los_Angeles\\'); d=DT.fromtimestamp(1773813875.3518236, la)\\ncc=\\x22import time; print(time.ctime(1773813875))\\x22\\nout=(d.isoformat(timespec=\\'seconds\\'), d.tzname(), d.utcoffset(), d.dst(), DT(2026,3,8,3,0,tzinfo=la).tzname(), DT(2026,3,8,1,59,tzinfo=la).tzname(), DT(2026,3,17).strftime(\\'%A\\'), time.asctime(time.gmtime(1773813875)), child(cc, TZ=\\'America/Los_Angeles\\'), child(cc, TZ=\\'UTC\\'), child(cc, TZ=\\'Europe/Istanbul\\'))', g), g['out'])[1])({})" ; chx:output "('2026-03-17T23:04:35-07:00', 'PDT', datetime.timedelta(days=-1, seconds=61200), datetime.timedelta(seconds=3600), 'PDT', 'PST', 'Tuesday', 'Wed Mar 18 06:04:35 2026', 'Tue Mar 17 23:04:35 2026', 'Wed Mar 18 06:04:35 2026', 'Wed Mar 18 09:04:35 2026')" .
chx:X_PstVersusPdt rd:hasIOExample chx:IO_PstVersusPdt .
chx:X_WallClockArithmetic a owl:NamedIndividual, chx:WallClockArithmetic ; rdfs:label "aware_datetime + timedelta(days=1)"@en ; skos:definition "Adding a timedelta to an aware datetime moves the wall-clock reading and keeps the zone: noon on 7 March 2026 in New York plus one day is noon on 8 March, but the two moments are 82800 seconds, 23 hours, apart in UTC, and the subtraction of two values in one zone ignores the change of offset."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_WallClockArithmetic a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nny=ZoneInfo(\\'America/New_York\\'); a=DT(2026,3,7,12,0,tzinfo=ny); b=a+TD(days=1)\\nout=(a.isoformat(), b.isoformat(), (b.astimezone(UTC)-a.astimezone(UTC)), (b-a), (a.astimezone(UTC)+TD(days=1)).astimezone(ny).isoformat(), (a+TD(hours=24)).isoformat())', g), g['out'])[1])({}) evaluates to ('2026-03-07T12:00:00-05:00', '2026-03-08T12:00:00-04:00', datetime.timedelta(seconds=82800), datetime.timedelta(days=1), '2026-03-08T13:00:00-04:00', '2026-03-08T12:00:00-04:00')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nny=ZoneInfo(\\'America/New_York\\'); a=DT(2026,3,7,12,0,tzinfo=ny); b=a+TD(days=1)\\nout=(a.isoformat(), b.isoformat(), (b.astimezone(UTC)-a.astimezone(UTC)), (b-a), (a.astimezone(UTC)+TD(days=1)).astimezone(ny).isoformat(), (a+TD(hours=24)).isoformat())', g), g['out'])[1])({})" ; chx:output "('2026-03-07T12:00:00-05:00', '2026-03-08T12:00:00-04:00', datetime.timedelta(seconds=82800), datetime.timedelta(days=1), '2026-03-08T13:00:00-04:00', '2026-03-08T12:00:00-04:00')" .
chx:X_WallClockArithmetic rd:hasIOExample chx:IO_WallClockArithmetic .
chx:X_GapAndFold a owl:NamedIndividual, chx:GapAndFold ; rdfs:label "datetime(2026, 11, 1, 1, 30, fold=1)"@en ; skos:definition "When clocks go forward, 02:30 on 8 March 2026 in New York does not exist and converts to 03:30 EDT; when they go back, 01:30 on 1 November 2026 happens twice, fold=0 meaning the first, 05:30 UTC, and fold=1 the second, 06:30 UTC, although the two values compare equal."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_GapAndFold a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nny=ZoneInfo(\\'America/New_York\\')\\ng=DT(2026,3,8,2,30,tzinfo=ny); f0=DT(2026,11,1,1,30,tzinfo=ny); f1=f0.replace(fold=1)\\nout=(g.isoformat(), g.astimezone(UTC).isoformat(), g.astimezone(UTC).astimezone(ny).isoformat(), f0.isoformat(), f1.isoformat(), f0==f1, f0.astimezone(UTC).isoformat(), f1.astimezone(UTC).isoformat(), (f1.astimezone(UTC)-f0.astimezone(UTC)), (f1-f0))', g), g['out'])[1])({}) evaluates to ('2026-03-08T02:30:00-05:00', '2026-03-08T07:30:00+00:00', '2026-03-08T03:30:00-04:00', '2026-11-01T01:30:00-04:00', '2026-11-01T01:30:00-05:00', True, '2026-11-01T05:30:00+00:00', '2026-11-01T06:30:00+00:00', datetime.timedelta(seconds=3600), datetime.timedelta(0))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nny=ZoneInfo(\\'America/New_York\\')\\ng=DT(2026,3,8,2,30,tzinfo=ny); f0=DT(2026,11,1,1,30,tzinfo=ny); f1=f0.replace(fold=1)\\nout=(g.isoformat(), g.astimezone(UTC).isoformat(), g.astimezone(UTC).astimezone(ny).isoformat(), f0.isoformat(), f1.isoformat(), f0==f1, f0.astimezone(UTC).isoformat(), f1.astimezone(UTC).isoformat(), (f1.astimezone(UTC)-f0.astimezone(UTC)), (f1-f0))', g), g['out'])[1])({})" ; chx:output "('2026-03-08T02:30:00-05:00', '2026-03-08T07:30:00+00:00', '2026-03-08T03:30:00-04:00', '2026-11-01T01:30:00-04:00', '2026-11-01T01:30:00-05:00', True, '2026-11-01T05:30:00+00:00', '2026-11-01T06:30:00+00:00', datetime.timedelta(seconds=3600), datetime.timedelta(0))" .
chx:X_GapAndFold rd:hasIOExample chx:IO_GapAndFold .
chx:X_Year2038 a owl:NamedIndividual, chx:Year2038 ; rdfs:label "2**31"@en ; skos:definition "A signed 32-bit time_t counts to 2147483647, 03:14:07 UTC on 19 January 2038, and 2**31 wraps to -2147483648, which is 20:45:52 UTC on 13 December 1901; a 64-bit value reaches datetime's year 9999 and negative timestamps are dates before 1970."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_Year2038 a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nt=2**31\\npacked=struct.pack(\\'<I\\', t); wrapped=struct.unpack(\\'<i\\', packed)[0]\\nout=(DT.fromtimestamp(t-1, UTC).isoformat(), DT.fromtimestamp(t, UTC).isoformat(), wrapped, DT.fromtimestamp(wrapped, UTC).isoformat(), time.gmtime(2**40)[0], DT.fromtimestamp(253402300799, UTC).isoformat(), err(lambda: DT.fromtimestamp(253402300800, UTC)), struct.calcsize(\\'l\\'), struct.calcsize(\\'q\\'), DT.fromtimestamp(-1, UTC).isoformat(), DT.fromtimestamp(-86400*365*100, UTC).isoformat(), err(lambda: DT.fromtimestamp(-62135596801, UTC)))', g), g['out'])[1])({}) evaluates to ('2038-01-19T03:14:07+00:00', '2038-01-19T03:14:08+00:00', -2147483648, '1901-12-13T20:45:52+00:00', 36812, '9999-12-31T23:59:59+00:00', ('ValueError', 'year must be in 1..9999, not 10000'), 8, 8, '1969-12-31T23:59:59+00:00', '1870-01-25T00:00:00+00:00', ('ValueError', 'year must be in 1..9999, not 0'))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nt=2**31\\npacked=struct.pack(\\'<I\\', t); wrapped=struct.unpack(\\'<i\\', packed)[0]\\nout=(DT.fromtimestamp(t-1, UTC).isoformat(), DT.fromtimestamp(t, UTC).isoformat(), wrapped, DT.fromtimestamp(wrapped, UTC).isoformat(), time.gmtime(2**40)[0], DT.fromtimestamp(253402300799, UTC).isoformat(), err(lambda: DT.fromtimestamp(253402300800, UTC)), struct.calcsize(\\'l\\'), struct.calcsize(\\'q\\'), DT.fromtimestamp(-1, UTC).isoformat(), DT.fromtimestamp(-86400*365*100, UTC).isoformat(), err(lambda: DT.fromtimestamp(-62135596801, UTC)))', g), g['out'])[1])({})" ; chx:output "('2038-01-19T03:14:07+00:00', '2038-01-19T03:14:08+00:00', -2147483648, '1901-12-13T20:45:52+00:00', 36812, '9999-12-31T23:59:59+00:00', ('ValueError', 'year must be in 1..9999, not 10000'), 8, 8, '1969-12-31T23:59:59+00:00', '1870-01-25T00:00:00+00:00', ('ValueError', 'year must be in 1..9999, not 0'))" .
chx:X_Year2038 rd:hasIOExample chx:IO_Year2038 .
chx:X_DatetimeRange a owl:NamedIndividual, chx:DatetimeRange ; rdfs:label "datetime.date.max"@en ; skos:definition "The datetime types run from 1 January of the year 1 to 31 December 9999, date.max is 9999-12-31, and arithmetic beyond either end raises OverflowError ('date value out of range') instead of wrapping."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DatetimeRange a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(D.min, D.max, DT.max, err(lambda: DT.max+TD(microseconds=1)), err(lambda: DT.min-TD(days=1)), err(lambda: D(1,1,1)-TD(days=1)), D(1,1,1).weekday(), D(1,1,1).toordinal(), D.fromordinal(1))', g), g['out'])[1])({}) evaluates to (datetime.date(1, 1, 1), datetime.date(9999, 12, 31), datetime.datetime(9999, 12, 31, 23, 59, 59, 999999), ('OverflowError', 'date value out of range'), ('OverflowError', 'date value out of range'), ('OverflowError', 'date value out of range'), 0, 1, datetime.date(1, 1, 1))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(D.min, D.max, DT.max, err(lambda: DT.max+TD(microseconds=1)), err(lambda: DT.min-TD(days=1)), err(lambda: D(1,1,1)-TD(days=1)), D(1,1,1).weekday(), D(1,1,1).toordinal(), D.fromordinal(1))', g), g['out'])[1])({})" ; chx:output "(datetime.date(1, 1, 1), datetime.date(9999, 12, 31), datetime.datetime(9999, 12, 31, 23, 59, 59, 999999), ('OverflowError', 'date value out of range'), ('OverflowError', 'date value out of range'), ('OverflowError', 'date value out of range'), 0, 1, datetime.date(1, 1, 1))" .
chx:X_DatetimeRange rd:hasIOExample chx:IO_DatetimeRange .
chx:X_GregorianCalendar a owl:NamedIndividual, chx:GregorianCalendar ; rdfs:label "datetime.date(1582, 10, 5)"@en ; skos:definition "Python's date uses the Gregorian rules for every year, so 5 October 1582, a day that did not exist in the countries that adopted the calendar then, is a Tuesday in Python, 1900 and 2100 are not leap years, 2000 is, the years 1 to 9999 hold 2424 leap years and 3,652,059 days."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_GregorianCalendar a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(D(1582,10,5).strftime(\\'%A %d %B %Y\\'), D(1582,10,4).toordinal()+1==D(1582,10,5).toordinal(), calendar.isleap(1900), calendar.isleap(2000), calendar.isleap(2024), calendar.isleap(2100), calendar.monthrange(2026,2), sum(calendar.isleap(y) for y in range(1,10000)), 365*9999+sum(calendar.isleap(y) for y in range(1,10000)))', g), g['out'])[1])({}) evaluates to ('Tuesday 05 October 1582', True, False, True, True, False, (calendar.SUNDAY, 28), 2424, 3652059)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(D(1582,10,5).strftime(\\'%A %d %B %Y\\'), D(1582,10,4).toordinal()+1==D(1582,10,5).toordinal(), calendar.isleap(1900), calendar.isleap(2000), calendar.isleap(2024), calendar.isleap(2100), calendar.monthrange(2026,2), sum(calendar.isleap(y) for y in range(1,10000)), 365*9999+sum(calendar.isleap(y) for y in range(1,10000)))', g), g['out'])[1])({})" ; chx:output "('Tuesday 05 October 1582', True, False, True, True, False, (calendar.SUNDAY, 28), 2424, 3652059)" .
chx:X_GregorianCalendar rd:hasIOExample chx:IO_GregorianCalendar .
chx:X_RunWaits a owl:NamedIndividual, chx:RunWaits ; rdfs:label "subprocess.run(['C:\\\\Windows\\\\System32\\\\calc.exe'])"@en ; skos:definition "subprocess.run starts the program, waits until it ends and returns a CompletedProcess that records the arguments and the return code, which prints as CompletedProcess(args=['sleep', '0.3'], returncode=0); capture_output adds stdout and stderr to the repr."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_RunWaits a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nt=time.monotonic(); r=subprocess.run([\\'sleep\\',\\'0.3\\']); e=time.monotonic()-t\\nr2=subprocess.run([sys.executable,\\'-c\\',\\'print(\\x22hi\\x22)\\'], capture_output=True, text=True)\\nout=(r, r.returncode, r.args, e>=0.3, type(r).__name__, r.stdout, r.stderr, repr(r2).replace(sys.executable,\\'PY\\'), subprocess.run([\\'true\\']), subprocess.run([\\'false\\']))', g), g['out'])[1])({}) evaluates to (CompletedProcess(args=['sleep', '0.3'], returncode=0), 0, ['sleep', '0.3'], True, 'CompletedProcess', None, None, 'CompletedProcess(args=[\\'PY\\', \\'-c\\', \\'print('hi')\\'], returncode=0, stdout=\\'hi\\\\n\\', stderr=\\'\\')', CompletedProcess(args=['true'], returncode=0), CompletedProcess(args=['false'], returncode=1))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nt=time.monotonic(); r=subprocess.run([\\'sleep\\',\\'0.3\\']); e=time.monotonic()-t\\nr2=subprocess.run([sys.executable,\\'-c\\',\\'print(\\x22hi\\x22)\\'], capture_output=True, text=True)\\nout=(r, r.returncode, r.args, e>=0.3, type(r).__name__, r.stdout, r.stderr, repr(r2).replace(sys.executable,\\'PY\\'), subprocess.run([\\'true\\']), subprocess.run([\\'false\\']))', g), g['out'])[1])({})" ; chx:output "(CompletedProcess(args=['sleep', '0.3'], returncode=0), 0, ['sleep', '0.3'], True, 'CompletedProcess', None, None, 'CompletedProcess(args=[\\'PY\\', \\'-c\\', \\'print('hi')\\'], returncode=0, stdout=\\'hi\\\\n\\', stderr=\\'\\')', CompletedProcess(args=['true'], returncode=0), CompletedProcess(args=['false'], returncode=1))" .
chx:X_RunWaits rd:hasIOExample chx:IO_RunWaits .
chx:X_PopenNoWait a owl:NamedIndividual, chx:PopenNoWait ; rdfs:label "calc_proc = subprocess.Popen([...])"@en ; skos:definition "subprocess.Popen returns at once with a Popen object; poll() returns None while the process runs and its return code after, wait() blocks until it ends, and wait(timeout=0.1) on a process that runs longer raises TimeoutExpired."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PopenNoWait a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nt=time.monotonic(); p=subprocess.Popen([\\'sleep\\',\\'0.4\\']); back=time.monotonic()-t\\npolls=[p.poll()]; code=p.wait(); polls.append(p.poll())\\nq=subprocess.Popen([\\'sleep\\',\\'0.3\\']); first=q.poll() is None; n=0\\nwhile q.poll() is None: n+=1; time.sleep(0.01)\\nout=(back<0.2, polls, code, type(p).__name__, p.returncode, p.pid>0, first, n>3, q.wait(), err(lambda: subprocess.Popen([\\'sleep\\',\\'2\\']).wait(timeout=0.1)))', g), g['out'])[1])({}) evaluates to (True, [None, 0], 0, 'Popen', 0, True, True, True, 0, ('TimeoutExpired', 'Command '['sleep', '2']' timed out after 0.1 seconds'))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nt=time.monotonic(); p=subprocess.Popen([\\'sleep\\',\\'0.4\\']); back=time.monotonic()-t\\npolls=[p.poll()]; code=p.wait(); polls.append(p.poll())\\nq=subprocess.Popen([\\'sleep\\',\\'0.3\\']); first=q.poll() is None; n=0\\nwhile q.poll() is None: n+=1; time.sleep(0.01)\\nout=(back<0.2, polls, code, type(p).__name__, p.returncode, p.pid>0, first, n>3, q.wait(), err(lambda: subprocess.Popen([\\'sleep\\',\\'2\\']).wait(timeout=0.1)))', g), g['out'])[1])({})" ; chx:output "(True, [None, 0], 0, 'Popen', 0, True, True, True, 0, ('TimeoutExpired', 'Command '['sleep', '2']' timed out after 0.1 seconds'))" .
chx:X_PopenNoWait rd:hasIOExample chx:IO_PopenNoWait .
chx:X_CheckAndTimeout a owl:NamedIndividual, chx:CheckAndTimeout ; rdfs:label "subprocess.run(cmd, check=True, timeout=10)"@en ; skos:definition "run() does not raise for a program that fails unless check=True, which raises CalledProcessError with the return code; timeout kills the child and raises TimeoutExpired; a missing program raises FileNotFoundError and a directory PermissionError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CheckAndTimeout a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(err(lambda: subprocess.run([\\'false\\'],check=True)), err(lambda: subprocess.run([\\'sleep\\',\\'5\\'],timeout=0.2)), err(lambda: subprocess.run([\\'no-such-program-xyz\\'])), err(lambda: subprocess.run([\\'/etc\\'])), err(lambda: subprocess.run([\\'sh\\',\\'-c\\',\\'exit 2\\'],check=True)), issubclass(subprocess.CalledProcessError, subprocess.SubprocessError), issubclass(FileNotFoundError, OSError))', g), g['out'])[1])({}) evaluates to (('CalledProcessError', 'Command '['false']' returned non-zero exit status 1.'), ('TimeoutExpired', 'Command '['sleep', '5']' timed out after 0.2 seconds'), ('FileNotFoundError', '[Errno 2] No such file or directory: 'no-such-program-xyz''), ('PermissionError', '[Errno 13] Permission denied: '/etc''), ('CalledProcessError', 'Command '['sh', '-c', 'exit 2']' returned non-zero exit status 2.'), True, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(err(lambda: subprocess.run([\\'false\\'],check=True)), err(lambda: subprocess.run([\\'sleep\\',\\'5\\'],timeout=0.2)), err(lambda: subprocess.run([\\'no-such-program-xyz\\'])), err(lambda: subprocess.run([\\'/etc\\'])), err(lambda: subprocess.run([\\'sh\\',\\'-c\\',\\'exit 2\\'],check=True)), issubclass(subprocess.CalledProcessError, subprocess.SubprocessError), issubclass(FileNotFoundError, OSError))', g), g['out'])[1])({})" ; chx:output "(('CalledProcessError', 'Command '['false']' returned non-zero exit status 1.'), ('TimeoutExpired', 'Command '['sleep', '5']' timed out after 0.2 seconds'), ('FileNotFoundError', '[Errno 2] No such file or directory: 'no-such-program-xyz''), ('PermissionError', '[Errno 13] Permission denied: '/etc''), ('CalledProcessError', 'Command '['sh', '-c', 'exit 2']' returned non-zero exit status 2.'), True, True)" .
chx:X_CheckAndTimeout rd:hasIOExample chx:IO_CheckAndTimeout .
chx:X_ArgumentList a owl:NamedIndividual, chx:ArgumentList ; rdfs:label "subprocess.Popen(['notepad.exe', 'hello.txt'])"@en ; skos:definition "Each item of the list becomes one argument of the program with no shell in between, so 'my file.txt' with a space arrives as one argument and *.txt arrives as the text *.txt, unexpanded; shlex.split cuts a command line into such a list."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ArgumentList a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport ast\\nc=\\'import sys; print(sys.argv[1:])\\'\\nr=subprocess.run([sys.executable,\\'-c\\',\\'import sys; print(sys.argv)\\',\\'one\\',\\'two words\\'],capture_output=True,text=True)\\nout=(subprocess.run([sys.executable,\\'-c\\',c,\\'my file.txt\\',\\'a b\\',\\'--x=1\\'],capture_output=True,text=True).stdout.strip(), shlex.split(\\x22notepad \\'my file.txt\\' x\\x22), subprocess.run([sys.executable,\\'-c\\',c,\\'*.txt\\'],capture_output=True,text=True).stdout.strip(), r.stdout.strip(), len(ast.literal_eval(r.stdout)), subprocess.run([\\'sh\\',\\'-c\\',\\'echo \\x22$0|$1|$2\\x22\\',\\'zero\\',\\'one\\'],capture_output=True,text=True).stdout.strip())', g), g['out'])[1])({}) evaluates to ('['my file.txt', 'a b', '--x=1']', ['notepad', 'my file.txt', 'x'], '['*.txt']', '['-c', 'one', 'two words']', 3, 'zero|one|')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport ast\\nc=\\'import sys; print(sys.argv[1:])\\'\\nr=subprocess.run([sys.executable,\\'-c\\',\\'import sys; print(sys.argv)\\',\\'one\\',\\'two words\\'],capture_output=True,text=True)\\nout=(subprocess.run([sys.executable,\\'-c\\',c,\\'my file.txt\\',\\'a b\\',\\'--x=1\\'],capture_output=True,text=True).stdout.strip(), shlex.split(\\x22notepad \\'my file.txt\\' x\\x22), subprocess.run([sys.executable,\\'-c\\',c,\\'*.txt\\'],capture_output=True,text=True).stdout.strip(), r.stdout.strip(), len(ast.literal_eval(r.stdout)), subprocess.run([\\'sh\\',\\'-c\\',\\'echo \\x22$0|$1|$2\\x22\\',\\'zero\\',\\'one\\'],capture_output=True,text=True).stdout.strip())', g), g['out'])[1])({})" ; chx:output "('['my file.txt', 'a b', '--x=1']', ['notepad', 'my file.txt', 'x'], '['*.txt']', '['-c', 'one', 'two words']', 3, 'zero|one|')" .
chx:X_ArgumentList rd:hasIOExample chx:IO_ArgumentList .
chx:X_CaptureOutput a owl:NamedIndividual, chx:CaptureOutput ; rdfs:label "subprocess.run(['ping', '-n', '4', 'nostarch.com'], capture_output=True, text=True)"@en ; skos:definition "capture_output=True collects stdout and stderr, as bytes unless text=True makes them str, and cannot be combined with stdout=; the book's ping -n 4 is the Windows flag and exits 2 on Linux, where -c 2 sends two packets, here to 127.0.0.1 with no loss."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CaptureOutput a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nr=subprocess.run([sys.executable,\\'-c\\',\\'import sys; print(\\x22out\\x22); print(\\x22err\\x22, file=sys.stderr)\\'],capture_output=True)\\nt=subprocess.run([sys.executable,\\'-c\\',\\'import sys; print(\\x22out\\x22); print(\\x22err\\x22, file=sys.stderr)\\'],capture_output=True,text=True)\\na=subprocess.run([\\'ping\\',\\'-n\\',\\'4\\',\\'localhost\\'],capture_output=True,text=True); b=subprocess.run([\\'ping\\',\\'-c\\',\\'2\\',\\'-W\\',\\'2\\',\\'127.0.0.1\\'],capture_output=True,text=True)\\nout=(r.stdout, r.stderr, t.stdout, t.stderr, type(r.stdout).__name__, type(t.stdout).__name__, err(lambda: subprocess.run([\\'echo\\'],capture_output=True,stdout=subprocess.PIPE)), a.returncode, b.returncode, \\'2 received\\' in b.stdout, b.stdout.splitlines()[0].split(\\' (\\')[0], \\'0% packet loss\\' in b.stdout)', g), g['out'])[1])({}) evaluates to (b'out\\n', b'err\\n', 'out\\n', 'err\\n', 'bytes', 'str', ('ValueError', 'stdout and stderr arguments may not be used with capture_output.'), 2, 0, True, 'PING 127.0.0.1', True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nr=subprocess.run([sys.executable,\\'-c\\',\\'import sys; print(\\x22out\\x22); print(\\x22err\\x22, file=sys.stderr)\\'],capture_output=True)\\nt=subprocess.run([sys.executable,\\'-c\\',\\'import sys; print(\\x22out\\x22); print(\\x22err\\x22, file=sys.stderr)\\'],capture_output=True,text=True)\\na=subprocess.run([\\'ping\\',\\'-n\\',\\'4\\',\\'localhost\\'],capture_output=True,text=True); b=subprocess.run([\\'ping\\',\\'-c\\',\\'2\\',\\'-W\\',\\'2\\',\\'127.0.0.1\\'],capture_output=True,text=True)\\nout=(r.stdout, r.stderr, t.stdout, t.stderr, type(r.stdout).__name__, type(t.stdout).__name__, err(lambda: subprocess.run([\\'echo\\'],capture_output=True,stdout=subprocess.PIPE)), a.returncode, b.returncode, \\'2 received\\' in b.stdout, b.stdout.splitlines()[0].split(\\' (\\')[0], \\'0% packet loss\\' in b.stdout)', g), g['out'])[1])({})" ; chx:output "(b'out\\n', b'err\\n', 'out\\n', 'err\\n', 'bytes', 'str', ('ValueError', 'stdout and stderr arguments may not be used with capture_output.'), 2, 0, True, 'PING 127.0.0.1', True)" .
chx:X_CaptureOutput rd:hasIOExample chx:IO_CaptureOutput .
chx:X_ShellTrueList a owl:NamedIndividual, chx:ShellTrueList ; rdfs:label "subprocess.run(['start', 'hello.txt'], shell=True)"@en ; skos:definition "On Windows shell=True with a list hands the list to cmd.exe, whose start command opens the file; on POSIX the first item alone is the command string and the others become the shell's own arguments, so ['echo', 'hi', 'there'] prints an empty line and ['start', 'hello.txt'] exits 127 with 'start: not found'."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ShellTrueList a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(subprocess.run([\\'echo\\',\\'hi\\',\\'there\\'],shell=True,capture_output=True,text=True).stdout, subprocess.run(\\'echo hi there\\',shell=True,capture_output=True,text=True).stdout, subprocess.run([\\'start\\',\\'hello.txt\\'],shell=True,capture_output=True,text=True).returncode, subprocess.run([\\'start\\',\\'hello.txt\\'],shell=True,capture_output=True,text=True).stderr.strip().split(\\': \\',1)[1], shutil.which(\\'start\\'))', g), g['out'])[1])({}) evaluates to ('\\n', 'hi there\\n', 127, '1: start: not found', None)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(subprocess.run([\\'echo\\',\\'hi\\',\\'there\\'],shell=True,capture_output=True,text=True).stdout, subprocess.run(\\'echo hi there\\',shell=True,capture_output=True,text=True).stdout, subprocess.run([\\'start\\',\\'hello.txt\\'],shell=True,capture_output=True,text=True).returncode, subprocess.run([\\'start\\',\\'hello.txt\\'],shell=True,capture_output=True,text=True).stderr.strip().split(\\': \\',1)[1], shutil.which(\\'start\\'))', g), g['out'])[1])({})" ; chx:output "('\\n', 'hi there\\n', 127, '1: start: not found', None)" .
chx:X_ShellTrueList rd:hasIOExample chx:IO_ShellTrueList .
chx:X_ShellInjection a owl:NamedIndividual, chx:ShellInjection ; rdfs:label "f'echo opening {name}' with shell=True"@en ; skos:definition "A command string built from a file name and run with shell=True lets the name carry shell syntax: a name of 'x; echo INJECTED' runs a second command, while shlex.quote makes it one word and a list with no shell never interprets it."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ShellInjection a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nname=\\'x; echo INJECTED\\'\\na=subprocess.run(f\\'echo opening {name}\\',shell=True,capture_output=True,text=True).stdout\\nb=subprocess.run(f\\'echo opening {shlex.quote(name)}\\',shell=True,capture_output=True,text=True).stdout\\nc=subprocess.run([\\'echo\\',\\'opening\\',name],capture_output=True,text=True).stdout\\nout=(a,b,c,shlex.quote(name),shlex.quote(\\'plain.txt\\'))', g), g['out'])[1])({}) evaluates to ('opening x\\nINJECTED\\n', 'opening x; echo INJECTED\\n', 'opening x; echo INJECTED\\n', ''x; echo INJECTED'', 'plain.txt')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nname=\\'x; echo INJECTED\\'\\na=subprocess.run(f\\'echo opening {name}\\',shell=True,capture_output=True,text=True).stdout\\nb=subprocess.run(f\\'echo opening {shlex.quote(name)}\\',shell=True,capture_output=True,text=True).stdout\\nc=subprocess.run([\\'echo\\',\\'opening\\',name],capture_output=True,text=True).stdout\\nout=(a,b,c,shlex.quote(name),shlex.quote(\\'plain.txt\\'))', g), g['out'])[1])({})" ; chx:output "('opening x\\nINJECTED\\n', 'opening x; echo INJECTED\\n', 'opening x; echo INJECTED\\n', ''x; echo INJECTED'', 'plain.txt')" .
chx:X_ShellInjection rd:hasIOExample chx:IO_ShellInjection .
chx:X_ExitCodes a owl:NamedIndividual, chx:ExitCodes ; rdfs:label "proc.returncode"@en ; skos:definition "A program that ends normally returns 0, sys.exit(3) returns 3, an uncaught exception 1, sys.exit('msg') 1, os._exit(263) 7 because only the low 8 bits are kept, and a process killed by signal 9 or 15 shows as -9 or -15 in returncode."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ExitCodes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nc=lambda code: subprocess.run([sys.executable,\\'-c\\',code]).returncode\\nout=(c(\\'pass\\'), c(\\'import sys; sys.exit(3)\\'), c(\\'raise ValueError\\'), c(\\'import sys; sys.exit(\\x22msg\\x22)\\'), c(\\'import os; os._exit(256+7)\\'), c(\\'import os,signal; os.kill(os.getpid(), signal.SIGKILL)\\'), c(\\'import os,signal; os.kill(os.getpid(), signal.SIGTERM)\\'))', g), g['out'])[1])({}) evaluates to (0, 3, 1, 1, 7, -9, -15)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nc=lambda code: subprocess.run([sys.executable,\\'-c\\',code]).returncode\\nout=(c(\\'pass\\'), c(\\'import sys; sys.exit(3)\\'), c(\\'raise ValueError\\'), c(\\'import sys; sys.exit(\\x22msg\\x22)\\'), c(\\'import os; os._exit(256+7)\\'), c(\\'import os,signal; os.kill(os.getpid(), signal.SIGKILL)\\'), c(\\'import os,signal; os.kill(os.getpid(), signal.SIGTERM)\\'))', g), g['out'])[1])({})" ; chx:output "(0, 3, 1, 1, 7, -9, -15)" .
chx:X_ExitCodes rd:hasIOExample chx:IO_ExitCodes .
chx:X_TerminateVsKill a owl:NamedIndividual, chx:TerminateVsKill ; rdfs:label "proc.terminate(), proc.kill()"@en ; skos:definition "terminate() sends SIGTERM, which a program can handle to save its work and exit with 0, kill() sends SIGKILL, which cannot be handled and leaves return code -9, and signal.signal(SIGKILL, handler) raises OSError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TerminateVsKill a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ncode=\\x22import signal,time,sys\\\\nsignal.signal(signal.SIGTERM, lambda s,f: (print(\\'asked to stop, saving work\\', flush=True), sys.exit(0)))\\\\nprint(\\'ready\\', flush=True)\\\\ntime.sleep(30)\\x22\\np=subprocess.Popen([sys.executable,\\'-c\\',code], stdout=subprocess.PIPE, text=True); p.stdout.readline(); p.terminate(); o=p.communicate()[0]; a=(o.strip(), p.returncode)\\np=subprocess.Popen([sys.executable,\\'-c\\',code], stdout=subprocess.PIPE, text=True); p.stdout.readline(); p.kill(); o=p.communicate()[0]; b=(o.strip(), p.returncode)\\nout=(a,b, signal.SIGKILL.value, signal.SIGTERM.value, err(lambda: signal.signal(signal.SIGKILL, lambda *a: 0)))', g), g['out'])[1])({}) evaluates to (('asked to stop, saving work', 0), ('', -9), 9, 15, ('OSError', '[Errno 22] Invalid argument'))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ncode=\\x22import signal,time,sys\\\\nsignal.signal(signal.SIGTERM, lambda s,f: (print(\\'asked to stop, saving work\\', flush=True), sys.exit(0)))\\\\nprint(\\'ready\\', flush=True)\\\\ntime.sleep(30)\\x22\\np=subprocess.Popen([sys.executable,\\'-c\\',code], stdout=subprocess.PIPE, text=True); p.stdout.readline(); p.terminate(); o=p.communicate()[0]; a=(o.strip(), p.returncode)\\np=subprocess.Popen([sys.executable,\\'-c\\',code], stdout=subprocess.PIPE, text=True); p.stdout.readline(); p.kill(); o=p.communicate()[0]; b=(o.strip(), p.returncode)\\nout=(a,b, signal.SIGKILL.value, signal.SIGTERM.value, err(lambda: signal.signal(signal.SIGKILL, lambda *a: 0)))', g), g['out'])[1])({})" ; chx:output "(('asked to stop, saving work', 0), ('', -9), 9, 15, ('OSError', '[Errno 22] Invalid argument'))" .
chx:X_TerminateVsKill rd:hasIOExample chx:IO_TerminateVsKill .
chx:X_OpenCommand a owl:NamedIndividual, chx:OpenCommand ; rdfs:label "subprocess.run(['open', 'hello.txt'])"@en ; skos:definition "open is a macOS command; on this Ubuntu machine /usr/bin/open exists only because the xdg-utils package registers an alternative that points to xdg-open, and for a file that does not exist it exits 2 with a message from xdg-open; os.startfile is defined on Windows only."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_OpenCommand a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nr=subprocess.run([\\'open\\',\\'/nonexistent-file\\'],capture_output=True,text=True)\\nout=(shutil.which(\\'open\\'), os.path.realpath(shutil.which(\\'open\\')), shutil.which(\\'xdg-open\\'), r.returncode, r.stderr.strip().splitlines()[-1], hasattr(os,\\'startfile\\'), sys.platform, os.name)', g), g['out'])[1])({}) evaluates to ('/usr/bin/open', '/usr/bin/xdg-open', '/usr/bin/xdg-open', 2, 'xdg-open: file '/nonexistent-file' does not exist', False, 'linux', 'posix')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nr=subprocess.run([\\'open\\',\\'/nonexistent-file\\'],capture_output=True,text=True)\\nout=(shutil.which(\\'open\\'), os.path.realpath(shutil.which(\\'open\\')), shutil.which(\\'xdg-open\\'), r.returncode, r.stderr.strip().splitlines()[-1], hasattr(os,\\'startfile\\'), sys.platform, os.name)', g), g['out'])[1])({})" ; chx:output "('/usr/bin/open', '/usr/bin/xdg-open', '/usr/bin/xdg-open', 2, 'xdg-open: file '/nonexistent-file' does not exist', False, 'linux', 'posix')" .
chx:X_OpenCommand rd:hasIOExample chx:IO_OpenCommand .
chx:X_Webbrowser a owl:NamedIndividual, chx:Webbrowser ; rdfs:label "webbrowser.open(url)"@en ; skos:definition "webbrowser.open returns False and webbrowser.get() raises Error ('could not locate runnable browser') on a machine with no browser and no BROWSER variable, so the call must be checked on a server or in a container."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_Webbrowser a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport webbrowser\\nout=(webbrowser.open(\\'file:///nonexistent\\'), err(lambda: webbrowser.get()), webbrowser.open_new_tab.__name__, os.environ.get(\\'BROWSER\\'))', g), g['out'])[1])({}) evaluates to (False, ('Error', 'could not locate runnable browser'), 'open_new_tab', None)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport webbrowser\\nout=(webbrowser.open(\\'file:///nonexistent\\'), err(lambda: webbrowser.get()), webbrowser.open_new_tab.__name__, os.environ.get(\\'BROWSER\\'))', g), g['out'])[1])({})" ; chx:output "(False, ('Error', 'could not locate runnable browser'), 'open_new_tab', None)" .
chx:X_Webbrowser rd:hasIOExample chx:IO_Webbrowser .
chx:X_ClipboardAndSound a owl:NamedIndividual, chx:ClipboardAndSound ; rdfs:label "pyperclip.copy(text)"@en ; skos:definition "pyperclip 1.11.0 raises PyperclipException, a RuntimeError, when no copy and paste program such as xclip, xsel or wl-clipboard is installed, and playsound3 3.3.2, which replaces the book's pinned playsound3 2.4.0, exposes playsound(), backends and PlaysoundException."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ClipboardAndSound a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport pyperclip, playsound3, importlib.metadata as md\\ne=err(lambda: pyperclip.copy(\\'x\\'))\\nout=(md.version(\\'pyperclip\\'), e[0], e[1][:60], pyperclip.PyperclipException.__mro__[1].__name__, md.version(\\'playsound3\\'), sorted(n for n in dir(playsound3) if not n.startswith(\\'_\\'))[:8], hasattr(playsound3,\\'playsound\\'))', g), g['out'])[1])({}) evaluates to ('1.11.0', 'PyperclipException', 'Pyperclip could not find a copy/paste mechanism for your sys', 'RuntimeError', '3.3.2', ['AVAILABLE_BACKENDS', 'DEFAULT_BACKEND', 'PlaysoundException', 'backends', 'playsound', 'playsound3', 'prefer_backends'], True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport pyperclip, playsound3, importlib.metadata as md\\ne=err(lambda: pyperclip.copy(\\'x\\'))\\nout=(md.version(\\'pyperclip\\'), e[0], e[1][:60], pyperclip.PyperclipException.__mro__[1].__name__, md.version(\\'playsound3\\'), sorted(n for n in dir(playsound3) if not n.startswith(\\'_\\'))[:8], hasattr(playsound3,\\'playsound\\'))', g), g['out'])[1])({})" ; chx:output "('1.11.0', 'PyperclipException', 'Pyperclip could not find a copy/paste mechanism for your sys', 'RuntimeError', '3.3.2', ['AVAILABLE_BACKENDS', 'DEFAULT_BACKEND', 'PlaysoundException', 'backends', 'playsound', 'playsound3', 'prefer_backends'], True)" .
chx:X_ClipboardAndSound rd:hasIOExample chx:IO_ClipboardAndSound .
chx:X_CronFields a owl:NamedIndividual, chx:CronFields ; rdfs:label "30 9 * * 1-5"@en ; skos:definition "A crontab entry has five time fields, minute, hour, day of month, month and day of week, and the command; '30 9 * * 1-5' runs at 09:30 on weekdays, '*/15 * * * *' every quarter hour, and when both day fields are restricted a day matches if either does, so '0 0 13 * 5' fires on every 13th and every Friday, not on Friday the 13th."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CronFields a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndef parse(f, lo, hi):\\n    vals=set()\\n    for part in f.split(\\',\\'):\\n        step=1\\n        if \\'/\\' in part: part, s = part.split(\\'/\\'); step=int(s)\\n        if part==\\'*\\': a,b=lo,hi\\n        elif \\'-\\' in part: a,b=map(int,part.split(\\'-\\'))\\n        else: a=b=int(part)\\n        if \\'/\\' in f and \\'-\\' not in part and part!=\\'*\\' : b=hi\\n        vals.update(range(a,b+1,step))\\n    return vals\\ndef nxt(expr, start):\\n    m,h,dom,mon,dow=expr.split()\\n    M,H,DOM,MON=parse(m,0,59),parse(h,0,23),parse(dom,1,31),parse(mon,1,12)\\n    DOW=parse(dow.replace(\\'7\\',\\'0\\'),0,6)\\n    t=start.replace(second=0,microsecond=0)+TD(minutes=1)\\n    while True:\\n        cd=(t.weekday()+1)%7\\n        ok=t.minute in M and t.hour in H and t.month in MON\\n        dm=dom==\\'*\\'; dwm=dow==\\'*\\'\\n        day=(t.day in DOM) if dwm else (cd in DOW) if dm else (t.day in DOM or cd in DOW)\\n        if ok and day: return t\\n        t+=TD(minutes=1)\\ns=DT(2026,10,13,9,30)\\nout=(nxt(\\'30 9 * * 1-5\\', s), nxt(\\'*/15 * * * *\\', s), nxt(\\'0 0 13 * 5\\', s), nxt(\\'0 4 * * *\\', s), nxt(\\'0 0 29 2 *\\', s), sorted(parse(\\'*/20\\',0,59)))', g), g['out'])[1])({}) evaluates to (datetime.datetime(2026, 10, 14, 9, 30), datetime.datetime(2026, 10, 13, 9, 45), datetime.datetime(2026, 10, 16, 0, 0), datetime.datetime(2026, 10, 14, 4, 0), datetime.datetime(2028, 2, 29, 0, 0), [0, 20, 40])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndef parse(f, lo, hi):\\n    vals=set()\\n    for part in f.split(\\',\\'):\\n        step=1\\n        if \\'/\\' in part: part, s = part.split(\\'/\\'); step=int(s)\\n        if part==\\'*\\': a,b=lo,hi\\n        elif \\'-\\' in part: a,b=map(int,part.split(\\'-\\'))\\n        else: a=b=int(part)\\n        if \\'/\\' in f and \\'-\\' not in part and part!=\\'*\\' : b=hi\\n        vals.update(range(a,b+1,step))\\n    return vals\\ndef nxt(expr, start):\\n    m,h,dom,mon,dow=expr.split()\\n    M,H,DOM,MON=parse(m,0,59),parse(h,0,23),parse(dom,1,31),parse(mon,1,12)\\n    DOW=parse(dow.replace(\\'7\\',\\'0\\'),0,6)\\n    t=start.replace(second=0,microsecond=0)+TD(minutes=1)\\n    while True:\\n        cd=(t.weekday()+1)%7\\n        ok=t.minute in M and t.hour in H and t.month in MON\\n        dm=dom==\\'*\\'; dwm=dow==\\'*\\'\\n        day=(t.day in DOM) if dwm else (cd in DOW) if dm else (t.day in DOM or cd in DOW)\\n        if ok and day: return t\\n        t+=TD(minutes=1)\\ns=DT(2026,10,13,9,30)\\nout=(nxt(\\'30 9 * * 1-5\\', s), nxt(\\'*/15 * * * *\\', s), nxt(\\'0 0 13 * 5\\', s), nxt(\\'0 4 * * *\\', s), nxt(\\'0 0 29 2 *\\', s), sorted(parse(\\'*/20\\',0,59)))', g), g['out'])[1])({})" ; chx:output "(datetime.datetime(2026, 10, 14, 9, 30), datetime.datetime(2026, 10, 13, 9, 45), datetime.datetime(2026, 10, 16, 0, 0), datetime.datetime(2026, 10, 14, 4, 0), datetime.datetime(2028, 2, 29, 0, 0), [0, 20, 40])" .
chx:X_CronFields rd:hasIOExample chx:IO_CronFields .
chx:X_CronEnvironment a owl:NamedIndividual, chx:CronEnvironment ; rdfs:label "crontab -e"@en ; skos:definition "A job started by cron does not run in the shell that installed it: on this machine a Python job run by cron 3.0pl1 saw PATH=/usr/bin:/bin, the working directory /root, 6 environment variables, no terminal, sh as its parent and a clock in UTC while the shell's TZ was Europe/Istanbul; a TZ=Asia/Kolkata line reached the job and set its clock to IST, but the time an entry fires follows the zone of the cron daemon, not of the job, and a CRON_TZ line was passed to the job as a variable and did not move the schedule."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_LaunchdPlist a owl:NamedIndividual, chx:LaunchdPlist ; rdfs:label "StartCalendarInterval"@en ; skos:definition "launchd on macOS reads a property list in which StartCalendarInterval names the hour and minute of a daily job; plistlib writes and reads such a file as XML and the result reads back equal to the dictionary, but nothing here ran launchd."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_LaunchdPlist a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport plistlib\\nd={\\'Label\\':\\'org.example.backup\\',\\'ProgramArguments\\':[\\'/usr/bin/python3\\',\\'/Users/al/backup.py\\'],\\'StartCalendarInterval\\':{\\'Hour\\':4,\\'Minute\\':0}}\\nb=plistlib.dumps(d); back=plistlib.loads(b)\\nout=(back==d, b.decode().splitlines()[:3], len(b), b.count(b\\'<key>\\'), plistlib.FMT_XML.name)', g), g['out'])[1])({}) evaluates to (True, ['<?xml version='1.0' encoding='UTF-8'?>', '<!DOCTYPE plist PUBLIC '-//Apple//DTD PLIST 1.0//EN' 'http://www.apple.com/DTDs/PropertyList-1.0.dtd'>', '<plist version='1.0'>'], 501, 5, 'FMT_XML')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport plistlib\\nd={\\'Label\\':\\'org.example.backup\\',\\'ProgramArguments\\':[\\'/usr/bin/python3\\',\\'/Users/al/backup.py\\'],\\'StartCalendarInterval\\':{\\'Hour\\':4,\\'Minute\\':0}}\\nb=plistlib.dumps(d); back=plistlib.loads(b)\\nout=(back==d, b.decode().splitlines()[:3], len(b), b.count(b\\'<key>\\'), plistlib.FMT_XML.name)', g), g['out'])[1])({})" ; chx:output "(True, ['<?xml version='1.0' encoding='UTF-8'?>', '<!DOCTYPE plist PUBLIC '-//Apple//DTD PLIST 1.0//EN' 'http://www.apple.com/DTDs/PropertyList-1.0.dtd'>', '<plist version='1.0'>'], 501, 5, 'FMT_XML')" .
chx:X_LaunchdPlist rd:hasIOExample chx:IO_LaunchdPlist .
chx:X_SystemdCalendar a owl:NamedIndividual, chx:SystemdCalendar ; rdfs:label "OnCalendar=Mon..Fri 09:00"@en ; skos:definition "A systemd timer takes an OnCalendar expression, and systemd-analyze calendar normalises it without running anything: 'Mon..Fri 09:00' becomes 'Mon..Fri *-*-* 09:00:00', 'daily' becomes '*-*-* 00:00:00' and 'weekly' becomes 'Mon *-*-* 00:00:00'; the container's PID 1 is not systemd, so no timer ran."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SystemdCalendar a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndef cal(expr, tz):\\n    r=subprocess.run([\\'systemd-analyze\\',\\'calendar\\',expr],capture_output=True,text=True,env=dict(os.environ,TZ=tz)); return r.stdout.splitlines()[:2]\\nout=(cal(\\'Mon..Fri 09:00\\',\\'UTC\\'), cal(\\'*-*-* 04:00\\',\\'Europe/Istanbul\\'), cal(\\'daily\\',\\'UTC\\'), cal(\\'weekly\\',\\'UTC\\'))', g), g['out'])[1])({}) evaluates to (['  Original form: Mon..Fri 09:00', 'Normalized form: Mon..Fri *-*-* 09:00:00'], ['  Original form: *-*-* 04:00', 'Normalized form: *-*-* 04:00:00'], ['  Original form: daily', 'Normalized form: *-*-* 00:00:00'], ['  Original form: weekly', 'Normalized form: Mon *-*-* 00:00:00'])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\ndef cal(expr, tz):\\n    r=subprocess.run([\\'systemd-analyze\\',\\'calendar\\',expr],capture_output=True,text=True,env=dict(os.environ,TZ=tz)); return r.stdout.splitlines()[:2]\\nout=(cal(\\'Mon..Fri 09:00\\',\\'UTC\\'), cal(\\'*-*-* 04:00\\',\\'Europe/Istanbul\\'), cal(\\'daily\\',\\'UTC\\'), cal(\\'weekly\\',\\'UTC\\'))', g), g['out'])[1])({})" ; chx:output "(['  Original form: Mon..Fri 09:00', 'Normalized form: Mon..Fri *-*-* 09:00:00'], ['  Original form: *-*-* 04:00', 'Normalized form: *-*-* 04:00:00'], ['  Original form: daily', 'Normalized form: *-*-* 00:00:00'], ['  Original form: weekly', 'Normalized form: Mon *-*-* 00:00:00'])" .
chx:X_SystemdCalendar rd:hasIOExample chx:IO_SystemdCalendar .
chx:X_SchedModule a owl:NamedIndividual, chx:SchedModule ; rdfs:label "sched.scheduler(time.monotonic, time.sleep)"@en ; skos:definition "sched.scheduler keeps events in a queue ordered by time and then priority and run() calls them in that order: with a fake clock, events at 0 s, 2 s and two at 5 s with priorities 1 and 0 ran as now, two, five with priority 0, five, and cancel() on an event that has run raises ValueError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SchedModule a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nclock=[0.0]; log=[]\\ns=sched.scheduler(lambda: clock[0], lambda d: clock.__setitem__(0, clock[0]+d))\\ns.enter(5, 1, log.append, (\\'five\\',)); s.enter(2, 1, log.append, (\\'two\\',)); s.enter(5, 0, log.append, (\\'five, priority 0\\',)); s.enter(0, 9, log.append, (\\'now\\',))\\nn=len(s.queue); s.run()\\nclock2=[100.0]; log2=[]\\ns2=sched.scheduler(lambda: clock2[0], lambda d: clock2.__setitem__(0, clock2[0]+d))\\ne=s2.enterabs(130, 1, log2.append, (\\'thirty\\',)); s2.enterabs(110, 1, log2.append, (\\'ten\\',)); s2.cancel(e); s2.enterabs(90, 1, log2.append, (\\'past\\',))\\ns2.run()\\nout=(n, log, clock[0], s.empty(), log2, clock2[0], err(lambda: s2.cancel(e))[0])', g), g['out'])[1])({}) evaluates to (4, ['now', 'two', 'five, priority 0', 'five'], 5.0, True, ['past', 'ten'], 110.0, 'ValueError')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nclock=[0.0]; log=[]\\ns=sched.scheduler(lambda: clock[0], lambda d: clock.__setitem__(0, clock[0]+d))\\ns.enter(5, 1, log.append, (\\'five\\',)); s.enter(2, 1, log.append, (\\'two\\',)); s.enter(5, 0, log.append, (\\'five, priority 0\\',)); s.enter(0, 9, log.append, (\\'now\\',))\\nn=len(s.queue); s.run()\\nclock2=[100.0]; log2=[]\\ns2=sched.scheduler(lambda: clock2[0], lambda d: clock2.__setitem__(0, clock2[0]+d))\\ne=s2.enterabs(130, 1, log2.append, (\\'thirty\\',)); s2.enterabs(110, 1, log2.append, (\\'ten\\',)); s2.cancel(e); s2.enterabs(90, 1, log2.append, (\\'past\\',))\\ns2.run()\\nout=(n, log, clock[0], s.empty(), log2, clock2[0], err(lambda: s2.cancel(e))[0])', g), g['out'])[1])({})" ; chx:output "(4, ['now', 'two', 'five, priority 0', 'five'], 5.0, True, ['past', 'ten'], 110.0, 'ValueError')" .
chx:X_SchedModule rd:hasIOExample chx:IO_SchedModule .
chx:X_TimerThread a owl:NamedIndividual, chx:TimerThread ; rdfs:label "threading.Timer(0.1, func)"@en ; skos:definition "threading.Timer is a Thread that calls a function once after a delay; nothing has run right after start(), the call has run after join(), and cancel() stops a timer that has not fired."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TimerThread a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nhits=[]\\nt=threading.Timer(0.1, hits.append, args=(\\'fired\\',)); t.start(); mid=list(hits); t.join()\\nt2=threading.Timer(5, hits.append, args=(\\'never\\',)); t2.start(); t2.cancel(); t2.join(1)\\nout=(mid, hits, threading.Timer.__mro__[1].__name__, t.is_alive(), t2.is_alive(), t.daemon)', g), g['out'])[1])({}) evaluates to ([], ['fired'], 'Thread', False, False, False)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nhits=[]\\nt=threading.Timer(0.1, hits.append, args=(\\'fired\\',)); t.start(); mid=list(hits); t.join()\\nt2=threading.Timer(5, hits.append, args=(\\'never\\',)); t2.start(); t2.cancel(); t2.join(1)\\nout=(mid, hits, threading.Timer.__mro__[1].__name__, t.is_alive(), t2.is_alive(), t.daemon)', g), g['out'])[1])({})" ; chx:output "([], ['fired'], 'Thread', False, False, False)" .
chx:X_TimerThread rd:hasIOExample chx:IO_TimerThread .
chx:X_AsyncioCallLater a owl:NamedIndividual, chx:AsyncioCallLater ; rdfs:label "loop.call_later(0.2, func)"@en ; skos:definition "An asyncio event loop runs a callback after a delay with call_later or at a loop time with call_at: callbacks scheduled with call_soon, then call_later 0.1 and 0.2, ran in the order soon, later 0.1, later 0.2."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_AsyncioCallLater a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport asyncio\\nlog=[]\\nasync def main():\\n    loop=asyncio.get_running_loop(); loop.call_later(0.2, log.append, \\'later 0.2\\'); loop.call_later(0.1, log.append, \\'later 0.1\\'); loop.call_soon(log.append, \\'soon\\')\\n    await asyncio.sleep(0.3)\\nasyncio.run(main())\\nout=log', g), g['out'])[1])({}) evaluates to ['soon', 'later 0.1', 'later 0.2']"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport asyncio\\nlog=[]\\nasync def main():\\n    loop=asyncio.get_running_loop(); loop.call_later(0.2, log.append, \\'later 0.2\\'); loop.call_later(0.1, log.append, \\'later 0.1\\'); loop.call_soon(log.append, \\'soon\\')\\n    await asyncio.sleep(0.3)\\nasyncio.run(main())\\nout=log', g), g['out'])[1])({})" ; chx:output "['soon', 'later 0.1', 'later 0.2']" .
chx:X_AsyncioCallLater rd:hasIOExample chx:IO_AsyncioCallLater .
chx:X_ScheduleLibrary a owl:NamedIndividual, chx:ScheduleLibrary ; rdfs:label "schedule.every().day.at('10:30').do(job)"@en ; skos:definition "The third-party schedule 1.2.2 runs jobs written as every().day.at('10:30').do(job) inside a running Python process: the first run is set for 10:30:00 and an every(10).minutes job is more than 590 seconds away; the process must keep calling run_pending, so it is not an operating system scheduler."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ScheduleLibrary a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport schedule, importlib.metadata as md\\ns=schedule.Scheduler(); j=s.every().day.at(\\'10:30\\').do(print, \\'job\\'); k=s.every(10).minutes.do(print, \\'tick\\')\\nout=(md.version(\\'schedule\\'), j.next_run.strftime(\\'%H:%M:%S\\'), (k.next_run-DT.now()).total_seconds()>590, str(j)[:30], s.idle_seconds is not None, len(s.jobs))', g), g['out'])[1])({}) evaluates to ('1.2.2', '10:30:00', True, 'Job(interval=1, unit=days, do=', True, 2)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nimport schedule, importlib.metadata as md\\ns=schedule.Scheduler(); j=s.every().day.at(\\'10:30\\').do(print, \\'job\\'); k=s.every(10).minutes.do(print, \\'tick\\')\\nout=(md.version(\\'schedule\\'), j.next_run.strftime(\\'%H:%M:%S\\'), (k.next_run-DT.now()).total_seconds()>590, str(j)[:30], s.idle_seconds is not None, len(s.jobs))', g), g['out'])[1])({})" ; chx:output "('1.2.2', '10:30:00', True, 'Job(interval=1, unit=days, do=', True, 2)" .
chx:X_ScheduleLibrary rd:hasIOExample chx:IO_ScheduleLibrary .
chx:X_EnDashListings a owl:NamedIndividual, chx:EnDashListings ; rdfs:label "end_time – start_time"@en ; skos:definition "Four places in three listings of the chapter, listings 2, 6 and 12 of the web page, write the en dash U+2013 where the minus sign belongs, and the compiler refuses the character with SyntaxError 'invalid character'; a minus sign compiles, and the en dash is not an identifier character either."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_EnDashListings a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout = (err(lambda: compile(\\'x = 5 – 3\\', \\'f\\', \\'exec\\')), err(lambda: compile(\\'x = 5 - 3\\', \\'f\\', \\'exec\\'))[0], err(lambda: compile(\\x22print(f\\'{5 – 3}\\')\\x22, \\'f\\', \\'exec\\')), ord(\\'–\\'), \\'–\\'.isidentifier())', g), g['out'])[1])({}) evaluates to (('SyntaxError', 'invalid character '–' (U+2013) (f, line 1)'), 'ok', ('SyntaxError', 'invalid character '–' (U+2013) (f, line 1)'), 8211, False)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout = (err(lambda: compile(\\'x = 5 – 3\\', \\'f\\', \\'exec\\')), err(lambda: compile(\\'x = 5 - 3\\', \\'f\\', \\'exec\\'))[0], err(lambda: compile(\\x22print(f\\'{5 – 3}\\')\\x22, \\'f\\', \\'exec\\')), ord(\\'–\\'), \\'–\\'.isidentifier())', g), g['out'])[1])({})" ; chx:output "(('SyntaxError', 'invalid character '–' (U+2013) (f, line 1)'), 'ok', ('SyntaxError', 'invalid character '–' (U+2013) (f, line 1)'), 8211, False)" .
chx:X_EnDashListings rd:hasIOExample chx:IO_EnDashListings .
chx:X_ShippedFiles a owl:NamedIndividual, chx:ShippedFiles ; rdfs:label "calcProd.py, stopwatch.py, simplecountdown.py"@en ; skos:definition "The online materials ship three files for the chapter and none of them is the printed listing: stopwatch.py has two en dashes, CRLF line ends and a print without the f prefix, calcProd.py loops to 99999, prints a digit count and has an en dash, and simplecountdown.py differs from the chapter only in spacing; the study fetched them and compared their SHA-256 hashes."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_ReplayOfListings a owl:NamedIndividual, chx:ReplayOfListings ; rdfs:label ">>> statements of the interactive sessions"@en ; skos:definition "The 75 statements of the 20 interactive sessions were replayed in a clean Python 3.14.6 in the author's zone, America/Los_Angeles: 54 printed what the book prints and 21 did not, of which 7 depend on the clock, 1 is the en dash and 13 need Windows or macOS or a program Linux lacks; with the dash repaired 55 match, and in the zone of Istanbul one more differs, fromtimestamp(1000000)."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_LapArithmetic a owl:NamedIndividual, chx:LapArithmetic ; rdfs:label "lap_time = round(time.time() - last_time, 2)"@en ; skos:definition "The stopwatch program rounds each difference to two digits, so for the readings 0, 3.56, 8.63, 17.68 and 19.11 it prints laps 3.56, 5.07, 9.05 and 1.43 with the totals 3.56, 8.63, 17.68 and 19.11, while the unrounded last lap is 1.4299999999999997."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_LapArithmetic a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nseq=[0.0, 3.56, 8.63, 17.68, 19.11]; start=seq[0]; last=start; rows=[]\\nfor i, now in enumerate(seq[1:], 1):\\n    lap=round(now-last,2); total=round(now-start,2); rows.append((i,total,lap)); last=now\\nprinted=[f\\'Lap #{n}: {tot}({lap})\\' for n,tot,lap in rows]\\nout=(printed, round(8.63-3.56,2), 8.63-3.56, round(19.11-17.68,2), 19.11-17.68)', g), g['out'])[1])({}) evaluates to (['Lap #1: 3.56(3.56)', 'Lap #2: 8.63(5.07)', 'Lap #3: 17.68(9.05)', 'Lap #4: 19.11(1.43)'], 5.07, 5.07, 1.43, 1.4299999999999997)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nseq=[0.0, 3.56, 8.63, 17.68, 19.11]; start=seq[0]; last=start; rows=[]\\nfor i, now in enumerate(seq[1:], 1):\\n    lap=round(now-last,2); total=round(now-start,2); rows.append((i,total,lap)); last=now\\nprinted=[f\\'Lap #{n}: {tot}({lap})\\' for n,tot,lap in rows]\\nout=(printed, round(8.63-3.56,2), 8.63-3.56, round(19.11-17.68,2), 19.11-17.68)', g), g['out'])[1])({})" ; chx:output "(['Lap #1: 3.56(3.56)', 'Lap #2: 8.63(5.07)', 'Lap #3: 17.68(9.05)', 'Lap #4: 19.11(1.43)'], 5.07, 5.07, 1.43, 1.4299999999999997)" .
chx:X_LapArithmetic rd:hasIOExample chx:IO_LapArithmetic .
chx:X_ColumnFormatting a owl:NamedIndividual, chx:ColumnFormatting ; rdfs:label "str(lap_time).rjust(6)"@en ; skos:definition "The Prettified Stopwatch pads the lap number to 2 characters and the times to 6 with rjust, which produces the book's lines such as 'Lap # 1:   3.56 (  3.56)', and an f-string with >2 and >6 produces the same text; str(2.0).ljust(6) is '2.0   ' and a float is formatted without losing a trailing zero only by .2f."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ColumnFormatting a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nexpected=[\\'Lap # 1:   3.56 (  3.56)\\',\\'Lap # 2:   8.63 (  5.07)\\',\\'Lap # 3:  17.68 (  9.05)\\',\\'Lap # 4:  19.11 (  1.43)\\']\\nrows=[(1,3.56,3.56),(2,8.63,5.07),(3,17.68,9.05),(4,19.11,1.43)]\\ngot=[\\'Lap #\\' + str(n).rjust(2) + \\': \\' + str(t).rjust(6) + \\' (\\' + str(l).rjust(6) + \\')\\' for n,t,l in rows]\\ngot2=[f\\'Lap #{n:>2}: {t:>6} ({l:>6})\\' for n,t,l in rows]\\nout=(got==expected, got2==expected, [str(x).ljust(6) for x in (2.0,)], str(2.0), str(round(2.004,2)), f\\'{round(2.004,2):.2f}\\', len(max(expected,key=len)))', g), g['out'])[1])({}) evaluates to (True, True, ['2.0   '], '2.0', '2.0', '2.00', 24)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nexpected=[\\'Lap # 1:   3.56 (  3.56)\\',\\'Lap # 2:   8.63 (  5.07)\\',\\'Lap # 3:  17.68 (  9.05)\\',\\'Lap # 4:  19.11 (  1.43)\\']\\nrows=[(1,3.56,3.56),(2,8.63,5.07),(3,17.68,9.05),(4,19.11,1.43)]\\ngot=[\\'Lap #\\' + str(n).rjust(2) + \\': \\' + str(t).rjust(6) + \\' (\\' + str(l).rjust(6) + \\')\\' for n,t,l in rows]\\ngot2=[f\\'Lap #{n:>2}: {t:>6} ({l:>6})\\' for n,t,l in rows]\\nout=(got==expected, got2==expected, [str(x).ljust(6) for x in (2.0,)], str(2.0), str(round(2.004,2)), f\\'{round(2.004,2):.2f}\\', len(max(expected,key=len)))', g), g['out'])[1])({})" ; chx:output "(True, True, ['2.0   '], '2.0', '2.0', '2.00', 24)" .
chx:X_ColumnFormatting rd:hasIOExample chx:IO_ColumnFormatting .
chx:X_CountdownLoop a owl:NamedIndividual, chx:CountdownLoop ; rdfs:label "while time_left > 0:"@en ; skos:definition "The countdown loop prints the time left, sleeps one second and subtracts one; counted with a fake sleep, 3 seconds print 3, 2 and 1 and then Beep!, after 3.0 seconds of sleeping, and the real program takes slightly longer than the sum of its sleeps."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CountdownLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nlines=[]; left=3; t=[0.0]\\ndef sleep(d): t[0]+=d\\nwhile left>0:\\n    lines.append(str(left)+\\' \\'); sleep(1); left-=1\\nlines.append(\\'Beep!\\')\\nout=(lines, t[0])', g), g['out'])[1])({}) evaluates to (['3 ', '2 ', '1 ', 'Beep!'], 3.0)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nlines=[]; left=3; t=[0.0]\\ndef sleep(d): t[0]+=d\\nwhile left>0:\\n    lines.append(str(left)+\\' \\'); sleep(1); left-=1\\nlines.append(\\'Beep!\\')\\nout=(lines, t[0])', g), g['out'])[1])({})" ; chx:output "(['3 ', '2 ', '1 ', 'Beep!'], 3.0)" .
chx:X_CountdownLoop rd:hasIOExample chx:IO_CountdownLoop .
chx:X_AlarmSound a owl:NamedIndividual, chx:AlarmSound ; rdfs:label "autbor.com/alarm.wav"@en ; skos:definition "autbor.com/alarm.wav answers 302 and redirects to automatetheboringstuff.com/src/alarm.wav, a 582,952-byte 16-bit stereo 44.1 kHz file of 3.30 seconds; the online materials do not hold it, and no sound could be played in the container, so the playing was not heard."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_FridayForward a owl:NamedIndividual, chx:FridayForward ; rdfs:label "while len(found) < 10: if d.day == 13 and d.weekday() == 4"@en ; skos:definition "Walking forward one day at a time from 13 October 2026 finds the next ten Friday the 13ths: 13 November 2026, 13 August 2027, 13 October 2028, 13 April 2029, 13 July 2029, 13 September 2030, 13 December 2030, 13 June 2031, 13 February 2032 and 13 August 2032."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_FridayForward a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nd=D(2026,10,13); one=TD(days=1); found=[]\\nwhile len(found)<10:\\n    if d.day==13 and d.weekday()==4: found.append(d)\\n    d+=one\\nout=([x.isoformat() for x in found], [x.strftime(\\'%B %Y\\') for x in found][:3], all(x.strftime(\\'%A\\')==\\'Friday\\' for x in found))', g), g['out'])[1])({}) evaluates to (['2026-11-13', '2027-08-13', '2028-10-13', '2029-04-13', '2029-07-13', '2030-09-13', '2030-12-13', '2031-06-13', '2032-02-13', '2032-08-13'], ['November 2026', 'August 2027', 'October 2028'], True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nd=D(2026,10,13); one=TD(days=1); found=[]\\nwhile len(found)<10:\\n    if d.day==13 and d.weekday()==4: found.append(d)\\n    d+=one\\nout=([x.isoformat() for x in found], [x.strftime(\\'%B %Y\\') for x in found][:3], all(x.strftime(\\'%A\\')==\\'Friday\\' for x in found))', g), g['out'])[1])({})" ; chx:output "(['2026-11-13', '2027-08-13', '2028-10-13', '2029-04-13', '2029-07-13', '2030-09-13', '2030-12-13', '2031-06-13', '2032-02-13', '2032-08-13'], ['November 2026', 'August 2027', 'October 2028'], True)" .
chx:X_FridayForward rd:hasIOExample chx:IO_FridayForward .
chx:X_FridayBackward a owl:NamedIndividual, chx:FridayBackward ; rdfs:label "d -= datetime.timedelta(days=1)"@en ; skos:definition "Walking backward from 13 October 2026 finds 3485 Friday the 13ths, the latest 13 March 2026 and the earliest 13 April of the year 1, then date arithmetic raises OverflowError at 1 January of the year 1, 739,901 days back; the 400-year Gregorian cycle of 146,097 days is a multiple of 7 and holds 688 Friday the 13ths, more than any other weekday's 13ths."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_FridayBackward a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nfrom collections import Counter\\nd=D(2026,10,13); one=TD(days=1); n=0; first=None; last=None\\ntry:\\n    while True:\\n        if d.day==13 and d.weekday()==4:\\n            n+=1; last=d\\n            if first is None: first=d\\n        d-=one\\nexcept OverflowError as e: stop=(str(e), d)\\nbyday=Counter(D(y,m,13).weekday() for y in range(2000,2400) for m in range(1,13))\\nout=(first, last, n, stop, (D(2026,10,13)-D(1,1,1)).days, sorted(byday.items()), (400*365+97)%7, 400*365+97)', g), g['out'])[1])({}) evaluates to (datetime.date(2026, 3, 13), datetime.date(1, 4, 13), 3485, ('date value out of range', datetime.date(1, 1, 1)), 739901, [(0, 685), (1, 685), (2, 687), (3, 684), (4, 688), (5, 684), (6, 687)], 0, 146097)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nfrom collections import Counter\\nd=D(2026,10,13); one=TD(days=1); n=0; first=None; last=None\\ntry:\\n    while True:\\n        if d.day==13 and d.weekday()==4:\\n            n+=1; last=d\\n            if first is None: first=d\\n        d-=one\\nexcept OverflowError as e: stop=(str(e), d)\\nbyday=Counter(D(y,m,13).weekday() for y in range(2000,2400) for m in range(1,13))\\nout=(first, last, n, stop, (D(2026,10,13)-D(1,1,1)).days, sorted(byday.items()), (400*365+97)%7, 400*365+97)', g), g['out'])[1])({})" ; chx:output "(datetime.date(2026, 3, 13), datetime.date(1, 4, 13), 3485, ('date value out of range', datetime.date(1, 1, 1)), 739901, [(0, 685), (1, 685), (2, 687), (3, 684), (4, 688), (5, 684), (6, 687)], 0, 146097)" .
chx:X_FridayBackward rd:hasIOExample chx:IO_FridayBackward .
chx:X_AppendixBAnswers a owl:NamedIndividual, chx:AppendixBAnswers ; rdfs:label "round(2.5)"@en ; skos:definition "Appendix B answers question 3 with time.asctime(), which prints what ctime() prints for the current time, question 5 with 'the closest integer', which is incomplete because round(2.5) is 2 and round(x, 2) returns a float, and question 7 with weekday() equal to 0 for Monday, which is right."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_AppendixBAnswers a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(round(2.4), round(2.5), round(3.5), type(round(2.5)).__name__, type(round(2.5,2)).__name__, child(\\x22import time; print(time.asctime() == time.ctime())\\x22), child(\\x22import time; print(time.asctime(time.localtime(5)) == time.ctime(5))\\x22), time.asctime(time.gmtime(0)), DT(2019,1,7).weekday())', g), g['out'])[1])({}) evaluates to (2, 2, 4, 'int', 'float', 'True', 'True', 'Thu Jan  1 00:00:00 1970', 0)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, time, datetime, subprocess, warnings, signal, threading, math, calendar, shlex, sched, tempfile, struct, zoneinfo, shutil\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef warned(f):\\n    with warnings.catch_warnings(record=True) as w:\\n        warnings.simplefilter(\\'always\\'); v = f()\\n    return v, [(x.category.__name__, str(x.message)) for x in w]\\ndef child(code, **env):\\n    e = dict(os.environ); e.update(env)\\n    r = subprocess.run([sys.executable, \\'-c\\', code], capture_output=True, text=True, env=e); return r.stdout.strip() if r.returncode == 0 else r.stderr.strip().splitlines()[-1]\\nout=(round(2.4), round(2.5), round(3.5), type(round(2.5)).__name__, type(round(2.5,2)).__name__, child(\\x22import time; print(time.asctime() == time.ctime())\\x22), child(\\x22import time; print(time.asctime(time.localtime(5)) == time.ctime(5))\\x22), time.asctime(time.gmtime(0)), DT(2019,1,7).weekday())', g), g['out'])[1])({})" ; chx:output "(2, 2, 4, 'int', 'float', 'True', 'True', 'Thu Jan  1 00:00:00 1970', 0)" .
chx:X_AppendixBAnswers rd:hasIOExample chx:IO_AppendixBAnswers .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 19 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch19/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 19 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which clock answers which question, which moments and durations can a datetime hold and which does it refuse or misread, and how does a program launch, wait for, stop and schedule another program on an operating system where the commands of the book do not exist?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, programs, numbers and statements of the chapter differ in current releases of Python, in the zone and the clock of the author, in the files the book ships or in the pages it points to, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 19 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 19 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch19/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-13."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py" .

