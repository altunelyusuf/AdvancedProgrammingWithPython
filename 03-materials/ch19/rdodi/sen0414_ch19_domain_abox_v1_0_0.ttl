chx:X_ElapsedTime a owl:NamedIndividual, chx:ElapsedTime ; rdfs:label "elapsed = end_time - start_time"@en ; skos:definition "Elapsed time is the difference of two clock readings taken before and after a block of code, which is how the chapter profiles calculate_product()."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ElapsedTime a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(12.75 - 10.5, 2) evaluates to 2.25"@en ; chx:input "round(12.75 - 10.5, 2)" ; chx:output "2.25" .
chx:X_ElapsedTime rd:hasIOExample chx:IO_ElapsedTime .
chx:X_MonotonicClock a owl:NamedIndividual, chx:MonotonicClock ; rdfs:label "time.monotonic(), time.perf_counter()"@en ; skos:definition "A monotonic clock cannot go backwards and is not changed when someone sets the system clock, so the difference of two of its readings is a reliable duration; time.time() is a clock that can be set."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_MonotonicClock a owl:NamedIndividual, rd:IOExample ; rdfs:label "[__import__('time').get_clock_info(n).monotonic for n in ('time', 'monotonic', 'perf_counter')] evaluates to [False, True, True]"@en ; chx:input "[__import__('time').get_clock_info(n).monotonic for n in ('time', 'monotonic', 'perf_counter')]" ; chx:output "[False, True, True]" .
chx:X_MonotonicClock rd:hasIOExample chx:IO_MonotonicClock .
chx:X_RoundFunction a owl:NamedIndividual, chx:RoundFunction ; rdfs:label "round(time.time() - last_time, 2)"@en ; skos:definition "round returns its number rounded to the digits asked for, and with no digits it returns an integer, rounding halves to the even neighbour."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_RoundFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(round(2.5), round(3.5), round(3.14159, 2), type(round(2.5)).__name__) evaluates to (2, 4, 3.14, 'int')"@en ; chx:input "(round(2.5), round(3.5), round(3.14159, 2), type(round(2.5)).__name__)" ; chx:output "(2, 4, 3.14, 'int')" .
chx:X_RoundFunction rd:hasIOExample chx:IO_RoundFunction .
chx:X_SleepFunction a owl:NamedIndividual, chx:SleepFunction ; rdfs:label "time.sleep(1)"@en ; skos:definition "time.sleep blocks the calling program for at least the given number of seconds, so a loop that checks the clock once a second does not burn processor time."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SleepFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "[__import__('time').sleep(0.01)] evaluates to [None]"@en ; chx:input "[__import__('time').sleep(0.01)]" ; chx:output "[None]" .
chx:X_SleepFunction rd:hasIOExample chx:IO_SleepFunction .
chx:X_EpochTimestamp a owl:NamedIndividual, chx:EpochTimestamp ; rdfs:label "time.time()"@en ; skos:definition "The time module counts seconds since the Unix epoch, midnight on 1 January 1970 in UTC, and time.time() returns that count as a float, called an epoch timestamp."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_EpochTimestamp a owl:NamedIndividual, rd:IOExample ; rdfs:label "tuple(__import__('time').gmtime(0))[:6] evaluates to (1970, 1, 1, 0, 0, 0)"@en ; chx:input "tuple(__import__('time').gmtime(0))[:6]" ; chx:output "(1970, 1, 1, 0, 0, 0)" .
chx:X_EpochTimestamp rd:hasIOExample chx:IO_EpochTimestamp .
chx:X_ReadableTimeString a owl:NamedIndividual, chx:ReadableTimeString ; rdfs:label "time.ctime(this_moment)"@en ; skos:definition "time.ctime turns an epoch timestamp, or the current moment, into a text such as 'Wed Mar 18 06:04:35 2026' in the computer's local time on a 24-hour clock."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ReadableTimeString a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('time').asctime(__import__('time').gmtime(1773813875)) evaluates to 'Wed Mar 18 06:04:35 2026'"@en ; chx:input "__import__('time').asctime(__import__('time').gmtime(1773813875))" ; chx:output "'Wed Mar 18 06:04:35 2026'" .
chx:X_ReadableTimeString rd:hasIOExample chx:IO_ReadableTimeString .
chx:X_LocalVersusUtc a owl:NamedIndividual, chx:LocalVersusUtc ; rdfs:label "datetime.fromtimestamp(1000000)"@en ; skos:definition "Converting an epoch timestamp to a date gives a different clock reading in each time zone for the same moment, so a printed time is reproducible only with its zone stated."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_LocalVersusUtc a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime.fromtimestamp(1000000, __import__('datetime').timezone.utc).isoformat() evaluates to '1970-01-12T13:46:40+00:00'"@en ; chx:input "__import__('datetime').datetime.fromtimestamp(1000000, __import__('datetime').timezone.utc).isoformat()" ; chx:output "'1970-01-12T13:46:40+00:00'" .
chx:X_LocalVersusUtc rd:hasIOExample chx:IO_LocalVersusUtc .
chx:X_DatetimeObject a owl:NamedIndividual, chx:DatetimeObject ; rdfs:label "datetime.datetime(2026, 10, 21, 16, 29, 0)"@en ; skos:definition "A datetime object holds a moment as year, month, day, hour, minute, second and microsecond, with hour, minute and second defaulting to 0."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DatetimeObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.year, d.month, d.day, d.hour, d.minute, d.second))(__import__('datetime').datetime(2026, 10, 21, 16, 29)) evaluates to (2026, 10, 21, 16, 29, 0)"@en ; chx:input "(lambda d: (d.year, d.month, d.day, d.hour, d.minute, d.second))(__import__('datetime').datetime(2026, 10, 21, 16, 29))" ; chx:output "(2026, 10, 21, 16, 29, 0)" .
chx:X_DatetimeObject rd:hasIOExample chx:IO_DatetimeObject .
chx:X_CurrentMoment a owl:NamedIndividual, chx:CurrentMoment ; rdfs:label "datetime.datetime.now()"@en ; skos:definition "datetime.now returns the current moment according to the computer's clock as a value with no time zone attached, unless a zone is passed."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CurrentMoment a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime.now(__import__('datetime').timezone.utc).utcoffset() evaluates to datetime.timedelta(0)"@en ; chx:input "__import__('datetime').datetime.now(__import__('datetime').timezone.utc).utcoffset()" ; chx:output "datetime.timedelta(0)" .
chx:X_CurrentMoment rd:hasIOExample chx:IO_CurrentMoment .
chx:X_DatetimeComparison a owl:NamedIndividual, chx:DatetimeComparison ; rdfs:label "new_years_2027 > halloween_2026"@en ; skos:definition "Datetime values are compared with the usual operators, and the later moment is the greater one."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DatetimeComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d, h, n: (h == d(2026, 10, 31), h > n, n > h))(__import__('datetime').datetime, __import__('datetime').datetime(2026, 10, 31), __import__('datetime').datetime(2027, 1, 1)) evaluates to (True, False, True)"@en ; chx:input "(lambda d, h, n: (h == d(2026, 10, 31), h > n, n > h))(__import__('datetime').datetime, __import__('datetime').datetime(2026, 10, 31), __import__('datetime').datetime(2027, 1, 1))" ; chx:output "(True, False, True)" .
chx:X_DatetimeComparison rd:hasIOExample chx:IO_DatetimeComparison .
chx:X_TimedeltaObject a owl:NamedIndividual, chx:TimedeltaObject ; rdfs:label "datetime.timedelta(days=11, hours=10, minutes=9, seconds=8)"@en ; skos:definition "A timedelta holds a duration, not a moment, normalised into days, seconds and microseconds."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TimedeltaObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.days, d.seconds, d.microseconds))(__import__('datetime').timedelta(days=11, hours=10, minutes=9, seconds=8)) evaluates to (11, 36548, 0)"@en ; chx:input "(lambda d: (d.days, d.seconds, d.microseconds))(__import__('datetime').timedelta(days=11, hours=10, minutes=9, seconds=8))" ; chx:output "(11, 36548, 0)" .
chx:X_TimedeltaObject rd:hasIOExample chx:IO_TimedeltaObject .
chx:X_DurationReadouts a owl:NamedIndividual, chx:DurationReadouts ; rdfs:label "delta.total_seconds(), str(delta)"@en ; skos:definition "total_seconds returns the whole duration as a float number of seconds and str gives a text such as '11 days, 10:09:08'."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DurationReadouts a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.total_seconds(), str(d)))(__import__('datetime').timedelta(days=11, hours=10, minutes=9, seconds=8)) evaluates to (986948.0, '11 days, 10:09:08')"@en ; chx:input "(lambda d: (d.total_seconds(), str(d)))(__import__('datetime').timedelta(days=11, hours=10, minutes=9, seconds=8))" ; chx:output "(986948.0, '11 days, 10:09:08')" .
chx:X_DurationReadouts rd:hasIOExample chx:IO_DurationReadouts .
chx:X_DurationUnits a owl:NamedIndividual, chx:DurationUnits ; rdfs:label "timedelta(weeks=1, hours=24)"@en ; skos:definition "A timedelta takes weeks, days, hours, minutes, seconds, milliseconds and microseconds but no months or years, because those have no fixed length."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DurationUnits a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').timedelta(weeks=1, hours=24).days evaluates to 8"@en ; chx:input "__import__('datetime').timedelta(weeks=1, hours=24).days" ; chx:output "8" .
chx:X_DurationUnits rd:hasIOExample chx:IO_DurationUnits .
chx:X_AddSubtractDuration a owl:NamedIndividual, chx:AddSubtractDuration ; rdfs:label "now + thousand_days"@en ; skos:definition "A timedelta is added to or subtracted from a datetime with + and -, multiplied by a number with *, and the module handles month lengths and leap years."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_AddSubtractDuration a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime(2026, 12, 2, 18, 38, 50, 636181) + __import__('datetime').timedelta(days=1000) evaluates to datetime.datetime(2029, 8, 28, 18, 38, 50, 636181)"@en ; chx:input "__import__('datetime').datetime(2026, 12, 2, 18, 38, 50, 636181) + __import__('datetime').timedelta(days=1000)" ; chx:output "datetime.datetime(2029, 8, 28, 18, 38, 50, 636181)" .
chx:X_AddSubtractDuration rd:hasIOExample chx:IO_AddSubtractDuration .
chx:X_DateDifference a owl:NamedIndividual, chx:DateDifference ; rdfs:label "delta = new_years_2027 - halloween_2026"@en ; skos:definition "Subtracting one datetime from another gives a timedelta, the time between the two moments."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_DateDifference a owl:NamedIndividual, rd:IOExample ; rdfs:label "str(__import__('datetime').datetime(2027, 1, 1) - __import__('datetime').datetime(2026, 10, 31)) evaluates to '62 days, 0:00:00'"@en ; chx:input "str(__import__('datetime').datetime(2027, 1, 1) - __import__('datetime').datetime(2026, 10, 31))" ; chx:output "'62 days, 0:00:00'" .
chx:X_DateDifference rd:hasIOExample chx:IO_DateDifference .
chx:X_WeekdayOfDate a owl:NamedIndividual, chx:WeekdayOfDate ; rdfs:label "datetime.date(2019, 1, 7).strftime('%A')"@en ; skos:definition "The weekday of a date is found by formatting it with %A for its name or by calling weekday(), which counts Monday as 0."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_WeekdayOfDate a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').date(2019, 1, 7).strftime('%A') evaluates to 'Monday'"@en ; chx:input "__import__('datetime').date(2019, 1, 7).strftime('%A')" ; chx:output "'Monday'" .
chx:X_WeekdayOfDate rd:hasIOExample chx:IO_WeekdayOfDate .
chx:X_StrftimeFormat a owl:NamedIndividual, chx:StrftimeFormat ; rdfs:label "oct_21st.strftime('%Y/%m/%d %H:%M:%S')"@en ; skos:definition "strftime returns a datetime as text from a format string of directives such as %Y, %m, %d, %H, %M, %S, %I and %p."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_StrftimeFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime(2026, 10, 21, 16, 29, 0).strftime('%Y/%m/%d %H:%M:%S') evaluates to '2026/10/21 16:29:00'"@en ; chx:input "__import__('datetime').datetime(2026, 10, 21, 16, 29, 0).strftime('%Y/%m/%d %H:%M:%S')" ; chx:output "'2026/10/21 16:29:00'" .
chx:X_StrftimeFormat rd:hasIOExample chx:IO_StrftimeFormat .
chx:X_StrptimeParse a owl:NamedIndividual, chx:StrptimeParse ; rdfs:label "datetime.datetime.strptime('October 21, 2026', '%B %d, %Y')"@en ; skos:definition "strptime is the inverse of strftime: it reads a datetime from text with a format string of the same directives."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_StrptimeParse a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime.strptime('October 21, 2026', '%B %d, %Y') evaluates to datetime.datetime(2026, 10, 21, 0, 0)"@en ; chx:input "__import__('datetime').datetime.strptime('October 21, 2026', '%B %d, %Y')" ; chx:output "datetime.datetime(2026, 10, 21, 0, 0)" .
chx:X_StrptimeParse rd:hasIOExample chx:IO_StrptimeParse .
chx:X_TwoDigitYear a owl:NamedIndividual, chx:TwoDigitYear ; rdfs:label "%y"@en ; skos:definition "The %y directive reads a two-digit year by the rule that 69 to 99 mean 1969 to 1999 and 0 to 68 mean 2000 to 2068."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TwoDigitYear a owl:NamedIndividual, rd:IOExample ; rdfs:label "[__import__('datetime').datetime.strptime(s, '%y').year for s in ('68', '69', '70')] evaluates to [2068, 1969, 1970]"@en ; chx:input "[__import__('datetime').datetime.strptime(s, '%y').year for s in ('68', '69', '70')]" ; chx:output "[2068, 1969, 1970]" .
chx:X_TwoDigitYear rd:hasIOExample chx:IO_TwoDigitYear .
