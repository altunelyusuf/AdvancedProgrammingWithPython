chx:IO_ParseMismatch a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime.strptime('2026-10-21', '%Y-%m-%d') evaluates to datetime.datetime(2026, 10, 21, 0, 0)"@en ; chx:input "__import__('datetime').datetime.strptime('2026-10-21', '%Y-%m-%d')" ; chx:output "datetime.datetime(2026, 10, 21, 0, 0)" .
chx:X_ParseMismatch rd:hasIOExample chx:IO_ParseMismatch .
chx:X_NaiveVersusAware a owl:NamedIndividual, chx:NaiveVersusAware ; rdfs:label "datetime.now(datetime.UTC)"@en ; skos:definition "A datetime without a tzinfo is naive and one with a tzinfo is aware; naive and aware values are never equal and cannot be ordered."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_NaiveVersusAware a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda m: (m(2026, 10, 21).tzinfo, m(2026, 10, 21, tzinfo=__import__('datetime').timezone.utc).tzinfo))(__import__('datetime').datetime) evaluates to (None, datetime.timezone.utc)"@en ; chx:input "(lambda m: (m(2026, 10, 21).tzinfo, m(2026, 10, 21, tzinfo=__import__('datetime').timezone.utc).tzinfo))(__import__('datetime').datetime)" ; chx:output "(None, datetime.timezone.utc)" .
chx:X_NaiveVersusAware rd:hasIOExample chx:IO_NaiveVersusAware .
chx:X_UtcnowDeprecated a owl:NamedIndividual, chx:UtcnowDeprecated ; rdfs:label "datetime.utcnow()"@en ; skos:definition "datetime.utcnow and utcfromtimestamp return naive values and have been deprecated since Python 3.12 in favour of aware values made with datetime.UTC."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_ZoneInfoZones a owl:NamedIndividual, chx:ZoneInfoZones ; rdfs:label "ZoneInfo('America/Los_Angeles')"@en ; skos:definition "The zoneinfo module attaches an IANA time zone, with its daylight saving rules, to a datetime as its tzinfo."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_WallClockArithmetic a owl:NamedIndividual, chx:WallClockArithmetic ; rdfs:label "aware_datetime + timedelta(days=1)"@en ; skos:definition "Adding a duration to an aware datetime in one zone moves the wall-clock reading, so adding one day across the start of daylight saving time spans 23 hours."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_YearlessParsing a owl:NamedIndividual, chx:YearlessParsing ; rdfs:label "strptime('02/29;1984', '%m/%d;%Y')"@en ; skos:definition "Parsing a month and a day without a year uses the non-leap year 1900, which fails for 29 February and draws a DeprecationWarning since Python 3.13; adding a leap year to the text and the format avoids it."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_YearlessParsing a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime.strptime('02/29;1984', '%m/%d;%Y') evaluates to datetime.datetime(1984, 2, 29, 0, 0)"@en ; chx:input "__import__('datetime').datetime.strptime('02/29;1984', '%m/%d;%Y')" ; chx:output "datetime.datetime(1984, 2, 29, 0, 0)" .
chx:X_YearlessParsing rd:hasIOExample chx:IO_YearlessParsing .
chx:X_RunFunction a owl:NamedIndividual, chx:RunFunction ; rdfs:label "subprocess.run(['/usr/bin/gnome-calculator'])"@en ; skos:definition "subprocess.run starts another program, waits until it ends and returns a CompletedProcess that records the arguments and the return code."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_RunFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('subprocess').CompletedProcess(['calc.exe'], 0) evaluates to CompletedProcess(args=['calc.exe'], returncode=0)"@en ; chx:input "__import__('subprocess').CompletedProcess(['calc.exe'], 0)" ; chx:output "CompletedProcess(args=['calc.exe'], returncode=0)" .
chx:X_RunFunction rd:hasIOExample chx:IO_RunFunction .
chx:X_ArgumentList a owl:NamedIndividual, chx:ArgumentList ; rdfs:label "['notepad', 'hello.txt']"@en ; skos:definition "The program and its command line arguments are given as a list of strings, the first being the program, so a file name with spaces stays one argument."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ArgumentList a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('shlex').split('notepad hello.txt \\'my file.txt\\'') evaluates to ['notepad', 'hello.txt', 'my file.txt']"@en ; chx:input "__import__('shlex').split('notepad hello.txt \\'my file.txt\\'')" ; chx:output "['notepad', 'hello.txt', 'my file.txt']" .
chx:X_ArgumentList rd:hasIOExample chx:IO_ArgumentList .
chx:X_CaptureOutput a owl:NamedIndividual, chx:CaptureOutput ; rdfs:label "capture_output=True, text=True"@en ; skos:definition "With capture_output=True the text the program prints is kept in the stdout and stderr attributes of the result, as text when text=True and as bytes otherwise."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CaptureOutput a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('subprocess').CompletedProcess(['ping', '-c', '4'], 0, stdout='4 replies\\n').stdout evaluates to '4 replies\\n'"@en ; chx:input "__import__('subprocess').CompletedProcess(['ping', '-c', '4'], 0, stdout='4 replies\\n').stdout" ; chx:output "'4 replies\\n'" .
chx:X_CaptureOutput rd:hasIOExample chx:IO_CaptureOutput .
chx:X_ExitCode a owl:NamedIndividual, chx:ExitCode ; rdfs:label "proc.returncode == 0"@en ; skos:definition "An exit code of 0 means the program ended without error and any other value that it failed; a negative value means a signal ended it."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ExitCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p: (p.returncode, p.returncode == 0))(__import__('subprocess').CompletedProcess(['x'], 3)) evaluates to (3, False)"@en ; chx:input "(lambda p: (p.returncode, p.returncode == 0))(__import__('subprocess').CompletedProcess(['x'], 3))" ; chx:output "(3, False)" .
chx:X_ExitCode rd:hasIOExample chx:IO_ExitCode .
chx:X_CheckAndTimeout a owl:NamedIndividual, chx:CheckAndTimeout ; rdfs:label "check=True, timeout=5"@en ; skos:definition "check=True raises CalledProcessError on a nonzero exit code and timeout kills the program and raises TimeoutExpired when it runs too long; a program that does not exist raises FileNotFoundError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_PopenLaunch a owl:NamedIndividual, chx:PopenLaunch ; rdfs:label "subprocess.Popen(['C:\\\\Windows\\\\System32\\\\calc.exe'])"@en ; skos:definition "Popen starts a program and returns at once with an object for the running process, so the Python program continues alongside it."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_PollAndWait a owl:NamedIndividual, chx:PollAndWait ; rdfs:label "calc_proc.poll(), calc_proc.wait()"@en ; skos:definition "poll asks whether the process has ended without waiting, returning None while it runs and the exit code afterwards, and wait blocks until it ends and returns the exit code."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PollAndWait a owl:NamedIndividual, rd:IOExample ; rdfs:label "[m for m in ('poll', 'wait', 'kill', 'terminate', 'communicate') if hasattr(__import__('subprocess').Popen, m)] evaluates to ['poll', 'wait', 'kill', 'terminate', 'communicate']"@en ; chx:input "[m for m in ('poll', 'wait', 'kill', 'terminate', 'communicate') if hasattr(__import__('subprocess').Popen, m)]" ; chx:output "['poll', 'wait', 'kill', 'terminate', 'communicate']" .
chx:X_PollAndWait rd:hasIOExample chx:IO_PollAndWait .
chx:X_KillProcess a owl:NamedIndividual, chx:KillProcess ; rdfs:label "paint_proc.kill()"@en ; skos:definition "kill ends the process at once, without asking it to save, so its unsaved work is lost."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_DefaultApplication a owl:NamedIndividual, chx:DefaultApplication ; rdfs:label "subprocess.run(['start', 'hello.txt'], shell=True)"@en ; skos:definition "The start command on Windows and the open command on macOS open a file with the program the operating system associates with its type."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_ShellTrue a owl:NamedIndividual, chx:ShellTrue ; rdfs:label "shell=True"@en ; skos:definition "With shell=True the text is run by the system shell, so a program must quote any outside text in it itself, for example with shlex.quote, or the text can run extra commands."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ShellTrue a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('shlex').split(__import__('shlex').quote('hello; rm -rf x')) evaluates to ['hello; rm -rf x']"@en ; chx:input "__import__('shlex').split(__import__('shlex').quote('hello; rm -rf x'))" ; chx:output "['hello; rm -rf x']" .
chx:X_ShellTrue rd:hasIOExample chx:IO_ShellTrue .
chx:X_BrowserOpen a owl:NamedIndividual, chx:BrowserOpen ; rdfs:label "webbrowser.open(url)"@en ; skos:definition "webbrowser.open shows a page in the default browser and returns True if a browser was launched."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_OsScheduler a owl:NamedIndividual, chx:OsScheduler ; rdfs:label "Task Scheduler, launchd, cron"@en ; skos:definition "The operating system's own scheduler starts a program at chosen times even when no Python program is running, which a Python program that sleeps cannot do."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:X_SchedModule a owl:NamedIndividual, chx:SchedModule ; rdfs:label "sched.scheduler"@en ; skos:definition "sched.scheduler runs functions at given times inside one running program, in the order of time and then priority, with a replaceable clock and delay function."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_SchedModule a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda log, clock: (lambda s: (s.enter(5, 1, log.append, ('five',)), s.enter(2, 1, log.append, ('two',)), s.run(), log)[-1])(__import__('sched').scheduler(lambda: clock[0], lambda d: clock.__setitem__(0, clock[0] + d))))([], [0]) evaluates to ['two', 'five']"@en ; chx:input "(lambda log, clock: (lambda s: (s.enter(5, 1, log.append, ('five',)), s.enter(2, 1, log.append, ('two',)), s.run(), log)[-1])(__import__('sched').scheduler(lambda: clock[0], lambda d: clock.__setitem__(0, clock[0] + d))))([], [0])" ; chx:output "['two', 'five']" .
chx:X_SchedModule rd:hasIOExample chx:IO_SchedModule .
chx:X_TimerThread a owl:NamedIndividual, chx:TimerThread ; rdfs:label "threading.Timer(5, function)"@en ; skos:definition "threading.Timer runs a function once after a delay in a thread of its own, and cancel stops it while it is still waiting."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TimerThread a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('threading').Timer.__mro__[1].__name__ evaluates to 'Thread'"@en ; chx:input "__import__('threading').Timer.__mro__[1].__name__" ; chx:output "'Thread'" .
chx:X_TimerThread rd:hasIOExample chx:IO_TimerThread .
chx:X_LapTiming a owl:NamedIndividual, chx:LapTiming ; rdfs:label "round(time.time() - last_time, 2)"@en ; skos:definition "The stopwatch keeps the time of the start and of the last lap, and each lap time is the difference from the last lap and each total the difference from the start."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_LapTiming a owl:NamedIndividual, rd:IOExample ; rdfs:label "[round(t - s, 2) for s, t in zip([0, 3.56, 8.63], [3.56, 8.63, 17.68])] evaluates to [3.56, 5.07, 9.05]"@en ; chx:input "[round(t - s, 2) for s, t in zip([0, 3.56, 8.63], [3.56, 8.63, 17.68])]" ; chx:output "[3.56, 5.07, 9.05]" .
chx:X_LapTiming rd:hasIOExample chx:IO_LapTiming .
chx:X_PrettifiedLaps a owl:NamedIndividual, chx:PrettifiedLaps ; rdfs:label "str(lap).rjust(6)"@en ; skos:definition "rjust pads a text on the left to a fixed width, so the lap numbers and times line up in columns."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_PrettifiedLaps a owl:NamedIndividual, rd:IOExample ; rdfs:label "'Lap #' + str(1).rjust(2) + ': ' + str(3.56).rjust(6) + ' (' + str(3.56).rjust(6) + ')' evaluates to 'Lap # 1:   3.56 (  3.56)'"@en ; chx:input "'Lap #' + str(1).rjust(2) + ': ' + str(3.56).rjust(6) + ' (' + str(3.56).rjust(6) + ')'" ; chx:output "'Lap # 1:   3.56 (  3.56)'" .
chx:X_PrettifiedLaps rd:hasIOExample chx:IO_PrettifiedLaps .
chx:X_InterruptToStop a owl:NamedIndividual, chx:InterruptToStop ; rdfs:label "except KeyboardInterrupt:"@en ; skos:definition "Pressing Ctrl-C raises KeyboardInterrupt, which the stopwatch catches to end quietly; it is a subclass of BaseException and not of Exception."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_InterruptToStop a owl:NamedIndividual, rd:IOExample ; rdfs:label "issubclass(KeyboardInterrupt, Exception) evaluates to False"@en ; chx:input "issubclass(KeyboardInterrupt, Exception)" ; chx:output "False" .
chx:X_InterruptToStop rd:hasIOExample chx:IO_InterruptToStop .
chx:X_CountdownLoop a owl:NamedIndividual, chx:CountdownLoop ; rdfs:label "while time_left > 0:"@en ; skos:definition "The countdown prints the seconds left, sleeps one second and subtracts one until none is left, and then runs the alarm."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_CountdownLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "[t for t in range(5, 0, -1)] evaluates to [5, 4, 3, 2, 1]"@en ; chx:input "[t for t in range(5, 0, -1)]" ; chx:output "[5, 4, 3, 2, 1]" .
chx:X_CountdownLoop rd:hasIOExample chx:IO_CountdownLoop .
chx:X_TimeUntilEvent a owl:NamedIndividual, chx:TimeUntilEvent ; rdfs:label "left = datetime(2027, 1, 1) - datetime.now()"@en ; skos:definition "A long countdown is the timedelta between now and a future moment."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_TimeUntilEvent a owl:NamedIndividual, rd:IOExample ; rdfs:label "str(__import__('datetime').datetime(2027, 1, 1) - __import__('datetime').datetime(2026, 10, 1, 12)) evaluates to '91 days, 12:00:00'"@en ; chx:input "str(__import__('datetime').datetime(2027, 1, 1) - __import__('datetime').datetime(2026, 10, 1, 12))" ; chx:output "'91 days, 12:00:00'" .
chx:X_TimeUntilEvent rd:hasIOExample chx:IO_TimeUntilEvent .
chx:X_ForwardSearch a owl:NamedIndividual, chx:ForwardSearch ; rdfs:label "day += timedelta(days=1)"@en ; skos:definition "The forward finder starts at a date and adds one day at a time, printing the month and year of each date whose day is 13 and whose weekday is Friday, until it has ten."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_ForwardSearch a owl:NamedIndividual, rd:IOExample ; rdfs:label "[d.isoformat() for d in (__import__('datetime').date(2026, 10, 1) + __import__('datetime').timedelta(days=n) for n in range(400)) if d.day == 13 and d.weekday() == 4] evaluates to ['2026-11-13', '2027-08-13']"@en ; chx:input "[d.isoformat() for d in (__import__('datetime').date(2026, 10, 1) + __import__('datetime').timedelta(days=n) for n in range(400)) if d.day == 13 and d.weekday() == 4]" ; chx:output "['2026-11-13', '2027-08-13']" .
chx:X_ForwardSearch rd:hasIOExample chx:IO_ForwardSearch .
chx:X_BackwardSearch a owl:NamedIndividual, chx:BackwardSearch ; rdfs:label "day -= timedelta(days=1)"@en ; skos:definition "The backward finder subtracts one day at a time and must stop at year 1, because subtracting a day from the earliest date raises OverflowError."@en ; dcterms:source <http://example.org/sen0414/ch19/research> .
chx:IO_BackwardSearch a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').date.min evaluates to datetime.date(1, 1, 1)"@en ; chx:input "__import__('datetime').date.min" ; chx:output "datetime.date(1, 1, 1)" .
chx:X_BackwardSearch rd:hasIOExample chx:IO_BackwardSearch .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 19 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch19/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 19 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which clock or date type answers which question about time, and which launching or scheduling construct answers which question about other programs?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs and concepts of the chapter differ in current Python, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 19 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 19 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch19/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-01."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

