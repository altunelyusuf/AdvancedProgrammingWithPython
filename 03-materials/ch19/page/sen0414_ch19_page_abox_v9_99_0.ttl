pg:CE_01 a ipo:CodeExample ; rdfs:label "Epoch timestamp"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 7 of the deck and runs 7 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 1 ;
    sen0414:code "import calendar\nfrom datetime import datetime, UTC\nt = calendar.timegm((2026, 3, 18, 6, 4, 35))\nprint('timestamp:', t)\nprint('zero:', datetime.fromtimestamp(0, UTC).isoformat())\nprint('last:', datetime.fromtimestamp(2**31 - 1, UTC).isoformat())\nprint('wrapped:', datetime.fromtimestamp(-2**31, UTC).isoformat())" ; sen0414:expectedOutput "timestamp: 1773813875\nzero: 1970-01-01T00:00:00+00:00\nlast: 2038-01-19T03:14:07+00:00\nwrapped: 1901-12-13T20:45:52+00:00\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "Which clock"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 8 of the deck and runs 10 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 2 ;
    sen0414:code "import time\nfor name in ('time', 'monotonic', 'perf_counter'):\n    info = time.get_clock_info(name)\n    print(name, info.monotonic, info.adjustable)\nwall, mono = [1000.0, 990.0], [50.0, 60.0]\nprint('wall clock set back 10 s:', wall[1] - wall[0])\nprint('monotonic clock:', mono[1] - mono[0])\nstart = time.monotonic()\ntime.sleep(0.2)\nprint('lasted at least 0.2:', time.monotonic() - start >= 0.2)" ; sen0414:expectedOutput "time False True\nmonotonic True False\nperf_counter True False\nwall clock set back 10 s: -10.0\nmonotonic clock: 10.0\nlasted at least 0.2: True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "Pausing programs"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 10 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 3 ;
    sen0414:code "import time\nstart = time.monotonic()\nresult = time.sleep(0.2)\nprint('returns', result, '| at least 0.2:', time.monotonic() - start >= 0.2)\nwork, rounds = 0.02, 3600\nprint('sleep after work:', round((rounds - 1) * (work + 1.0), 2))\nprint('fixed tick:', round((rounds - 1) * 1.0, 2))" ; sen0414:expectedOutput "returns None | at least 0.2: True\nsleep after work: 3670.98\nfixed tick: 3599.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Stopwatch laps"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 11 of the deck and runs 13 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 11 ; sen0414:orderInTab 4 ;
    sen0414:code "now = [1000.0]\ndef clock():\n    return now[0]\nstart_time = last_time = clock()\nlap_number = 1\ngaps = (3.56, 5.07, 9.05, 1.43)\nfor gap in gaps:\n    now[0] += gap\n    lap_time = round(clock() - last_time, 2)\n    total_time = round(clock() - start_time, 2)\n    print(f'Lap #{lap_number}: {total_time} ({lap_time})')\n    lap_number += 1\n    last_time = clock()" ; sen0414:expectedOutput "Lap #1: 3.56 (3.56)\nLap #2: 8.63 (5.07)\nLap #3: 17.68 (9.05)\nLap #4: 19.11 (1.43)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "Durations"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 15 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 15 ; sen0414:orderInTab 5 ;
    sen0414:code "from datetime import datetime, timedelta\nd = timedelta(days=11, hours=10, minutes=9, seconds=8)\nprint(d.days, d.seconds, d.total_seconds())\ntry:\n    timedelta(months=1)\nexcept TypeError:\n    print('TypeError: timedelta has no months')\nstart = datetime(2026, 10, 21, 16, 29)\nback = start - timedelta(days=365 * 30)\nprint(back.date(), start.replace(year=1996).date())" ; sen0414:expectedOutput "11 36548 986948.0\nTypeError: timedelta has no months\n1996-10-28 1996-10-21\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "datetime to string"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 16 of the deck and runs 8 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 6 ;
    sen0414:code "from datetime import datetime\ndt = datetime(2026, 11, 3, 16, 29, 7)\nprint(dt.strftime('%Y/%m/%d %H:%M:%S'))\nprint(dt.strftime('%I:%M %p'))\nprint(dt.strftime('%A, %B %d'))\nprint(dt.strftime('%j %w'))\nprint(dt.isoformat())\nprint(datetime.fromisoformat('2026-11-03T16:29:07'))" ; sen0414:expectedOutput "2026/11/03 16:29:07\n04:29 PM\nTuesday, November 03\n307 2\n2026-11-03T16:29:07\n2026-11-03 16:29:07\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "String to datetime"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 17 of the deck and runs 7 lines of Python that print 8 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 17 ; sen0414:orderInTab 7 ;
    sen0414:code "from datetime import datetime\nprint(datetime.strptime('October 21, 2026', '%B %d, %Y'))\nfor text in ('2026-10-21', 'Oct 21, 2026'):\n    try: datetime.strptime(text, '%B %d, %Y')\n    except ValueError as e: print('ValueError:', e)\nfor text in ('00', '26', '68', '69', '99'):\n    print(text, datetime.strptime(text, '%y').year)" ; sen0414:expectedOutput "2026-10-21 00:00:00\nValueError: time data '2026-10-21' does not match format '%B %d, %Y'\nValueError: time data 'Oct 21, 2026' does not match format '%B %d, %Y'\n00 2000\n26 2026\n68 2068\n69 1969\n99 1999\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Time zones"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 19 of the deck and runs 9 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 8 ;
    sen0414:code "from datetime import datetime, UTC\nfrom zoneinfo import ZoneInfo\nnaive = datetime(2026, 10, 21, 16, 29)\naware = naive.replace(tzinfo=UTC)\nprint(naive == aware)\ntry: naive - aware\nexcept TypeError as e: print('TypeError:', e)\nfor zone in ('America/Los_Angeles', 'UTC', 'Europe/Istanbul'):\n    print(zone, datetime.fromtimestamp(1000000, ZoneInfo(zone)).isoformat())" ; sen0414:expectedOutput "False\nTypeError: can't subtract offset-naive and offset-aware datetimes\nAmerica/Los_Angeles 1970-01-12T05:46:40-08:00\nUTC 1970-01-12T13:46:40+00:00\nEurope/Istanbul 1970-01-12T15:46:40+02:00\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Daylight saving time"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 20 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 20 ; sen0414:orderInTab 9 ;
    sen0414:code "from datetime import datetime, timedelta, UTC\nfrom zoneinfo import ZoneInfo\nny = ZoneInfo('America/New_York')\nx = datetime(2026, 3, 7, 12, tzinfo=ny)\ny = x + timedelta(days=1)\nprint('wall:', y - x)\nprint('real:', y.astimezone(UTC) - x.astimezone(UTC))\nfirst = datetime(2026, 11, 1, 1, 30, tzinfo=ny)\nsecond = first.replace(fold=1)\na, b = first.astimezone(UTC), second.astimezone(UTC)\nprint(a.hour, b.hour, first == second)" ; sen0414:expectedOutput "wall: 1 day, 0:00:00\nreal: 23:00:00\n5 6 True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "subprocess.run"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 24 of the deck and runs 7 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 10 ;
    sen0414:code "import subprocess, sys\nchild = 'import sys; print('out'); print('err', file=sys.stderr)'\ncommand = [sys.executable, '-c', child]\ndone = subprocess.run(command, capture_output=True)\nprint(done.returncode, done.stdout, done.stderr)\ndone = subprocess.run(command, capture_output=True, text=True)\nprint(type(done.stdout).__name__, repr(done.stdout))" ; sen0414:expectedOutput "0 b'out\\n' b'err\\n'\nstr 'out\\n'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "subprocess.Popen"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 25 of the deck and runs 10 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 11 ;
    sen0414:code "import subprocess\np = subprocess.Popen(['sleep', '0.4'])\nprint('poll():', p.poll())\nprint('wait():', p.wait())\nprint('poll():', p.poll())\nfor call in (['nosuch'], ['false']):\n    try:\n        subprocess.run(call, check=True)\n    except Exception as e:\n        print(type(e).__name__, e)" ; sen0414:expectedOutput "poll(): None\nwait(): 0\npoll(): 0\nFileNotFoundError [Errno 2] No such file or directory: 'nosuch'\nCalledProcessError Command '['false']' returned non-zero exit status 1.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "Exit codes"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 26 of the deck and runs 6 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 12 ;
    sen0414:code "import subprocess, sys\ndef code_of(source):\n    return subprocess.run([sys.executable, '-c', source], stderr=subprocess.DEVNULL).returncode\nkill = 'import os, signal; os.kill(os.getpid(), signal.SIG%s)'\nprint(code_of('pass'), code_of('import sys; sys.exit(3)'), code_of('raise ValueError'))\nprint(code_of(kill % 'KILL'), code_of(kill % 'TERM'))" ; sen0414:expectedOutput "0 3 1\n-9 -15\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Shell safety"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 27 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 27 ; sen0414:orderInTab 13 ;
    sen0414:code "import subprocess, shlex\ndef sh(args, **kw):\n    return subprocess.run(args, capture_output=True, text=True, **kw).stdout\nname = 'x; echo INJECTED'\nprint(repr(sh(f'echo opening {name}', shell=True)))\nprint(repr(sh(f'echo opening {shlex.quote(name)}', shell=True)))\nprint(repr(sh(['echo', 'opening', name])))" ; sen0414:expectedOutput "'opening x\\nINJECTED\\n'\n'opening x; echo INJECTED\\n'\n'opening x; echo INJECTED\\n'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "In-process scheduler"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 32 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 14 ;
    sen0414:code "import sched\nnow, log = [0.0], []\ndef clock(): return now[0]\ndef advance(seconds): now[0] += seconds\ns = sched.scheduler(clock, advance)\njobs = ((5, 1, 'five'), (2, 1, 'two'), (5, 0, 'five-0'), (0, 9, 'now'))\nfor delay, priority, name in jobs:\n    s.enter(delay, priority, log.append, (name,))\ns.run()\nprint(log, now[0])" ; sen0414:expectedOutput "['now', 'two', 'five-0', 'five'] 5.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "Cron fields"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 33 of the deck and runs 13 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 33 ; sen0414:orderInTab 15 ;
    sen0414:code "from datetime import datetime, timedelta\ndef matches(text, value):\n    return text == '*' or str(value) in text.split(',')\ndef next_run(fields, t):\n    while True:\n        t += timedelta(minutes=1)\n        now = (t.minute, t.hour, t.isoweekday() % 7)\n        if all(map(matches, fields, now)):\n            return t\nstart = datetime(2026, 10, 13, 9, 30)\nfmt = '%Y-%m-%d %H:%M %a'\nprint(next_run(('30', '9', '1,2,3,4,5'), start).strftime(fmt))\nprint(next_run(('0', '0', '5'), start).strftime(fmt))" ; sen0414:expectedOutput "2026-10-14 09:30 Wed\n2026-10-16 00:00 Fri\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "Countdown timer"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 37 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 16 ;
    sen0414:code "now = [0.0]\ntime_left = 5\nwhile time_left > 0:\n    print(time_left, end=' ')\n    now[0] += 1\n    time_left = time_left - 1\nprint()\nprint('counted', now[0], 'seconds; the alarm needs a sound card')" ; sen0414:expectedOutput "5 4 3 2 1 \ncounted 5.0 seconds; the alarm needs a sound card\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "Prettified stopwatch"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 38 of the deck and runs 3 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 38 ; sen0414:orderInTab 17 ;
    sen0414:code "rows = [(1, 3.56, 3.56), (2, 8.63, 5.07), (3, 17.68, 9.05), (4, 19.11, 1.43)]\nfor number, total, lap in rows:\n    print('Lap #' + str(number).rjust(2) + ': ' + str(total).rjust(6) + ' (' + str(lap).rjust(6) + ')')" ; sen0414:expectedOutput "Lap # 1:   3.56 (  3.56)\nLap # 2:   8.63 (  5.07)\nLap # 3:  17.68 (  9.05)\nLap # 4:  19.11 (  1.43)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "Friday the 13th"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 39 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch19/page/chapter_code_ch19_v1_2_0.json" ;
    sen0414:slideNumber 39 ; sen0414:orderInTab 18 ;
    sen0414:code "from datetime import date, timedelta\nday = date(2026, 10, 13)\nfound = []\nwhile len(found) < 10:\n    if day.day == 13 and day.weekday() == 4:\n        found.append(day.isoformat())\n    day += timedelta(days=1)\nprint(found[0], '...', found[-1])\nprint(len(found), 'dates')" ; sen0414:expectedOutput "2026-11-13 ... 2032-08-13\n10 dates\n" .
