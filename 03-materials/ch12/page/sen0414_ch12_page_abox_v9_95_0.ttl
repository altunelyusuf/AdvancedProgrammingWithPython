pg:CE_01 a ipo:CodeExample ; rdfs:label "cd and pwd as os calls"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 7 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 1 ;
    sen0414:code "import os, tempfile\nstart = os.getcwd()\nwith tempfile.TemporaryDirectory() as lab:\n    os.chdir(lab)\n    os.mkdir('Desktop')\n    os.chdir('Desktop')  # cd Desktop\n    where = os.path.basename(os.getcwd())  # pwd\n    os.chdir('..')  # cd ..\n    os.chdir(start)\nprint('pwd ->', where)" ; sen0414:expectedOutput "pwd -> Desktop\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "ls and dir as os.listdir"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 8 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 2 ;
    sen0414:code "import os, tempfile\nwith tempfile.TemporaryDirectory() as lab:\n    for name in ('spam.exe', 'eggs.exe', 'notes.txt'):\n        open(os.path.join(lab, name), 'w').close()\n    listing = sorted(os.listdir(lab))  # ls\n    programs = [n for n in listing if n.endswith('.exe')]  # dir *.exe\nprint('ls ->', listing)\nprint('dir *.exe ->', programs)" ; sen0414:expectedOutput "ls -> ['eggs.exe', 'notes.txt', 'spam.exe']\ndir *.exe -> ['eggs.exe', 'spam.exe']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "PATH is a text of folders"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 9 of the deck and runs 5 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 3 ;
    sen0414:code "PATH = '/home/al/bin:/usr/local/bin:/usr/bin:/bin'\nfolders = PATH.split(':')\nprint(len(folders), 'folders')\nprint('/usr/bin is number', folders.index('/usr/bin') + 1)\nprint(':'.join(['/home/al/Scripts'] + folders[:2]))" ; sen0414:expectedOutput "4 folders\n/usr/bin is number 3\n/home/al/Scripts:/home/al/bin:/usr/local/bin\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "shutil.which walks the folders"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 10 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 4 ;
    sen0414:code "import os, shutil, tempfile\nwith tempfile.TemporaryDirectory() as lab:\n    for d in ('a', 'b'):\n        os.mkdir(lab + '/' + d)\n        prog = lab + '/' + d + '/spam'\n        open(prog, 'w').close()\n        os.chmod(prog, 0o744)\n    path = lab + '/a:' + lab + '/b'\n    where = os.path.relpath(shutil.which('spam', path=path), lab)\nprint('first spam is in', where)\nprint('eggs found:', shutil.which('eggs', path=path))" ; sen0414:expectedOutput "first spam is in a/spam\neggs found: None\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "pyvenv.cfg is a settings file"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 13 of the deck and runs 3 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 13 ; sen0414:orderInTab 5 ;
    sen0414:code "cfg = 'home = /usr/bin\\ninclude-system-site-packages = false'\nsettings = dict(line.split(' = ') for line in cfg.splitlines())\nprint(settings)" ; sen0414:expectedOutput "{'home': '/usr/bin', 'include-system-site-packages': 'false'}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "activate edits PATH"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 14 of the deck and runs 5 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 6 ;
    sen0414:code "import sys\nbin_dir = '/home/al/Scripts/.venv/bin'\nPATH = '/usr/local/bin:/usr/bin:/bin'\nprint('after activate:', bin_dir + ':' + PATH)\nprint('inside a virtual environment:', sys.prefix != sys.base_prefix)" ; sen0414:expectedOutput "after activate: /home/al/Scripts/.venv/bin:/usr/local/bin:/usr/bin:/bin\ninside a virtual environment: False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "pip requirement and find_spec"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 15 of the deck and runs 6 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 15 ; sen0414:orderInTab 7 ;
    sen0414:code "requirement = 'package_name==1.17.4'\nname, sep, version = requirement.partition('==')\nprint(name, sep, version)\nimport importlib.util, json\nprint(type(json).__name__)\nprint('pyperclip missing:', importlib.util.find_spec('pyperclip') is None)" ; sen0414:expectedOutput "package_name == 1.17.4\nmodule\npyperclip missing: True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "os.name, sys.version_info and __file__"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 19 of the deck and runs 6 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 8 ;
    sen0414:code "import os, sys\nKINDS = {'nt': 'Windows', 'posix': 'macOS or Linux'}\nprint('os.name is', os.name, '->', KINDS[os.name])\nprint('Python 3.9 or newer:', sys.version_info >= (3, 9))\nprint('version fields:', len(sys.version_info))\nprint('started from a file:', '__file__' in globals())" ; sen0414:expectedOutput "os.name is posix -> macOS or Linux\nPython 3.9 or newer: True\nversion fields: 5\nstarted from a file: False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "ModuleNotFoundError and sys.exit"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 20 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 20 ; sen0414:orderInTab 9 ;
    sen0414:code "import sys\ntry:\n    import nonexistentModule\nexcept ModuleNotFoundError as err:\n    print('Result: no module called', err.name)\n    try:\n        sys.exit('This program needs nonexistentModule.')\n    except SystemExit as stop:\n        print('exit message:', stop.code)" ; sen0414:expectedOutput "Result: no module called nonexistentModule\nexit message: This program needs nonexistentModule.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "sys.argv and shlex.split"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 21 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 21 ; sen0414:orderInTab 10 ;
    sen0414:code "import shlex\ntyped = ['python3 yourScript.py hello world',\n         'python3 yourScript.py 'hello world'',\n         'python3 yourScript.py']\nfor line in typed:\n    argv = shlex.split(line)[1:]\n    print(len(argv), argv)" ; sen0414:expectedOutput "3 ['yourScript.py', 'hello', 'world']\n2 ['yourScript.py', 'hello world']\n1 ['yourScript.py']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "argparse declares the arguments"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 22 of the deck and runs 6 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 11 ;
    sen0414:code "import argparse\np = argparse.ArgumentParser(prog='snowstorm', exit_on_error=False)\np.add_argument('density', type=int, nargs='?', default=4)\np.add_argument('-v', '--verbose', action='store_true')\nfor argv in ([], ['20', '-v']):\n    print(argv, '->', vars(p.parse_args(argv)))" ; sen0414:expectedOutput "[] -> {'density': 4, 'verbose': False}\n['20', '-v'] -> {'density': 20, 'verbose': True}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "argparse refuses a wrong word"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 23 of the deck and runs 7 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 12 ;
    sen0414:code "import argparse\np = argparse.ArgumentParser(prog='snowstorm', exit_on_error=False)\np.add_argument('density', type=int)\ntry:\n    p.parse_args(['lots'])\nexcept argparse.ArgumentError as err:\n    print('Result: refused,', err)" ; sen0414:expectedOutput "Result: refused, argument density: invalid int value: 'lots'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Quiet, default and verbose"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 26 of the deck and runs 8 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 13 ;
    sen0414:code "import argparse\np = argparse.ArgumentParser(prog='backup', exit_on_error=False)\np.add_argument('-v', '--verbose', action='store_true')\np.add_argument('-q', '--quiet', action='store_true')\nsteps = ['reading 3 files', 'zipping', 'saved backup.zip']\nreport = lambda a: [] if a.quiet else steps if a.verbose else steps[-1:]\nfor argv in ([], ['-v'], ['-q']):\n    print(argv, '->', report(p.parse_args(argv)))" ; sen0414:expectedOutput "[] -> ['saved backup.zip']\n['-v'] -> ['reading 3 files', 'zipping', 'saved backup.zip']\n['-q'] -> []\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "chr and the clear command"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 29 of the deck and runs 6 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 14 ;
    sen0414:code "import os\nclear_command = 'cls' if os.name == 'nt' else 'clear'\nprint('os.system would run:', clear_command)\nTOP, BOTTOM, FULL = chr(9600), chr(9604), chr(9608)\nprint([ord(c) for c in (TOP, BOTTOM, FULL)])\nprint(TOP * 10 + BOTTOM * 10 + FULL * 10)" ; sen0414:expectedOutput "os.system would run: clear\n[9600, 9604, 9608]\n▀▀▀▀▀▀▀▀▀▀▄▄▄▄▄▄▄▄▄▄██████████\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "Colour names as escape codes"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 30 of the deck and runs 6 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 30 ; sen0414:orderInTab 15 ;
    sen0414:code "COLORS = ['black', 'red', 'green', 'yellow',\n          'blue', 'purple', 'cyan', 'white']\nfg = lambda name: '\\x1b[%dm' % (30 + COLORS.index(name))\nbg = lambda name: '\\x1b[%dm' % (40 + COLORS.index(name))\nprint(repr(fg('red') + bg('blue') + 'hi' + '\\x1b[0m'))\nprint([fg(c)[2:-1] for c in COLORS])" ; sen0414:expectedOutput "'\\x1b[31m\\x1b[44mhi\\x1b[0m'\n['30', '31', '32', '33', '34', '35', '36', '37']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "One snowstorm frame"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 32 of the deck and runs 11 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 16 ;
    sen0414:code "import random\nTOP, BOTTOM = chr(9600), chr(9604)\nargv = ['snowstorm.py', '20']\nDENSITY = int(argv[1]) if len(argv) > 1 else 4\nrandom.seed(12)\ndef cell():\n    snow = random.randint(0, 99) < DENSITY\n    return random.choice([TOP, BOTTOM]) if snow else ' '\nrows = [''.join(cell() for x in range(40)) for y in range(5)]\nprint('flakes per row:', [len(r) - r.count(' ') for r in rows])\nprint('\\n'.join(rows))" ; sen0414:expectedOutput "flakes per row: [12, 6, 7, 5, 8]\n      ▄▄        ▀     ▀▄  ▀▀▄ ▄▄    ▀ ▄ \n        ▀         ▄         ▄ ▀   ▄   ▀ \n▄▄      ▄                   ▄    ▀  ▄  ▀\n    ▀              ▄           ▀ ▀   ▀  \n ▄ ▄  ▄          ▀▀▄   ▄         ▀      \n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "The launcher script, line by line"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 36 of the deck and runs 5 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 36 ; sen0414:orderInTab 17 ;
    sen0414:code "launcher = '#!/usr/bin/env bash\\nsource ~/Scripts/.venv/bin/activate\\n'\nlauncher += 'python3 ~/Scripts/yourScript.py '$@'\\n'\nfor number, line in enumerate(launcher.splitlines(), 1):\n    print(number, line)\nprint('interpreter:', launcher.splitlines()[0][2:].split())" ; sen0414:expectedOutput "1 #!/usr/bin/env bash\n2 source ~/Scripts/.venv/bin/activate\n3 python3 ~/Scripts/yourScript.py '$@'\ninterpreter: ['/usr/bin/env', 'bash']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "chmod u+x makes it a command"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 37 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 18 ;
    sen0414:code "import os, shutil, stat, tempfile\nfrom pathlib import Path\nwith tempfile.TemporaryDirectory() as scripts:\n    path = Path(scripts, 'yourScript')\n    path.write_text('#!/usr/bin/env bash\\n')\n    path.chmod(0o644)\n    before = stat.filemode(path.stat().st_mode)\n    path.chmod(path.stat().st_mode | stat.S_IXUSR)  # chmod u+x\n    after = stat.filemode(path.stat().st_mode)\n    on_path = shutil.which('yourScript', path=scripts) == str(path)\nprint(before, '->', after, '| found on PATH:', on_path)" ; sen0414:expectedOutput "-rw-r--r-- -> -rwxr--r-- | found on PATH: True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "A .desktop entry with configparser"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 39 of the deck and runs 8 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 39 ; sen0414:orderInTab 19 ;
    sen0414:code "import configparser\nentry = ('[Desktop Entry]\\n'\n         'Name=yourScript\\n'\n         'Exec=gnome-terminal -- /home/al/Scripts/yourScript\\n'\n         'Type=Application\\n')\nc = configparser.ConfigParser()\nc.read_string(entry)\nprint(dict(c['Desktop Entry']))" ; sen0414:expectedOutput "{'name': 'yourScript', 'exec': 'gnome-terminal -- /home/al/Scripts/yourScript', 'type': 'Application'}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "ccwd copies the working directory"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 40 of the deck and runs 12 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 40 ; sen0414:orderInTab 20 ;
    sen0414:code "import os\nclipboard = []\ndef ccwd(argv):\n    if len(argv) > 1:\n        os.chdir(argv[1])\n    clipboard.append(os.getcwd())\nstart = os.getcwd()\nos.chdir('/tmp')\nterminal = os.getcwd()  # where the terminal stands\nccwd(['ccwd.py', '..'])\nprint('clipboard', clipboard[-1], '| terminal', terminal)\nos.chdir(start)" ; sen0414:expectedOutput "clipboard / | terminal /tmp\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "Clipboard recorder loop"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 41 of the deck and runs 11 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 41 ; sen0414:orderInTab 21 ;
    sen0414:code "texts = ['ch11', 'ch11', 'ch12', 'ch12', 'ch13']\nprevious_content, recorded = '', []\ntry:\n    for content in texts:  # the book calls paste()\n        if content != previous_content:\n            print(content)\n            recorded.append(content)\n            previous_content = content\n    raise KeyboardInterrupt  # the user presses CTRL-C\nexcept KeyboardInterrupt:\n    print('Result: stopped quietly;', len(recorded), 'recorded')" ; sen0414:expectedOutput "ch11\nch12\nch13\nResult: stopped quietly; 3 recorded\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
pg:CE_22 a ipo:CodeExample ; rdfs:label "The PyInstaller command line"@en ;
    skos:definition "Example 22 of the chapter-code tab comes from slide 42 of the deck and runs 8 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 42 ; sen0414:orderInTab 22 ;
    sen0414:code "import shlex\ncommand = 'python -m PyInstaller --onefile yourScript.py'\nwords = shlex.split(command)\nprint(len(words), 'words:', words)\nroles = {'-m': 'run a module', '--onefile': 'bundle into one file'}\nprint({w: roles[w] for w in words if w in roles})\nleft = ['build/', 'dist/', 'yourScript.spec']\nprint('the build leaves:', left)" ; sen0414:expectedOutput "5 words: ['python', '-m', 'PyInstaller', '--onefile', 'yourScript.py']\n{'-m': 'run a module', '--onefile': 'bundle into one file'}\nthe build leaves: ['build/', 'dist/', 'yourScript.spec']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_22 .
pg:CE_23 a ipo:CodeExample ; rdfs:label "Launchers for earlier projects"@en ;
    skos:definition "Example 23 of the chapter-code tab comes from slide 44 of the deck and runs 4 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch12/page/chapter_code_ch12_v1_0_0.json" ;
    sen0414:slideNumber 44 ; sen0414:orderInTab 23 ;
    sen0414:code "LINE = 'python3 ~/Scripts/{name}.py '$@''  # third line of a launcher\nprojects = {'zipBackup': 11, 'extractContacts': 9, 'wikiBullets': 8, 'chessboard': 7}\nfor name, chapter in projects.items():\n    print(name.ljust(16), 'chapter', chapter, '|', LINE.format(name=name))" ; sen0414:expectedOutput "zipBackup        chapter 11 | python3 ~/Scripts/zipBackup.py '$@'\nextractContacts  chapter 9 | python3 ~/Scripts/extractContacts.py '$@'\nwikiBullets      chapter 8 | python3 ~/Scripts/wikiBullets.py '$@'\nchessboard       chapter 7 | python3 ~/Scripts/chessboard.py '$@'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_23 .
