pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Navigate folders and run programs from a terminal, and explain how the terminal finds a program through the PATH environment variable"@en ;
    skos:definition "The objective is met when the reader can navigate folders and run programs from a terminal, and explain how the terminal finds a program through the PATH environment variable, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter12.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Create, activate and recognise a virtual environment, and install, pin and remove packages in it with python -m pip"@en ;
    skos:definition "The objective is met when the reader can create, activate and recognise a virtual environment, and install, pin and remove packages in it with python -m pip, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter12.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Write programs that read their command line arguments from sys.argv or argparse, inspect their own file, interpreter and operating system, and exit with a message and an exit code"@en ;
    skos:definition "The objective is met when the reader can write programs that read their command line arguments from sys.argv or argparse, inspect their own file, interpreter and operating system, and exit with a message and an exit code, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter12.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Design a text-based program's interface - its name, arguments, clipboard input and output, screen clearing and verbosity"@en ;
    skos:definition "The objective is met when the reader can design a text-based program's interface - its name, arguments, clipboard input and output, screen clearing and verbosity, at the create level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter12.html> ;
    ld:bloomLevel ld:Create  .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Deploy a script with a launcher file or PyInstaller, and analyze why a launcher fails to forward arguments, run, or stay open"@en ;
    skos:definition "The objective is met when the reader can deploy a script with a launcher file or PyInstaller, and analyze why a launcher fails to forward arguments, run, or stay open, at the analyze level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter12.html> ;
    ld:bloomLevel ld:Analyze  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "On Ubuntu, PATH lists /home/al/bin and then /usr/bin, and only /usr/bin and /home/al/bin/tools hold a program named spam. What runs when spam is typed?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "The terminal searches the PATH folders themselves, not the folders inside them." ;
    ld:distractorRationale "That is Windows; macOS and Linux check only the PATH folders." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "/usr/bin/spam, because subfolders of a PATH folder are never searched" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "/home/al/bin/tools/spam, because /home/al/bin comes first" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "Nothing: Ubuntu first checks the current folder and stops there" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A file named example sits in the current folder of a Linux terminal, which is not on PATH. How is it run?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Linux and macOS do not search the current folder for a bare name." ;
    ld:distractorRationale "There is no run command; the path is what matters." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "./example" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "example" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "run example" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does activating a virtual environment change?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "Activation is for one window; the export line in .bashrc is what affects new windows." ;
    ld:distractorRationale "The environment is separate from the system Python; nothing there changes." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "PATH and the prompt, in the current terminal window only" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "PATH in every terminal window opened afterwards" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "The system Python's own installed packages" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A fresh .venv is created with python -m venv .venv under Python 3.14 and python -m pip list is run inside it. What is listed?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "The chapter's listing shows setuptools, but since Python 3.12 venv no longer pre-installs it." ;
    ld:distractorRationale "A new environment starts without the original installation's packages." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "pip alone" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "pip and setuptools" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "Every package installed in the original Python" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why does the chapter run pip as python -m pip rather than as pip?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "pip is a program of its own; the chapter only prefers the module form." ;
    ld:distractorRationale "Speed has nothing to do with it; a pip on PATH may belong to another installation." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "It installs into exactly the Python that python starts" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "pip cannot be run by itself" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "It downloads packages faster" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What is sys.argv when python3 yourScript.py 'hello world' is typed?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "The quotation marks keep the two words together as one argument." ;
    ld:distractorRationale "The interpreter's own name is not part of the script's sys.argv." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "['yourScript.py', 'hello world']" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "['yourScript.py', 'hello', 'world']" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "['python3', 'yourScript.py', 'hello world']" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A script calls sys.exit('needs pyperclip'). What does the terminal see?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "A string argument goes to standard error and means failure." ;
    ld:distractorRationale "SystemExit ends the program without a traceback." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "The text on standard error and exit code 1" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "The text on standard output and exit code 0" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "A traceback ending in SystemExit" .
pg:Q8 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does os.system('cls' if os.name == 'nt' else 'clear') run on Ubuntu?"@en ; ld:hasOption pg:Q8_O0, pg:Q8_O1, pg:Q8_O2 ; ld:hasCorrectOption pg:Q8_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "The conditional expression gives cls only when os.name is 'nt'." ;
    ld:distractorRationale "It works only in a terminal, not in Mu or another editor." .
pg:Q8_O0 a ld:AnswerOption ; rdfs:label "clear, because os.name is 'posix'" .
pg:Q8_O1 a ld:AnswerOption ; rdfs:label "cls, because the condition is checked first" .
pg:Q8_O2 a ld:AnswerOption ; rdfs:label "Nothing: it only works in Mu" .
pg:Q9 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Under the Unix philosophy, what should a command print by default?"@en ; ld:hasOption pg:Q9_O0, pg:Q9_O1, pg:Q9_O2 ; ld:hasCorrectOption pg:Q9_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "The chapter calls silence by default the better choice." ;
    ld:distractorRationale "Sound is easily overused and wasted on a muted computer." .
pg:Q9_O0 a ld:AnswerOption ; rdfs:label "Only what another command could use, with --verbose for more" .
pg:Q9_O1 a ld:AnswerOption ; rdfs:label "Every step it takes, with --quiet to hide it" .
pg:Q9_O2 a ld:AnswerOption ; rdfs:label "Nothing ever; it should use sound instead" .
pg:Q10 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "The chapter's Ubuntu launcher runs python3 ~/Scripts/yourScript.py and is started as yourScript spam eggs. What is sys.argv[1:] in the script?"@en ; ld:hasOption pg:Q10_O0, pg:Q10_O1, pg:Q10_O2 ; ld:hasCorrectOption pg:Q10_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "Only with '$@' after the script's path, like %* in a batch file, would they arrive." ;
    ld:distractorRationale "The launcher's own name is not passed on either." .
pg:Q10_O0 a ld:AnswerOption ; rdfs:label "[] - the launcher forwards nothing" .
pg:Q10_O1 a ld:AnswerOption ; rdfs:label "['spam', 'eggs']" .
pg:Q10_O2 a ld:AnswerOption ; rdfs:label "['yourScript', 'spam', 'eggs']" .
pg:Q11 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A shell script launcher has the right shebang line but Linux refuses to run it by name. What is the likeliest fix?"@en ; ld:hasOption pg:Q11_O0, pg:Q11_O1, pg:Q11_O2 ; ld:hasCorrectOption pg:Q11_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "The shebang line already identifies the file; no extension is needed." ;
    ld:distractorRationale "@pause is a Windows batch command and keeps a window open; it does not make a file runnable." .
pg:Q11_O0 a ld:AnswerOption ; rdfs:label "chmod u+x on the file" .
pg:Q11_O1 a ld:AnswerOption ; rdfs:label "Rename it to yourScript.sh" .
pg:Q11_O2 a ld:AnswerOption ; rdfs:label "Add @pause at the end" .
pg:Q12 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why is a PyInstaller Hello, world executable megabytes in size?"@en ; ld:hasOption pg:Q12_O0, pg:Q12_O1, pg:Q12_O2 ; ld:hasCorrectOption pg:Q12_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "PyInstaller does not compile Python into machine code." ;
    ld:distractorRationale "Documentation is not part of the bundle; the interpreter is." .
pg:Q12_O0 a ld:AnswerOption ; rdfs:label "It contains a copy of the Python interpreter" .
pg:Q12_O1 a ld:AnswerOption ; rdfs:label "It is compiled into unoptimised machine code" .
pg:Q12_O2 a ld:AnswerOption ; rdfs:label "It includes the whole standard library documentation" .
pg:Terminal a ipo:ChapterSection ; rdfs:label "Terminal"@en ;
    skos:definition "Chapter 12 starts where every earlier chapter stopped, at the point where a program has to run without the code editor that wrote it, and it starts with the terminal, the text window in which a program is started by typing its name (Sweigart, 2025). The chapter calls deployment the process of making software usable outside the editor, and the terminal is the first place that happens."@en ; dcterms:source <http://example.org/sen0414/ch12#S_Terminal> ;
    sen0414:anchor "#s-Terminal" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Terminal .
pg:ProgramVocabulary a ipo:ChapterSection ; rdfs:label "Program vocabulary"@en ;
    skos:definition "The chapter lists seven words that can all fairly be called a program, and the differences between them are about how the program is run rather than what it does: a program, a script, a command, a shell script, an application, an app and a web app (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ProgramVocabulary> ;
    sen0414:anchor "#s-ProgramVocabulary" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Terminal .
pg:Page ipo:coversChapterSection pg:ProgramVocabulary .
pg:InterpretedScript a ipo:ChapterSection ; rdfs:label "Interpreted script"@en ;
    skos:definition "A script is a program that an interpreter runs from its source code rather than from a compiled, machine-code form, a loose term that the chapter applies to Python programs although Python code can be bundled into an executable as well (Sweigart, 2025). Under Python 3.14.6, compile() turned the one-line source print(42), named yourScript.py, into a code object, which is the form the interpreter actually runs, so even an interpreted script is translated before it runs, only not into machine code (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_InterpretedScript> ;
    sen0414:anchor "#s-InterpretedScript" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ProgramVocabulary .
pg:Page ipo:coversChapterSection pg:InterpretedScript .
pg:TerminalCommand a ipo:ChapterSection ; rdfs:label "Terminal command"@en ;
    skos:definition "A command is a program that is often run from a text-based terminal and has no graphical user interface; everything it needs is given up front as command line arguments, although an interactive command may stop to ask a question such as Are you sure? Y/N (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_TerminalCommand> ;
    sen0414:anchor "#s-TerminalCommand" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ProgramVocabulary .
pg:Page ipo:coversChapterSection pg:TerminalCommand .
pg:ShellScript a ipo:ChapterSection ; rdfs:label "Shell script"@en ;
    skos:definition "A shell script is a single text file that runs several terminal commands in one batch, so that a user runs one file instead of typing each command; on macOS and Linux it has a .sh extension or none, and Windows calls it a batch file, with the .bat extension (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ShellScript> ;
    sen0414:anchor "#s-ShellScript" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ProgramVocabulary .
pg:Page ipo:coversChapterSection pg:ShellScript .
pg:NavigatingFolders a ipo:ChapterSection ; rdfs:label "Navigating folders"@en ;
    skos:definition "A terminal, like a running program, has a current working directory, and moving it, listing it and running what is in it are the three everyday jobs of the command line (Sweigart, 2025). The prompt itself shows the folder on Windows, macOS and Ubuntu, each in its own format."@en ; dcterms:source <http://example.org/sen0414/ch12#S_NavigatingFolders> ;
    sen0414:anchor "#s-NavigatingFolders" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Terminal .
pg:Page ipo:coversChapterSection pg:NavigatingFolders .
pg:ChangeDirectory a ipo:ChapterSection ; rdfs:label "Change directory"@en ;
    skos:definition "The terminal has a current working directory that relative paths are attached to; pwd on macOS and Linux, or cd with no argument on Windows, shows it, and cd followed by a relative or absolute path changes it, with cd .. moving up one folder and a drive letter followed by a colon switching drives on Windows (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ChangeDirectory> ;
    sen0414:anchor "#s-ChangeDirectory" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NavigatingFolders .
pg:Page ipo:coversChapterSection pg:ChangeDirectory .
pg:ListDirectory a ipo:ChapterSection ; rdfs:label "List directory"@en ;
    skos:definition "dir on Windows and ls on macOS and Linux list the files and subfolders of the current working directory, dir *.exe lists only the programs on Windows and file * | grep executable does the same on macOS and Linux (Sweigart, 2025). Inside Python, os.listdir() returns the same names as a list of strings, in no promised order (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ListDirectory> ;
    sen0414:anchor "#s-ListDirectory" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NavigatingFolders .
pg:Page ipo:coversChapterSection pg:ListDirectory .
pg:RunFromTerminal a ipo:ChapterSection ; rdfs:label "Run from terminal"@en ;
    skos:definition "A .py file runs by naming it after python on Windows or python3 on macOS and Linux, either by its absolute path or by a relative one from its own folder; a program in the current folder runs as example.exe on Windows but must be typed as ./example on macOS and Linux; and a file that is not a program, such as example.txt, opens in its associated application when its name is entered on Windows or after open on macOS (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_RunFromTerminal> ;
    sen0414:anchor "#s-RunFromTerminal" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NavigatingFolders .
pg:Page ipo:coversChapterSection pg:RunFromTerminal .
pg:PathVariable a ipo:ChapterSection ; rdfs:label "Path variable"@en ;
    skos:definition "Every running program has environment variables, and PATH, a list of folders, is the one the terminal reads to find a program from its bare name (Sweigart, 2025). The chapter's Ubuntu example lists eleven folders, from /home/al/.local/bin to /snap/bin, separated by colons."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PathVariable> ;
    sen0414:anchor "#s-PathVariable" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Terminal .
pg:Page ipo:coversChapterSection pg:PathVariable .
pg:PathSearchOrder a ipo:ChapterSection ; rdfs:label "Path search order"@en ;
    skos:definition "When a program name is typed, the terminal looks for it in the folders listed in PATH, one after another, and runs the first match; Windows first checks the current working directory and then PATH, whereas macOS and Linux check only PATH, which is why a program in the current folder must be typed as ./example there; and folders below a PATH folder are not searched (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PathSearchOrder> ;
    sen0414:anchor "#s-PathSearchOrder" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PathVariable .
pg:Page ipo:coversChapterSection pg:PathSearchOrder .
pg:PathEditing a ipo:ChapterSection ; rdfs:label "Path editing"@en ;
    skos:definition "To add a folder to PATH on Windows, the user variable Path is edited in the Environment Variables window, with a semicolon before the new folder; on macOS and Linux a line export PATH=/home/al/Scripts:$PATH is added to the bottom of .zshrc or .bashrc, the startup script every new terminal runs, so the change reaches only terminal windows opened afterwards (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PathEditing> ;
    sen0414:anchor "#s-PathEditing" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PathVariable .
pg:Page ipo:coversChapterSection pg:PathEditing .
pg:WhichAndWhere a ipo:ChapterSection ; rdfs:label "Which and where"@en ;
    skos:definition "which on macOS and Linux and where on Windows report the folder on PATH that holds a given program; where lists every match, and the topmost one is the program that runs when the name is typed (Sweigart, 2025). Inside Python, shutil.which() returns the path of the program that would run for a name, checking that it exists and is executable, or None (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_WhichAndWhere> ;
    sen0414:anchor "#s-WhichAndWhere" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PathVariable .
pg:Page ipo:coversChapterSection pg:WhichAndWhere .
pg:Environments a ipo:ChapterSection ; rdfs:label "Environments"@en ;
    skos:definition "Two programs that need different versions of one package cannot share one Python installation, and the chapter's answer is the virtual environment, with pip as the tool that fills it from PyPI (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_Environments> ;
    sen0414:anchor "#s-Environments" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Environments .
pg:VirtualEnvironments a ipo:ChapterSection ; rdfs:label "Virtual environments"@en ;
    skos:definition "A virtual environment is a separate installation of Python with its own set of installed third-party packages, made by the built-in venv module; the chapter advises one environment per application but allows one shared environment for small scripts while learning (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_VirtualEnvironments> ;
    sen0414:anchor "#s-VirtualEnvironments" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Environments .
pg:Page ipo:coversChapterSection pg:VirtualEnvironments .
pg:CreatingAVenv a ipo:ChapterSection ; rdfs:label "Creating a venv"@en ;
    skos:definition "python -m venv .venv, typed in the Scripts folder, creates a virtual environment in a new folder named .venv, a conventional name whose leading period hides it; the environment starts with only the default packages and none of those installed in the original Python (Sweigart, 2025). PEP 405 made this part of Python 3.3, crediting Ian Bicking's virtualenv as the tool that proved the idea (Meyer, 2011)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_CreatingAVenv> ;
    sen0414:anchor "#s-CreatingAVenv" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:VirtualEnvironments .
pg:Page ipo:coversChapterSection pg:CreatingAVenv .
pg:ActivatingAVenv a ipo:ChapterSection ; rdfs:label "Activating a venv"@en ;
    skos:definition "Activation runs activate.bat in .venv\\Scripts on Windows or source activate in .venv/bin on macOS and Linux; it changes PATH so that python or python3 runs the environment's interpreter and adds (.venv) to the prompt, in the current terminal window only, and deactivate, closing the window, or deleting the .venv folder ends it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ActivatingAVenv> ;
    sen0414:anchor "#s-ActivatingAVenv" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:VirtualEnvironments .
pg:Page ipo:coversChapterSection pg:ActivatingAVenv .
pg:VenvDetection a ipo:ChapterSection ; rdfs:label "Venv detection"@en ;
    skos:definition "A program can tell whether it runs inside a virtual environment, because there sys.prefix names the environment's folder while sys.base_prefix names the Python that created it; the venv documentation says that checking sys.prefix != sys.base_prefix is sufficient (Python Software Foundation, 2026), and PEP 405 defines the rule through the pyvenv.cfg file (Meyer, 2011)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_VenvDetection> ;
    sen0414:anchor "#s-VenvDetection" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:VirtualEnvironments .
pg:Page ipo:coversChapterSection pg:VenvDetection .
pg:SystemInterpreter a ipo:ChapterSection ; rdfs:label "System interpreter"@en ;
    skos:definition "macOS and Linux ship their own Python, called the system Python, for programs of the operating system; running scripts with it is fine, but installing or updating packages in it can introduce incompatibilities that break those programs, so a virtual environment in the Scripts folder is the chapter's precaution (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_SystemInterpreter> ;
    sen0414:anchor "#s-SystemInterpreter" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:VirtualEnvironments .
pg:Page ipo:coversChapterSection pg:SystemInterpreter .
pg:PipInstaller a ipo:ChapterSection ; rdfs:label "Pip installer"@en ;
    skos:definition "pip, a recursive acronym for pip installs packages, is the command line package manager that comes with Python and downloads third-party packages from PyPI, the Python Package Index at pypi.org (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PipInstaller> ;
    sen0414:anchor "#s-PipInstaller" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Environments .
pg:Page ipo:coversChapterSection pg:PipInstaller .
pg:PackagesAndModules a ipo:ChapterSection ; rdfs:label "Packages and modules"@en ;
    skos:definition "In Python, a package is a collection of Python code made available on PyPI and a module is an individual .py file of Python code; packages are installed from PyPI, they contain modules, and an import statement imports a module (Sweigart, 2025). The standard library's modules, such as sys, random and os, need no installing."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PackagesAndModules> ;
    sen0414:anchor "#s-PackagesAndModules" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PipInstaller .
pg:Page ipo:coversChapterSection pg:PackagesAndModules .
pg:RunningPipAsAModule a ipo:ChapterSection ; rdfs:label "Running pip as a module"@en ;
    skos:definition "pip is a program of its own, but the chapter runs it through the interpreter, as python -m pip on Windows or python3 -m pip on macOS and Linux, because that installs into the very Python that python or python3 starts, avoiding the case where several installations exist, PATH is misconfigured and the pip program on PATH belongs to another one (Sweigart, 2025). The pip user guide recommends the same form (Python Packaging Authority, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_RunningPipAsAModule> ;
    sen0414:anchor "#s-RunningPipAsAModule" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PipInstaller .
pg:Page ipo:coversChapterSection pg:RunningPipAsAModule .
pg:InstallAndUninstall a ipo:ChapterSection ; rdfs:label "Install and uninstall"@en ;
    skos:definition "python -m pip install package_name installs a package from PyPI, install -U upgrades it to the latest version, package_name==1.17.4 installs one exact version, uninstall removes it and list shows every installed package with its version; the chapter adds that Anaconda users should use conda instead, and that the automateboringstuff3 package installs the versions the book was written with (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_InstallAndUninstall> ;
    sen0414:anchor "#s-InstallAndUninstall" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PipInstaller .
pg:Page ipo:coversChapterSection pg:InstallAndUninstall .
pg:SelfAware a ipo:ChapterSection ; rdfs:label "Self aware"@en ;
    skos:definition "Several built-in values tell a running program about itself, the interpreter running it and the operating system, and the interpreter sets them automatically; the chapter calls such programs self-aware (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_SelfAware> ;
    sen0414:anchor "#s-SelfAware" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:SelfAware .
pg:ScriptLocation a ipo:ChapterSection ; rdfs:label "Script location"@en ;
    skos:definition "A program can ask where it is and what runs it: __file__ gives the path of its own .py file, and sys.executable and sys.version describe the interpreter (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ScriptLocation> ;
    sen0414:anchor "#s-ScriptLocation" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SelfAware .
pg:Page ipo:coversChapterSection pg:ScriptLocation .
pg:FileVariable a ipo:ChapterSection ; rdfs:label "File variable"@en ;
    skos:definition "__file__ contains the running .py file's path as a string, Path(__file__) turns it into a Path object useful for finding files in the program's own folder, and the variable does not exist in the interactive shell (Sweigart, 2025). Since Python 3.9 it is an absolute path even when the script was started by a relative name, so it stays valid after os.chdir() (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_FileVariable> ;
    sen0414:anchor "#s-FileVariable" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ScriptLocation .
pg:Page ipo:coversChapterSection pg:FileVariable .
pg:InterpreterLocation a ipo:ChapterSection ; rdfs:label "Interpreter location"@en ;
    skos:definition "sys.executable contains the full path and file name of the Python interpreter program itself, and sys.version the string that appears at the top of the interactive shell with the interpreter's version (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_InterpreterLocation> ;
    sen0414:anchor "#s-InterpreterLocation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ScriptLocation .
pg:Page ipo:coversChapterSection pg:InterpreterLocation .
pg:PlatformChecks a ipo:ChapterSection ; rdfs:label "Platform checks"@en ;
    skos:definition "One script can run on several operating systems if it asks which one it is on and which Python version runs it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PlatformChecks> ;
    sen0414:anchor "#s-PlatformChecks" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SelfAware .
pg:Page ipo:coversChapterSection pg:PlatformChecks .
pg:VersionInfo a ipo:ChapterSection ; rdfs:label "Version info"@en ;
    skos:definition "sys.version_info.major and sys.version_info.minor are integers, 3 and 13 on the author's laptop running Python 3.13.1, and list(sys.version_info) gives more detail; the chapter prints that list as [3, 13, 1 'final', 0], where a comma after the 1 is missing, and the form is easier to work with than the sys.version string (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_VersionInfo> ;
    sen0414:anchor "#s-VersionInfo" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PlatformChecks .
pg:Page ipo:coversChapterSection pg:VersionInfo .
pg:OperatingSystemName a ipo:ChapterSection ; rdfs:label "Operating system name"@en ;
    skos:definition "os.name is 'nt' on Windows and 'posix' on macOS and Linux, enough for a script that runs different code per family of operating systems, and sys.platform is more specific: 'win32' on Windows, 'darwin' on macOS and 'linux' on Linux; the platform module reports the operating system version and processor in detail (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_OperatingSystemName> ;
    sen0414:anchor "#s-OperatingSystemName" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PlatformChecks .
pg:Page ipo:coversChapterSection pg:OperatingSystemName .
pg:ModuleChecks a ipo:ChapterSection ; rdfs:label "Module checks"@en ;
    skos:definition "A program can check that what it needs is there before it starts its work: a missing third-party module is caught with ModuleNotFoundError, and sys.exit() ends the program with a message the user can act on (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ModuleChecks> ;
    sen0414:anchor "#s-ModuleChecks" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SelfAware .
pg:Page ipo:coversChapterSection pg:ModuleChecks .
pg:MissingModule a ipo:ChapterSection ; rdfs:label "Missing module"@en ;
    skos:definition "To check whether a module is installed, the import statement goes into a try block whose except clause catches ModuleNotFoundError; if the module is necessary, a descriptive message and a call to sys.exit() are more helpful to the user than a generic error and traceback (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_MissingModule> ;
    sen0414:anchor "#s-MissingModule" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ModuleChecks .
pg:Page ipo:coversChapterSection pg:MissingModule .
pg:ExitWithMessage a ipo:ChapterSection ; rdfs:label "Exit with message"@en ;
    skos:definition "sys.exit() terminates the program, which the chapter recommends after a failed import of a module the program cannot do without (Sweigart, 2025). It works by raising SystemExit; given a string, Python prints the text to standard error and the process ends with exit code 1, while sys.exit() or sys.exit(0) means success (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ExitWithMessage> ;
    sen0414:anchor "#s-ExitWithMessage" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ModuleChecks .
pg:Page ipo:coversChapterSection pg:ExitWithMessage .
pg:TextDesign a ipo:ChapterSection ; rdfs:label "Text design"@en ;
    skos:definition "The book's programs use print() and input() through a command line interface rather than windows and buttons, and the chapter gathers the design choices that make such a text-based program pleasant to use: its name, its arguments, the clipboard, colour, clearing, sound, verbosity and small dialog boxes, with the Snowstorm animation as a short program that puts several of them to work (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_TextDesign> ;
    sen0414:anchor "#s-TextDesign" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:TextDesign .
pg:CommandLineArguments a ipo:ChapterSection ; rdfs:label "Command line arguments"@en ;
    skos:definition "The text typed after a command is its command line arguments, passed to it much as arguments are passed to a function, so that ls exampleFolder lists a different folder from ls alone (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_CommandLineArguments> ;
    sen0414:anchor "#s-CommandLineArguments" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:TextDesign .
pg:Page ipo:coversChapterSection pg:CommandLineArguments .
pg:ShortCommandNames a ipo:ChapterSection ; rdfs:label "Short command names"@en ;
    skos:definition "Source code is read more often than it is written, so variables get long names, but commands are typed more often than they are read, so a command typed a dozen times a day deserves a short name, like cp rather than copy; which, where and an internet search check that the name is not already taken (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ShortCommandNames> ;
    sen0414:anchor "#s-ShortCommandNames" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CommandLineArguments .
pg:Page ipo:coversChapterSection pg:ShortCommandNames .
pg:ArgvList a ipo:ChapterSection ; rdfs:label "Argv list"@en ;
    skos:definition "Python scripts receive their command line arguments in the sys.argv list: python3 yourScript.py hello world sets it to ['yourScript.py', 'hello', 'world'], the first item is the script's file name, and the rest are the typed words, split at spaces (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ArgvList> ;
    sen0414:anchor "#s-ArgvList" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CommandLineArguments .
pg:Page ipo:coversChapterSection pg:ArgvList .
pg:QuotedArguments a ipo:ChapterSection ; rdfs:label "Quoted arguments"@en ;
    skos:definition "Arguments are split at spaces, so a space inside one argument needs quotation marks around it when the command is run: python3 yourScript.py 'hello world' sets sys.argv to ['yourScript.py', 'hello world'] (Sweigart, 2025). Python's shlex.split() splits a command line by the same rules as a POSIX shell (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_QuotedArguments> ;
    sen0414:anchor "#s-QuotedArguments" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CommandLineArguments .
pg:Page ipo:coversChapterSection pg:QuotedArguments .
pg:ArgparseModule a ipo:ChapterSection ; rdfs:label "Argparse module"@en ;
    skos:definition "Once a program accepts several arguments, reading sys.argv by hand becomes a pile of edge cases - whether spam eggs means the same as eggs spam, what happens when two exclusive options are both given - and the chapter recommends Python's built-in argparse module instead, leaving it to the documentation (Sweigart, 2025). argparse declares each argument once and parses the list, converts types, fills defaults and writes usage and error messages; in Python 3.14 it also colours its help text and can suggest a mistyped choice (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ArgparseModule> ;
    sen0414:anchor "#s-ArgparseModule" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CommandLineArguments .
pg:Page ipo:coversChapterSection pg:ArgparseModule .
pg:TerminalOutput a ipo:ChapterSection ; rdfs:label "Terminal output"@en ;
    skos:definition "Even limited to text, a program can offer an interface close to a graphical one, and the chapter collects the ways: a text-based user interface, the clipboard as input and output, colour, clearing the screen, and sound and quiet or verbose output (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_TerminalOutput> ;
    sen0414:anchor "#s-TerminalOutput" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:TextDesign .
pg:Page ipo:coversChapterSection pg:TerminalOutput .
pg:TextUserInterface a ipo:ChapterSection ; rdfs:label "Text user interface"@en ;
    skos:definition "Before graphical operating systems were common, every program talked to its user in text, and applications such as Norton Commander, shown in the chapter's Figure 12-1, drew panels and menus out of text characters; such programs are called TUI, text-based user interface, applications, and their advantage is simplicity (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_TextUserInterface> ;
    sen0414:anchor "#s-TextUserInterface" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TerminalOutput .
pg:Page ipo:coversChapterSection pg:TextUserInterface .
pg:ClipboardProgramDesign a ipo:ChapterSection ; rdfs:label "Clipboard program design"@en ;
    skos:definition "Instead of input(), a program can take its text from the clipboard: it imports pyperclip, calls pyperclip.paste() for the input, works on the text and passes the result to pyperclip.copy(), so a user highlights text, copies it, runs the command and pastes the result; pyperclip is installed with pip and needs xclip on Linux (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ClipboardProgramDesign> ;
    sen0414:anchor "#s-ClipboardProgramDesign" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TerminalOutput .
pg:Page ipo:coversChapterSection pg:ClipboardProgramDesign .
pg:ColorfulText a ipo:ChapterSection ; rdfs:label "Colorful text"@en ;
    skos:definition "The third-party Bext package, built on Jonathan Hartley's Colorama, prints colourful text: fg() sets the text colour and bg() the background, with names such as 'red', 'green' or 'blue', and 'reset' returns to the terminal's own colours; bext.clear(), width(), height(), title(), goto() and get_key() add simple screen control, and the package works only in a terminal, not in Mu (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ColorfulText> ;
    sen0414:anchor "#s-ColorfulText" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TerminalOutput .
pg:Page ipo:coversChapterSection pg:ColorfulText .
pg:TerminalClearing a ipo:ChapterSection ; rdfs:label "Terminal clearing"@en ;
    skos:definition "bext.clear() removes text left from before, and a one-liner does the same without the package: a clear() function calling os.system('cls' if os.name == 'nt' else 'clear'), which runs the cls program on Windows and clear on macOS and Linux, and works only in a terminal; the choice is made by a conditional expression, value1 if condition else value2, which the chapter calls a ternary operator in other languages (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_TerminalClearing> ;
    sen0414:anchor "#s-TerminalClearing" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TerminalOutput .
pg:Page ipo:coversChapterSection pg:TerminalClearing .
pg:SoundAndTextNotification a ipo:ChapterSection ; rdfs:label "Sound and text notification"@en ;
    skos:definition "The playsound3 package plays an MP3 or WAV file, and its playsound() blocks until the sound ends; sound can announce that a task finished, but it is easily overused and wasted on a muted computer; and under the Unix philosophy a command prints only what another command could use, reporting success or failure through its exit code, with -v or --verbose for more output and -q or --quiet for none, or silence by default (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_SoundAndTextNotification> ;
    sen0414:anchor "#s-SoundAndTextNotification" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TerminalOutput .
pg:Page ipo:coversChapterSection pg:SoundAndTextNotification .
pg:SnowstormProgram a ipo:ChapterSection ; rdfs:label "Snowstorm program"@en ;
    skos:definition "snowstorm.py animates a snowstorm in the terminal with half-block characters for snow and full blocks for the ground, taking its density from an optional command line argument; the chapter chose it because it is fun rather than practical (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_SnowstormProgram> ;
    sen0414:anchor "#s-SnowstormProgram" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:TextDesign .
pg:Page ipo:coversChapterSection pg:SnowstormProgram .
pg:BlockCharacters a ipo:ChapterSection ; rdfs:label "Block characters"@en ;
    skos:definition "The program's snow and ground are block text characters that fill the top half, the bottom half or the whole of one character cell, returned by chr(9600), chr(9604) and chr(9608) and kept in the constants TOP, BOTTOM and FULL because names read better than numbers (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_BlockCharacters> ;
    sen0414:anchor "#s-BlockCharacters" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SnowstormProgram .
pg:Page ipo:coversChapterSection pg:BlockCharacters .
pg:DensityArgument a ipo:ChapterSection ; rdfs:label "Density argument"@en ;
    skos:definition "snowstorm.py starts with DENSITY = 4, four percent snow, and if len(sys.argv) > 1 sets it to int(sys.argv[1]), so python snowstorm.py 20 makes sys.argv ['snowstorm.py', '20'] and the density 20, changing the program's behaviour without changing its source code (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_DensityArgument> ;
    sen0414:anchor "#s-DensityArgument" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SnowstormProgram .
pg:Page ipo:coversChapterSection pg:DensityArgument .
pg:FlipbookAnimation a ipo:ChapterSection ; rdfs:label "Flipbook animation"@en ;
    skos:definition "Inside an endless while loop the program clears the terminal, loops over 20 rows and 40 columns printing either a random TOP or BOTTOM character or a space with print(..., end=''), ends each row with print(), prints two rows of FULL characters as the ground and a reminder that CTRL-C stops it, and pauses with time.sleep(0.2) before the next frame (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_FlipbookAnimation> ;
    sen0414:anchor "#s-FlipbookAnimation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SnowstormProgram .
pg:Page ipo:coversChapterSection pg:FlipbookAnimation .
pg:MessageBoxes a ipo:ChapterSection ; rdfs:label "Message boxes"@en ;
    skos:definition "A full graphical interface needs a library such as Tkinter, wxPython or PyQt, but small dialog boxes come from the third-party PyMsgBox package, which uses Tkinter and names its functions after JavaScript's message boxes (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_MessageBoxes> ;
    sen0414:anchor "#s-MessageBoxes" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:TextDesign .
pg:Page ipo:coversChapterSection pg:MessageBoxes .
pg:AlertAndConfirm a ipo:ChapterSection ; rdfs:label "Alert and confirm"@en ;
    skos:definition "pymsgbox.alert(text) shows a message until the user clicks OK and returns 'OK', and pymsgbox.confirm(text) shows it with OK and Cancel and returns the button's name; PyMsgBox is installed with pip, and on Ubuntu Tkinter must first be installed with sudo apt install python3-tk (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_AlertAndConfirm> ;
    sen0414:anchor "#s-AlertAndConfirm" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:MessageBoxes .
pg:Page ipo:coversChapterSection pg:AlertAndConfirm .
pg:PromptAndPassword a ipo:ChapterSection ; rdfs:label "Prompt and password"@en ;
    skos:definition "pymsgbox.prompt(text) shows a message with a text field and returns what the user typed, or None if Cancel was clicked, and pymsgbox.password(text) does the same with the typing masked by asterisks; none of the four functions returns until the user clicks OK, Cancel or the close button (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PromptAndPassword> ;
    sen0414:anchor "#s-PromptAndPassword" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:MessageBoxes .
pg:Page ipo:coversChapterSection pg:PromptAndPassword .
pg:Deployment a ipo:ChapterSection ; rdfs:label "Deployment"@en ;
    skos:definition "Deployment makes a finished program run in as few keystrokes as possible, without opening Mu; the chapter's recipe is a Scripts folder on PATH, a virtual environment in it, and for each script a small launcher file for the operating system, shown on two short programs, ccwd and the Clipboard Recorder, with PyInstaller as the alternative for computers without Python (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_Deployment> ;
    sen0414:anchor "#s-Deployment" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Deployment .
pg:LauncherFiles a ipo:ChapterSection ; rdfs:label "Launcher files"@en ;
    skos:definition "For each script the chapter writes one small text file per operating system that activates the Scripts folder's virtual environment, runs the script with the environment's Python and deactivates, so that typing one name runs the program (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_LauncherFiles> ;
    sen0414:anchor "#s-LauncherFiles" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Deployment .
pg:Page ipo:coversChapterSection pg:LauncherFiles .
pg:BatchFile a ipo:ChapterSection ; rdfs:label "Batch file"@en ;
    skos:definition "On Windows, yourScript.bat in the Scripts folder holds four lines: @call %HOMEDRIVE%%HOMEPATH%\\Scripts\\.venv\\Scripts\\activate.bat, @python %HOMEDRIVE%%HOMEPATH%\\Scripts\\yourScript.py %*, @pause and @deactivate; the @ hides each command, call is needed or the rest of the file would not run after activate.bat, and the Run dialog, opened with the Windows key and R, then runs it by name (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_BatchFile> ;
    sen0414:anchor "#s-BatchFile" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LauncherFiles .
pg:Page ipo:coversChapterSection pg:BatchFile .
pg:CommandFile a ipo:ChapterSection ; rdfs:label "Command file"@en ;
    skos:definition "On macOS, a plain-text yourScript.command file in the Scripts folder sources ~/Scripts/.venv/bin/activate, runs python3 ~/Scripts/yourScript.py and deactivates; chmod u+x gives it the execute permission, and Spotlight then runs it by name, which it would not do for yourScript.py, opening that in an editor instead (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_CommandFile> ;
    sen0414:anchor "#s-CommandFile" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LauncherFiles .
pg:Page ipo:coversChapterSection pg:CommandFile .
pg:ShellScriptLauncher a ipo:ChapterSection ; rdfs:label "Shell script launcher"@en ;
    skos:definition "On Ubuntu, a text file named yourScript with no extension holds #!/usr/bin/env bash, source ~/Scripts/.venv/bin/activate, python3 ~/Scripts/yourScript.py, read -p 'Press any key to continue...' -n1 -s and deactivate; chmod u+x makes it executable, after which typing yourScript in any terminal runs it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ShellScriptLauncher> ;
    sen0414:anchor "#s-ShellScriptLauncher" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LauncherFiles .
pg:Page ipo:coversChapterSection pg:ShellScriptLauncher .
pg:DesktopEntry a ipo:ChapterSection ; rdfs:label "Desktop entry"@en ;
    skos:definition "To run the shell script from Ubuntu's Dash, a yourScript.desktop file in ~/.local/share/applications holds [Desktop Entry], Name=yourScript, Exec=gnome-terminal -- /home/al/Scripts/yourScript and Type=Application; the Exec line must spell out /home/al because ~ is not expanded in this file, and CTRL-H shows the hidden .local folder in a save dialog (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_DesktopEntry> ;
    sen0414:anchor "#s-DesktopEntry" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LauncherFiles .
pg:Page ipo:coversChapterSection pg:DesktopEntry .
pg:LauncherMechanics a ipo:ChapterSection ; rdfs:label "Launcher mechanics"@en ;
    skos:definition "Four details make a launcher work or fail: the first line that names its interpreter, the permission to execute it, passing on the arguments typed after its name, and keeping its window open long enough to read the output (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_LauncherMechanics> ;
    sen0414:anchor "#s-LauncherMechanics" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Deployment .
pg:Page ipo:coversChapterSection pg:LauncherMechanics .
pg:ShebangLine a ipo:ChapterSection ; rdfs:label "Shebang line"@en ;
    skos:definition "The first line of the Ubuntu launcher, #!/usr/bin/env bash, identifies the file as a shell script, so it needs no .sh extension (Sweigart, 2025); a first line beginning with #! names the interpreter that the operating system runs the file with, and the form /usr/bin/env bash asks the env program to find bash on PATH rather than naming its folder."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ShebangLine> ;
    sen0414:anchor "#s-ShebangLine" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LauncherMechanics .
pg:Page ipo:coversChapterSection pg:ShebangLine .
pg:ExecutePermission a ipo:ChapterSection ; rdfs:label "Execute permission"@en ;
    skos:definition "chmod u+x adds execute permission for the file's owner, so that macOS can run a .command file from Spotlight and Linux can run a shell script by name; without it the system refuses to run the file (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ExecutePermission> ;
    sen0414:anchor "#s-ExecutePermission" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LauncherMechanics .
pg:Page ipo:coversChapterSection pg:ExecutePermission .
pg:ArgumentForwarding a ipo:ChapterSection ; rdfs:label "Argument forwarding"@en ;
    skos:definition "The batch file runs @python ...\\yourScript.py %*, and %* forwards every command line argument the batch file received to the Python program; the chapter advises always including it in case arguments are added later (Sweigart, 2025). Its macOS command file and Ubuntu shell script launcher, however, run python3 ~/Scripts/yourScript.py with nothing after it."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ArgumentForwarding> ;
    sen0414:anchor "#s-ArgumentForwarding" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LauncherMechanics .
pg:Page ipo:coversChapterSection pg:ArgumentForwarding .
pg:PauseBeforeClose a ipo:ChapterSection ; rdfs:label "Pause before close"@en ;
    skos:definition "@pause in the batch file makes Windows display Press any key to continue and wait, and read -p 'Press any key to continue...' -n1 -s does the same in the Ubuntu shell script, so the window opened by the Run dialog or by Dash does not close before its printed output can be read; a program with no printed output, such as ccwd, leaves the line out (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PauseBeforeClose> ;
    sen0414:anchor "#s-PauseBeforeClose" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:LauncherMechanics .
pg:Page ipo:coversChapterSection pg:PauseBeforeClose .
pg:CcwdCommand a ipo:ChapterSection ; rdfs:label "Ccwd command"@en ;
    skos:definition "ccwd, short for copy current working directory, copies the folder a terminal is in to the clipboard, for example to paste into a Save File dialog, and takes an optional relative path such as .. to copy another folder instead (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_CcwdCommand> ;
    sen0414:anchor "#s-CcwdCommand" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Deployment .
pg:Page ipo:coversChapterSection pg:CcwdCommand .
pg:CcwdScript a ipo:ChapterSection ; rdfs:label "Ccwd script"@en ;
    skos:definition "ccwd.py reads: import pyperclip, os, sys; if len(sys.argv) > 1: os.chdir(sys.argv[1]); pyperclip.copy(os.getcwd()); sys.argv always holds at least the script's name, so more than one item means the user gave a folder, and the batch file for it has no @pause because it prints nothing (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_CcwdScript> ;
    sen0414:anchor "#s-CcwdScript" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CcwdCommand .
pg:Page ipo:coversChapterSection pg:CcwdScript .
pg:ProgramWorkingDirectory a ipo:ChapterSection ; rdfs:label "Program working directory"@en ;
    skos:definition "Every program has its own current working directory setting, and changing it with os.chdir() does not change the current working directory of the terminal that ran the program (Sweigart, 2025); a new process starts in its parent's folder, and what it does with its own folder afterwards stays inside it (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ProgramWorkingDirectory> ;
    sen0414:anchor "#s-ProgramWorkingDirectory" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CcwdCommand .
pg:Page ipo:coversChapterSection pg:ProgramWorkingDirectory .
pg:ClipboardRecorder a ipo:ChapterSection ; rdfs:label "Clipboard recorder"@en ;
    skos:definition "The Clipboard Recorder, cliprec.py, turns copying many links from a web page into a two-step job: it watches the clipboard and prints every new text copied, so the user only copies links and finally copies everything from its window at once (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ClipboardRecorder> ;
    sen0414:anchor "#s-ClipboardRecorder" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Deployment .
pg:Page ipo:coversChapterSection pg:ClipboardRecorder .
pg:ClipboardPolling a ipo:ChapterSection ; rdfs:label "Clipboard polling"@en ;
    skos:definition "cliprec.py prints Recording clipboard... (Ctrl-C to stop), keeps previous_content = '', and in an endless loop calls pyperclip.paste(), prints the content and stores it when it differs from previous_content, then sleeps 0.01 seconds, so the loop checks the clipboard a hundred times a second instead of tens of thousands of times and does not hog the CPU (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_ClipboardPolling> ;
    sen0414:anchor "#s-ClipboardPolling" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ClipboardRecorder .
pg:Page ipo:coversChapterSection pg:ClipboardPolling .
pg:KeyboardInterruptExit a ipo:ChapterSection ; rdfs:label "Keyboard interrupt exit"@en ;
    skos:definition "The loop of cliprec.py sits inside a try block; pressing CTRL-C raises KeyboardInterrupt, the except KeyboardInterrupt clause holds only pass, a statement that does nothing but fills a block that needs one, and the program ends without a traceback (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_KeyboardInterruptExit> ;
    sen0414:anchor "#s-KeyboardInterruptExit" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ClipboardRecorder .
pg:Page ipo:coversChapterSection pg:KeyboardInterruptExit .
pg:CompilingWithPyInstaller a ipo:ChapterSection ; rdfs:label "Compiling with py installer"@en ;
    skos:definition "Python programs are mostly run by an interpreter, but the PyInstaller package makes an executable that runs on a computer without Python, so a program can be sent to a co-worker as one file (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_CompilingWithPyInstaller> ;
    sen0414:anchor "#s-CompilingWithPyInstaller" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Deployment .
pg:Page ipo:coversChapterSection pg:CompilingWithPyInstaller .
pg:OneFileBuild a ipo:ChapterSection ; rdfs:label "One file build"@en ;
    skos:definition "PyInstaller is installed with pip install pyinstaller, and python -m PyInstaller --onefile yourScript.py, with python3 on macOS and Linux, compiles the script; PyInstaller must be typed with a capital P and a capital I or the command fails with No module named pyinstaller, and --onefile has two dashes (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_OneFileBuild> ;
    sen0414:anchor "#s-OneFileBuild" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CompilingWithPyInstaller .
pg:Page ipo:coversChapterSection pg:OneFileBuild .
pg:BuildAndDist a ipo:ChapterSection ; rdfs:label "Build and dist"@en ;
    skos:definition "After PyInstaller runs there is a build folder, which can be deleted, and a dist folder containing the executable, which needs no virtual environment and can be copied to other computers; PyInstaller must run on the operating system the executable is for, so a Windows build makes only a Windows program (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_BuildAndDist> ;
    sen0414:anchor "#s-BuildAndDist" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CompilingWithPyInstaller .
pg:Page ipo:coversChapterSection pg:BuildAndDist .
pg:BundledInterpreter a ipo:ChapterSection ; rdfs:label "Bundled interpreter"@en ;
    skos:definition "PyInstaller does not compile Python into machine code; it makes an executable that contains a copy of the Python interpreter and the script, so even a simple Hello, world program is close to 8MB, a thousand times larger than one written in assembly language, and many email providers block executables as attachments (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_BundledInterpreter> ;
    sen0414:anchor "#s-BundledInterpreter" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CompilingWithPyInstaller .
pg:Page ipo:coversChapterSection pg:BundledInterpreter .
pg:PracticeWork a ipo:ChapterSection ; rdfs:label "Practice work"@en ;
    skos:definition "The chapter closes with six practice questions and one practice program, which asks for the earlier projects of the book to be made easy to run (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PracticeWork> ;
    sen0414:anchor "#s-PracticeWork" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:PracticeWork .
pg:Questions a ipo:ChapterSection ; rdfs:label "Questions"@en ;
    skos:definition "The six practice questions test the terminal, PATH, __file__, clearing the screen, virtual environments and PyInstaller, one question each (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_Questions> ;
    sen0414:anchor "#s-Questions" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:PracticeWork .
pg:Page ipo:coversChapterSection pg:Questions .
pg:PracticeQuestions a ipo:ChapterSection ; rdfs:label "Practice questions"@en ;
    skos:definition "The questions ask which command lists folder contents on Windows and on macOS and Linux, what the PATH environment variable contains, what the __file__ variable contains, which command erases the terminal's text on each system, how to create a new virtual environment, and which command line argument to pass to PyInstaller (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_PracticeQuestions> ;
    sen0414:anchor "#s-PracticeQuestions" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Questions .
pg:Page ipo:coversChapterSection pg:PracticeQuestions .
pg:Programs a ipo:ChapterSection ; rdfs:label "Programs"@en ;
    skos:definition "One practice program asks for the book's earlier projects to be deployed, through launcher scripts in a PATH folder or with PyInstaller (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_Programs> ;
    sen0414:anchor "#s-Programs" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:PracticeWork .
pg:Page ipo:coversChapterSection pg:Programs .
pg:DeployablePrograms a ipo:ChapterSection ; rdfs:label "Deployable programs"@en ;
    skos:definition "The practice program asks for shell scripts in a PATH folder, or a PyInstaller build, for Back Up a Folder into a ZIP File from chapter 11, Extract Contact Information from Large Documents from chapter 9, Add Bullets to Wiki Markup from chapter 8 and Interactive Chessboard Simulator from chapter 7, and for any other program the reader wants to launch easily (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch12#S_DeployablePrograms> ;
    sen0414:anchor "#s-DeployablePrograms" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Programs .
pg:Page ipo:coversChapterSection pg:DeployablePrograms .
pg:ProgramVocabulary sen0414:hasPanel pg:InterpretedScript, pg:TerminalCommand, pg:ShellScript .
