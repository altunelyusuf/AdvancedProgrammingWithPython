    skos:definition "The Start item of the main menu opens the introduction to the chapter, which is the page the reader starts on."@en ; dcterms:source "03-materials/ch12/page/sen0414_ch12_page_v9_96_0.html" ;
    dcterms:isPartOf pg:GroupedTopBar .
