chx:X_InterpretedScript a owl:NamedIndividual, chx:InterpretedScript ; rdfs:label "python yourScript.py"@en ; skos:definition "A script is a program that an interpreter runs from its source code rather than from compiled machine code; Python programs are usually called scripts, although PyInstaller can bundle one into an executable file."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_InterpretedScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "type(compile('print(42)', 'yourScript.py', 'exec')).__name__ evaluates to 'code'"@en ; chx:input "type(compile('print(42)', 'yourScript.py', 'exec')).__name__" ; chx:output "'code'" .
chx:X_InterpretedScript rd:hasIOExample chx:IO_InterpretedScript .
chx:X_TerminalCommand a owl:NamedIndividual, chx:TerminalCommand ; rdfs:label "ls exampleFolder"@en ; skos:definition "A command is a program run from a text-based terminal without a graphical user interface and configured up front by command line arguments, such as dir, ls, cd or cp."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_ShellScript a owl:NamedIndividual, chx:ShellScript ; rdfs:label "yourScript.bat, yourScript.command, yourScript"@en ; skos:definition "A shell script is one text file that runs several terminal commands in one batch; macOS and Linux use a .sh extension or none, and Windows calls it a batch file with the .bat extension."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_ChangeDirectory a owl:NamedIndividual, chx:ChangeDirectory ; rdfs:label "cd Desktop, cd .., pwd"@en ; skos:definition "cd changes the terminal's current working directory to a relative or absolute path, and pwd on macOS and Linux, or cd alone on Windows, shows it; a Python program does the same with os.chdir() and os.getcwd()."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_ChangeDirectory a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, shutil\\nold = os.getcwd()\\nt = os.path.realpath(tempfile.mkdtemp())\\nos.chdir(t)\\nos.mkdir(\\'Desktop\\')\\nos.chdir(\\'Desktop\\')\\nfirst = os.path.basename(os.getcwd())\\nos.chdir(\\'..\\')\\nback = os.getcwd() == t\\nos.chdir(old)\\nshutil.rmtree(t)\\nout = (first, back)', g), g['out'])[1])({}) evaluates to ('Desktop', True)"@en ; chx:input "(lambda g: (exec('import os, tempfile, shutil\\nold = os.getcwd()\\nt = os.path.realpath(tempfile.mkdtemp())\\nos.chdir(t)\\nos.mkdir(\\'Desktop\\')\\nos.chdir(\\'Desktop\\')\\nfirst = os.path.basename(os.getcwd())\\nos.chdir(\\'..\\')\\nback = os.getcwd() == t\\nos.chdir(old)\\nshutil.rmtree(t)\\nout = (first, back)', g), g['out'])[1])({})" ; chx:output "('Desktop', True)" .
chx:X_ChangeDirectory rd:hasIOExample chx:IO_ChangeDirectory .
chx:X_ListDirectory a owl:NamedIndividual, chx:ListDirectory ; rdfs:label "dir, ls, dir *.exe"@en ; skos:definition "dir on Windows and ls on macOS and Linux list the files and subfolders of the current working directory, dir *.exe lists only the programs, and os.listdir() returns the same names to a Python program."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_ListDirectory a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, shutil\\nt = tempfile.mkdtemp()\\nfor name in (\\'spam.exe\\', \\'notes.txt\\', \\'eggs.exe\\'):\\n    open(os.path.join(t, name), \\'w\\').close()\\nos.mkdir(os.path.join(t, \\'Scripts\\'))\\nnames = sorted(os.listdir(t))\\nout = (names, [n for n in names if n.endswith(\\'.exe\\')])\\nshutil.rmtree(t)', g), g['out'])[1])({}) evaluates to (['Scripts', 'eggs.exe', 'notes.txt', 'spam.exe'], ['eggs.exe', 'spam.exe'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, shutil\\nt = tempfile.mkdtemp()\\nfor name in (\\'spam.exe\\', \\'notes.txt\\', \\'eggs.exe\\'):\\n    open(os.path.join(t, name), \\'w\\').close()\\nos.mkdir(os.path.join(t, \\'Scripts\\'))\\nnames = sorted(os.listdir(t))\\nout = (names, [n for n in names if n.endswith(\\'.exe\\')])\\nshutil.rmtree(t)', g), g['out'])[1])({})" ; chx:output "(['Scripts', 'eggs.exe', 'notes.txt', 'spam.exe'], ['eggs.exe', 'spam.exe'])" .
chx:X_ListDirectory rd:hasIOExample chx:IO_ListDirectory .
chx:X_RunFromTerminal a owl:NamedIndividual, chx:RunFromTerminal ; rdfs:label "python3 yourScript.py, ./example"@en ; skos:definition "A .py file runs by naming it after python or python3 with an absolute or a relative path, a program in the current folder runs as example.exe on Windows but as ./example on macOS and Linux, and a file that is not a program opens in its associated application."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_PathSearchOrder a owl:NamedIndividual, chx:PathSearchOrder ; rdfs:label "echo $PATH"@en ; skos:definition "PATH is an environment variable holding a list of folders that the terminal searches in order for a typed program name; the first folder holding the name wins, subfolders are never searched, and Windows looks in the current folder first while macOS and Linux do not."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_PathSearchOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, shutil\\nt = tempfile.mkdtemp()\\nfor d in (\\'a\\', \\'a/sub\\', \\'b\\', \\'c\\'):\\n    os.makedirs(os.path.join(t, d))\\nfor d in (\\'a/sub\\', \\'b\\', \\'c\\'):\\n    open(os.path.join(t, d, \\'spam\\'), \\'w\\').close()\\npath = \\':\\'.join(os.path.join(t, d) for d in (\\'a\\', \\'b\\', \\'c\\'))\\nfound = [d for d in path.split(\\':\\') if os.path.exists(os.path.join(d, \\'spam\\'))]\\nout = os.path.basename(found[0])\\nshutil.rmtree(t)', g), g['out'])[1])({}) evaluates to 'b'"@en ; chx:input "(lambda g: (exec('import os, tempfile, shutil\\nt = tempfile.mkdtemp()\\nfor d in (\\'a\\', \\'a/sub\\', \\'b\\', \\'c\\'):\\n    os.makedirs(os.path.join(t, d))\\nfor d in (\\'a/sub\\', \\'b\\', \\'c\\'):\\n    open(os.path.join(t, d, \\'spam\\'), \\'w\\').close()\\npath = \\':\\'.join(os.path.join(t, d) for d in (\\'a\\', \\'b\\', \\'c\\'))\\nfound = [d for d in path.split(\\':\\') if os.path.exists(os.path.join(d, \\'spam\\'))]\\nout = os.path.basename(found[0])\\nshutil.rmtree(t)', g), g['out'])[1])({})" ; chx:output "'b'" .
chx:X_PathSearchOrder rd:hasIOExample chx:IO_PathSearchOrder .
chx:X_PathEditing a owl:NamedIndividual, chx:PathEditing ; rdfs:label "export PATH=/home/al/Scripts:$PATH"@en ; skos:definition "A folder is added to PATH through the user variable Path in the Windows Environment Variables window, or with an export line at the bottom of .zshrc on macOS or .bashrc on Linux, which affects only terminal windows opened afterwards; folders are separated by a semicolon on Windows and a colon on macOS and Linux."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_PathEditing a owl:NamedIndividual, rd:IOExample ; rdfs:label "':'.join(['/home/al/Scripts'] + '/usr/local/bin:/usr/bin:/bin'.split(':')) evaluates to '/home/al/Scripts:/usr/local/bin:/usr/bin:/bin'"@en ; chx:input "':'.join(['/home/al/Scripts'] + '/usr/local/bin:/usr/bin:/bin'.split(':'))" ; chx:output "'/home/al/Scripts:/usr/local/bin:/usr/bin:/bin'" .
chx:X_PathEditing rd:hasIOExample chx:IO_PathEditing .
chx:X_WhichAndWhere a owl:NamedIndividual, chx:WhichAndWhere ; rdfs:label "which python3, where python"@en ; skos:definition "which on macOS and Linux and where on Windows report the folder on PATH from which a program name would run; where lists every match, the topmost one is the one that runs, and shutil.which() answers the same question inside Python."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_CreatingAVenv a owl:NamedIndividual, chx:CreatingAVenv ; rdfs:label "python -m venv .venv"@en ; skos:definition "python -m venv .venv creates a virtual environment, a separate Python installation with its own set of installed packages, in a hidden folder named .venv by convention, so that two programs can depend on different versions of one package."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_ActivatingAVenv a owl:NamedIndividual, chx:ActivatingAVenv ; rdfs:label "source .venv/bin/activate, deactivate"@en ; skos:definition "Activating an environment, with activate.bat on Windows or source activate on macOS and Linux, puts its folder first on PATH and adds (.venv) to the prompt in that one terminal window; deactivate undoes it, and deleting the .venv folder removes the environment with its packages."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_VenvDetection a owl:NamedIndividual, chx:VenvDetection ; rdfs:label "sys.prefix != sys.base_prefix"@en ; skos:definition "Inside a virtual environment sys.prefix names the environment and sys.base_prefix the Python that created it, so a program can tell that it runs in one when the two differ; outside an environment they are equal."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_VenvDetection a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sys').prefix != __import__('sys').base_prefix evaluates to False"@en ; chx:input "__import__('sys').prefix != __import__('sys').base_prefix" ; chx:output "False" .
chx:X_VenvDetection rd:hasIOExample chx:IO_VenvDetection .
chx:X_SystemInterpreter a owl:NamedIndividual, chx:SystemInterpreter ; rdfs:label "/usr/bin/python3"@en ; skos:definition "The system Python is the installation that macOS and Linux ship for their own programs; running scripts with it is fine, installing packages into it can break those programs, and since PEP 668 distributions such as Ubuntu 24.04 refuse pip install there with error: externally-managed-environment."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_PackagesAndModules a owl:NamedIndividual, chx:PackagesAndModules ; rdfs:label "python -m pip install pyperclip, then import pyperclip"@en ; skos:definition "A package is a collection of Python code published on PyPI, the Python Package Index, and a module is one .py file of Python code; pip installs packages, which contain modules, and an import statement imports a module."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_PackagesAndModules a owl:NamedIndividual, rd:IOExample ; rdfs:label "type(__import__('json')).__name__ evaluates to 'module'"@en ; chx:input "type(__import__('json')).__name__" ; chx:output "'module'" .
chx:X_PackagesAndModules rd:hasIOExample chx:IO_PackagesAndModules .
chx:X_RunningPipAsAModule a owl:NamedIndividual, chx:RunningPipAsAModule ; rdfs:label "python -m pip install package_name"@en ; skos:definition "Running pip through the interpreter, as python -m pip on Windows or python3 -m pip on macOS and Linux, installs into exactly the Python that python or python3 starts, which avoids a pip program on PATH that belongs to another installation."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_InstallAndUninstall a owl:NamedIndividual, chx:InstallAndUninstall ; rdfs:label "python -m pip install package_name==1.17.4"@en ; skos:definition "pip install adds a package from PyPI, install -U upgrades it, package_name==1.17.4 installs one exact version, uninstall removes it and list shows every installed package with its version; the automateboringstuff3 package installs the versions the book was written with."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_InstallAndUninstall a owl:NamedIndividual, rd:IOExample ; rdfs:label "'package_name==1.17.4'.partition('==') evaluates to ('package_name', '==', '1.17.4')"@en ; chx:input "'package_name==1.17.4'.partition('==')" ; chx:output "('package_name', '==', '1.17.4')" .
chx:X_InstallAndUninstall rd:hasIOExample chx:IO_InstallAndUninstall .
chx:X_FileVariable a owl:NamedIndividual, chx:FileVariable ; rdfs:label "Path(__file__).parent"@en ; skos:definition "__file__ holds the running .py file's path as a string, an absolute path since Python 3.9, so Path(__file__).parent finds files kept beside the program; code that does not come from a file, such as the interactive shell, has no __file__."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_FileVariable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('x = 42', g), '__file__' in g)[1])({}) evaluates to False"@en ; chx:input "(lambda g: (exec('x = 42', g), '__file__' in g)[1])({})" ; chx:output "False" .
chx:X_FileVariable rd:hasIOExample chx:IO_FileVariable .
chx:X_InterpreterLocation a owl:NamedIndividual, chx:InterpreterLocation ; rdfs:label "sys.executable, sys.version"@en ; skos:definition "sys.executable holds the full path of the Python interpreter running the program and sys.version the version text that the interactive shell prints at its top."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_VersionInfo a owl:NamedIndividual, chx:VersionInfo ; rdfs:label "sys.version_info.major, sys.version_info.minor"@en ; skos:definition "sys.version_info holds the interpreter's version as integers, major and minor first, so sys.version_info >= (3, 9) compares versions directly instead of pulling numbers out of the sys.version string."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_VersionInfo a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sys').version_info >= (3, 9) evaluates to True"@en ; chx:input "__import__('sys').version_info >= (3, 9)" ; chx:output "True" .
chx:X_VersionInfo rd:hasIOExample chx:IO_VersionInfo .
chx:X_OperatingSystemName a owl:NamedIndividual, chx:OperatingSystemName ; rdfs:label "os.name, sys.platform"@en ; skos:definition "os.name is 'nt' on Windows and 'posix' on macOS and Linux, and sys.platform is finer grained, 'win32', 'darwin' or 'linux', so a program can run different code on each operating system."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_OperatingSystemName a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('os').name evaluates to 'posix'"@en ; chx:input "__import__('os').name" ; chx:output "'posix'" .
chx:X_OperatingSystemName rd:hasIOExample chx:IO_OperatingSystemName .
chx:X_MissingModule a owl:NamedIndividual, chx:MissingModule ; rdfs:label "except ModuleNotFoundError:"@en ; skos:definition "Putting an import statement in a try block and catching ModuleNotFoundError lets a program say that a package is missing in its own words, instead of stopping with a traceback."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_MissingModule a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('try:\\n    import nonexistentModule\\n    out = \\'found\\'\\nexcept ModuleNotFoundError:\\n    out = \\'This code runs if nonexistentModule was not found.\\'', g), g['out'])[1])({}) evaluates to 'This code runs if nonexistentModule was not found.'"@en ; chx:input "(lambda g: (exec('try:\\n    import nonexistentModule\\n    out = \\'found\\'\\nexcept ModuleNotFoundError:\\n    out = \\'This code runs if nonexistentModule was not found.\\'', g), g['out'])[1])({})" ; chx:output "'This code runs if nonexistentModule was not found.'" .
chx:X_MissingModule rd:hasIOExample chx:IO_MissingModule .
chx:X_ExitWithMessage a owl:NamedIndividual, chx:ExitWithMessage ; rdfs:label "sys.exit('This program needs pyperclip.')"@en ; skos:definition "sys.exit() ends a program by raising SystemExit; given a string, Python prints the text to standard error and the program ends with exit code 1, which the terminal or another program can test."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_ExitWithMessage a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import sys\\ntry:\\n    sys.exit(\\'This program needs pyperclip.\\')\\nexcept SystemExit as e:\\n    out = (type(e).__name__, e.code)', g), g['out'])[1])({}) evaluates to ('SystemExit', 'This program needs pyperclip.')"@en ; chx:input "(lambda g: (exec('import sys\\ntry:\\n    sys.exit(\\'This program needs pyperclip.\\')\\nexcept SystemExit as e:\\n    out = (type(e).__name__, e.code)', g), g['out'])[1])({})" ; chx:output "('SystemExit', 'This program needs pyperclip.')" .
chx:X_ExitWithMessage rd:hasIOExample chx:IO_ExitWithMessage .
chx:X_ShortCommandNames a owl:NamedIndividual, chx:ShortCommandNames ; rdfs:label "cp rather than copy; ccwd"@en ; skos:definition "Commands are typed far more often than they are read, so a command a user types many times a day deserves a short name, checked first with which or where and an internet search so that it does not clash with an existing program."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_ArgvList a owl:NamedIndividual, chx:ArgvList ; rdfs:label "sys.argv"@en ; skos:definition "sys.argv is the list of command line arguments a script receives: the script's file name first, then the words typed after it, split at spaces, so python3 yourScript.py hello world gives ['yourScript.py', 'hello', 'world']."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_ArgvList a owl:NamedIndividual, rd:IOExample ; rdfs:label "'python3 yourScript.py hello world'.split()[1:] evaluates to ['yourScript.py', 'hello', 'world']"@en ; chx:input "'python3 yourScript.py hello world'.split()[1:]" ; chx:output "['yourScript.py', 'hello', 'world']" .
chx:X_ArgvList rd:hasIOExample chx:IO_ArgvList .
chx:X_QuotedArguments a owl:NamedIndividual, chx:QuotedArguments ; rdfs:label "python3 yourScript.py 'hello world'"@en ; skos:definition "Quotation marks keep a space inside one argument, so the two words arrive as the single item 'hello world'; shlex.split() splits a command line the way a POSIX shell does."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_QuotedArguments a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('shlex').split('python3 yourScript.py \\'hello world\\'')[1:] evaluates to ['yourScript.py', 'hello world']"@en ; chx:input "__import__('shlex').split('python3 yourScript.py \\'hello world\\'')[1:]" ; chx:output "['yourScript.py', 'hello world']" .
chx:X_QuotedArguments rd:hasIOExample chx:IO_QuotedArguments .
chx:X_ArgparseModule a owl:NamedIndividual, chx:ArgparseModule ; rdfs:label "argparse.ArgumentParser()"@en ; skos:definition "The argparse module, which the chapter recommends once arguments multiply and leaves to its documentation, declares each argument once and then parses sys.argv, converts types, fills in defaults and writes usage and error messages."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_ArgparseModule a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import argparse\\np = argparse.ArgumentParser(prog=\\'snowstorm\\')\\np.add_argument(\\'density\\', type=int, nargs=\\'?\\', default=4)\\np.add_argument(\\'-v\\', \\'--verbose\\', action=\\'store_true\\')\\na = p.parse_args([\\'20\\', \\'-v\\'])\\nb = p.parse_args([])\\nout = (a.density, a.verbose, b.density, b.verbose)', g), g['out'])[1])({}) evaluates to (20, True, 4, False)"@en ; chx:input "(lambda g: (exec('import argparse\\np = argparse.ArgumentParser(prog=\\'snowstorm\\')\\np.add_argument(\\'density\\', type=int, nargs=\\'?\\', default=4)\\np.add_argument(\\'-v\\', \\'--verbose\\', action=\\'store_true\\')\\na = p.parse_args([\\'20\\', \\'-v\\'])\\nb = p.parse_args([])\\nout = (a.density, a.verbose, b.density, b.verbose)', g), g['out'])[1])({})" ; chx:output "(20, True, 4, False)" .
chx:X_ArgparseModule rd:hasIOExample chx:IO_ArgparseModule .
chx:X_TextUserInterface a owl:NamedIndividual, chx:TextUserInterface ; rdfs:label "Norton Commander"@en ; skos:definition "A text-based user interface, or TUI, builds panels, menus and colour out of text characters inside a terminal window, as Norton Commander did for browsing files, and is simpler to program than a graphical user interface."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_ClipboardProgramDesign a owl:NamedIndividual, chx:ClipboardProgramDesign ; rdfs:label "pyperclip.paste(), then pyperclip.copy(result)"@en ; skos:definition "A clipboard program imports pyperclip, takes its input text from pyperclip.paste(), works on it and puts the result back with pyperclip.copy(), so a user copies, runs the command and pastes; on Linux pyperclip also needs xclip."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_ClipboardProgramDesign a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda clip: '\\n'.join('* ' + line for line in clip.split('\\n')))('Lists of animals\\nLists of aquarium life') evaluates to '* Lists of animals\\n* Lists of aquarium life'"@en ; chx:input "(lambda clip: '\\n'.join('* ' + line for line in clip.split('\\n')))('Lists of animals\\nLists of aquarium life')" ; chx:output "'* Lists of animals\\n* Lists of aquarium life'" .
chx:X_ClipboardProgramDesign rd:hasIOExample chx:IO_ClipboardProgramDesign .
chx:X_ColorfulText a owl:NamedIndividual, chx:ColorfulText ; rdfs:label "bext.fg('red'), bext.bg('blue')"@en ; skos:definition "The third-party Bext package, built on Jonathan Hartley's Colorama, sets the text colour with fg() and the background with bg(), 'reset' restores the terminal's own colours, and clear(), width(), height(), goto() and get_key() give a text program simple control of the screen; it works in a terminal, not in Mu."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_TerminalClearing a owl:NamedIndividual, chx:TerminalClearing ; rdfs:label "os.system('cls' if os.name == 'nt' else 'clear')"@en ; skos:definition "A one-line clear() function runs the cls program on Windows or clear on macOS and Linux through os.system(), choosing between them with a conditional expression of the form value1 if condition else value2."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_TerminalClearing a owl:NamedIndividual, rd:IOExample ; rdfs:label "'cls' if 'posix' == 'nt' else 'clear' evaluates to 'clear'"@en ; chx:input "'cls' if 'posix' == 'nt' else 'clear'" ; chx:output "'clear'" .
chx:X_TerminalClearing rd:hasIOExample chx:IO_TerminalClearing .
chx:X_SoundAndTextNotification a owl:NamedIndividual, chx:SoundAndTextNotification ; rdfs:label "playsound3.playsound('hello.mp3'); --verbose, --quiet"@en ; skos:definition "playsound3 plays an MP3 or WAV file and blocks until it ends; under the Unix philosophy a command prints only what another command could use and signals success through its exit code, -v or --verbose asks for more and -q or --quiet for none."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_SoundAndTextNotification a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda argv: 'verbose' if '--verbose' in argv else 'quiet' if '--quiet' in argv else 'default')(['cliprec.py', '--quiet']) evaluates to 'quiet'"@en ; chx:input "(lambda argv: 'verbose' if '--verbose' in argv else 'quiet' if '--quiet' in argv else 'default')(['cliprec.py', '--quiet'])" ; chx:output "'quiet'" .
chx:X_SoundAndTextNotification rd:hasIOExample chx:IO_SoundAndTextNotification .
chx:X_BlockCharacters a owl:NamedIndividual, chx:BlockCharacters ; rdfs:label "chr(9600), chr(9604), chr(9608)"@en ; skos:definition "chr() returns the character a number stands for; 9600, 9604 and 9608 are the top half block, the bottom half block and the full block, which snowstorm.py keeps in the constants TOP, BOTTOM and FULL."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_BlockCharacters a owl:NamedIndividual, rd:IOExample ; rdfs:label "[chr(9600), chr(9604), chr(9608)] evaluates to ['▀', '▄', '█']"@en ; chx:input "[chr(9600), chr(9604), chr(9608)]" ; chx:output "['▀', '▄', '█']" .
chx:X_BlockCharacters rd:hasIOExample chx:IO_BlockCharacters .
chx:X_DensityArgument a owl:NamedIndividual, chx:DensityArgument ; rdfs:label "DENSITY = int(sys.argv[1])"@en ; skos:definition "snowstorm.py starts with a density of 4 percent and replaces it with int(sys.argv[1]) when the user gives an argument, so python snowstorm.py 20 changes the snowstorm without editing the source code."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_DensityArgument a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda argv: int(argv[1]) if len(argv) > 1 else 4)(['snowstorm.py', '20']) evaluates to 20"@en ; chx:input "(lambda argv: int(argv[1]) if len(argv) > 1 else 4)(['snowstorm.py', '20'])" ; chx:output "20" .
chx:X_DensityArgument rd:hasIOExample chx:IO_DensityArgument .
chx:X_FlipbookAnimation a owl:NamedIndividual, chx:FlipbookAnimation ; rdfs:label "clear(); print(..., end=''); time.sleep(0.2)"@en ; skos:definition "Each pass of the endless loop clears the terminal, prints a 40-by-20 frame of random snow and two rows of ground, and pauses for 0.2 seconds, a flipbook animation that CTRL-C stops; the same clear, print and pause loop makes a dashboard."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_FlipbookAnimation a owl:NamedIndividual, rd:IOExample ; rdfs:label "'|' + (lambda r: ''.join(r.choice([chr(9600), chr(9604)]) if r.randint(0, 99) < 20 else ' ' for x in range(40)))(__import__('random').Random(1)) + '|' evaluates to '|▀ ▄      ▄▄    ▄    ▄▀▀     ▀           |'"@en ; chx:input "'|' + (lambda r: ''.join(r.choice([chr(9600), chr(9604)]) if r.randint(0, 99) < 20 else ' ' for x in range(40)))(__import__('random').Random(1)) + '|'" ; chx:output "'|▀ ▄      ▄▄    ▄    ▄▀▀     ▀           |'" .
chx:X_FlipbookAnimation rd:hasIOExample chx:IO_FlipbookAnimation .
chx:X_AlertAndConfirm a owl:NamedIndividual, chx:AlertAndConfirm ; rdfs:label "pymsgbox.alert(text), pymsgbox.confirm(text)"@en ; skos:definition "The third-party PyMsgBox package shows small Tkinter dialog boxes: alert() waits for OK and returns 'OK', and confirm() returns 'OK' or 'Cancel'; on Ubuntu, Tkinter must first be installed with sudo apt install python3-tk."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_PromptAndPassword a owl:NamedIndividual, chx:PromptAndPassword ; rdfs:label "pymsgbox.prompt(text), pymsgbox.password(text)"@en ; skos:definition "prompt() shows a text field and returns what the user typed, or None after Cancel, and password() does the same with the typing hidden behind asterisks; like input(), the dialog functions do not return until the user answers."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_BatchFile a owl:NamedIndividual, chx:BatchFile ; rdfs:label "@call ...activate.bat  @python ...yourScript.py %*  @pause  @deactivate"@en ; skos:definition "On Windows a yourScript.bat file in a PATH folder activates the virtual environment with @call, runs the script with %* to forward arguments, keeps the window open with @pause and deactivates; the Run dialog, opened with the Windows key and R, then starts it by name."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_CommandFile a owl:NamedIndividual, chx:CommandFile ; rdfs:label "yourScript.command"@en ; skos:definition "On macOS a yourScript.command text file sources the environment's activate script, runs python3 on the script and deactivates; after chmod u+x, Spotlight runs it by name, although Spotlight cannot pass command line arguments."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_ShellScriptLauncher a owl:NamedIndividual, chx:ShellScriptLauncher ; rdfs:label "#!/usr/bin/env bash  source ~/Scripts/.venv/bin/activate  python3 ~/Scripts/yourScript.py"@en ; skos:definition "On Ubuntu a shell script named yourScript, with no extension, starts with #!/usr/bin/env bash, sources the activate script, runs python3 on the script, waits for a key with read -p, deactivates, and is made executable with chmod u+x."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_DesktopEntry a owl:NamedIndividual, chx:DesktopEntry ; rdfs:label "~/.local/share/applications/yourScript.desktop"@en ; skos:definition "An Ubuntu .desktop file in ~/.local/share/applications, with the keys Name, Exec=gnome-terminal -- /home/al/Scripts/yourScript and Type=Application, puts a launcher into Dash; its Exec line needs the full /home/al path because ~ is not expanded there."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_DesktopEntry a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: (c.read_string('[Desktop Entry]\\nName=yourScript\\nExec=gnome-terminal -- /home/al/Scripts/yourScript\\nType=Application\\n'), c['Desktop Entry']['Exec'])[1])(__import__('configparser').ConfigParser()) evaluates to 'gnome-terminal -- /home/al/Scripts/yourScript'"@en ; chx:input "(lambda c: (c.read_string('[Desktop Entry]\\nName=yourScript\\nExec=gnome-terminal -- /home/al/Scripts/yourScript\\nType=Application\\n'), c['Desktop Entry']['Exec'])[1])(__import__('configparser').ConfigParser())" ; chx:output "'gnome-terminal -- /home/al/Scripts/yourScript'" .
chx:X_DesktopEntry rd:hasIOExample chx:IO_DesktopEntry .
chx:X_ShebangLine a owl:NamedIndividual, chx:ShebangLine ; rdfs:label "#!/usr/bin/env bash"@en ; skos:definition "A first line that starts with #! names the interpreter the operating system runs the file with; #!/usr/bin/env bash asks the env program to find bash on PATH, so the file needs no .sh extension."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_ShebangLine a owl:NamedIndividual, rd:IOExample ; rdfs:label "'#!/usr/bin/env bash'[2:].split() evaluates to ['/usr/bin/env', 'bash']"@en ; chx:input "'#!/usr/bin/env bash'[2:].split()" ; chx:output "['/usr/bin/env', 'bash']" .
chx:X_ShebangLine rd:hasIOExample chx:IO_ShebangLine .
chx:X_ExecutePermission a owl:NamedIndividual, chx:ExecutePermission ; rdfs:label "chmod u+x yourScript"@en ; skos:definition "chmod u+x adds the execute permission for the file's owner, without which macOS and Linux refuse to run a launcher; it sets the owner's x bit, turning -rw-r--r-- into -rwxr--r--."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_ExecutePermission a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('stat').filemode(0o100644 | 0o100) evaluates to '-rwxr--r--'"@en ; chx:input "__import__('stat').filemode(0o100644 | 0o100)" ; chx:output "'-rwxr--r--'" .
chx:X_ExecutePermission rd:hasIOExample chx:IO_ExecutePermission .
chx:X_ArgumentForwarding a owl:NamedIndividual, chx:ArgumentForwarding ; rdfs:label "%* in a batch file"@en ; skos:definition "The batch file's %* forwards every command line argument to the script; the chapter's macOS and Linux launchers have nothing after the script's path, so they forward none, and adding '$@' to that line forwards them."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_PauseBeforeClose a owl:NamedIndividual, chx:PauseBeforeClose ; rdfs:label "@pause, read -p 'Press any key to continue...' -n1 -s"@en ; skos:definition "A pause at the end of a launcher, @pause on Windows or read -p on Ubuntu, keeps the window open after the program ends so that its output can be read; a launcher for a program that prints nothing leaves it out."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_CcwdScript a owl:NamedIndividual, chx:CcwdScript ; rdfs:label "pyperclip.copy(os.getcwd())"@en ; skos:definition "ccwd.py, short for copy current working directory, is four lines: it imports pyperclip, os and sys, changes to sys.argv[1] when an argument is given and copies os.getcwd() to the clipboard, so ccwd .. copies the parent folder."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_CcwdScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, shutil\\nold = os.getcwd()\\nhome = os.path.realpath(tempfile.mkdtemp())\\nos.mkdir(os.path.join(home, \\'Scripts\\'))\\nos.chdir(os.path.join(home, \\'Scripts\\'))\\nargv = [\\'ccwd.py\\', \\'..\\']\\nif len(argv) > 1:\\n    os.chdir(argv[1])\\nout = os.getcwd() == home\\nos.chdir(old)\\nshutil.rmtree(home)', g), g['out'])[1])({}) evaluates to True"@en ; chx:input "(lambda g: (exec('import os, tempfile, shutil\\nold = os.getcwd()\\nhome = os.path.realpath(tempfile.mkdtemp())\\nos.mkdir(os.path.join(home, \\'Scripts\\'))\\nos.chdir(os.path.join(home, \\'Scripts\\'))\\nargv = [\\'ccwd.py\\', \\'..\\']\\nif len(argv) > 1:\\n    os.chdir(argv[1])\\nout = os.getcwd() == home\\nos.chdir(old)\\nshutil.rmtree(home)', g), g['out'])[1])({})" ; chx:output "True" .
chx:X_CcwdScript rd:hasIOExample chx:IO_CcwdScript .
chx:X_ProgramWorkingDirectory a owl:NamedIndividual, chx:ProgramWorkingDirectory ; rdfs:label "os.chdir(sys.argv[1])"@en ; skos:definition "Every running program has its own current working directory, so os.chdir() inside ccwd.py does not move the terminal that started it; after ccwd .. the terminal is still in the folder it was in."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_ClipboardPolling a owl:NamedIndividual, chx:ClipboardPolling ; rdfs:label "content = pyperclip.paste(); time.sleep(0.01)"@en ; skos:definition "cliprec.py reads the clipboard in an endless loop, prints the text only when it differs from previous_content, and sleeps 0.01 seconds between reads so that it checks a hundred times a second instead of hogging the CPU."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_ClipboardPolling a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda seen: [x for i, x in enumerate(seen) if i == 0 or x != seen[i - 1]])(['a', 'a', 'b', 'b', 'a']) evaluates to ['a', 'b', 'a']"@en ; chx:input "(lambda seen: [x for i, x in enumerate(seen) if i == 0 or x != seen[i - 1]])(['a', 'a', 'b', 'b', 'a'])" ; chx:output "['a', 'b', 'a']" .
chx:X_ClipboardPolling rd:hasIOExample chx:IO_ClipboardPolling .
chx:X_KeyboardInterruptExit a owl:NamedIndividual, chx:KeyboardInterruptExit ; rdfs:label "except KeyboardInterrupt: pass"@en ; skos:definition "Pressing CTRL-C raises KeyboardInterrupt; cliprec.py wraps its loop in a try block and catches it with an except clause holding only pass, so the program ends quietly instead of printing a traceback."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_KeyboardInterruptExit a owl:NamedIndividual, rd:IOExample ; rdfs:label "issubclass(KeyboardInterrupt, Exception) evaluates to False"@en ; chx:input "issubclass(KeyboardInterrupt, Exception)" ; chx:output "False" .
chx:X_KeyboardInterruptExit rd:hasIOExample chx:IO_KeyboardInterruptExit .
chx:X_OneFileBuild a owl:NamedIndividual, chx:OneFileBuild ; rdfs:label "python -m PyInstaller --onefile yourScript.py"@en ; skos:definition "python -m PyInstaller --onefile yourScript.py builds one executable file from a script; the module name needs its two capital letters and --onefile its two dashes."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_BuildAndDist a owl:NamedIndividual, chx:BuildAndDist ; rdfs:label "build/, dist/"@en ; skos:definition "PyInstaller leaves a build folder, which can be deleted, and a dist folder holding the executable, which runs without Python or a virtual environment on a computer with the same operating system as the one that built it."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_BundledInterpreter a owl:NamedIndividual, chx:BundledInterpreter ; rdfs:label "Hello, world at about 8MB"@en ; skos:definition "PyInstaller does not turn Python into machine code: it packs a copy of the interpreter with the script, so even a Hello, world executable is megabytes in size, and email providers may block it as an attachment."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "What does the PATH environment variable contain?"@en ; skos:definition "The six practice questions ask for the commands that list a folder, what PATH contains, what __file__ contains, the commands that clear the terminal, how to create a virtual environment and the argument PyInstaller needs."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:IO_PracticeQuestions a owl:NamedIndividual, rd:IOExample ; rdfs:label "{'nt': 'cls', 'posix': 'clear'}['nt'] evaluates to 'cls'"@en ; chx:input "{'nt': 'cls', 'posix': 'clear'}['nt']" ; chx:output "'cls'" .
chx:X_PracticeQuestions rd:hasIOExample chx:IO_PracticeQuestions .
chx:X_DeployablePrograms a owl:NamedIndividual, chx:DeployablePrograms ; rdfs:label "Back Up a Folder into a ZIP File, deployed"@en ; skos:definition "The practice program asks for earlier projects - the ZIP backup of chapter 11, contact extraction of chapter 9, wiki bullets of chapter 8 and the chessboard of chapter 7 - to be made runnable through launcher scripts in a PATH folder or compiled with PyInstaller."@en ; dcterms:source <http://example.org/sen0414/ch12/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 12 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch12/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 12 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "How does a typed command reach a Python program - through the terminal's search of PATH, a launcher script, a virtual environment and sys.argv - and where along that way can it go wrong?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, commands and programs of the chapter differ in current Python or on a current system, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 12 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 12 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch12/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-11."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py" .

