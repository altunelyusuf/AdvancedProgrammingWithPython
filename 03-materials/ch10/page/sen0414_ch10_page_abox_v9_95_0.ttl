pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Build, join, take apart and compare file paths with pathlib, and tell an absolute path from a relative one"@en ;
    skos:definition "The objective is met when the reader can build, join, take apart and compare file paths with pathlib, and tell an absolute path from a relative one, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter10.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Create folders, find files with glob patterns and ask the file system about a path, and tell which operations only compute a path"@en ;
    skos:definition "The objective is met when the reader can create folders, find files with glob patterns and ask the file system about a path, and tell which operations only compute a path, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter10.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Read and write text files with read_text, write_text and open in the modes r, w, a and x, and predict what each leaves in the file"@en ;
    skos:definition "The objective is met when the reader can read and write text files with read_text, write_text and open in the modes r, w, a and x, and predict what each leaves in the file, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter10.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Choose an encoding and close files safely with with, and explain what goes wrong without them"@en ;
    skos:definition "The objective is met when the reader can choose an encoding and close files safely with with, and explain what goes wrong without them, at the analyze level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter10.html> ;
    ld:bloomLevel ld:Analyze  .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Save and restore variables with a shelf, explain why a changed list can be lost, and choose between shelve and json"@en ;
    skos:definition "The objective is met when the reader can save and restore variables with a shelf, explain why a changed list can be lost, and choose between shelve and json, at the analyze level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter10.html> ;
    ld:bloomLevel ld:Analyze  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What happens when you run 'spam' / 'bacon' (two strings)?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Only a path object understands the / operator for joining; two plain strings do not become a path." ;
    ld:distractorRationale "The / operator on two strings is a division and is not defined for strings." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "TypeError: unsupported operand type(s) for /: 'str' and 'str'" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "It gives PosixPath('spam/bacon') on Linux" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "It gives the string 'spam/bacon'" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "For p = PureWindowsPath('C:/Users/Al/spam.txt'), what is p.stem?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "spam.txt is p.name, the stem plus the suffix." ;
    ld:distractorRationale ".txt is p.suffix." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "'spam.txt'" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "'spam'" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "'.txt'" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Is Path('./spam.txt') equal to Path('spam.txt')?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "The chapter says the .\\ at the start of a relative path is optional, and pathlib drops it." ;
    ld:distractorRationale "Both are ordinary relative paths and neither raises." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "No, the leading ./ makes it a different path" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "Yes, a leading ./ is dropped when the path is made" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "It raises ValueError" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does Path('note.txt').write_text('café', encoding='utf-8') return?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "The file holds 5 bytes, but write_text returns the count of characters." ;
    ld:distractorRationale "write_text returns a number; only methods such as sort return None." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "4, the number of characters written" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "5, the number of bytes written" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "None" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A file holds 'old text'. What does it hold after f = open('data.txt', 'w', encoding='utf-8') and f.close(), with nothing written?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "Write mode empties an existing file as soon as it is opened." ;
    ld:distractorRationale "Write mode creates or empties the file; only mode 'x' refuses an existing file." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "'old text', because nothing was written" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "Nothing: the file is empty" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "FileExistsError is raised" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "After f.read() has returned the whole content of a file, what does a second f.read() return?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "The file object remembers its position, which is now at the end." ;
    ld:distractorRationale "read() at the end of a file returns '' and does not raise." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "The whole content again" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "An empty string" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "It raises EOFError" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "g = Path('.').glob('*.txt') and list(g) are run twice in a row. What does the second list(g) give?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O1 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "glob gives an iterator, not a list, and a pass through it uses it up." ;
    ld:distractorRationale "list() of an exhausted iterator is an empty list." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "The same paths as the first" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "An empty list, because the iterator is used up" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "A TypeError" .
pg:Q8 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why does the with statement make a file safer than calling close() yourself?"@en ; ld:hasOption pg:Q8_O0, pg:Q8_O1, pg:Q8_O2 ; ld:hasCorrectOption pg:Q8_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "It does the opposite: the file is closed when the block ends." ;
    ld:distractorRationale "Closing releases the file; with does not lock it." .
pg:Q8_O0 a ld:AnswerOption ; rdfs:label "It closes the file however the block is left, even by an exception" .
pg:Q8_O1 a ld:AnswerOption ; rdfs:label "It keeps the file open until the program ends" .
pg:Q8_O2 a ld:AnswerOption ; rdfs:label "It stops other programs from ever reading the file" .
pg:Q9 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A shelf holds cats = ['Zophie']. The program reopens it and runs shelf['cats'].append('Pooka') without writeback=True, then closes it. What will shelf['cats'] be next time?"@en ; ld:hasOption pg:Q9_O0, pg:Q9_O1, pg:Q9_O2 ; ld:hasCorrectOption pg:Q9_O1 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "The shelf cannot see that the list was changed in place, so the change was not written." ;
    ld:distractorRationale "The key is still there; only the change is lost." .
pg:Q9_O0 a ld:AnswerOption ; rdfs:label "['Zophie', 'Pooka']" .
pg:Q9_O1 a ld:AnswerOption ; rdfs:label "['Zophie']" .
pg:Q9_O2 a ld:AnswerOption ; rdfs:label "A KeyError" .
pg:Q10 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Reading the bytes b'caf\\xc3\\xa9' as text with encoding='ascii' and the default errors. What happens?"@en ; ld:hasOption pg:Q10_O0, pg:Q10_O1, pg:Q10_O2 ; ld:hasCorrectOption pg:Q10_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "That is the result with encoding='utf-8'." ;
    ld:distractorRationale "That needs errors='replace'; the default is 'strict', which raises." .
pg:Q10_O0 a ld:AnswerOption ; rdfs:label "UnicodeDecodeError" .
pg:Q10_O1 a ld:AnswerOption ; rdfs:label "'café'" .
pg:Q10_O2 a ld:AnswerOption ; rdfs:label "The string 'caf' followed by two replacement characters" .
pg:Filepaths a ipo:ChapterSection ; rdfs:label "Filepaths"@en ;
    skos:definition "Filepaths is the branch that opens chapter 10: before a single byte of a file is read or written, the chapter builds the name that says where that file lies, using the Path() function of the pathlib module rather than the plain strings earlier chapters would have passed to open() (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_Filepaths> ;
    sen0414:anchor "#s-Filepaths" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Filepaths .
pg:PathObjects a ipo:ChapterSection ; rdfs:label "Path objects"@en ;
    skos:definition "Path objects is the branch's first part: pathlib's Path() function joins the names it is given into one path object, the / operator joins paths the same way after the first one is built, and the object it returns is one of two classes depending on the operating system it runs on (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PathObjects> ;
    sen0414:anchor "#s-PathObjects" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Filepaths .
pg:Page ipo:coversChapterSection pg:PathObjects .
pg:PathConstruction a ipo:ChapterSection ; rdfs:label "Path construction"@en ;
    skos:definition "Path('spam', 'bacon', 'eggs') joins the names it is given with the separator of the operating system it runs on: the chapter, run on Windows, prints WindowsPath('spam/bacon/eggs') and str() of it as 'spam\\\\bacon\\\\eggs', and on macOS or Linux a PosixPath and the plain string 'spam/bacon/eggs' (Sweigart, 2025). The chapter's own wording says in one sentence that Path() returns a string and in the next that it returns a WindowsPath object; it is the object, not a string, that the function actually hands back, and str() is the separate step that turns it into text."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PathConstruction> ;
    sen0414:anchor "#s-PathConstruction" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PathObjects .
pg:Page ipo:coversChapterSection pg:PathConstruction .
pg:PathFlavours a ipo:ChapterSection ; rdfs:label "Path flavours"@en ;
    skos:definition "On Windows the backslash separates folders and is not allowed inside a filename, and on macOS and Linux the backslash is an ordinary character with no special meaning at all, which is why the chapter advises writing forward slashes in source code and letting pathlib turn them into whichever separator the running operating system actually needs; looped with Path(r'C:\\Users\\Al', filename) over accounts.txt, details.csv and invite.docx, the chapter prints C:\\Users\\Al\\accounts.txt and the two lines like it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PathFlavours> ;
    sen0414:anchor "#s-PathFlavours" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PathObjects .
pg:Page ipo:coversChapterSection pg:PathFlavours .
pg:PathJoining a ipo:ChapterSection ; rdfs:label "Path joining"@en ;
    skos:definition "Path('spam') / 'bacon' / 'eggs' gives the same path as Path('spam') / Path('bacon/eggs') and as Path('spam') / Path('bacon', 'eggs'), because the / operator joins a path object to a string or to another path the same way Path construction's own function joins several names at once; the operator replaces os.path.join(), the older function earlier chapters used (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PathJoining> ;
    sen0414:anchor "#s-PathJoining" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PathObjects .
pg:Page ipo:coversChapterSection pg:PathJoining .
pg:WorkingLocations a ipo:ChapterSection ; rdfs:label "Working locations"@en ;
    skos:definition "Working locations is the branch's second part: a path is read relative to some folder, and this subsection names the two folders every running program and every user account carries, the working directory and the home directory, along with the absolute-versus-relative distinction and the dot notation that both of them use (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_WorkingLocations> ;
    sen0414:anchor "#s-WorkingLocations" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Filepaths .
pg:Page ipo:coversChapterSection pg:WorkingLocations .
pg:WorkingDirectory a ipo:ChapterSection ; rdfs:label "Working directory"@en ;
    skos:definition "Every program has a current working directory, and a filename that does not begin at the root folder is read relative to it, exactly the rule path flavours relies on when a chapter example writes a bare filename; Path.cwd() returns the working directory as a path object and os.getcwd() returns the identical folder as a plain string, while only os.chdir() changes it, there being no pathlib method of its own for that one job, and os.chdir() to a folder that does not exist raises FileNotFoundError (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_WorkingDirectory> ;
    sen0414:anchor "#s-WorkingDirectory" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WorkingLocations .
pg:Page ipo:coversChapterSection pg:WorkingDirectory .
pg:HomeDirectory a ipo:ChapterSection ; rdfs:label "Home directory"@en ;
    skos:definition "Path.home() returns the home folder of the account running the program as an absolute path object, C:\\Users\\Al in the chapter's own Windows example, a folder under C:\\Users on Windows, under /Users on macOS and, on Linux, usually under /home (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_HomeDirectory> ;
    sen0414:anchor "#s-HomeDirectory" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WorkingLocations .
pg:Page ipo:coversChapterSection pg:HomeDirectory .
pg:AbsoluteVersusRelative a ipo:ChapterSection ; rdfs:label "Absolute versus relative"@en ;
    skos:definition "An absolute path begins at the root folder, C:\\ on Windows and / on macOS and Linux, and a relative path is read relative to the working directory instead; Path.cwd().is_absolute() is True and Path('spam/bacon/eggs').is_absolute() is False, and Path.cwd() / Path('my/relative/path') gives the identical absolute path as Path('my/relative/path').absolute(), with the same relative path placed after home directory's own Path.home() instead if that folder is wanted (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_AbsoluteVersusRelative> ;
    sen0414:anchor "#s-AbsoluteVersusRelative" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WorkingLocations .
pg:Page ipo:coversChapterSection pg:AbsoluteVersusRelative .
pg:DotAndDotDot a ipo:ChapterSection ; rdfs:label "Dot and dot dot"@en ;
    skos:definition "A single dot is the special name of this folder and two dots the special name of its parent folder; neither is a real folder on disk, and the .\\ that could sit at the front of a relative path is optional, so .\\spam.txt and spam.txt name the same file, read from the working directory exactly the same way (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_DotAndDotDot> ;
    sen0414:anchor "#s-DotAndDotDot" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WorkingLocations .
pg:Page ipo:coversChapterSection pg:DotAndDotDot .
pg:PathAnatomy a ipo:ChapterSection ; rdfs:label "Path anatomy"@en ;
    skos:definition "Path anatomy is the branch's third part: once a path object exists, built as path construction describes, it breaks apart into named pieces, its anchor, name, stem, suffix and drive as single strings and its parent as another path object, every piece read off without touching the disk at all (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PathAnatomy> ;
    sen0414:anchor "#s-PathAnatomy" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Filepaths .
pg:Page ipo:coversChapterSection pg:PathAnatomy .
pg:PathAttributes a ipo:ChapterSection ; rdfs:label "Path attributes"@en ;
    skos:definition "For Path('C:/Users/Al/spam.txt'), built exactly as path construction describes, the anchor is 'C:\\\\', the name 'spam.txt', the stem 'spam', the suffix '.txt' and the drive 'C:', and the parent is itself another path object, WindowsPath('C:/Users/Al'); every one of these attributes is a plain string except parent, which path flavours's own PureWindowsPath class also carries (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PathAttributes> ;
    sen0414:anchor "#s-PathAttributes" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PathAnatomy .
pg:Page ipo:coversChapterSection pg:PathAttributes .
pg:PathParts a ipo:ChapterSection ; rdfs:label "Path parts"@en ;
    skos:definition "The parts attribute is a tuple of strings, ('C:\\\\', 'Users', 'Al', 'spam.txt') for path attributes's own chapter path, so parts[3] is 'spam.txt' and parts[0:2] is ('C:\\\\', 'Users'); the parents attribute, a different attribute from the singular parent path attributes already names, is indexed by an integer instead, parents[0] being C:/Users/Al and parents[2] being C:/ for a path such as C:/Users/Al/Desktop (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PathParts> ;
    sen0414:anchor "#s-PathParts" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PathAnatomy .
pg:Page ipo:coversChapterSection pg:PathParts .
pg:DerivedPaths a ipo:ChapterSection ; rdfs:label "Derived paths"@en ;
    skos:definition "Derived paths is the branch's fourth and last part: a new path object can be built from an existing one, changing its suffix, its name or the folder it is read relative to, all without touching any file on disk at all, closing the filepaths branch exactly where it opened, on paths as plain objects (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_DerivedPaths> ;
    sen0414:anchor "#s-DerivedPaths" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Filepaths .
pg:Page ipo:coversChapterSection pg:DerivedPaths .
pg:PathDerivation a ipo:ChapterSection ; rdfs:label "Path derivation"@en ;
    skos:definition "with_suffix('.csv') turned /home/al/reports/spam.txt into /home/al/reports/spam.csv, replacing path attributes's own suffix alone; with_name('eggs.txt') turned the same path into /home/al/reports/eggs.txt, replacing the whole name; and relative_to('/home/al') turned it into the short relative path reports/spam.txt, the inverse of absolute versus relative's own absolute(), while relative_to('/usr') on the same path raised ValueError, since that path does not begin inside /usr at all (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PathDerivation> ;
    sen0414:anchor "#s-PathDerivation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:DerivedPaths .
pg:Page ipo:coversChapterSection pg:PathDerivation .
pg:Folders a ipo:ChapterSection ; rdfs:label "Folders"@en ;
    skos:definition "Folders is chapter 10's second branch: once a path can be named and taken apart, as the filepaths branch teaches, this branch acts on the folder that path names, creating it, searching it for files with a glob pattern, and asking the file system whether it exists at all and what kind of thing it is (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_Folders> ;
    sen0414:anchor "#s-Folders" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Folders .
pg:CreatingFolders a ipo:ChapterSection ; rdfs:label "Creating folders"@en ;
    skos:definition "Creating folders is the branch's first part: the chapter makes a new folder two ways, with the older os.makedirs() function and with the newer mkdir() method of a path object built exactly as path construction describes (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_CreatingFolders> ;
    sen0414:anchor "#s-CreatingFolders" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Folders .
pg:Page ipo:coversChapterSection pg:CreatingFolders .
pg:MakingFolders a ipo:ChapterSection ; rdfs:label "Making folders"@en ;
    skos:definition "os.makedirs('C:\\\\delicious\\\\walnut\\\\waffles') creates the folder delicious, the folder walnut inside it and the folder waffles inside that, every intermediate folder along the way; Path(r'C:\\Users\\Al\\spam').mkdir() makes exactly one folder, and needs parents=True to create the folders above it the way makedirs() always does on its own (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_MakingFolders> ;
    sen0414:anchor "#s-MakingFolders" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CreatingFolders .
pg:Page ipo:coversChapterSection pg:MakingFolders .
pg:FindingFiles a ipo:ChapterSection ; rdfs:label "Finding files"@en ;
    skos:definition "Finding files is the branch's second part: once a folder exists, as making folders describes, its files can be listed by a glob pattern, a small matching language built from * and ?, searched either in one folder or recursively through every folder beneath it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_FindingFiles> ;
    sen0414:anchor "#s-FindingFiles" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Folders .
pg:Page ipo:coversChapterSection pg:FindingFiles .
pg:GlobPatterns a ipo:ChapterSection ; rdfs:label "Glob patterns"@en ;
    skos:definition "In a glob pattern * matches any run of characters and ? matches exactly one character, so '*.txt' matches every name ending in .txt, 'project?.txt' matches project1.txt, project2.txt and projectX.txt but not a two-digit name, and a bare '*' matches every name in the folder; glob() called on a folder's path gives back a generator that list() turns into a list of paths, or that a for loop can step through directly (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_GlobPatterns> ;
    sen0414:anchor "#s-GlobPatterns" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FindingFiles .
pg:Page ipo:coversChapterSection pg:GlobPatterns .
pg:RecursiveGlob a ipo:ChapterSection ; rdfs:label "Recursive glob"@en ;
    skos:definition "Glob patterns's own patterns only look inside one folder; adding a ** segment instead searches the whole tree below a folder, so glob('**/*.txt') and the dedicated rglob('*.txt') method give back the identical set of paths (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_RecursiveGlob> ;
    sen0414:anchor "#s-RecursiveGlob" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FindingFiles .
pg:Page ipo:coversChapterSection pg:RecursiveGlob .
pg:FileInformation a ipo:ChapterSection ; rdfs:label "File information"@en ;
    skos:definition "File information is the branch's third and last part: a program asks the file system whether a path exists at all, what kind of thing it is, and, once it does exist, what it holds, its size and the times it was last changed (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_FileInformation> ;
    sen0414:anchor "#s-FileInformation" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Folders .
pg:Page ipo:coversChapterSection pg:FileInformation .
pg:PathValidity a ipo:ChapterSection ; rdfs:label "Path validity"@en ;
    skos:definition "exists() is True exactly when the path exists on disk, is_file() is True when it exists and is a file, and is_dir() is True when it exists and is a folder, and every one of the three is False together for a path that is simply not there at all, so Path('D:/').exists() is False whenever no flash drive happens to be attached; the older functions os.path.exists(), isfile() and isdir() behave the same way and have accepted path objects since Python 3.6 (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PathValidity> ;
    sen0414:anchor "#s-PathValidity" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FileInformation .
pg:Page ipo:coversChapterSection pg:PathValidity .
pg:FileStat a ipo:ChapterSection ; rdfs:label "File stat"@en ;
    skos:definition "stat() returns a stat_result object whose st_size is the size of the file in bytes, which divided by 1024, by 1024 ** 2 or by 1024 ** 3 gives kilobytes, megabytes or gigabytes; st_mtime is the last time its content was modified, st_ctime is the creation time on Windows and the last time its metadata changed elsewhere, and st_atime is the last time it was read, every one of the three counted in seconds since 1 January 1970, which time.asctime(time.localtime(...)) turns back into readable text (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_FileStat> ;
    sen0414:anchor "#s-FileStat" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FileInformation .
pg:Page ipo:coversChapterSection pg:FileStat .
pg:TextFiles a ipo:ChapterSection ; rdfs:label "Text files"@en ;
    skos:definition "Text files is chapter 10's third branch: once a folder's files can be found and asked about, as the folders branch teaches, this branch actually reads and writes their content, whole with two pathlib methods, or piece by piece through a file object returned by open() (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_TextFiles> ;
    sen0414:anchor "#s-TextFiles" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:TextFiles .
pg:WholeFileMethods a ipo:ChapterSection ; rdfs:label "Whole file methods"@en ;
    skos:definition "Whole file methods is the branch's first part: pathlib's own read_text() and write_text() methods open, act on and close a whole text file in one single call each, the shortest way the chapter offers to move a string in or out of a file (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_WholeFileMethods> ;
    sen0414:anchor "#s-WholeFileMethods" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:TextFiles .
pg:Page ipo:coversChapterSection pg:WholeFileMethods .
pg:WriteAndReadText a ipo:ChapterSection ; rdfs:label "Write and read text"@en ;
    skos:definition "Path('spam.txt').write_text('Hello, world!') creates the file, or overwrites it if it is already there, and returns 13, the number of characters written, which read_text() then reads back as the identical string 'Hello, world!' (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_WriteAndReadText> ;
    sen0414:anchor "#s-WriteAndReadText" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WholeFileMethods .
pg:Page ipo:coversChapterSection pg:WriteAndReadText .
pg:PlainVersusBinaryFiles a ipo:ChapterSection ; rdfs:label "Plain versus binary files"@en ;
    skos:definition "Plaintext files hold only basic text characters, with no font, size or colour information at all, and the .txt and .py files write and read text's own examples use are exactly this kind; every other file, a word processing document, a PDF, an image, a spreadsheet or a compiled program, is a binary file that looks like nonsense opened in a plain text editor, and the chapter reads and writes only the plaintext kind directly, leaving binary files to other modules such as shelve later in this chapter (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PlainVersusBinaryFiles> ;
    sen0414:anchor "#s-PlainVersusBinaryFiles" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WholeFileMethods .
pg:Page ipo:coversChapterSection pg:PlainVersusBinaryFiles .
pg:OpenedFiles a ipo:ChapterSection ; rdfs:label "Opened files"@en ;
    skos:definition "Opened files is the branch's second part: open() returns a file object that whole file methods's own one-call methods hide entirely, and that object is read from, written to and closed by hand, each its own separate step (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_OpenedFiles> ;
    sen0414:anchor "#s-OpenedFiles" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:TextFiles .
pg:Page ipo:coversChapterSection pg:OpenedFiles .
pg:OpenAndModes a ipo:ChapterSection ; rdfs:label "Open and modes"@en ;
    skos:definition "open('hello.txt', encoding='UTF-8') opens the file in read mode, the default, which can also be asked for by name with 'r'; mode 'w' overwrites the file after emptying it and mode 'a' appends to the end of it, and both of these, like 'r', create the file first if it is not already there; in the chapter's own session, bacon_file.write('Hello, world!\\n') returned 14 and a following write('Bacon is not a vegetable.') returned 25, and reading the file back afterward printed both lines in order (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_OpenAndModes> ;
    sen0414:anchor "#s-OpenAndModes" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OpenedFiles .
pg:Page ipo:coversChapterSection pg:OpenAndModes .
pg:ReadMethods a ipo:ChapterSection ; rdfs:label "Read methods"@en ;
    skos:definition "read() returns the whole content of the file as one single string and readlines() returns a list of strings, one for each line, every string but the last one ending in its own newline character; run on the chapter's own sonnet file, readlines() returned the four lines the chapter itself prints there (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_ReadMethods> ;
    sen0414:anchor "#s-ReadMethods" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OpenedFiles .
pg:Page ipo:coversChapterSection pg:ReadMethods .
pg:LineIteration a ipo:ChapterSection ; rdfs:label "Line iteration"@en ;
    skos:definition "Read methods's own read() and readlines() each load a whole file into memory at once; a file object can instead be looped over directly, one line at a time, each line still keeping its own newline, and no more than one line ever held in memory together, which matters for a file too large to read whole (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_LineIteration> ;
    sen0414:anchor "#s-LineIteration" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OpenedFiles .
pg:Page ipo:coversChapterSection pg:LineIteration .
pg:WriteMethod a ipo:ChapterSection ; rdfs:label "Write method"@en ;
    skos:definition "write() writes exactly the string it is given into the file and returns the number of characters written, counting a newline if one is included; unlike print(), write() never adds a newline of its own, so a program that wants one must write it explicitly, exactly as open and modes's own bacon_file.write('Hello, world!\\n') does by hand (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_WriteMethod> ;
    sen0414:anchor "#s-WriteMethod" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OpenedFiles .
pg:Page ipo:coversChapterSection pg:WriteMethod .
pg:CloseMethod a ipo:ChapterSection ; rdfs:label "Close method"@en ;
    skos:definition "Every file opened with open() needs close() called on it eventually, which the chapter asks for before the same file is opened again anywhere else in the same program (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_CloseMethod> ;
    sen0414:anchor "#s-CloseMethod" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OpenedFiles .
pg:Page ipo:coversChapterSection pg:CloseMethod .
pg:TextEncoding a ipo:ChapterSection ; rdfs:label "Text encoding"@en ;
    skos:definition "Text encoding is the branch's third part: the encoding, newline and errors arguments every open and modes call and every whole file method call can take decide exactly how characters on screen become bytes on disk, and back again (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_TextEncoding> ;
    sen0414:anchor "#s-TextEncoding" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:TextFiles .
pg:Page ipo:coversChapterSection pg:TextEncoding .
pg:EncodingArgument a ipo:ChapterSection ; rdfs:label "Encoding argument"@en ;
    skos:definition "The encoding argument names the encoding used to convert the bytes of a file into the characters of a text string; the chapter says it is almost always 'utf-8', the default on macOS and Linux, that Windows instead defaults to 'cp1252', and that passing encoding='utf-8' to open() in every plaintext mode is simply a good habit to keep (Sweigart, 2025). The documentation is more exact still: the real default is whatever locale.getencoding() reports for the machine running the program, and it recommends UTF-8 by name rather than leaving the choice to the locale at all."@en ; dcterms:source <http://example.org/sen0414/ch10#S_EncodingArgument> ;
    sen0414:anchor "#s-EncodingArgument" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TextEncoding .
pg:Page ipo:coversChapterSection pg:EncodingArgument .
pg:NewlineTranslation a ipo:ChapterSection ; rdfs:label "Newline translation"@en ;
    skos:definition "In text mode Python reads every line ending it finds, \\n, \\r and \\r\\n alike, as the single character \\n, and when writing turns that \\n back into whichever line ending the running operating system actually expects; the newline argument changes this translation, and the chapter, as read, does not present it at all (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_NewlineTranslation> ;
    sen0414:anchor "#s-NewlineTranslation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TextEncoding .
pg:Page ipo:coversChapterSection pg:NewlineTranslation .
pg:DecodingErrors a ipo:ChapterSection ; rdfs:label "Decoding errors"@en ;
    skos:definition "The errors argument chooses what happens to bytes that the chosen encoding simply cannot turn into characters at all: the default setting, 'strict', raises an error exactly as encoding argument's own ascii example does, 'replace' inserts the placeholder character U+FFFD in their place, 'ignore' drops them silently, and 'surrogateescape' keeps them in a form that can later be written back out unchanged (Sweigart, 2025) (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_DecodingErrors> ;
    sen0414:anchor "#s-DecodingErrors" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TextEncoding .
pg:Page ipo:coversChapterSection pg:DecodingErrors .
pg:AutomaticClosing a ipo:ChapterSection ; rdfs:label "Automatic closing"@en ;
    skos:definition "Automatic closing is the branch's fourth and last part: the with statement closes a file object on every way out of its own block, replacing close method's own explicit call with something that cannot be forgotten by accident (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_AutomaticClosing> ;
    sen0414:anchor "#s-AutomaticClosing" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:TextFiles .
pg:Page ipo:coversChapterSection pg:AutomaticClosing .
pg:WithStatement a ipo:ChapterSection ; rdfs:label "With statement"@en ;
    skos:definition "A with statement creates a context manager and runs the block beneath it, closing the file object when execution leaves that block however it does, by reaching the block's own end, by a return statement, or by an unhandled exception, so code written as with open('data.txt', 'w', encoding='UTF-8') as file_obj: never needs close method's own explicit call at all (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_WithStatement> ;
    sen0414:anchor "#s-WithStatement" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:AutomaticClosing .
pg:Page ipo:coversChapterSection pg:WithStatement .
pg:ClosedFileError a ipo:ChapterSection ; rdfs:label "Closed file error"@en ;
    skos:definition "Once with statement's own block has ended, or once close method's own close() has been called by hand, the file object can no longer be used at all: a read or a write on it raises ValueError: I/O operation on closed file, the identical error close method's own example already raises, and the object's closed attribute reads True from that point on; the chapter, as read, does not show this error happening at all (Sweigart, 2025) (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_ClosedFileError> ;
    sen0414:anchor "#s-ClosedFileError" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:AutomaticClosing .
pg:Page ipo:coversChapterSection pg:ClosedFileError .
pg:SavedData a ipo:ChapterSection ; rdfs:label "Saved data"@en ;
    skos:definition "Saved data is chapter 10's fourth branch: once text can be read and written, as the text files branch teaches, a program's own variables, not only plain strings, can be made to outlive the program that created them by being saved to a file and read back in a later run (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_SavedData> ;
    sen0414:anchor "#s-SavedData" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:SavedData .
pg:Shelves a ipo:ChapterSection ; rdfs:label "Shelves"@en ;
    skos:definition "Shelves is the branch's first part: the shelve module opens a binary file on disk and makes it behave like a dictionary whose keys and values survive between one run of the program and the next (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_Shelves> ;
    sen0414:anchor "#s-Shelves" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SavedData .
pg:Page ipo:coversChapterSection pg:Shelves .
pg:ShelveOpen a ipo:ChapterSection ; rdfs:label "Shelve open"@en ;
    skos:definition "shelve.open('mydata') returns a shelf value, and shelf_file['cats'] = ['Zophie', 'Pooka', 'Simon'] stores a whole list under the string key 'cats', exactly like assigning into a dictionary; close() ends that one session of use, and reopening the same file afterward gives the identical list straight back, type(shelf_file) reading as <class 'shelve.DbfilenameShelf'> (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_ShelveOpen> ;
    sen0414:anchor "#s-ShelveOpen" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Shelves .
pg:Page ipo:coversChapterSection pg:ShelveOpen .
pg:ShelfAsDictionary a ipo:ChapterSection ; rdfs:label "Shelf as dictionary"@en ;
    skos:definition "A shelf has keys() and values() methods exactly like an ordinary dictionary, so list(shelf_file.keys()) is ['cats'] and list(shelf_file.values()) is [['Zophie', 'Pooka', 'Simon']], the same list shelve open's own example first stored there (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_ShelfAsDictionary> ;
    sen0414:anchor "#s-ShelfAsDictionary" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Shelves .
pg:Page ipo:coversChapterSection pg:ShelfAsDictionary .
pg:ShelfWriteback a ipo:ChapterSection ; rdfs:label "Shelf writeback"@en ;
    skos:definition "The chapter, as read, stores values into a shelf but does not show changing one already there; run here, a shelf holding ['Zophie'] under 'cats' still held exactly ['Zophie'] after a reopened shelf's own shelf['cats'].append('Pooka') call, because shelf as dictionary's own point, that each read gives back a copy rather than the original object, means the shelf itself never saw the list change at all (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_ShelfWriteback> ;
    sen0414:anchor "#s-ShelfWriteback" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Shelves .
pg:Page ipo:coversChapterSection pg:ShelfWriteback .
pg:ShelfBackend a ipo:ChapterSection ; rdfs:label "Shelf backend"@en ;
    skos:definition "The chapter says that after shelve open's own first shelf is made, the folder holds three files, mydata.bak, mydata.dat and mydata.dir, on Windows, a single mydata.db on macOS, and a single mydata on Linux, and that exactly which format is used underneath does not matter to the program at all (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_ShelfBackend> ;
    sen0414:anchor "#s-ShelfBackend" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Shelves .
pg:Page ipo:coversChapterSection pg:ShelfBackend .
pg:ShelfSecurity a ipo:ChapterSection ; rdfs:label "Shelf security"@en ;
    skos:definition "The chapter simply says to use the shelve module to save data between runs of a Python program (Sweigart, 2025); the documentation adds a warning worth repeating in full, because shelve is built on pickle underneath, that it is insecure to open a shelf file from an untrusted source at all, since loading one can execute arbitrary code the moment it is read, that two programs reading and writing the same shelf file at once is not supported, that the values stored should stay fairly small, and that on macOS the dbm.ndbm backend can silently corrupt the file on an update (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_ShelfSecurity> ;
    sen0414:anchor "#s-ShelfSecurity" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Shelves .
pg:Page ipo:coversChapterSection pg:ShelfSecurity .
pg:PlainAlternative a ipo:ChapterSection ; rdfs:label "Plain alternative"@en ;
    skos:definition "Plain alternative is the branch's second and last part: plain data, the kind shelf as dictionary's own lists and dictionaries hold, can also be saved in a format that is not tied to Python at all, one any other program or language can open and read (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PlainAlternative> ;
    sen0414:anchor "#s-PlainAlternative" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SavedData .
pg:Page ipo:coversChapterSection pg:PlainAlternative .
pg:JsonSaving a ipo:ChapterSection ; rdfs:label "Json saving"@en ;
    skos:definition "The chapter, as read, saves data with shelve alone, and the tutorial presents json instead for lists and dictionaries of simple values: json.dump(x, f) writes such a value to an open file and json.load(f) reads one back, the file itself must be UTF-8, the encoding encoding argument already names as the sensible default, and only the simplest types, strings, numbers, lists, dictionaries, true, false and null, are handled without extra work of any kind (Sweigart, 2025) (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_JsonSaving> ;
    sen0414:anchor "#s-JsonSaving" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PlainAlternative .
pg:Page ipo:coversChapterSection pg:JsonSaving .
pg:ChapterPrograms a ipo:ChapterSection ; rdfs:label "Chapter programs"@en ;
    skos:definition "Chapter programs is chapter 10's fifth and last branch: the chapter's one project and its two practice programs put every earlier branch's file functions to work together in one running program apiece, rather than one function or one method at a time (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_ChapterPrograms> ;
    sen0414:anchor "#s-ChapterPrograms" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:ChapterPrograms .
pg:QuizProgram a ipo:ChapterSection ; rdfs:label "Quiz program"@en ;
    skos:definition "Quiz program is the branch's first part: Project 4 writes 35 different state-capitals quizzes and their 35 matching answer keys to text files, in four numbered steps, using open and modes's own write mode for every one of the seventy files it creates (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_QuizProgram> ;
    sen0414:anchor "#s-QuizProgram" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ChapterPrograms .
pg:Page ipo:coversChapterSection pg:QuizProgram .
pg:QuizData a ipo:ChapterSection ; rdfs:label "Quiz data"@en ;
    skos:definition "Step 1 of the quiz program imports random, keeps the 50 states and their capitals in one dictionary named capitals, and opens a for loop over range(35) that will make every one of the thirty-five quiz files in turn (Sweigart, 2025); in the chapter's own printed listing the key 'West Virginia' is broken awkwardly over two lines of the page."@en ; dcterms:source <http://example.org/sen0414/ch10#S_QuizData> ;
    sen0414:anchor "#s-QuizData" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:QuizProgram .
pg:Page ipo:coversChapterSection pg:QuizData .
pg:QuizFiles a ipo:ChapterSection ; rdfs:label "Quiz files"@en ;
    skos:definition "Steps 2 to 4 open capitalsquiz<N>.txt and capitalsquiz_answers<N>.txt in write mode for each pass of quiz data's own loop, write a short header, shuffle a list of all 50 states with random.shuffle(), delete the one right capital from a copy of the dictionary's own values, choose three wrong capitals at random with random.sample(), shuffle those three together with the one right answer, and write each question out with the letters 'ABCD'[i] naming its four options and the key letter 'ABCD'[answer_options.index(correct_answer)] naming the right one, before close method's own close() ends both files (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_QuizFiles> ;
    sen0414:anchor "#s-QuizFiles" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:QuizProgram .
pg:Page ipo:coversChapterSection pg:QuizFiles .
pg:QuizOutputDiffers a ipo:ChapterSection ; rdfs:label "Quiz output differs"@en ;
    skos:definition "The chapter's own prose prints a quiz file reading 'State Capitals Quiz (Form 1)' and '1. What is the capital of West Virginia?', and an answer key reading, one answer per line, '1."@en ; dcterms:source <http://example.org/sen0414/ch10#S_QuizOutputDiffers> ;
    sen0414:anchor "#s-QuizOutputDiffers" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:QuizProgram .
pg:Page ipo:coversChapterSection pg:QuizOutputDiffers .
pg:PracticeWork a ipo:ChapterSection ; rdfs:label "Practice work"@en ;
    skos:definition "Practice work is the branch's second and last part: the chapter ends with eleven practice questions and two short programs left for a reader to write, each one built from the same read, write and regular-expression tools the rest of the chapter, and chapter 9 before it, already covers (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PracticeWork> ;
    sen0414:anchor "#s-PracticeWork" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ChapterPrograms .
pg:Page ipo:coversChapterSection pg:PracticeWork .
pg:MadLibs a ipo:ChapterSection ; rdfs:label "Mad libs"@en ;
    skos:definition "Practice program 1 reads a text file, asks the user for a replacement word wherever the placeholder ADJECTIVE, NOUN, ADVERB or VERB appears in it, prints the finished result, and saves that same result to a brand-new text file, leaving the original untouched (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_MadLibs> ;
    sen0414:anchor "#s-MadLibs" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticeWork .
pg:Page ipo:coversChapterSection pg:MadLibs .
pg:RegexSearch a ipo:ChapterSection ; rdfs:label "Regex search"@en ;
    skos:definition "Practice program 2 opens every .txt file inside a folder, exactly the files glob patterns's own '*.txt' would list there, and prints every line in any of them that matches a regular expression typed in by the user (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch10#S_RegexSearch> ;
    sen0414:anchor "#s-RegexSearch" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticeWork .
pg:Page ipo:coversChapterSection pg:RegexSearch .
pg:PracticeQuestions a ipo:ChapterSection ; rdfs:label "Practice questions"@en ;
    skos:definition "The chapter's 11 practice questions ask what a relative path is relative to, what an absolute path begins with, what Path('C:/Users') / 'Al' and the plain string expression 'C:/Users' / 'Al' each evaluate to, what os.getcwd() and os.chdir() each do, what the . and .."@en ; dcterms:source <http://example.org/sen0414/ch10#S_PracticeQuestions> ;
    sen0414:anchor "#s-PracticeQuestions" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticeWork .
pg:Page ipo:coversChapterSection pg:PracticeQuestions .
pg:PathObjects sen0414:hasPanel pg:PathConstruction, pg:PathFlavours, pg:PathJoining .
