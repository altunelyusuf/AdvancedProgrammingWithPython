pg:CE_01 a ipo:CodeExample ; rdfs:label "Building paths with Path and /"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 6 of the deck and runs 9 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 6 ; sen0414:orderInTab 1 ;
    sen0414:code "from pathlib import Path, PureWindowsPath\np = Path('spam', 'bacon', 'eggs')\nprint(p)\nprint(Path('spam') / 'bacon' / 'eggs' == p)\nprint(PureWindowsPath('spam', 'bacon', 'eggs'))\ntry:\n    print('spam' / 'bacon')\nexcept TypeError:\n    print('two strings cannot use the slash')" ; sen0414:expectedOutput "spam/bacon/eggs\nTrue\nspam\\bacon\\eggs\ntwo strings cannot use the slash\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "Working directory, home, absolute and relative"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 9 of the deck and runs 6 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 2 ;
    sen0414:code "import os, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\nprint(Path.cwd().is_absolute(), Path.home().is_absolute())\nprint(Path('spam/bacon/eggs').is_absolute())\nprint(Path('./spam.txt') == Path('spam.txt'))\nprint(Path('spam.txt').resolve() == Path.cwd() / 'spam.txt')" ; sen0414:expectedOutput "True True\nFalse\nTrue\nTrue\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "The parts of a filepath"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 10 of the deck and runs 7 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 3 ;
    sen0414:code "from pathlib import PureWindowsPath\np = PureWindowsPath('C:/Users/Al/spam.txt')\nprint(p.drive, p.name, p.stem, p.suffix)\nprint(p.parent)\nprint(p.parts)\nprint(p.parents[1])\nprint(p.with_suffix('.csv'))" ; sen0414:expectedOutput "C: spam.txt spam .txt\nC:\\Users\\Al\n('C:\\\\', 'Users', 'Al', 'spam.txt')\nC:\\Users\nC:\\Users\\Al\\spam.csv\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Creating new folders"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 13 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 13 ; sen0414:orderInTab 4 ;
    sen0414:code "import os, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\nos.makedirs('delicious/walnut/waffles')\nPath('delicious/walnut/pecan').mkdir()\nPath('delicious').mkdir(exist_ok=True)\nfor p in sorted(Path('delicious').rglob('*')):\n    print(p)" ; sen0414:expectedOutput "delicious/walnut\ndelicious/walnut/pecan\ndelicious/walnut/waffles\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "Finding files with glob patterns"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 14 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 5 ;
    sen0414:code "import os, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\nfor name in ('project1.txt', 'project2.txt', 'project10.txt', 'notes.csv'):\n    Path(name).write_text('x')\nprint(sorted(p.name for p in Path('.').glob('project?.txt')))\nprint(sorted(p.name for p in Path('.').glob('*.txt')))\nprint(sorted(p.name for p in Path('.').glob('*')))" ; sen0414:expectedOutput "['project1.txt', 'project2.txt']\n['project1.txt', 'project10.txt', 'project2.txt']\n['notes.csv', 'project1.txt', 'project10.txt', 'project2.txt']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Checking a path and reading file facts"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 15 of the deck and runs 9 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 15 ; sen0414:orderInTab 6 ;
    sen0414:code "import os, tempfile, time; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\nf = Path('f.txt')\nprint(f.exists())\nf.write_text('Hello, world!')\nprint(f.exists(), f.is_file(), f.is_dir(), Path('.').is_dir())\nprint(f.stat().st_size)\nos.utime('f.txt', (1712627129, 1712627129))\nprint(time.asctime(time.gmtime(f.stat().st_mtime)))" ; sen0414:expectedOutput "False\nTrue True False True\n13\nTue Apr  9 01:45:29 2024\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "Whole-file reading and writing"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 18 of the deck and runs 9 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 18 ; sen0414:orderInTab 7 ;
    sen0414:code "import os, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\nspam = Path('spam.txt')\nprint(spam.write_text('Hello, world!'))\nprint(spam.read_text())\nprint(spam.write_text('café', encoding='utf-8'))\nprint(spam.stat().st_size)\nPath('b.bin').write_bytes(bytes([0, 1, 255]))\nprint(Path('b.bin').read_bytes())" ; sen0414:expectedOutput "13\nHello, world!\n4\n5\nb'\\x00\\x01\\xff'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "open, read and close"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 20 of the deck and runs 9 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 20 ; sen0414:orderInTab 8 ;
    sen0414:code "import os, tempfile; os.chdir(tempfile.mkdtemp())\nbacon = open('bacon.txt', 'w', encoding='utf-8')\nprint(bacon.write('Hello, world!\\n'))\nprint(bacon.write('Bacon is not a vegetable.'))\nbacon.close()\nreader = open('bacon.txt', encoding='utf-8')\nprint(reader.read())\nreader.close()\nprint(reader.closed)" ; sen0414:expectedOutput "14\n25\nHello, world!\nBacon is not a vegetable.\nTrue\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "read, readline, readlines and seek"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 21 of the deck and runs 11 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 21 ; sen0414:orderInTab 9 ;
    sen0414:code "import os, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\npoem = Path('poem.txt')\npoem.write_text('roses\\nviolets\\nsugar\\n', encoding='utf-8')\nf = open(poem, encoding='utf-8')\nprint(repr(f.readline()), f.tell())\nprint(f.readlines(), f.tell())\nprint(repr(f.read()), f.tell())\nf.seek(0)\nprint(repr(f.read(5)), f.tell())\nf.close()" ; sen0414:expectedOutput "'roses\\n' 6\n['violets\\n', 'sugar\\n'] 20\n'' 20\n'roses' 5\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "The with statement"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 23 of the deck and runs 8 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 10 ;
    sen0414:code "import os, tempfile; os.chdir(tempfile.mkdtemp())\nwith open('data.txt', 'w', encoding='utf-8') as file_obj:\n    print(file_obj.write('abc'), file_obj.closed)\nprint(file_obj.closed)\ntry:\n    with open('data.txt', 'w', encoding='utf-8') as g: raise RuntimeError('boom')\nexcept RuntimeError:\n    print(g.closed)" ; sen0414:expectedOutput "3 False\nTrue\nTrue\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "Write modes w, a and x"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 24 of the deck and runs 9 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 11 ;
    sen0414:code "import os, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\nlog = Path('log.txt')\nfor mode, text in (('w', 'A\\n'), ('a', 'B\\n'), ('a', 'C\\n'), ('w', 'D\\n')):\n    with open(log, mode, encoding='utf-8') as f:\n        f.write(text)\n    print(mode, repr(log.read_text()))\ntry: open(log, 'x')\nexcept FileExistsError: print('x refuses: the file exists')" ; sen0414:expectedOutput "w 'A\\n'\na 'A\\nB\\n'\na 'A\\nB\\nC\\n'\nw 'D\\n'\nx refuses: the file exists\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "The encoding argument"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 25 of the deck and runs 9 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 12 ;
    sen0414:code "import os, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\nPath('a.txt').write_text('café', encoding='utf-8')\nprint(open('a.txt', encoding='utf-8').read())\nprint(open('a.txt', encoding='ascii', errors='replace').read())\ntry: print(open('a.txt', encoding='ascii').read())\nexcept UnicodeDecodeError: print('ascii cannot read the byte 0xc3')\nfor enc in ('utf-8', 'utf-16-le', 'latin-1'):\n    print(enc, len('café'.encode(enc)))" ; sen0414:expectedOutput "café\ncaf��\nascii cannot read the byte 0xc3\nutf-8 5\nutf-16-le 8\nlatin-1 4\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Saving variables with a shelf"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 28 of the deck and runs 12 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 28 ; sen0414:orderInTab 13 ;
    sen0414:code "import shelve\nstore = {}\nshelf = shelve.Shelf(store)\nshelf['cats'] = ['Zophie', 'Pooka', 'Simon']\nprint(list(shelf.keys()), shelf['cats'])\nprint(type(store[b'cats']).__name__)\nshelf['cats'].append('Fat-tail')\nprint(len(shelf['cats']))\ncats = shelf['cats']\ncats.append('Fat-tail')\nshelf['cats'] = cats\nprint(len(shelf['cats']))" ; sen0414:expectedOutput "['cats'] ['Zophie', 'Pooka', 'Simon']\nbytes\n3\n4\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "json as the plain alternative"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 30 of the deck and runs 5 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 30 ; sen0414:orderInTab 14 ;
    sen0414:code "import json\ndata = {'cats': ['Zophie', 'Pooka'], 'pair': (1, 2), 5: 'five'}\ntext = json.dumps(data)\nprint(text)\nprint(json.loads(text))" ; sen0414:expectedOutput "{'cats': ['Zophie', 'Pooka'], 'pair': [1, 2], '5': 'five'}\n{'cats': ['Zophie', 'Pooka'], 'pair': [1, 2], '5': 'five'}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "Practice program: Mad Libs"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 34 of the deck and runs 9 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 34 ; sen0414:orderInTab 15 ;
    sen0414:code "import os, re, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\nstory = 'The ADJECTIVE panda walked to the NOUN and then VERB.'\nPath('panda.txt').write_text(story, encoding='utf-8')\nanswers = iter(['silly', 'chandelier', 'screamed'])\ntext = Path('panda.txt').read_text(encoding='utf-8')\nresult = re.sub(r'ADJECTIVE|NOUN|VERB', lambda m: next(answers), text)\nPath('panda_filled.txt').write_text(result, encoding='utf-8')\nprint(result)" ; sen0414:expectedOutput "The silly panda walked to the chandelier and then screamed.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "Practice program: Regex Search"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 35 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 16 ;
    sen0414:code "import os, re, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\nput = lambda f, t: Path(f).write_text(t, encoding='utf-8')\nput('a.txt', 'spam and eggs\\nbacon alone\\nSPAM again\\n')\nput('b.txt', 'nothing here\\nspam, glorious spam\\n')\nput('notes.csv', 'spam,1\\n')\nfor p in sorted(Path('.').glob('*.txt')):\n    lines = p.read_text(encoding='utf-8').splitlines()\n    for n, line in enumerate(lines, 1):\n        if re.search('spam', line): print(f'{p.name}:{n}: {line}')" ; sen0414:expectedOutput "a.txt:1: spam and eggs\nb.txt:2: spam, glorious spam\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "Project 4, step 1: one quiz question"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 36 of the deck and runs 12 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 36 ; sen0414:orderInTab 17 ;
    sen0414:code "import random\ncapitals = {'Alabama': 'Montgomery', 'Alaska': 'Juneau',\n            'Arizona': 'Phoenix', 'Arkansas': 'Little Rock',\n            'California': 'Sacramento'}\nrandom.seed(10)\nstate = random.choice(list(capitals))\nothers = [c for c in capitals.values() if c != capitals[state]]\noptions = random.sample(others, 3) + [capitals[state]]\nrandom.shuffle(options)\nprint(f'What is the capital of {state}?')\nfor letter, option in zip('ABCD', options):\n    print(f'  {letter}. {option}')" ; sen0414:expectedOutput "What is the capital of California?\n  A. Phoenix\n  B. Juneau\n  C. Sacramento\n  D. Montgomery\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "Project 4, step 2: quiz and answer-key files"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 37 of the deck and runs 15 lines of Python that print 8 lines of output."@en ; dcterms:source "03-materials/ch10/page/chapter_code_ch10_v1_0_0.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 18 ;
    sen0414:code "import os, random, tempfile; os.chdir(tempfile.mkdtemp())\nfrom pathlib import Path\ncaps = {'Ohio': 'Columbus', 'Utah': 'Salt Lake City',\n        'Iowa': 'Des Moines', 'Maine': 'Augusta'}\nrandom.seed(10)\nquiz, key = [], []\nfor n, state in enumerate(caps, 1):\n    others = [c for c in caps.values() if c != caps[state]]\n    options = random.sample(others, 3) + [caps[state]]\n    random.shuffle(options)\n    quiz.append(f'{n}. {state}: ' + ' / '.join(options))\n    key.append(f'{n}. {'ABCD'[options.index(caps[state])]}')\nfor f, rows in (('quiz1.txt', quiz), ('key1.txt', key)):\n    Path(f).write_text('\\n'.join(rows) + '\\n', encoding='utf-8')\n    print(Path(f).read_text(encoding='utf-8'), end='')" ; sen0414:expectedOutput "1. Ohio: Salt Lake City / Augusta / Des Moines / Columbus\n2. Utah: Des Moines / Columbus / Salt Lake City / Augusta\n3. Iowa: Augusta / Salt Lake City / Des Moines / Columbus\n4. Maine: Columbus / Augusta / Salt Lake City / Des Moines\n1. D\n2. C\n3. C\n4. B\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
