pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 10 Stage 3 document"@en ;
    skos:definition "The source document is the Stage 3 document of chapter 10, which has one section for each of the 59 concepts of the chapter."@en ; dcterms:source <http://example.org/sen0414/ch10/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4, pg:CO5 .
