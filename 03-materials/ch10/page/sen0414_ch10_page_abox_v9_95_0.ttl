pg:PathAnatomy sen0414:hasPanel pg:PathAttributes, pg:PathParts .
pg:DerivedPaths sen0414:hasPanel pg:PathDerivation .
pg:CreatingFolders sen0414:hasPanel pg:MakingFolders .
pg:FindingFiles sen0414:hasPanel pg:GlobPatterns, pg:RecursiveGlob .
pg:FileInformation sen0414:hasPanel pg:PathValidity, pg:FileStat .
pg:WholeFileMethods sen0414:hasPanel pg:WriteAndReadText, pg:PlainVersusBinaryFiles .
pg:OpenedFiles sen0414:hasPanel pg:OpenAndModes, pg:ReadMethods, pg:LineIteration, pg:WriteMethod, pg:CloseMethod .
pg:TextEncoding sen0414:hasPanel pg:EncodingArgument, pg:NewlineTranslation, pg:DecodingErrors .
pg:AutomaticClosing sen0414:hasPanel pg:WithStatement, pg:ClosedFileError .
pg:Shelves sen0414:hasPanel pg:ShelveOpen, pg:ShelfAsDictionary, pg:ShelfWriteback, pg:ShelfBackend, pg:ShelfSecurity .
