   "setup": [
    "import os, tempfile",
    "os.chdir(tempfile.mkdtemp())",
    "try:",
    "    import dbm",
    "except ImportError:",
    "    import sys, types, pickle",
    "    class Db(dict):",
    "        def __init__(self, name):",
    "            self.name = name + '.db'",
    "            if os.path.exists(self.name):",
    "                self.update(pickle.load(open(self.name, 'rb')))",
    "        def close(self):",
    "            pickle.dump(dict(self), open(self.name, 'wb'))",
    "    def dbm_open(name, flag='r'):",
    "        return Db(name)",
    "    dbm = types.ModuleType('dbm')",
    "    dbm.open = dbm_open",
    "    dbm.error = (OSError,)",
    "    sys.modules['dbm'] = dbm",
    "import pathlib, sys",
    "class WindowsPath(pathlib.PosixPath):",
    "    def __str__(self):",
    "        s = pathlib.PosixPath.__str__(self)",
    "        if not sys._getframe(1).f_code.co_filename.endswith('.py'):",
    "            s = ('C:' if s.startswith('/') else '') + s.replace('/', '\\\\')",
    "        return s",
    "    def __repr__(self): return 'WindowsPath(%r)' % (('C:' if pathlib.PosixPath.__str__(self).startswith('/') else '') + pathlib.PosixPath.__str__(self))",
