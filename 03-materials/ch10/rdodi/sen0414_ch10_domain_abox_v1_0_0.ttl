chx:X_PathConstruction a owl:NamedIndividual, chx:PathConstruction ; rdfs:label "Path('spam', 'bacon', 'eggs')"@en ; skos:definition "Path() joins the names it is given with the separator of the operating system and returns a path object, a PosixPath on macOS and Linux and a WindowsPath on Windows; str() of it gives the path as text."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_PathConstruction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(repr(__import__('pathlib').PureWindowsPath('spam', 'bacon', 'eggs').parents[1]), str(__import__('pathlib').PureWindowsPath('spam', 'bacon', 'eggs'))) evaluates to ('PureWindowsPath('spam')', 'spam\\\\bacon\\\\eggs')"@en ; chx:input "(repr(__import__('pathlib').PureWindowsPath('spam', 'bacon', 'eggs').parents[1]), str(__import__('pathlib').PureWindowsPath('spam', 'bacon', 'eggs')))" ; chx:output "('PureWindowsPath('spam')', 'spam\\\\bacon\\\\eggs')" .
chx:X_PathConstruction rd:hasIOExample chx:IO_PathConstruction .
chx:X_PathJoining a owl:NamedIndividual, chx:PathJoining ; rdfs:label "Path('spam') / 'bacon' / 'eggs'"@en ; skos:definition "The / operator joins a path object with a string or another path into a new path; one of the first two operands must be a path, because two strings raise TypeError, and os.path.join() is the older function that joins strings."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_PathJoining a owl:NamedIndividual, rd:IOExample ; rdfs:label "((__import__('pathlib').PurePosixPath('spam') / 'bacon' / 'eggs').parts[:2], repr('spam' / __import__('pathlib').PurePosixPath('bacon'))) evaluates to (('spam', 'bacon'), 'PurePosixPath('spam/bacon')')"@en ; chx:input "((__import__('pathlib').PurePosixPath('spam') / 'bacon' / 'eggs').parts[:2], repr('spam' / __import__('pathlib').PurePosixPath('bacon')))" ; chx:output "(('spam', 'bacon'), 'PurePosixPath('spam/bacon')')" .
chx:X_PathJoining rd:hasIOExample chx:IO_PathJoining .
chx:X_PathFlavours a owl:NamedIndividual, chx:PathFlavours ; rdfs:label "PureWindowsPath(r'spam\\eggs')"@en ; skos:definition "Windows writes paths with backslashes and macOS and Linux with forward slashes, so the same text is two names on Windows and one name on the others; the pure path classes build either kind on any machine without using a disk, and forward slashes in source code work everywhere."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_PathFlavours a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('pathlib').PureWindowsPath(r'spam\\eggs').parts[:2], __import__('pathlib').PurePosixPath(r'spam\\eggs').parts[:2]) evaluates to (('spam', 'eggs'), ('spam\\\\eggs',))"@en ; chx:input "(__import__('pathlib').PureWindowsPath(r'spam\\eggs').parts[:2], __import__('pathlib').PurePosixPath(r'spam\\eggs').parts[:2])" ; chx:output "(('spam', 'eggs'), ('spam\\\\eggs',))" .
chx:X_PathFlavours rd:hasIOExample chx:IO_PathFlavours .
chx:X_WorkingDirectory a owl:NamedIndividual, chx:WorkingDirectory ; rdfs:label "Path.cwd()"@en ; skos:definition "Every running program has a current working directory that every path not starting at the root is read from; Path.cwd() and os.getcwd() read it, only os.chdir() changes it, and a folder that does not exist raises FileNotFoundError."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_WorkingDirectory a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('pathlib').Path.cwd().is_absolute(), __import__('os').getcwd() == str(__import__('pathlib').Path.cwd())) evaluates to (True, True)"@en ; chx:input "(__import__('pathlib').Path.cwd().is_absolute(), __import__('os').getcwd() == str(__import__('pathlib').Path.cwd()))" ; chx:output "(True, True)" .
chx:X_WorkingDirectory rd:hasIOExample chx:IO_WorkingDirectory .
chx:X_HomeDirectory a owl:NamedIndividual, chx:HomeDirectory ; rdfs:label "Path.home()"@en ; skos:definition "Path.home() returns the user's home folder as an absolute path object; where it lies depends on the operating system, and a program can normally read and write files there."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_HomeDirectory a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('pathlib').Path.home().is_absolute() evaluates to True"@en ; chx:input "__import__('pathlib').Path.home().is_absolute()" ; chx:output "True" .
chx:X_HomeDirectory rd:hasIOExample chx:IO_HomeDirectory .
chx:X_AbsoluteVersusRelative a owl:NamedIndividual, chx:AbsoluteVersusRelative ; rdfs:label "Path('my/relative/path').absolute()"@en ; skos:definition "An absolute path starts at the root folder and a relative path is read from the current working directory; is_absolute() tells which, absolute() puts the working directory in front without tidying the path, and resolve() also removes .. and follows links."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_AbsoluteVersusRelative a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('pathlib').Path('a/b').is_absolute(), __import__('pathlib').PurePosixPath('/a/b').is_absolute(), __import__('pathlib').PureWindowsPath('/a/b').is_absolute()) evaluates to (False, True, False)"@en ; chx:input "(__import__('pathlib').Path('a/b').is_absolute(), __import__('pathlib').PurePosixPath('/a/b').is_absolute(), __import__('pathlib').PureWindowsPath('/a/b').is_absolute())" ; chx:output "(False, True, False)" .
chx:X_AbsoluteVersusRelative rd:hasIOExample chx:IO_AbsoluteVersusRelative .
chx:X_DotAndDotDot a owl:NamedIndividual, chx:DotAndDotDot ; rdfs:label "Path('..')"@en ; skos:definition "A single dot names this folder and two dots the parent folder; a leading ./ is optional, so Path('./spam.txt') equals Path('spam.txt'), while .. stays in the path text until resolve() removes it."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_DotAndDotDot a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('pathlib').Path('./spam.txt') == __import__('pathlib').Path('spam.txt'), __import__('pathlib').PurePosixPath('a/../b').parts[:3]) evaluates to (True, ('a', '..', 'b'))"@en ; chx:input "(__import__('pathlib').Path('./spam.txt') == __import__('pathlib').Path('spam.txt'), __import__('pathlib').PurePosixPath('a/../b').parts[:3])" ; chx:output "(True, ('a', '..', 'b'))" .
chx:X_DotAndDotDot rd:hasIOExample chx:IO_DotAndDotDot .
chx:X_PathAttributes a owl:NamedIndividual, chx:PathAttributes ; rdfs:label "p.name, p.stem, p.suffix, p.parent"@en ; skos:definition "The name of a path is its last part, made of a stem and a suffix (the extension); parent is the path of the folder that holds it, and anchor and drive give the root and, on Windows, the drive letter; all are strings except parent, which is a path."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_PathAttributes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p: (p.name, p.stem, p.suffix, p.drive, p.anchor, repr(p.parents[1])))(__import__('pathlib').PureWindowsPath('C:/Users/Al/spam.txt')) evaluates to ('spam.txt', 'spam', '.txt', 'C:', 'C:\\\\', 'PureWindowsPath('C:/Users')')"@en ; chx:input "(lambda p: (p.name, p.stem, p.suffix, p.drive, p.anchor, repr(p.parents[1])))(__import__('pathlib').PureWindowsPath('C:/Users/Al/spam.txt'))" ; chx:output "('spam.txt', 'spam', '.txt', 'C:', 'C:\\\\', 'PureWindowsPath('C:/Users')')" .
chx:X_PathAttributes rd:hasIOExample chx:IO_PathAttributes .
chx:X_PathParts a owl:NamedIndividual, chx:PathParts ; rdfs:label "p.parts, p.parents[1]"@en ; skos:definition "parts is the tuple of the names of a path from the root on, and parents is a sequence of the folders above it, nearest first, ending at the root; parent and parents are two different attributes."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_PathParts a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p: (p.parts[1:3], str(p.parents[1]), len(p.parents)))(__import__('pathlib').PurePosixPath('/home/al/spam.txt')) evaluates to (('home', 'al'), '/home', 3)"@en ; chx:input "(lambda p: (p.parts[1:3], str(p.parents[1]), len(p.parents)))(__import__('pathlib').PurePosixPath('/home/al/spam.txt'))" ; chx:output "(('home', 'al'), '/home', 3)" .
chx:X_PathParts rd:hasIOExample chx:IO_PathParts .
chx:X_PathDerivation a owl:NamedIndividual, chx:PathDerivation ; rdfs:label "p.with_suffix('.csv')"@en ; skos:definition "with_suffix(), with_name() and relative_to() build a new path from an existing one without using a disk, and never change the original; relative_to() raises ValueError when the path does not begin with the other one."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_PathDerivation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(str(__import__('pathlib').PurePosixPath('/home/al/spam.txt').with_suffix('.csv').parents[1]), str(__import__('pathlib').PurePosixPath('/home/al/spam.txt').relative_to('/home/al'))) evaluates to ('/home', 'spam.txt')"@en ; chx:input "(str(__import__('pathlib').PurePosixPath('/home/al/spam.txt').with_suffix('.csv').parents[1]), str(__import__('pathlib').PurePosixPath('/home/al/spam.txt').relative_to('/home/al')))" ; chx:output "('/home', 'spam.txt')" .
chx:X_PathDerivation rd:hasIOExample chx:IO_PathDerivation .
chx:X_MakingFolders a owl:NamedIndividual, chx:MakingFolders ; rdfs:label "os.makedirs('C:\\\\delicious\\\\walnut\\\\waffles')"@en ; skos:definition "os.makedirs() creates a folder and every missing folder above it, and Path.mkdir() makes one folder unless parents=True is given; both raise FileExistsError for a folder that exists unless exist_ok=True is given."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_MakingFolders a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda q: (q.mkdir(parents=True), sorted(x.name for x in d.rglob('*')))[1])(d / 'delicious' / 'walnut' / 'waffles')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to ['delicious', 'waffles', 'walnut']"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda q: (q.mkdir(parents=True), sorted(x.name for x in d.rglob('*')))[1])(d / 'delicious' / 'walnut' / 'waffles')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "['delicious', 'waffles', 'walnut']" .
chx:X_MakingFolders rd:hasIOExample chx:IO_MakingFolders .
chx:X_GlobPatterns a owl:NamedIndividual, chx:GlobPatterns ; rdfs:label "p.glob('project?.txt')"@en ; skos:definition "In a glob pattern * matches any run of characters inside one name, ? matches exactly one character and [seq] one character of a set; glob() gives an iterator that can be used once and in no particular order, so sorted() is used to show its paths."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_GlobPatterns a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])(([d.joinpath(n).write_text('x') for n in ('project1.txt', 'project2.txt', 'projectX.txt', 'project10.txt', 'cat.jpg')], [x.name for x in sorted(d.glob('project?.txt'))], [x.name for x in sorted(d.glob('*.txt'))])[1:]))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to (['project1.txt', 'project2.txt', 'projectX.txt'], ['project1.txt', 'project10.txt', 'project2.txt', 'projectX.txt'])"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])(([d.joinpath(n).write_text('x') for n in ('project1.txt', 'project2.txt', 'projectX.txt', 'project10.txt', 'cat.jpg')], [x.name for x in sorted(d.glob('project?.txt'))], [x.name for x in sorted(d.glob('*.txt'))])[1:]))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "(['project1.txt', 'project2.txt', 'projectX.txt'], ['project1.txt', 'project10.txt', 'project2.txt', 'projectX.txt'])" .
chx:X_GlobPatterns rd:hasIOExample chx:IO_GlobPatterns .
chx:X_RecursiveGlob a owl:NamedIndividual, chx:RecursiveGlob ; rdfs:label "p.rglob('*.txt')"@en ; skos:definition "A ** segment matches any number of nested folders, so rglob('*.txt') and glob('**/*.txt') search the whole tree below a folder, while '*/*.txt' looks exactly one folder down."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_RecursiveGlob a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])(((d / 'sub' / 'deeper').mkdir(parents=True), (d / 'top.txt').write_text('x'), (d / 'sub' / 'inner.txt').write_text('x'), (d / 'sub' / 'deeper' / 'deep.txt').write_text('x'), [str(x.relative_to(d)) for x in sorted(d.rglob('*.txt'))], [str(x.relative_to(d)) for x in sorted(d.glob('*/*.txt'))])[4:]))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to (['sub/deeper/deep.txt', 'sub/inner.txt', 'top.txt'], ['sub/inner.txt'])"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])(((d / 'sub' / 'deeper').mkdir(parents=True), (d / 'top.txt').write_text('x'), (d / 'sub' / 'inner.txt').write_text('x'), (d / 'sub' / 'deeper' / 'deep.txt').write_text('x'), [str(x.relative_to(d)) for x in sorted(d.rglob('*.txt'))], [str(x.relative_to(d)) for x in sorted(d.glob('*/*.txt'))])[4:]))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "(['sub/deeper/deep.txt', 'sub/inner.txt', 'top.txt'], ['sub/inner.txt'])" .
chx:X_RecursiveGlob rd:hasIOExample chx:IO_RecursiveGlob .
chx:X_PathValidity a owl:NamedIndividual, chx:PathValidity ; rdfs:label "p.exists(), p.is_file(), p.is_dir()"@en ; skos:definition "exists(), is_file() and is_dir() answer True or False and do not raise for a path that is missing; the functions of os.path with the same names do the same and accept path objects."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_PathValidity a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])(((d / 'f.txt').write_text('x'), [(q.exists(), q.is_file(), q.is_dir()) for q in (d, d / 'f.txt', d / 'nothing')])[1]))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to [(True, False, True), (True, True, False), (False, False, False)]"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])(((d / 'f.txt').write_text('x'), [(q.exists(), q.is_file(), q.is_dir()) for q in (d, d / 'f.txt', d / 'nothing')])[1]))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "[(True, False, True), (True, True, False), (False, False, False)]" .
chx:X_PathValidity rd:hasIOExample chx:IO_PathValidity .
chx:X_FileStat a owl:NamedIndividual, chx:FileStat ; rdfs:label "p.stat().st_size"@en ; skos:definition "stat() returns a stat_result whose st_size is the size in bytes and whose st_mtime is the time of the last change in seconds since 1 January 1970, which the time module turns into a date; timestamps can be set by hand and are not proof."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_FileStat a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write_text('Hello, world!'), f.stat().st_size, __import__('os').utime(f, (1712627129, 1712627129)), f.stat().st_mtime)[1::2])(d / 'calc.txt')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to (13, 1712627129.0)"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write_text('Hello, world!'), f.stat().st_size, __import__('os').utime(f, (1712627129, 1712627129)), f.stat().st_mtime)[1::2])(d / 'calc.txt')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "(13, 1712627129.0)" .
chx:X_FileStat rd:hasIOExample chx:IO_FileStat .
chx:X_WriteAndReadText a owl:NamedIndividual, chx:WriteAndReadText ; rdfs:label "p.write_text('Hello, world!')"@en ; skos:definition "write_text() creates or overwrites a file with a string and returns the number of characters written, which is not the number of bytes; read_text() opens, reads and closes the file and returns its contents as one string."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_WriteAndReadText a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write_text('caf\\u00e9'*2, encoding='utf-8'), f.stat().st_size, ascii(f.read_text(encoding='utf-8'))))(d / 'spam.txt')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to (8, 10, ''caf\\\\xe9caf\\\\xe9'')"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write_text('caf\\u00e9'*2, encoding='utf-8'), f.stat().st_size, ascii(f.read_text(encoding='utf-8'))))(d / 'spam.txt')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "(8, 10, ''caf\\\\xe9caf\\\\xe9'')" .
chx:X_WriteAndReadText rd:hasIOExample chx:IO_WriteAndReadText .
chx:X_PlainVersusBinaryFiles a owl:NamedIndividual, chx:PlainVersusBinaryFiles ; rdfs:label "p.read_bytes()"@en ; skos:definition "A plain text file holds only characters and a binary file anything else; Python reads text as str and binary data as bytes, and read_bytes() and write_bytes() do for bytes what read_text() and write_text() do for text."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_PlainVersusBinaryFiles a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write_bytes(bytes([0, 1, 255])), f.read_bytes()))(d / 'b.bin')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to (3, b'\\x00\\x01\\xff')"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write_bytes(bytes([0, 1, 255])), f.read_bytes()))(d / 'b.bin')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "(3, b'\\x00\\x01\\xff')" .
chx:X_PlainVersusBinaryFiles rd:hasIOExample chx:IO_PlainVersusBinaryFiles .
chx:X_OpenAndModes a owl:NamedIndividual, chx:OpenAndModes ; rdfs:label "open('bacon.txt', 'w', encoding='UTF-8')"@en ; skos:definition "open() returns a file object; mode 'r' reads and is the default, 'w' writes after emptying the file, 'a' appends, 'x' creates a file and fails with FileExistsError if it exists, and 'w', 'a' and 'x' create a missing file; a file opened for reading cannot be written."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_OpenAndModes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda n: (lambda f: (f.write('Hello, world!\\n'), f.close()))(open(n, 'w', encoding='UTF-8')) and (lambda f: (f.write('Bacon is not a vegetable.'), f.close()))(open(n, 'a', encoding='UTF-8')) and open(n, encoding='UTF-8').read())(str(d / 'bacon.txt'))))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to 'Hello, world!\\nBacon is not a vegetable.'"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda n: (lambda f: (f.write('Hello, world!\\n'), f.close()))(open(n, 'w', encoding='UTF-8')) and (lambda f: (f.write('Bacon is not a vegetable.'), f.close()))(open(n, 'a', encoding='UTF-8')) and open(n, encoding='UTF-8').read())(str(d / 'bacon.txt'))))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "'Hello, world!\\nBacon is not a vegetable.'" .
chx:X_OpenAndModes rd:hasIOExample chx:IO_OpenAndModes .
chx:X_ReadMethods a owl:NamedIndividual, chx:ReadMethods ; rdfs:label "f.read(), f.readlines()"@en ; skos:definition "read() returns the rest of the file as one string, readlines() returns the remaining lines as a list in which each line keeps its newline, and readline() returns one line; a file object remembers its position, so a second read() returns an empty string until seek(0)."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_ReadMethods a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (g.read(5), g.seek(0), g.readlines(), g.read(), g.seek(0), g.readline()))(__import__('io').StringIO('When, in disgrace,\\nI all alone')) evaluates to ('When,', 0, ['When, in disgrace,\\n', 'I all alone'], '', 0, 'When, in disgrace,\\n')"@en ; chx:input "(lambda g: (g.read(5), g.seek(0), g.readlines(), g.read(), g.seek(0), g.readline()))(__import__('io').StringIO('When, in disgrace,\\nI all alone'))" ; chx:output "('When,', 0, ['When, in disgrace,\\n', 'I all alone'], '', 0, 'When, in disgrace,\\n')" .
chx:X_ReadMethods rd:hasIOExample chx:IO_ReadMethods .
chx:X_LineIteration a owl:NamedIndividual, chx:LineIteration ; rdfs:label "for line in f:"@en ; skos:definition "A file object is iterated one line at a time without loading the whole file, which is the economical way to go through a large text file; the last line has no newline when the file does not end with one."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_LineIteration a owl:NamedIndividual, rd:IOExample ; rdfs:label "[line.rstrip('\\n') for line in __import__('io').StringIO('one\\ntwo\\nthree')][:2] evaluates to ['one', 'two']"@en ; chx:input "[line.rstrip('\\n') for line in __import__('io').StringIO('one\\ntwo\\nthree')][:2]" ; chx:output "['one', 'two']" .
chx:X_LineIteration rd:hasIOExample chx:IO_LineIteration .
chx:X_WriteMethod a owl:NamedIndividual, chx:WriteMethod ; rdfs:label "f.write('Hello\\n')"@en ; skos:definition "write() puts exactly the string it is given into the file and returns the number of characters; unlike print() it adds no newline, and a value that is not a string raises TypeError, while print(text, file=f) and writelines() are the alternatives."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_WriteMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda f: (f.write('ab'*2), f.write('c'), print('d', file=f), f.getvalue()))(__import__('io').StringIO()) evaluates to (4, 1, None, 'ababcd\\n')"@en ; chx:input "(lambda f: (f.write('ab'*2), f.write('c'), print('d', file=f), f.getvalue()))(__import__('io').StringIO())" ; chx:output "(4, 1, None, 'ababcd\\n')" .
chx:X_WriteMethod rd:hasIOExample chx:IO_WriteMethod .
chx:X_CloseMethod a owl:NamedIndividual, chx:CloseMethod ; rdfs:label "f.close()"@en ; skos:definition "close() writes out what is still buffered and releases the file for other programs; data written with write() may not be on the disk until then, and any later use of the closed file raises ValueError."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_CloseMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write('data'*2), (d / 'c.txt').read_text(), f.close(), (d / 'c.txt').read_text(), f.closed))(open(d / 'c.txt', 'w', encoding='utf-8'))))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to (8, '', None, 'datadata', True)"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write('data'*2), (d / 'c.txt').read_text(), f.close(), (d / 'c.txt').read_text(), f.closed))(open(d / 'c.txt', 'w', encoding='utf-8'))))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "(8, '', None, 'datadata', True)" .
chx:X_CloseMethod rd:hasIOExample chx:IO_CloseMethod .
chx:X_EncodingArgument a owl:NamedIndividual, chx:EncodingArgument ; rdfs:label "open(path, encoding='UTF-8')"@en ; skos:definition "encoding names how the stored bytes become characters; without it Python 3.14.4 uses the encoding of the machine's locale, so text with non-English letters can fail or turn into nonsense on a machine where that is not UTF-8, which is why UTF-8 is written out, and Python 3.15 will make UTF-8 the default."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_EncodingArgument a owl:NamedIndividual, rd:IOExample ; rdfs:label "('caf\\u00e9'.encode('utf-8')[:3], len('caf\\u00e9'), len('caf\\u00e9'.encode('utf-8')), ascii('caf\\u00e9'.encode('utf-8').decode('latin-1'))) evaluates to (b'caf', 4, 5, ''caf\\\\xc3\\\\xa9'')"@en ; chx:input "('caf\\u00e9'.encode('utf-8')[:3], len('caf\\u00e9'), len('caf\\u00e9'.encode('utf-8')), ascii('caf\\u00e9'.encode('utf-8').decode('latin-1')))" ; chx:output "(b'caf', 4, 5, ''caf\\\\xc3\\\\xa9'')" .
chx:X_EncodingArgument rd:hasIOExample chx:IO_EncodingArgument .
chx:X_NewlineTranslation a owl:NamedIndividual, chx:NewlineTranslation ; rdfs:label "write_text('a\\nb', newline='\\r\\n')"@en ; skos:definition "In text mode Python turns a newline into the line ending of the system when writing and any line ending into a newline when reading; the newline argument changes this, and binary mode never translates."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_NewlineTranslation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write_text('a\\nb'*2, newline='\\r\\n', encoding='utf-8'), f.read_bytes(), f.read_text(encoding='utf-8'), f.read_text(encoding='utf-8', newline='')))(d / 'n.txt')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path) evaluates to (6, b'a\\r\\nba\\r\\nb', 'a\\nba\\nb', 'a\\r\\nba\\r\\nb')"@en ; chx:input "(lambda t, P: (lambda d: (lambda r: (t.cleanup(), r)[1])((lambda f: (f.write_text('a\\nb'*2, newline='\\r\\n', encoding='utf-8'), f.read_bytes(), f.read_text(encoding='utf-8'), f.read_text(encoding='utf-8', newline='')))(d / 'n.txt')))(P(t.name)))(__import__('tempfile').TemporaryDirectory(), __import__('pathlib').Path)" ; chx:output "(6, b'a\\r\\nba\\r\\nb', 'a\\nba\\nb', 'a\\r\\nba\\r\\nb')" .
chx:X_NewlineTranslation rd:hasIOExample chx:IO_NewlineTranslation .
chx:X_DecodingErrors a owl:NamedIndividual, chx:DecodingErrors ; rdfs:label "open(path, encoding='ascii', errors='replace')"@en ; skos:definition "Bytes that the encoding cannot decode raise UnicodeDecodeError, and the errors argument chooses another handling, such as 'replace', which puts the character U+FFFD in their place; writing a character the encoding lacks raises UnicodeEncodeError."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_DecodingErrors a owl:NamedIndividual, rd:IOExample ; rdfs:label "ascii(b'caf\\xc3\\xa9'.decode('ascii', errors='replace')) evaluates to ''caf\\\\ufffd\\\\ufffd''"@en ; chx:input "ascii(b'caf\\xc3\\xa9'.decode('ascii', errors='replace'))" ; chx:output "''caf\\\\ufffd\\\\ufffd''" .
chx:X_DecodingErrors rd:hasIOExample chx:IO_DecodingErrors .
chx:X_WithStatement a owl:NamedIndividual, chx:WithStatement ; rdfs:label "with open(path) as f:"@en ; skos:definition "A with statement runs its block and then closes the file however the block is left, by reaching its end, by return or by an exception; it works because a file object is a context manager, with __enter__ and __exit__ methods."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_WithStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda f: (f.__enter__() is f, f.__exit__(None, None, None), f.closed))(__import__('tempfile').TemporaryFile('w+', encoding='utf-8')) evaluates to (True, None, True)"@en ; chx:input "(lambda f: (f.__enter__() is f, f.__exit__(None, None, None), f.closed))(__import__('tempfile').TemporaryFile('w+', encoding='utf-8'))" ; chx:output "(True, None, True)" .
chx:X_WithStatement rd:hasIOExample chx:IO_WithStatement .
chx:X_ClosedFileError a owl:NamedIndividual, chx:ClosedFileError ; rdfs:label "f.read() after f.close()"@en ; skos:definition "Reading or writing a file object that is closed raises ValueError: I/O operation on closed file, and the closed attribute of the object is True once a with block has ended."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_ClosedFileError a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda f, ns: (f.close(), exec('try:\\n    f.read()\\nexcept ValueError as e:\\n    r = type(e).__name__ + chr(58) + chr(32) + str(e)', {'f': f}, ns), ns['r'])[2])(__import__('tempfile').TemporaryFile('w+', encoding='utf-8'), {}) evaluates to 'ValueError: I/O operation on closed file.'"@en ; chx:input "(lambda f, ns: (f.close(), exec('try:\\n    f.read()\\nexcept ValueError as e:\\n    r = type(e).__name__ + chr(58) + chr(32) + str(e)', {'f': f}, ns), ns['r'])[2])(__import__('tempfile').TemporaryFile('w+', encoding='utf-8'), {})" ; chx:output "'ValueError: I/O operation on closed file.'" .
chx:X_ClosedFileError rd:hasIOExample chx:IO_ClosedFileError .
chx:X_ShelveOpen a owl:NamedIndividual, chx:ShelveOpen ; rdfs:label "shelve.open('mydata')"@en ; skos:definition "shelve.open() opens, and creates if needed, a persistent dictionary kept in a file, open for reading and writing at once; it must be closed, or used in a with statement, for everything to be written. In the page, whose Python has no dbm module, the example opens the shelf with shelve.Shelf over an in-memory dictionary, the class that shelve.open() builds on; shelve.open() itself was run under Python 3.14.4 in the Code Lab data."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_ShelveOpen a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda sh, d: (lambda s: (s.__setitem__('cats', list(map(str.title, ('zophie', 'pooka', 'simon')))), s.close()))(sh.Shelf(d)) and (lambda s: (s['cats'], s.close())[0])(sh.Shelf(d)))(__import__('shelve'), {}) evaluates to ['Zophie', 'Pooka', 'Simon']"@en ; chx:input "(lambda sh, d: (lambda s: (s.__setitem__('cats', list(map(str.title, ('zophie', 'pooka', 'simon')))), s.close()))(sh.Shelf(d)) and (lambda s: (s['cats'], s.close())[0])(sh.Shelf(d)))(__import__('shelve'), {})" ; chx:output "['Zophie', 'Pooka', 'Simon']" .
chx:X_ShelveOpen rd:hasIOExample chx:IO_ShelveOpen .
chx:X_ShelfAsDictionary a owl:NamedIndividual, chx:ShelfAsDictionary ; rdfs:label "list(shelf_file.keys())"@en ; skos:definition "A shelf answers the dictionary operations, assignment and lookup by key, in, del, keys(), values() and len(), with string keys; keys() and values() give views that list() turns into lists, and a value read from a shelf is a copy. In the page, whose Python has no dbm module, the example opens the shelf with shelve.Shelf over an in-memory dictionary, the class that shelve.open() builds on; shelve.open() itself was run under Python 3.14.4 in the Code Lab data."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_ShelfAsDictionary a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda sh, d: (lambda s: (s.__setitem__('cats', ['Zophie']), s.__setitem__('dogs', []), s.close()))(sh.Shelf(d)) and (lambda s: (list(s.keys()), list(s.values()), len(s), 'cats' in s, s['cats'] is s['cats'], s.close())[:-1])(sh.Shelf(d)))(__import__('shelve'), {}) evaluates to (['cats', 'dogs'], [['Zophie'], []], 2, True, False)"@en ; chx:input "(lambda sh, d: (lambda s: (s.__setitem__('cats', ['Zophie']), s.__setitem__('dogs', []), s.close()))(sh.Shelf(d)) and (lambda s: (list(s.keys()), list(s.values()), len(s), 'cats' in s, s['cats'] is s['cats'], s.close())[:-1])(sh.Shelf(d)))(__import__('shelve'), {})" ; chx:output "(['cats', 'dogs'], [['Zophie'], []], 2, True, False)" .
chx:X_ShelfAsDictionary rd:hasIOExample chx:IO_ShelfAsDictionary .
chx:X_ShelfWriteback a owl:NamedIndividual, chx:ShelfWriteback ; rdfs:label "shelf_file['cats'].append('Pooka')"@en ; skos:definition "A shelf cannot see a list that is changed in place, so the change is lost unless the value is assigned back to its key or the shelf is opened with writeback=True, which keeps a cache of the values read and writes it on closing, at a cost in memory and time. In the page, whose Python has no dbm module, the example opens the shelf with shelve.Shelf over an in-memory dictionary, the class that shelve.open() builds on; shelve.open() itself was run under Python 3.14.4 in the Code Lab data."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_ShelfWriteback a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda sh, d: (lambda s: (s.__setitem__('cats', ['Zophie']), s.close()))(sh.Shelf(d)) and (lambda s: (s['cats'].append('Pooka'), s.close()))(sh.Shelf(d)) and (lambda s: (s['cats'].append('Pooka'), s.close()))(sh.Shelf(d, writeback=True)) and (lambda s: (s['cats'], s.close())[0])(sh.Shelf(d)))(__import__('shelve'), {}) evaluates to ['Zophie', 'Pooka']"@en ; chx:input "(lambda sh, d: (lambda s: (s.__setitem__('cats', ['Zophie']), s.close()))(sh.Shelf(d)) and (lambda s: (s['cats'].append('Pooka'), s.close()))(sh.Shelf(d)) and (lambda s: (s['cats'].append('Pooka'), s.close()))(sh.Shelf(d, writeback=True)) and (lambda s: (s['cats'], s.close())[0])(sh.Shelf(d)))(__import__('shelve'), {})" ; chx:output "['Zophie', 'Pooka']" .
chx:X_ShelfWriteback rd:hasIOExample chx:IO_ShelfWriteback .
chx:X_ShelfBackend a owl:NamedIndividual, chx:ShelfBackend ; rdfs:label "dbm.whichdb('mydata')"@en ; skos:definition "A shelf is built on the dbm package, which uses the first available backend for a new file: in Python 3.14.4 that is dbm.sqlite3, which makes one file named as in the call, while dbm.dumb makes .dat, .dir and .bak files; the file lists the chapter gives for Windows and macOS were not run. This concept has no example in the page: the Python of the page has no dbm module, so the backends were run only under Python 3.14.4 (Code Lab data)."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:X_ShelfSecurity a owl:NamedIndividual, chx:ShelfSecurity ; rdfs:label "shelve.open(untrusted_file)"@en ; skos:definition "The values in a shelf are pickled, so loading a shelf from an untrusted source can run arbitrary code, and two programs must not write to one shelf at the same time; a shelf is for a program's own data."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:X_JsonSaving a owl:NamedIndividual, chx:JsonSaving ; rdfs:label "json.dump(data, f)"@en ; skos:definition "JSON writes plain data, dictionaries, lists, strings, numbers, true, false and null, as readable UTF-8 text that other programs and languages can read, so it suits data that is shared or inspected; tuples come back as lists and keys as strings."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_JsonSaving a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda j: (j.dumps({'cats': ['Zophie'], 'pair': (1, 2), 5: 'five'}), j.loads(j.dumps({'pair': (1, 2)}))))(__import__('json')) evaluates to ('{'cats': ['Zophie'], 'pair': [1, 2], '5': 'five'}', {'pair': [1, 2]})"@en ; chx:input "(lambda j: (j.dumps({'cats': ['Zophie'], 'pair': (1, 2), 5: 'five'}), j.loads(j.dumps({'pair': (1, 2)}))))(__import__('json'))" ; chx:output "('{'cats': ['Zophie'], 'pair': [1, 2], '5': 'five'}', {'pair': [1, 2]})" .
chx:X_JsonSaving rd:hasIOExample chx:IO_JsonSaving .
chx:X_QuizData a owl:NamedIndividual, chx:QuizData ; rdfs:label "capitals = {'Alabama': 'Montgomery', ...}"@en ; skos:definition "Step 1 of the quiz program keeps the 50 states and their capitals in a dictionary and loops 35 times; in the listing as printed the key 'West Virginia' is broken over two lines, which is a SyntaxError if it is typed that way."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:X_QuizFiles a owl:NamedIndividual, chx:QuizFiles ; rdfs:label "quiz_file = open(f'capitalsquiz{quiz_num + 1}.txt', 'w', encoding='UTF-8')"@en ; skos:definition "Steps 2 to 4 open a quiz file and an answer-key file for each quiz, write a header, shuffle the states with random.shuffle(), pick three wrong capitals with random.sample(), shuffle them together with the right one, write each question with its four lettered options, and write the letter of the right one to the key."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_QuizFiles a owl:NamedIndividual, rd:IOExample ; rdfs:label "'ABCD'[['Hartford', 'Santa Fe', 'Harrisburg', 'Charleston'].index('Harrisburg')] evaluates to 'C'"@en ; chx:input "'ABCD'[['Hartford', 'Santa Fe', 'Harrisburg', 'Charleston'].index('Harrisburg')]" ; chx:output "'C'" .
chx:X_QuizFiles rd:hasIOExample chx:IO_QuizFiles .
chx:X_QuizOutputDiffers a owl:NamedIndividual, chx:QuizOutputDiffers ; rdfs:label "answer_file.write(f'{num + 1}.{'ABCD'[...]}')"@en ; skos:definition "Run as printed, the quiz program writes 'Capital of West Virginia:' and '(Form1)' into the quiz and an answer key of one unbroken line such as 1.D2.C3.C, where the chapter shows 'What is the capital of West Virginia?', '(Form 1)' and one answer per line such as '1. D'."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_QuizOutputDiffers a owl:NamedIndividual, rd:IOExample ; rdfs:label "('%d.%s' % (1, 'ABCD'[3]) + '%d.%s' % (2, 'ABCD'[2]), '%d. %s\\n' % (1, 'ABCD'[3])) evaluates to ('1.D2.C', '1. D\\n')"@en ; chx:input "('%d.%s' % (1, 'ABCD'[3]) + '%d.%s' % (2, 'ABCD'[2]), '%d. %s\\n' % (1, 'ABCD'[3]))" ; chx:output "('1.D2.C', '1. D\\n')" .
chx:X_QuizOutputDiffers rd:hasIOExample chx:IO_QuizOutputDiffers .
chx:X_MadLibs a owl:NamedIndividual, chx:MadLibs ; rdfs:label "re.sub(r'\\b(ADJECTIVE|NOUN|ADVERB|VERB)\\b', ask, text)"@en ; skos:definition "The first practice program reads a text file, finds the words ADJECTIVE, NOUN, ADVERB and VERB, asks the user for a replacement for each and saves and prints the result; re.sub() with a function as the replacement calls the function once for each match."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_MadLibs a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('re').sub(r'\\b(ADJECTIVE|NOUN)\\b', lambda m: {'ADJECTIVE': 'silly', 'NOUN': 'chandelier'}[m.group(1)], 'The ADJECTIVE panda and the NOUN') evaluates to 'The silly panda and the chandelier'"@en ; chx:input "__import__('re').sub(r'\\b(ADJECTIVE|NOUN)\\b', lambda m: {'ADJECTIVE': 'silly', 'NOUN': 'chandelier'}[m.group(1)], 'The ADJECTIVE panda and the NOUN')" ; chx:output "'The silly panda and the chandelier'" .
chx:X_MadLibs rd:hasIOExample chx:IO_MadLibs .
chx:X_RegexSearch a owl:NamedIndividual, chx:RegexSearch ; rdfs:label "for number, line in enumerate(f, start=1): rx.search(line)"@en ; skos:definition "The second practice program opens every .txt file of a folder, which glob('*.txt') lists, and prints each line that matches a regular expression given by the user; enumerate() with start=1 numbers the lines."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_RegexSearch a owl:NamedIndividual, rd:IOExample ; rdfs:label "[n for n, line in enumerate(__import__('io').StringIO('spam and eggs\\nbacon\\nSPAM again\\n'), start=1) if __import__('re').search('(?i)spam', line)] evaluates to [1, 3]"@en ; chx:input "[n for n, line in enumerate(__import__('io').StringIO('spam and eggs\\nbacon\\nSPAM again\\n'), start=1) if __import__('re').search('(?i)spam', line)]" ; chx:output "[1, 3]" .
chx:X_RegexSearch rd:hasIOExample chx:IO_RegexSearch .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "Path('C:/Users') / 'Al'"@en ; skos:definition "The chapter closes with 11 practice questions and 2 practice programs; the questions ask what a relative and an absolute path are, what the path operators and the functions getcwd() and chdir() do, what the file modes are, what write mode does to an existing file and how a shelf is like a dictionary."@en ; dcterms:source <http://example.org/sen0414/ch10/research> .
chx:IO_PracticeQuestions a owl:NamedIndividual, rd:IOExample ; rdfs:label "repr(__import__('pathlib').PureWindowsPath('C:/Users') / 'Al') evaluates to 'PureWindowsPath('C:/Users/Al')'"@en ; chx:input "repr(__import__('pathlib').PureWindowsPath('C:/Users') / 'Al')" ; chx:output "'PureWindowsPath('C:/Users/Al')'" .
chx:X_PracticeQuestions rd:hasIOExample chx:IO_PracticeQuestions .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 10 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch10/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 10 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which operations on a path only compute a new path, which ask the file system a question, and which change files or folders, and what decides that?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs and concepts of the chapter differ in current Python or between operating systems, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 10 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 10 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch10/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-01."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

