pg:CE_01 a ipo:CodeExample ; rdfs:label "Colours and RGBA values"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 8 of the deck and runs 5 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 1 ;
    sen0414:code "from PIL import Image, ImageColor\nnames = ['red', 'lime', 'blue', 'CornflowerBlue', '#CCDDEE']\nfor n in names:\n    print(n, ImageColor.getcolor(n, 'RGBA'))\nprint(Image.new('1', (176, 176)).size, 176 * 176, 'pixels')" ; sen0414:expectedOutput "red (255, 0, 0, 255)\nlime (0, 255, 0, 255)\nblue (0, 0, 255, 255)\nCornflowerBlue (100, 149, 237, 255)\n#CCDDEE (204, 221, 238, 255)\n(176, 176) 30976 pixels\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "Coordinates and box tuples"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 10 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 2 ;
    sen0414:code "from PIL import Image\nim = Image.new('RGB', (28, 27), 'white')\nprint(im.size, im.width, im.height)\nleft, top, right, bottom = 3, 1, 9, 6\nprint(right - left, 'wide,', bottom - top, 'high')\npart = im.crop((left, top, right, bottom))\nprint(part.size, im.size)" ; sen0414:expectedOutput "(28, 27) 28 27\n6 wide, 5 high\n(6, 5) (28, 27)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "Cropping a picture"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 11 of the deck and runs 6 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 11 ; sen0414:orderInTab 3 ;
    sen0414:code "from PIL import Image, ImageDraw\ncat = Image.new('RGB', (200, 140), 'tan')\nImageDraw.Draw(cat).ellipse((60, 30, 140, 110), fill='black')\nface = cat.crop((60, 30, 141, 111))\nprint(cat.size, face.size)\nprint(cat.getpixel((100, 70)), face.getpixel((40, 40)))" ; sen0414:expectedOutput "(200, 140) (81, 81)\n(0, 0, 0) (0, 0, 0)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Pasting and tiling"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 12 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 12 ; sen0414:orderInTab 4 ;
    sen0414:code "from PIL import Image\nface = Image.new('RGB', (40, 40), 'orange')\nsheet = Image.new('RGB', (200, 120), 'white')\ncount = 0\nfor left in range(0, sheet.width, face.width):\n    for top in range(0, sheet.height, face.height):\n        sheet.paste(face, (left, top))\n        count += 1\nprint(count, 'pastes')\nprint(sheet.getpixel((199, 119)), sheet.paste(face, (0, 0)))" ; sen0414:expectedOutput "15 pastes\n(255, 165, 0) None\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "Pasting with a mask and the alpha channel"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 16 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 5 ;
    sen0414:code "from PIL import Image\nbase = Image.new('RGBA', (4, 4), 'red')\ntop = Image.new('RGBA', (2, 2), (0, 0, 255, 128))\nplain, masked = base.copy(), base.copy()\nplain.paste(top, (1, 1))\nmasked.paste(top, (1, 1), top)\nprint(plain.getpixel((1, 1)))\nprint(masked.getpixel((1, 1)))" ; sen0414:expectedOutput "(0, 0, 255, 128)\n(127, 0, 128, 191)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Resize, rotate, flip and set a pixel"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 17 of the deck and runs 9 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 17 ; sen0414:orderInTab 6 ;
    sen0414:code "from PIL import Image\nim = Image.new('RGB', (120, 80), 'white')\nbig = im.rotate(90, expand=True)\nprint(im.resize((60, 40)).size, im.rotate(90).size, big.size)\nprint(im.rotate(6).size, im.rotate(6, expand=True).size)\nprint(im.transpose(Image.Transpose.FLIP_LEFT_RIGHT).size)\nim.putpixel((0, 0), (255, 0, 0))\nprint(im.getpixel((0, 0)), im.getpixel((1, 0)))\nprint(im.rotate(6).getpixel((0, 0)))" ; sen0414:expectedOutput "(60, 40) (120, 80) (80, 120)\n(120, 80) (128, 94)\n(120, 80)\n(255, 0, 0) (255, 255, 255)\n(0, 0, 0)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "Saving: PNG, JPEG and pixel density"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 20 of the deck and runs 12 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 20 ; sen0414:orderInTab 7 ;
    sen0414:code "import io\nfrom PIL import Image, ImageDraw\nim = Image.new('RGB', (200, 200), 'white')\nImageDraw.Draw(im).ellipse((20, 20, 180, 180), fill='green')\nfor kind in ('PNG', 'JPEG'):\n    buf = io.BytesIO()\n    im.save(buf, kind)\n    print(kind, len(buf.getvalue()))\ntry:\n    im.convert('RGBA').save(io.BytesIO(), 'JPEG')\nexcept OSError as e:\n    print(e)" ; sen0414:expectedOutput "PNG 1219\nJPEG 3648\ncannot write mode RGBA as JPEG\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Project 16: add a logo"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 25 of the deck and runs 14 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 8 ;
    sen0414:code "import os\nfrom PIL import Image\nlogo = Image.new('RGBA', (40, 30), (255, 0, 0, 200))\ndef stamp(name):\n    im = Image.open(name)\n    if im.width < 4 * logo.width:\n        return None\n    r = min(1, 300 / max(im.size))\n    im = im.resize((round(im.width * r), round(im.height * r)))\n    x, y = im.width - logo.width, im.height - logo.height\n    im.paste(logo, (x, y), logo)\n    return im.size\nfor name in sorted(os.listdir('.')):\n    print(name, stamp(name))" ; sen0414:expectedOutput "300.png (300, 150)\n500.png (300, 150)\n80.png None\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Drawing shapes on a picture"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 26 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 9 ;
    sen0414:code "from PIL import Image, ImageDraw\nim = Image.new('RGBA', (200, 200), 'white')\ndraw = ImageDraw.Draw(im)\ndraw.point([(5, 5), (6, 6)], fill='red')\ndraw.line([(0, 0), (199, 199)], fill='black', width=3)\ndraw.rectangle((20, 30, 60, 60), fill='blue')\ndraw.ellipse((100, 50, 180, 130), outline='green')\ndraw.polygon([(30, 150), (90, 190), (20, 190)], fill='purple')\ncolours = {c: n for n, c in im.getcolors()}\nprint(colours[(0, 0, 255, 255)], 'blue pixels')" ; sen0414:expectedOutput "1271 blue pixels\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "Drawing text"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 27 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 27 ; sen0414:orderInTab 10 ;
    sen0414:code "from PIL import Image, ImageDraw, ImageFont\nfont = ImageFont.load_default(size=24)\nim = Image.new('RGB', (200, 60), 'white')\ndraw = ImageDraw.Draw(im)\nbox = draw.textbbox((10, 10), 'Howdy!', font=font)\nprint(box)\nprint(box[2] - box[0], 'wide,', box[3] - box[1], 'high')\ndraw.text((10, 10), 'Howdy!', fill='black', font=font)\nprint(len(im.getcolors()) > 1)" ; sen0414:expectedOutput "(10, 17, 93, 39)\n83 wide, 22 high\nTrue\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "Copying and pasting images to the clipboard"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 31 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 31 ; sen0414:orderInTab 11 ;
    sen0414:code "from PIL import Image\nclass Clipboard:\n    held = None\n    def copy(self, im):\n        self.held = im.copy()\n    def paste(self):\n        return self.held\nclip = Clipboard()\nclip.copy(Image.new('RGB', (30, 20), 'orange'))\ngot = clip.paste()\nprint(got.size, got.getpixel((0, 0)))" ; sen0414:expectedOutput "(30, 20) (255, 165, 0)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "Line graphs and scatter plots"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 32 of the deck and runs 12 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 12 ;
    sen0414:code "import io\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nlines = plt.plot([1, 2, 3, 4], [1, 4, 9, 16], label='squares')\ndots = plt.scatter([1, 2, 3, 4], [2, 3, 5, 8])\nplt.title('Growth'); plt.xlabel('step')\nplt.ylabel('size'); plt.legend()\nbuf = io.BytesIO()\nplt.savefig(buf, dpi=100, format='png')\ntitle, size = plt.gca().get_title(), len(buf.getvalue())\nprint(len(lines), type(dots).__name__, title, size > 1000)" ; sen0414:expectedOutput "1 PathCollection Growth True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Bar graphs and pie charts"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 33 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 33 ; sen0414:orderInTab 13 ;
    sen0414:code "import matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nnames, votes = ['A', 'B', 'C'], [5, 3, 2]\nbars = plt.bar(names, votes)\nprint([round(b.get_height()) for b in bars])\nplt.figure()\nwedges, labels = plt.pie(votes, labels=names)\nprint(len(wedges), round(wedges[0].theta2 - wedges[0].theta1))" ; sen0414:expectedOutput "[5, 3, 2]\n3 180\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "Tile Maker"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 36 of the deck and runs 12 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 36 ; sen0414:orderInTab 14 ;
    sen0414:code "from PIL import Image, ImageDraw\ndef make_tile(face, across, down):\n    w, h = face.size\n    sheet = Image.new('RGB', (w * across, h * down))\n    for x in range(across):\n        for y in range(down):\n            sheet.paste(face, (x * w, y * h))\n    return sheet\nface = Image.new('RGB', (50, 40), 'tan')\nImageDraw.Draw(face).ellipse((10, 5, 40, 35), fill='black')\nsheet = make_tile(face, 4, 3)\nprint(sheet.size, sheet.getpixel((25, 20)), sheet.getpixel((75, 60)))" ; sen0414:expectedOutput "(200, 120) (0, 0, 0) (0, 0, 0)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "Creating custom seating cards"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 37 of the deck and runs 14 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch21/page/chapter_code_ch21_v1_0_0.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 15 ;
    sen0414:code "from PIL import Image, ImageDraw, ImageFont\nguests = ['Ada Lovelace', 'Alan Turing', 'Grace Hopper']\nfont = ImageFont.load_default(size=28)\ncards = []\nfor name in guests:\n    card = Image.new('RGB', (288, 360), 'white')\n    draw = ImageDraw.Draw(card)\n    box = draw.textbbox((0, 0), name, font=font)\n    x = (288 - (box[2] - box[0])) // 2\n    draw.text((x, 160), name, fill='black', font=font)\n    cards.append(card)\ncard, white = cards[0], (255, 255, 255)\nprint(len(cards), card.size)\nprint(card.getpixel((0, 0)), card.getpixel((144, 175)) != white)" ; sen0414:expectedOutput "3 (288, 360)\n(255, 255, 255) True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
