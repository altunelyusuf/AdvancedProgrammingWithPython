chx:X_ProportionMath rd:hasIOExample chx:IO_ProportionMath .
chx:X_CornerPosition a owl:NamedIndividual, chx:CornerPosition ; rdfs:label "(width - logo_width, height - logo_height)"@en ; skos:definition "The logo's top-left corner goes to the image width minus the logo width and the image height minus the logo height, so a 100 by 95 logo on the 225 by 300 picture is pasted at (125, 205) and on a 300 by 100 picture at (200, 5), which puts its bottom-right corner on the image's corner."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_CornerPosition a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nshp(); lw, lh = Image.open(\\'catlogo.png\\').size\\nout = ((lw, lh), (225 - lw, 300 - lh), (300 - lw, 100 - lh))', g), g['out'])[1])({}) evaluates to ((100, 95), (125, 205), (200, 5))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nshp(); lw, lh = Image.open(\\'catlogo.png\\').size\\nout = ((lw, lh), (225 - lw, 300 - lh), (300 - lw, 100 - lh))', g), g['out'])[1])({})" ; chx:output "((100, 95), (125, 205), (200, 5))" .
chx:X_CornerPosition rd:hasIOExample chx:IO_CornerPosition .
chx:X_MaskedPaste a owl:NamedIndividual, chx:MaskedPaste ; rdfs:label "im.paste(logo_im, (width - logo_width, height - logo_height), logo_im)"@en ; skos:definition "The logo is passed as its own third argument so that its transparent pixels are not pasted: the pixel at the logo's corner then equals the picture's own pixel, while the call without the mask puts (255, 255, 255) there, and a pixel in the middle of the cat is (0, 0, 0)."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_MaskedPaste a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nshp(); logo = Image.open(\\'catlogo.png\\'); base = Image.open(\\'zophie.png\\').resize((225, 300)); pos = (225 - logo.width, 300 - logo.height)\\na = base.copy(); a.paste(logo, pos, logo); b = base.copy(); b.paste(logo, pos)\\nout = (a.getpixel(pos) == base.getpixel(pos), b.getpixel(pos), a.getpixel((pos[0] + 50, pos[1] + 47)), a.mode)', g), g['out'])[1])({}) evaluates to (True, (255, 255, 255), (0, 0, 0), 'RGB')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nshp(); logo = Image.open(\\'catlogo.png\\'); base = Image.open(\\'zophie.png\\').resize((225, 300)); pos = (225 - logo.width, 300 - logo.height)\\na = base.copy(); a.paste(logo, pos, logo); b = base.copy(); b.paste(logo, pos)\\nout = (a.getpixel(pos) == base.getpixel(pos), b.getpixel(pos), a.getpixel((pos[0] + 50, pos[1] + 47)), a.mode)', g), g['out'])[1])({})" ; chx:output "(True, (255, 255, 255), (0, 0, 0), 'RGB')" .
