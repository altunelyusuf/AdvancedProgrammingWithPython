chx:X_LogoFileLoop a owl:NamedIndividual, chx:LogoFileLoop ; rdfs:label "filename.endswith('.png') or filename.endswith('.jpg')"@en ; skos:definition "The program loops over os.listdir('.') and skips every name that does not end in the lower case .png or .jpg and the logo itself, so a.png and b.jpg are processed while C.PNG, e.JPG, d.jpeg and n.txt are skipped; the order of os.listdir() is arbitrary."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_LogoFileLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nnames = [\\'a.png\\', \\'b.jpg\\', \\'C.PNG\\', \\'d.jpeg\\', \\'catlogo.png\\', \\'n.txt\\', \\'e.JPG\\']\\nskip = lambda f: not (f.endswith(\\'.png\\') or f.endswith(\\'.jpg\\')) or f == \\'catlogo.png\\'\\nout = ([f for f in names if not skip(f)], [f for f in names if skip(f)])', g), g['out'])[1])({}) evaluates to (['a.png', 'b.jpg'], ['C.PNG', 'd.jpeg', 'catlogo.png', 'n.txt', 'e.JPG'])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nnames = [\\'a.png\\', \\'b.jpg\\', \\'C.PNG\\', \\'d.jpeg\\', \\'catlogo.png\\', \\'n.txt\\', \\'e.JPG\\']\\nskip = lambda f: not (f.endswith(\\'.png\\') or f.endswith(\\'.jpg\\')) or f == \\'catlogo.png\\'\\nout = ([f for f in names if not skip(f)], [f for f in names if skip(f)])', g), g['out'])[1])({})" ; chx:output "(['a.png', 'b.jpg'], ['C.PNG', 'd.jpeg', 'catlogo.png', 'n.txt', 'e.JPG'])" .
chx:X_LogoFileLoop rd:hasIOExample chx:IO_LogoFileLoop .
chx:X_BothSidesTest a owl:NamedIndividual, chx:BothSidesTest ; rdfs:label "if width > SQUARE_FIT_SIZE and height > SQUARE_FIT_SIZE:"@en ; skos:definition "The program resizes an image only when both its width and its height exceed 300: a 1200 by 400 panorama becomes 300 by 100 and a 500 by 700 picture becomes 214 by 300, but a 1200 by 250 strip and a 250 by 900 column keep their size, so the 300 pixel limit is not kept for them."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_BothSidesTest a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nd = shp(); sizes = {\\'panorama.png\\': (1200, 400), \\'strip.png\\': (1200, 250), \\'tall.jpg\\': (500, 700), \\'narrow.png\\': (250, 900)}\\nfor n, s in sizes.items(): Image.new(\\'RGB\\', s, \\'gray\\').save(n)\\nr = subprocess.run([sys.executable, \\'resizeAndAddLogo.py\\'], capture_output=True, text=True, stdin=subprocess.DEVNULL)\\nout = (r.returncode, {n: Image.open(\\'withLogo/\\' + n).size for n in sorted(sizes)})', g), g['out'])[1])({}) evaluates to (0, {'narrow.png': (250, 900), 'panorama.png': (300, 100), 'strip.png': (1200, 250), 'tall.jpg': (214, 300)})"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nd = shp(); sizes = {\\'panorama.png\\': (1200, 400), \\'strip.png\\': (1200, 250), \\'tall.jpg\\': (500, 700), \\'narrow.png\\': (250, 900)}\\nfor n, s in sizes.items(): Image.new(\\'RGB\\', s, \\'gray\\').save(n)\\nr = subprocess.run([sys.executable, \\'resizeAndAddLogo.py\\'], capture_output=True, text=True, stdin=subprocess.DEVNULL)\\nout = (r.returncode, {n: Image.open(\\'withLogo/\\' + n).size for n in sorted(sizes)})', g), g['out'])[1])({})" ; chx:output "(0, {'narrow.png': (250, 900), 'panorama.png': (300, 100), 'strip.png': (1200, 250), 'tall.jpg': (214, 300)})" .
