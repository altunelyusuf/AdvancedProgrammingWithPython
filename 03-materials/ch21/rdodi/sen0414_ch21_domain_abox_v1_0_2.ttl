chx:X_TransposeFlip a owl:NamedIndividual, chx:TransposeFlip ; rdfs:label "g.transpose(Image.FLIP_LEFT_RIGHT)"@en ; skos:definition "transpose() returns a mirrored or quarter-turned image: Image.FLIP_LEFT_RIGHT makes the pixel at x 0 the pixel that was at x 59, FLIP_TOP_BOTTOM works on rows, and ROTATE_90 gives 40 by 60 from 60 by 40; in Pillow 12.3.0 Image.FLIP_LEFT_RIGHT is the integer 0 equal to Image.Transpose.FLIP_LEFT_RIGHT, which the chapter's older constant still reaches."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_TransposeFlip a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\ng = grad()\\nout = (g.transpose(Image.FLIP_LEFT_RIGHT).getpixel((0, 0)) == g.getpixel((59, 0)), Image.FLIP_LEFT_RIGHT == Image.Transpose.FLIP_LEFT_RIGHT, type(Image.FLIP_LEFT_RIGHT).__name__, type(Image.Transpose.FLIP_LEFT_RIGHT).__name__, int(Image.Transpose.FLIP_LEFT_RIGHT), int(Image.Transpose.FLIP_TOP_BOTTOM), g.transpose(Image.Transpose.ROTATE_90).size, g.transpose(Image.Transpose.FLIP_TOP_BOTTOM).getpixel((0, 0)) == g.getpixel((0, 39)))', g), g['out'])[1])({}) evaluates to (True, True, 'int', 'Transpose', 0, 1, (40, 60), True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\ng = grad()\\nout = (g.transpose(Image.FLIP_LEFT_RIGHT).getpixel((0, 0)) == g.getpixel((59, 0)), Image.FLIP_LEFT_RIGHT == Image.Transpose.FLIP_LEFT_RIGHT, type(Image.FLIP_LEFT_RIGHT).__name__, type(Image.Transpose.FLIP_LEFT_RIGHT).__name__, int(Image.Transpose.FLIP_LEFT_RIGHT), int(Image.Transpose.FLIP_TOP_BOTTOM), g.transpose(Image.Transpose.ROTATE_90).size, g.transpose(Image.Transpose.FLIP_TOP_BOTTOM).getpixel((0, 0)) == g.getpixel((0, 39)))', g), g['out'])[1])({})" ; chx:output "(True, True, 'int', 'Transpose', 0, 1, (40, 60), True)" .
