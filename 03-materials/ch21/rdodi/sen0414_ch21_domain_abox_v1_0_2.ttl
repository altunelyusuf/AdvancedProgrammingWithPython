sIO(); plt.savefig(b, format=\\'png\\'); im = Image.open(io.BytesIO(b.getvalue())); c = io.BytesIO(); plt.savefig(c, format=\\'png\\', dpi=200)\\nout = (im.size, im.mode, round(im.info[\\'dpi\\'][0], 1), Image.open(io.BytesIO(c.getvalue())).size, plt.close(\\'all\\'))', g), g['out'])[1])({})" ; chx:output "((640, 480), 'RGBA', 100.0, (1280, 960), None)" .
chx:X_SaveFigure rd:hasIOExample chx:IO_SaveFigure .
chx:X_ShowLifecycle a owl:NamedIndividual, chx:ShowLifecycle ; rdfs:label "plt.show()"@en ; skos:definition "With the Agg backend plt.show() returns None at once and keeps the figure, so a savefig() after it still holds the line; with a Tk window plt.show() blocks until the window is closed and then the figure list is empty, a second plt.show() returns at once, and a savefig() after it writes a blank image."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_ShowLifecycle a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nplt.close(\\'all\\'); plt.plot([1, 2, 3]); a = io.BytesIO(); plt.savefig(a, format=\\'png\\'); r = plt.show(); b = io.BytesIO(); plt.savefig(b, format=\\'png\\')\\nca = len(set(Image.open(io.BytesIO(a.getvalue())).convert(\\'RGB\\').getdata())); cb = len(set(Image.open(io.BytesIO(b.getvalue())).convert(\\'RGB\\').getdata()))\\nout = (r, plt.get_fignums(), ca == cb, matplotlib.get_backend(), plt.close(\\'all\\'))', g), g['out'])[1])({}) evaluates to (None, [1], True, 'Agg', None)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nplt.close(\\'all\\'); plt.plot([1, 2, 3]); a = io.BytesIO(); plt.savefig(a, format=\\'png\\'); r = plt.show(); b = io.BytesIO(); plt.savefig(b, format=\\'png\\')\\nca = len(set(Image.open(io.BytesIO(a.getvalue())).convert(\\'RGB\\').getdata())); cb = len(set(Image.open(io.BytesIO(b.getvalue())).convert(\\'RGB\\').getdata()))\\nout = (r, plt.get_fignums(), ca == cb, matplotlib.get_backend(), plt.close(\\'all\\'))', g), g['out'])[1])({})" ; chx:output "(None, [1], True, 'Agg', None)" .
chx:X_ShowLifecycle rd:hasIOExample chx:IO_ShowLifecycle .
chx:X_AppendixPins a owl:NamedIndividual, chx:AppendixPins ; rdfs:label "matplotlib==3.92"@en ; skos:definition "Appendix A pins pillow==10.4.0 and matplotlib==3.92, and no Matplotlib release 3.92 exists: pip reads 3.92 as 3.92.0, which is greater than 3.11.2, so the pin asks for a version that is not there, and the release the author meant is 3.9.2."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_AppendixPins a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nfrom packaging.version import Version\\nout = (Version(\\'3.92\\') == Version(\\'3.92.0\\'), Version(\\'3.92\\') > Version(\\'3.11.2\\'), Version(\\'3.9.2\\') < Version(\\'3.11.2\\'), str(Version(\\'3.9.2\\')))', g), g['out'])[1])({}) evaluates to (True, True, True, '3.9.2')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nfrom packaging.version import Version\\nout = (Version(\\'3.92\\') == Version(\\'3.92.0\\'), Version(\\'3.92\\') > Version(\\'3.11.2\\'), Version(\\'3.9.2\\') < Version(\\'3.11.2\\'), str(Version(\\'3.9.2\\')))', g), g['out'])[1])({})" ; chx:output "(True, True, True, '3.9.2')" .
chx:X_AppendixPins rd:hasIOExample chx:IO_AppendixPins .
chx:X_PythonWheelSupport a owl:NamedIndividual, chx:PythonWheelSupport ; rdfs:label "uv pip install pillow==10.4.0"@en ; skos:definition "A wheel is a prebuilt package for one Python version: the first Pillow release with a CPython 3.14 wheel is 11.3.0 and the first Matplotlib release is 3.10.5, so the book's pins Pillow 10.4.0 and Matplotlib 3.9.2 have wheels for Python 3.13 and not for 3.14, and pip must build them from source."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:X_PinnedBuildOnSource a owl:NamedIndividual, chx:PinnedBuildOnSource ; rdfs:label "Matplotlib 3.9.2 built on Python 3.14.6"@en ; skos:definition "Matplotlib 3.9.2 built from source on Python 3.14.6 with the system FreeType and Qhull installs, but its savefig() and legend() raise RecursionError while copying a MarkerStyle, so the pinned release cannot draw a figure under 3.14.6 and the book's pins work only up to Python 3.13."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:X_TkVersionNine a owl:NamedIndividual, chx:TkVersionNine ; rdfs:label "tkinter.TkVersion"@en ; skos:definition "Python 3.14.6 from uv has tkinter built against Tk 9.0, and the Matplotlib 3.9.2 TkAgg backend fails with ImportError (Failed to load Tcl_SetVar) against Tk 9.0 in both uv Pythons, 3.14.6 and 3.13.14, so the window of plt.show() opens with Matplotlib 3.11.2 and not with the pinned 3.9.2."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_TkVersionNine a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nimport tkinter\\nout = (tkinter.TkVersion, tkinter.TclVersion, sys.version_info[:2] >= (3, 14))', g), g['out'])[1])({}) evaluates to (9.0, 9.0, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nimport tkinter\\nout = (tkinter.TkVersion, tkinter.TclVersion, sys.version_info[:2] >= (3, 14))', g), g['out'])[1])({})" ; chx:output "(9.0, 9.0, True)" .
