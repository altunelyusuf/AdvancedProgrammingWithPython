ord=True) as w:\\n    warnings.simplefilter(\\'always\\'); v = list(Image.new(\\'RGB\\', (2, 1), \\'red\\').getdata())\\nout = (v, [str(x.message)[:62] for x in w], hasattr(Image.Image, \\'get_flattened_data\\'), md.version(\\'pillow\\'))', g), g['out'])[1])({})" ; chx:output "([(255, 0, 0), (255, 0, 0)], ['Image.Image.getdata is deprecated and will be removed in Pillo'], True, '12.3.0')" .
