180, expand=True).size, im.rotate(6, expand=True).size, im.rotate(6).size)', g), g['out'])[1])({})" ; chx:output "((816, 1088), (816, 1088), (1088, 816), (816, 1088), (926, 1168), (816, 1088))" .
