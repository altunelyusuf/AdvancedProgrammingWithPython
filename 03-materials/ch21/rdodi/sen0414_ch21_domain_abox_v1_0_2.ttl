chx:X_PolygonDrawing a owl:NamedIndividual, chx:PolygonDrawing ; rdfs:label "draw.polygon([(0, 0), (10, 0), (0, 10)], fill='red')"@en ; skos:definition "polygon() joins the points in order and closes the shape from the last point to the first by itself: the triangle (0, 0), (10, 0), (0, 10) fills 66 pixels of an 11 by 11 image, including the closing edge at (0, 5) and the corner (5, 5), and leaves (10, 10) black."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_PolygonDrawing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nim = Image.new(\\'RGB\\', (11, 11)); ImageDraw.Draw(im).polygon([(0, 0), (10, 0), (0, 10)], fill=\\'red\\')\\nout = (sum(1 for p in im.getdata() if p == (255, 0, 0)), im.getpixel((0, 5)), im.getpixel((5, 5)), im.getpixel((10, 10)))', g), g['out'])[1])({}) evaluates to (66, (255, 0, 0), (255, 0, 0), (0, 0, 0))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nim = Image.new(\\'RGB\\', (11, 11)); ImageDraw.Draw(im).polygon([(0, 0), (10, 0), (0, 10)], fill=\\'red\\')\\nout = (sum(1 for p in im.getdata() if p == (255, 0, 0)), im.getpixel((0, 5)), im.getpixel((5, 5)), im.getpixel((10, 10)))', g), g['out'])[1])({})" ; chx:output "(66, (255, 0, 0), (255, 0, 0), (0, 0, 0))" .
chx:X_PolygonDrawing rd:hasIOExample chx:IO_PolygonDrawing .
chx:X_DrawingExample a owl:NamedIndividual, chx:DrawingExample ; rdfs:label "draw.line([(i, 0), (200, i - 100)], fill='green')"@en ; skos:definition "The chapter's 200 by 200 drawing example makes a black border, a blue rectangle, a red ellipse, a brown polygon and ten green lines; the green lines start at y 0 and overwrite the border there, so the pixel (100, 0) is (0, 128, 0, 255), 654 pixels are green, and 1271 are blue."@en ; dcterms:source <http://example.org/sen0414/ch21/research> .
chx:IO_DrawingExample a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nim = Image.new(\\'RGBA\\', (200, 200), \\'white\\'); draw = ImageDraw.Draw(im)\\ndraw.line([(0, 0), (199, 0), (199, 199), (0, 199), (0, 0)], fill=\\'black\\'); draw.rectangle((20, 30, 60, 60), fill=\\'blue\\'); draw.ellipse((120, 30, 160, 60), fill=\\'red\\')\\ndraw.polygon(((57, 87), (79, 62), (94, 85), (120, 90), (103, 113)), fill=\\'brown\\')\\nfor i in range(100, 200, 10): draw.line([(i, 0), (200, i - 100)], fill=\\'green\\')\\nP = list(im.getdata())\\nout = (im.getpixel((100, 0)), im.getpixel((50, 45)), im.getpixel((0, 0)), im.getpixel((0, 199)), sum(1 for p in P if p == (0, 128, 0, 255)), sum(1 for p in P if p == (0, 0, 255, 255)))', g), g['out'])[1])({}) evaluates to ((0, 128, 0, 255), (0, 0, 255, 255), (0, 0, 0, 255), (0, 0, 0, 255), 654, 1271)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, json, time, shutil, zipfile, hashlib, tempfile, warnings, subprocess, struct, importlib.metadata as md\\nimport matplotlib\\nmatplotlib.use(\\'Agg\\')\\nimport matplotlib.pyplot as plt\\nfrom PIL import Image, ImageColor, ImageDraw, ImageFont, ImageChops, ImageShow\\nwarnings.simplefilter(\\'ignore\\')\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef grad():\\n    im = Image.new(\\'RGB\\', (60, 40))\\n    for x in range(60):\\n        for y in range(40): im.putpixel((x, y), (x * 4 % 256, y * 6 % 256, (x + y) * 3 % 256))\\n    return im\\ndef sha(im): return hashlib.sha256(im.tobytes()).hexdigest()[:12]\\nZIPSHA = \\'dac627e807f69ee14913ba621a15dec1f98db739d76939555ba5360d05eba916\\'\\ndef zipbytes():\\n    p = os.path.join(tempfile.gettempdir(), \\'ch21_materials_%s.zip\\' % ZIPSHA[:8])\\n    if not os.path.exists(p):\\n        import urllib.request\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        open(p + \\'.part\\', \\'wb\\').write(urllib.request.urlopen(rq, timeout=180).read()); os.replace(p + \\'.part\\', p)\\n    b = open(p, \\'rb\\').read(); assert hashlib.sha256(b).hexdigest() == ZIPSHA, \\'the online materials differ from the recorded zip\\'\\n    return b\\nFILESHA = {\\'zophie.png\\': \\'5c5bf02fd0c95cee5d490a6daf3f1c4ccbbcab9fdc59bd8bba9564cad1462ba1\\', \\'catlogo.png\\': \\'107740e7ca46ce7642b6940ff1232689bc3d34eb14c026813a61cfae45385db0\\',\\n           \\'guests.txt\\': \\'e6136e39f829ae7380be4969b780c72bd8022a1a97efc399f0f2002ce1fd5164\\', \\'resizeAndAddLogo.py\\': \\'4291c7cedd9dcf37b792ee7c20485902ad746b2743f66873ccc953bf4681634a\\'}\\ndef shp():\\n    d = wd(); z = zipfile.ZipFile(io.BytesIO(zipbytes())); names = [n for n in z.namelist() if \\'__MACOSX\\' not in n]\\n    for f, h in FILESHA.items():\\n        data = z.read([n for n in names if n.endswith(\\'/\\' + f)][0]); assert hashlib.sha256(data).hexdigest() == h, f; open(f, \\'wb\\').write(data)\\n    return d\\ndef child(code, drop=(), extra=None):\\n    e = dict(os.environ); e.update(extra or {})\\n    for k in drop: e.pop(k, None)\\n    fo = tempfile.TemporaryFile(\\'w+\\'); fe = tempfile.TemporaryFile(\\'w+\\')\\n    r = subprocess.run([sys.executable, \\'-W\\', \\'ignore\\', \\'-c\\', code], stdin=subprocess.DEVNULL, stdout=fo, stderr=fe, text=True, env=e, timeout=120); fo.seek(0); fe.seek(0)\\n    return fo.read().strip()\\nim = Image.new(\\'RGBA\\', (200, 200), \\'white\\'); draw = ImageDraw.Draw(im)\\ndraw.line([(0, 0), (199, 0), (199, 199), (0, 199), (0, 0)], fill=\\'black\\'); draw.rectangle((20, 30, 60, 60), fill=\\'blue\\'); draw.ellipse((120, 30, 160, 60), fill=\\'red\\')\\ndraw.polygon(((57, 87), (79, 62), (94, 85), (120, 90), (103, 113)), fill=\\'brown\\')\\nfor i in range(100, 200, 10): draw.line([(i, 0), (200, i - 100)], fill=\\'green\\')\\nP = list(im.getdata())\\nout = (im.getpixel((100, 0)), im.getpixel((50, 45)), im.getpixel((0, 0)), im.getpixel((0, 199)), sum(1 for p in P if p == (0, 128, 0, 255)), sum(1 for p in P if p == (0, 0, 255, 255)))', g), g['out'])[1])({})" ; chx:output "((0, 128, 0, 255), (0, 0, 255, 255), (0, 0, 0, 255), (0, 0, 0, 255), 654, 1271)" .
