chx:X_TableIsTupleList a owl:NamedIndividual, chx:TableIsTupleList ; rdfs:label "[('Zophie', '2021-01-24', 'black', 5.6), ('Colin', '2016-12-24', 'siamese', 6.2), ...]"@en ; skos:definition "The chapter's picture of a table as a list of tuples holds: fetchall() on a four-row table returned a list whose items are tuples, the first being ('Zophie', '2021-01-24', 'black', 5.6)."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_TableIsTupleList a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nrows = c.execute(\\'SELECT * FROM cats\\').fetchall()\\nout = (type(rows).__name__, type(rows[0]).__name__, rows[0], len(rows))', g), g['out'])[1])({}) evaluates to ('list', 'tuple', ('Zophie', '2021-01-24', 'black', 5.6), 4)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nrows = c.execute(\\'SELECT * FROM cats\\').fetchall()\\nout = (type(rows).__name__, type(rows[0]).__name__, rows[0], len(rows))', g), g['out'])[1])({})" ; chx:output "('list', 'tuple', ('Zophie', '2021-01-24', 'black', 5.6), 4)" .
chx:X_TableIsTupleList rd:hasIOExample chx:IO_TableIsTupleList .
chx:X_RowidHidden a owl:NamedIndividual, chx:RowidHidden ; rdfs:label "SELECT rowid, * FROM cats"@en ; skos:definition "SELECT star leaves the rowid out, SELECT rowid, star puts it first, and rowid, oid and _rowid_ are three names for the same value, here (1, 1, 1) for the first row."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_RowidHidden a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nout = ([d[0] for d in c.execute(\\'SELECT * FROM cats\\').description], [d[0] for d in c.execute(\\'SELECT rowid, * FROM cats\\').description], c.execute(\\'SELECT rowid, oid, _rowid_ FROM cats LIMIT 1\\').fetchone())', g), g['out'])[1])({}) evaluates to (['name', 'birthdate', 'fur', 'weight_kg'], ['rowid', 'name', 'birthdate', 'fur', 'weight_kg'], (1, 1, 1))"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nout = ([d[0] for d in c.execute(\\'SELECT * FROM cats\\').description], [d[0] for d in c.execute(\\'SELECT rowid, * FROM cats\\').description], c.execute(\\'SELECT rowid, oid, _rowid_ FROM cats LIMIT 1\\').fetchone())', g), g['out'])[1])({})" ; chx:output "(['name', 'birthdate', 'fur', 'weight_kg'], ['rowid', 'name', 'birthdate', 'fur', 'weight_kg'], (1, 1, 1))" .
chx:X_RowidHidden rd:hasIOExample chx:IO_RowidHidden .
chx:X_RowidReuse a owl:NamedIndividual, chx:RowidReuse ; rdfs:label "DELETE FROM cats WHERE rowid = 4; INSERT INTO cats ..."@en ; skos:definition "A rowid freed by deleting the largest row is handed out again: after deleting rowid 4 the next insert received 4, and after deleting rowid 2 the next received 5, leaving rowids 1, 3, 4 and 5."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_RowidReuse a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'DELETE FROM cats WHERE rowid = 4\\')\\nfirst = c.execute(\\x22INSERT INTO cats VALUES (\\'New\\', \\'2023-01-01\\', \\'gray\\', 4.0)\\x22).lastrowid\\nc.execute(\\'DELETE FROM cats WHERE rowid = 2\\')\\nsecond = c.execute(\\x22INSERT INTO cats VALUES (\\'Newer\\', \\'2023-02-01\\', \\'gray\\', 4.1)\\x22).lastrowid\\nout = (first, second, [r[0] for r in c.execute(\\'SELECT rowid FROM cats ORDER BY rowid\\')])', g), g['out'])[1])({}) evaluates to (4, 5, [1, 3, 4, 5])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'DELETE FROM cats WHERE rowid = 4\\')\\nfirst = c.execute(\\x22INSERT INTO cats VALUES (\\'New\\', \\'2023-01-01\\', \\'gray\\', 4.0)\\x22).lastrowid\\nc.execute(\\'DELETE FROM cats WHERE rowid = 2\\')\\nsecond = c.execute(\\x22INSERT INTO cats VALUES (\\'Newer\\', \\'2023-02-01\\', \\'gray\\', 4.1)\\x22).lastrowid\\nout = (first, second, [r[0] for r in c.execute(\\'SELECT rowid FROM cats ORDER BY rowid\\')])', g), g['out'])[1])({})" ; chx:output "(4, 5, [1, 3, 4, 5])" .
chx:X_RowidReuse rd:hasIOExample chx:IO_RowidReuse .
chx:X_RowidAfterVacuum a owl:NamedIndividual, chx:RowidAfterVacuum ; rdfs:label "VACUUM"@en ; skos:definition "VACUUM may renumber the rowids of a table that has no INTEGER PRIMARY KEY: after deleting rows 1 and 2 of four, the remaining rows (3, 'Jacob') and (4, 'Toby') became (1, 'Jacob') and (2, 'Toby')."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_RowidAfterVacuum a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'DELETE FROM cats WHERE rowid IN (1, 2)\\')\\nbefore = c.execute(\\'SELECT rowid, name FROM cats\\').fetchall()\\nc.execute(\\'VACUUM\\')\\nout = (before, c.execute(\\'SELECT rowid, name FROM cats\\').fetchall())', g), g['out'])[1])({}) evaluates to ([(3, 'Jacob'), (4, 'Toby')], [(1, 'Jacob'), (2, 'Toby')])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'DELETE FROM cats WHERE rowid IN (1, 2)\\')\\nbefore = c.execute(\\'SELECT rowid, name FROM cats\\').fetchall()\\nc.execute(\\'VACUUM\\')\\nout = (before, c.execute(\\'SELECT rowid, name FROM cats\\').fetchall())', g), g['out'])[1])({})" ; chx:output "([(3, 'Jacob'), (4, 'Toby')], [(1, 'Jacob'), (2, 'Toby')])" .
chx:X_RowidAfterVacuum rd:hasIOExample chx:IO_RowidAfterVacuum .
chx:X_IntegerPrimaryKeyAlias a owl:NamedIndividual, chx:IntegerPrimaryKeyAlias ; rdfs:label "id INTEGER PRIMARY KEY AUTOINCREMENT"@en ; skos:definition "A column declared INTEGER PRIMARY KEY is an alias for the rowid and keeps its values through VACUUM, and with AUTOINCREMENT a deleted number is never handed out again: the AUTOINCREMENT table ended with ids 1, 2 and 4 and a sqlite_sequence row of ('b', 4)."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_IntegerPrimaryKeyAlias a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE a (id INTEGER PRIMARY KEY, v TEXT) STRICT\\'); c.execute(\\'CREATE TABLE b (id INTEGER PRIMARY KEY AUTOINCREMENT, v TEXT) STRICT\\')\\nfor t in \\'ab\\':\\n    c.executemany(\\'INSERT INTO %s(v) VALUES (?)\\' % t, [(\\'x\\',), (\\'y\\',), (\\'z\\',)]); c.execute(\\'DELETE FROM %s WHERE id = 3\\' % t); c.execute(\\'INSERT INTO %s(v) VALUES (?)\\' % t, (\\'w\\',))\\nc.execute(\\'DELETE FROM a WHERE id = 1\\'); c.execute(\\'VACUUM\\')\\nout = (c.execute(\\'SELECT id, rowid FROM a\\').fetchall(), c.execute(\\'SELECT id FROM b\\').fetchall(), c.execute(\\'SELECT * FROM sqlite_sequence\\').fetchall())', g), g['out'])[1])({}) evaluates to ([(2, 2), (3, 3)], [(1,), (2,), (4,)], [('b', 4)])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE a (id INTEGER PRIMARY KEY, v TEXT) STRICT\\'); c.execute(\\'CREATE TABLE b (id INTEGER PRIMARY KEY AUTOINCREMENT, v TEXT) STRICT\\')\\nfor t in \\'ab\\':\\n    c.executemany(\\'INSERT INTO %s(v) VALUES (?)\\' % t, [(\\'x\\',), (\\'y\\',), (\\'z\\',)]); c.execute(\\'DELETE FROM %s WHERE id = 3\\' % t); c.execute(\\'INSERT INTO %s(v) VALUES (?)\\' % t, (\\'w\\',))\\nc.execute(\\'DELETE FROM a WHERE id = 1\\'); c.execute(\\'VACUUM\\')\\nout = (c.execute(\\'SELECT id, rowid FROM a\\').fetchall(), c.execute(\\'SELECT id FROM b\\').fetchall(), c.execute(\\'SELECT * FROM sqlite_sequence\\').fetchall())', g), g['out'])[1])({})" ; chx:output "([(2, 2), (3, 3)], [(1,), (2,), (4,)], [('b', 4)])" .
chx:X_IntegerPrimaryKeyAlias rd:hasIOExample chx:IO_IntegerPrimaryKeyAlias .
chx:X_SingleFileServerless a owl:NamedIndividual, chx:SingleFileServerless ; rdfs:label "sqlite3.connect('example.db')"@en ; skos:definition "The whole database lived in one file: after four rows were stored and the connection closed, the directory held only example.db, of 8192 bytes, a multiple of the 4096-byte page."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SingleFileServerless a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'example.db\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.close()\\nout = (os.listdir(\\'.\\'), os.path.getsize(\\'example.db\\'), os.path.getsize(\\'example.db\\') % 4096)', g), g['out'])[1])({}) evaluates to (['example.db'], 8192, 0)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'example.db\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.close()\\nout = (os.listdir(\\'.\\'), os.path.getsize(\\'example.db\\'), os.path.getsize(\\'example.db\\') % 4096)', g), g['out'])[1])({})" ; chx:output "(['example.db'], 8192, 0)" .
chx:X_SingleFileServerless rd:hasIOExample chx:IO_SingleFileServerless .
chx:X_NoGrantRevoke a owl:NamedIndividual, chx:NoGrantRevoke ; rdfs:label "GRANT SELECT ON cats TO bob"@en ; skos:definition "SQLite has no user roles: GRANT SELECT ON cats TO bob was a syntax error near GRANT, REVOKE a syntax error near REVOKE, and CREATE USER a syntax error near USER."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_NoGrantRevoke a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nres = []\\nfor s in (\\'GRANT SELECT ON cats TO bob\\', \\'REVOKE SELECT ON cats FROM bob\\', \\'CREATE USER bob\\'):\\n    try:\\n        c.execute(s)\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({}) evaluates to ['near 'GRANT': syntax error', 'near 'REVOKE': syntax error', 'near 'USER': syntax error']"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nres = []\\nfor s in (\\'GRANT SELECT ON cats TO bob\\', \\'REVOKE SELECT ON cats FROM bob\\', \\'CREATE USER bob\\'):\\n    try:\\n        c.execute(s)\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({})" ; chx:output "['near 'GRANT': syntax error', 'near 'REVOKE': syntax error', 'near 'USER': syntax error']" .
chx:X_NoGrantRevoke rd:hasIOExample chx:IO_NoGrantRevoke .
chx:X_LargeDataLimits a owl:NamedIndividual, chx:LargeDataLimits ; rdfs:label "PRAGMA max_page_count"@en ; skos:definition "Since SQLite 3.45.0 the default maximum is 4294967294 pages, which is 17592186036224 bytes at the 4096-byte page and 281474976579584 bytes at the largest page of 65536; the example computes both from that documented number and checks that the library in use reports it (True), or the older default of 1073741823 pages below 3.45.0."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_LargeDataLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nmp = c.execute(\\'PRAGMA max_page_count\\').fetchone()[0]\\ndoc = 4294967294\\nout = (c.execute(\\'PRAGMA page_size\\').fetchone()[0], doc * 4096, doc * 65536, round(doc * 65536 / 10**12, 1), mp == (doc if sqlite3.sqlite_version_info >= (3, 45, 0) else 1073741823))', g), g['out'])[1])({}) evaluates to (4096, 17592186036224, 281474976579584, 281.5, True)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nmp = c.execute(\\'PRAGMA max_page_count\\').fetchone()[0]\\ndoc = 4294967294\\nout = (c.execute(\\'PRAGMA page_size\\').fetchone()[0], doc * 4096, doc * 65536, round(doc * 65536 / 10**12, 1), mp == (doc if sqlite3.sqlite_version_info >= (3, 45, 0) else 1073741823))', g), g['out'])[1])({})" ; chx:output "(4096, 17592186036224, 281474976579584, 281.5, True)" .
chx:X_LargeDataLimits rd:hasIOExample chx:IO_LargeDataLimits .
chx:X_QueryVersusPythonLoop a owl:NamedIndividual, chx:QueryVersusPythonLoop ; rdfs:label "SELECT * FROM cats WHERE weight_kg BETWEEN 3 AND 5 AND birthdate < '2023-10-01'"@en ; skos:definition "The chapter's opening question, cats weighing between 3 and 5 kilograms and born before October 2023, returned 6 cats from the shipped database, the same six as a Python loop over all 100 rows; the lightest cat weighs 5.0 and the heaviest 8.0, so only cats of exactly 5.0 kilograms matched."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_QueryVersusPythonLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(db)\\nsql = c.execute(\\x22SELECT name, weight_kg, birthdate FROM cats WHERE weight_kg BETWEEN 3 AND 5 AND birthdate < \\'2023-10-01\\' ORDER BY rowid\\x22).fetchall()\\npy = [r for r in c.execute(\\'SELECT name, weight_kg, birthdate FROM cats ORDER BY rowid\\').fetchall() if 3 <= r[1] <= 5 and r[2] < \\'2023-10-01\\']\\nout = (len(sql), sql == py, [r[0] for r in sql], c.execute(\\'SELECT MIN(weight_kg), MAX(weight_kg), COUNT(*) FROM cats\\').fetchone())', g), g['out'])[1])({}) evaluates to (6, True, ['Powder', 'Morgan', 'Mitsy', 'Spice', 'Harry', 'Luke'], (5.0, 8.0, 100))"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(db)\\nsql = c.execute(\\x22SELECT name, weight_kg, birthdate FROM cats WHERE weight_kg BETWEEN 3 AND 5 AND birthdate < \\'2023-10-01\\' ORDER BY rowid\\x22).fetchall()\\npy = [r for r in c.execute(\\'SELECT name, weight_kg, birthdate FROM cats ORDER BY rowid\\').fetchall() if 3 <= r[1] <= 5 and r[2] < \\'2023-10-01\\']\\nout = (len(sql), sql == py, [r[0] for r in sql], c.execute(\\'SELECT MIN(weight_kg), MAX(weight_kg), COUNT(*) FROM cats\\').fetchone())', g), g['out'])[1])({})" ; chx:output "(6, True, ['Powder', 'Morgan', 'Mitsy', 'Spice', 'Harry', 'Luke'], (5.0, 8.0, 100))" .
chx:X_QueryVersusPythonLoop rd:hasIOExample chx:IO_QueryVersusPythonLoop .
chx:X_ConnectCreatesFile a owl:NamedIndividual, chx:ConnectCreatesFile ; rdfs:label "sqlite3.connect('example.db', isolation_level=None)"@en ; skos:definition "connect() creates the file at once but writes nothing: a new example.db existed with 0 bytes after connect and after a SELECT 1, and had 8192 bytes only after the first CREATE TABLE."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ConnectCreatesFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'example.db\\', isolation_level=None)\\na = (os.path.exists(\\'example.db\\'), os.path.getsize(\\'example.db\\'))\\nc.execute(\\'SELECT 1\\').fetchall()\\nb = os.path.getsize(\\'example.db\\')\\nc.execute(\\'CREATE TABLE t (a)\\')\\nout = (a, b, os.path.getsize(\\'example.db\\'))', g), g['out'])[1])({}) evaluates to ((True, 0), 0, 8192)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'example.db\\', isolation_level=None)\\na = (os.path.exists(\\'example.db\\'), os.path.getsize(\\'example.db\\'))\\nc.execute(\\'SELECT 1\\').fetchall()\\nb = os.path.getsize(\\'example.db\\')\\nc.execute(\\'CREATE TABLE t (a)\\')\\nout = (a, b, os.path.getsize(\\'example.db\\'))', g), g['out'])[1])({})" ; chx:output "((True, 0), 0, 8192)" .
chx:X_ConnectCreatesFile rd:hasIOExample chx:IO_ConnectCreatesFile .
chx:X_NotADatabaseFile a owl:NamedIndividual, chx:NotADatabaseFile ; rdfs:label "sqlite3.DatabaseError: file is not a database"@en ; skos:definition "A text file connects without error and fails when a statement needs the file: CREATE TABLE raised DatabaseError with the message file is not a database."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_NotADatabaseFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nopen(\\'notes.db\\', \\'w\\').write(\\'this is a text file, not a database. \\' * 20)\\nc = sqlite3.connect(\\'notes.db\\')\\nres = [\\'connected\\']\\nfor s in (\\'CREATE TABLE t (a)\\',):\\n    try:\\n        c.execute(s)\\n    except sqlite3.Error as e:\\n        res.append((type(e).__name__, str(e), isinstance(e, sqlite3.DatabaseError)))\\nout = res', g), g['out'])[1])({}) evaluates to ['connected', ('DatabaseError', 'file is not a database', True)]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nopen(\\'notes.db\\', \\'w\\').write(\\'this is a text file, not a database. \\' * 20)\\nc = sqlite3.connect(\\'notes.db\\')\\nres = [\\'connected\\']\\nfor s in (\\'CREATE TABLE t (a)\\',):\\n    try:\\n        c.execute(s)\\n    except sqlite3.Error as e:\\n        res.append((type(e).__name__, str(e), isinstance(e, sqlite3.DatabaseError)))\\nout = res', g), g['out'])[1])({})" ; chx:output "['connected', ('DatabaseError', 'file is not a database', True)]" .
chx:X_NotADatabaseFile rd:hasIOExample chx:IO_NotADatabaseFile .
chx:X_PathLikeAndUri a owl:NamedIndividual, chx:PathLikeAndUri ; rdfs:label "sqlite3.connect(pathlib.Path('example.db')); sqlite3.connect('file:example.db?mode=ro', uri=True)"@en ; skos:definition "connect() accepts a pathlib.Path, and with uri=True a file: URI whose mode=ro made a write fail with attempt to write a readonly database while mode=rw on a missing file failed with unable to open database file and created nothing."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_PathLikeAndUri a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport pathlib\\nc = sqlite3.connect(pathlib.Path(\\'p.db\\')); c.execute(\\'CREATE TABLE t (a)\\'); c.commit(); c.close()\\nro = sqlite3.connect(\\'file:p.db?mode=ro\\', uri=True)\\nres = []\\nfor f in (lambda: ro.execute(\\'INSERT INTO t VALUES (1)\\'), lambda: sqlite3.connect(\\'file:missing.db?mode=rw\\', uri=True)):\\n    try:\\n        f()\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nro.close()\\nout = (os.path.exists(\\'p.db\\'), res, os.path.exists(\\'missing.db\\'))', g), g['out'])[1])({}) evaluates to (True, ['attempt to write a readonly database', 'unable to open database file'], False)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport pathlib\\nc = sqlite3.connect(pathlib.Path(\\'p.db\\')); c.execute(\\'CREATE TABLE t (a)\\'); c.commit(); c.close()\\nro = sqlite3.connect(\\'file:p.db?mode=ro\\', uri=True)\\nres = []\\nfor f in (lambda: ro.execute(\\'INSERT INTO t VALUES (1)\\'), lambda: sqlite3.connect(\\'file:missing.db?mode=rw\\', uri=True)):\\n    try:\\n        f()\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nro.close()\\nout = (os.path.exists(\\'p.db\\'), res, os.path.exists(\\'missing.db\\'))', g), g['out'])[1])({})" ; chx:output "(True, ['attempt to write a readonly database', 'unable to open database file'], False)" .
chx:X_PathLikeAndUri rd:hasIOExample chx:IO_PathLikeAndUri .
chx:X_CloseAndWarnings a owl:NamedIndividual, chx:CloseAndWarnings ; rdfs:label "conn.close(); with sqlite3.connect(...) as conn"@en ; skos:definition "with conn does not close the connection, closing() from contextlib does, and an unclosed connection that is deleted emits a ResourceWarning: after the with block a query still returned (0,), after closing() a query raised ProgrammingError with Cannot operate on a closed database."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_CloseAndWarnings a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport contextlib, gc\\nc = sqlite3.connect(\\'x.db\\')\\nwith c:\\n    c.execute(\\'CREATE TABLE t (a)\\')\\nstill = c.execute(\\'SELECT count(*) FROM t\\').fetchone()\\nwith contextlib.closing(sqlite3.connect(\\'x.db\\')) as k:\\n    pass\\ntry:\\n    k.execute(\\'SELECT 1\\')\\nexcept sqlite3.ProgrammingError as e:\\n    closed = str(e)\\nc.close()\\ngc.collect()\\nwith warnings.catch_warnings(record=True) as w:\\n    warnings.simplefilter(\\'always\\')\\n    u = sqlite3.connect(\\'x.db\\'); del u; gc.collect()\\nout = (still, closed, [(x.category.__name__, str(x.message)[:24]) for x in w])', g), g['out'])[1])({}) evaluates to ((0,), 'Cannot operate on a closed database.', [('ResourceWarning', 'unclosed database in <sq')])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport contextlib, gc\\nc = sqlite3.connect(\\'x.db\\')\\nwith c:\\n    c.execute(\\'CREATE TABLE t (a)\\')\\nstill = c.execute(\\'SELECT count(*) FROM t\\').fetchone()\\nwith contextlib.closing(sqlite3.connect(\\'x.db\\')) as k:\\n    pass\\ntry:\\n    k.execute(\\'SELECT 1\\')\\nexcept sqlite3.ProgrammingError as e:\\n    closed = str(e)\\nc.close()\\ngc.collect()\\nwith warnings.catch_warnings(record=True) as w:\\n    warnings.simplefilter(\\'always\\')\\n    u = sqlite3.connect(\\'x.db\\'); del u; gc.collect()\\nout = (still, closed, [(x.category.__name__, str(x.message)[:24]) for x in w])', g), g['out'])[1])({})" ; chx:output "((0,), 'Cannot operate on a closed database.', [('ResourceWarning', 'unclosed database in <sq')])" .
chx:X_CloseAndWarnings rd:hasIOExample chx:IO_CloseAndWarnings .
chx:X_StorageClasses a owl:NamedIndividual, chx:StorageClasses ; rdfs:label "SELECT typeof(NULL), typeof(1), typeof(1.5), typeof('a'), typeof(x'00')"@en ; skos:definition "A value has one of five storage classes, and typeof() names them: NULL gave 'null', 1 gave 'integer', 1.5 gave 'real', 'a' gave 'text' and x'00' gave 'blob', both in SQL and when the values were bound from None, int, float, str and bytes."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_StorageClasses a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nout = (c.execute(\\x22SELECT typeof(NULL), typeof(1), typeof(1.5), typeof(\\'a\\'), typeof(x\\'00\\')\\x22).fetchone(), c.execute(\\'SELECT ?, ?, ?, ?, ?\\', (None, 1, 1.5, \\'a\\', b\\'\\\\x00\\')).fetchone(), c.execute(\\'SELECT typeof(?), typeof(?), typeof(?), typeof(?), typeof(?)\\', (None, 1, 1.5, \\'a\\', b\\'\\\\x00\\')).fetchone())', g), g['out'])[1])({}) evaluates to (('null', 'integer', 'real', 'text', 'blob'), (None, 1, 1.5, 'a', b'\\x00'), ('null', 'integer', 'real', 'text', 'blob'))"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nout = (c.execute(\\x22SELECT typeof(NULL), typeof(1), typeof(1.5), typeof(\\'a\\'), typeof(x\\'00\\')\\x22).fetchone(), c.execute(\\'SELECT ?, ?, ?, ?, ?\\', (None, 1, 1.5, \\'a\\', b\\'\\\\x00\\')).fetchone(), c.execute(\\'SELECT typeof(?), typeof(?), typeof(?), typeof(?), typeof(?)\\', (None, 1, 1.5, \\'a\\', b\\'\\\\x00\\')).fetchone())', g), g['out'])[1])({})" ; chx:output "(('null', 'integer', 'real', 'text', 'blob'), (None, 1, 1.5, 'a', b'\\x00'), ('null', 'integer', 'real', 'text', 'blob'))" .
chx:X_StorageClasses rd:hasIOExample chx:IO_StorageClasses .
chx:X_SixTypesMiscount a owl:NamedIndividual, chx:SixTypesMiscount ; rdfs:label "CREATE TABLE ... (a INT, b INTEGER, c REAL, d TEXT, e BLOB, f ANY) STRICT"@en ; skos:definition "The chapter says there are six data types and lists five; under STRICT a column may be declared INT, INTEGER, REAL, TEXT, BLOB or ANY, six keywords, and CREATE TABLE refused NULL, BOOLEAN, DATE, VARCHAR, NUMERIC and FLOAT."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SixTypesMiscount a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nok, bad = [], []\\nfor t in (\\'INT\\', \\'INTEGER\\', \\'REAL\\', \\'TEXT\\', \\'BLOB\\', \\'ANY\\', \\'NULL\\', \\'BOOLEAN\\', \\'DATE\\', \\'VARCHAR\\', \\'NUMERIC\\', \\'FLOAT\\'):\\n    try:\\n        c.execute(\\'CREATE TABLE t_%s (a %s) STRICT\\' % (t.lower(), t)); ok.append(t)\\n    except sqlite3.OperationalError:\\n        bad.append(t)\\nout = (ok, bad, len(ok))', g), g['out'])[1])({}) evaluates to (['INT', 'INTEGER', 'REAL', 'TEXT', 'BLOB', 'ANY'], ['NULL', 'BOOLEAN', 'DATE', 'VARCHAR', 'NUMERIC', 'FLOAT'], 6)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nok, bad = [], []\\nfor t in (\\'INT\\', \\'INTEGER\\', \\'REAL\\', \\'TEXT\\', \\'BLOB\\', \\'ANY\\', \\'NULL\\', \\'BOOLEAN\\', \\'DATE\\', \\'VARCHAR\\', \\'NUMERIC\\', \\'FLOAT\\'):\\n    try:\\n        c.execute(\\'CREATE TABLE t_%s (a %s) STRICT\\' % (t.lower(), t)); ok.append(t)\\n    except sqlite3.OperationalError:\\n        bad.append(t)\\nout = (ok, bad, len(ok))', g), g['out'])[1])({})" ; chx:output "(['INT', 'INTEGER', 'REAL', 'TEXT', 'BLOB', 'ANY'], ['NULL', 'BOOLEAN', 'DATE', 'VARCHAR', 'NUMERIC', 'FLOAT'], 6)" .
chx:X_SixTypesMiscount rd:hasIOExample chx:IO_SixTypesMiscount .
chx:X_TypeAffinity a owl:NamedIndividual, chx:TypeAffinity ; rdfs:label "INSERT INTO t (i) VALUES ('42')"@en ; skos:definition "In an ordinary table the column type is a preference: '42' in an INTEGER column became the integer 42, 42 in a TEXT column became the text '42', '3.5' in a REAL column became 3.5, '7' in a NUMERIC column became the integer 7, and 'Hello' in an INTEGER column stayed the text 'Hello'."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_TypeAffinity a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE t (i INTEGER, t TEXT, r REAL, n NUMERIC, b BLOB)\\')\\nc.execute(\\x22INSERT INTO t VALUES (\\'42\\', 42, \\'3.5\\', \\'7\\', \\'x\\')\\x22)\\nc.execute(\\x22INSERT INTO t (i) VALUES (\\'Hello\\')\\x22)\\nout = (c.execute(\\'SELECT i, typeof(i), t, typeof(t), r, typeof(r), n, typeof(n), b, typeof(b) FROM t WHERE rowid = 1\\').fetchone(), c.execute(\\'SELECT i, typeof(i) FROM t WHERE rowid = 2\\').fetchone())', g), g['out'])[1])({}) evaluates to ((42, 'integer', '42', 'text', 3.5, 'real', 7, 'integer', 'x', 'text'), ('Hello', 'text'))"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE t (i INTEGER, t TEXT, r REAL, n NUMERIC, b BLOB)\\')\\nc.execute(\\x22INSERT INTO t VALUES (\\'42\\', 42, \\'3.5\\', \\'7\\', \\'x\\')\\x22)\\nc.execute(\\x22INSERT INTO t (i) VALUES (\\'Hello\\')\\x22)\\nout = (c.execute(\\'SELECT i, typeof(i), t, typeof(t), r, typeof(r), n, typeof(n), b, typeof(b) FROM t WHERE rowid = 1\\').fetchone(), c.execute(\\'SELECT i, typeof(i) FROM t WHERE rowid = 2\\').fetchone())', g), g['out'])[1])({})" ; chx:output "((42, 'integer', '42', 'text', 3.5, 'real', 7, 'integer', 'x', 'text'), ('Hello', 'text'))" .
chx:X_TypeAffinity rd:hasIOExample chx:IO_TypeAffinity .
chx:X_StrictMode a owl:NamedIndividual, chx:StrictMode ; rdfs:label "CREATE TABLE cats (...) STRICT"@en ; skos:definition "STRICT keeps the casts that are lossless and refuses the rest: '42' and 42 and '3.5' went in as 42, '42' and 3.5, 'Hello' raised IntegrityError with cannot store TEXT value in INTEGER column s.i, 3.5 into INTEGER raised the same error for REAL, 42.0 and NULL were stored, and a column without a type was refused with missing datatype for bad.a."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_StrictMode a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE s (i INTEGER, t TEXT, r REAL) STRICT\\')\\nc.execute(\\x22INSERT INTO s VALUES (\\'42\\', 42, \\'3.5\\')\\x22)\\nres = [c.execute(\\'SELECT i, typeof(i), t, typeof(t), r, typeof(r) FROM s\\').fetchone()]\\nfor v in (\\x22\\'Hello\\'\\x22, \\'3.5\\', \\'42.0\\', \\'NULL\\'):\\n    try:\\n        c.execute(\\'INSERT INTO s (i) VALUES (%s)\\' % v); res.append((v, \\'stored\\', c.execute(\\'SELECT i, typeof(i) FROM s ORDER BY rowid DESC LIMIT 1\\').fetchone()))\\n    except sqlite3.IntegrityError as e:\\n        res.append((v, type(e).__name__, str(e)))\\ntry:\\n    c.execute(\\'CREATE TABLE bad (a, b INTEGER) STRICT\\')\\nexcept sqlite3.OperationalError as e:\\n    res.append(str(e))\\nout = res', g), g['out'])[1])({}) evaluates to [(42, 'integer', '42', 'text', 3.5, 'real'), (''Hello'', 'IntegrityError', 'cannot store TEXT value in INTEGER column s.i'), ('3.5', 'IntegrityError', 'cannot store REAL value in INTEGER column s.i'), ('42.0', 'stored', (42, 'integer')), ('NULL', 'stored', (None, 'null')), 'missing datatype for bad.a']"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE s (i INTEGER, t TEXT, r REAL) STRICT\\')\\nc.execute(\\x22INSERT INTO s VALUES (\\'42\\', 42, \\'3.5\\')\\x22)\\nres = [c.execute(\\'SELECT i, typeof(i), t, typeof(t), r, typeof(r) FROM s\\').fetchone()]\\nfor v in (\\x22\\'Hello\\'\\x22, \\'3.5\\', \\'42.0\\', \\'NULL\\'):\\n    try:\\n        c.execute(\\'INSERT INTO s (i) VALUES (%s)\\' % v); res.append((v, \\'stored\\', c.execute(\\'SELECT i, typeof(i) FROM s ORDER BY rowid DESC LIMIT 1\\').fetchone()))\\n    except sqlite3.IntegrityError as e:\\n        res.append((v, type(e).__name__, str(e)))\\ntry:\\n    c.execute(\\'CREATE TABLE bad (a, b INTEGER) STRICT\\')\\nexcept sqlite3.OperationalError as e:\\n    res.append(str(e))\\nout = res', g), g['out'])[1])({})" ; chx:output "[(42, 'integer', '42', 'text', 3.5, 'real'), (''Hello'', 'IntegrityError', 'cannot store TEXT value in INTEGER column s.i'), ('3.5', 'IntegrityError', 'cannot store REAL value in INTEGER column s.i'), ('42.0', 'stored', (42, 'integer')), ('NULL', 'stored', (None, 'null')), 'missing datatype for bad.a']" .
chx:X_StrictMode rd:hasIOExample chx:IO_StrictMode .
chx:X_BooleanAndDates a owl:NamedIndividual, chx:BooleanAndDates ; rdfs:label "SELECT date('2035-10-31'), datetime('2035-10-31 16:30:00'), time('16:30:00.407')"@en ; skos:definition "There is no Boolean or date type, only conventions: True went into an INTEGER column as 1, TRUE and FALSE are 1 and 0 in SQL, date('31/10/2035') gave None, datetime with .407 seconds printed without the fraction, and storing a datetime.date object worked with a DeprecationWarning."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_BooleanAndDates a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport datetime\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE t (flag INTEGER, day TEXT) STRICT\\')\\nc.execute(\\'INSERT INTO t VALUES (?, ?)\\', (True, \\'2035-10-31\\'))\\nres = [c.execute(\\'SELECT flag, typeof(flag), day FROM t\\').fetchone(), c.execute(\\'SELECT TRUE, FALSE\\').fetchone()]\\nres.append(c.execute(\\x22SELECT date(\\'2035-10-31\\'), datetime(\\'2035-10-31 16:30:00\\'), datetime(\\'2035-10-31 16:30:00.407\\'), time(\\'16:30:00\\'), time(\\'16:30:00.407\\'), date(\\'31/10/2035\\'), \\'2035-10-31\\' < \\'2035-11-01\\'\\x22).fetchone())\\nwith warnings.catch_warnings(record=True) as w:\\n    warnings.simplefilter(\\'always\\')\\n    c.execute(\\'INSERT INTO t VALUES (1, ?)\\', (datetime.date(2035, 10, 31),))\\nres.append((c.execute(\\'SELECT day FROM t ORDER BY rowid DESC LIMIT 1\\').fetchone(), [x.category.__name__ for x in w]))\\nout = res', g), g['out'])[1])({}) evaluates to [(1, 'integer', '2035-10-31'), (1, 0), ('2035-10-31', '2035-10-31 16:30:00', '2035-10-31 16:30:00', '16:30:00', '16:30:00', None, 1), (('2035-10-31',), ['DeprecationWarning'])]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport datetime\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE t (flag INTEGER, day TEXT) STRICT\\')\\nc.execute(\\'INSERT INTO t VALUES (?, ?)\\', (True, \\'2035-10-31\\'))\\nres = [c.execute(\\'SELECT flag, typeof(flag), day FROM t\\').fetchone(), c.execute(\\'SELECT TRUE, FALSE\\').fetchone()]\\nres.append(c.execute(\\x22SELECT date(\\'2035-10-31\\'), datetime(\\'2035-10-31 16:30:00\\'), datetime(\\'2035-10-31 16:30:00.407\\'), time(\\'16:30:00\\'), time(\\'16:30:00.407\\'), date(\\'31/10/2035\\'), \\'2035-10-31\\' < \\'2035-11-01\\'\\x22).fetchone())\\nwith warnings.catch_warnings(record=True) as w:\\n    warnings.simplefilter(\\'always\\')\\n    c.execute(\\'INSERT INTO t VALUES (1, ?)\\', (datetime.date(2035, 10, 31),))\\nres.append((c.execute(\\'SELECT day FROM t ORDER BY rowid DESC LIMIT 1\\').fetchone(), [x.category.__name__ for x in w]))\\nout = res', g), g['out'])[1])({})" ; chx:output "[(1, 'integer', '2035-10-31'), (1, 0), ('2035-10-31', '2035-10-31 16:30:00', '2035-10-31 16:30:00', '16:30:00', '16:30:00', None, 1), (('2035-10-31',), ['DeprecationWarning'])]" .
chx:X_BooleanAndDates rd:hasIOExample chx:IO_BooleanAndDates .
chx:X_PythonValueMapping a owl:NamedIndividual, chx:PythonValueMapping ; rdfs:label "conn.execute('INSERT INTO t VALUES (?)', [value])"@en ; skos:definition "The module binds None, int, float, str and bytes to NULL, INTEGER, REAL, TEXT and BLOB and True to the integer 1, and it refuses everything else: 2**63 raised OverflowError (Python int too large to convert to SQLite INTEGER), and a Decimal and a list raised ProgrammingError."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_PythonValueMapping a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport decimal\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE t (v)\\')\\nfor v in (None, 7, 2.5, \\'x\\', b\\'\\\\x00\\\\x01\\', True, 2**63 - 1):\\n    c.execute(\\'INSERT INTO t VALUES (?)\\', (v,))\\nres = c.execute(\\'SELECT v, typeof(v) FROM t\\').fetchall()\\nerrs = []\\nfor v in (2**63, decimal.Decimal(\\'1.5\\'), [1, 2]):\\n    try:\\n        c.execute(\\'INSERT INTO t VALUES (?)\\', (v,))\\n    except Exception as e:\\n        errs.append((type(e).__name__, str(e)[:60]))\\nout = (res, errs)', g), g['out'])[1])({}) evaluates to ([(None, 'null'), (7, 'integer'), (2.5, 'real'), ('x', 'text'), (b'\\x00\\x01', 'blob'), (1, 'integer'), (9223372036854775807, 'integer')], [('OverflowError', 'Python int too large to convert to SQLite INTEGER'), ('ProgrammingError', 'Error binding parameter 1: type 'decimal.Decimal' is not sup'), ('ProgrammingError', 'Error binding parameter 1: type 'list' is not supported')])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport decimal\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE t (v)\\')\\nfor v in (None, 7, 2.5, \\'x\\', b\\'\\\\x00\\\\x01\\', True, 2**63 - 1):\\n    c.execute(\\'INSERT INTO t VALUES (?)\\', (v,))\\nres = c.execute(\\'SELECT v, typeof(v) FROM t\\').fetchall()\\nerrs = []\\nfor v in (2**63, decimal.Decimal(\\'1.5\\'), [1, 2]):\\n    try:\\n        c.execute(\\'INSERT INTO t VALUES (?)\\', (v,))\\n    except Exception as e:\\n        errs.append((type(e).__name__, str(e)[:60]))\\nout = (res, errs)', g), g['out'])[1])({})" ; chx:output "([(None, 'null'), (7, 'integer'), (2.5, 'real'), ('x', 'text'), (b'\\x00\\x01', 'blob'), (1, 'integer'), (9223372036854775807, 'integer')], [('OverflowError', 'Python int too large to convert to SQLite INTEGER'), ('ProgrammingError', 'Error binding parameter 1: type 'decimal.Decimal' is not sup'), ('ProgrammingError', 'Error binding parameter 1: type 'list' is not supported')])" .
chx:X_PythonValueMapping rd:hasIOExample chx:IO_PythonValueMapping .
chx:X_CreateIfNotExists a owl:NamedIndividual, chx:CreateIfNotExists ; rdfs:label "CREATE TABLE IF NOT EXISTS cats (...)"@en ; skos:definition "CREATE TABLE raised OperationalError with table cats already exists for the same name and for CATS, and CREATE TABLE IF NOT EXISTS with a different column list returned without an error and left the first definition in place."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_CreateIfNotExists a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE cats (name TEXT) STRICT\\')\\nres = []\\nfor s in (\\'CREATE TABLE cats (name TEXT) STRICT\\', \\'CREATE TABLE CATS (name TEXT) STRICT\\', \\'CREATE TABLE IF NOT EXISTS cats (other INTEGER) STRICT\\'):\\n    try:\\n        c.execute(s); res.append(\\'ok\\')\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nres.append(c.execute(\\'PRAGMA table_info(cats)\\').fetchall())\\nres.append(c.execute(\\x22SELECT NAME FROM CATS WHERE NAME = \\'x\\'\\x22).fetchall())\\nout = res', g), g['out'])[1])({}) evaluates to ['table cats already exists', 'table CATS already exists', 'ok', [(0, 'name', 'TEXT', 0, None, 0)], []]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE cats (name TEXT) STRICT\\')\\nres = []\\nfor s in (\\'CREATE TABLE cats (name TEXT) STRICT\\', \\'CREATE TABLE CATS (name TEXT) STRICT\\', \\'CREATE TABLE IF NOT EXISTS cats (other INTEGER) STRICT\\'):\\n    try:\\n        c.execute(s); res.append(\\'ok\\')\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nres.append(c.execute(\\'PRAGMA table_info(cats)\\').fetchall())\\nres.append(c.execute(\\x22SELECT NAME FROM CATS WHERE NAME = \\'x\\'\\x22).fetchall())\\nout = res', g), g['out'])[1])({})" ; chx:output "['table cats already exists', 'table CATS already exists', 'ok', [(0, 'name', 'TEXT', 0, None, 0)], []]" .
chx:X_CreateIfNotExists rd:hasIOExample chx:IO_CreateIfNotExists .
chx:X_SchemaTable a owl:NamedIndividual, chx:SchemaTable ; rdfs:label "SELECT name FROM sqlite_schema WHERE type='table'"@en ; skos:definition "sqlite_schema lists every table, index and view with its type and tbl_name, in the order they were created, and sqlite_master returned the same rows: the type = 'table' query gave [('cats',)] while the full listing gave cats, idx_name and black_cats."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SchemaTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\')\\nc.execute(\\'CREATE VIEW black_cats AS SELECT * FROM cats WHERE fur = \\\\\\'black\\\\\\'\\')\\nout = (c.execute(\\'SELECT name FROM sqlite_schema WHERE type = \\\\\\'table\\\\\\'\\').fetchall(), c.execute(\\'SELECT name, type, tbl_name FROM sqlite_schema ORDER BY rowid\\').fetchall(), c.execute(\\'SELECT * FROM sqlite_schema ORDER BY rowid\\').fetchall() == c.execute(\\'SELECT * FROM sqlite_master ORDER BY rowid\\').fetchall())', g), g['out'])[1])({}) evaluates to ([('cats',)], [('cats', 'table', 'cats'), ('idx_name', 'index', 'cats'), ('black_cats', 'view', 'black_cats')], True)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\')\\nc.execute(\\'CREATE VIEW black_cats AS SELECT * FROM cats WHERE fur = \\\\\\'black\\\\\\'\\')\\nout = (c.execute(\\'SELECT name FROM sqlite_schema WHERE type = \\\\\\'table\\\\\\'\\').fetchall(), c.execute(\\'SELECT name, type, tbl_name FROM sqlite_schema ORDER BY rowid\\').fetchall(), c.execute(\\'SELECT * FROM sqlite_schema ORDER BY rowid\\').fetchall() == c.execute(\\'SELECT * FROM sqlite_master ORDER BY rowid\\').fetchall())', g), g['out'])[1])({})" ; chx:output "([('cats',)], [('cats', 'table', 'cats'), ('idx_name', 'index', 'cats'), ('black_cats', 'view', 'black_cats')], True)" .
chx:X_SchemaTable rd:hasIOExample chx:IO_SchemaTable .
chx:X_TableInfo a owl:NamedIndividual, chx:TableInfo ; rdfs:label "PRAGMA TABLE_INFO(cats)"@en ; skos:definition "PRAGMA TABLE_INFO returns one tuple per column with the fields cid, name, type, notnull, dflt_value and pk, and for a text default the dflt_value is the SQL text with its quotes, ''x'', while the pk field is 1 for an INTEGER PRIMARY KEY."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_TableInfo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE k (id INTEGER PRIMARY KEY, a TEXT DEFAULT \\\\\\'x\\\\\\', b TEXT NOT NULL) STRICT\\')\\nout = (c.execute(\\'PRAGMA TABLE_INFO(cats)\\').fetchall(), c.execute(\\'PRAGMA TABLE_INFO(k)\\').fetchall(), [d[0] for d in c.execute(\\'SELECT * FROM pragma_table_info(\\\\\\'cats\\\\\\')\\').description])', g), g['out'])[1])({}) evaluates to ([(0, 'name', 'TEXT', 1, None, 0), (1, 'birthdate', 'TEXT', 0, None, 0), (2, 'fur', 'TEXT', 0, None, 0), (3, 'weight_kg', 'REAL', 0, None, 0)], [(0, 'id', 'INTEGER', 0, None, 1), (1, 'a', 'TEXT', 0, ''x'', 0), (2, 'b', 'TEXT', 1, None, 0)], ['cid', 'name', 'type', 'notnull', 'dflt_value', 'pk'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE k (id INTEGER PRIMARY KEY, a TEXT DEFAULT \\\\\\'x\\\\\\', b TEXT NOT NULL) STRICT\\')\\nout = (c.execute(\\'PRAGMA TABLE_INFO(cats)\\').fetchall(), c.execute(\\'PRAGMA TABLE_INFO(k)\\').fetchall(), [d[0] for d in c.execute(\\'SELECT * FROM pragma_table_info(\\\\\\'cats\\\\\\')\\').description])', g), g['out'])[1])({})" ; chx:output "([(0, 'name', 'TEXT', 1, None, 0), (1, 'birthdate', 'TEXT', 0, None, 0), (2, 'fur', 'TEXT', 0, None, 0), (3, 'weight_kg', 'REAL', 0, None, 0)], [(0, 'id', 'INTEGER', 0, None, 1), (1, 'a', 'TEXT', 0, ''x'', 0), (2, 'b', 'TEXT', 1, None, 0)], ['cid', 'name', 'type', 'notnull', 'dflt_value', 'pk'])" .
chx:X_TableInfo rd:hasIOExample chx:IO_TableInfo .
chx:X_SqliteVersion a owl:NamedIndividual, chx:SqliteVersion ; rdfs:label "sqlite3.sqlite_version"@en ; skos:definition "sqlite3.sqlite_version is the version of the SQLite library the module is linked with, as text; it equals SELECT sqlite_version() and the tuple sqlite_version_info, and sqlite3.threadsafety is one of the DB-API levels 0, 1 and 3. The numbers themselves depend on the machine: they were 3.53.1 and Python 3.14.6 where this chapter was recorded (interpreter_record_v1_0_0.json)."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SqliteVersion a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nv = sqlite3.sqlite_version\\nout = (c.execute(\\'SELECT sqlite_version()\\').fetchone()[0] == v, sqlite3.sqlite_version_info == tuple(int(x) for x in v.split(\\'.\\')), type(v).__name__, sqlite3.threadsafety in (0, 1, 3))', g), g['out'])[1])({}) evaluates to (True, True, 'str', True)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nv = sqlite3.sqlite_version\\nout = (c.execute(\\'SELECT sqlite_version()\\').fetchone()[0] == v, sqlite3.sqlite_version_info == tuple(int(x) for x in v.split(\\'.\\')), type(v).__name__, sqlite3.threadsafety in (0, 1, 3))', g), g['out'])[1])({})" ; chx:output "(True, True, 'str', True)" .
chx:X_SqliteVersion rd:hasIOExample chx:IO_SqliteVersion .
chx:X_StrictVersionClaim a owl:NamedIndividual, chx:StrictVersionClaim ; rdfs:label "STRICT needs SQLite 3.37.0"@en ; skos:definition "STRICT worked under SQLite 3.53.1, pragma_table_list marked the table strict = 1 and sqlite_schema stored the text CREATE TABLE s (a INTEGER) STRICT; the version in which it appeared is 3.37.0, released 2021-11-27."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_StrictVersionClaim a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE s (a INTEGER) STRICT\\')\\nout = (sqlite3.sqlite_version_info >= (3, 37, 0), c.execute(\\x22SELECT name, strict FROM pragma_table_list WHERE name = \\'s\\'\\x22).fetchall(), c.execute(\\x22SELECT sql FROM sqlite_schema WHERE name = \\'s\\'\\x22).fetchone()[0])', g), g['out'])[1])({}) evaluates to (True, [('s', 1)], 'CREATE TABLE s (a INTEGER) STRICT')"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE s (a INTEGER) STRICT\\')\\nout = (sqlite3.sqlite_version_info >= (3, 37, 0), c.execute(\\x22SELECT name, strict FROM pragma_table_list WHERE name = \\'s\\'\\x22).fetchall(), c.execute(\\x22SELECT sql FROM sqlite_schema WHERE name = \\'s\\'\\x22).fetchone()[0])', g), g['out'])[1])({})" ; chx:output "(True, [('s', 1)], 'CREATE TABLE s (a INTEGER) STRICT')" .
chx:X_StrictVersionClaim rd:hasIOExample chx:IO_StrictVersionClaim .
chx:X_InsertColumnList a owl:NamedIndividual, chx:InsertColumnList ; rdfs:label "INSERT INTO cats (name, fur) VALUES ('Mango', 'tuxedo')"@en ; skos:definition "INSERT INTO cats (name, fur) VALUES (...) stored NULL in the columns left out; a row with too few values was refused with table cats has 4 columns but 1 values were supplied, a list of two columns and one value with 1 values for 2 columns, a NULL name with NOT NULL constraint failed: cats.name, and after ADD COLUMN the chapter's four-value form failed with table cats has 5 columns but 4 values were supplied."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_InsertColumnList a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\x22INSERT INTO cats (name, fur) VALUES (\\'Mango\\', \\'tuxedo\\')\\x22)\\nres = [c.execute(\\'SELECT * FROM cats WHERE name = \\\\\\'Mango\\\\\\'\\').fetchone()]\\nfor s in (\\x22INSERT INTO cats VALUES (\\'Short\\')\\x22, \\x22INSERT INTO cats (name, fur) VALUES (\\'Mango\\')\\x22, \\x22INSERT INTO cats (name) VALUES (NULL)\\x22):\\n    try:\\n        c.execute(s)\\n    except sqlite3.Error as e:\\n        res.append((type(e).__name__, str(e)))\\nc.execute(\\'ALTER TABLE cats ADD COLUMN is_loved INTEGER DEFAULT 1\\')\\ntry:\\n    c.execute(\\x22INSERT INTO cats VALUES (\\'Zed\\', \\'2020-01-01\\', \\'gray\\', 4.0)\\x22)\\nexcept sqlite3.Error as e:\\n    res.append((type(e).__name__, str(e)))\\nout = res', g), g['out'])[1])({}) evaluates to [('Mango', None, 'tuxedo', None), ('OperationalError', 'table cats has 4 columns but 1 values were supplied'), ('OperationalError', '1 values for 2 columns'), ('IntegrityError', 'NOT NULL constraint failed: cats.name'), ('OperationalError', 'table cats has 5 columns but 4 values were supplied')]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\x22INSERT INTO cats (name, fur) VALUES (\\'Mango\\', \\'tuxedo\\')\\x22)\\nres = [c.execute(\\'SELECT * FROM cats WHERE name = \\\\\\'Mango\\\\\\'\\').fetchone()]\\nfor s in (\\x22INSERT INTO cats VALUES (\\'Short\\')\\x22, \\x22INSERT INTO cats (name, fur) VALUES (\\'Mango\\')\\x22, \\x22INSERT INTO cats (name) VALUES (NULL)\\x22):\\n    try:\\n        c.execute(s)\\n    except sqlite3.Error as e:\\n        res.append((type(e).__name__, str(e)))\\nc.execute(\\'ALTER TABLE cats ADD COLUMN is_loved INTEGER DEFAULT 1\\')\\ntry:\\n    c.execute(\\x22INSERT INTO cats VALUES (\\'Zed\\', \\'2020-01-01\\', \\'gray\\', 4.0)\\x22)\\nexcept sqlite3.Error as e:\\n    res.append((type(e).__name__, str(e)))\\nout = res', g), g['out'])[1])({})" ; chx:output "[('Mango', None, 'tuxedo', None), ('OperationalError', 'table cats has 4 columns but 1 values were supplied'), ('OperationalError', '1 values for 2 columns'), ('IntegrityError', 'NOT NULL constraint failed: cats.name'), ('OperationalError', 'table cats has 5 columns but 4 values were supplied')]" .
chx:X_InsertColumnList rd:hasIOExample chx:IO_InsertColumnList .
chx:X_InsertMany a owl:NamedIndividual, chx:InsertMany ; rdfs:label "conn.executemany('INSERT INTO cats VALUES (?, ?, ?, ?)', rows)"@en ; skos:definition "executemany inserted three rows and reported rowcount 3, but when the second row of a second batch violated NOT NULL the first row stayed: the table held A, B, C and D, the rows before the error."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_InsertMany a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nrows = [(\\'A\\', \\'2020-01-01\\', \\'x\\', 1.0), (\\'B\\', \\'2020-01-02\\', \\'y\\', 2.0), (\\'C\\', \\'2020-01-03\\', \\'z\\', 3.0)]\\ncur = c.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', rows)\\nn = c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0]\\ntry:\\n    c.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'D\\', None, None, 4.0), (None, None, None, 5.0), (\\'E\\', None, None, 6.0)])\\nexcept sqlite3.IntegrityError as e:\\n    err = str(e)\\nout = (cur.rowcount, n, err, c.execute(\\'SELECT name FROM cats ORDER BY rowid\\').fetchall())', g), g['out'])[1])({}) evaluates to (3, 3, 'NOT NULL constraint failed: cats.name', [('A',), ('B',), ('C',), ('D',)])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nrows = [(\\'A\\', \\'2020-01-01\\', \\'x\\', 1.0), (\\'B\\', \\'2020-01-02\\', \\'y\\', 2.0), (\\'C\\', \\'2020-01-03\\', \\'z\\', 3.0)]\\ncur = c.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', rows)\\nn = c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0]\\ntry:\\n    c.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'D\\', None, None, 4.0), (None, None, None, 5.0), (\\'E\\', None, None, 6.0)])\\nexcept sqlite3.IntegrityError as e:\\n    err = str(e)\\nout = (cur.rowcount, n, err, c.execute(\\'SELECT name FROM cats ORDER BY rowid\\').fetchall())', g), g['out'])[1])({})" ; chx:output "(3, 3, 'NOT NULL constraint failed: cats.name', [('A',), ('B',), ('C',), ('D',)])" .
chx:X_InsertMany rd:hasIOExample chx:IO_InsertMany .
chx:X_UpdateDeleteWhere a owl:NamedIndividual, chx:UpdateDeleteWhere ; rdfs:label "UPDATE cats SET fur = 'gray tabby' WHERE rowid = 1"@en ; skos:definition "rowcount shows what a statement touched: UPDATE ... WHERE rowid = 1 changed 1 row, the same UPDATE by name changed 2 because two cats were named Zophie, WHERE 1 changed all 5, DELETE by name removed 1, DELETE ... WHERE 0 removed 0, and DELETE without a condition removed the remaining 4 and left the empty table in place."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_UpdateDeleteWhere a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Zophie\\', \\'2019-03-03\\', \\'brown\\', 4.9)\\x22)\\nres = []\\nres.append(c.execute(\\x22UPDATE cats SET fur = \\'gray tabby\\' WHERE rowid = 1\\x22).rowcount)\\nres.append(c.execute(\\x22UPDATE cats SET weight_kg = 6 WHERE name = \\'Zophie\\'\\x22).rowcount)\\nres.append(c.execute(\\x22UPDATE cats SET fur = \\'x\\' WHERE 1\\x22).rowcount)\\nres.append(c.execute(\\x22DELETE FROM cats WHERE name = \\'Toby\\'\\x22).rowcount)\\nres.append(c.execute(\\'DELETE FROM cats WHERE 0\\').rowcount)\\nres.append(c.execute(\\'DELETE FROM cats\\').rowcount)\\nout = (res, c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], c.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22).fetchall())', g), g['out'])[1])({}) evaluates to ([1, 2, 5, 1, 0, 4], 0, [('cats',)])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Zophie\\', \\'2019-03-03\\', \\'brown\\', 4.9)\\x22)\\nres = []\\nres.append(c.execute(\\x22UPDATE cats SET fur = \\'gray tabby\\' WHERE rowid = 1\\x22).rowcount)\\nres.append(c.execute(\\x22UPDATE cats SET weight_kg = 6 WHERE name = \\'Zophie\\'\\x22).rowcount)\\nres.append(c.execute(\\x22UPDATE cats SET fur = \\'x\\' WHERE 1\\x22).rowcount)\\nres.append(c.execute(\\x22DELETE FROM cats WHERE name = \\'Toby\\'\\x22).rowcount)\\nres.append(c.execute(\\'DELETE FROM cats WHERE 0\\').rowcount)\\nres.append(c.execute(\\'DELETE FROM cats\\').rowcount)\\nout = (res, c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], c.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22).fetchall())', g), g['out'])[1])({})" ; chx:output "([1, 2, 5, 1, 0, 4], 0, [('cats',)])" .
chx:X_UpdateDeleteWhere rd:hasIOExample chx:IO_UpdateDeleteWhere .
chx:X_ReturningAndLastrowid a owl:NamedIndividual, chx:ReturningAndLastrowid ; rdfs:label "INSERT INTO cats VALUES (...) RETURNING rowid"@en ; skos:definition "cursor.lastrowid gave the rowid of the row just inserted, 5, with rowcount 1; INSERT ... RETURNING rowid, name returned [(6, 'Sox')] in one call, and UPDATE ... RETURNING returned the two changed rows."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ReturningAndLastrowid a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\ncur = c.execute(\\x22INSERT INTO cats VALUES (\\'Mango\\', \\'2017-02-12\\', \\'tuxedo\\', 6.8)\\x22)\\nlast = (cur.lastrowid, cur.rowcount)\\nr = c.execute(\\x22INSERT INTO cats VALUES (\\'Sox\\', \\'2020-01-01\\', \\'white\\', 4.2) RETURNING rowid, name\\x22).fetchall()\\nout = (last, r, c.execute(\\x22UPDATE cats SET fur = \\'x\\' WHERE rowid <= 2 RETURNING rowid, fur\\x22).fetchall())', g), g['out'])[1])({}) evaluates to ((5, 1), [(6, 'Sox')], [(1, 'x'), (2, 'x')])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\ncur = c.execute(\\x22INSERT INTO cats VALUES (\\'Mango\\', \\'2017-02-12\\', \\'tuxedo\\', 6.8)\\x22)\\nlast = (cur.lastrowid, cur.rowcount)\\nr = c.execute(\\x22INSERT INTO cats VALUES (\\'Sox\\', \\'2020-01-01\\', \\'white\\', 4.2) RETURNING rowid, name\\x22).fetchall()\\nout = (last, r, c.execute(\\x22UPDATE cats SET fur = \\'x\\' WHERE rowid <= 2 RETURNING rowid, fur\\x22).fetchall())', g), g['out'])[1])({})" ; chx:output "((5, 1), [(6, 'Sox')], [(1, 'x'), (2, 'x')])" .
chx:X_ReturningAndLastrowid rd:hasIOExample chx:IO_ReturningAndLastrowid .
chx:X_QmarkPlaceholders a owl:NamedIndividual, chx:QmarkPlaceholders ; rdfs:label "conn.execute('INSERT INTO cats VALUES (?, ?, ?, ?)', [cat_name, cat_bday, fur_color, cat_weight])"@en ; skos:definition "Question marks bind values by position from a list or a tuple; too few values raised ProgrammingError (Incorrect number of bindings supplied. The current statement uses 2, and there are 1 supplied), a bare string 'black' was read as 5 values, a one-character string was accepted as one value, and a question mark cannot stand for a table name (near ?: syntax error)."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_QmarkPlaceholders a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nres = [c.execute(\\'SELECT name FROM cats WHERE fur = ? AND weight_kg > ?\\', [\\'black\\', 6]).fetchall(), c.execute(\\'SELECT name FROM cats WHERE fur = ?\\', (\\'black\\',)).fetchall()]\\nfor s, p in ((\\'SELECT name FROM cats WHERE fur = ? AND weight_kg > ?\\', [\\'black\\']), (\\'SELECT name FROM cats WHERE fur = ?\\', \\'black\\'), (\\'SELECT name FROM cats WHERE fur = ?\\', \\'b\\'), (\\'SELECT name FROM ?\\', [\\'cats\\'])):\\n    try:\\n        res.append(c.execute(s, p).fetchall())\\n    except sqlite3.Error as e:\\n        res.append((type(e).__name__, str(e)[:70]))\\nout = res', g), g['out'])[1])({}) evaluates to [[('Toby',)], [('Zophie',), ('Toby',)], ('ProgrammingError', 'Incorrect number of bindings supplied. The current statement uses 2, a'), ('ProgrammingError', 'Incorrect number of bindings supplied. The current statement uses 1, a'), [], ('OperationalError', 'near '?': syntax error')]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nres = [c.execute(\\'SELECT name FROM cats WHERE fur = ? AND weight_kg > ?\\', [\\'black\\', 6]).fetchall(), c.execute(\\'SELECT name FROM cats WHERE fur = ?\\', (\\'black\\',)).fetchall()]\\nfor s, p in ((\\'SELECT name FROM cats WHERE fur = ? AND weight_kg > ?\\', [\\'black\\']), (\\'SELECT name FROM cats WHERE fur = ?\\', \\'black\\'), (\\'SELECT name FROM cats WHERE fur = ?\\', \\'b\\'), (\\'SELECT name FROM ?\\', [\\'cats\\'])):\\n    try:\\n        res.append(c.execute(s, p).fetchall())\\n    except sqlite3.Error as e:\\n        res.append((type(e).__name__, str(e)[:70]))\\nout = res', g), g['out'])[1])({})" ; chx:output "[[('Toby',)], [('Zophie',), ('Toby',)], ('ProgrammingError', 'Incorrect number of bindings supplied. The current statement uses 2, a'), ('ProgrammingError', 'Incorrect number of bindings supplied. The current statement uses 1, a'), [], ('OperationalError', 'near '?': syntax error')]" .
chx:X_QmarkPlaceholders rd:hasIOExample chx:IO_QmarkPlaceholders .
chx:X_NamedPlaceholders a owl:NamedIndividual, chx:NamedPlaceholders ; rdfs:label "conn.execute('... WHERE fur = :fur', {'fur': 'black'})"@en ; skos:definition "A name after a colon binds from a dictionary, and the error for a missing key is specific: a dictionary without the key raised ProgrammingError with You did not supply a value for binding parameter :fur."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_NamedPlaceholders a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nres = [c.execute(\\'SELECT name FROM cats WHERE fur = :fur AND weight_kg > :w\\', {\\'fur\\': \\'black\\', \\'w\\': 6}).fetchall()]\\ntry:\\n    c.execute(\\'SELECT name FROM cats WHERE fur = :fur\\', {\\'color\\': \\'black\\'})\\nexcept sqlite3.ProgrammingError as e:\\n    res.append(str(e)[:60])\\nout = res', g), g['out'])[1])({}) evaluates to [[('Toby',)], 'You did not supply a value for binding parameter :fur.']"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nres = [c.execute(\\'SELECT name FROM cats WHERE fur = :fur AND weight_kg > :w\\', {\\'fur\\': \\'black\\', \\'w\\': 6}).fetchall()]\\ntry:\\n    c.execute(\\'SELECT name FROM cats WHERE fur = :fur\\', {\\'color\\': \\'black\\'})\\nexcept sqlite3.ProgrammingError as e:\\n    res.append(str(e)[:60])\\nout = res', g), g['out'])[1])({})" ; chx:output "[[('Toby',)], 'You did not supply a value for binding parameter :fur.']" .
chx:X_NamedPlaceholders rd:hasIOExample chx:IO_NamedPlaceholders .
chx:X_SqlInjection a owl:NamedIndividual, chx:SqlInjection ; rdfs:label "f'... WHERE name = '{name}''"@en ; skos:definition "Pasting x' OR '1'='1 into the query text with an f-string returned all 4 rows, binding the same text returned 0, a second statement after a semicolon was refused by execute with You can only execute one statement at a time, and the table survived."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SqlInjection a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nname = \\x22x\\' OR \\'1\\'=\\'1\\x22\\nbad = c.execute(f\\x22SELECT name FROM cats WHERE name = \\'{name}\\'\\x22).fetchall()\\ngood = c.execute(\\'SELECT name FROM cats WHERE name = ?\\', [name]).fetchall()\\nevil = \\x22x\\'; DROP TABLE cats; --\\x22\\ntry:\\n    c.execute(f\\x22SELECT * FROM cats WHERE name = \\'{evil}\\'\\x22)\\n    stacked = \\'ran\\'\\nexcept sqlite3.ProgrammingError as e:\\n    stacked = str(e)\\nout = (len(bad), len(good), stacked, c.execute(\\x22SELECT count(*) FROM sqlite_schema WHERE name = \\'cats\\'\\x22).fetchone()[0], c.executescript(\\'SELECT 1; SELECT 2;\\').__class__.__name__)', g), g['out'])[1])({}) evaluates to (4, 0, 'You can only execute one statement at a time.', 1, 'Cursor')"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nname = \\x22x\\' OR \\'1\\'=\\'1\\x22\\nbad = c.execute(f\\x22SELECT name FROM cats WHERE name = \\'{name}\\'\\x22).fetchall()\\ngood = c.execute(\\'SELECT name FROM cats WHERE name = ?\\', [name]).fetchall()\\nevil = \\x22x\\'; DROP TABLE cats; --\\x22\\ntry:\\n    c.execute(f\\x22SELECT * FROM cats WHERE name = \\'{evil}\\'\\x22)\\n    stacked = \\'ran\\'\\nexcept sqlite3.ProgrammingError as e:\\n    stacked = str(e)\\nout = (len(bad), len(good), stacked, c.execute(\\x22SELECT count(*) FROM sqlite_schema WHERE name = \\'cats\\'\\x22).fetchone()[0], c.executescript(\\'SELECT 1; SELECT 2;\\').__class__.__name__)', g), g['out'])[1])({})" ; chx:output "(4, 0, 'You can only execute one statement at a time.', 1, 'Cursor')" .
chx:X_SqlInjection rd:hasIOExample chx:IO_SqlInjection .
chx:X_FetchMethods a owl:NamedIndividual, chx:FetchMethods ; rdfs:label "cur.fetchall(), cur.fetchone(), cur.fetchmany(2), for row in cur"@en ; skos:definition "fetchone returned the next row as a tuple, fetchmany(2) the next two as a list, fetchall the rest, and fetchone None once the cursor was exhausted; iterating the cursor gave the same names, an exhausted cursor returned [], rowcount for a SELECT was -1 and description held the column names."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_FetchMethods a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\ncur = c.execute(\\'SELECT name FROM cats ORDER BY rowid\\')\\nres = [cur.fetchone(), cur.fetchmany(2), cur.fetchall(), cur.fetchone()]\\ncur = c.execute(\\'SELECT name FROM cats ORDER BY rowid\\')\\nnames = [row[0] for row in cur]\\nout = (res, names, cur.fetchall(), cur.rowcount, [d[0] for d in cur.description])', g), g['out'])[1])({}) evaluates to ([('Zophie',), [('Miguel',), ('Jacob',)], [('Toby',)], None], ['Zophie', 'Miguel', 'Jacob', 'Toby'], [], -1, ['name'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\ncur = c.execute(\\'SELECT name FROM cats ORDER BY rowid\\')\\nres = [cur.fetchone(), cur.fetchmany(2), cur.fetchall(), cur.fetchone()]\\ncur = c.execute(\\'SELECT name FROM cats ORDER BY rowid\\')\\nnames = [row[0] for row in cur]\\nout = (res, names, cur.fetchall(), cur.rowcount, [d[0] for d in cur.description])', g), g['out'])[1])({})" ; chx:output "([('Zophie',), [('Miguel',), ('Jacob',)], [('Toby',)], None], ['Zophie', 'Miguel', 'Jacob', 'Toby'], [], -1, ['name'])" .
chx:X_FetchMethods rd:hasIOExample chx:IO_FetchMethods .
chx:X_WhereOperators a owl:NamedIndividual, chx:WhereOperators ; rdfs:label "WHERE fur = 'black' OR birthdate >= '2024-01-01'"@en ; skos:definition "SQLite accepts both = and == and both <> and !=, compares text case-sensitively by default ('a' = 'A' is 0), treats BETWEEN as inclusive and combines tests with AND, OR and NOT; with the four cats the filter fur = 'black' OR birthdate >= '2022-01-01' returned Zophie, Jacob and Toby."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_WhereOperators a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nres = c.execute(\\x22SELECT 1 = 1, 1 == 1, 1 <> 2, 1 != 2, \\'a\\' = \\'A\\', NOT 0, 1 AND 0, 1 OR 0, 5 BETWEEN 3 AND 5, \\'b\\' IN (\\'a\\', \\'b\\')\\x22).fetchone()\\nq = lambda w: [r[0] for r in c.execute(\\'SELECT name FROM cats WHERE \\' + w + \\' ORDER BY rowid\\')]\\nout = (res, q(\\x22fur = \\'black\\' OR birthdate >= \\'2022-01-01\\'\\x22), q(\\x22fur = \\'black\\' AND weight_kg > 6\\x22), q(\\x22NOT fur = \\'black\\'\\x22), q(\\x22birthdate >= \\'2021-01-01\\' AND birthdate < \\'2022-01-01\\'\\x22))', g), g['out'])[1])({}) evaluates to ((1, 1, 1, 1, 0, 1, 0, 1, 1, 1), ['Zophie', 'Jacob', 'Toby'], ['Toby'], ['Miguel', 'Jacob'], ['Zophie', 'Toby'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nres = c.execute(\\x22SELECT 1 = 1, 1 == 1, 1 <> 2, 1 != 2, \\'a\\' = \\'A\\', NOT 0, 1 AND 0, 1 OR 0, 5 BETWEEN 3 AND 5, \\'b\\' IN (\\'a\\', \\'b\\')\\x22).fetchone()\\nq = lambda w: [r[0] for r in c.execute(\\'SELECT name FROM cats WHERE \\' + w + \\' ORDER BY rowid\\')]\\nout = (res, q(\\x22fur = \\'black\\' OR birthdate >= \\'2022-01-01\\'\\x22), q(\\x22fur = \\'black\\' AND weight_kg > 6\\x22), q(\\x22NOT fur = \\'black\\'\\x22), q(\\x22birthdate >= \\'2021-01-01\\' AND birthdate < \\'2022-01-01\\'\\x22))', g), g['out'])[1])({})" ; chx:output "((1, 1, 1, 1, 0, 1, 0, 1, 1, 1), ['Zophie', 'Jacob', 'Toby'], ['Toby'], ['Miguel', 'Jacob'], ['Zophie', 'Toby'])" .
chx:X_WhereOperators rd:hasIOExample chx:IO_WhereOperators .
chx:X_DoubleQuotedStrings a owl:NamedIndividual, chx:DoubleQuotedStrings ; rdfs:label "WHERE fur = 'black'"@en ; skos:definition "Double quotes work as text only when no column has that name: fur = 'black' matched the same Zophie and Toby as 'black', but fur = 'fur' matched all 4 rows because it compared the column with itself, and SELECT 'no such column' returned the text because no column has that name."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DoubleQuotedStrings a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nq = lambda w: [r[0] for r in c.execute(\\'SELECT name FROM cats WHERE \\' + w)]\\nout = (q(\\'fur = \\\\x22black\\\\x22\\'), q(\\x22fur = \\'black\\'\\x22), q(\\'fur = \\\\x22fur\\\\x22\\'), q(\\x22fur = \\'fur\\'\\x22), c.execute(\\'SELECT \\\\x22no such column\\\\x22\\').fetchall(), [o[0] for o in c.execute(\\'PRAGMA compile_options\\') if \\'DQS\\' in o[0]])', g), g['out'])[1])({}) evaluates to (['Zophie', 'Toby'], ['Zophie', 'Toby'], ['Zophie', 'Miguel', 'Jacob', 'Toby'], [], [('no such column',)], [])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nq = lambda w: [r[0] for r in c.execute(\\'SELECT name FROM cats WHERE \\' + w)]\\nout = (q(\\'fur = \\\\x22black\\\\x22\\'), q(\\x22fur = \\'black\\'\\x22), q(\\'fur = \\\\x22fur\\\\x22\\'), q(\\x22fur = \\'fur\\'\\x22), c.execute(\\'SELECT \\\\x22no such column\\\\x22\\').fetchall(), [o[0] for o in c.execute(\\'PRAGMA compile_options\\') if \\'DQS\\' in o[0]])', g), g['out'])[1])({})" ; chx:output "(['Zophie', 'Toby'], ['Zophie', 'Toby'], ['Zophie', 'Miguel', 'Jacob', 'Toby'], [], [('no such column',)], [])" .
chx:X_DoubleQuotedStrings rd:hasIOExample chx:IO_DoubleQuotedStrings .
chx:X_LikeAndGlob a owl:NamedIndividual, chx:LikeAndGlob ; rdfs:label "name LIKE '%y'; name GLOB '*m*'"@en ; skos:definition "LIKE is case-insensitive for ASCII only and GLOB is case-sensitive: name LIKE '%y' returned Toby, Mandy and Mitsy, LIKE '%OB%' returned Toby and Jacob, GLOB '*m*' returned Sam, Cinnamon, Thomas and Émile, GLOB '*M*' returned Mandy and Mitsy, and LIKE 'é%' found élan and not Émile."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_LikeAndGlob a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE n (name TEXT)\\')\\nc.executemany(\\'INSERT INTO n VALUES (?)\\', [(\\'Toby\\',), (\\'Mandy\\',), (\\'Sam\\',), (\\'Cinnamon\\',), (\\'Thomas\\',), (\\'Mitsy\\',), (\\'\\\\u00c9mile\\',), (\\'\\\\u00e9lan\\',), (\\'Jacob\\',), (\\'50%\\',)])\\nq = lambda w, p=(): [r[0] for r in c.execute(\\'SELECT name FROM n WHERE \\' + w, p)]\\nout = (q(\\x22name LIKE \\'%y\\'\\x22), q(\\x22name LIKE \\'Ja%\\'\\x22), q(\\x22name LIKE \\'%OB%\\'\\x22), q(\\x22name GLOB \\'*m*\\'\\x22), q(\\x22name GLOB \\'*M*\\'\\x22), q(\\x22name LIKE \\'\\\\u00e9%\\'\\x22), q(\\x22name LIKE \\'5!%\\' ESCAPE \\'!\\'\\x22), q(\\x22name LIKE \\'5%\\'\\x22))', g), g['out'])[1])({}) evaluates to (['Toby', 'Mandy', 'Mitsy'], ['Jacob'], ['Toby', 'Jacob'], ['Sam', 'Cinnamon', 'Thomas', 'Émile'], ['Mandy', 'Mitsy'], ['élan'], [], ['50%'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\')\\nc.execute(\\'CREATE TABLE n (name TEXT)\\')\\nc.executemany(\\'INSERT INTO n VALUES (?)\\', [(\\'Toby\\',), (\\'Mandy\\',), (\\'Sam\\',), (\\'Cinnamon\\',), (\\'Thomas\\',), (\\'Mitsy\\',), (\\'\\\\u00c9mile\\',), (\\'\\\\u00e9lan\\',), (\\'Jacob\\',), (\\'50%\\',)])\\nq = lambda w, p=(): [r[0] for r in c.execute(\\'SELECT name FROM n WHERE \\' + w, p)]\\nout = (q(\\x22name LIKE \\'%y\\'\\x22), q(\\x22name LIKE \\'Ja%\\'\\x22), q(\\x22name LIKE \\'%OB%\\'\\x22), q(\\x22name GLOB \\'*m*\\'\\x22), q(\\x22name GLOB \\'*M*\\'\\x22), q(\\x22name LIKE \\'\\\\u00e9%\\'\\x22), q(\\x22name LIKE \\'5!%\\' ESCAPE \\'!\\'\\x22), q(\\x22name LIKE \\'5%\\'\\x22))', g), g['out'])[1])({})" ; chx:output "(['Toby', 'Mandy', 'Mitsy'], ['Jacob'], ['Toby', 'Jacob'], ['Sam', 'Cinnamon', 'Thomas', 'Émile'], ['Mandy', 'Mitsy'], ['élan'], [], ['50%'])" .
chx:X_LikeAndGlob rd:hasIOExample chx:IO_LikeAndGlob .
chx:X_OrderByLimit a owl:NamedIndividual, chx:OrderByLimit ; rdfs:label "SELECT * FROM cats WHERE fur='orange' ORDER BY birthdate LIMIT 4"@en ; skos:definition "ORDER BY sorts by the first column and then by the next, DESC reverses one column, and LIMIT with OFFSET takes a window: on seven cats ORDER BY fur, birthdate began with Zophie and Toby, ORDER BY weight_kg DESC, name LIMIT 3 gave Mittens, Toby and Miguel, LIMIT 2 OFFSET 2 over the names gave Misty and Mittens, and LIMIT 3 equalled the first three rows of fetchall."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_OrderByLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Piers\\', \\'2014-07-08\\', \\'orange\\', 5.2)\\x22); c.execute(\\x22INSERT INTO cats VALUES (\\'Mittens\\', \\'2013-07-03\\', \\'orange\\', 7.4)\\x22); c.execute(\\x22INSERT INTO cats VALUES (\\'Misty\\', \\'2016-07-08\\', \\'orange\\', 5.2)\\x22)\\nq = lambda s: [r[0] for r in c.execute(s)]\\nout = (q(\\'SELECT name FROM cats ORDER BY fur, birthdate\\'), q(\\'SELECT name FROM cats ORDER BY fur ASC, birthdate DESC\\'), q(\\'SELECT name FROM cats ORDER BY weight_kg DESC, name LIMIT 3\\'), q(\\'SELECT name FROM cats ORDER BY name LIMIT 2 OFFSET 2\\'), q(\\x22SELECT name FROM cats WHERE fur = \\'orange\\' ORDER BY birthdate LIMIT 2\\x22), [r[0] for r in c.execute(\\'SELECT name FROM cats\\').fetchall()[:3]] == q(\\'SELECT name FROM cats LIMIT 3\\'))', g), g['out'])[1])({}) evaluates to (['Zophie', 'Toby', 'Mittens', 'Piers', 'Misty', 'Jacob', 'Miguel'], ['Toby', 'Zophie', 'Misty', 'Piers', 'Mittens', 'Jacob', 'Miguel'], ['Mittens', 'Toby', 'Miguel'], ['Misty', 'Mittens'], ['Mittens', 'Piers'], True)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Piers\\', \\'2014-07-08\\', \\'orange\\', 5.2)\\x22); c.execute(\\x22INSERT INTO cats VALUES (\\'Mittens\\', \\'2013-07-03\\', \\'orange\\', 7.4)\\x22); c.execute(\\x22INSERT INTO cats VALUES (\\'Misty\\', \\'2016-07-08\\', \\'orange\\', 5.2)\\x22)\\nq = lambda s: [r[0] for r in c.execute(s)]\\nout = (q(\\'SELECT name FROM cats ORDER BY fur, birthdate\\'), q(\\'SELECT name FROM cats ORDER BY fur ASC, birthdate DESC\\'), q(\\'SELECT name FROM cats ORDER BY weight_kg DESC, name LIMIT 3\\'), q(\\'SELECT name FROM cats ORDER BY name LIMIT 2 OFFSET 2\\'), q(\\x22SELECT name FROM cats WHERE fur = \\'orange\\' ORDER BY birthdate LIMIT 2\\x22), [r[0] for r in c.execute(\\'SELECT name FROM cats\\').fetchall()[:3]] == q(\\'SELECT name FROM cats LIMIT 3\\'))', g), g['out'])[1])({})" ; chx:output "(['Zophie', 'Toby', 'Mittens', 'Piers', 'Misty', 'Jacob', 'Miguel'], ['Toby', 'Zophie', 'Misty', 'Piers', 'Mittens', 'Jacob', 'Miguel'], ['Mittens', 'Toby', 'Miguel'], ['Misty', 'Mittens'], ['Mittens', 'Piers'], True)" .
chx:X_OrderByLimit rd:hasIOExample chx:IO_OrderByLimit .
chx:X_NullComparison a owl:NamedIndividual, chx:NullComparison ; rdfs:label "WHERE fur = NULL"@en ; skos:definition "NULL is not equal to anything, including NULL: fur = NULL matched no row, fur != 'black' skipped the cat with no fur, fur IS NULL found it, NULL = NULL gave None, 1 + NULL gave None, count(*) counted 5 rows where count(fur) counted 4, and ORDER BY fur put the NULL first."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_NullComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\x22INSERT INTO cats (name) VALUES (\\'Ghost\\')\\x22)\\nq = lambda w: [r[0] for r in c.execute(\\'SELECT name FROM cats WHERE \\' + w)]\\nout = (q(\\'fur = NULL\\'), q(\\'fur != \\\\\\'black\\\\\\'\\'), q(\\'fur IS NULL\\'), q(\\'fur IS NOT \\\\\\'black\\\\\\'\\'), c.execute(\\'SELECT NULL = NULL, NULL IS NULL, 1 + NULL, count(*), count(fur) FROM cats\\').fetchone(), [r[0] for r in c.execute(\\'SELECT fur FROM cats ORDER BY fur LIMIT 2\\')])', g), g['out'])[1])({}) evaluates to ([], ['Miguel', 'Jacob'], ['Ghost'], ['Miguel', 'Jacob', 'Ghost'], (None, 1, None, 5, 4), [None, 'black'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\x22INSERT INTO cats (name) VALUES (\\'Ghost\\')\\x22)\\nq = lambda w: [r[0] for r in c.execute(\\'SELECT name FROM cats WHERE \\' + w)]\\nout = (q(\\'fur = NULL\\'), q(\\'fur != \\\\\\'black\\\\\\'\\'), q(\\'fur IS NULL\\'), q(\\'fur IS NOT \\\\\\'black\\\\\\'\\'), c.execute(\\'SELECT NULL = NULL, NULL IS NULL, 1 + NULL, count(*), count(fur) FROM cats\\').fetchone(), [r[0] for r in c.execute(\\'SELECT fur FROM cats ORDER BY fur LIMIT 2\\')])', g), g['out'])[1])({})" ; chx:output "([], ['Miguel', 'Jacob'], ['Ghost'], ['Miguel', 'Jacob', 'Ghost'], (None, 1, None, 5, 4), [None, 'black'])" .
chx:X_NullComparison rd:hasIOExample chx:IO_NullComparison .
chx:X_RowFactory a owl:NamedIndividual, chx:RowFactory ; rdfs:label "conn.row_factory = sqlite3.Row"@en ; skos:definition "Setting conn.row_factory = sqlite3.Row lets a program read a column by name, r['name'], by position, r[1], list its keys and turn the row into a dict, instead of counting tuple positions as the chapter does."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_RowFactory a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.row_factory = sqlite3.Row\\nr = c.execute(\\'SELECT rowid AS id, name, weight_kg FROM cats ORDER BY rowid\\').fetchone()\\nout = (type(r).__name__, r[\\'name\\'], r[1], r.keys(), tuple(r), r[\\'id\\'], dict(r))', g), g['out'])[1])({}) evaluates to ('Row', 'Zophie', 'Zophie', ['id', 'name', 'weight_kg'], (1, 'Zophie', 5.6), 1, {'id': 1, 'name': 'Zophie', 'weight_kg': 5.6})"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.row_factory = sqlite3.Row\\nr = c.execute(\\'SELECT rowid AS id, name, weight_kg FROM cats ORDER BY rowid\\').fetchone()\\nout = (type(r).__name__, r[\\'name\\'], r[1], r.keys(), tuple(r), r[\\'id\\'], dict(r))', g), g['out'])[1])({})" ; chx:output "('Row', 'Zophie', 'Zophie', ['id', 'name', 'weight_kg'], (1, 'Zophie', 5.6), 1, {'id': 1, 'name': 'Zophie', 'weight_kg': 5.6})" .
chx:X_RowFactory rd:hasIOExample chx:IO_RowFactory .
chx:X_CreateIndexPlan a owl:NamedIndividual, chx:CreateIndexPlan ; rdfs:label "CREATE INDEX idx_name ON cats (name)"@en ; skos:definition "EXPLAIN QUERY PLAN showed SCAN cats before CREATE INDEX idx_name and SEARCH cats USING INDEX idx_name (name=?) after it, a second index on another column with the same name was refused with index idx_name already exists, and sqlite_schema listed the two indexes in creation order, idx_name and idx_birthdate."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_CreateIndexPlan a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'n%d\\' % i, \\'2020-01-01\\', \\'x\\', 1.0) for i in range(2000)])\\nplan = lambda: [r[3] for r in c.execute(\\x22EXPLAIN QUERY PLAN SELECT * FROM cats WHERE name = \\'n5\\'\\x22)]\\nbefore = plan()\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\'); c.execute(\\'CREATE INDEX idx_birthdate ON cats (birthdate)\\')\\ntry:\\n    c.execute(\\'CREATE INDEX idx_name ON cats (fur)\\')\\nexcept sqlite3.OperationalError as e:\\n    dup = str(e)\\nout = (before, plan(), dup, [r[0] for r in c.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'index\\' AND tbl_name = \\'cats\\'\\x22)])', g), g['out'])[1])({}) evaluates to (['SCAN cats'], ['SEARCH cats USING INDEX idx_name (name=?)'], 'index idx_name already exists', ['idx_name', 'idx_birthdate'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'n%d\\' % i, \\'2020-01-01\\', \\'x\\', 1.0) for i in range(2000)])\\nplan = lambda: [r[3] for r in c.execute(\\x22EXPLAIN QUERY PLAN SELECT * FROM cats WHERE name = \\'n5\\'\\x22)]\\nbefore = plan()\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\'); c.execute(\\'CREATE INDEX idx_birthdate ON cats (birthdate)\\')\\ntry:\\n    c.execute(\\'CREATE INDEX idx_name ON cats (fur)\\')\\nexcept sqlite3.OperationalError as e:\\n    dup = str(e)\\nout = (before, plan(), dup, [r[0] for r in c.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'index\\' AND tbl_name = \\'cats\\'\\x22)])', g), g['out'])[1])({})" ; chx:output "(['SCAN cats'], ['SEARCH cats USING INDEX idx_name (name=?)'], 'index idx_name already exists', ['idx_name', 'idx_birthdate'])" .
chx:X_CreateIndexPlan rd:hasIOExample chx:IO_CreateIndexPlan .
chx:X_LikeAndIndex a owl:NamedIndividual, chx:LikeAndIndex ; rdfs:label "EXPLAIN QUERY PLAN SELECT * FROM cats WHERE name LIKE 'Ma%'"@en ; skos:definition "An index on name served name = 'Mango' (SEARCH ... USING INDEX idx_name (name=?)), name GLOB 'Ma*' and the range name >= 'Ma' AND name < 'Mb', but not name LIKE 'Ma%' or name LIKE '%ango', which both scanned the whole table."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_LikeAndIndex a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\')\\nplan = lambda w: [r[3] for r in c.execute(\\'EXPLAIN QUERY PLAN SELECT * FROM cats WHERE \\' + w)]\\nout = (plan(\\x22name = \\'Mango\\'\\x22), plan(\\x22name LIKE \\'Ma%\\'\\x22), plan(\\x22name GLOB \\'Ma*\\'\\x22), plan(\\x22name >= \\'Ma\\' AND name < \\'Mb\\'\\x22), plan(\\x22name LIKE \\'%ango\\'\\x22))', g), g['out'])[1])({}) evaluates to (['SEARCH cats USING INDEX idx_name (name=?)'], ['SCAN cats'], ['SEARCH cats USING INDEX idx_name (name>? AND name<?)'], ['SEARCH cats USING INDEX idx_name (name>? AND name<?)'], ['SCAN cats'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\')\\nplan = lambda w: [r[3] for r in c.execute(\\'EXPLAIN QUERY PLAN SELECT * FROM cats WHERE \\' + w)]\\nout = (plan(\\x22name = \\'Mango\\'\\x22), plan(\\x22name LIKE \\'Ma%\\'\\x22), plan(\\x22name GLOB \\'Ma*\\'\\x22), plan(\\x22name >= \\'Ma\\' AND name < \\'Mb\\'\\x22), plan(\\x22name LIKE \\'%ango\\'\\x22))', g), g['out'])[1])({})" ; chx:output "(['SEARCH cats USING INDEX idx_name (name=?)'], ['SCAN cats'], ['SEARCH cats USING INDEX idx_name (name>? AND name<?)'], ['SEARCH cats USING INDEX idx_name (name>? AND name<?)'], ['SCAN cats'])" .
chx:X_LikeAndIndex rd:hasIOExample chx:IO_LikeAndIndex .
chx:X_BeginCommitRollback a owl:NamedIndividual, chx:BeginCommitRollback ; rdfs:label "conn.execute('BEGIN'); ...; conn.rollback()"@en ; skos:definition "With isolation_level=None, BEGIN, two INSERTs and rollback() left no trace (the count of Socks and Fluffy was 0 and in_transaction was False), BEGIN with commit() kept both, DDL was rolled back too (CREATE TABLE tmp and DROP TABLE cats were undone, leaving cats), and a rollback() after a lone INSERT undid nothing because the INSERT had already committed."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_BeginCommitRollback a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nres = []\\nc.execute(\\'BEGIN\\')\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Socks\\', \\'2022-04-04\\', \\'white\\', 4.2)\\x22); c.execute(\\x22INSERT INTO cats VALUES (\\'Fluffy\\', \\'2022-10-30\\', \\'gray\\', 4.5)\\x22)\\nres.append((c.in_transaction, c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0]))\\nc.rollback()\\nres.append((c.in_transaction, c.execute(\\x22SELECT count(*) FROM cats WHERE name IN (\\'Socks\\', \\'Fluffy\\')\\x22).fetchone()[0]))\\nc.execute(\\'BEGIN\\')\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Socks\\', \\'2022-04-04\\', \\'white\\', 4.2)\\x22); c.execute(\\x22INSERT INTO cats VALUES (\\'Fluffy\\', \\'2022-10-30\\', \\'gray\\', 4.5)\\x22)\\nc.commit()\\nres.append((c.in_transaction, c.execute(\\x22SELECT count(*) FROM cats WHERE name IN (\\'Socks\\', \\'Fluffy\\')\\x22).fetchone()[0]))\\nc.execute(\\'BEGIN\\'); c.execute(\\'CREATE TABLE tmp (a)\\'); c.execute(\\'DROP TABLE cats\\'); c.rollback()\\nres.append(c.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22).fetchall())\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Auto\\', \\'2022-01-01\\', \\'x\\', 1)\\x22); c.rollback()\\nres.append(c.execute(\\x22SELECT count(*) FROM cats WHERE name = \\'Auto\\'\\x22).fetchone()[0])\\nout = res', g), g['out'])[1])({}) evaluates to [(True, 6), (False, 0), (False, 2), [('cats',)], 1]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nres = []\\nc.execute(\\'BEGIN\\')\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Socks\\', \\'2022-04-04\\', \\'white\\', 4.2)\\x22); c.execute(\\x22INSERT INTO cats VALUES (\\'Fluffy\\', \\'2022-10-30\\', \\'gray\\', 4.5)\\x22)\\nres.append((c.in_transaction, c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0]))\\nc.rollback()\\nres.append((c.in_transaction, c.execute(\\x22SELECT count(*) FROM cats WHERE name IN (\\'Socks\\', \\'Fluffy\\')\\x22).fetchone()[0]))\\nc.execute(\\'BEGIN\\')\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Socks\\', \\'2022-04-04\\', \\'white\\', 4.2)\\x22); c.execute(\\x22INSERT INTO cats VALUES (\\'Fluffy\\', \\'2022-10-30\\', \\'gray\\', 4.5)\\x22)\\nc.commit()\\nres.append((c.in_transaction, c.execute(\\x22SELECT count(*) FROM cats WHERE name IN (\\'Socks\\', \\'Fluffy\\')\\x22).fetchone()[0]))\\nc.execute(\\'BEGIN\\'); c.execute(\\'CREATE TABLE tmp (a)\\'); c.execute(\\'DROP TABLE cats\\'); c.rollback()\\nres.append(c.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22).fetchall())\\nc.execute(\\x22INSERT INTO cats VALUES (\\'Auto\\', \\'2022-01-01\\', \\'x\\', 1)\\x22); c.rollback()\\nres.append(c.execute(\\x22SELECT count(*) FROM cats WHERE name = \\'Auto\\'\\x22).fetchone()[0])\\nout = res', g), g['out'])[1])({})" ; chx:output "[(True, 6), (False, 0), (False, 2), [('cats',)], 1]" .
chx:X_BeginCommitRollback rd:hasIOExample chx:IO_BeginCommitRollback .
chx:X_LegacyAutocommit a owl:NamedIndividual, chx:LegacyAutocommit ; rdfs:label "sqlite3.connect(..., isolation_level=None)"@en ; skos:definition "In the legacy mode, which is the default, isolation_level reads as the empty string and in_transaction became True after an INSERT but stayed False after a CREATE TABLE, so a rollback() removed the inserted row; with isolation_level=None an INSERT is committed at once (in_transaction False) and only an explicit BEGIN opens a transaction."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_LegacyAutocommit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\ndef mk(**kw):\\n    for f in os.listdir(\\'.\\'): os.remove(f)\\n    c = sqlite3.connect(\\'t.db\\', **kw); c.execute(\\'CREATE TABLE t (a INTEGER)\\'); c.commit(); return c\\nres = []\\nc = mk(); res.append((repr(c.isolation_level), c.autocommit))\\nc.execute(\\'INSERT INTO t VALUES (1)\\'); a = c.in_transaction; c.execute(\\'SELECT * FROM t\\'); c.rollback()\\nc.execute(\\'CREATE TABLE u (a)\\'); b = c.in_transaction\\nres.append((\\'default: after INSERT\\', a, \\'after rollback rows\\', c.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], \\'after CREATE\\', b)); c.close()\\nd = mk(isolation_level=None); res.append((repr(d.isolation_level), d.autocommit))\\nd.execute(\\'INSERT INTO t VALUES (1)\\'); a = d.in_transaction; d.rollback()\\nres.append((\\'None: after INSERT\\', a, \\'after rollback rows\\', d.execute(\\'SELECT count(*) FROM t\\').fetchone()[0]))\\nd.execute(\\'BEGIN\\'); d.execute(\\'INSERT INTO t VALUES (2)\\'); a = d.in_transaction; d.rollback()\\nres.append((\\'None: after BEGIN+INSERT\\', a, \\'after rollback rows\\', d.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], d.in_transaction))\\nout = res', g), g['out'])[1])({}) evaluates to [('''', -1), ('default: after INSERT', True, 'after rollback rows', 0, 'after CREATE', False), ('None', -1), ('None: after INSERT', False, 'after rollback rows', 1), ('None: after BEGIN+INSERT', True, 'after rollback rows', 1, False)]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\ndef mk(**kw):\\n    for f in os.listdir(\\'.\\'): os.remove(f)\\n    c = sqlite3.connect(\\'t.db\\', **kw); c.execute(\\'CREATE TABLE t (a INTEGER)\\'); c.commit(); return c\\nres = []\\nc = mk(); res.append((repr(c.isolation_level), c.autocommit))\\nc.execute(\\'INSERT INTO t VALUES (1)\\'); a = c.in_transaction; c.execute(\\'SELECT * FROM t\\'); c.rollback()\\nc.execute(\\'CREATE TABLE u (a)\\'); b = c.in_transaction\\nres.append((\\'default: after INSERT\\', a, \\'after rollback rows\\', c.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], \\'after CREATE\\', b)); c.close()\\nd = mk(isolation_level=None); res.append((repr(d.isolation_level), d.autocommit))\\nd.execute(\\'INSERT INTO t VALUES (1)\\'); a = d.in_transaction; d.rollback()\\nres.append((\\'None: after INSERT\\', a, \\'after rollback rows\\', d.execute(\\'SELECT count(*) FROM t\\').fetchone()[0]))\\nd.execute(\\'BEGIN\\'); d.execute(\\'INSERT INTO t VALUES (2)\\'); a = d.in_transaction; d.rollback()\\nres.append((\\'None: after BEGIN+INSERT\\', a, \\'after rollback rows\\', d.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], d.in_transaction))\\nout = res', g), g['out'])[1])({})" ; chx:output "[('''', -1), ('default: after INSERT', True, 'after rollback rows', 0, 'after CREATE', False), ('None', -1), ('None: after INSERT', False, 'after rollback rows', 1), ('None: after BEGIN+INSERT', True, 'after rollback rows', 1, False)]" .
chx:X_LegacyAutocommit rd:hasIOExample chx:IO_LegacyAutocommit .
chx:X_AutocommitAttribute a owl:NamedIndividual, chx:AutocommitAttribute ; rdfs:label "sqlite3.connect(..., autocommit=True)"@en ; skos:definition "Connection.autocommit changes what commit() and rollback() do: with autocommit=False a transaction is open from the start, rollback() undid the INSERT and a new transaction opened at once, and BEGIN was refused with cannot start a transaction within a transaction; with autocommit=True the INSERT was committed immediately and rollback() did nothing, even after an explicit BEGIN, so the second row stayed."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_AutocommitAttribute a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\ndef mk(**kw):\\n    for f in os.listdir(\\'.\\'): os.remove(f)\\n    c = sqlite3.connect(\\'t.db\\', **kw); c.execute(\\'CREATE TABLE t (a INTEGER)\\'); c.commit(); return c\\nres = {}\\nfor mode in (False, True):\\n    c = mk(autocommit=mode); r = [c.autocommit, c.in_transaction]\\n    c.execute(\\'INSERT INTO t VALUES (1)\\'); r.append(c.in_transaction); c.rollback(); r.append(c.execute(\\'SELECT count(*) FROM t\\').fetchone()[0])\\n    try:\\n        c.execute(\\'BEGIN\\')\\n    except sqlite3.OperationalError as e:\\n        r.append(str(e))\\n    c.execute(\\'INSERT INTO t VALUES (2)\\'); c.rollback(); r.append((c.in_transaction, c.execute(\\'SELECT count(*) FROM t\\').fetchone()[0]))\\n    c.execute(\\'ROLLBACK\\') if c.in_transaction else None\\n    res[mode] = r\\nout = (res, sqlite3.LEGACY_TRANSACTION_CONTROL)', g), g['out'])[1])({}) evaluates to ({False: [False, True, True, 0, 'cannot start a transaction within a transaction', (True, 0)], True: [True, False, False, 1, (True, 2)]}, -1)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\ndef mk(**kw):\\n    for f in os.listdir(\\'.\\'): os.remove(f)\\n    c = sqlite3.connect(\\'t.db\\', **kw); c.execute(\\'CREATE TABLE t (a INTEGER)\\'); c.commit(); return c\\nres = {}\\nfor mode in (False, True):\\n    c = mk(autocommit=mode); r = [c.autocommit, c.in_transaction]\\n    c.execute(\\'INSERT INTO t VALUES (1)\\'); r.append(c.in_transaction); c.rollback(); r.append(c.execute(\\'SELECT count(*) FROM t\\').fetchone()[0])\\n    try:\\n        c.execute(\\'BEGIN\\')\\n    except sqlite3.OperationalError as e:\\n        r.append(str(e))\\n    c.execute(\\'INSERT INTO t VALUES (2)\\'); c.rollback(); r.append((c.in_transaction, c.execute(\\'SELECT count(*) FROM t\\').fetchone()[0]))\\n    c.execute(\\'ROLLBACK\\') if c.in_transaction else None\\n    res[mode] = r\\nout = (res, sqlite3.LEGACY_TRANSACTION_CONTROL)', g), g['out'])[1])({})" ; chx:output "({False: [False, True, True, 0, 'cannot start a transaction within a transaction', (True, 0)], True: [True, False, False, 1, (True, 2)]}, -1)" .
chx:X_AutocommitAttribute rd:hasIOExample chx:IO_AutocommitAttribute .
chx:X_ContextManagerTransaction a owl:NamedIndividual, chx:ContextManagerTransaction ; rdfs:label "with conn: ..."@en ; skos:definition "with conn: commits when the block ends and rolls back when it raises, and does not close the connection: after a block that inserted 2 and then NULL, the NOT NULL error rolled back both inserts, the table held only the committed (1,), in_transaction was False and the connection still answered."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ContextManagerTransaction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'t.db\\'); c.execute(\\'CREATE TABLE t (a INTEGER NOT NULL)\\'); c.commit()\\nwith c:\\n    c.execute(\\'INSERT INTO t VALUES (1)\\')\\nseen = sqlite3.connect(\\'t.db\\').execute(\\'SELECT count(*) FROM t\\').fetchone()[0]\\ntry:\\n    with c:\\n        c.execute(\\'INSERT INTO t VALUES (2)\\'); c.execute(\\'INSERT INTO t VALUES (NULL)\\')\\nexcept sqlite3.IntegrityError as e:\\n    err = str(e)\\nafter = (c.execute(\\'SELECT a FROM t\\').fetchall(), c.in_transaction)\\nout = (seen, err, after, c.execute(\\'SELECT 1\\').fetchone())', g), g['out'])[1])({}) evaluates to (1, 'NOT NULL constraint failed: t.a', ([(1,)], False), (1,))"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'t.db\\'); c.execute(\\'CREATE TABLE t (a INTEGER NOT NULL)\\'); c.commit()\\nwith c:\\n    c.execute(\\'INSERT INTO t VALUES (1)\\')\\nseen = sqlite3.connect(\\'t.db\\').execute(\\'SELECT count(*) FROM t\\').fetchone()[0]\\ntry:\\n    with c:\\n        c.execute(\\'INSERT INTO t VALUES (2)\\'); c.execute(\\'INSERT INTO t VALUES (NULL)\\')\\nexcept sqlite3.IntegrityError as e:\\n    err = str(e)\\nafter = (c.execute(\\'SELECT a FROM t\\').fetchall(), c.in_transaction)\\nout = (seen, err, after, c.execute(\\'SELECT 1\\').fetchone())', g), g['out'])[1])({})" ; chx:output "(1, 'NOT NULL constraint failed: t.a', ([(1,)], False), (1,))" .
chx:X_ContextManagerTransaction rd:hasIOExample chx:IO_ContextManagerTransaction .
chx:X_ExecuteScriptCommit a owl:NamedIndividual, chx:ExecuteScriptCommit ; rdfs:label "conn.executescript(...)"@en ; skos:definition "executescript commits any pending transaction first and then runs its statements: after an INSERT that opened a transaction (in_transaction True, invisible to another connection), executescript('CREATE TABLE u ...; INSERT INTO u ...') left in_transaction False, made the earlier row visible to the other connection, and created u with one row."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ExecuteScriptCommit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'t.db\\'); c.execute(\\'CREATE TABLE t (a)\\'); c.commit()\\nc.execute(\\'INSERT INTO t VALUES (1)\\'); before = (c.in_transaction, sqlite3.connect(\\'t.db\\').execute(\\'SELECT count(*) FROM t\\').fetchone()[0])\\nc.executescript(\\'CREATE TABLE u (a); INSERT INTO u VALUES (5);\\')\\nout = (before, c.in_transaction, sqlite3.connect(\\'t.db\\').execute(\\'SELECT count(*) FROM t\\').fetchone()[0], sqlite3.connect(\\'t.db\\').execute(\\'SELECT * FROM u\\').fetchall())', g), g['out'])[1])({}) evaluates to ((True, 0), False, 1, [(5,)])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'t.db\\'); c.execute(\\'CREATE TABLE t (a)\\'); c.commit()\\nc.execute(\\'INSERT INTO t VALUES (1)\\'); before = (c.in_transaction, sqlite3.connect(\\'t.db\\').execute(\\'SELECT count(*) FROM t\\').fetchone()[0])\\nc.executescript(\\'CREATE TABLE u (a); INSERT INTO u VALUES (5);\\')\\nout = (before, c.in_transaction, sqlite3.connect(\\'t.db\\').execute(\\'SELECT count(*) FROM t\\').fetchone()[0], sqlite3.connect(\\'t.db\\').execute(\\'SELECT * FROM u\\').fetchall())', g), g['out'])[1])({})" ; chx:output "((True, 0), False, 1, [(5,)])" .
chx:X_ExecuteScriptCommit rd:hasIOExample chx:IO_ExecuteScriptCommit .
chx:X_AtomicStatement a owl:NamedIndividual, chx:AtomicStatement ; rdfs:label "a transaction is carried out completely or not at all"@en ; skos:definition "A multi-row INSERT whose third row violated NOT NULL inserted none of its rows (the count stayed 1), and inside BEGIN an INSERT followed by an UPDATE that broke STRICT (cannot store TEXT value in INTEGER column t.b) was undone by rollback(), leaving only the original row ('keep', 1)."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_AtomicStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'t.db\\', isolation_level=None); c.execute(\\'CREATE TABLE t (a TEXT NOT NULL, b INTEGER) STRICT\\'); c.execute(\\x22INSERT INTO t VALUES (\\'keep\\', 1)\\x22)\\nres = []\\ntry:\\n    c.execute(\\x22INSERT INTO t VALUES (\\'x\\', 2), (\\'y\\', 3), (NULL, 4)\\x22)\\nexcept sqlite3.IntegrityError as e:\\n    res.append(str(e))\\nres.append(c.execute(\\'SELECT count(*) FROM t\\').fetchone()[0])\\nc.execute(\\'BEGIN\\')\\ntry:\\n    c.execute(\\x22INSERT INTO t VALUES (\\'p\\', 5)\\x22); c.execute(\\x22UPDATE t SET b = \\'text\\' WHERE a = \\'keep\\'\\x22)\\nexcept sqlite3.IntegrityError as e:\\n    res.append(str(e)); c.rollback()\\nres.append(c.execute(\\'SELECT a, b FROM t\\').fetchall())\\nout = res', g), g['out'])[1])({}) evaluates to ['NOT NULL constraint failed: t.a', 1, 'cannot store TEXT value in INTEGER column t.b', [('keep', 1)]]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'t.db\\', isolation_level=None); c.execute(\\'CREATE TABLE t (a TEXT NOT NULL, b INTEGER) STRICT\\'); c.execute(\\x22INSERT INTO t VALUES (\\'keep\\', 1)\\x22)\\nres = []\\ntry:\\n    c.execute(\\x22INSERT INTO t VALUES (\\'x\\', 2), (\\'y\\', 3), (NULL, 4)\\x22)\\nexcept sqlite3.IntegrityError as e:\\n    res.append(str(e))\\nres.append(c.execute(\\'SELECT count(*) FROM t\\').fetchone()[0])\\nc.execute(\\'BEGIN\\')\\ntry:\\n    c.execute(\\x22INSERT INTO t VALUES (\\'p\\', 5)\\x22); c.execute(\\x22UPDATE t SET b = \\'text\\' WHERE a = \\'keep\\'\\x22)\\nexcept sqlite3.IntegrityError as e:\\n    res.append(str(e)); c.rollback()\\nres.append(c.execute(\\'SELECT a, b FROM t\\').fetchall())\\nout = res', g), g['out'])[1])({})" ; chx:output "['NOT NULL constraint failed: t.a', 1, 'cannot store TEXT value in INTEGER column t.b', [('keep', 1)]]" .
chx:X_AtomicStatement rd:hasIOExample chx:IO_AtomicStatement .
chx:X_ConsistentConstraints a owl:NamedIndividual, chx:ConsistentConstraints ; rdfs:label "NOT NULL, STRICT, UNIQUE, CHECK, FOREIGN KEY"@en ; skos:definition "The database refuses a row that breaks a rule and says which: NOT NULL constraint failed: p.name, UNIQUE constraint failed: p.name, CHECK constraint failed: w > 0, cannot store TEXT value in REAL column p.w, and FOREIGN KEY constraint failed, each as sqlite3.IntegrityError."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ConsistentConstraints a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None); c.execute(\\'PRAGMA foreign_keys = ON\\')\\nc.execute(\\'CREATE TABLE p (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, w REAL CHECK (w > 0)) STRICT\\'); c.execute(\\'CREATE TABLE ch (pid INTEGER REFERENCES p(id)) STRICT\\')\\nc.execute(\\x22INSERT INTO p VALUES (1, \\'a\\', 1.5)\\x22)\\nres = []\\nfor s in (\\x22INSERT INTO p VALUES (2, NULL, 1)\\x22, \\x22INSERT INTO p VALUES (2, \\'a\\', 1)\\x22, \\x22INSERT INTO p VALUES (2, \\'b\\', -1)\\x22, \\x22INSERT INTO p VALUES (2, \\'b\\', \\'heavy\\')\\x22, \\x22INSERT INTO ch VALUES (9)\\x22):\\n    try:\\n        c.execute(s); res.append(\\'ok\\')\\n    except sqlite3.IntegrityError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({}) evaluates to ['NOT NULL constraint failed: p.name', 'UNIQUE constraint failed: p.name', 'CHECK constraint failed: w > 0', 'cannot store TEXT value in REAL column p.w', 'FOREIGN KEY constraint failed']"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None); c.execute(\\'PRAGMA foreign_keys = ON\\')\\nc.execute(\\'CREATE TABLE p (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, w REAL CHECK (w > 0)) STRICT\\'); c.execute(\\'CREATE TABLE ch (pid INTEGER REFERENCES p(id)) STRICT\\')\\nc.execute(\\x22INSERT INTO p VALUES (1, \\'a\\', 1.5)\\x22)\\nres = []\\nfor s in (\\x22INSERT INTO p VALUES (2, NULL, 1)\\x22, \\x22INSERT INTO p VALUES (2, \\'a\\', 1)\\x22, \\x22INSERT INTO p VALUES (2, \\'b\\', -1)\\x22, \\x22INSERT INTO p VALUES (2, \\'b\\', \\'heavy\\')\\x22, \\x22INSERT INTO ch VALUES (9)\\x22):\\n    try:\\n        c.execute(s); res.append(\\'ok\\')\\n    except sqlite3.IntegrityError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({})" ; chx:output "['NOT NULL constraint failed: p.name', 'UNIQUE constraint failed: p.name', 'CHECK constraint failed: w > 0', 'cannot store TEXT value in REAL column p.w', 'FOREIGN KEY constraint failed']" .
chx:X_ConsistentConstraints rd:hasIOExample chx:IO_ConsistentConstraints .
chx:X_IsolatedFromOthers a owl:NamedIndividual, chx:IsolatedFromOthers ; rdfs:label "one transaction does not affect another"@en ; skos:definition "An open transaction is invisible to other connections until it commits: the connection that ran BEGIN and an INSERT counted 2 rows while a second connection counted 1, and after commit() the second counted 2."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_IsolatedFromOthers a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\na = sqlite3.connect(\\'t.db\\', isolation_level=None); b = sqlite3.connect(\\'t.db\\', isolation_level=None)\\na.execute(\\'CREATE TABLE t (a)\\'); a.execute(\\'INSERT INTO t VALUES (1)\\')\\na.execute(\\'BEGIN\\'); a.execute(\\'INSERT INTO t VALUES (2)\\')\\nmid = (a.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0])\\na.commit()\\nout = (mid, b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0])', g), g['out'])[1])({}) evaluates to ((2, 1), 2)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\na = sqlite3.connect(\\'t.db\\', isolation_level=None); b = sqlite3.connect(\\'t.db\\', isolation_level=None)\\na.execute(\\'CREATE TABLE t (a)\\'); a.execute(\\'INSERT INTO t VALUES (1)\\')\\na.execute(\\'BEGIN\\'); a.execute(\\'INSERT INTO t VALUES (2)\\')\\nmid = (a.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0])\\na.commit()\\nout = (mid, b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0])', g), g['out'])[1])({})" ; chx:output "((2, 1), 2)" .
chx:X_IsolatedFromOthers rd:hasIOExample chx:IO_IsolatedFromOthers .
chx:X_DurableAfterReopen a owl:NamedIndividual, chx:DurableAfterReopen ; rdfs:label "committed results are written to persistent storage"@en ; skos:definition "A committed row survives closing and reopening and an uncommitted one does not: after a commit of row 1 and an INSERT of row 2 without commit, close() and a new connection, the table held [(1,)], PRAGMA synchronous read 2 (FULL), the journal mode was delete, integrity_check said ok and only t.db remained in the directory."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DurableAfterReopen a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'t.db\\'); c.execute(\\'CREATE TABLE t (a)\\'); c.execute(\\'INSERT INTO t VALUES (1)\\'); c.commit(); c.execute(\\'INSERT INTO t VALUES (2)\\')\\nc.close()\\nd = sqlite3.connect(\\'t.db\\')\\nout = (d.execute(\\'SELECT a FROM t\\').fetchall(), d.execute(\\'PRAGMA synchronous\\').fetchone()[0], d.execute(\\'PRAGMA journal_mode\\').fetchone()[0], d.execute(\\'PRAGMA integrity_check\\').fetchone()[0], sorted(os.listdir(\\'.\\')))', g), g['out'])[1])({}) evaluates to ([(1,)], 2, 'delete', 'ok', ['t.db'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'t.db\\'); c.execute(\\'CREATE TABLE t (a)\\'); c.execute(\\'INSERT INTO t VALUES (1)\\'); c.commit(); c.execute(\\'INSERT INTO t VALUES (2)\\')\\nc.close()\\nd = sqlite3.connect(\\'t.db\\')\\nout = (d.execute(\\'SELECT a FROM t\\').fetchall(), d.execute(\\'PRAGMA synchronous\\').fetchone()[0], d.execute(\\'PRAGMA journal_mode\\').fetchone()[0], d.execute(\\'PRAGMA integrity_check\\').fetchone()[0], sorted(os.listdir(\\'.\\')))', g), g['out'])[1])({})" ; chx:output "([(1,)], 2, 'delete', 'ok', ['t.db'])" .
chx:X_DurableAfterReopen rd:hasIOExample chx:IO_DurableAfterReopen .
chx:X_WriterLocked a owl:NamedIndividual, chx:WriterLocked ; rdfs:label "sqlite3.OperationalError: database is locked"@en ; skos:definition "While one connection held BEGIN IMMEDIATE with an uncommitted INSERT, a second connection's INSERT waited for its timeout of 0.3 seconds and raised OperationalError: database is locked, a reader still counted 0 rows, and after the first commit the second INSERT succeeded; the default busy timeout is 5000 milliseconds."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_WriterLocked a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport time\\na = sqlite3.connect(\\'t.db\\', isolation_level=None); a.execute(\\'CREATE TABLE t (a)\\')\\nb = sqlite3.connect(\\'t.db\\', timeout=0.3, isolation_level=None)\\na.execute(\\'BEGIN IMMEDIATE\\'); a.execute(\\'INSERT INTO t VALUES (1)\\')\\nt = time.perf_counter()\\ntry:\\n    b.execute(\\'INSERT INTO t VALUES (2)\\')\\nexcept sqlite3.OperationalError as e:\\n    err = str(e)\\nwaited = time.perf_counter() - t\\nreader = b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0]\\na.commit(); b.execute(\\'INSERT INTO t VALUES (2)\\')\\nout = (err, waited >= 0.25, reader, b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], sqlite3.connect(\\'t.db\\').execute(\\'PRAGMA busy_timeout\\').fetchone()[0])', g), g['out'])[1])({}) evaluates to ('database is locked', True, 0, 2, 5000)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport time\\na = sqlite3.connect(\\'t.db\\', isolation_level=None); a.execute(\\'CREATE TABLE t (a)\\')\\nb = sqlite3.connect(\\'t.db\\', timeout=0.3, isolation_level=None)\\na.execute(\\'BEGIN IMMEDIATE\\'); a.execute(\\'INSERT INTO t VALUES (1)\\')\\nt = time.perf_counter()\\ntry:\\n    b.execute(\\'INSERT INTO t VALUES (2)\\')\\nexcept sqlite3.OperationalError as e:\\n    err = str(e)\\nwaited = time.perf_counter() - t\\nreader = b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0]\\na.commit(); b.execute(\\'INSERT INTO t VALUES (2)\\')\\nout = (err, waited >= 0.25, reader, b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], sqlite3.connect(\\'t.db\\').execute(\\'PRAGMA busy_timeout\\').fetchone()[0])', g), g['out'])[1])({})" ; chx:output "('database is locked', True, 0, 2, 5000)" .
chx:X_WriterLocked rd:hasIOExample chx:IO_WriterLocked .
chx:X_JournalModeWal a owl:NamedIndividual, chx:JournalModeWal ; rdfs:label "PRAGMA journal_mode=WAL"@en ; skos:definition "PRAGMA journal_mode=WAL switched a database from delete to wal; while a writer held an open transaction a second connection could still read, the directory held t.db, t.db-shm and t.db-wal, after both connections closed only t.db remained, and the mode was still wal on reopening."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_JournalModeWal a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\na = sqlite3.connect(\\'t.db\\', isolation_level=None); a.execute(\\'CREATE TABLE t (a)\\')\\nres = [a.execute(\\'PRAGMA journal_mode\\').fetchone()[0], a.execute(\\'PRAGMA journal_mode=WAL\\').fetchone()[0]]\\na.execute(\\'INSERT INTO t VALUES (1)\\')\\nb = sqlite3.connect(\\'t.db\\', isolation_level=None)\\na.execute(\\'BEGIN IMMEDIATE\\'); a.execute(\\'INSERT INTO t VALUES (2)\\')\\nres.append((b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], sorted(os.listdir(\\'.\\'))))\\na.commit(); b.close(); a.close()\\nres.append(sorted(os.listdir(\\'.\\')))\\nres.append(sqlite3.connect(\\'t.db\\').execute(\\'PRAGMA journal_mode\\').fetchone()[0])\\nout = res', g), g['out'])[1])({}) evaluates to ['delete', 'wal', (1, ['t.db', 't.db-shm', 't.db-wal']), ['t.db'], 'wal']"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\na = sqlite3.connect(\\'t.db\\', isolation_level=None); a.execute(\\'CREATE TABLE t (a)\\')\\nres = [a.execute(\\'PRAGMA journal_mode\\').fetchone()[0], a.execute(\\'PRAGMA journal_mode=WAL\\').fetchone()[0]]\\na.execute(\\'INSERT INTO t VALUES (1)\\')\\nb = sqlite3.connect(\\'t.db\\', isolation_level=None)\\na.execute(\\'BEGIN IMMEDIATE\\'); a.execute(\\'INSERT INTO t VALUES (2)\\')\\nres.append((b.execute(\\'SELECT count(*) FROM t\\').fetchone()[0], sorted(os.listdir(\\'.\\'))))\\na.commit(); b.close(); a.close()\\nres.append(sorted(os.listdir(\\'.\\')))\\nres.append(sqlite3.connect(\\'t.db\\').execute(\\'PRAGMA journal_mode\\').fetchone()[0])\\nout = res', g), g['out'])[1])({})" ; chx:output "['delete', 'wal', (1, ['t.db', 't.db-shm', 't.db-wal']), ['t.db'], 'wal']" .
chx:X_JournalModeWal rd:hasIOExample chx:IO_JournalModeWal .
chx:X_RenameTableAndColumn a owl:NamedIndividual, chx:RenameTableAndColumn ; rdfs:label "ALTER TABLE cats RENAME TO felines; ALTER TABLE felines RENAME COLUMN fur TO description"@en ; skos:definition "ALTER TABLE RENAME rewrote the stored schema text to CREATE TABLE 'felines' with the new name in double quotes, RENAME COLUMN changed fur to description in PRAGMA TABLE_INFO and in the index (CREATE INDEX idx_fur ON 'felines' (description)), and a query on the new column name found Zophie."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_RenameTableAndColumn a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_fur ON cats (fur)\\')\\nbefore = c.execute(\\x22SELECT sql FROM sqlite_schema WHERE name = \\'cats\\'\\x22).fetchone()[0]\\nc.execute(\\'ALTER TABLE cats RENAME TO felines\\')\\nafter = c.execute(\\x22SELECT sql FROM sqlite_schema WHERE name = \\'felines\\'\\x22).fetchone()[0]\\nc.execute(\\'ALTER TABLE felines RENAME COLUMN fur TO description\\')\\nout = (before, after, c.execute(\\'PRAGMA TABLE_INFO(felines)\\').fetchall()[2], c.execute(\\x22SELECT sql FROM sqlite_schema WHERE type = \\'index\\'\\x22).fetchone()[0], c.execute(\\'SELECT description FROM felines WHERE rowid = 1\\').fetchone())', g), g['out'])[1])({}) evaluates to ('CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT', 'CREATE TABLE 'felines' (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT', (2, 'description', 'TEXT', 0, None, 0), 'CREATE INDEX idx_fur ON 'felines' (description)', ('black',))"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_fur ON cats (fur)\\')\\nbefore = c.execute(\\x22SELECT sql FROM sqlite_schema WHERE name = \\'cats\\'\\x22).fetchone()[0]\\nc.execute(\\'ALTER TABLE cats RENAME TO felines\\')\\nafter = c.execute(\\x22SELECT sql FROM sqlite_schema WHERE name = \\'felines\\'\\x22).fetchone()[0]\\nc.execute(\\'ALTER TABLE felines RENAME COLUMN fur TO description\\')\\nout = (before, after, c.execute(\\'PRAGMA TABLE_INFO(felines)\\').fetchall()[2], c.execute(\\x22SELECT sql FROM sqlite_schema WHERE type = \\'index\\'\\x22).fetchone()[0], c.execute(\\'SELECT description FROM felines WHERE rowid = 1\\').fetchone())', g), g['out'])[1])({})" ; chx:output "('CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT', 'CREATE TABLE 'felines' (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT', (2, 'description', 'TEXT', 0, None, 0), 'CREATE INDEX idx_fur ON 'felines' (description)', ('black',))" .
chx:X_RenameTableAndColumn rd:hasIOExample chx:IO_RenameTableAndColumn .
chx:X_AddColumn a owl:NamedIndividual, chx:AddColumn ; rdfs:label "ALTER TABLE felines ADD COLUMN is_loved INTEGER DEFAULT 1"@en ; skos:definition "ADD COLUMN is_loved INTEGER DEFAULT 1 gave every existing row the value 1 and a table_info row (4, 'is_loved', 'INTEGER', 0, '1', 0); a NOT NULL column without a default was refused with Cannot add a NOT NULL column with default value NULL, a PRIMARY KEY column with Cannot add a PRIMARY KEY column, and MODIFY COLUMN is a syntax error near MODIFY."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_AddColumn a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'ALTER TABLE cats ADD COLUMN is_loved INTEGER DEFAULT 1\\')\\nres = [c.execute(\\'SELECT * FROM cats LIMIT 2\\').fetchall(), c.execute(\\'PRAGMA TABLE_INFO(cats)\\').fetchall()[-1]]\\nfor s in (\\'ALTER TABLE cats ADD COLUMN z TEXT NOT NULL\\', \\'ALTER TABLE cats ADD COLUMN k INTEGER PRIMARY KEY\\', \\'ALTER TABLE cats MODIFY COLUMN name TEXT\\'):\\n    try:\\n        c.execute(s)\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({}) evaluates to [[('Zophie', '2021-01-24', 'black', 5.6, 1), ('Miguel', '2016-12-24', 'siamese', 6.2, 1)], (4, 'is_loved', 'INTEGER', 0, '1', 0), 'Cannot add a NOT NULL column with default value NULL', 'Cannot add a PRIMARY KEY column', 'near 'MODIFY': syntax error']"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'ALTER TABLE cats ADD COLUMN is_loved INTEGER DEFAULT 1\\')\\nres = [c.execute(\\'SELECT * FROM cats LIMIT 2\\').fetchall(), c.execute(\\'PRAGMA TABLE_INFO(cats)\\').fetchall()[-1]]\\nfor s in (\\'ALTER TABLE cats ADD COLUMN z TEXT NOT NULL\\', \\'ALTER TABLE cats ADD COLUMN k INTEGER PRIMARY KEY\\', \\'ALTER TABLE cats MODIFY COLUMN name TEXT\\'):\\n    try:\\n        c.execute(s)\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({})" ; chx:output "[[('Zophie', '2021-01-24', 'black', 5.6, 1), ('Miguel', '2016-12-24', 'siamese', 6.2, 1)], (4, 'is_loved', 'INTEGER', 0, '1', 0), 'Cannot add a NOT NULL column with default value NULL', 'Cannot add a PRIMARY KEY column', 'near 'MODIFY': syntax error']" .
chx:X_AddColumn rd:hasIOExample chx:IO_AddColumn .
chx:X_DropColumn a owl:NamedIndividual, chx:DropColumn ; rdfs:label "ALTER TABLE felines DROP COLUMN is_loved"@en ; skos:definition "DROP COLUMN is_loved restored the four columns, but DROP COLUMN fur was refused with error in index idx_fur after drop column: no such column: fur while an index used it, DROP COLUMN rowid with no such column: 'rowid', and after DROP INDEX the fur column could be dropped and the row read back as ('Zophie', '2021-01-24', 5.6)."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DropColumn a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'ALTER TABLE cats ADD COLUMN is_loved INTEGER DEFAULT 1\\'); c.execute(\\'CREATE INDEX idx_fur ON cats (fur)\\')\\nres = []\\nc.execute(\\'ALTER TABLE cats DROP COLUMN is_loved\\')\\nres.append([r[1] for r in c.execute(\\'PRAGMA TABLE_INFO(cats)\\')])\\nfor s in (\\'ALTER TABLE cats DROP COLUMN fur\\', \\'ALTER TABLE cats DROP COLUMN rowid\\'):\\n    try:\\n        c.execute(s)\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nc.execute(\\'DROP INDEX idx_fur\\'); c.execute(\\'ALTER TABLE cats DROP COLUMN fur\\')\\nres.append(c.execute(\\'SELECT * FROM cats LIMIT 1\\').fetchall())\\nout = res', g), g['out'])[1])({}) evaluates to [['name', 'birthdate', 'fur', 'weight_kg'], 'error in index idx_fur after drop column: no such column: fur', 'no such column: 'rowid'', [('Zophie', '2021-01-24', 5.6)]]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'ALTER TABLE cats ADD COLUMN is_loved INTEGER DEFAULT 1\\'); c.execute(\\'CREATE INDEX idx_fur ON cats (fur)\\')\\nres = []\\nc.execute(\\'ALTER TABLE cats DROP COLUMN is_loved\\')\\nres.append([r[1] for r in c.execute(\\'PRAGMA TABLE_INFO(cats)\\')])\\nfor s in (\\'ALTER TABLE cats DROP COLUMN fur\\', \\'ALTER TABLE cats DROP COLUMN rowid\\'):\\n    try:\\n        c.execute(s)\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nc.execute(\\'DROP INDEX idx_fur\\'); c.execute(\\'ALTER TABLE cats DROP COLUMN fur\\')\\nres.append(c.execute(\\'SELECT * FROM cats LIMIT 1\\').fetchall())\\nout = res', g), g['out'])[1])({})" ; chx:output "[['name', 'birthdate', 'fur', 'weight_kg'], 'error in index idx_fur after drop column: no such column: fur', 'no such column: 'rowid'', [('Zophie', '2021-01-24', 5.6)]]" .
chx:X_DropColumn rd:hasIOExample chx:IO_DropColumn .
chx:X_DropTable a owl:NamedIndividual, chx:DropTable ; rdfs:label "DROP TABLE felines"@en ; skos:definition "DROP TABLE removed the table and its index (sqlite_schema was empty afterwards), a second DROP TABLE cats raised no such table: cats, DROP TABLE IF EXISTS cats returned without error, and a SELECT from the dropped table raised no such table: cats."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DropTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\')\\nc.execute(\\'DROP TABLE cats\\')\\nres = [c.execute(\\'SELECT name, type FROM sqlite_schema\\').fetchall()]\\nfor s in (\\'DROP TABLE cats\\', \\'DROP TABLE IF EXISTS cats\\', \\'SELECT * FROM cats\\'):\\n    try:\\n        c.execute(s); res.append(\\'ok\\')\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({}) evaluates to [[], 'no such table: cats', 'ok', 'no such table: cats']"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\')\\nc.execute(\\'DROP TABLE cats\\')\\nres = [c.execute(\\'SELECT name, type FROM sqlite_schema\\').fetchall()]\\nfor s in (\\'DROP TABLE cats\\', \\'DROP TABLE IF EXISTS cats\\', \\'SELECT * FROM cats\\'):\\n    try:\\n        c.execute(s); res.append(\\'ok\\')\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({})" ; chx:output "[[], 'no such table: cats', 'ok', 'no such table: cats']" .
chx:X_DropTable rd:hasIOExample chx:IO_DropTable .
chx:X_SeparateTableDesign a owl:NamedIndividual, chx:SeparateTableDesign ; rdfs:label "CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, administered_by TEXT, cat_id INTEGER, ...)"@en ; skos:definition "A second table with one row per vaccination and a cat_id column holds a varying number of vaccinations without any change to the cats table: three rows for cat 1 and one for cat 3 were counted by GROUP BY cat_id, and the cats table kept its four columns."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SeparateTableDesign a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, administered_by TEXT, cat_id INTEGER) STRICT\\')\\nc.executemany(\\'INSERT INTO vaccinations VALUES (?, ?, ?, ?)\\', [(\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'FeLV\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'FVRCP\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'rabies\\', \\'2023-07-11\\', \\'Dr. Echo\\', 3)])\\nout = (c.execute(\\'SELECT cat_id, count(*) FROM vaccinations GROUP BY cat_id\\').fetchall(), c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], [r[1] for r in c.execute(\\'PRAGMA TABLE_INFO(cats)\\')])', g), g['out'])[1])({}) evaluates to ([(1, 3), (3, 1)], 4, ['name', 'birthdate', 'fur', 'weight_kg'])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, administered_by TEXT, cat_id INTEGER) STRICT\\')\\nc.executemany(\\'INSERT INTO vaccinations VALUES (?, ?, ?, ?)\\', [(\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'FeLV\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'FVRCP\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'rabies\\', \\'2023-07-11\\', \\'Dr. Echo\\', 3)])\\nout = (c.execute(\\'SELECT cat_id, count(*) FROM vaccinations GROUP BY cat_id\\').fetchall(), c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], [r[1] for r in c.execute(\\'PRAGMA TABLE_INFO(cats)\\')])', g), g['out'])[1])({})" ; chx:output "([(1, 3), (3, 1)], 4, ['name', 'birthdate', 'fur', 'weight_kg'])" .
chx:X_SeparateTableDesign rd:hasIOExample chx:IO_SeparateTableDesign .
chx:X_InnerJoin a owl:NamedIndividual, chx:InnerJoin ; rdfs:label "SELECT * FROM cats INNER JOIN vaccinations ON cats.rowid = vaccinations.cat_id"@en ; skos:definition "An INNER JOIN on cats.rowid = vaccinations.cat_id returned only the matching pairs: of four vaccination rows, one with cat_id 99 had no cat and was left out, giving 3 rows, the first being ('Zophie', '2021-01-24', 'black', 5.6, 'rabies', '2023-06-06', 'Dr. Echo', 1), and the orphan stayed in the table."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_InnerJoin a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, administered_by TEXT, cat_id INTEGER) STRICT\\')\\nc.executemany(\\'INSERT INTO vaccinations VALUES (?, ?, ?, ?)\\', [(\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'FeLV\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'rabies\\', \\'2023-07-11\\', \\'Dr. Echo\\', 3), (\\'rabies\\', \\'2023-07-12\\', \\'Dr. Echo\\', 99)])\\nrows = c.execute(\\'SELECT * FROM cats INNER JOIN vaccinations ON cats.rowid = vaccinations.cat_id\\').fetchall()\\nout = (len(rows), rows[0], [r[0] for r in c.execute(\\'SELECT cats.name FROM cats JOIN vaccinations v ON cats.rowid = v.cat_id ORDER BY v.rowid\\')], c.execute(\\'SELECT count(*) FROM vaccinations\\').fetchone()[0])', g), g['out'])[1])({}) evaluates to (3, ('Zophie', '2021-01-24', 'black', 5.6, 'rabies', '2023-06-06', 'Dr. Echo', 1), ['Zophie', 'Zophie', 'Jacob'], 4)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, administered_by TEXT, cat_id INTEGER) STRICT\\')\\nc.executemany(\\'INSERT INTO vaccinations VALUES (?, ?, ?, ?)\\', [(\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'FeLV\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'rabies\\', \\'2023-07-11\\', \\'Dr. Echo\\', 3), (\\'rabies\\', \\'2023-07-12\\', \\'Dr. Echo\\', 99)])\\nrows = c.execute(\\'SELECT * FROM cats INNER JOIN vaccinations ON cats.rowid = vaccinations.cat_id\\').fetchall()\\nout = (len(rows), rows[0], [r[0] for r in c.execute(\\'SELECT cats.name FROM cats JOIN vaccinations v ON cats.rowid = v.cat_id ORDER BY v.rowid\\')], c.execute(\\'SELECT count(*) FROM vaccinations\\').fetchone()[0])', g), g['out'])[1])({})" ; chx:output "(3, ('Zophie', '2021-01-24', 'black', 5.6, 'rabies', '2023-06-06', 'Dr. Echo', 1), ['Zophie', 'Zophie', 'Jacob'], 4)" .
chx:X_InnerJoin rd:hasIOExample chx:IO_InnerJoin .
chx:X_LeftJoin a owl:NamedIndividual, chx:LeftJoin ; rdfs:label "SELECT name FROM cats LEFT JOIN vaccinations ON ... WHERE vaccinations.vaccine IS NULL"@en ; skos:definition "A LEFT JOIN keeps every cat and fills the missing side with None: Miguel and Toby, who have no vaccination, came back with None, and adding WHERE vaccinations.vaccine IS NULL returned just [('Miguel',), ('Toby',)]."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_LeftJoin a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, administered_by TEXT, cat_id INTEGER) STRICT\\')\\nc.executemany(\\'INSERT INTO vaccinations VALUES (?, ?, ?, ?)\\', [(\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'FeLV\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'rabies\\', \\'2023-07-11\\', \\'Dr. Echo\\', 3)])\\nout = (c.execute(\\'SELECT cats.name, vaccinations.vaccine FROM cats LEFT JOIN vaccinations ON cats.rowid = vaccinations.cat_id ORDER BY cats.rowid\\').fetchall(), c.execute(\\'SELECT cats.name FROM cats LEFT JOIN vaccinations ON cats.rowid = vaccinations.cat_id WHERE vaccinations.vaccine IS NULL\\').fetchall())', g), g['out'])[1])({}) evaluates to ([('Zophie', 'FeLV'), ('Zophie', 'rabies'), ('Miguel', None), ('Jacob', 'rabies'), ('Toby', None)], [('Miguel',), ('Toby',)])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, administered_by TEXT, cat_id INTEGER) STRICT\\')\\nc.executemany(\\'INSERT INTO vaccinations VALUES (?, ?, ?, ?)\\', [(\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'FeLV\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1), (\\'rabies\\', \\'2023-07-11\\', \\'Dr. Echo\\', 3)])\\nout = (c.execute(\\'SELECT cats.name, vaccinations.vaccine FROM cats LEFT JOIN vaccinations ON cats.rowid = vaccinations.cat_id ORDER BY cats.rowid\\').fetchall(), c.execute(\\'SELECT cats.name FROM cats LEFT JOIN vaccinations ON cats.rowid = vaccinations.cat_id WHERE vaccinations.vaccine IS NULL\\').fetchall())', g), g['out'])[1])({})" ; chx:output "([('Zophie', 'FeLV'), ('Zophie', 'rabies'), ('Miguel', None), ('Jacob', 'rabies'), ('Toby', None)], [('Miguel',), ('Toby',)])" .
chx:X_LeftJoin rd:hasIOExample chx:IO_LeftJoin .
chx:X_ForeignKeyMismatch a owl:NamedIndividual, chx:ForeignKeyMismatch ; rdfs:label "FOREIGN KEY(cat_id) REFERENCES cats(rowid)"@en ; skos:definition "The chapter's declaration FOREIGN KEY(cat_id) REFERENCES cats(rowid) does not work once enforcement is on: with foreign_keys at its default of 0 it accepted a row for cat 999 (2 rows), and after PRAGMA foreign_keys = ON an INSERT, a DELETE on cats and PRAGMA foreign_key_check each raised OperationalError: foreign key mismatch - 'vaccinations' referencing 'cats'."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ForeignKeyMismatch a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, administered_by TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(rowid)) STRICT\\')\\nres = [c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0]]\\nc.execute(\\x22INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1)\\x22); c.execute(\\x22INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 999)\\x22)\\nres.append(c.execute(\\'SELECT count(*) FROM vaccinations\\').fetchone()[0])\\nc.execute(\\'PRAGMA foreign_keys = ON\\')\\nfor s in (\\x22INSERT INTO vaccinations VALUES (\\'FeLV\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1)\\x22, \\'DELETE FROM cats WHERE rowid = 1\\', \\'PRAGMA foreign_key_check\\'):\\n    try:\\n        c.execute(s).fetchall(); res.append(\\'ok\\')\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({}) evaluates to [0, 2, 'foreign key mismatch - 'vaccinations' referencing 'cats'', 'foreign key mismatch - 'vaccinations' referencing 'cats'', 'foreign key mismatch - 'vaccinations' referencing 'cats'']"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, administered_by TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(rowid)) STRICT\\')\\nres = [c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0]]\\nc.execute(\\x22INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1)\\x22); c.execute(\\x22INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', \\'Dr. Echo\\', 999)\\x22)\\nres.append(c.execute(\\'SELECT count(*) FROM vaccinations\\').fetchone()[0])\\nc.execute(\\'PRAGMA foreign_keys = ON\\')\\nfor s in (\\x22INSERT INTO vaccinations VALUES (\\'FeLV\\', \\'2023-06-06\\', \\'Dr. Echo\\', 1)\\x22, \\'DELETE FROM cats WHERE rowid = 1\\', \\'PRAGMA foreign_key_check\\'):\\n    try:\\n        c.execute(s).fetchall(); res.append(\\'ok\\')\\n    except sqlite3.OperationalError as e:\\n        res.append(str(e))\\nout = res', g), g['out'])[1])({})" ; chx:output "[0, 2, 'foreign key mismatch - 'vaccinations' referencing 'cats'', 'foreign key mismatch - 'vaccinations' referencing 'cats'', 'foreign key mismatch - 'vaccinations' referencing 'cats'']" .
chx:X_ForeignKeyMismatch rd:hasIOExample chx:IO_ForeignKeyMismatch .
chx:X_ForeignKeyEnforcement a owl:NamedIndividual, chx:ForeignKeyEnforcement ; rdfs:label "PRAGMA foreign_keys = ON"@en ; skos:definition "With the parent declared as id INTEGER PRIMARY KEY, enforcement works: it is off by default (0), rows added earlier stay unchecked, after PRAGMA foreign_keys = ON an orphan insert, a delete of a parent with children and an update to a missing parent each raised IntegrityError: FOREIGN KEY constraint failed, foreign_key_check listed the earlier orphan as ('vaccinations', 1, 'cats', 0), and the pragma changed nothing inside a transaction."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ForeignKeyEnforcement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nres = [c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0]]\\nc.execute(\\'CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL) STRICT\\'); c.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, cat_id INTEGER REFERENCES cats(id)) STRICT\\')\\nc.execute(\\x22INSERT INTO cats (name) VALUES (\\'Zophie\\')\\x22); c.execute(\\x22INSERT INTO vaccinations VALUES (\\'orphan before\\', 999)\\x22)\\nc.execute(\\'PRAGMA foreign_keys = ON\\'); res.append(c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0])\\nfor s in (\\x22INSERT INTO vaccinations VALUES (\\'rabies\\', 1)\\x22, \\x22INSERT INTO vaccinations VALUES (\\'rabies\\', 999)\\x22, \\'DELETE FROM cats WHERE id = 1\\', \\'UPDATE vaccinations SET cat_id = 77 WHERE cat_id = 1\\'):\\n    try:\\n        c.execute(s); res.append(\\'ok\\')\\n    except sqlite3.IntegrityError as e:\\n        res.append(str(e))\\nres.append(c.execute(\\'PRAGMA foreign_key_check\\').fetchall())\\nc.execute(\\'BEGIN\\'); c.execute(\\'PRAGMA foreign_keys = OFF\\'); res.append(c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0]); c.execute(\\'COMMIT\\')\\nc.execute(\\'PRAGMA foreign_keys = OFF\\'); res.append(c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0])\\nout = res', g), g['out'])[1])({}) evaluates to [0, 1, 'ok', 'FOREIGN KEY constraint failed', 'FOREIGN KEY constraint failed', 'FOREIGN KEY constraint failed', [('vaccinations', 1, 'cats', 0)], 1, 0]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nres = [c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0]]\\nc.execute(\\'CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL) STRICT\\'); c.execute(\\'CREATE TABLE vaccinations (vaccine TEXT, cat_id INTEGER REFERENCES cats(id)) STRICT\\')\\nc.execute(\\x22INSERT INTO cats (name) VALUES (\\'Zophie\\')\\x22); c.execute(\\x22INSERT INTO vaccinations VALUES (\\'orphan before\\', 999)\\x22)\\nc.execute(\\'PRAGMA foreign_keys = ON\\'); res.append(c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0])\\nfor s in (\\x22INSERT INTO vaccinations VALUES (\\'rabies\\', 1)\\x22, \\x22INSERT INTO vaccinations VALUES (\\'rabies\\', 999)\\x22, \\'DELETE FROM cats WHERE id = 1\\', \\'UPDATE vaccinations SET cat_id = 77 WHERE cat_id = 1\\'):\\n    try:\\n        c.execute(s); res.append(\\'ok\\')\\n    except sqlite3.IntegrityError as e:\\n        res.append(str(e))\\nres.append(c.execute(\\'PRAGMA foreign_key_check\\').fetchall())\\nc.execute(\\'BEGIN\\'); c.execute(\\'PRAGMA foreign_keys = OFF\\'); res.append(c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0]); c.execute(\\'COMMIT\\')\\nc.execute(\\'PRAGMA foreign_keys = OFF\\'); res.append(c.execute(\\'PRAGMA foreign_keys\\').fetchone()[0])\\nout = res', g), g['out'])[1])({})" ; chx:output "[0, 1, 'ok', 'FOREIGN KEY constraint failed', 'FOREIGN KEY constraint failed', 'FOREIGN KEY constraint failed', [('vaccinations', 1, 'cats', 0)], 1, 0]" .
chx:X_ForeignKeyEnforcement rd:hasIOExample chx:IO_ForeignKeyEnforcement .
chx:X_ShippedSchema a owl:NamedIndividual, chx:ShippedSchema ; rdfs:label "sweigartcats.db of the online materials"@en ; skos:definition "The shipped sweigartcats.db is 24576 bytes with 4096-byte pages and passes integrity_check; it holds both tables, cats with 100 rows and vaccinations with 291, so the chapter's CREATE TABLE for vaccinations would not create it but find it present, and the cats it prints do not match: Zophie (rowid 1) has fur black and Mango is rowid 29, where the chapter prints 'gray tabby' and 23."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ShippedSchema a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(\\'file:\\' + db + \\'?mode=ro\\', uri=True)\\nout = (os.path.getsize(db), c.execute(\\'SELECT name, type, sql FROM sqlite_schema ORDER BY rowid\\').fetchall(), c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], c.execute(\\'SELECT count(*) FROM vaccinations\\').fetchone()[0], c.execute(\\'PRAGMA page_size\\').fetchone()[0], c.execute(\\'PRAGMA integrity_check\\').fetchone()[0], c.execute(\\'SELECT rowid, * FROM cats WHERE name = \\\\\\'Mango\\\\\\'\\').fetchall(), c.execute(\\'SELECT rowid, * FROM cats WHERE rowid = 1\\').fetchall())', g), g['out'])[1])({}) evaluates to (24576, [('cats', 'table', 'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT'), ('vaccinations', 'table', 'CREATE TABLE vaccinations (vaccine TEXT,date_administered TEXT, administered_by TEXT, cat_id INTEGER,FOREIGN KEY(cat_id) REFERENCES cats(rowid)) STRICT')], 100, 291, 4096, 'ok', [(29, 'Mango', '2017-02-12', 'tuxedo', 6.8)], [(1, 'Zophie', '2021-01-24', 'black', 5.6)])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(\\'file:\\' + db + \\'?mode=ro\\', uri=True)\\nout = (os.path.getsize(db), c.execute(\\'SELECT name, type, sql FROM sqlite_schema ORDER BY rowid\\').fetchall(), c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], c.execute(\\'SELECT count(*) FROM vaccinations\\').fetchone()[0], c.execute(\\'PRAGMA page_size\\').fetchone()[0], c.execute(\\'PRAGMA integrity_check\\').fetchone()[0], c.execute(\\'SELECT rowid, * FROM cats WHERE name = \\\\\\'Mango\\\\\\'\\').fetchall(), c.execute(\\'SELECT rowid, * FROM cats WHERE rowid = 1\\').fetchall())', g), g['out'])[1])({})" ; chx:output "(24576, [('cats', 'table', 'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT'), ('vaccinations', 'table', 'CREATE TABLE vaccinations (vaccine TEXT,date_administered TEXT, administered_by TEXT, cat_id INTEGER,FOREIGN KEY(cat_id) REFERENCES cats(rowid)) STRICT')], 100, 291, 4096, 'ok', [(29, 'Mango', '2017-02-12', 'tuxedo', 6.8)], [(1, 'Zophie', '2021-01-24', 'black', 5.6)])" .
chx:X_ShippedSchema rd:hasIOExample chx:IO_ShippedSchema .
chx:X_ShippedPlantedErrors a owl:NamedIndividual, chx:ShippedPlantedErrors ; rdfs:label "vaccinations given before the cat was born"@en ; skos:definition "The shipped data contain three vaccinations dated before the cat was born (Ruby, rowid 52, FVRCP on 2004-12-24 for a birth on 2023-12-22; Java, 55, 2001-03-13 against 2019-12-19; Rocket, 95, 2003-12-25 against 2013-03-28), seven cats lacking at least one of the three vaccines (Molly 17, Sage 19, Hugh 42, Chester 43, Snowflake 88, Luke 93, Muffin 96), no orphan vaccination rows, 97 vaccinations of each vaccine and two cats named Tiger."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ShippedPlantedErrors a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(\\'file:\\' + db + \\'?mode=ro\\', uri=True)\\nearly = c.execute(\\'SELECT cats.rowid, cats.name, cats.birthdate, v.vaccine, v.date_administered FROM vaccinations v JOIN cats ON cats.rowid = v.cat_id WHERE v.date_administered < cats.birthdate ORDER BY cats.rowid\\').fetchall()\\nlacking = c.execute(\\x22SELECT cats.rowid, cats.name FROM cats WHERE (SELECT count(DISTINCT vaccine) FROM vaccinations v WHERE v.cat_id = cats.rowid AND vaccine IN (\\'rabies\\', \\'FeLV\\', \\'FVRCP\\')) < 3 ORDER BY cats.rowid\\x22).fetchall()\\norph = c.execute(\\'SELECT count(*) FROM vaccinations v LEFT JOIN cats ON cats.rowid = v.cat_id WHERE cats.rowid IS NULL\\').fetchone()[0]\\nout = (early, lacking, orph, c.execute(\\'SELECT vaccine, count(*) FROM vaccinations GROUP BY vaccine\\').fetchall(), c.execute(\\'SELECT name, count(*) FROM cats GROUP BY name HAVING count(*) > 1\\').fetchall())', g), g['out'])[1])({}) evaluates to ([(52, 'Ruby', '2023-12-22', 'FVRCP', '2004-12-24'), (55, 'Java', '2019-12-19', 'FVRCP', '2001-03-13'), (95, 'Rocket', '2013-03-28', 'FVRCP', '2003-12-25')], [(17, 'Molly'), (19, 'Sage'), (42, 'Hugh'), (43, 'Chester'), (88, 'Snowflake'), (93, 'Luke'), (96, 'Muffin')], 0, [('FVRCP', 97), ('FeLV', 97), ('rabies', 97)], [('Tiger', 2)])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(\\'file:\\' + db + \\'?mode=ro\\', uri=True)\\nearly = c.execute(\\'SELECT cats.rowid, cats.name, cats.birthdate, v.vaccine, v.date_administered FROM vaccinations v JOIN cats ON cats.rowid = v.cat_id WHERE v.date_administered < cats.birthdate ORDER BY cats.rowid\\').fetchall()\\nlacking = c.execute(\\x22SELECT cats.rowid, cats.name FROM cats WHERE (SELECT count(DISTINCT vaccine) FROM vaccinations v WHERE v.cat_id = cats.rowid AND vaccine IN (\\'rabies\\', \\'FeLV\\', \\'FVRCP\\')) < 3 ORDER BY cats.rowid\\x22).fetchall()\\norph = c.execute(\\'SELECT count(*) FROM vaccinations v LEFT JOIN cats ON cats.rowid = v.cat_id WHERE cats.rowid IS NULL\\').fetchone()[0]\\nout = (early, lacking, orph, c.execute(\\'SELECT vaccine, count(*) FROM vaccinations GROUP BY vaccine\\').fetchall(), c.execute(\\'SELECT name, count(*) FROM cats GROUP BY name HAVING count(*) > 1\\').fetchall())', g), g['out'])[1])({})" ; chx:output "([(52, 'Ruby', '2023-12-22', 'FVRCP', '2004-12-24'), (55, 'Java', '2019-12-19', 'FVRCP', '2001-03-13'), (95, 'Rocket', '2013-03-28', 'FVRCP', '2003-12-25')], [(17, 'Molly'), (19, 'Sage'), (42, 'Hugh'), (43, 'Chester'), (88, 'Snowflake'), (93, 'Luke'), (96, 'Muffin')], 0, [('FVRCP', 97), ('FeLV', 97), ('rabies', 97)], [('Tiger', 2)])" .
chx:X_ShippedPlantedErrors rd:hasIOExample chx:IO_ShippedPlantedErrors .
chx:X_InMemoryDatabase a owl:NamedIndividual, chx:InMemoryDatabase ; rdfs:label "sqlite3.connect(':memory:')"@en ; skos:definition "Each connect(':memory:') is a separate database: a table created through one connection was not visible through another (no such table: t), a URI with mode=memory&cache=shared was visible to both connections, the database list showed an empty file name, connect('') also gave a private database with an empty file name, and no file was created in the directory."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_InMemoryDatabase a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\na = sqlite3.connect(\\':memory:\\'); b = sqlite3.connect(\\':memory:\\'); a.execute(\\'CREATE TABLE t (x)\\'); a.commit()\\ntry:\\n    b.execute(\\'SELECT * FROM t\\')\\n    sep = \\'visible\\'\\nexcept sqlite3.OperationalError as e:\\n    sep = str(e)\\ns1 = sqlite3.connect(\\'file:memdb?mode=memory&cache=shared\\', uri=True); s2 = sqlite3.connect(\\'file:memdb?mode=memory&cache=shared\\', uri=True)\\ns1.execute(\\'CREATE TABLE t (x)\\'); s1.commit()\\nt = sqlite3.connect(\\'\\')\\nout = (sep, s2.execute(\\'SELECT name FROM sqlite_schema\\').fetchall(), a.execute(\\'PRAGMA database_list\\').fetchall(), t.execute(\\'PRAGMA database_list\\').fetchall(), os.listdir(\\'.\\'))\\nfor k in (a, b, s1, s2, t):\\n    k.close()', g), g['out'])[1])({}) evaluates to ('no such table: t', [('t',)], [(0, 'main', '')], [(0, 'main', '')], [])"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\na = sqlite3.connect(\\':memory:\\'); b = sqlite3.connect(\\':memory:\\'); a.execute(\\'CREATE TABLE t (x)\\'); a.commit()\\ntry:\\n    b.execute(\\'SELECT * FROM t\\')\\n    sep = \\'visible\\'\\nexcept sqlite3.OperationalError as e:\\n    sep = str(e)\\ns1 = sqlite3.connect(\\'file:memdb?mode=memory&cache=shared\\', uri=True); s2 = sqlite3.connect(\\'file:memdb?mode=memory&cache=shared\\', uri=True)\\ns1.execute(\\'CREATE TABLE t (x)\\'); s1.commit()\\nt = sqlite3.connect(\\'\\')\\nout = (sep, s2.execute(\\'SELECT name FROM sqlite_schema\\').fetchall(), a.execute(\\'PRAGMA database_list\\').fetchall(), t.execute(\\'PRAGMA database_list\\').fetchall(), os.listdir(\\'.\\'))\\nfor k in (a, b, s1, s2, t):\\n    k.close()', g), g['out'])[1])({})" ; chx:output "('no such table: t', [('t',)], [(0, 'main', '')], [(0, 'main', '')], [])" .
chx:X_InMemoryDatabase rd:hasIOExample chx:IO_InMemoryDatabase .
chx:X_BackupMethod a owl:NamedIndividual, chx:BackupMethod ; rdfs:label "conn.backup(backup_conn)"@en ; skos:definition "conn.backup(target) copied the 4 rows of a file database to another file, with pages=1 and a progress callback it was called several times and ended with status 101 (SQLITE_DONE), a memory database with an added row saved to a file carried 5 rows, backing up onto a database that already had a table replaced its content (only cats remained), and backing up a connection onto itself raised ValueError: target cannot be the same connection instance."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_BackupMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'cats.db\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.commit() if False else None\\nc.close(); c = sqlite3.connect(\\'cats.db\\', isolation_level=None)\\nbk = sqlite3.connect(\\'backup.db\\', isolation_level=None)\\nprog = []\\nc.backup(bk, pages=1, progress=lambda status, remaining, total: prog.append((status, remaining, total)))\\nm = sqlite3.connect(\\':memory:\\', isolation_level=None); c.backup(m)\\nm.execute(\\x22INSERT INTO cats VALUES (\\'Mem\\', \\'2024-01-01\\', \\'x\\', 1)\\x22); f = sqlite3.connect(\\'mem.db\\', isolation_level=None); m.backup(f)\\nt = sqlite3.connect(\\'target.db\\', isolation_level=None); t.execute(\\'CREATE TABLE other (a)\\'); c.backup(t)\\ntry:\\n    c.backup(c)\\nexcept ValueError as e:\\n    same = str(e)\\nout = (bk.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], len(prog) > 1, prog[-1][0], f.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], t.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22).fetchall(), same, c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0])', g), g['out'])[1])({}) evaluates to (4, True, 101, 5, [('cats',)], 'target cannot be the same connection instance', 4)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\'cats.db\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.commit() if False else None\\nc.close(); c = sqlite3.connect(\\'cats.db\\', isolation_level=None)\\nbk = sqlite3.connect(\\'backup.db\\', isolation_level=None)\\nprog = []\\nc.backup(bk, pages=1, progress=lambda status, remaining, total: prog.append((status, remaining, total)))\\nm = sqlite3.connect(\\':memory:\\', isolation_level=None); c.backup(m)\\nm.execute(\\x22INSERT INTO cats VALUES (\\'Mem\\', \\'2024-01-01\\', \\'x\\', 1)\\x22); f = sqlite3.connect(\\'mem.db\\', isolation_level=None); m.backup(f)\\nt = sqlite3.connect(\\'target.db\\', isolation_level=None); t.execute(\\'CREATE TABLE other (a)\\'); c.backup(t)\\ntry:\\n    c.backup(c)\\nexcept ValueError as e:\\n    same = str(e)\\nout = (bk.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], len(prog) > 1, prog[-1][0], f.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], t.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22).fetchall(), same, c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0])', g), g['out'])[1])({})" ; chx:output "(4, True, 101, 5, [('cats',)], 'target cannot be the same connection instance', 4)" .
chx:X_BackupMethod rd:hasIOExample chx:IO_BackupMethod .
chx:X_DumpMethod a owl:NamedIndividual, chx:DumpMethod ; rdfs:label "conn.iterdump()"@en ; skos:definition "iterdump() on a small database yielded 8 lines from BEGIN TRANSACTION; to COMMIT; with the table, four INSERT INTO 'cats' lines (the name in double quotes) and the index, running them with executescript in an empty database rebuilt identical rows, and filter='cats' left out the index line (7 lines)."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DumpMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\')\\nlines = list(c.iterdump())\\nd = sqlite3.connect(\\':memory:\\'); d.executescript(\\'\\\\n\\'.join(lines))\\nout = (lines[:3], lines[-2:], len(lines), d.execute(\\'SELECT * FROM cats\\').fetchall() == c.execute(\\'SELECT * FROM cats\\').fetchall(), len(list(c.iterdump(filter=\\'cats\\'))), sum(len(l) + 1 for l in lines))', g), g['out'])[1])({}) evaluates to (['BEGIN TRANSACTION;', 'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT;', 'INSERT INTO 'cats' VALUES(\\'Zophie\\',\\'2021-01-24\\',\\'black\\',5.6);'], ['CREATE INDEX idx_name ON cats (name);', 'COMMIT;'], 8, True, 7, 412)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nc = sqlite3.connect(\\':memory:\\', isolation_level=None)\\nc.execute(\\'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT\\')\\nc.executemany(\\'INSERT INTO cats VALUES (?, ?, ?, ?)\\', [(\\'Zophie\\', \\'2021-01-24\\', \\'black\\', 5.6), (\\'Miguel\\', \\'2016-12-24\\', \\'siamese\\', 6.2), (\\'Jacob\\', \\'2022-02-20\\', \\'orange and white\\', 5.5), (\\'Toby\\', \\'2021-05-17\\', \\'black\\', 6.8)])\\nc.execute(\\'CREATE INDEX idx_name ON cats (name)\\')\\nlines = list(c.iterdump())\\nd = sqlite3.connect(\\':memory:\\'); d.executescript(\\'\\\\n\\'.join(lines))\\nout = (lines[:3], lines[-2:], len(lines), d.execute(\\'SELECT * FROM cats\\').fetchall() == c.execute(\\'SELECT * FROM cats\\').fetchall(), len(list(c.iterdump(filter=\\'cats\\'))), sum(len(l) + 1 for l in lines))', g), g['out'])[1])({})" ; chx:output "(['BEGIN TRANSACTION;', 'CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT;', 'INSERT INTO 'cats' VALUES(\\'Zophie\\',\\'2021-01-24\\',\\'black\\',5.6);'], ['CREATE INDEX idx_name ON cats (name);', 'COMMIT;'], 8, True, 7, 412)" .
chx:X_DumpMethod rd:hasIOExample chx:IO_DumpMethod .
chx:X_DumpShippedFails a owl:NamedIndividual, chx:DumpShippedFails ; rdfs:label "conn.iterdump() on sweigartcats.db"@en ; skos:definition "On the shipped sweigartcats.db the chapter's iterdump() loop raised OperationalError: foreign key mismatch - 'vaccinations' referencing 'cats', as did iterdump(filter='cats') and PRAGMA foreign_key_check, although the file holds 100 cats and 2 schema objects that were read without trouble."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DumpShippedFails a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(db, isolation_level=None)\\nres = []\\ntry:\\n    res.append(len(list(c.iterdump())))\\nexcept sqlite3.OperationalError as e:\\n    res.append(str(e))\\ntry:\\n    res.append(c.execute(\\'PRAGMA foreign_key_check\\').fetchall())\\nexcept sqlite3.OperationalError as e:\\n    res.append(str(e))\\ntry:\\n    res.append(len(list(c.iterdump(filter=\\'cats\\'))))\\nexcept sqlite3.OperationalError as e:\\n    res.append(str(e))\\nres.append((c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], len([r[0] for r in c.execute(\\'SELECT sql FROM sqlite_schema WHERE sql IS NOT NULL\\')])))\\nout = res', g), g['out'])[1])({}) evaluates to ['foreign key mismatch - 'vaccinations' referencing 'cats'', 'foreign key mismatch - 'vaccinations' referencing 'cats'', 'foreign key mismatch - 'vaccinations' referencing 'cats'', (100, 2)]"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(db, isolation_level=None)\\nres = []\\ntry:\\n    res.append(len(list(c.iterdump())))\\nexcept sqlite3.OperationalError as e:\\n    res.append(str(e))\\ntry:\\n    res.append(c.execute(\\'PRAGMA foreign_key_check\\').fetchall())\\nexcept sqlite3.OperationalError as e:\\n    res.append(str(e))\\ntry:\\n    res.append(len(list(c.iterdump(filter=\\'cats\\'))))\\nexcept sqlite3.OperationalError as e:\\n    res.append(str(e))\\nres.append((c.execute(\\'SELECT count(*) FROM cats\\').fetchone()[0], len([r[0] for r in c.execute(\\'SELECT sql FROM sqlite_schema WHERE sql IS NOT NULL\\')])))\\nout = res', g), g['out'])[1])({})" ; chx:output "['foreign key mismatch - 'vaccinations' referencing 'cats'', 'foreign key mismatch - 'vaccinations' referencing 'cats'', 'foreign key mismatch - 'vaccinations' referencing 'cats'', (100, 2)]" .
chx:X_DumpShippedFails rd:hasIOExample chx:IO_DumpShippedFails .
chx:X_SqliteCli a owl:NamedIndividual, chx:SqliteCli ; rdfs:label "sqlite3 example.db"@en ; skos:definition "The sqlite3 shell of release 3.54.0, run on a script from standard input, printed Zophie|2021-01-24|gray tabby|4.7 for a SELECT, listed cats for .tables, printed the header line name|birthdate|fur|weight_kg after .headers on, executed a last statement that lacked its semicolon at the end of input, and began its .dump with PRAGMA foreign_keys=OFF; and BEGIN TRANSACTION;."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SqliteCli a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, subprocess, tempfile, zipfile, hashlib, io, urllib.request\\ndef cli():\\n    p = os.environ.get(\\'CH16_SQLITE3\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sqlite3_3540000\\')\\n    if not os.path.exists(p):\\n        z = urllib.request.urlopen(\\'https://sqlite.org/2026/sqlite-tools-linux-x64-3540000.zip\\', timeout=120).read()\\n        assert hashlib.sha3_256(z).hexdigest() == \\'283ee891049f180c74f56bab4fbcbc96e9acf3b3218a8b0d72771569a9cb8246\\'\\n        open(p + \\'.part\\', \\'wb\\').write(zipfile.ZipFile(io.BytesIO(z)).read(\\'sqlite3\\')); os.chmod(p + \\'.part\\', 0o755); os.replace(p + \\'.part\\', p)\\n    return p\\nos.chdir(tempfile.mkdtemp())\\nrun = lambda s: subprocess.run([cli(), \\'example.db\\'], input=s, capture_output=True, text=True)\\nr1 = run(\\x22CREATE TABLE IF NOT EXISTS cats (name TEXT NOT NULL,\\\\nbirthdate TEXT, fur TEXT, weight_kg REAL) STRICT;\\\\nINSERT INTO cats VALUES (\\'Zophie\\', \\'2021-01-24\\', \\'gray tabby\\', 4.7);\\\\nSELECT * from cats;\\\\n.tables\\\\n.headers on\\\\nSELECT * from cats;\\\\n\\x22)\\nr2 = run(\\x22SELECT * from cats\\\\n\\x22)\\nr3 = run(\\'.dump\\\\n\\')\\nout = (subprocess.run([cli(), \\'--version\\'], capture_output=True, text=True).stdout.split()[0], r1.stdout.splitlines(), r2.stdout, r2.returncode, r3.stdout.splitlines()[:3])', g), g['out'])[1])({}) evaluates to ('3.54.0', ['Zophie|2021-01-24|gray tabby|4.7', 'cats', 'name|birthdate|fur|weight_kg', 'Zophie|2021-01-24|gray tabby|4.7'], 'Zophie|2021-01-24|gray tabby|4.7\\n', 0, ['PRAGMA foreign_keys=OFF;', 'BEGIN TRANSACTION;', 'CREATE TABLE cats (name TEXT NOT NULL,'])"@en ; chx:input "(lambda g: (exec('import os, subprocess, tempfile, zipfile, hashlib, io, urllib.request\\ndef cli():\\n    p = os.environ.get(\\'CH16_SQLITE3\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sqlite3_3540000\\')\\n    if not os.path.exists(p):\\n        z = urllib.request.urlopen(\\'https://sqlite.org/2026/sqlite-tools-linux-x64-3540000.zip\\', timeout=120).read()\\n        assert hashlib.sha3_256(z).hexdigest() == \\'283ee891049f180c74f56bab4fbcbc96e9acf3b3218a8b0d72771569a9cb8246\\'\\n        open(p + \\'.part\\', \\'wb\\').write(zipfile.ZipFile(io.BytesIO(z)).read(\\'sqlite3\\')); os.chmod(p + \\'.part\\', 0o755); os.replace(p + \\'.part\\', p)\\n    return p\\nos.chdir(tempfile.mkdtemp())\\nrun = lambda s: subprocess.run([cli(), \\'example.db\\'], input=s, capture_output=True, text=True)\\nr1 = run(\\x22CREATE TABLE IF NOT EXISTS cats (name TEXT NOT NULL,\\\\nbirthdate TEXT, fur TEXT, weight_kg REAL) STRICT;\\\\nINSERT INTO cats VALUES (\\'Zophie\\', \\'2021-01-24\\', \\'gray tabby\\', 4.7);\\\\nSELECT * from cats;\\\\n.tables\\\\n.headers on\\\\nSELECT * from cats;\\\\n\\x22)\\nr2 = run(\\x22SELECT * from cats\\\\n\\x22)\\nr3 = run(\\'.dump\\\\n\\')\\nout = (subprocess.run([cli(), \\'--version\\'], capture_output=True, text=True).stdout.split()[0], r1.stdout.splitlines(), r2.stdout, r2.returncode, r3.stdout.splitlines()[:3])', g), g['out'])[1])({})" ; chx:output "('3.54.0', ['Zophie|2021-01-24|gray tabby|4.7', 'cats', 'name|birthdate|fur|weight_kg', 'Zophie|2021-01-24|gray tabby|4.7'], 'Zophie|2021-01-24|gray tabby|4.7\\n', 0, ['PRAGMA foreign_keys=OFF;', 'BEGIN TRANSACTION;', 'CREATE TABLE cats (name TEXT NOT NULL,'])" .
chx:X_SqliteCli rd:hasIOExample chx:IO_SqliteCli .
chx:X_CliInteractive a owl:NamedIndividual, chx:CliInteractive ; rdfs:label "sqlite> prompt and the box output of a terminal"@en ; skos:definition "Run in a terminal (a pseudo-terminal here), the shell of 3.54.0 printed the banner SQLite version 3.54.0 2026-10-09 15:46:58 and Enter '.help' for usage hints., a prompt of the form SQLite-3.54 example.db-> instead of sqlite>, a continuation marker such as ); for an unfinished statement, and drew the result as a box with the header already shown, so .headers on changed nothing."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:X_PythonShell a owl:NamedIndividual, chx:PythonShell ; rdfs:label "python -m sqlite3 example.db"@en ; skos:definition "python -m sqlite3 example.db opened an interactive shell inside Python with no installation: statements typed at the sqlite> prompt ran, the row inserted came back as ('Zophie', '2021-01-24', 'gray tabby', 4.7), .version printed 3.53.1, and the banner said sqlite3 shell, running on SQLite version 3.53.1."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_PythonShell a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import subprocess, sys, tempfile, os\\nos.chdir(tempfile.mkdtemp())\\nr = subprocess.run([sys.executable, \\'-m\\', \\'sqlite3\\', \\'example.db\\'], input=\\x22CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT;\\\\nINSERT INTO cats VALUES (\\'Zophie\\', \\'2021-01-24\\', \\'gray tabby\\', 4.7);\\\\nSELECT * FROM cats;\\\\n.version\\\\n\\x22, capture_output=True, text=True)\\nout = (r.returncode, r.stdout.splitlines(), r.stderr.splitlines()[:2])', g), g['out'])[1])({}) evaluates to (0, ['sqlite> sqlite> sqlite> ('Zophie', '2021-01-24', 'gray tabby', 4.7)', 'sqlite> 3.53.1', 'sqlite> '], ['sqlite3 shell, running on SQLite version 3.53.1', 'Connected to 'example.db''])"@en ; chx:input "(lambda g: (exec('import subprocess, sys, tempfile, os\\nos.chdir(tempfile.mkdtemp())\\nr = subprocess.run([sys.executable, \\'-m\\', \\'sqlite3\\', \\'example.db\\'], input=\\x22CREATE TABLE cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT;\\\\nINSERT INTO cats VALUES (\\'Zophie\\', \\'2021-01-24\\', \\'gray tabby\\', 4.7);\\\\nSELECT * FROM cats;\\\\n.version\\\\n\\x22, capture_output=True, text=True)\\nout = (r.returncode, r.stdout.splitlines(), r.stderr.splitlines()[:2])', g), g['out'])[1])({})" ; chx:output "(0, ['sqlite> sqlite> sqlite> ('Zophie', '2021-01-24', 'gray tabby', 4.7)', 'sqlite> 3.53.1', 'sqlite> '], ['sqlite3 shell, running on SQLite version 3.53.1', 'Connected to 'example.db''])" .
chx:X_PythonShell rd:hasIOExample chx:IO_PythonShell .
chx:X_GuiApps a owl:NamedIndividual, chx:GuiApps ; rdfs:label "DB Browser for SQLite, SQLite Studio, DBeaver Community"@en ; skos:definition "The three apps of the chapter were not installed or run; their project pages were read, DB Browser for SQLite described itself as a high quality, visual, open source tool to create, search and edit SQLite files, the page at sqlitestudio.pl now presented Letos, formerly known as SQLiteStudio, and DBeaver Community as a free open-source tool for many databases."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:X_VaccinationChecker a owl:NamedIndividual, chx:VaccinationChecker ; rdfs:label "Cat Vaccination Checker"@en ; skos:definition "A program that walks the cats of the shipped database and compares each cat's vaccines with rabies, FeLV and FVRCP found 7 cats lacking one or two of them (Molly 17 rabies, Sage 19 FeLV, Hugh 42 FVRCP, Chester 43 FeLV and rabies, Snowflake 88 FeLV and rabies, Luke 93 FVRCP, Muffin 96 FVRCP), none lacking all three, and a join found 3 vaccines dated before the cat's birth (Ruby, Java and Rocket)."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_VaccinationChecker a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(db, isolation_level=None)\\nneeded = (\\'rabies\\', \\'FeLV\\', \\'FVRCP\\')\\nmissing = {}\\nfor rowid, name in c.execute(\\'SELECT rowid, name FROM cats ORDER BY rowid\\').fetchall():\\n    have = {r[0] for r in c.execute(\\'SELECT vaccine FROM vaccinations WHERE cat_id = ?\\', [rowid])}\\n    if set(needed) - have:\\n        missing[(rowid, name)] = sorted(set(needed) - have)\\nearly = c.execute(\\'SELECT cats.name, v.vaccine, v.date_administered, cats.birthdate FROM vaccinations v JOIN cats ON cats.rowid = v.cat_id WHERE v.date_administered < cats.birthdate\\').fetchall()\\nout = (len(missing), missing, early, sum(1 for k in missing if len(missing[k]) == 3))', g), g['out'])[1])({}) evaluates to (7, {(17, 'Molly'): ['rabies'], (19, 'Sage'): ['FeLV'], (42, 'Hugh'): ['FVRCP'], (43, 'Chester'): ['FeLV', 'rabies'], (88, 'Snowflake'): ['FeLV', 'rabies'], (93, 'Luke'): ['FVRCP'], (96, 'Muffin'): ['FVRCP']}, [('Ruby', 'FVRCP', '2004-12-24', '2023-12-22'), ('Java', 'FVRCP', '2001-03-13', '2019-12-19'), ('Rocket', 'FVRCP', '2003-12-25', '2013-03-28')], 0)"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, zipfile, hashlib, shutil, urllib.request\\ndef real_db():\\n    p = os.environ.get(\\'CH16_DB\\') or os.path.join(tempfile.gettempdir(), \\'ch16_sweigartcats_41f0d0b5.db\\')\\n    if not os.path.exists(p):\\n        rq = urllib.request.Request(\\'https://nostarch.com/download/code/Automate_the_Boring_Stuff_3e_onlinematerials.zip\\', headers={\\'User-Agent\\': \\'Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0\\'})\\n        z = zipfile.ZipFile(io.BytesIO(urllib.request.urlopen(rq, timeout=120).read()))\\n        open(p + \\'.part\\', \\'wb\\').write(z.read(\\'Automate_the_Boring_Stuff_3e_onlinematerials/sweigartcats.db\\')); os.replace(p + \\'.part\\', p)\\n    assert hashlib.sha256(open(p, \\'rb\\').read()).hexdigest().startswith(\\'41f0d0b5bc2e\\')\\n    d = tempfile.mkdtemp(); shutil.copy(p, os.path.join(d, \\'sweigartcats.db\\')); os.chdir(d); return \\'sweigartcats.db\\'\\ndb = real_db(); c = sqlite3.connect(db, isolation_level=None)\\nneeded = (\\'rabies\\', \\'FeLV\\', \\'FVRCP\\')\\nmissing = {}\\nfor rowid, name in c.execute(\\'SELECT rowid, name FROM cats ORDER BY rowid\\').fetchall():\\n    have = {r[0] for r in c.execute(\\'SELECT vaccine FROM vaccinations WHERE cat_id = ?\\', [rowid])}\\n    if set(needed) - have:\\n        missing[(rowid, name)] = sorted(set(needed) - have)\\nearly = c.execute(\\'SELECT cats.name, v.vaccine, v.date_administered, cats.birthdate FROM vaccinations v JOIN cats ON cats.rowid = v.cat_id WHERE v.date_administered < cats.birthdate\\').fetchall()\\nout = (len(missing), missing, early, sum(1 for k in missing if len(missing[k]) == 3))', g), g['out'])[1])({})" ; chx:output "(7, {(17, 'Molly'): ['rabies'], (19, 'Sage'): ['FeLV'], (42, 'Hugh'): ['FVRCP'], (43, 'Chester'): ['FeLV', 'rabies'], (88, 'Snowflake'): ['FeLV', 'rabies'], (93, 'Luke'): ['FVRCP'], (96, 'Muffin'): ['FVRCP']}, [('Ruby', 'FVRCP', '2004-12-24', '2023-12-22'), ('Java', 'FVRCP', '2001-03-13', '2019-12-19'), ('Rocket', 'FVRCP', '2003-12-25', '2013-03-28')], 0)" .
chx:X_VaccinationChecker rd:hasIOExample chx:IO_VaccinationChecker .
chx:X_MealIngredients a owl:NamedIndividual, chx:MealIngredients ; rdfs:label "meal:ingredient1,ingredient2"@en ; skos:definition "The second practice program fails as the book specifies it: with meals (name TEXT) and a foreign key REFERENCES meals (rowid) and PRAGMA foreign_keys = ON, the first INSERT exits with foreign key mismatch - 'ingredients' referencing 'meals', and with meals (id INTEGER PRIMARY KEY, name TEXT) and REFERENCES meals (id) the same program (run here inside Python, with input() fed the sample lines) printed the chapter's sample run: Meal added for onigiri and chicken and rice, the four ingredients of onigiri, chicken as an ingredient of chicken and rice, and rice in two meals."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_MealIngredients a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, contextlib\\nSCRIPT = \\'\\'\\'\\nimport sqlite3\\nconn = sqlite3.connect(\\\\x27meals.db\\\\x27, isolation_level=None)\\nconn.execute(\\\\x27PRAGMA foreign_keys = ON\\\\x27)\\nconn.execute(\\\\x27CREATE TABLE IF NOT EXISTS meals (MEALCOLS) STRICT\\\\x27)\\nconn.execute(\\\\x27CREATE TABLE IF NOT EXISTS ingredients (name TEXT, meal_id INTEGER, FOREIGN KEY(meal_id) REFERENCES meals (FKCOL)) STRICT\\\\x27)\\nwhile True:\\n    line = input(\\\\x27> \\\\x27).strip()\\n    if line == \\\\x27quit\\\\x27:\\n        break\\n    if \\\\x27:\\\\x27 in line:\\n        meal, rest = line.split(\\\\x27:\\\\x27, 1)\\n        cur = conn.execute(\\\\x27INSERT INTO meals (name) VALUES (?)\\\\x27, [meal])\\n        conn.executemany(\\\\x27INSERT INTO ingredients VALUES (?, ?)\\\\x27, [(i.strip(), cur.lastrowid) for i in rest.split(\\\\x27,\\\\x27)])\\n        print(\\\\x27Meal added:\\\\x27, meal)\\n        continue\\n    ings = [r[0] for r in conn.execute(\\\\x27SELECT i.name FROM ingredients i JOIN meals m ON m.MEALKEY = i.meal_id WHERE m.name = ? ORDER BY i.rowid\\\\x27, [line])]\\n    if ings:\\n        print(\\\\x27Ingredients of \\\\x27 + line + \\\\x27:\\\\x27)\\n        for i in ings: print(\\\\x27 \\\\x27, i)\\n    used = [r[0] for r in conn.execute(\\\\x27SELECT m.name FROM meals m JOIN ingredients i ON m.MEALKEY = i.meal_id WHERE i.name = ? ORDER BY m.rowid\\\\x27, [line])]\\n    if used:\\n        print(\\\\x27Meals that use \\\\x27 + line + \\\\x27:\\\\x27)\\n        for m in used: print(\\\\x27 \\\\x27, m)\\n\\'\\'\\'\\nimport traceback\\nINP = \\'onigiri:rice,nori,salt,sesame seeds\\\\nchicken and rice:chicken,rice,cream of chicken soup\\\\nonigiri\\\\nchicken\\\\nrice\\\\nquit\\\\n\\'\\ndef run(s):\\n    lines = iter(INP.splitlines()); sout = io.StringIO()\\n    def inp(prompt=\\'\\'):\\n        sout.write(prompt); return next(lines)\\n    ns = {\\'input\\': inp, \\'__name__\\': \\'__main__\\'}; code = 0; err = \\'\\'\\n    try:\\n        with contextlib.redirect_stdout(sout):\\n            exec(s, ns)\\n    except Exception as e:\\n        code = 1; err = traceback.format_exception_only(type(e), e)[-1].strip()\\n    finally:\\n        if \\'conn\\' in ns: ns[\\'conn\\'].close()\\n    return code, err, sout.getvalue()\\nbad = run(SCRIPT.replace(\\'MEALCOLS\\', \\'name TEXT\\').replace(\\'FKCOL\\', \\'rowid\\').replace(\\'MEALKEY\\', \\'rowid\\'))\\nos.remove(\\'meals.db\\')\\nr = run(SCRIPT.replace(\\'MEALCOLS\\', \\'id INTEGER PRIMARY KEY, name TEXT\\').replace(\\'FKCOL\\', \\'id\\').replace(\\'MEALKEY\\', \\'id\\'))\\nout = (bad[0], bad[1], r[0], r[2], r[1][-120:])', g), g['out'])[1])({}) evaluates to (1, 'sqlite3.OperationalError: foreign key mismatch - 'ingredients' referencing 'meals'', 0, '> Meal added: onigiri\\n> Meal added: chicken and rice\\n> Ingredients of onigiri:\\n  rice\\n  nori\\n  salt\\n  sesame seeds\\n> Meals that use chicken:\\n  chicken and rice\\n> Meals that use rice:\\n  onigiri\\n  chicken and rice\\n> ', '')"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport io, contextlib\\nSCRIPT = \\'\\'\\'\\nimport sqlite3\\nconn = sqlite3.connect(\\\\x27meals.db\\\\x27, isolation_level=None)\\nconn.execute(\\\\x27PRAGMA foreign_keys = ON\\\\x27)\\nconn.execute(\\\\x27CREATE TABLE IF NOT EXISTS meals (MEALCOLS) STRICT\\\\x27)\\nconn.execute(\\\\x27CREATE TABLE IF NOT EXISTS ingredients (name TEXT, meal_id INTEGER, FOREIGN KEY(meal_id) REFERENCES meals (FKCOL)) STRICT\\\\x27)\\nwhile True:\\n    line = input(\\\\x27> \\\\x27).strip()\\n    if line == \\\\x27quit\\\\x27:\\n        break\\n    if \\\\x27:\\\\x27 in line:\\n        meal, rest = line.split(\\\\x27:\\\\x27, 1)\\n        cur = conn.execute(\\\\x27INSERT INTO meals (name) VALUES (?)\\\\x27, [meal])\\n        conn.executemany(\\\\x27INSERT INTO ingredients VALUES (?, ?)\\\\x27, [(i.strip(), cur.lastrowid) for i in rest.split(\\\\x27,\\\\x27)])\\n        print(\\\\x27Meal added:\\\\x27, meal)\\n        continue\\n    ings = [r[0] for r in conn.execute(\\\\x27SELECT i.name FROM ingredients i JOIN meals m ON m.MEALKEY = i.meal_id WHERE m.name = ? ORDER BY i.rowid\\\\x27, [line])]\\n    if ings:\\n        print(\\\\x27Ingredients of \\\\x27 + line + \\\\x27:\\\\x27)\\n        for i in ings: print(\\\\x27 \\\\x27, i)\\n    used = [r[0] for r in conn.execute(\\\\x27SELECT m.name FROM meals m JOIN ingredients i ON m.MEALKEY = i.meal_id WHERE i.name = ? ORDER BY m.rowid\\\\x27, [line])]\\n    if used:\\n        print(\\\\x27Meals that use \\\\x27 + line + \\\\x27:\\\\x27)\\n        for m in used: print(\\\\x27 \\\\x27, m)\\n\\'\\'\\'\\nimport traceback\\nINP = \\'onigiri:rice,nori,salt,sesame seeds\\\\nchicken and rice:chicken,rice,cream of chicken soup\\\\nonigiri\\\\nchicken\\\\nrice\\\\nquit\\\\n\\'\\ndef run(s):\\n    lines = iter(INP.splitlines()); sout = io.StringIO()\\n    def inp(prompt=\\'\\'):\\n        sout.write(prompt); return next(lines)\\n    ns = {\\'input\\': inp, \\'__name__\\': \\'__main__\\'}; code = 0; err = \\'\\'\\n    try:\\n        with contextlib.redirect_stdout(sout):\\n            exec(s, ns)\\n    except Exception as e:\\n        code = 1; err = traceback.format_exception_only(type(e), e)[-1].strip()\\n    finally:\\n        if \\'conn\\' in ns: ns[\\'conn\\'].close()\\n    return code, err, sout.getvalue()\\nbad = run(SCRIPT.replace(\\'MEALCOLS\\', \\'name TEXT\\').replace(\\'FKCOL\\', \\'rowid\\').replace(\\'MEALKEY\\', \\'rowid\\'))\\nos.remove(\\'meals.db\\')\\nr = run(SCRIPT.replace(\\'MEALCOLS\\', \\'id INTEGER PRIMARY KEY, name TEXT\\').replace(\\'FKCOL\\', \\'id\\').replace(\\'MEALKEY\\', \\'id\\'))\\nout = (bad[0], bad[1], r[0], r[2], r[1][-120:])', g), g['out'])[1])({})" ; chx:output "(1, 'sqlite3.OperationalError: foreign key mismatch - 'ingredients' referencing 'meals'', 0, '> Meal added: onigiri\\n> Meal added: chicken and rice\\n> Ingredients of onigiri:\\n  rice\\n  nori\\n  salt\\n  sesame seeds\\n> Meals that use chicken:\\n  chicken and rice\\n> Meals that use rice:\\n  onigiri\\n  chicken and rice\\n> ', '')" .
chx:X_MealIngredients rd:hasIOExample chx:IO_MealIngredients .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "the 16 practice questions"@en ; skos:definition "The answers to the 16 questions can be checked in the module: sqlite3.connect('example.db') gives a Connection, CREATE TABLE students (first_name TEXT, last_name TEXT, favorite_color TEXT) creates the table, isolation_level=None gives autocommit, ':memory:' names an in-memory database, backup() copies a database, and typeof showed integer for 1 and real for 1.0."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_PracticeQuestions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport tempfile\\nconn = sqlite3.connect(\\'example.db\\')\\nconn.execute(\\'CREATE TABLE students (first_name TEXT, last_name TEXT, favorite_color TEXT)\\')\\nauto = sqlite3.connect(\\'example.db\\', isolation_level=None)\\nm = sqlite3.connect(\\':memory:\\')\\nm.execute(\\'CREATE TABLE test (a)\\')\\nt = sqlite3.connect(\\':memory:\\')\\nconn.backup(t)\\nout = ([r[0] for r in conn.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22)], auto.isolation_level, m.execute(\\'PRAGMA database_list\\').fetchone()[2], [r[0] for r in t.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22)], conn.execute(\\'SELECT typeof(1), typeof(1.0)\\').fetchone())', g), g['out'])[1])({}) evaluates to (['students'], None, '', ['students'], ('integer', 'real'))"@en ; chx:input "(lambda g: (exec('import os, tempfile, sqlite3, warnings\\nos.chdir(tempfile.mkdtemp())\\nimport tempfile\\nconn = sqlite3.connect(\\'example.db\\')\\nconn.execute(\\'CREATE TABLE students (first_name TEXT, last_name TEXT, favorite_color TEXT)\\')\\nauto = sqlite3.connect(\\'example.db\\', isolation_level=None)\\nm = sqlite3.connect(\\':memory:\\')\\nm.execute(\\'CREATE TABLE test (a)\\')\\nt = sqlite3.connect(\\':memory:\\')\\nconn.backup(t)\\nout = ([r[0] for r in conn.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22)], auto.isolation_level, m.execute(\\'PRAGMA database_list\\').fetchone()[2], [r[0] for r in t.execute(\\x22SELECT name FROM sqlite_schema WHERE type = \\'table\\'\\x22)], conn.execute(\\'SELECT typeof(1), typeof(1.0)\\').fetchone())', g), g['out'])[1])({})" ; chx:output "(['students'], None, '', ['students'], ('integer', 'real'))" .
chx:X_PracticeQuestions rd:hasIOExample chx:IO_PracticeQuestions .
