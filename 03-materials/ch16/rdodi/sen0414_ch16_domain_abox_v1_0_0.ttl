chx:X_SpreadsheetVersusTable a owl:NamedIndividual, chx:SpreadsheetVersusTable ; rdfs:label "conn.execute('SELECT * FROM cats').fetchall()"@en ; skos:definition "A database table is like a spreadsheet laid out as a list of records: one row per record and one named column per kind of value, but every row has the same columns, a query instead of a cell position finds the data, and sqlite3 returns each row as a tuple."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SpreadsheetVersusTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), type(c.execute('SELECT * FROM cats').fetchone()).__name__))))(__import__('sqlite3').connect(':memory:')) evaluates to 'tuple'"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), type(c.execute('SELECT * FROM cats').fetchone()).__name__))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "'tuple'" .
chx:X_SpreadsheetVersusTable rd:hasIOExample chx:IO_SpreadsheetVersusTable .
chx:X_RowidKey a owl:NamedIndividual, chx:RowidKey ; rdfs:label "SELECT rowid, * FROM cats"@en ; skos:definition "Every ordinary SQLite table has a hidden integer key called rowid that SELECT * leaves out; it tells rows apart even when all their values are equal, but a number freed by deleting the last row is given out again, and VACUUM may renumber the rows of a table that has no INTEGER PRIMARY KEY, so a key that must never change is declared INTEGER PRIMARY KEY, with AUTOINCREMENT to forbid reuse."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_RowidKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE t (n TEXT); INSERT INTO t VALUES (\\'a\\'), (\\'b\\'), (\\'c\\'); DELETE FROM t WHERE rowid = 3; INSERT INTO t VALUES (\\'d\\');'), c.execute('SELECT rowid, n FROM t').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [(1, 'a'), (2, 'b'), (3, 'd')]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE t (n TEXT); INSERT INTO t VALUES (\\'a\\'), (\\'b\\'), (\\'c\\'); DELETE FROM t WHERE rowid = 3; INSERT INTO t VALUES (\\'d\\');'), c.execute('SELECT rowid, n FROM t').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[(1, 'a'), (2, 'b'), (3, 'd')]" .
chx:X_RowidKey rd:hasIOExample chx:IO_RowidKey .
chx:X_EmbeddedSingleFile a owl:NamedIndividual, chx:EmbeddedSingleFile ; rdfs:label "sqlite3.connect('example.db')"@en ; skos:definition "SQLite is a library that runs inside the Python program and keeps the whole database in one ordinary file that begins with the text 'SQLite format 3'; there is no server process, no installation, no network connection and no users or GRANT statements."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_EmbeddedSingleFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p: next(reversed((__import__('sqlite3').connect(p).execute('CREATE TABLE t (a)'), open(p, 'rb').read(15)))))(__import__('tempfile').mkdtemp() + '/example.db') evaluates to b'SQLite format 3'"@en ; chx:input "(lambda p: next(reversed((__import__('sqlite3').connect(p).execute('CREATE TABLE t (a)'), open(p, 'rb').read(15)))))(__import__('tempfile').mkdtemp() + '/example.db')" ; chx:output "b'SQLite format 3'" .
chx:X_EmbeddedSingleFile rd:hasIOExample chx:IO_EmbeddedSingleFile .
chx:X_WriterLimit a owl:NamedIndividual, chx:WriterLimit ; rdfs:label "conn.execute('BEGIN IMMEDIATE')"@en ; skos:definition "SQLite allows one writer at a time per database file: a second connection that wants to write waits for the connect timeout, five seconds by default, and then raises OperationalError: database is locked, which suits most programs but not hundreds of simultaneous writers."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:X_ConnectCall a owl:NamedIndividual, chx:ConnectCall ; rdfs:label "conn = sqlite3.connect('example.db', isolation_level=None)"@en ; skos:definition "sqlite3.connect opens a database file, creating an empty one when it does not exist, or the name ':memory:' for a private database in memory, and returns a Connection; a file that is not a SQLite database raises DatabaseError: file is not a database when the first query runs."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ConnectCall a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: c.execute('PRAGMA database_list').fetchall())(__import__('sqlite3').connect(':memory:')) evaluates to [(0, 'main', '')]"@en ; chx:input "(lambda c: c.execute('PRAGMA database_list').fetchall())(__import__('sqlite3').connect(':memory:'))" ; chx:output "[(0, 'main', '')]" .
chx:X_ConnectCall rd:hasIOExample chx:IO_ConnectCall .
chx:X_ConnectionClose a owl:NamedIndividual, chx:ConnectionClose ; rdfs:label "conn.close()"@en ; skos:definition "close ends the connection and, in the default and the isolation_level=None modes, commits nothing for you; using a closed connection raises ProgrammingError, and since Python 3.13 a connection deleted without a close call emits a ResourceWarning."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:X_StorageClasses a owl:NamedIndividual, chx:StorageClasses ; rdfs:label "SELECT typeof(1), typeof(1.5)"@en ; skos:definition "SQLite stores every value in one of five storage classes, NULL, INTEGER, REAL, TEXT and BLOB, which sqlite3 maps to None, int, float, str and bytes; there is no Boolean, so True is stored as the integer 1, and there is no date type."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_StorageClasses a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: c.execute('SELECT typeof(NULL), typeof(1), typeof(1.5), typeof(\\'a\\'), typeof(x\\'00\\')').fetchone())(__import__('sqlite3').connect(':memory:')) evaluates to ('null', 'integer', 'real', 'text', 'blob')"@en ; chx:input "(lambda c: c.execute('SELECT typeof(NULL), typeof(1), typeof(1.5), typeof(\\'a\\'), typeof(x\\'00\\')').fetchone())(__import__('sqlite3').connect(':memory:'))" ; chx:output "('null', 'integer', 'real', 'text', 'blob')" .
chx:X_StorageClasses rd:hasIOExample chx:IO_StorageClasses .
chx:X_TypeAffinity a owl:NamedIndividual, chx:TypeAffinity ; rdfs:label "INSERT INTO loose VALUES ('42'), ('Hello')"@en ; skos:definition "In an ordinary table a column has only a type affinity: a value that can be converted losslessly to the column's type is converted, so '42' is stored as the integer 42 in an INTEGER column, and a value that cannot be converted, such as 'Hello', is stored as it is without any error."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_TypeAffinity a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE loose (n INTEGER); INSERT INTO loose VALUES (\\'42\\'), (\\'Hello\\'), (3.0), (3.5);'), c.execute('SELECT n, typeof(n) FROM loose').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [(42, 'integer'), ('Hello', 'text'), (3, 'integer'), (3.5, 'real')]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE loose (n INTEGER); INSERT INTO loose VALUES (\\'42\\'), (\\'Hello\\'), (3.0), (3.5);'), c.execute('SELECT n, typeof(n) FROM loose').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[(42, 'integer'), ('Hello', 'text'), (3, 'integer'), (3.5, 'real')]" .
chx:X_TypeAffinity rd:hasIOExample chx:IO_TypeAffinity .
chx:X_StrictTable a owl:NamedIndividual, chx:StrictTable ; rdfs:label "CREATE TABLE cats (name TEXT NOT NULL, weight_kg REAL) STRICT"@en ; skos:definition "The STRICT table option, available from SQLite 3.37.0, requires every column to have one of the types INT, INTEGER, REAL, TEXT, BLOB or ANY and raises IntegrityError for a value that cannot be converted to the column's type, while still converting values that can, so '42' becomes the integer 42."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_StrictTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE s (n INTEGER) STRICT; INSERT INTO s VALUES (\\'42\\');'), c.execute('SELECT n, typeof(n) FROM s').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [(42, 'integer')]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE s (n INTEGER) STRICT; INSERT INTO s VALUES (\\'42\\');'), c.execute('SELECT n, typeof(n) FROM s').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[(42, 'integer')]" .
chx:X_StrictTable rd:hasIOExample chx:IO_StrictTable .
chx:X_DateAsText a owl:NamedIndividual, chx:DateAsText ; rdfs:label "birthdate TEXT"@en ; skos:definition "SQLite has no date or time type, so dates are kept as TEXT in the forms YYYY-MM-DD, YYYY-MM-DD HH:MM:SS and similar; text in the form YYYY-MM-DD sorts and compares in date order, and the SQL functions date() and datetime() calculate with it."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DateAsText a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: c.execute('SELECT date(\\'2035-10-31\\', \\'+1 day\\'), \\'2024-03-19\\' < \\'2024-12-09\\', datetime(\\'2035-10-31 16:30:00\\', \\'+1 hour\\')').fetchone())(__import__('sqlite3').connect(':memory:')) evaluates to ('2035-11-01', 1, '2035-10-31 17:30:00')"@en ; chx:input "(lambda c: c.execute('SELECT date(\\'2035-10-31\\', \\'+1 day\\'), \\'2024-03-19\\' < \\'2024-12-09\\', datetime(\\'2035-10-31 16:30:00\\', \\'+1 hour\\')').fetchone())(__import__('sqlite3').connect(':memory:'))" ; chx:output "('2035-11-01', 1, '2035-10-31 17:30:00')" .
chx:X_DateAsText rd:hasIOExample chx:IO_DateAsText .
chx:X_CreateTable a owl:NamedIndividual, chx:CreateTable ; rdfs:label "CREATE TABLE IF NOT EXISTS cats (name TEXT NOT NULL, birthdate TEXT, fur TEXT, weight_kg REAL) STRICT"@en ; skos:definition "CREATE TABLE names a table and lists its columns with their types and constraints such as NOT NULL; without IF NOT EXISTS a second creation raises OperationalError: table cats already exists, and SQL keywords may be written in lower case."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_CreateTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE IF NOT EXISTS t (a INTEGER NOT NULL, b TEXT) STRICT; CREATE TABLE IF NOT EXISTS t (a INTEGER NOT NULL, b TEXT) STRICT;'), c.execute('SELECT name FROM sqlite_schema').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('t',)]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE IF NOT EXISTS t (a INTEGER NOT NULL, b TEXT) STRICT; CREATE TABLE IF NOT EXISTS t (a INTEGER NOT NULL, b TEXT) STRICT;'), c.execute('SELECT name FROM sqlite_schema').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('t',)]" .
chx:X_CreateTable rd:hasIOExample chx:IO_CreateTable .
chx:X_SchemaTable a owl:NamedIndividual, chx:SchemaTable ; rdfs:label "SELECT name FROM sqlite_schema WHERE type = 'table'"@en ; skos:definition "Every SQLite database has a built-in table sqlite_schema that holds one row for each table and index with its type, name and the SQL that created it, so a query on it lists the tables and the indexes of a table; it is read, never written."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SchemaTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8); CREATE INDEX idx_name ON cats (name);'), c.execute('SELECT type, name FROM sqlite_schema ORDER BY type, name').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('index', 'idx_name'), ('table', 'cats')]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8); CREATE INDEX idx_name ON cats (name);'), c.execute('SELECT type, name FROM sqlite_schema ORDER BY type, name').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('index', 'idx_name'), ('table', 'cats')]" .
chx:X_SchemaTable rd:hasIOExample chx:IO_SchemaTable .
chx:X_TableInfo a owl:NamedIndividual, chx:TableInfo ; rdfs:label "PRAGMA TABLE_INFO(cats)"@en ; skos:definition "PRAGMA table_info(table) returns one tuple for each column: its position counted from 0, its name, its declared type, 1 when it is NOT NULL, its default value and 1 when it is part of the primary key."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_TableInfo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('PRAGMA table_info(cats)').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [(0, 'name', 'TEXT', 1, None, 0), (1, 'fur', 'TEXT', 0, None, 0), (2, 'weight_kg', 'REAL', 0, None, 0)]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('PRAGMA table_info(cats)').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[(0, 'name', 'TEXT', 1, None, 0), (1, 'fur', 'TEXT', 0, None, 0), (2, 'weight_kg', 'REAL', 0, None, 0)]" .
chx:X_TableInfo rd:hasIOExample chx:IO_TableInfo .
chx:X_InsertStatement a owl:NamedIndividual, chx:InsertStatement ; rdfs:label "INSERT INTO cats VALUES ('Zophie', '2021-01-24', 'black', 5.6)"@en ; skos:definition "INSERT INTO table VALUES (...) adds one row whose values are listed in the order of the table's columns; the cursor it returns reports rowcount, the rows added, and lastrowid, the rowid of the new row."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_InsertStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (lambda k: (k.rowcount, k.lastrowid))(c.execute('INSERT INTO cats VALUES (\\'Sassy\\', \\'black\\', 7.5)'))))))(__import__('sqlite3').connect(':memory:')) evaluates to (1, 4)"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (lambda k: (k.rowcount, k.lastrowid))(c.execute('INSERT INTO cats VALUES (\\'Sassy\\', \\'black\\', 7.5)'))))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "(1, 4)" .
chx:X_InsertStatement rd:hasIOExample chx:IO_InsertStatement .
chx:X_Placeholders a owl:NamedIndividual, chx:Placeholders ; rdfs:label "conn.execute('INSERT INTO cats VALUES (?, ?, ?, ?)', [name, bday, fur, weight])"@en ; skos:definition "A ? placeholder, or a :name placeholder with a dict, marks where a Python value goes and the module binds the value separately from the SQL text, so a value can never change the meaning of the query; building the SQL with an f-string lets input such as x' OR '1'='1 do exactly that."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_Placeholders a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (lambda e: (len(c.execute('SELECT * FROM cats WHERE name = \\'' + e + '\\'').fetchall()), len(c.execute('SELECT * FROM cats WHERE name = ?', (e,)).fetchall())))('x\\' OR \\'1\\'=\\'1')))))(__import__('sqlite3').connect(':memory:')) evaluates to (3, 0)"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (lambda e: (len(c.execute('SELECT * FROM cats WHERE name = \\'' + e + '\\'').fetchall()), len(c.execute('SELECT * FROM cats WHERE name = ?', (e,)).fetchall())))('x\\' OR \\'1\\'=\\'1')))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "(3, 0)" .
chx:X_Placeholders rd:hasIOExample chx:IO_Placeholders .
chx:X_ManyRows a owl:NamedIndividual, chx:ManyRows ; rdfs:label "conn.executemany('INSERT INTO cats VALUES (?, ?, ?)', rows)"@en ; skos:definition "executemany runs one parameterised INSERT, UPDATE or DELETE once for every item of an iterable of parameters, in a single call and a single transaction, and its cursor reports the total rows changed."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ManyRows a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.executemany('INSERT INTO cats VALUES (?, ?, ?)', [('Iris', 'bengal', 6.8), ('Ruby', 'bengal', 5.0)]).rowcount))))(__import__('sqlite3').connect(':memory:')) evaluates to 2"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.executemany('INSERT INTO cats VALUES (?, ?, ?)', [('Iris', 'bengal', 6.8), ('Ruby', 'bengal', 5.0)]).rowcount))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "2" .
chx:X_ManyRows rd:hasIOExample chx:IO_ManyRows .
chx:X_UpdateStatement a owl:NamedIndividual, chx:UpdateStatement ; rdfs:label "UPDATE cats SET fur = 'gray tabby' WHERE rowid = 1"@en ; skos:definition "UPDATE table SET column = value WHERE condition changes every row for which the condition is true, and every row of the table when the WHERE clause is forgotten, which is why the clause is written even for a change meant for all rows, as WHERE 1."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_UpdateStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('UPDATE cats SET fur = \\'gray\\' WHERE rowid = 1').rowcount, c.execute('UPDATE cats SET fur = \\'gray\\'').rowcount)))))(__import__('sqlite3').connect(':memory:')) evaluates to (1, 3)"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('UPDATE cats SET fur = \\'gray\\' WHERE rowid = 1').rowcount, c.execute('UPDATE cats SET fur = \\'gray\\'').rowcount)))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "(1, 3)" .
chx:X_UpdateStatement rd:hasIOExample chx:IO_UpdateStatement .
chx:X_DeleteStatement a owl:NamedIndividual, chx:DeleteStatement ; rdfs:label "DELETE FROM cats WHERE rowid = 1"@en ; skos:definition "DELETE FROM table WHERE condition removes every row for which the condition is true, and all rows when the WHERE clause is missing; it reports the rows removed in rowcount."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DeleteStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('DELETE FROM cats WHERE fur = \\'black\\'').rowcount))))(__import__('sqlite3').connect(':memory:')) evaluates to 2"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('DELETE FROM cats WHERE fur = \\'black\\'').rowcount))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "2" .
chx:X_DeleteStatement rd:hasIOExample chx:IO_DeleteStatement .
chx:X_SelectStatement a owl:NamedIndividual, chx:SelectStatement ; rdfs:label "SELECT rowid, name FROM cats"@en ; skos:definition "SELECT columns FROM table reads rows; * means every column except rowid, and naming rowid asks for it explicitly."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_SelectStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT rowid, name FROM cats').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [(1, 'Zophie'), (2, 'Miguel'), (3, 'Toby')]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT rowid, name FROM cats').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[(1, 'Zophie'), (2, 'Miguel'), (3, 'Toby')]" .
chx:X_SelectStatement rd:hasIOExample chx:IO_SelectStatement .
chx:X_FetchAndIterate a owl:NamedIndividual, chx:FetchAndIterate ; rdfs:label "for row in conn.execute('SELECT * FROM cats'):"@en ; skos:definition "execute returns a cursor that yields tuples once: fetchone takes the next row, fetchmany(n) the next n, fetchall everything left as a list, and a for loop over the cursor needs no fetchall; a cursor that has been read to the end gives nothing more."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_FetchAndIterate a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (lambda k: (k.fetchone(), k.fetchmany(1), k.fetchall(), k.fetchall()))(c.execute('SELECT name FROM cats'))))))(__import__('sqlite3').connect(':memory:')) evaluates to (('Zophie',), [('Miguel',)], [('Toby',)], [])"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (lambda k: (k.fetchone(), k.fetchmany(1), k.fetchall(), k.fetchall()))(c.execute('SELECT name FROM cats'))))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "(('Zophie',), [('Miguel',)], [('Toby',)], [])" .
chx:X_FetchAndIterate rd:hasIOExample chx:IO_FetchAndIterate .
chx:X_WhereFilter a owl:NamedIndividual, chx:WhereFilter ; rdfs:label "SELECT * FROM cats WHERE fur = 'black' OR birthdate >= '2024-01-01'"@en ; skos:definition "A WHERE clause keeps only the rows for which its condition is true; it uses =, !=, <, >, <=, >=, AND, OR and NOT, where a single = tests equality, and it is written before ORDER BY and LIMIT."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_WhereFilter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT name FROM cats WHERE fur = \\'black\\' AND weight_kg > 6').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('Toby',)]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT name FROM cats WHERE fur = \\'black\\' AND weight_kg > 6').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('Toby',)]" .
chx:X_WhereFilter rd:hasIOExample chx:IO_WhereFilter .
chx:X_LikeAndGlob a owl:NamedIndividual, chx:LikeAndGlob ; rdfs:label "SELECT name FROM cats WHERE name LIKE '%y'"@en ; skos:definition "LIKE matches text with % for any run of characters and ignores case for ASCII letters only; GLOB does the same with * and _-free patterns but is case sensitive."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_LikeAndGlob a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: c.execute('SELECT \\'Toby\\' LIKE \\'%OB%\\', \\'Toby\\' GLOB \\'*OB*\\', \\'Toby\\' GLOB \\'*ob*\\'').fetchone())(__import__('sqlite3').connect(':memory:')) evaluates to (1, 0, 1)"@en ; chx:input "(lambda c: c.execute('SELECT \\'Toby\\' LIKE \\'%OB%\\', \\'Toby\\' GLOB \\'*OB*\\', \\'Toby\\' GLOB \\'*ob*\\'').fetchone())(__import__('sqlite3').connect(':memory:'))" ; chx:output "(1, 0, 1)" .
chx:X_LikeAndGlob rd:hasIOExample chx:IO_LikeAndGlob .
chx:X_OrderByClause a owl:NamedIndividual, chx:OrderByClause ; rdfs:label "SELECT * FROM cats ORDER BY fur ASC, birthdate DESC"@en ; skos:definition "ORDER BY sorts the result by one or more columns, ascending unless DESC follows the column, and a later column orders the rows that are equal in the earlier one; rows come in no promised order without it."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_OrderByClause a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT name, fur FROM cats ORDER BY fur ASC, weight_kg DESC').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('Toby', 'black'), ('Zophie', 'black'), ('Miguel', 'siamese')]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT name, fur FROM cats ORDER BY fur ASC, weight_kg DESC').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('Toby', 'black'), ('Zophie', 'black'), ('Miguel', 'siamese')]" .
chx:X_OrderByClause rd:hasIOExample chx:IO_OrderByClause .
chx:X_LimitClause a owl:NamedIndividual, chx:LimitClause ; rdfs:label "SELECT * FROM cats ORDER BY birthdate LIMIT 4"@en ; skos:definition "LIMIT n makes the database stop after n rows instead of reading everything and slicing the list in Python; it is written after WHERE and ORDER BY."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_LimitClause a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT name FROM cats ORDER BY weight_kg DESC LIMIT 2').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('Toby',), ('Miguel',)]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT name FROM cats ORDER BY weight_kg DESC LIMIT 2').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('Toby',), ('Miguel',)]" .
chx:X_LimitClause rd:hasIOExample chx:IO_LimitClause .
chx:X_GroupAndCount a owl:NamedIndividual, chx:GroupAndCount ; rdfs:label "SELECT fur, count(*) FROM cats GROUP BY fur"@en ; skos:definition "GROUP BY puts rows with the same value in one group so that aggregate functions such as count, avg, min and max are computed per group; the chapter leaves it out as one of the clauses beyond its scope."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_GroupAndCount a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT fur, count(*), round(avg(weight_kg), 2) FROM cats GROUP BY fur ORDER BY fur').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('black', 2, 6.2), ('siamese', 1, 6.2)]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), c.execute('SELECT fur, count(*), round(avg(weight_kg), 2) FROM cats GROUP BY fur ORDER BY fur').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('black', 2, 6.2), ('siamese', 1, 6.2)]" .
chx:X_GroupAndCount rd:hasIOExample chx:IO_GroupAndCount .
chx:X_RowFactory a owl:NamedIndividual, chx:RowFactory ; rdfs:label "conn.row_factory = sqlite3.Row"@en ; skos:definition "Setting row_factory to sqlite3.Row makes each row answer to column names as well as to positions, with case-insensitive names and a keys() list, where the default row is a plain tuple that only knows positions."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_RowFactory a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((setattr(c, 'row_factory', __import__('sqlite3').Row), (lambda r: (r['name'], r['WEIGHT_KG'], r.keys()))(c.execute('SELECT \\'Zophie\\' AS name, 5.6 AS weight_kg').fetchone())))))(__import__('sqlite3').connect(':memory:')) evaluates to ('Zophie', 5.6, ['name', 'weight_kg'])"@en ; chx:input "(lambda c: next(reversed((setattr(c, 'row_factory', __import__('sqlite3').Row), (lambda r: (r['name'], r['WEIGHT_KG'], r.keys()))(c.execute('SELECT \\'Zophie\\' AS name, 5.6 AS weight_kg').fetchone())))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "('Zophie', 5.6, ['name', 'weight_kg'])" .
chx:X_RowFactory rd:hasIOExample chx:IO_RowFactory .
chx:X_CreateIndex a owl:NamedIndividual, chx:CreateIndex ; rdfs:label "CREATE INDEX idx_name ON cats (name)"@en ; skos:definition "CREATE INDEX name ON table (column) builds a sorted structure that lets a WHERE on that column search instead of scanning the table, at the price of more storage and slightly slower inserts and updates; DROP INDEX removes it and EXPLAIN QUERY PLAN tells whether a query uses it."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_CreateIndex a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8); CREATE INDEX idx_name ON cats (name);'), c.execute('SELECT name FROM sqlite_schema WHERE type = \\'index\\' AND tbl_name = \\'cats\\'').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('idx_name',)]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8); CREATE INDEX idx_name ON cats (name);'), c.execute('SELECT name FROM sqlite_schema WHERE type = \\'index\\' AND tbl_name = \\'cats\\'').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('idx_name',)]" .
chx:X_CreateIndex rd:hasIOExample chx:IO_CreateIndex .
chx:X_BeginCommitRollback a owl:NamedIndividual, chx:BeginCommitRollback ; rdfs:label "conn.execute('BEGIN')"@en ; skos:definition "BEGIN opens a transaction, commit makes all its changes permanent and rollback discards them, so several statements either all take effect or none does; with isolation_level=None a statement outside BEGIN is its own transaction and rollback then has nothing to undo."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_BeginCommitRollback a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('BEGIN'), c.execute('INSERT INTO cats VALUES (\\'Socks\\', \\'white\\', 4.2)'), c.rollback(), c.execute('SELECT count(*) FROM cats').fetchone()[0], c.execute('BEGIN'), c.execute('INSERT INTO cats VALUES (\\'Socks\\', \\'white\\', 4.2)'), c.commit(), c.execute('SELECT count(*) FROM cats').fetchone()[0])[3::4]))))(__import__('sqlite3').connect(':memory:', isolation_level=None)) evaluates to (3, 4)"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('BEGIN'), c.execute('INSERT INTO cats VALUES (\\'Socks\\', \\'white\\', 4.2)'), c.rollback(), c.execute('SELECT count(*) FROM cats').fetchone()[0], c.execute('BEGIN'), c.execute('INSERT INTO cats VALUES (\\'Socks\\', \\'white\\', 4.2)'), c.commit(), c.execute('SELECT count(*) FROM cats').fetchone()[0])[3::4]))))(__import__('sqlite3').connect(':memory:', isolation_level=None))" ; chx:output "(3, 4)" .
chx:X_BeginCommitRollback rd:hasIOExample chx:IO_BeginCommitRollback .
chx:X_AutocommitModes a owl:NamedIndividual, chx:AutocommitModes ; rdfs:label "sqlite3.connect('example.db', autocommit=False)"@en ; skos:definition "The autocommit argument chooses the transaction behaviour: False keeps a transaction always open until commit or rollback and is the one the documentation recommends, True gives SQLite's own autocommit where commit and rollback do nothing, and the default LEGACY_TRANSACTION_CONTROL lets isolation_level decide, where None, as in the chapter, means no transaction is opened implicitly."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_AutocommitModes a owl:NamedIndividual, rd:IOExample ; rdfs:label "tuple(__import__('sqlite3').connect(':memory:', autocommit=a).in_transaction for a in (False, True)) evaluates to (True, False)"@en ; chx:input "tuple(__import__('sqlite3').connect(':memory:', autocommit=a).in_transaction for a in (False, True))" ; chx:output "(True, False)" .
chx:X_AutocommitModes rd:hasIOExample chx:IO_AutocommitModes .
chx:X_ContextManagerTransaction a owl:NamedIndividual, chx:ContextManagerTransaction ; rdfs:label "with conn: conn.execute(...)"@en ; skos:definition "Using a connection in a with statement commits the open transaction when the block ends normally and rolls it back when the block raises, and it does not close the connection; contextlib.closing closes it."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:X_AcidProperties a owl:NamedIndividual, chx:AcidProperties ; rdfs:label "BEGIN; INSERT ...; COMMIT"@en ; skos:definition "A transaction is atomic (all or nothing), consistent (constraints such as NOT NULL, UNIQUE and CHECK hold at its end), isolated (others do not see its partial work) and durable (once committed it survives a crash); a statement that breaks a constraint raises IntegrityError and its changes are undone."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:X_RenameTableColumn a owl:NamedIndividual, chx:RenameTableColumn ; rdfs:label "ALTER TABLE cats RENAME TO felines"@en ; skos:definition "ALTER TABLE ... RENAME TO changes a table's name and ALTER TABLE ... RENAME COLUMN a TO b a column's name, keeping the data; queries in the program that use the old names must be changed to match."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_RenameTableColumn a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('ALTER TABLE cats RENAME TO felines'), c.execute('ALTER TABLE felines RENAME COLUMN fur TO description'), c.execute('PRAGMA table_info(felines)').fetchall()[1], c.execute('SELECT name FROM sqlite_schema WHERE type = \\'table\\'').fetchall())[2:]))))(__import__('sqlite3').connect(':memory:')) evaluates to ((1, 'description', 'TEXT', 0, None, 0), [('felines',)])"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('ALTER TABLE cats RENAME TO felines'), c.execute('ALTER TABLE felines RENAME COLUMN fur TO description'), c.execute('PRAGMA table_info(felines)').fetchall()[1], c.execute('SELECT name FROM sqlite_schema WHERE type = \\'table\\'').fetchall())[2:]))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "((1, 'description', 'TEXT', 0, None, 0), [('felines',)])" .
chx:X_RenameTableColumn rd:hasIOExample chx:IO_RenameTableColumn .
chx:X_AddDropColumn a owl:NamedIndividual, chx:AddDropColumn ; rdfs:label "ALTER TABLE felines ADD COLUMN is_loved INTEGER DEFAULT 1"@en ; skos:definition "ALTER TABLE ... ADD COLUMN appends a column that existing rows receive as its default value, and ALTER TABLE ... DROP COLUMN removes a column together with its data, but only a column that is not a primary key, not UNIQUE, not indexed and not used by another part of the schema."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_AddDropColumn a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('ALTER TABLE cats ADD COLUMN is_loved INTEGER DEFAULT 1'), c.execute('SELECT * FROM cats LIMIT 1').fetchall(), c.execute('ALTER TABLE cats DROP COLUMN is_loved'), len(c.execute('PRAGMA table_info(cats)').fetchall()))[1::2]))))(__import__('sqlite3').connect(':memory:')) evaluates to ([('Zophie', 'black', 5.6, 1)], 3)"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('ALTER TABLE cats ADD COLUMN is_loved INTEGER DEFAULT 1'), c.execute('SELECT * FROM cats LIMIT 1').fetchall(), c.execute('ALTER TABLE cats DROP COLUMN is_loved'), len(c.execute('PRAGMA table_info(cats)').fetchall()))[1::2]))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "([('Zophie', 'black', 5.6, 1)], 3)" .
chx:X_AddDropColumn rd:hasIOExample chx:IO_AddDropColumn .
chx:X_DropTable a owl:NamedIndividual, chx:DropTable ; rdfs:label "DROP TABLE felines"@en ; skos:definition "DROP TABLE deletes a table with all its rows and cannot be undone except from a backup; DROP TABLE IF EXISTS does not complain about a missing table."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DropTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('DROP TABLE cats'), c.execute('DROP TABLE IF EXISTS cats'), c.execute('SELECT name FROM sqlite_schema WHERE type = \\'table\\'').fetchall())[2]))))(__import__('sqlite3').connect(':memory:')) evaluates to []"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), (c.execute('DROP TABLE cats'), c.execute('DROP TABLE IF EXISTS cats'), c.execute('SELECT name FROM sqlite_schema WHERE type = \\'table\\'').fetchall())[2]))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[]" .
chx:X_DropTable rd:hasIOExample chx:IO_DropTable .
chx:X_ForeignKey a owl:NamedIndividual, chx:ForeignKey ; rdfs:label "FOREIGN KEY(cat_id) REFERENCES cats(id)"@en ; skos:definition "A foreign key is a column of one table whose values must match the parent key of another table, so varying amounts of data, such as many vaccinations for one cat, become rows of a second table that point back to the first; the parent key must be a named PRIMARY KEY or UNIQUE column, and the rowid cannot be named as one."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ForeignKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL, birthdate TEXT) STRICT; CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(id)) STRICT; INSERT INTO cats(name) VALUES (\\'Zophie\\'); INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', 1), (\\'FeLV\\', \\'2023-06-06\\', 99);'), c.execute('PRAGMA foreign_key_check').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('vaccinations', 2, 'cats', 0)]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL, birthdate TEXT) STRICT; CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(id)) STRICT; INSERT INTO cats(name) VALUES (\\'Zophie\\'); INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', 1), (\\'FeLV\\', \\'2023-06-06\\', 99);'), c.execute('PRAGMA foreign_key_check').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('vaccinations', 2, 'cats', 0)]" .
chx:X_ForeignKey rd:hasIOExample chx:IO_ForeignKey .
chx:X_InnerJoin a owl:NamedIndividual, chx:InnerJoin ; rdfs:label "SELECT * FROM cats INNER JOIN vaccinations ON cats.id = vaccinations.cat_id"@en ; skos:definition "An inner join returns one combined row for every pair of rows, one from each table, for which the ON condition holds, so rows without a partner in the other table do not appear."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_InnerJoin a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL, birthdate TEXT) STRICT; CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(id)) STRICT; INSERT INTO cats(name) VALUES (\\'Zophie\\'), (\\'Miguel\\'); INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', 1), (\\'FeLV\\', \\'2023-06-06\\', 1);'), c.execute('SELECT cats.name, vaccinations.vaccine FROM cats INNER JOIN vaccinations ON cats.id = vaccinations.cat_id ORDER BY vaccinations.rowid').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('Zophie', 'rabies'), ('Zophie', 'FeLV')]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL, birthdate TEXT) STRICT; CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(id)) STRICT; INSERT INTO cats(name) VALUES (\\'Zophie\\'), (\\'Miguel\\'); INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', 1), (\\'FeLV\\', \\'2023-06-06\\', 1);'), c.execute('SELECT cats.name, vaccinations.vaccine FROM cats INNER JOIN vaccinations ON cats.id = vaccinations.cat_id ORDER BY vaccinations.rowid').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('Zophie', 'rabies'), ('Zophie', 'FeLV')]" .
chx:X_InnerJoin rd:hasIOExample chx:IO_InnerJoin .
chx:X_LeftJoin a owl:NamedIndividual, chx:LeftJoin ; rdfs:label "SELECT cats.name FROM cats LEFT JOIN vaccinations ON ... WHERE vaccinations.vaccine IS NULL"@en ; skos:definition "A left join keeps every row of the left table and fills the columns of the right table with NULL where no row matches, so testing the right table's column with IS NULL finds the rows that have no partner, such as the cats with no vaccination at all."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_LeftJoin a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL, birthdate TEXT) STRICT; CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(id)) STRICT; INSERT INTO cats(name) VALUES (\\'Zophie\\'), (\\'Miguel\\'); INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', 1);'), c.execute('SELECT cats.name FROM cats LEFT JOIN vaccinations ON cats.id = vaccinations.cat_id WHERE vaccinations.vaccine IS NULL').fetchall()))))(__import__('sqlite3').connect(':memory:')) evaluates to [('Miguel',)]"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL, birthdate TEXT) STRICT; CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(id)) STRICT; INSERT INTO cats(name) VALUES (\\'Zophie\\'), (\\'Miguel\\'); INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', 1);'), c.execute('SELECT cats.name FROM cats LEFT JOIN vaccinations ON cats.id = vaccinations.cat_id WHERE vaccinations.vaccine IS NULL').fetchall()))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "[('Miguel',)]" .
chx:X_LeftJoin rd:hasIOExample chx:IO_LeftJoin .
chx:X_ForeignKeyEnforcement a owl:NamedIndividual, chx:ForeignKeyEnforcement ; rdfs:label "PRAGMA foreign_keys = ON"@en ; skos:definition "SQLite checks foreign keys only after PRAGMA foreign_keys = ON has been run on that connection, which must be done outside a transaction; while it is off, a row that points to a missing parent is accepted silently."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_ForeignKeyEnforcement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: (c.execute('PRAGMA foreign_keys').fetchone(), c.execute('PRAGMA foreign_keys = ON'), c.execute('PRAGMA foreign_keys').fetchone())[::2])(__import__('sqlite3').connect(':memory:')) evaluates to ((0,), (1,))"@en ; chx:input "(lambda c: (c.execute('PRAGMA foreign_keys').fetchone(), c.execute('PRAGMA foreign_keys = ON'), c.execute('PRAGMA foreign_keys').fetchone())[::2])(__import__('sqlite3').connect(':memory:'))" ; chx:output "((0,), (1,))" .
chx:X_ForeignKeyEnforcement rd:hasIOExample chx:IO_ForeignKeyEnforcement .
chx:X_InMemoryDatabase a owl:NamedIndividual, chx:InMemoryDatabase ; rdfs:label "sqlite3.connect(':memory:')"@en ; skos:definition "The name ':memory:' gives a database that lives only in RAM, is fast, and is gone when the connection closes or the program ends; every connection to ':memory:' gets its own separate database."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_InMemoryDatabase a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, b: next(reversed((a.execute('CREATE TABLE t (x)'), b.execute('SELECT name FROM sqlite_schema').fetchall()))))(__import__('sqlite3').connect(':memory:'), __import__('sqlite3').connect(':memory:')) evaluates to []"@en ; chx:input "(lambda a, b: next(reversed((a.execute('CREATE TABLE t (x)'), b.execute('SELECT name FROM sqlite_schema').fetchall()))))(__import__('sqlite3').connect(':memory:'), __import__('sqlite3').connect(':memory:'))" ; chx:output "[]" .
chx:X_InMemoryDatabase rd:hasIOExample chx:IO_InMemoryDatabase .
chx:X_BackupMethod a owl:NamedIndividual, chx:BackupMethod ; rdfs:label "conn.backup(backup_conn)"@en ; skos:definition "source.backup(target) copies a whole database, also while it is in use, into the database of another connection, which can be a file, so it saves an in-memory database to disk or loads a file into memory; copying the file with shutil.copy is safe only while no program uses it."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_BackupMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, b: (a.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), a.backup(b), b.execute('SELECT count(*) FROM cats').fetchone())[2])(__import__('sqlite3').connect(':memory:'), __import__('sqlite3').connect(':memory:')) evaluates to (3,)"@en ; chx:input "(lambda a, b: (a.executescript('CREATE TABLE cats (name TEXT NOT NULL, fur TEXT, weight_kg REAL) STRICT; INSERT INTO cats VALUES (\\'Zophie\\', \\'black\\', 5.6), (\\'Miguel\\', \\'siamese\\', 6.2), (\\'Toby\\', \\'black\\', 6.8);'), a.backup(b), b.execute('SELECT count(*) FROM cats').fetchone())[2])(__import__('sqlite3').connect(':memory:'), __import__('sqlite3').connect(':memory:'))" ; chx:output "(3,)" .
chx:X_BackupMethod rd:hasIOExample chx:IO_BackupMethod .
chx:X_DumpMethod a owl:NamedIndividual, chx:DumpMethod ; rdfs:label "for line in conn.iterdump():"@en ; skos:definition "iterdump yields the text of the SQL statements that would re-create the database, so writing them to a file gives a readable copy that executescript can load again; for a small database the text can be shorter than the database file, whose size is a whole number of pages."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_DumpMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE t (a TEXT); INSERT INTO t VALUES (\\'x\\');'), list(c.iterdump())))))(__import__('sqlite3').connect(':memory:')) evaluates to ['BEGIN TRANSACTION;', 'CREATE TABLE t (a TEXT);', 'INSERT INTO 't' VALUES(\\'x\\');', 'COMMIT;']"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE t (a TEXT); INSERT INTO t VALUES (\\'x\\');'), list(c.iterdump())))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "['BEGIN TRANSACTION;', 'CREATE TABLE t (a TEXT);', 'INSERT INTO 't' VALUES(\\'x\\');', 'COMMIT;']" .
chx:X_DumpMethod rd:hasIOExample chx:IO_DumpMethod .
chx:X_SqliteApps a owl:NamedIndividual, chx:SqliteApps ; rdfs:label "python -m sqlite3 example.db"@en ; skos:definition "The sqlite3 command-line program, and since Python 3.12 the same kind of shell started with python -m sqlite3, run SQL typed at a prompt, and graphical programs such as DB Browser for SQLite, SQLite Studio and DBeaver show the tables; SQL typed into the command-line shell ends with a semicolon."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:X_VaccinationChecker a owl:NamedIndividual, chx:VaccinationChecker ; rdfs:label "SELECT cats.name FROM cats LEFT JOIN vaccinations ..."@en ; skos:definition "The first practice program lists the cats that lack any of the vaccines rabies, FeLV and FVRCP and finds vaccinations dated before the cat's birthday; both are answered by queries over the two tables, here with a small table written for this study because the chapter's sweigartcats.db was not downloaded."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_VaccinationChecker a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL, birthdate TEXT) STRICT; CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(id)) STRICT; INSERT INTO cats(name, birthdate) VALUES (\\'Zophie\\', \\'2021-01-24\\'), (\\'Miguel\\', \\'2016-12-24\\'), (\\'Toby\\', \\'2021-05-17\\'); INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', 1), (\\'FeLV\\', \\'2023-06-06\\', 1), (\\'FVRCP\\', \\'2023-06-06\\', 1), (\\'rabies\\', \\'2017-01-01\\', 2), (\\'FeLV\\', \\'2021-01-01\\', 3), (\\'rabies\\', \\'2022-01-01\\', 3), (\\'FVRCP\\', \\'2022-01-01\\', 3);'), (c.execute('SELECT cats.name FROM cats WHERE (SELECT count(DISTINCT vaccine) FROM vaccinations WHERE cat_id = cats.id AND vaccine IN (\\'rabies\\', \\'FeLV\\', \\'FVRCP\\')) < 3 ORDER BY cats.id').fetchall(), c.execute('SELECT cats.name, vaccinations.vaccine FROM cats JOIN vaccinations ON vaccinations.cat_id = cats.id WHERE vaccinations.date_administered < cats.birthdate').fetchall())))))(__import__('sqlite3').connect(':memory:')) evaluates to ([('Miguel',)], [('Toby', 'FeLV')])"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE cats (id INTEGER PRIMARY KEY, name TEXT NOT NULL, birthdate TEXT) STRICT; CREATE TABLE vaccinations (vaccine TEXT, date_administered TEXT, cat_id INTEGER, FOREIGN KEY(cat_id) REFERENCES cats(id)) STRICT; INSERT INTO cats(name, birthdate) VALUES (\\'Zophie\\', \\'2021-01-24\\'), (\\'Miguel\\', \\'2016-12-24\\'), (\\'Toby\\', \\'2021-05-17\\'); INSERT INTO vaccinations VALUES (\\'rabies\\', \\'2023-06-06\\', 1), (\\'FeLV\\', \\'2023-06-06\\', 1), (\\'FVRCP\\', \\'2023-06-06\\', 1), (\\'rabies\\', \\'2017-01-01\\', 2), (\\'FeLV\\', \\'2021-01-01\\', 3), (\\'rabies\\', \\'2022-01-01\\', 3), (\\'FVRCP\\', \\'2022-01-01\\', 3);'), (c.execute('SELECT cats.name FROM cats WHERE (SELECT count(DISTINCT vaccine) FROM vaccinations WHERE cat_id = cats.id AND vaccine IN (\\'rabies\\', \\'FeLV\\', \\'FVRCP\\')) < 3 ORDER BY cats.id').fetchall(), c.execute('SELECT cats.name, vaccinations.vaccine FROM cats JOIN vaccinations ON vaccinations.cat_id = cats.id WHERE vaccinations.date_administered < cats.birthdate').fetchall())))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "([('Miguel',)], [('Toby', 'FeLV')])" .
chx:X_VaccinationChecker rd:hasIOExample chx:IO_VaccinationChecker .
chx:X_MealIngredients a owl:NamedIndividual, chx:MealIngredients ; rdfs:label "meal:ingredient1,ingredient2"@en ; skos:definition "The second practice program keeps meals and their ingredients in two linked tables and answers a typed name with the meal's ingredients, or with every meal that uses the ingredient; the two CREATE TABLE statements the chapter gives reference meals(rowid), which SQLite rejects once foreign keys are on, so a solution declares an INTEGER PRIMARY KEY in meals."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_MealIngredients a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: next(reversed((c.executescript('CREATE TABLE meals (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE) STRICT; CREATE TABLE ingredients (name TEXT NOT NULL, meal_id INTEGER NOT NULL, FOREIGN KEY(meal_id) REFERENCES meals(id)) STRICT; INSERT INTO meals(name) VALUES (\\'onigiri\\'), (\\'chicken and rice\\'); INSERT INTO ingredients VALUES (\\'rice\\', 1), (\\'nori\\', 1), (\\'salt\\', 1), (\\'chicken\\', 2), (\\'rice\\', 2);'), ([r[0] for r in c.execute('SELECT ingredients.name FROM ingredients JOIN meals ON meals.id = ingredients.meal_id WHERE meals.name = ? ORDER BY ingredients.rowid', ('onigiri',))], [r[0] for r in c.execute('SELECT meals.name FROM meals JOIN ingredients ON meals.id = ingredients.meal_id WHERE ingredients.name = ? ORDER BY meals.id', ('rice',))])))))(__import__('sqlite3').connect(':memory:')) evaluates to (['rice', 'nori', 'salt'], ['onigiri', 'chicken and rice'])"@en ; chx:input "(lambda c: next(reversed((c.executescript('CREATE TABLE meals (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE) STRICT; CREATE TABLE ingredients (name TEXT NOT NULL, meal_id INTEGER NOT NULL, FOREIGN KEY(meal_id) REFERENCES meals(id)) STRICT; INSERT INTO meals(name) VALUES (\\'onigiri\\'), (\\'chicken and rice\\'); INSERT INTO ingredients VALUES (\\'rice\\', 1), (\\'nori\\', 1), (\\'salt\\', 1), (\\'chicken\\', 2), (\\'rice\\', 2);'), ([r[0] for r in c.execute('SELECT ingredients.name FROM ingredients JOIN meals ON meals.id = ingredients.meal_id WHERE meals.name = ? ORDER BY ingredients.rowid', ('onigiri',))], [r[0] for r in c.execute('SELECT meals.name FROM meals JOIN ingredients ON meals.id = ingredients.meal_id WHERE ingredients.name = ? ORDER BY meals.id', ('rice',))])))))(__import__('sqlite3').connect(':memory:'))" ; chx:output "(['rice', 'nori', 'salt'], ['onigiri', 'chicken and rice'])" .
chx:X_MealIngredients rd:hasIOExample chx:IO_MealIngredients .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "SELECT typeof(5), typeof(5.0)"@en ; skos:definition "The 16 practice questions ask for the commands and terms of the chapter: connect, CREATE TABLE, isolation_level=None, INTEGER against REAL, STRICT, SELECT *, CRUD, ACID, INSERT, DELETE, an UPDATE without WHERE, an index, a foreign key, DROP TABLE, ':memory:' and backup."@en ; dcterms:source <http://example.org/sen0414/ch16/research> .
chx:IO_PracticeQuestions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c: c.execute('SELECT typeof(5), typeof(5.0), 5 = 5.0').fetchone())(__import__('sqlite3').connect(':memory:')) evaluates to ('integer', 'real', 1)"@en ; chx:input "(lambda c: c.execute('SELECT typeof(5), typeof(5.0), 5 = 5.0').fetchone())(__import__('sqlite3').connect(':memory:'))" ; chx:output "('integer', 'real', 1)" .
chx:X_PracticeQuestions rd:hasIOExample chx:IO_PracticeQuestions .
