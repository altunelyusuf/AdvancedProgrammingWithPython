pg:CE_01 a ipo:CodeExample ; rdfs:label "Connect, ask, close"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 7 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 1 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nprint('in a transaction:', conn.in_transaction)\nrow = conn.execute('SELECT 6 * 7').fetchone()\nprint('the answer row:', row)\nconn.close()\ntry:\n    conn.execute('SELECT 1')\nexcept sqlite3.ProgrammingError as e:\n    print('after close:', e)" ; sen0414:expectedOutput "in a transaction: False\nthe answer row: (42,)\nafter close: Cannot operate on a closed database.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "Create a table and read the schema"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 10 of the deck and runs 8 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 2 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE cats (name TEXT NOT NULL,'\n             ' birthdate TEXT, fur TEXT, weight_kg REAL) STRICT')\nsql = 'SELECT name FROM sqlite_schema WHERE type = 'table''\nprint(conn.execute(sql).fetchall())\nfor row in conn.execute('PRAGMA table_info(cats)'):\n    print(row)" ; sen0414:expectedOutput "[('cats',)]\n(0, 'name', 'TEXT', 1, None, 0)\n(1, 'birthdate', 'TEXT', 0, None, 0)\n(2, 'fur', 'TEXT', 0, None, 0)\n(3, 'weight_kg', 'REAL', 0, None, 0)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "STRICT refuses what a plain table keeps"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 11 of the deck and runs 13 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 11 ; sen0414:orderInTab 3 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE s (i INTEGER) STRICT')\nconn.execute('CREATE TABLE p (i INTEGER)')\nfor t in ('s', 'p'):\n    try:\n        conn.execute(f'INSERT INTO {t} VALUES (?)', ('Hello',))\n        print(t, 'stored Hello')\n    except sqlite3.IntegrityError as e:\n        print(t, 'refused:', e)\nconn.execute('INSERT INTO s VALUES ('42')')\nprint(conn.execute('SELECT i, typeof(i) FROM s').fetchall())\nprint(conn.execute('SELECT i, typeof(i) FROM p').fetchall())" ; sen0414:expectedOutput "s refused: cannot store TEXT value in INTEGER column s.i\np stored Hello\n[(42, 'integer')]\n[('Hello', 'text')]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Insert rows and read them back"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 13 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 13 ; sen0414:orderInTab 4 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE cats (name TEXT, fur TEXT)')\nconn.execute('INSERT INTO cats VALUES ('Zophie', 'black')')\nrows = [('Toby', 'black'), ('Jacob', 'orange')]\nconn.executemany('INSERT INTO cats VALUES (?, ?)', rows)\nprint(conn.execute('SELECT rowid, * FROM cats').fetchall())\nprint(conn.execute('SELECT name FROM cats').fetchone())\nprint(conn.total_changes, 'rows changed so far')" ; sen0414:expectedOutput "[(1, 'Zophie', 'black'), (2, 'Toby', 'black'), (3, 'Jacob', 'orange')]\n('Zophie',)\n3 rows changed so far\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "The rowid is not a promise"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 14 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 5 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:', isolation_level=None)\nconn.execute('CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT)')\nconn.executemany('INSERT INTO t (v) VALUES (?)',\n                 [('a',), ('b',), ('c',)])\nprint(conn.execute('SELECT rowid, id, v FROM t').fetchall())\nconn.execute('DELETE FROM t WHERE id = 3')\nconn.execute('INSERT INTO t (v) VALUES ('d')')\nprint(conn.execute('SELECT id, v FROM t').fetchall())\nlast = conn.execute('SELECT last_insert_rowid()').fetchone()\nprint('last id:', last[0])" ; sen0414:expectedOutput "[(1, 1, 'a'), (2, 2, 'b'), (3, 3, 'c')]\n[(1, 'a'), (2, 'b'), (3, 'd')]\nlast id: 3\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "WHERE, ORDER BY and LIMIT"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 17 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 17 ; sen0414:orderInTab 6 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE cats (name, fur, kg)')\ndata = [('Zophie', 'black', 5.6), ('Miguel', 'siamese', 6.2),\n        ('Toby', 'black', 4.1)]\nconn.executemany('INSERT INTO cats VALUES (?, ?, ?)', data)\nq = 'SELECT name, kg FROM cats WHERE fur = ? ORDER BY kg DESC'\nprint(conn.execute(q, ('black',)).fetchall())\nq = 'SELECT name FROM cats ORDER BY kg DESC LIMIT 2'\nprint(conn.execute(q).fetchall())" ; sen0414:expectedOutput "[('Zophie', 5.6), ('Toby', 4.1)]\n[('Miguel',), ('Zophie',)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "LIKE ignores case, GLOB does not"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 19 of the deck and runs 6 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 7 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nq = lambda sql: conn.execute(sql).fetchall()\nprint(q('SELECT 'Zophie' LIKE 'zo%', 'Zophie' GLOB 'zo*''))\nprint(q('SELECT 'Zophie' LIKE 'Zo%', 'Zophie' GLOB 'Zo*''))\nprint(q('SELECT 'a' LIKE 'A', 'é' LIKE 'É''))" ; sen0414:expectedOutput "[(1, 0)]\n[(1, 1)]\n[(1, 0)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "NULL is not a value"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 20 of the deck and runs 10 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 20 ; sen0414:orderInTab 8 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nq = lambda sql: conn.execute(sql).fetchall()\nq('CREATE TABLE c (name TEXT, fur TEXT)')\nq('INSERT INTO c VALUES ('Zophie', 'black'), ('Toby', 'black')')\nq('INSERT INTO c VALUES ('Mandy', NULL)')\nprint(q('SELECT count(*), count(fur) FROM c'))\nprint(q('SELECT name FROM c WHERE fur = NULL'))\nprint(q('SELECT name FROM c WHERE fur != 'black''))\nprint(q('SELECT name FROM c WHERE fur IS NULL'))" ; sen0414:expectedOutput "[(3, 2)]\n[]\n[]\n[('Mandy',)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "UPDATE, DELETE and RETURNING"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 22 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 9 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:', isolation_level=None)\nconn.execute('CREATE TABLE cats (name, kg)')\nconn.executemany('INSERT INTO cats VALUES (?, ?)',\n                 [('Zophie', 5.6), ('Toby', 4.1), ('Jacob', 7.3)])\ncur = conn.execute('UPDATE cats SET kg = kg + 0.5 WHERE kg < 6')\nprint('updated rows:', cur.rowcount)\ncur = conn.execute('DELETE FROM cats WHERE kg > 7 RETURNING name')\nprint('deleted:', cur.fetchall())\nprint(conn.execute('SELECT * FROM cats').fetchall())" ; sen0414:expectedOutput "updated rows: 2\ndeleted: [('Jacob',)]\n[('Zophie', 6.1), ('Toby', 4.6)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "Placeholders by position and by name"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 23 of the deck and runs 7 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 10 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE cats (name TEXT, fur TEXT)')\nconn.execute('INSERT INTO cats VALUES (?, ?)', ('Zophie', 'black'))\nconn.execute('INSERT INTO cats VALUES (:n, :f)', {'n': 'Toby', 'f': 'black'})\nsql = 'SELECT name FROM cats WHERE fur = :fur'\nprint(conn.execute(sql, {'fur': 'black'}).fetchall())" ; sen0414:expectedOutput "[('Zophie',), ('Toby',)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "SQL injection and the placeholder"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 24 of the deck and runs 12 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 11 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE cats (name TEXT)')\nconn.executemany('INSERT INTO cats VALUES (?)',\n                 [('Zophie',), ('Toby',)])\nattack = 'x' OR '1'='1'\nsql = f'SELECT * FROM cats WHERE name = '{attack}''\nn = len(conn.execute(sql).fetchall())\nprint('pasted into the SQL:', n, 'rows')\nsql = 'SELECT * FROM cats WHERE name = ?'\nn = len(conn.execute(sql, (attack,)).fetchall())\nprint('bound as a value:', n, 'rows')" ; sen0414:expectedOutput "pasted into the SQL: 2 rows\nbound as a value: 0 rows\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "BEGIN, commit and rollback"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 28 of the deck and runs 13 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 28 ; sen0414:orderInTab 12 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:', isolation_level=None)\nconn.execute('CREATE TABLE t (a INTEGER NOT NULL)')\nn = lambda: conn.execute('SELECT count(*) FROM t').fetchone()[0]\nconn.execute('BEGIN')\nconn.execute('INSERT INTO t VALUES (1)')\nprint('inside:', n(), conn.in_transaction)\nconn.rollback()\nprint('after rollback:', n())\nconn.execute('BEGIN')\nconn.execute('INSERT INTO t VALUES (2)')\nconn.commit()\nprint('after commit:', n(), conn.in_transaction)" ; sen0414:expectedOutput "inside: 1 True\nafter rollback: 0\nafter commit: 1 False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "A failed statement changes nothing"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 29 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 13 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:', isolation_level=None)\nconn.execute('CREATE TABLE t (a INTEGER NOT NULL)')\nn = lambda: conn.execute('SELECT count(*) FROM t').fetchone()[0]\ntry:\n    conn.execute('INSERT INTO t VALUES (1), (2), (NULL)')\nexcept sqlite3.IntegrityError as e:\n    print('refused:', e)\nprint('rows after the failure:', n())\nconn.execute('INSERT INTO t VALUES (3), (4)')\nprint('rows after a good insert:', n())" ; sen0414:expectedOutput "refused: NOT NULL constraint failed: t.a\nrows after the failure: 0\nrows after a good insert: 2\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "with conn: commit or roll back"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 31 of the deck and runs 13 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 31 ; sen0414:orderInTab 14 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE t (a INTEGER NOT NULL)')\nn = lambda: conn.execute('SELECT count(*) FROM t').fetchone()[0]\nwith conn:\n    conn.execute('INSERT INTO t VALUES (1)')\nprint('after the first block:', n())\ntry:\n    with conn:\n        conn.execute('INSERT INTO t VALUES (2)')\n        conn.execute('INSERT INTO t VALUES (NULL)')\nexcept sqlite3.IntegrityError:\n    print('second block failed, rows left:', n())" ; sen0414:expectedOutput "after the first block: 1\nsecond block failed, rows left: 1\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "with conn does not close; closing() does"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 32 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 15 ;
    sen0414:code "import sqlite3, contextlib\nconn = sqlite3.connect(':memory:')\nwith conn:\n    conn.execute('CREATE TABLE t (a INTEGER)')\nprint('after with conn:', conn.execute('SELECT 6 * 7').fetchone())\nwith contextlib.closing(conn):\n    conn.execute('SELECT 1')\ntry:\n    conn.execute('SELECT 2')\nexcept sqlite3.ProgrammingError as e:\n    print('after closing():', e)" ; sen0414:expectedOutput "after with conn: (42,)\nafter closing(): Cannot operate on a closed database.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "ALTER TABLE and DROP TABLE"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 34 of the deck and runs 12 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 34 ; sen0414:orderInTab 16 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE cats (name TEXT, fur TEXT)')\nconn.execute('INSERT INTO cats VALUES ('Zophie', 'black')')\nconn.execute('ALTER TABLE cats ADD COLUMN kg REAL')\nconn.execute('ALTER TABLE cats RENAME COLUMN fur TO colour')\nprint([r[1] for r in conn.execute('PRAGMA table_info(cats)')])\nprint(conn.execute('SELECT * FROM cats').fetchall())\nconn.execute('ALTER TABLE cats DROP COLUMN kg')\nconn.execute('DROP TABLE IF EXISTS dogs')\nconn.execute('DROP TABLE cats')\nprint(conn.execute('SELECT count(*) FROM sqlite_schema').fetchone())" ; sen0414:expectedOutput "['name', 'colour', 'kg']\n[('Zophie', 'black', None)]\n(0,)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "An index serves some searches"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 36 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 36 ; sen0414:orderInTab 17 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE cats (name TEXT, fur TEXT)')\nconn.execute('CREATE INDEX idx_fur ON cats (fur)')\ndef plan(sql):\n    rows = conn.execute('EXPLAIN QUERY PLAN ' + sql).fetchall()\n    return rows[0][3].split()[0]\nqueries = ['fur = 'black'', 'name = 'Zophie'', 'fur LIKE '%ck'']\nfor w in queries:\n    print(plan('SELECT * FROM cats WHERE ' + w), '|', w)" ; sen0414:expectedOutput "SEARCH | fur = 'black'\nSCAN | name = 'Zophie'\nSCAN | fur LIKE '%ck'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "A database file and VACUUM"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 37 of the deck and runs 14 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 18 ;
    sen0414:code "import os, sqlite3, tempfile\npath = os.path.join(tempfile.mkdtemp(), 'cats.db')\nprint('file exists before connect:', os.path.exists(path))\nconn = sqlite3.connect(path)\nprint('file exists after connect:', os.path.exists(path))\nconn.execute('CREATE TABLE t (v TEXT)')\nconn.executemany('INSERT INTO t VALUES (?)', [('x' * 100,)] * 2000)\nconn.commit()\nbig = os.path.getsize(path)\nconn.execute('DELETE FROM t')\nconn.commit()\nprint('after DELETE, same size:', os.path.getsize(path) == big)\nconn.execute('VACUUM')\nprint('after VACUUM, smaller:', os.path.getsize(path) < big)" ; sen0414:expectedOutput "file exists before connect: False\nfile exists after connect: True\nafter DELETE, same size: True\nafter VACUUM, smaller: True\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "A foreign key and its switch"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 41 of the deck and runs 13 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 41 ; sen0414:orderInTab 19 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:', isolation_level=None)\nrow = conn.execute('PRAGMA foreign_keys').fetchone()\nprint('foreign_keys is', row[0])\nconn.execute('PRAGMA foreign_keys = ON')\nconn.execute('CREATE TABLE meals (id INTEGER PRIMARY KEY, name)')\nconn.execute('CREATE TABLE ing (meal_id REFERENCES meals, item)')\nconn.execute('INSERT INTO meals VALUES (1, 'Pancakes')')\nconn.execute('INSERT INTO ing VALUES (1, 'flour')')\ntry:\n    conn.execute('INSERT INTO ing VALUES (99, 'salt')')\nexcept sqlite3.IntegrityError as e:\n    print('refused:', e)" ; sen0414:expectedOutput "foreign_keys is 0\nrefused: FOREIGN KEY constraint failed\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "INNER JOIN and LEFT JOIN"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 42 of the deck and runs 12 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 42 ; sen0414:orderInTab 20 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE cats (id INTEGER PRIMARY KEY, name)')\nconn.execute('CREATE TABLE vax (cat_id INTEGER, vaccine TEXT)')\nnames = [('Zophie',), ('Toby',), ('Mandy',)]\nconn.executemany('INSERT INTO cats (name) VALUES (?)', names)\nconn.executemany('INSERT INTO vax VALUES (?, ?)',\n                 [(1, 'rabies'), (1, 'FVRCP'), (2, 'rabies')])\njoin = ('SELECT name, vaccine FROM cats {} vax'\n        ' ON cat_id = id ORDER BY 1, 2')\nprint(conn.execute(join.format('INNER JOIN')).fetchall())\nprint(conn.execute(join.format('LEFT JOIN')).fetchall())" ; sen0414:expectedOutput "[('Toby', 'rabies'), ('Zophie', 'FVRCP'), ('Zophie', 'rabies')]\n[('Mandy', None), ('Toby', 'rabies'), ('Zophie', 'FVRCP'), ('Zophie', 'rabies')]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "backup() copies a whole database"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 43 of the deck and runs 13 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 43 ; sen0414:orderInTab 21 ;
    sen0414:code "import os, sqlite3, tempfile\nsrc = sqlite3.connect(':memory:')\nsrc.execute('CREATE TABLE cats (name TEXT)')\nsrc.executemany('INSERT INTO cats VALUES (?)',\n                [('Zophie',), ('Toby',)])\nsrc.commit()\npath = os.path.join(tempfile.mkdtemp(), 'copy.db')\ndst = sqlite3.connect(path)\nsrc.backup(dst)\nq = 'SELECT count(*) FROM cats'\nprint('rows in the copy:', dst.execute(q).fetchone()[0])\nsrc.execute('INSERT INTO cats VALUES ('Jacob')')\nprint('copy after a later change:', dst.execute(q).fetchone()[0])" ; sen0414:expectedOutput "rows in the copy: 2\ncopy after a later change: 2\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
pg:CE_22 a ipo:CodeExample ; rdfs:label "iterdump() turns a database into SQL"@en ;
    skos:definition "Example 22 of the chapter-code tab comes from slide 44 of the deck and runs 10 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 44 ; sen0414:orderInTab 22 ;
    sen0414:code "import sqlite3\na = sqlite3.connect(':memory:')\na.execute('CREATE TABLE cats (name TEXT, kg REAL)')\na.execute('INSERT INTO cats VALUES ('Zophie', 5.6)')\na.commit()\nscript = '\\n'.join(a.iterdump())\nprint(script)\nb = sqlite3.connect(':memory:')\nb.executescript(script)\nprint(b.execute('SELECT * FROM cats').fetchall())" ; sen0414:expectedOutput "BEGIN TRANSACTION;\nCREATE TABLE cats (name TEXT, kg REAL);\nINSERT INTO 'cats' VALUES('Zophie',5.6);\nCOMMIT;\n[('Zophie', 5.6)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_22 .
pg:CE_23 a ipo:CodeExample ; rdfs:label "shutil copies a database file"@en ;
    skos:definition "Example 23 of the chapter-code tab comes from slide 45 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 45 ; sen0414:orderInTab 23 ;
    sen0414:code "import os, shutil, sqlite3, tempfile\nfolder = tempfile.mkdtemp()\npath = os.path.join(folder, 'a.db')\nconn = sqlite3.connect(path)\nconn.execute('CREATE TABLE t (v TEXT)')\nconn.execute('INSERT INTO t VALUES ('kept')')\nconn.commit()\nconn.close()\nshutil.copyfile(path, os.path.join(folder, 'b.db'))\ncopy = sqlite3.connect(os.path.join(folder, 'b.db'))\nprint('copy holds:', copy.execute('SELECT v FROM t').fetchall())" ; sen0414:expectedOutput "copy holds: [('kept',)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_23 .
pg:CE_24 a ipo:CodeExample ; rdfs:label "Practice program: the cat vaccination checker"@en ;
    skos:definition "Example 24 of the chapter-code tab comes from slide 48 of the deck and runs 14 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 48 ; sen0414:orderInTab 24 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE cats (id, name, born)')\nconn.execute('CREATE TABLE vax (cat_id, vaccine, given)')\nconn.executemany('INSERT INTO cats VALUES (?,?,?)', [\n    (1, 'Zophie', '2021-01-24'), (2, 'Toby', '2019-05-02')])\nconn.executemany('INSERT INTO vax VALUES (?,?,?)', [\n    (1, 'rabies', '2021-06-01'), (2, 'FVRCP', '2019-01-01')])\nsql = ('SELECT name, vaccine FROM vax JOIN cats'\n       ' ON cat_id = cats.id WHERE given < born')\nprint('given before birth:', conn.execute(sql).fetchall())\nsql = ('SELECT name FROM cats LEFT JOIN vax ON cat_id = cats.id'\n       ' GROUP BY cats.id HAVING count(DISTINCT vaccine) < 2')\nprint('missing a vaccine:', conn.execute(sql).fetchall())" ; sen0414:expectedOutput "given before birth: [('Toby', 'FVRCP')]\nmissing a vaccine: [('Zophie',), ('Toby',)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_24 .
pg:CE_25 a ipo:CodeExample ; rdfs:label "Practice program: the meal ingredients database"@en ;
    skos:definition "Example 25 of the chapter-code tab comes from slide 49 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch16/page/chapter_code_ch16_v1_0_1.json" ;
    sen0414:slideNumber 49 ; sen0414:orderInTab 25 ;
    sen0414:code "import sqlite3\nconn = sqlite3.connect(':memory:')\nconn.execute('CREATE TABLE ing (meal, item)')\nconn.executemany('INSERT INTO ing VALUES (?, ?)', [\n    ('Pancakes', 'flour'), ('Pancakes', 'milk'), ('Pancakes', 'egg'),\n    ('Omelette', 'egg'), ('Omelette', 'butter')])\nhave = ('egg', 'butter', 'milk')\nsql = ('SELECT meal FROM ing GROUP BY meal'\n       ' HAVING sum(item NOT IN (?, ?, ?)) = 0')\nprint('can cook:', conn.execute(sql, have).fetchall())" ; sen0414:expectedOutput "can cook: [('Omelette',)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_25 .
