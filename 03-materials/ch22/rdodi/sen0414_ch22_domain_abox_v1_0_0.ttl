chx:X_OpticalCharacterRecognition a owl:NamedIndividual, chx:OpticalCharacterRecognition ; rdfs:label "the extraction of text from an image"@en ; skos:definition "Optical character recognition, OCR, is the extraction of text from an image, so that string methods and regular expressions can then be applied to it."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_TesseractEngine a owl:NamedIndividual, chx:TesseractEngine ; rdfs:label "the tesseract program"@en ; skos:definition "Tesseract is the open source OCR engine that does the recognition; it is a separate program installed on the computer, and Python only starts it and reads what it returns."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_PyTesseractWrapper a owl:NamedIndividual, chx:PyTesseractWrapper ; rdfs:label "import pytesseract as tess"@en ; skos:definition "PyTesseract is the Python package that calls the tesseract program for a script; it lists Pillow among its requirements."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_PillowImage a owl:NamedIndividual, chx:PillowImage ; rdfs:label "Image.open('ocr-example.png')"@en ; skos:definition "Pillow opens an image file as an object that can be passed to PyTesseract, cropped, rotated and given a border."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_PrintedTextOnly a owl:NamedIndividual, chx:PrintedTextOnly ; rdfs:label "a photo of a license plate"@en ; skos:definition "Tesseract is meant for printed documents; photographs of scenes and handwriting are not its task, and a photographed object must be cropped to its text first."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_ImperfectResult a owl:NamedIndividual, chx:ImperfectResult ; rdfs:label "always consider OCR text imperfect"@en ; skos:definition "Recognised text is a draft: it keeps hyphenation, loses font and size, may space words wrongly, may confuse characters and may mix columns."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_EngineInstall a owl:NamedIndividual, chx:EngineInstall ; rdfs:label "sudo apt install tesseract-ocr"@en ; skos:definition "The engine is installed outside Python: with an installer on Windows, with Homebrew on macOS and with the package manager on Linux; language packs are installed apart from it."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_LanguagePackFile a owl:NamedIndividual, chx:LanguagePackFile ; rdfs:label "jpn.traineddata"@en ; skos:definition "A language pack is a file named for its language code with the extension .traineddata."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_LanguagePackFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "'jpn.traineddata'.removesuffix('.traineddata') evaluates to 'jpn'"@en ; chx:input "'jpn.traineddata'.removesuffix('.traineddata')" ; chx:output "'jpn'" .
chx:X_LanguagePackFile rd:hasIOExample chx:IO_LanguagePackFile .
chx:X_PathVariable a owl:NamedIndividual, chx:PathVariable ; rdfs:label "C:\\Program Files\\Tesseract-OCR on PATH"@en ; skos:definition "PyTesseract starts the program named tesseract, so the program's folder must be on the PATH, or its full path must be given to PyTesseract."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_ImageOpen a owl:NamedIndividual, chx:ImageOpen ; rdfs:label "img = Image.open('ocr-example.png')"@en ; skos:definition "Image.open() reads an image file into a Pillow image; the chapter imports pytesseract as tess and Image from PIL first."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_ImageToString a owl:NamedIndividual, chx:ImageToString ; rdfs:label "tess.image_to_string(img)"@en ; skos:definition "image_to_string() takes an image, or the path of one, and returns the recognised text as one string with line breaks; its lang argument names the language."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_WordConfidenceTable a owl:NamedIndividual, chx:WordConfidenceTable ; rdfs:label "tess.image_to_data(img)"@en ; skos:definition "image_to_data() returns a tab-separated table with one row per recognised word, its box, a confidence from 0 to 100 and its text, so a program can tell which words to distrust."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_WordConfidenceTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(r.split('\\t')[-1], float(r.split('\\t')[-2])) for r in 'level\\tword_num\\tconf\\ttext\\n5\\t1\\t96.5\\tHello\\n5\\t2\\t88.0\\tworld'.splitlines()[1:]] evaluates to [('Hello', 96.5), ('world', 88.0)]"@en ; chx:input "[(r.split('\\t')[-1], float(r.split('\\t')[-2])) for r in 'level\\tword_num\\tconf\\ttext\\n5\\t1\\t96.5\\tHello\\n5\\t2\\t88.0\\tworld'.splitlines()[1:]]" ; chx:output "[('Hello', 96.5), ('world', 88.0)]" .
chx:X_WordConfidenceTable rd:hasIOExample chx:IO_WordConfidenceTable .
chx:X_PageSegmentationMode a owl:NamedIndividual, chx:PageSegmentationMode ; rdfs:label "config='--psm 7'"@en ; skos:definition "The page segmentation mode tells Tesseract how the image is laid out; the default expects a page of text, and a single line or a single word has modes of its own."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_SearchablePdfOutput a owl:NamedIndividual, chx:SearchablePdfOutput ; rdfs:label "image_to_pdf_or_hocr(img, extension='pdf')"@en ; skos:definition "PyTesseract can return a PDF with the recognised text placed under the image, which is the kind of file the chapter makes with NAPS2."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_EndOfLineHyphenation a owl:NamedIndividual, chx:EndOfLineHyphenation ; rdfs:label "'-' in 'dig-'"@en ; skos:definition "Text recognised from a page keeps a hyphen where a word was broken at the end of a line; a program can join the halves, but it cannot tell from the text alone whether the hyphen belonged to the word."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_EndOfLineHyphenation a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('re').sub(r'-\\n(\\w)', r'\\1', 'dig-\\nital art pro-\\ngrams') evaluates to 'digital art programs'"@en ; chx:input "__import__('re').sub(r'-\\n(\\w)', r'\\1', 'dig-\\nital art pro-\\ngrams')" ; chx:output "'digital art programs'" .
chx:X_EndOfLineHyphenation rd:hasIOExample chx:IO_EndOfLineHyphenation .
chx:X_ConfusedCharacters a owl:NamedIndividual, chx:ConfusedCharacters ; rdfs:label "'Iv' != 'It'"@en ; skos:definition "A character can be read as another that looks like it, and the result may be a valid word, so the mistake is found only by comparing with what the text should be."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_ConfusedCharacters a owl:NamedIndividual, rd:IOExample ; rdfs:label "[i for i, (a, b) in enumerate(zip('It was', 'Iv was')) if a != b] evaluates to [1]"@en ; chx:input "[i for i, (a, b) in enumerate(zip('It was', 'Iv was')) if a != b]" ; chx:output "[1]" .
chx:X_ConfusedCharacters rd:hasIOExample chx:IO_ConfusedCharacters .
chx:X_ColumnMixing a owl:NamedIndividual, chx:ColumnMixing ; rdfs:label "two columns in one image"@en ; skos:definition "When an image holds columns or a table, the recognised lines run across the columns and the text comes out in the wrong order; each column goes into its own image."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_ColumnMixing a owl:NamedIndividual, rd:IOExample ; rdfs:label "['%s %s' % p for p in zip(['Left one', 'Left two'], ['Right one', 'Right two'])] evaluates to ['Left one Right one', 'Left two Right two']"@en ; chx:input "['%s %s' % p for p in zip(['Left one', 'Left two'], ['Right one', 'Right two'])]" ; chx:output "['Left one Right one', 'Left two Right two']" .
chx:X_ColumnMixing rd:hasIOExample chx:IO_ColumnMixing .
chx:X_NumberErrors a owl:NamedIndividual, chx:NumberErrors ; rdfs:label "1,25O.75"@en ; skos:definition "A misread digit, or a letter O for a zero, is harder to see than a misspelled word, so numbers are checked against the pattern they must have."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_NumberErrors a owl:NamedIndividual, rd:IOExample ; rdfs:label "[bool(__import__('re').fullmatch(r'[\\d,]+\\.\\d\\d', n)) for n in ('1,250.75', '1,25O.75')] evaluates to [True, False]"@en ; chx:input "[bool(__import__('re').fullmatch(r'[\\d,]+\\.\\d\\d', n)) for n in ('1,250.75', '1,25O.75')]" ; chx:output "[True, False]" .
chx:X_NumberErrors rd:hasIOExample chx:IO_NumberErrors .
chx:X_SeparateColumns a owl:NamedIndividual, chx:SeparateColumns ; rdfs:label "img.crop((0, 0, 450, 200))"@en ; skos:definition "Cropping an image to one column, a box of left, upper, right and lower pixel coordinates, gives Tesseract one column at a time."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_SeparateColumns a owl:NamedIndividual, rd:IOExample ; rdfs:label "[row[:2] for row in [[1, 2, 3, 4], [5, 6, 7, 8]]] evaluates to [[1, 2], [5, 6]]"@en ; chx:input "[row[:2] for row in [[1, 2, 3, 4], [5, 6, 7, 8]]]" ; chx:output "[[1, 2], [5, 6]]" .
chx:X_SeparateColumns rd:hasIOExample chx:IO_SeparateColumns .
chx:X_DarkOnLight a owl:NamedIndividual, chx:DarkOnLight ; rdfs:label "white text on a black background"@en ; skos:definition "The documentation advises dark text on a light background; inverting an image swaps every pixel value v for 255 - v."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_DarkOnLight a owl:NamedIndividual, rd:IOExample ; rdfs:label "[[255 - p for p in row] for row in [[0, 255], [255, 0]]] evaluates to [[255, 0], [0, 255]]"@en ; chx:input "[[255 - p for p in row] for row in [[0, 255], [255, 0]]]" ; chx:output "[[255, 0], [0, 255]]" .
chx:X_DarkOnLight rd:hasIOExample chx:IO_DarkOnLight .
chx:X_UprightText a owl:NamedIndividual, chx:UprightText ; rdfs:label "rotate the image so that lines are level"@en ; skos:definition "Lines of text should be level, because a slanted line drifts from the row Tesseract expects; at 2 degrees a line 100 pixels long ends 3.5 pixels off the level."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_UprightText a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(100 * __import__('math').tan(__import__('math').radians(2)), 1) evaluates to 3.5"@en ; chx:input "round(100 * __import__('math').tan(__import__('math').radians(2)), 1)" ; chx:output "3.5" .
chx:X_UprightText rd:hasIOExample chx:IO_UprightText .
chx:X_WhiteBorder a owl:NamedIndividual, chx:WhiteBorder ; rdfs:label "a small white border around the text"@en ; skos:definition "A margin of light pixels around the text helps when the text touches the edge, and a margin that is too large can make the page look empty."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_WhiteBorder a owl:NamedIndividual, rd:IOExample ; rdfs:label "[[255] * 4] + [[255] + row + [255] for row in [[0, 0], [0, 0]]] + [[255] * 4] evaluates to [[255, 255, 255, 255], [255, 0, 0, 255], [255, 0, 0, 255], [255, 255, 255, 255]]"@en ; chx:input "[[255] * 4] + [[255] + row + [255] for row in [[0, 0], [0, 0]]] + [[255] * 4]" ; chx:output "[[255, 255, 255, 255], [255, 0, 0, 255], [255, 0, 0, 255], [255, 255, 255, 255]]" .
chx:X_WhiteBorder rd:hasIOExample chx:IO_WhiteBorder .
chx:X_ContrastThreshold a owl:NamedIndividual, chx:ContrastThreshold ; rdfs:label "brightness and contrast"@en ; skos:definition "Raising contrast makes the text stand out; a threshold turns every pixel below a level to black and the others to white."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_ContrastThreshold a owl:NamedIndividual, rd:IOExample ; rdfs:label "[[0 if p < 128 else 255 for p in row] for row in [[30, 200], [120, 250]]] evaluates to [[0, 255], [0, 255]]"@en ; chx:input "[[0 if p < 128 else 255 for p in row] for row in [[30, 200], [120, 250]]]" ; chx:output "[[0, 255], [0, 255]]" .
chx:X_ContrastThreshold rd:hasIOExample chx:IO_ContrastThreshold .
chx:X_NoiseRemoval a owl:NamedIndividual, chx:NoiseRemoval ; rdfs:label "small bits of noise pixels"@en ; skos:definition "Stray pixels are removed before scanning; a median of each pixel and its two neighbours removes a lone dark pixel and keeps a run of three."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_NoiseRemoval a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda r: [r[0]] + [sorted(r[i - 1:i + 2])[1] for i in range(1, len(r) - 1)] + [r[-1]])([255, 255, 0, 255, 255, 0, 0, 0, 255]) evaluates to [255, 255, 255, 255, 255, 0, 0, 0, 255]"@en ; chx:input "(lambda r: [r[0]] + [sorted(r[i - 1:i + 2])[1] for i in range(1, len(r) - 1)] + [r[-1]])([255, 255, 0, 255, 255, 0, 0, 0, 255])" ; chx:output "[255, 255, 255, 255, 255, 0, 0, 0, 255]" .
chx:X_NoiseRemoval rd:hasIOExample chx:IO_NoiseRemoval .
chx:X_SpellcheckBlindSpot a owl:NamedIndividual, chx:SpellcheckBlindSpot ; rdfs:label "modem for modern"@en ; skos:definition "A spellchecker looks for words that are not in a dictionary, but an OCR error often produces another real word, so it cannot find the mistakes OCR makes."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_SpellcheckBlindSpot a owl:NamedIndividual, rd:IOExample ; rdfs:label "('modem' in {'modem', 'modern', 'the'}, 'Iv' in {'It', 'is', 'the'}) evaluates to (True, False)"@en ; chx:input "('modem' in {'modem', 'modern', 'the'}, 'Iv' in {'It', 'is', 'the'})" ; chx:output "(True, False)" .
chx:X_SpellcheckBlindSpot rd:hasIOExample chx:IO_SpellcheckBlindSpot .
chx:X_HyphenAmbiguity a owl:NamedIndividual, chx:HyphenAmbiguity ; rdfs:label "half-, extinguished"@en ; skos:definition "An end-of-line hyphen is either a break in a word or part of a hyphenated word, and removing every one of them joins words that should stay apart."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_HyphenAmbiguity a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('re').sub(r'-\\n(\\w)', r'\\1', 'the half-\\nextinguished light') evaluates to 'the halfextinguished light'"@en ; chx:input "__import__('re').sub(r'-\\n(\\w)', r'\\1', 'the half-\\nextinguished light')" ; chx:output "'the halfextinguished light'" .
chx:X_HyphenAmbiguity rd:hasIOExample chx:IO_HyphenAmbiguity .
chx:X_LlmCorrection a owl:NamedIndividual, chx:LlmCorrection ; rdfs:label "a prompt and the OCR text"@en ; skos:definition "A large language model given the recognised text and a prompt can repair spacing, missing characters and hyphenation from context; it needs an online service and an account, and it was not run here."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_ReviewByDifference a owl:NamedIndividual, chx:ReviewByDifference ; rdfs:label "Iv became It"@en ; skos:definition "Listing the words that differ between the raw and the corrected text shows the reviewer where the correction changed the text."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_ReviewByDifference a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(a, b) for a, b in zip('Iv was on'.split(), 'It was on'.split()) if a != b] evaluates to [('Iv', 'It')]"@en ; chx:input "[(a, b) for a, b in zip('Iv was on'.split(), 'It was on'.split()) if a != b]" ; chx:output "[('Iv', 'It')]" .
chx:X_ReviewByDifference rd:hasIOExample chx:IO_ReviewByDifference .
chx:X_CharacterSimilarity a owl:NamedIndividual, chx:CharacterSimilarity ; rdfs:label "how close the correction is"@en ; skos:definition "A similarity ratio between the raw and the corrected text gives a number for how much was changed, and a large change is a reason for a closer look."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_CharacterSimilarity a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(__import__('difflib').SequenceMatcher(None, 'Iv was on a dreary night', 'It was on a dreary night').ratio(), 3) evaluates to 0.958"@en ; chx:input "round(__import__('difflib').SequenceMatcher(None, 'Iv was on a dreary night', 'It was on a dreary night').ratio(), 3)" ; chx:output "0.958" .
chx:X_CharacterSimilarity rd:hasIOExample chx:IO_CharacterSimilarity .
chx:X_InstalledLanguages a owl:NamedIndividual, chx:InstalledLanguages ; rdfs:label "'jpn' in tess.get_languages()"@en ; skos:definition "get_languages() returns the language packs Tesseract can find; the list depends on what was installed, and it includes osd, the orientation data."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_InstalledLanguages a owl:NamedIndividual, rd:IOExample ; rdfs:label "'List of available languages in (2):\\neng\\nosd'.splitlines()[1:] evaluates to ['eng', 'osd']"@en ; chx:input "'List of available languages in (2):\\neng\\nosd'.splitlines()[1:]" ; chx:output "['eng', 'osd']" .
chx:X_InstalledLanguages rd:hasIOExample chx:IO_InstalledLanguages .
chx:X_LanguageCode a owl:NamedIndividual, chx:LanguageCode ; rdfs:label "'aze_cyrl'"@en ; skos:definition "A language is named by a three-letter code with a few exceptions that add a script, such as aze_cyrl for Azeri in Cyrillic letters."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_LanguageCode a owl:NamedIndividual, rd:IOExample ; rdfs:label "[bool(__import__('re').fullmatch(r'[a-z]{3}(_[a-z]+)?', c)) for c in ('jpn', 'aze_cyrl', 'japanese', 'en')] evaluates to [True, True, False, False]"@en ; chx:input "[bool(__import__('re').fullmatch(r'[a-z]{3}(_[a-z]+)?', c)) for c in ('jpn', 'aze_cyrl', 'japanese', 'en')]" ; chx:output "[True, True, False, False]" .
chx:X_LanguageCode rd:hasIOExample chx:IO_LanguageCode .
chx:X_LangKeyword a owl:NamedIndividual, chx:LangKeyword ; rdfs:label "lang='jpn'"@en ; skos:definition "The lang keyword names the language to recognise; left out, it means English."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_CombiningLanguages a owl:NamedIndividual, chx:CombiningLanguages ; rdfs:label "lang='eng+jpn'"@en ; skos:definition "Two or more codes joined with + make Tesseract recognise all of those languages in one image."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_CombiningLanguages a owl:NamedIndividual, rd:IOExample ; rdfs:label "'eng+jpn'.split('+') evaluates to ['eng', 'jpn']"@en ; chx:input "'eng+jpn'.split('+')" ; chx:output "['eng', 'jpn']" .
chx:X_CombiningLanguages rd:hasIOExample chx:IO_CombiningLanguages .
chx:X_WrongLanguage a owl:NamedIndividual, chx:WrongLanguage ; rdfs:label "lang='eng'"@en ; skos:definition "Text scanned in the wrong language comes back as the closest letters of that language, which is gibberish."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_MissingLanguagePack a owl:NamedIndividual, chx:MissingLanguagePack ; rdfs:label "'jpn' not in tess.get_languages()"@en ; skos:definition "A language whose pack is not installed is an error when it is the only one named, and only a warning on standard error when another language is named with it."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_MissingLanguagePack a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted(set('eng+jpn'.split('+')) - {'eng', 'osd'}) evaluates to ['jpn']"@en ; chx:input "sorted(set('eng+jpn'.split('+')) - {'eng', 'osd'})" ; chx:output "['jpn']" .
chx:X_MissingLanguagePack rd:hasIOExample chx:IO_MissingLanguagePack .
chx:X_Naps2App a owl:NamedIndividual, chx:Naps2App ; rdfs:label "NAPS2"@en ; skos:definition "NAPS2, Not Another PDF Scanner 2, is an open source scanning application whose command-line form combines images into a PDF and runs Tesseract on them."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_SubprocessInvocation a owl:NamedIndividual, chx:SubprocessInvocation ; rdfs:label "subprocess.run(naps2_path + [...], capture_output=True)"@en ; skos:definition "Python starts NAPS2 with subprocess.run and a list of arguments, one list item for each argument, so no quoting is needed even if a name holds a space."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_SubprocessInvocation a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a: __import__('shlex').split(__import__('shlex').join(a)) == a)(['naps2', 'console', '-i', 'my scan.png']) evaluates to True"@en ; chx:input "(lambda a: __import__('shlex').split(__import__('shlex').join(a)) == a)(['naps2', 'console', '-i', 'my scan.png'])" ; chx:output "True" .
chx:X_SubprocessInvocation rd:hasIOExample chx:IO_SubprocessInvocation .
chx:X_ValueOptions a owl:NamedIndividual, chx:ValueOptions ; rdfs:label "'-i', 'frankenstein.png', '-o', 'output.pdf'"@en ; skos:definition "Most NAPS2 options come as a pair of an option and its value, such as -i and the input, -o and the output, --ocrlang and the language, and -n and the number of scans; -f and -v take no value."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_ValueOptions a owl:NamedIndividual, rd:IOExample ; rdfs:label "dict(zip(*[iter(['-i', 'frankenstein.png', '-o', 'output.pdf', '--ocrlang', 'eng', '-n', '0'])] * 2)) evaluates to {'-i': 'frankenstein.png', '-o': 'output.pdf', '--ocrlang': 'eng', '-n': '0'}"@en ; chx:input "dict(zip(*[iter(['-i', 'frankenstein.png', '-o', 'output.pdf', '--ocrlang', 'eng', '-n', '0'])] * 2))" ; chx:output "{'-i': 'frankenstein.png', '-o': 'output.pdf', '--ocrlang': 'eng', '-n': '0'}" .
chx:X_ValueOptions rd:hasIOExample chx:IO_ValueOptions .
chx:X_InputList a owl:NamedIndividual, chx:InputList ; rdfs:label "'cat.png;dog.png;moose.png'"@en ; skos:definition "Several inputs are given to -i as one argument with the names separated by semicolons, and each becomes the next page."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_InputList a owl:NamedIndividual, rd:IOExample ; rdfs:label "'cat.png;dog.png;moose.png'.split(';') evaluates to ['cat.png', 'dog.png', 'moose.png']"@en ; chx:input "'cat.png;dog.png;moose.png'.split(';')" ; chx:output "['cat.png', 'dog.png', 'moose.png']" .
chx:X_InputList rd:hasIOExample chx:IO_InputList .
chx:X_InputItem a owl:NamedIndividual, chx:InputItem ; rdfs:label "spam.pdf[5]"@en ; skos:definition "A file name may be followed by square brackets with the page or pages to take from it; without them all pages are taken."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_InputItem a owl:NamedIndividual, rd:IOExample ; rdfs:label "[__import__('re').fullmatch(r'(.+?)(?:\\[(.*)\\])?', s).groups() for s in ('spam.pdf[5]', 'eggs.pdf')] evaluates to [('spam.pdf', '5'), ('eggs.pdf', None)]"@en ; chx:input "[__import__('re').fullmatch(r'(.+?)(?:\\[(.*)\\])?', s).groups() for s in ('spam.pdf[5]', 'eggs.pdf')]" ; chx:output "[('spam.pdf', '5'), ('eggs.pdf', None)]" .
chx:X_InputItem rd:hasIOExample chx:IO_InputItem .
chx:X_PageSlices a owl:NamedIndividual, chx:PageSlices ; rdfs:label "spam.pdf[0:2];eggs.pdf[-1]"@en ; skos:definition "The text in the brackets is read as a Python index or slice starting at 0, so [0:2] is the first two pages, [-1] the last page and [:-2] all but the last two."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_PageSlices a owl:NamedIndividual, rd:IOExample ; rdfs:label "([*range(5)][0:2], [*range(5)][-1], [*range(5)][:-2]) evaluates to ([0, 1], 4, [0, 1, 2])"@en ; chx:input "([*range(5)][0:2], [*range(5)][-1], [*range(5)][:-2])" ; chx:output "([0, 1], 4, [0, 1, 2])" .
chx:X_PageSlices rd:hasIOExample chx:IO_PageSlices .
chx:X_OcrmypdfAlternative a owl:NamedIndividual, chx:OcrmypdfAlternative ; rdfs:label "ocrmypdf"@en ; skos:definition "OCRmyPDF is a Python package that adds a text layer to scanned PDF files so they can be searched; the chapter names it as the alternative if NAPS2 does not suit."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_ScreenCapture a owl:NamedIndividual, chx:ScreenCapture ; rdfs:label "pyautogui.screenshot()"@en ; skos:definition "The practice program takes a screenshot with PyAutoGUI, which needs a screen and was not run here; the rest of the program needs only an image."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:X_CropBox a owl:NamedIndividual, chx:CropBox ; rdfs:label "LEFT, TOP, RIGHT, BOTTOM"@en ; skos:definition "The box given to crop() is left, upper, right, lower, so its width is right minus left and its height bottom minus top."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_CropBox a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b: (b[2] - b[0], b[3] - b[1]))((400, 200, 1000, 800)) evaluates to (600, 600)"@en ; chx:input "(lambda b: (b[2] - b[0], b[3] - b[1]))((400, 200, 1000, 800))" ; chx:output "(600, 600)" .
chx:X_CropBox rd:hasIOExample chx:IO_CropBox .
chx:X_AppendToOutputFile a owl:NamedIndividual, chx:AppendToOutputFile ; rdfs:label "open('output.txt', 'a')"@en ; skos:definition "Mode 'a' adds to the end of the file instead of replacing it, so each run of the program adds the text of one more page."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
chx:IO_AppendToOutputFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p: (p.write_text('first\\n'), p.open('a').write('second\\n'), p.read_text())[2])(__import__('pathlib').Path(__import__('tempfile').mkdtemp()) / 'output.txt') evaluates to 'first\\nsecond\\n'"@en ; chx:input "(lambda p: (p.write_text('first\\n'), p.open('a').write('second\\n'), p.read_text())[2])(__import__('pathlib').Path(__import__('tempfile').mkdtemp()) / 'output.txt')" ; chx:output "'first\\nsecond\\n'" .
chx:X_AppendToOutputFile rd:hasIOExample chx:IO_AppendToOutputFile .
