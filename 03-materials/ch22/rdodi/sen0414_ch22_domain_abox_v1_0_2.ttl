chx:X_ProgramNotFound a owl:NamedIndividual, chx:ProgramNotFound ; rdfs:label "subprocess.run(['flatpak', ...])"@en ; skos:definition "Naming a program that is not installed (the Windows console of NAPS2, the flatpak command) raises FileNotFoundError, and on this machine flatpak is not found while /usr/bin/naps2 is."@en ; dcterms:source <http://example.org/sen0414/ch22/research> .
