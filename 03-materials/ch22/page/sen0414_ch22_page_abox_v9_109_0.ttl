pg:CE_01 a ipo:CodeExample ; rdfs:label "The engine and its languages"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 7 of the deck and runs 5 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 1 ;
    sen0414:code "import pytesseract as tess\nprint(tess.get_tesseract_version())\nlangs = tess.get_languages()\nprint(len(langs), langs[:5])\nprint('eng' in langs, 'xyz' in langs)" ; sen0414:expectedOutput "5.3.4\n22 ['ara', 'chi_sim', 'chi_tra', 'deu', 'eng']\nTrue False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "Reading one line of text"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 9 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 2 ;
    sen0414:code "from PIL import Image, ImageDraw, ImageFont\nimport pytesseract as tess\nfont = ImageFont.load_default(size=40)\nim = Image.new('L', (440, 90), 255)\nImageDraw.Draw(im).text((20, 20), 'Hello OCR 2026', fill=0, font=font)\ntext = tess.image_to_string(im)\nprint(repr(text))\nprint(text.strip() == 'Hello OCR 2026')" ; sen0414:expectedOutput "'Hello OCR 2026\\n'\nTrue\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "Lines, breaks and the data behind a line"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 10 of the deck and runs 5 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 3 ;
    sen0414:code "import pytesseract as tess\n# im holds three lines of text, drawn one under the other\ntext = tess.image_to_string(im)\nprint(type(text).__name__, len(text))\nprint(text.splitlines())" ; sen0414:expectedOutput "str 83\n['It was on a dreary night', 'of November that | beheld', '', 'the accomplishment of my toils']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Words, boxes and confidence"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 11 of the deck and runs 6 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 11 ; sen0414:orderInTab 4 ;
    sen0414:code "import pytesseract as tess\n# im holds one line: Invoice 2026-114 total 482.50\nd = tess.image_to_data(im, output_type=tess.Output.DICT)\nfor w, c, x, y in zip(d['text'], d['conf'], d['left'], d['top']):\n    if w.strip():\n        print(w, c, x, y)" ; sen0414:expectedOutput "Invoice 96 23 29\n2026-114 96 133 29\ntotal 96 281 27\n482.50 96 352 29\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "Text that is too small"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 15 of the deck and runs 10 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 15 ; sen0414:orderInTab 5 ;
    sen0414:code "def page(px, tilt=0):\n    font = ImageFont.load_default(size=px)\n    im = Image.new('L', (int(font.getlength(TRUTH)) + 60, px * 3), 255)\n    ImageDraw.Draw(im).text((30, px), TRUTH, fill=0, font=font)\n    return im.rotate(tilt, expand=True, fillcolor=255)\ndef score(im):\n    read = tess.image_to_string(im).strip()\n    return round(difflib.SequenceMatcher(None, TRUTH, read).ratio(), 2)\nfor px in (7, 8, 9, 10, 12, 16):\n    print(px, score(page(px)))" ; sen0414:expectedOutput "7 0.0\n8 0.0\n9 0.95\n10 0.99\n12 1.0\n16 1.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "A page that is crooked"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 16 of the deck and runs 3 lines of Python that print 7 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 6 ;
    sen0414:code "# page() and score() are those of the size example\nfor deg in (0, 4, 6, 7, 8, 9, 12):\n    print(deg, score(page(24, deg)))" ; sen0414:expectedOutput "0 1.0\n4 1.0\n6 0.98\n7 0.9\n8 0.91\n9 0.0\n12 0.25\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "Noise on the picture"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 17 of the deck and runs 6 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 17 ; sen0414:orderInTab 7 ;
    sen0414:code "def noisy(im, s):\n    rng = np.random.default_rng(1)\n    a = np.array(im, dtype=int) + rng.integers(-s, s + 1, (im.height, im.width))\n    return Image.fromarray(np.clip(a, 0, 255).astype('uint8'))\nfor s in (0, 50, 90, 100, 105, 110):\n    print(s, score(noisy(page(24), s)))" ; sen0414:expectedOutput "0 1.0\n50 1.0\n90 1.0\n100 1.0\n105 0.0\n110 0.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Cleaning a picture before reading"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 22 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 8 ;
    sen0414:code "tilted = page(24, 10)\nprint('tilted', score(tilted), score(tilted.rotate(-10, expand=True, fillcolor=255)))\nsmall = page(8)\nbig = small.resize((small.width * 3, small.height * 3), Image.Resampling.LANCZOS)\nprint('small', score(small), score(big))\ntable = [0] * 128 + [255] * 128\nprint('black and white', score(big.point(table)))" ; sen0414:expectedOutput "tilted 0.0 1.0\nsmall 0.0 0.98\nblack and white 0.7\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Telling Tesseract what to expect"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 23 of the deck and runs 5 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 9 ;
    sen0414:code "import pytesseract as tess\n# im holds the line: Call 555-0199 now: 2026\nprint(repr(tess.image_to_string(im).strip()))\ndigits = '--psm 7 -c tessedit_char_whitelist=0123456789-'\nprint(repr(tess.image_to_string(im, config=digits).strip()))" ; sen0414:expectedOutput "'Call 555-0199 now: 2026'\n'555-01992026'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "Languages other than English"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 24 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 10 ;
    sen0414:code "def ratio(a, b):\n    return round(difflib.SequenceMatcher(None, a, b).ratio(), 2)\nfor lang, text in texts.items():\n    as_eng = tess.image_to_string(line(text), lang='eng').strip()\n    as_own = tess.image_to_string(line(text), lang=lang).strip()\n    print(lang, ratio(text, as_eng), ratio(text, as_own))\ntry:\n    tess.image_to_string(line(texts['deu']), lang='xyz')\nexcept tess.TesseractError as e:\n    print(type(e).__name__)" ; sen0414:expectedOutput "deu 0.83 1.0\nfra 0.86 1.0\nTesseractError\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "Finding the mistakes of a reading"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 28 of the deck and runs 8 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 28 ; sen0414:orderInTab 11 ;
    sen0414:code "import difflib\nTRUTH = 'Invoice 2026-114 total 482.50'\nread = 'lnvoice 2O26-114 totaI 482.5O'\nfor tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, TRUTH, read).get_opcodes():\n    if tag != 'equal':\n        print(tag, repr(TRUTH[i1:i2]), 'read as', repr(read[j1:j2]))\nratio = difflib.SequenceMatcher(None, TRUTH, read).ratio()\nprint(round(ratio, 2))" ; sen0414:expectedOutput "replace 'I' read as 'l'\nreplace '0' read as 'O'\nreplace 'l' read as 'I'\nreplace '0' read as 'O'\n0.86\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "A searchable PDF"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 29 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 12 ;
    sen0414:code "import subprocess, tempfile\nimport pytesseract as tess\n# im holds two lines of text\npdf = tess.image_to_pdf_or_hocr(im, extension='pdf')\nprint(type(pdf).__name__, pdf[:5])\npath = tempfile.mktemp(suffix='.pdf')\nopen(path, 'wb').write(pdf)\ndone = subprocess.run(['pdftotext', path, '-'], capture_output=True, text=True)\nprint([t for t in done.stdout.splitlines() if t.strip()])" ; sen0414:expectedOutput "bytes b'%PDF-'\n['Invoice 2026-114 total 482.50', 'Paid by bank transfer']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Running NAPS2 from Python"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 30 of the deck and runs 7 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 30 ; sen0414:orderInTab 13 ;
    sen0414:code "import subprocess\ncommand = ['NAPS2.Console', '-n', '0', '-i', 'ocr-example.png', '-o', 'output.pdf']\nprint(' '.join(command))\ntry:\n    subprocess.run(command, check=True)\nexcept FileNotFoundError as e:\n    print(type(e).__name__, e.filename)" ; sen0414:expectedOutput "NAPS2.Console -n 0 -i ocr-example.png -o output.pdf\nFileNotFoundError NAPS2.Console\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "Reading the screen"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 34 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 34 ; sen0414:orderInTab 14 ;
    sen0414:code "class Screen:\n    def screenshot(self):\n        im = Image.new('RGB', (640, 300), 'white')\n        draw = ImageDraw.Draw(im)\n        draw.text((20, 60), 'Embedded document', fill='black', font=font)\n        draw.text((20, 120), 'Page 3 of 12: total 482.50', fill='black', font=font)\n        return im\nshot = Screen().screenshot()\npart = shot.crop((0, 50, 640, 170))\nprint(shot.size, part.size)\nprint(tess.image_to_string(part).strip().splitlines())" ; sen0414:expectedOutput "(640, 300) (640, 120)\n['Embedded document', '', 'Page 3 of 12: total 482.50']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "Practice program: browser text scraper"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 35 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch22/page/chapter_code_ch22_v2_1_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 15 ;
    sen0414:code "def screenshot(n):\n    im = Image.new('RGB', (640, 160), 'white')\n    line = f'Page {n} of 3: total {n * 100}.50'\n    ImageDraw.Draw(im).text((20, 50), line, fill='black', font=font)\n    return im\nfor n in (1, 2, 3):\n    part = screenshot(n).crop((0, 20, 640, 120))\n    text = tess.image_to_string(part).strip()\n    with open('output.txt', 'a') as f:\n        f.write(text + '\\n')\nprint(open('output.txt').read().splitlines())" ; sen0414:expectedOutput "['Page 1 of 3: total 100.50', 'Page 2 of 3: total 200.50', 'Page 3 of 3: total 300.50']\n" .
