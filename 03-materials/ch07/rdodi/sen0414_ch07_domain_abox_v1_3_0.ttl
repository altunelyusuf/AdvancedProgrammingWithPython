chx:X_DictionaryType a owl:NamedIndividual, chx:DictionaryType ; rdfs:label "my_cat = {'size': 'fat', 'color': 'gray', 'age': 17}"@en ; skos:definition "A dictionary is a mutable collection of key-value pairs written between curly brackets; a key selects its value the way an index selects an item of a list, and each key occurs only once."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DictionaryType a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda my_cat: (my_cat['size'], 'My cat has ' + my_cat['color'] + ' fur.', len(my_cat), type({}).__name__, type({'a'}).__name__))({'size': 'fat', 'color': 'gray', 'age': 17}) evaluates to ('fat', 'My cat has gray fur.', 3, 'dict', 'set')"@en ; chx:input "(lambda my_cat: (my_cat['size'], 'My cat has ' + my_cat['color'] + ' fur.', len(my_cat), type({}).__name__, type({'a'}).__name__))({'size': 'fat', 'color': 'gray', 'age': 17})" ; chx:output "('fat', 'My cat has gray fur.', 3, 'dict', 'set')" .
chx:X_DictionaryType rd:hasIOExample chx:IO_DictionaryType .
chx:X_KeyValuePair a owl:NamedIndividual, chx:KeyValuePair ; rdfs:label "the pair 'color': 'red'"@en ; skos:definition "A key-value pair is one key together with the value it stands for; it is the unit a dictionary is built from, and the items view hands it out as a tuple of two."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_KeyValuePair a owl:NamedIndividual, rd:IOExample ; rdfs:label "(list({'color': 'red', 'age': 42}.items()), len({'color': 'red', 'age': 42})) evaluates to ([('color', 'red'), ('age', 42)], 2)"@en ; chx:input "(list({'color': 'red', 'age': 42}.items()), len({'color': 'red', 'age': 42}))" ; chx:output "([('color', 'red'), ('age', 42)], 2)" .
chx:X_KeyValuePair rd:hasIOExample chx:IO_KeyValuePair .
chx:X_DictionaryConstructors a owl:NamedIndividual, chx:DictionaryConstructors ; rdfs:label "dict(one=1, two=2) and dict(zip(keys, values))"@en ; skos:definition "The dict constructor builds a dictionary from keyword arguments, from pairs, from another mapping or from two parallel lists joined by zip, and when a key occurs twice the last value wins."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DictionaryConstructors a owl:NamedIndividual, rd:IOExample ; rdfs:label "(dict([('two', 2), ('one', 1)]) == dict(one=1, two=2) == dict(zip(['one', 'two'], [1, 2])), dict([('k', 1), ('k', 2)])) evaluates to (True, {'k': 2})"@en ; chx:input "(dict([('two', 2), ('one', 1)]) == dict(one=1, two=2) == dict(zip(['one', 'two'], [1, 2])), dict([('k', 1), ('k', 2)]))" ; chx:output "(True, {'k': 2})" .
chx:X_DictionaryConstructors rd:hasIOExample chx:IO_DictionaryConstructors .
chx:X_KeysNotIndexes a owl:NamedIndividual, chx:KeysNotIndexes ; rdfs:label "spam[0] with spam = {12345: 'Luggage Combination', 42: 'The Answer'}"@en ; skos:definition "A dictionary has keys and not positions: spam[0] looks for a key equal to 0 and raises KeyError when there is none, even though the dictionary holds two pairs."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_KeysNotIndexes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: (spam[12345], spam[42], 0 in spam, len(spam)))({12345: 'Luggage Combination', 42: 'The Answer'}) evaluates to ('Luggage Combination', 'The Answer', False, 2)"@en ; chx:input "(lambda spam: (spam[12345], spam[42], 0 in spam, len(spam)))({12345: 'Luggage Combination', 42: 'The Answer'})" ; chx:output "('Luggage Combination', 'The Answer', False, 2)" .
chx:X_KeysNotIndexes rd:hasIOExample chx:IO_KeysNotIndexes .
chx:X_OrderInsensitiveEquality a owl:NamedIndividual, chx:OrderInsensitiveEquality ; rdfs:label "eggs == ham"@en ; skos:definition "Two dictionaries are equal when they hold the same pairs, whatever the order in which the pairs were entered, where two lists are equal only when their items are in the same order."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_OrderInsensitiveEquality a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam, bacon, eggs, ham: (spam == bacon, eggs == ham))(['cats', 'dogs', 'moose'], ['dogs', 'moose', 'cats'], {'name': 'Zophie', 'species': 'cat', 'age': '8'}, {'species': 'cat', 'age': '8', 'name': 'Zophie'}) evaluates to (False, True)"@en ; chx:input "(lambda spam, bacon, eggs, ham: (spam == bacon, eggs == ham))(['cats', 'dogs', 'moose'], ['dogs', 'moose', 'cats'], {'name': 'Zophie', 'species': 'cat', 'age': '8'}, {'species': 'cat', 'age': '8', 'name': 'Zophie'})" ; chx:output "(False, True)" .
chx:X_OrderInsensitiveEquality rd:hasIOExample chx:IO_OrderInsensitiveEquality .
chx:X_InsertionOrder a owl:NamedIndividual, chx:InsertionOrder ; rdfs:label "list(d) after replacing, deleting and re-adding keys"@en ; skos:definition "Since Python 3.7 a dictionary remembers the order in which its keys were first inserted, and every loop, list and display follows that order; replacing a value keeps the position of its key and a key added after a deletion goes to the end."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_InsertionOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.__setitem__('one', 42), d.__delitem__('two'), d.__setitem__('two', None), list(d))[3])({'one': 1, 'two': 2, 'three': 3, 'four': 4}) evaluates to ['one', 'three', 'four', 'two']"@en ; chx:input "(lambda d: (d.__setitem__('one', 42), d.__delitem__('two'), d.__setitem__('two', None), list(d))[3])({'one': 1, 'two': 2, 'three': 3, 'four': 4})" ; chx:output "['one', 'three', 'four', 'two']" .
chx:X_InsertionOrder rd:hasIOExample chx:IO_InsertionOrder .
chx:X_MappingNotSequence a owl:NamedIndividual, chx:MappingNotSequence ; rdfs:label "d[0:2]"@en ; skos:definition "A dictionary is a mapping and not a sequence: its keys are not positions, so it cannot be sliced, and the subscript d[0:2] is looked up as a key and raises KeyError."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_MappingNotSequence a owl:NamedIndividual, rd:IOExample ; rdfs:label "[isinstance({}, __import__('collections.abc').abc.Sequence), isinstance({}, __import__('collections.abc').abc.Mapping), isinstance([], __import__('collections.abc').abc.Sequence)] evaluates to [False, True, True]"@en ; chx:input "[isinstance({}, __import__('collections.abc').abc.Sequence), isinstance({}, __import__('collections.abc').abc.Mapping), isinstance([], __import__('collections.abc').abc.Sequence)]" ; chx:output "[False, True, True]" .
chx:X_MappingNotSequence rd:hasIOExample chx:IO_MappingNotSequence .
chx:X_HashableKeys a owl:NamedIndividual, chx:HashableKeys ; rdfs:label "{[1, 2]: 'x'}"@en ; skos:definition "A key must be hashable: a number, a string or a tuple of hashable items can be a key, while a list or a dictionary cannot, because they can change and Python refuses to file a pair under a value that might move."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_HashableKeys a owl:NamedIndividual, rd:IOExample ; rdfs:label "[isinstance(x, __import__('collections.abc').abc.Hashable) for x in ('a', 1, (1, 2), [1], {})] evaluates to [True, True, True, False, False]"@en ; chx:input "[isinstance(x, __import__('collections.abc').abc.Hashable) for x in ('a', 1, (1, 2), [1], {})]" ; chx:output "[True, True, True, False, False]" .
chx:X_HashableKeys rd:hasIOExample chx:IO_HashableKeys .
chx:X_HashValue a owl:NamedIndividual, chx:HashValue ; rdfs:label "hash('spam') and hash(1) == hash(1.0)"@en ; skos:definition "A hash value is the whole number that Python computes from a hashable object; equal objects have equal hash values, and the number is used to decide where a key's pair is stored."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_HashValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "(hash(1) == hash(1.0) == hash(True), hash('ab') == hash('a' + 'b'), isinstance(hash('spam'), int)) evaluates to (True, True, True)"@en ; chx:input "(hash(1) == hash(1.0) == hash(True), hash('ab') == hash('a' + 'b'), isinstance(hash('spam'), int))" ; chx:output "(True, True, True)" .
chx:X_HashValue rd:hasIOExample chx:IO_HashValue .
chx:X_TupleAsKey a owl:NamedIndividual, chx:TupleAsKey ; rdfs:label "grid = {(0, 0): 'start', (2, 3): 'goal'}"@en ; skos:definition "A tuple of hashable items is hashable, so it can be a key where a list cannot; it is the book's replacement when a compound value such as a coordinate must identify a pair."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_TupleAsKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda grid: (grid[(2, 3)], (0, 0) in grid, (1, 1) in grid))({(0, 0): 'start', (2, 3): 'goal'}) evaluates to ('goal', True, False)"@en ; chx:input "(lambda grid: (grid[(2, 3)], (0, 0) in grid, (1, 1) in grid))({(0, 0): 'start', (2, 3): 'goal'})" ; chx:output "('goal', True, False)" .
chx:X_TupleAsKey rd:hasIOExample chx:IO_TupleAsKey .
chx:X_EqualKeysShareASlot a owl:NamedIndividual, chx:EqualKeysShareASlot ; rdfs:label "{1: 'a', 1.0: 'b', True: 'c'}"@en ; skos:definition "Keys that compare equal and have the same hash are one key, so 1, 1.0 and True name a single pair, which keeps the first key object and takes the last value."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_EqualKeysShareASlot a owl:NamedIndividual, rd:IOExample ; rdfs:label "{1: 'a', 1.0: 'b', True: 'c'} evaluates to {1: 'c'}"@en ; chx:input "{1: 'a', 1.0: 'b', True: 'c'}" ; chx:output "{1: 'c'}" .
chx:X_EqualKeysShareASlot rd:hasIOExample chx:IO_EqualKeysShareASlot .
chx:X_KeyErrorOnMissing a owl:NamedIndividual, chx:KeyErrorOnMissing ; rdfs:label "spam['color'] with spam = {'name': 'Zophie', 'age': 7}"@en ; skos:definition "KeyError is the exception raised when a key is not in the dictionary; its message is the missing key as Python would write it, so the cause can be read off the last line of the traceback."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_KeyErrorOnMissing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: [k in spam for k in ('name', 'color')])({'name': 'Zophie', 'age': 7}) evaluates to [True, False]"@en ; chx:input "(lambda spam: [k in spam for k in ('name', 'color')])({'name': 'Zophie', 'age': 7})" ; chx:output "[True, False]" .
chx:X_KeyErrorOnMissing rd:hasIOExample chx:IO_KeyErrorOnMissing .
chx:X_MembershipOnKeys a owl:NamedIndividual, chx:MembershipOnKeys ; rdfs:label "'color' in spam"@en ; skos:definition "The in and not in operators applied to a dictionary ask about its keys; 'color' in spam is the same question as 'color' in spam.keys(), and the values have a separate test, 'red' in spam.values()."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_MembershipOnKeys a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: ('color' in spam, 'color' in spam.keys(), 'red' in spam, 'red' in spam.values(), 'age' not in spam.keys()))({'color': 'red', 'age': 42}) evaluates to (True, True, False, True, False)"@en ; chx:input "(lambda spam: ('color' in spam, 'color' in spam.keys(), 'red' in spam, 'red' in spam.values(), 'age' not in spam.keys()))({'color': 'red', 'age': 42})" ; chx:output "(True, True, False, True, False)" .
chx:X_MembershipOnKeys rd:hasIOExample chx:IO_MembershipOnKeys .
chx:X_GetMethod a owl:NamedIndividual, chx:GetMethod ; rdfs:label "picnic_items.get('eggs', 0)"@en ; skos:definition "The get method takes a key and a fallback value and returns the value of the key, or the fallback when the key is absent, without raising and without changing the dictionary."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_GetMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda picnic_items: (picnic_items.get('cups', 0), picnic_items.get('eggs', 0), picnic_items.get('eggs'), 'eggs' in picnic_items))({'apples': 5, 'cups': 2}) evaluates to (2, 0, None, False)"@en ; chx:input "(lambda picnic_items: (picnic_items.get('cups', 0), picnic_items.get('eggs', 0), picnic_items.get('eggs'), 'eggs' in picnic_items))({'apples': 5, 'cups': 2})" ; chx:output "(2, 0, None, False)" .
chx:X_GetMethod rd:hasIOExample chx:IO_GetMethod .
chx:X_SetdefaultMethod a owl:NamedIndividual, chx:SetdefaultMethod ; rdfs:label "spam.setdefault('color', 'black')"@en ; skos:definition "The setdefault method stores a default value under a key only if the key is not yet there, and in every case returns the value now stored."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_SetdefaultMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: (spam.setdefault('color', 'black'), spam.setdefault('color', 'white'), spam))({'name': 'Pooka', 'age': 5}) evaluates to ('black', 'black', {'name': 'Pooka', 'age': 5, 'color': 'black'})"@en ; chx:input "(lambda spam: (spam.setdefault('color', 'black'), spam.setdefault('color', 'white'), spam))({'name': 'Pooka', 'age': 5})" ; chx:output "('black', 'black', {'name': 'Pooka', 'age': 5, 'color': 'black'})" .
chx:X_SetdefaultMethod rd:hasIOExample chx:IO_SetdefaultMethod .
chx:X_AddOrReplacePair a owl:NamedIndividual, chx:AddOrReplacePair ; rdfs:label "birthdays[name] = bday"@en ; skos:definition "Assigning to a key with square brackets adds a pair when the key is new and replaces the value when the key exists; a new key goes at the end, and a replaced key keeps its place."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_AddOrReplacePair a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.__setitem__('Eve', 'Dec 5'), d.__setitem__('Bob', 'Dec 13'), list(d.items()), len(d))[2:])({'Alice': 'Apr 1', 'Bob': 'Dec 12'}) evaluates to ([('Alice', 'Apr 1'), ('Bob', 'Dec 13'), ('Eve', 'Dec 5')], 3)"@en ; chx:input "(lambda d: (d.__setitem__('Eve', 'Dec 5'), d.__setitem__('Bob', 'Dec 13'), list(d.items()), len(d))[2:])({'Alice': 'Apr 1', 'Bob': 'Dec 12'})" ; chx:output "([('Alice', 'Apr 1'), ('Bob', 'Dec 13'), ('Eve', 'Dec 5')], 3)" .
chx:X_AddOrReplacePair rd:hasIOExample chx:IO_AddOrReplacePair .
chx:X_DeletePair a owl:NamedIndividual, chx:DeletePair ; rdfs:label "del main_board[response[1]]"@en ; skos:definition "The del statement removes a key and its value from a dictionary, and raises KeyError when the key is not there; the chessboard's remove command and the second half of its move command are del statements."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DeletePair a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda main_board: (main_board.__setitem__('e4', main_board['e2']), main_board.__delitem__('e2'), sorted(main_board))[2])({'e2': 'wP', 'e1': 'wK'}) evaluates to ['e1', 'e4']"@en ; chx:input "(lambda main_board: (main_board.__setitem__('e4', main_board['e2']), main_board.__delitem__('e2'), sorted(main_board))[2])({'e2': 'wP', 'e1': 'wK'})" ; chx:output "['e1', 'e4']" .
chx:X_DeletePair rd:hasIOExample chx:IO_DeletePair .
chx:X_PopMethod a owl:NamedIndividual, chx:PopMethod ; rdfs:label "d.pop('e2', None)"@en ; skos:definition "The pop method removes a key and returns its value; with a second argument it returns that default instead of raising KeyError when the key is absent, and popitem removes and returns the most recently added pair."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_PopMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.pop('e2'), d.pop('e2', None), d.popitem(), d))({'a1': 'wR', 'e2': 'wP', 'h8': 'bR'}) evaluates to ('wP', None, ('h8', 'bR'), {'a1': 'wR'})"@en ; chx:input "(lambda d: (d.pop('e2'), d.pop('e2', None), d.popitem(), d))({'a1': 'wR', 'e2': 'wP', 'h8': 'bR'})" ; chx:output "('wP', None, ('h8', 'bR'), {'a1': 'wR'})" .
chx:X_PopMethod rd:hasIOExample chx:IO_PopMethod .
chx:X_UpdateAndMerge a owl:NamedIndividual, chx:UpdateAndMerge ; rdfs:label "defaults | overrides"@en ; skos:definition "The update method copies the pairs of another mapping into a dictionary, and since Python 3.9 the operator | builds a new merged dictionary and |= updates in place; in every case the right-hand values win where the keys clash."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_UpdateAndMerge a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda defaults, overrides: (defaults | overrides, {**defaults, **overrides}, defaults))({'x': 1, 'y': 2}, {'y': 20}) evaluates to ({'x': 1, 'y': 20}, {'x': 1, 'y': 20}, {'x': 1, 'y': 2})"@en ; chx:input "(lambda defaults, overrides: (defaults | overrides, {**defaults, **overrides}, defaults))({'x': 1, 'y': 2}, {'y': 20})" ; chx:output "({'x': 1, 'y': 20}, {'x': 1, 'y': 20}, {'x': 1, 'y': 2})" .
chx:X_UpdateAndMerge rd:hasIOExample chx:IO_UpdateAndMerge .
chx:X_FromkeysMethod a owl:NamedIndividual, chx:FromkeysMethod ; rdfs:label "dict.fromkeys('abc', 0)"@en ; skos:definition "The class method dict.fromkeys builds a dictionary whose keys are the items of an iterable, all with one starting value; with a mutable value such as a list, every key shares that one object."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_FromkeysMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(dict.fromkeys('abc', 0), (lambda d: d['a'] is d['b'])(dict.fromkeys('ab', []))) evaluates to ({'a': 0, 'b': 0, 'c': 0}, True)"@en ; chx:input "(dict.fromkeys('abc', 0), (lambda d: d['a'] is d['b'])(dict.fromkeys('ab', [])))" ; chx:output "({'a': 0, 'b': 0, 'c': 0}, True)" .
chx:X_FromkeysMethod rd:hasIOExample chx:IO_FromkeysMethod .
chx:X_BirthdayLookup a owl:NamedIndividual, chx:BirthdayLookup ; rdfs:label "birthdays.py"@en ; skos:definition "The birthdays program keeps names as keys and birthdays as values in a dictionary, looks a typed name up with in and square brackets, and adds a pair for an unknown name."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_BirthdayLookup a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda birthdays, name: birthdays[name] + ' is the birthday of ' + name if name in birthdays else 'I do not have birthday information for ' + name)({'Alice': 'Apr 1', 'Bob': 'Dec 12', 'Carol': 'Mar 4'}, 'Alice') evaluates to 'Apr 1 is the birthday of Alice'"@en ; chx:input "(lambda birthdays, name: birthdays[name] + ' is the birthday of ' + name if name in birthdays else 'I do not have birthday information for ' + name)({'Alice': 'Apr 1', 'Bob': 'Dec 12', 'Carol': 'Mar 4'}, 'Alice')" ; chx:output "'Apr 1 is the birthday of Alice'" .
chx:X_BirthdayLookup rd:hasIOExample chx:IO_BirthdayLookup .
chx:X_KeysValuesItems a owl:NamedIndividual, chx:KeysValuesItems ; rdfs:label "spam.keys(), spam.values(), spam.items()"@en ; skos:definition "The methods keys(), values() and items() return views of the keys, of the values and of the (key, value) tuples of a dictionary, which can be looped over, counted and tested with in but not indexed or modified."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_KeysValuesItems a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: (repr(spam.keys()), repr(spam.values()), repr(spam.items()), list(spam.keys()), len(spam.items())))({'color': 'red', 'age': 42}) evaluates to ('dict_keys(['color', 'age'])', 'dict_values(['red', 42])', 'dict_items([('color', 'red'), ('age', 42)])', ['color', 'age'], 2)"@en ; chx:input "(lambda spam: (repr(spam.keys()), repr(spam.values()), repr(spam.items()), list(spam.keys()), len(spam.items())))({'color': 'red', 'age': 42})" ; chx:output "('dict_keys(['color', 'age'])', 'dict_values(['red', 42])', 'dict_items([('color', 'red'), ('age', 42)])', ['color', 'age'], 2)" .
chx:X_KeysValuesItems rd:hasIOExample chx:IO_KeysValuesItems .
chx:X_LiveAndSetLikeViews a owl:NamedIndividual, chx:LiveAndSetLikeViews ; rdfs:label "keys = spam.keys(); spam['name'] = 'Pooka'"@en ; skos:definition "A view is live: it shows later changes to its dictionary; and the keys view and the items view behave like sets, so they can be intersected, subtracted and compared with &, - and ==."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_LiveAndSetLikeViews a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: (lambda keys: (spam.__setitem__('name', 'Pooka'), list(keys), sorted(keys & {'age', 'x'}), sorted(keys - {'age'}), keys == {'color', 'age', 'name'})[1:])(spam.keys()))({'color': 'red', 'age': 42}) evaluates to (['color', 'age', 'name'], ['age'], ['color', 'name'], True)"@en ; chx:input "(lambda spam: (lambda keys: (spam.__setitem__('name', 'Pooka'), list(keys), sorted(keys & {'age', 'x'}), sorted(keys - {'age'}), keys == {'color', 'age', 'name'})[1:])(spam.keys()))({'color': 'red', 'age': 42})" ; chx:output "(['color', 'age', 'name'], ['age'], ['color', 'name'], True)" .
chx:X_LiveAndSetLikeViews rd:hasIOExample chx:IO_LiveAndSetLikeViews .
chx:X_ItemsLoop a owl:NamedIndividual, chx:ItemsLoop ; rdfs:label "for k, v in spam.items():"@en ; skos:definition "A for loop over items() unpacks each (key, value) tuple into two loop variables, so both halves of every pair are available in the body without a second lookup."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ItemsLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: ['Key: ' + str(k) + ' Value: ' + str(v) for k, v in spam.items()])({'color': 'red', 'age': 42}) evaluates to ['Key: color Value: red', 'Key: age Value: 42']"@en ; chx:input "(lambda spam: ['Key: ' + str(k) + ' Value: ' + str(v) for k, v in spam.items()])({'color': 'red', 'age': 42})" ; chx:output "['Key: color Value: red', 'Key: age Value: 42']" .
chx:X_ItemsLoop rd:hasIOExample chx:IO_ItemsLoop .
chx:X_SortedAndReversedLoops a owl:NamedIndividual, chx:SortedAndReversedLoops ; rdfs:label "for k in sorted(spam):  and  reversed(spam)"@en ; skos:definition "A dictionary loop follows insertion order; sorted() gives the keys, or the pairs, in order of their values, and reversed() gives the newest key first."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_SortedAndReversedLoops a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (sorted(s), list(reversed(s)), sorted(s.items(), key=lambda kv: kv[1]), sorted(s.items(), key=lambda kv: kv[1], reverse=True)[0]))({'b': 2, 'a': 3, 'c': 1}) evaluates to (['a', 'b', 'c'], ['c', 'a', 'b'], [('c', 1), ('b', 2), ('a', 3)], ('a', 3))"@en ; chx:input "(lambda s: (sorted(s), list(reversed(s)), sorted(s.items(), key=lambda kv: kv[1]), sorted(s.items(), key=lambda kv: kv[1], reverse=True)[0]))({'b': 2, 'a': 3, 'c': 1})" ; chx:output "(['a', 'b', 'c'], ['c', 'a', 'b'], [('c', 1), ('b', 2), ('a', 3)], ('a', 3))" .
chx:X_SortedAndReversedLoops rd:hasIOExample chx:IO_SortedAndReversedLoops .
chx:X_ChangeWhileLooping a owl:NamedIndividual, chx:ChangeWhileLooping ; rdfs:label "for k in spam: spam[k + 'x'] = 1"@en ; skos:definition "Adding or deleting keys while a loop walks over the dictionary raises RuntimeError, because the walk would lose its place; replacing the values of existing keys is allowed, and looping over list(spam) gives a snapshot that is safe to change."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChangeWhileLooping a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.update({k: v * 2 for k, v in d.items()}), [d.__delitem__(k) for k in list(d) if d[k] > 2], d)[2])({'a': 1, 'b': 2, 'c': 3}) evaluates to {'a': 2}"@en ; chx:input "(lambda d: (d.update({k: v * 2 for k, v in d.items()}), [d.__delitem__(k) for k in list(d) if d[k] > 2], d)[2])({'a': 1, 'b': 2, 'c': 3})" ; chx:output "{'a': 2}" .
chx:X_ChangeWhileLooping rd:hasIOExample chx:IO_ChangeWhileLooping .
chx:X_DictComprehension a owl:NamedIndividual, chx:DictComprehension ; rdfs:label "{v: k for k, v in spam.items()}"@en ; skos:definition "A dictionary comprehension builds a new dictionary from a loop in one expression, key: value for item in iterable, with an optional if to filter; it can invert a dictionary, filter its pairs or index a list."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DictComprehension a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: ({v: k for k, v in d.items()}, {k: v for k, v in d.items() if v > 1}, {c: ord(c) for c in 'ab'}, {w[0]: w for w in ['apple', 'avocado']}))({'a': 1, 'b': 2, 'c': 3}) evaluates to ({1: 'a', 2: 'b', 3: 'c'}, {'b': 2, 'c': 3}, {'a': 97, 'b': 98}, {'a': 'avocado'})"@en ; chx:input "(lambda d: ({v: k for k, v in d.items()}, {k: v for k, v in d.items() if v > 1}, {c: ord(c) for c in 'ab'}, {w[0]: w for w in ['apple', 'avocado']}))({'a': 1, 'b': 2, 'c': 3})" ; chx:output "({1: 'a', 2: 'b', 3: 'c'}, {'b': 2, 'c': 3}, {'a': 97, 'b': 98}, {'a': 'avocado'})" .
chx:X_DictComprehension rd:hasIOExample chx:IO_DictComprehension .
chx:X_CharacterCount a owl:NamedIndividual, chx:CharacterCount ; rdfs:label "count.setdefault(character, 0); count[character] += 1"@en ; skos:definition "The program characterCount.py counts how often each character occurs in a string by making sure the key exists with setdefault and then adding one, and ends with a dictionary of letter counts."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_CharacterCount a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda message: (lambda count: ([count.__setitem__(c, count.get(c, 0) + 1) for c in message], count['c'], count[' '], count['A'], len(count), sum(count.values()))[1:])({}))('It was a bright cold day in April, and the clocks were striking thirteen.') evaluates to (3, 13, 1, 23, 73)"@en ; chx:input "(lambda message: (lambda count: ([count.__setitem__(c, count.get(c, 0) + 1) for c in message], count['c'], count[' '], count['A'], len(count), sum(count.values()))[1:])({}))('It was a bright cold day in April, and the clocks were striking thirteen.')" ; chx:output "(3, 13, 1, 23, 73)" .
chx:X_CharacterCount rd:hasIOExample chx:IO_CharacterCount .
chx:X_CounterClass a owl:NamedIndividual, chx:CounterClass ; rdfs:label "collections.Counter('abracadabra')"@en ; skos:definition "The Counter class of the collections module is a dictionary made for counting: it counts the items of an iterable in one call, returns 0 for a missing item without adding it, adds and subtracts counts, and lists the commonest items with most_common."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_CounterClass a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda C: (C('abracadabra').most_common(2), C('abracadabra')['z'], C(a=3) + C(a=1, b=2), C(a=1) - C(a=5)))(__import__('collections').Counter) evaluates to ([('a', 5), ('b', 2)], 0, Counter({'a': 4, 'b': 2}), Counter())"@en ; chx:input "(lambda C: (C('abracadabra').most_common(2), C('abracadabra')['z'], C(a=3) + C(a=1, b=2), C(a=1) - C(a=5)))(__import__('collections').Counter)" ; chx:output "([('a', 5), ('b', 2)], 0, Counter({'a': 4, 'b': 2}), Counter())" .
chx:X_CounterClass rd:hasIOExample chx:IO_CounterClass .
chx:X_DefaultdictCounting a owl:NamedIndividual, chx:DefaultdictCounting ; rdfs:label "collections.defaultdict(int)"@en ; skos:definition "A defaultdict calls a factory function to create the value for a missing key and stores it, so defaultdict(int) starts every count at 0 and lets count[key] += 1 work on a key that has never been seen."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DefaultdictCounting a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda dd: (dd.__setitem__('x', dd['x'] + 1), dd['y'], dict(dd), dd.default_factory.__name__, dd.get('q'), 'q' in dd)[2:])(__import__('collections').defaultdict(int)) evaluates to ({'x': 1, 'y': 0}, 'int', None, False)"@en ; chx:input "(lambda dd: (dd.__setitem__('x', dd['x'] + 1), dd['y'], dict(dd), dd.default_factory.__name__, dd.get('q'), 'q' in dd)[2:])(__import__('collections').defaultdict(int))" ; chx:output "({'x': 1, 'y': 0}, 'int', None, False)" .
chx:X_DefaultdictCounting rd:hasIOExample chx:IO_DefaultdictCounting .
chx:X_GroupingIntoLists a owl:NamedIndividual, chx:GroupingIntoLists ; rdfs:label "groups.setdefault(word[0], []).append(word)"@en ; skos:definition "Grouping puts each item into the list stored under its label; setdefault(label, []) creates the list on the first sight of a label and returns it, so .append can follow in the same statement, and a defaultdict(list) does the same without the call."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_GroupingIntoLists a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda w: (lambda g: ([g.setdefault(x[0], []).append(x) for x in w], g)[1])({}))(['apple', 'avocado', 'banana', 'blueberry', 'cherry', 'apricot']) evaluates to {'a': ['apple', 'avocado', 'apricot'], 'b': ['banana', 'blueberry'], 'c': ['cherry']}"@en ; chx:input "(lambda w: (lambda g: ([g.setdefault(x[0], []).append(x) for x in w], g)[1])({}))(['apple', 'avocado', 'banana', 'blueberry', 'cherry', 'apricot'])" ; chx:output "{'a': ['apple', 'avocado', 'apricot'], 'b': ['banana', 'blueberry'], 'c': ['cherry']}" .
chx:X_GroupingIntoLists rd:hasIOExample chx:IO_GroupingIntoLists .
chx:X_MissingKeyHook a owl:NamedIndividual, chx:MissingKeyHook ; rdfs:label "class Zero(dict): def __missing__(self, key): return 0"@en ; skos:definition "A dictionary subclass that defines the method __missing__ decides what d[key] means for an absent key; the lookup calls it, while get() and the in test do not, and what it returns is not stored unless the method stores it."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_MissingKeyHook a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda Z: (Z()['a'], 'a' in Z(), Z().get('a'), len(Z())))(type('Z', (dict,), {'__missing__': lambda self, key: 0})) evaluates to (0, False, None, 0)"@en ; chx:input "(lambda Z: (Z()['a'], 'a' in Z(), Z().get('a'), len(Z())))(type('Z', (dict,), {'__missing__': lambda self, key: 0}))" ; chx:output "(0, False, None, 0)" .
chx:X_MissingKeyHook rd:hasIOExample chx:IO_MissingKeyHook .
chx:X_DataStructureModel a owl:NamedIndividual, chx:DataStructureModel ; rdfs:label "{'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'}"@en ; skos:definition "A data structure models a real thing when its parts stand for the parts of the thing; the five pairs of this dictionary stand for five pieces on a chessboard, with each square as a key and each piece as its value."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DataStructureModel a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b: (len(b), b['c6'], 'a1' in b))({'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'}) evaluates to (5, 'wQ', False)"@en ; chx:input "(lambda b: (len(b), b['c6'], 'a1' in b))({'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'})" ; chx:output "(5, 'wQ', False)" .
chx:X_DataStructureModel rd:hasIOExample chx:IO_DataStructureModel .
chx:X_ChessboardModel a owl:NamedIndividual, chx:ChessboardModel ; rdfs:label "STARTING_PIECES"@en ; skos:definition "The chessboard simulator keeps the position as a dictionary from square names a1 to h8 to piece names such as wR, with a constant STARTING_PIECES holding the 32 pieces of the starting position and a copy of it made whenever the board is reset."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChessboardModel a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda S: (len(S), S['d1'], S['e8'], sorted(set(S.values())), sum(p[0] == 'w' for p in S.values())))({**{c + '1': 'w' + p for c, p in zip('abcdefgh', 'RNBQKBNR')}, **{c + '2': 'wP' for c in 'abcdefgh'}, **{c + '8': 'b' + p for c, p in zip('abcdefgh', 'RNBQKBNR')}, **{c + '7': 'bP' for c in 'abcdefgh'}}) evaluates to (32, 'wQ', 'bK', ['bB', 'bK', 'bN', 'bP', 'bQ', 'bR', 'wB', 'wK', 'wN', 'wP', 'wQ', 'wR'], 16)"@en ; chx:input "(lambda S: (len(S), S['d1'], S['e8'], sorted(set(S.values())), sum(p[0] == 'w' for p in S.values())))({**{c + '1': 'w' + p for c, p in zip('abcdefgh', 'RNBQKBNR')}, **{c + '2': 'wP' for c in 'abcdefgh'}, **{c + '8': 'b' + p for c, p in zip('abcdefgh', 'RNBQKBNR')}, **{c + '7': 'bP' for c in 'abcdefgh'}})" ; chx:output "(32, 'wQ', 'bK', ['bB', 'bK', 'bN', 'bP', 'bQ', 'bR', 'wB', 'wK', 'wN', 'wP', 'wQ', 'wR'], 16)" .
chx:X_ChessboardModel rd:hasIOExample chx:IO_ChessboardModel .
chx:X_BoardTemplate a owl:NamedIndividual, chx:BoardTemplate ; rdfs:label "BOARD_TEMPLATE.format(*squares)"@en ; skos:definition "The board is drawn from a template, a multi-line string with 64 empty pairs of curly brackets, one for each square, which the format method fills with 64 strings in order."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_BoardTemplate a owl:NamedIndividual, rd:IOExample ; rdfs:label "'| {} | {} |'.format('wK', 'bK') evaluates to '| wK | bK |'"@en ; chx:input "'| {} | {} |'.format('wK', 'bK')" ; chx:output "'| wK | bK |'" .
chx:X_BoardTemplate rd:hasIOExample chx:IO_BoardTemplate .
chx:X_ChessboardPrinter a owl:NamedIndividual, chx:ChessboardPrinter ; rdfs:label "print_chessboard(board)"@en ; skos:definition "The function print_chessboard builds a list of 64 strings by looping over the ranks 8 to 1 and the files a to h, taking the piece from the dictionary when the square is a key and an empty-square string otherwise, with a Boolean tracking the colour of the square."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChessboardPrinter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda board: (lambda sq: (len(sq), sq[0], sq[1], sq[63]))([board[x + y] if x + y in board else ('||' if (i + j) % 2 == 0 else '  ') for i, y in enumerate('87654321') for j, x in enumerate('abcdefgh')]))({'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'}) evaluates to (64, '||', '  ', 'bK')"@en ; chx:input "(lambda board: (lambda sq: (len(sq), sq[0], sq[1], sq[63]))([board[x + y] if x + y in board else ('||' if (i + j) % 2 == 0 else '  ') for i, y in enumerate('87654321') for j, x in enumerate('abcdefgh')]))({'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'})" ; chx:output "(64, '||', '  ', 'bK')" .
chx:X_ChessboardPrinter rd:hasIOExample chx:IO_ChessboardPrinter .
chx:X_StarSyntax a owl:NamedIndividual, chx:StarSyntax ; rdfs:label "BOARD_TEMPLATE.format(*squares)  and  print(*spam)"@en ; skos:definition "A star before a list in a call passes the list's items as separate arguments, and a double star before a dictionary passes its pairs as keyword arguments, so format(*squares) gives format 64 arguments instead of one list."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_StarSyntax a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: ('{} {} {}'.format(*spam), '{a}-{b}'.format(**{'a': 1, 'b': 2})))(['cat', 'dog', 'rat']) evaluates to ('cat dog rat', '1-2')"@en ; chx:input "(lambda spam: ('{} {} {}'.format(*spam), '{a}-{b}'.format(**{'a': 1, 'b': 2})))(['cat', 'dog', 'rat'])" ; chx:output "('cat dog rat', '1-2')" .
chx:X_StarSyntax rd:hasIOExample chx:IO_StarSyntax .
chx:X_ChessboardCommands a owl:NamedIndividual, chx:ChessboardCommands ; rdfs:label "input('> ').split()"@en ; skos:definition "The simulator reads a line, splits it into words with split(), and chooses the action from the first word: move copies and deletes a pair, remove deletes, set assigns, reset copies the starting position, clear makes an empty dictionary, fill sets all 64 squares, and quit ends the program."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChessboardCommands a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda response: (response, response[0], response[1:]))('move e2 e4'.split()) evaluates to (['move', 'e2', 'e4'], 'move', ['e2', 'e4'])"@en ; chx:input "(lambda response: (response, response[0], response[1:]))('move e2 e4'.split())" ; chx:output "(['move', 'e2', 'e4'], 'move', ['e2', 'e4'])" .
chx:X_ChessboardCommands rd:hasIOExample chx:IO_ChessboardCommands .
chx:X_NestedDictionaries a owl:NamedIndividual, chx:NestedDictionaries ; rdfs:label "all_guests['Bob']['apples']"@en ; skos:definition "A nested dictionary holds dictionaries as values, and a lookup is chained, one pair of brackets for each level: all_guests['Bob']['apples'] first finds Bob's dictionary and then the apples in it."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_NestedDictionaries a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda all_guests: (all_guests['Bob']['apples'], 'cups' in all_guests['Bob'], sorted(all_guests['Carol']), len(all_guests)))({'Alice': {'apples': 5, 'pretzels': 12}, 'Bob': {'ham sandwiches': 3, 'apples': 2}, 'Carol': {'cups': 3, 'apple pies': 1}}) evaluates to (2, False, ['apple pies', 'cups'], 3)"@en ; chx:input "(lambda all_guests: (all_guests['Bob']['apples'], 'cups' in all_guests['Bob'], sorted(all_guests['Carol']), len(all_guests)))({'Alice': {'apples': 5, 'pretzels': 12}, 'Bob': {'ham sandwiches': 3, 'apples': 2}, 'Carol': {'cups': 3, 'apple pies': 1}})" ; chx:output "(2, False, ['apple pies', 'cups'], 3)" .
chx:X_NestedDictionaries rd:hasIOExample chx:IO_NestedDictionaries .
chx:X_TotalBrought a owl:NamedIndividual, chx:TotalBrought ; rdfs:label "total_brought(all_guests, 'apples')"@en ; skos:definition "The function total_brought loops over the guests with items() and adds v.get(item, 0) from each guest's dictionary, so a guest who does not bring the item adds zero, and the call for apples returns 7."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_TotalBrought a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda all_guests: [sum(v.get(item, 0) for k, v in all_guests.items()) for item in ('apples', 'cups', 'cakes', 'ham sandwiches', 'apple pies')])({'Alice': {'apples': 5, 'pretzels': 12}, 'Bob': {'ham sandwiches': 3, 'apples': 2}, 'Carol': {'cups': 3, 'apple pies': 1}}) evaluates to [7, 3, 0, 3, 1]"@en ; chx:input "(lambda all_guests: [sum(v.get(item, 0) for k, v in all_guests.items()) for item in ('apples', 'cups', 'cakes', 'ham sandwiches', 'apple pies')])({'Alice': {'apples': 5, 'pretzels': 12}, 'Bob': {'ham sandwiches': 3, 'apples': 2}, 'Carol': {'cups': 3, 'apple pies': 1}})" ; chx:output "[7, 3, 0, 3, 1]" .
chx:X_TotalBrought rd:hasIOExample chx:IO_TotalBrought .
chx:X_CopyingDictionaries a owl:NamedIndividual, chx:CopyingDictionaries ; rdfs:label "copy.copy(original)  and  copy.deepcopy(original)"@en ; skos:definition "An assignment makes a second name for the same dictionary; copy.copy makes a new outer dictionary that still shares the inner ones; copy.deepcopy copies every level, so changing an inner value of the original reaches the alias and the shallow copy but not the deep copy."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_CopyingDictionaries a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda copy, o: (lambda s, d: (o['Alice'].__setitem__('apples', 99), s['Alice']['apples'], d['Alice']['apples'], s['Alice'] is o['Alice'], d['Alice'] is o['Alice'])[1:])(copy.copy(o), copy.deepcopy(o)))(__import__('copy'), {'Alice': {'apples': 5}}) evaluates to (99, 5, True, False)"@en ; chx:input "(lambda copy, o: (lambda s, d: (o['Alice'].__setitem__('apples', 99), s['Alice']['apples'], d['Alice']['apples'], s['Alice'] is o['Alice'], d['Alice'] is o['Alice'])[1:])(copy.copy(o), copy.deepcopy(o)))(__import__('copy'), {'Alice': {'apples': 5}})" ; chx:output "(99, 5, True, False)" .
chx:X_CopyingDictionaries rd:hasIOExample chx:IO_CopyingDictionaries .
chx:X_PrettyPrinting a owl:NamedIndividual, chx:PrettyPrinting ; rdfs:label "pprint.pprint(spam)"@en ; skos:definition "The pprint module prints a dictionary in a readable layout, with the keys in sorted order by default and nested structures broken over lines when they are wider than the line width; pformat returns the same text as a string."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_PrettyPrinting a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda p: (p.pformat({'b': 1, 'a': 2}), p.pformat({'b': 1, 'a': 2}, sort_dicts=False)))(__import__('pprint')) evaluates to ('{'a': 2, 'b': 1}', '{'b': 1, 'a': 2}')"@en ; chx:input "(lambda p: (p.pformat({'b': 1, 'a': 2}), p.pformat({'b': 1, 'a': 2}, sort_dicts=False)))(__import__('pprint'))" ; chx:output "('{'a': 2, 'b': 1}', '{'b': 1, 'a': 2}')" .
chx:X_PrettyPrinting rd:hasIOExample chx:IO_PrettyPrinting .
chx:X_JsonText a owl:NamedIndividual, chx:JsonText ; rdfs:label "json.dumps(spam) and json.loads(text)"@en ; skos:definition "JSON is a text notation whose objects and arrays correspond to dictionaries and lists; json.dumps turns a structure into text and json.loads turns text back, with the limits that JSON keys are always strings and a tuple comes back as a list."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_JsonText a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda j: (j.dumps({'b': 1, 'a': [1, 2]}), j.loads(j.dumps({1: 'a'})), j.loads(j.dumps({'t': (1, 2)}))))(__import__('json')) evaluates to ('{'b': 1, 'a': [1, 2]}', {'1': 'a'}, {'t': [1, 2]})"@en ; chx:input "(lambda j: (j.dumps({'b': 1, 'a': [1, 2]}), j.loads(j.dumps({1: 'a'})), j.loads(j.dumps({'t': (1, 2)}))))(__import__('json'))" ; chx:output "('{'b': 1, 'a': [1, 2]}', {'1': 'a'}, {'t': [1, 2]})" .
chx:X_JsonText rd:hasIOExample chx:IO_JsonText .
chx:X_TypedModels a owl:NamedIndividual, chx:TypedModels ; rdfs:label "class Cat(TypedDict): size: str; age: int"@en ; skos:definition "A TypedDict class declares which keys a dictionary should have and what type each value should be, for a type checker to verify; at run time the object is still an ordinary dict."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_TypedModels a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda T: (T(size='fat', age=17), type(T(size='fat', age=17)).__name__, sorted(T.__required_keys__)))(__import__('typing').TypedDict('Cat', {'size': str, 'age': int})) evaluates to ({'size': 'fat', 'age': 17}, 'dict', ['age', 'size'])"@en ; chx:input "(lambda T: (T(size='fat', age=17), type(T(size='fat', age=17)).__name__, sorted(T.__required_keys__)))(__import__('typing').TypedDict('Cat', {'size': str, 'age': int}))" ; chx:output "({'size': 'fat', 'age': 17}, 'dict', ['age', 'size'])" .
chx:X_TypedModels rd:hasIOExample chx:IO_TypedModels .
chx:X_MappingPattern a owl:NamedIndividual, chx:MappingPattern ; rdfs:label "match command: case {'type': 'move', 'from': a, 'to': b}:"@en ; skos:definition "The match statement can take a dictionary apart by its shape: a mapping pattern matches when the keys it names are present, binds the values it names, and ignores any other keys."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_MappingPattern a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ns: (exec('def f(p):' + chr(10) + ' match p:' + chr(10) + '  case {1: a, 2: b}:' + chr(10) + '   return (a, b)' + chr(10) + '  case _:' + chr(10) + '   return None', ns), ns['f']({1: 'e2', 2: 'e4', 3: 'extra'}), ns['f']({}))[1:])({}) evaluates to (('e2', 'e4'), None)"@en ; chx:input "(lambda ns: (exec('def f(p):' + chr(10) + ' match p:' + chr(10) + '  case {1: a, 2: b}:' + chr(10) + '   return (a, b)' + chr(10) + '  case _:' + chr(10) + '   return None', ns), ns['f']({1: 'e2', 2: 'e4', 3: 'extra'}), ns['f']({}))[1:])({})" ; chx:output "(('e2', 'e4'), None)" .
chx:X_MappingPattern rd:hasIOExample chx:IO_MappingPattern .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "spam.setdefault('color', 'black')"@en ; skos:definition "The eight practice questions are answered by the empty dictionary {}, the pair {'foo': 42}, keys instead of indexes, KeyError for a missing key, in on keys with or without keys(), in on values, setdefault as the shortcut, and the pprint module."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_PracticeQuestions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda spam: ({}, {'foo': 42}, spam.setdefault('color', 'black'), spam))({}) evaluates to ({}, {'foo': 42}, 'black', {'color': 'black'})"@en ; chx:input "(lambda spam: ({}, {'foo': 42}, spam.setdefault('color', 'black'), spam))({})" ; chx:output "({}, {'foo': 42}, 'black', {'color': 'black'})" .
chx:X_PracticeQuestions rd:hasIOExample chx:IO_PracticeQuestions .
chx:X_ChessValidator a owl:NamedIndividual, chx:ChessValidator ; rdfs:label "is_valid_chessboard(board)"@en ; skos:definition "The validator checks that every key is a square from a1 to h8, every value is a colour letter and a piece letter, each side has exactly one king, at most eight pawns and at most sixteen pieces, and returns True or False."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChessValidator a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda valid, b: (valid(b), valid({**b, 'a1': 'wK'}), valid({**b, 'i9': 'wP'}), valid({**b, **{c + '2': 'wP' for c in 'abcdefgh'}, 'a3': 'wP'})))(lambda b: all(len(s) == 2 and s[0] in 'abcdefgh' and s[1] in '12345678' and len(p) == 2 and p[0] in 'wb' and p[1] in 'PNBRQK' for s, p in b.items()) and all(list(b.values()).count(c + 'K') == 1 and list(b.values()).count(c + 'P') <= 8 and sum(p[0] == c for p in b.values()) <= 16 for c in 'wb'), {'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'}) evaluates to (True, False, False, False)"@en ; chx:input "(lambda valid, b: (valid(b), valid({**b, 'a1': 'wK'}), valid({**b, 'i9': 'wP'}), valid({**b, **{c + '2': 'wP' for c in 'abcdefgh'}, 'a3': 'wP'})))(lambda b: all(len(s) == 2 and s[0] in 'abcdefgh' and s[1] in '12345678' and len(p) == 2 and p[0] in 'wb' and p[1] in 'PNBRQK' for s, p in b.items()) and all(list(b.values()).count(c + 'K') == 1 and list(b.values()).count(c + 'P') <= 8 and sum(p[0] == c for p in b.values()) <= 16 for c in 'wb'), {'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'})" ; chx:output "(True, False, False, False)" .
chx:X_ChessValidator rd:hasIOExample chx:IO_ChessValidator .
chx:X_FantasyInventory a owl:NamedIndividual, chx:FantasyInventory ; rdfs:label "display_inventory(stuff)"@en ; skos:definition "The function display_inventory loops over items(), prints each count and item and adds the counts into a total, which for the inventory of rope, torch, gold coin, dagger and arrow is 62."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_FantasyInventory a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda stuff: (sum(stuff.values()), [str(v) + ' ' + k for k, v in stuff.items()][:2]))({'rope': 1, 'torch': 6, 'gold coin': 42, 'dagger': 1, 'arrow': 12}) evaluates to (62, ['1 rope', '6 torch'])"@en ; chx:input "(lambda stuff: (sum(stuff.values()), [str(v) + ' ' + k for k, v in stuff.items()][:2]))({'rope': 1, 'torch': 6, 'gold coin': 42, 'dagger': 1, 'arrow': 12})" ; chx:output "(62, ['1 rope', '6 torch'])" .
chx:X_FantasyInventory rd:hasIOExample chx:IO_FantasyInventory .
chx:X_LootConversion a owl:NamedIndividual, chx:LootConversion ; rdfs:label "add_to_inventory(inv, dragon_loot)"@en ; skos:definition "The function add_to_inventory takes an inventory dictionary and a list of found items, possibly with repeats, adds one for each occurrence with setdefault and returns the updated dictionary; the Counter class does the same count in one call."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_LootConversion a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda add: add({'gold coin': 42, 'rope': 1}, ['gold coin', 'dagger', 'gold coin', 'gold coin', 'ruby']))(lambda inv, items: ([inv.__setitem__(i, inv.get(i, 0) + 1) for i in items], inv)[1]) evaluates to {'gold coin': 45, 'rope': 1, 'dagger': 1, 'ruby': 1}"@en ; chx:input "(lambda add: add({'gold coin': 42, 'rope': 1}, ['gold coin', 'dagger', 'gold coin', 'gold coin', 'ruby']))(lambda inv, items: ([inv.__setitem__(i, inv.get(i, 0) + 1) for i in items], inv)[1])" ; chx:output "{'gold coin': 45, 'rope': 1, 'dagger': 1, 'ruby': 1}" .
chx:X_LootConversion rd:hasIOExample chx:IO_LootConversion .
