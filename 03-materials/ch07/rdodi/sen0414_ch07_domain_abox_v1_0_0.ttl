chx:X_DictionaryType a owl:NamedIndividual, chx:DictionaryType ; rdfs:label "my_cat = {'size': 'fat', 'color': 'gray', 'age': 17}"@en ; skos:definition "A dictionary is a mutable collection of key-value pairs written between curly brackets; a key picks its value the way an index picks an item of a list, but a key may be of almost any type and each key occurs only once; {} is the empty dictionary, and an empty set has no literal."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DictionaryType a owl:NamedIndividual, rd:IOExample ; rdfs:label "({'size': 'fat', 'color': 'gray', 'age': 17}['color'], {}, type({}).__name__, type({'a'}).__name__) evaluates to ('gray', {}, 'dict', 'set')"@en ; chx:input "({'size': 'fat', 'color': 'gray', 'age': 17}['color'], {}, type({}).__name__, type({'a'}).__name__)" ; chx:output "('gray', {}, 'dict', 'set')" .
chx:X_DictionaryType rd:hasIOExample chx:IO_DictionaryType .
chx:X_DictionaryConstructors a owl:NamedIndividual, chx:DictionaryConstructors ; rdfs:label "dict(one=1, two=2) and dict(zip(keys, values))"@en ; skos:definition "The dict constructor builds a dictionary from keyword arguments, from pairs, from another mapping or from zip of two lists, and when a key occurs twice the last value wins; keyword arguments work only for keys that are valid names."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DictionaryConstructors a owl:NamedIndividual, rd:IOExample ; rdfs:label "(dict([('two', 2), ('one', 1)]) == dict(one=1, two=2) == dict(zip(['one', 'two'], [1, 2])), dict([('k', 1), ('k', 2)])) evaluates to (True, {'k': 2})"@en ; chx:input "(dict([('two', 2), ('one', 1)]) == dict(one=1, two=2) == dict(zip(['one', 'two'], [1, 2])), dict([('k', 1), ('k', 2)]))" ; chx:output "(True, {'k': 2})" .
chx:X_DictionaryConstructors rd:hasIOExample chx:IO_DictionaryConstructors .
chx:X_KeysNotIndexes a owl:NamedIndividual, chx:KeysNotIndexes ; rdfs:label "spam[0] with spam = {12345: 'Luggage Combination', 42: 'The Answer'}"@en ; skos:definition "A dictionary has keys, not positions: d[0] looks for a key equal to 0, and raises KeyError when there is none, even though the dictionary holds two items; a missing key is reported as KeyError with the key as its message."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_KeysNotIndexes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d[42], 0 in d, len(d)))({12345: 'Luggage Combination', 42: 'The Answer'}) evaluates to ('The Answer', False, 2)"@en ; chx:input "(lambda d: (d[42], 0 in d, len(d)))({12345: 'Luggage Combination', 42: 'The Answer'})" ; chx:output "('The Answer', False, 2)" .
chx:X_KeysNotIndexes rd:hasIOExample chx:IO_KeysNotIndexes .
chx:X_HashableKeys a owl:NamedIndividual, chx:HashableKeys ; rdfs:label "{[1, 2]: 'x'}"@en ; skos:definition "A key must be hashable, so a number, a string or a tuple of hashable items can be a key while a list or a dictionary cannot; the chapter calls these types unhashable and suggests a tuple where a list is wanted, and a tuple that holds a list is refused too."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_HashableKeys a owl:NamedIndividual, rd:IOExample ; rdfs:label "[isinstance(x, __import__('collections.abc').abc.Hashable) for x in ('a', 1, (1, 2), [1], {})] evaluates to [True, True, True, False, False]"@en ; chx:input "[isinstance(x, __import__('collections.abc').abc.Hashable) for x in ('a', 1, (1, 2), [1], {})]" ; chx:output "[True, True, True, False, False]" .
chx:X_HashableKeys rd:hasIOExample chx:IO_HashableKeys .
chx:X_EqualKeysShareASlot a owl:NamedIndividual, chx:EqualKeysShareASlot ; rdfs:label "{1: 'a', 1.0: 'b', True: 'c'}"@en ; skos:definition "Keys that compare equal and have the same hash are one key, so 1, 1.0 and True name a single pair, which keeps the first key object and takes the last value."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_EqualKeysShareASlot a owl:NamedIndividual, rd:IOExample ; rdfs:label "{1: 'a', 1.0: 'b', True: 'c'} evaluates to {1: 'c'}"@en ; chx:input "{1: 'a', 1.0: 'b', True: 'c'}" ; chx:output "{1: 'c'}" .
chx:X_EqualKeysShareASlot rd:hasIOExample chx:IO_EqualKeysShareASlot .
chx:X_OrderInsensitiveEquality a owl:NamedIndividual, chx:OrderInsensitiveEquality ; rdfs:label "eggs == ham"@en ; skos:definition "Two dictionaries are equal when they hold the same pairs, whatever the order in which the pairs were entered, where two lists are equal only when their items are in the same order."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_OrderInsensitiveEquality a owl:NamedIndividual, rd:IOExample ; rdfs:label "({'name': 'Zophie', 'species': 'cat', 'age': '8'} == {'species': 'cat', 'age': '8', 'name': 'Zophie'}, ['cats', 'dogs'] == ['dogs', 'cats']) evaluates to (True, False)"@en ; chx:input "({'name': 'Zophie', 'species': 'cat', 'age': '8'} == {'species': 'cat', 'age': '8', 'name': 'Zophie'}, ['cats', 'dogs'] == ['dogs', 'cats'])" ; chx:output "(True, False)" .
chx:X_OrderInsensitiveEquality rd:hasIOExample chx:IO_OrderInsensitiveEquality .
chx:X_InsertionOrder a owl:NamedIndividual, chx:InsertionOrder ; rdfs:label "list(d)"@en ; skos:definition "Since Python 3.7 a dictionary remembers the order in which its keys were first inserted and every loop, list and display follows that order; replacing a value keeps the position of its key and a key added after a deletion goes to the end; the chapter's statement that items are unordered describes older versions."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_InsertionOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.__setitem__('one', 42), d.__delitem__('two'), d.__setitem__('two', None), list(d))[3])({'one': 1, 'two': 2, 'three': 3}) evaluates to ['one', 'three', 'two']"@en ; chx:input "(lambda d: (d.__setitem__('one', 42), d.__delitem__('two'), d.__setitem__('two', None), list(d))[3])({'one': 1, 'two': 2, 'three': 3})" ; chx:output "['one', 'three', 'two']" .
chx:X_InsertionOrder rd:hasIOExample chx:IO_InsertionOrder .
chx:X_MappingNotSequence a owl:NamedIndividual, chx:MappingNotSequence ; rdfs:label "d[0:2]"@en ; skos:definition "A dictionary is a mapping and not a sequence: it cannot be sliced, the subscript d[0:2] is looked up as a key, and only equality, not ordering, can be used to compare two dictionaries."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_MappingNotSequence a owl:NamedIndividual, rd:IOExample ; rdfs:label "[isinstance({}, __import__('collections.abc').abc.Sequence), isinstance({}, __import__('collections.abc').abc.Mapping), isinstance([], __import__('collections.abc').abc.Sequence)] evaluates to [False, True, True]"@en ; chx:input "[isinstance({}, __import__('collections.abc').abc.Sequence), isinstance({}, __import__('collections.abc').abc.Mapping), isinstance([], __import__('collections.abc').abc.Sequence)]" ; chx:output "[False, True, True]" .
chx:X_MappingNotSequence rd:hasIOExample chx:IO_MappingNotSequence .
chx:X_MembershipOnKeys a owl:NamedIndividual, chx:MembershipOnKeys ; rdfs:label "'color' in spam"@en ; skos:definition "The in and not in operators on a dictionary test for a key, exactly as 'color' in spam.keys() does; a value is tested with spam.values()."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_MembershipOnKeys a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: ('color' in d, 'color' in d.keys(), 'red' in d.values(), 'red' in d))({'color': 'red', 'age': 42}) evaluates to (True, True, True, False)"@en ; chx:input "(lambda d: ('color' in d, 'color' in d.keys(), 'red' in d.values(), 'red' in d))({'color': 'red', 'age': 42})" ; chx:output "(True, True, True, False)" .
chx:X_MembershipOnKeys rd:hasIOExample chx:IO_MembershipOnKeys .
chx:X_GetMethod a owl:NamedIndividual, chx:GetMethod ; rdfs:label "picnic_items.get('eggs', 0)"@en ; skos:definition "The get method takes a key and a fallback and returns the value of the key or the fallback without adding anything to the dictionary; without a fallback it gives None, so it never raises KeyError."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_GetMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.get('cups', 0), d.get('eggs', 0), d.get('eggs'), d))({'apples': 5, 'cups': 2}) evaluates to (2, 0, None, {'apples': 5, 'cups': 2})"@en ; chx:input "(lambda d: (d.get('cups', 0), d.get('eggs', 0), d.get('eggs'), d))({'apples': 5, 'cups': 2})" ; chx:output "(2, 0, None, {'apples': 5, 'cups': 2})" .
chx:X_GetMethod rd:hasIOExample chx:IO_GetMethod .
chx:X_SetdefaultMethod a owl:NamedIndividual, chx:SetdefaultMethod ; rdfs:label "spam.setdefault('color', 'black')"@en ; skos:definition "The setdefault method stores a value only when the key is absent and returns the value the key has afterwards, so it replaces a three-line if test and leaves an existing value alone."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_SetdefaultMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.setdefault('color', 'black'), d.setdefault('color', 'white'), d))({'name': 'Pooka', 'age': 5}) evaluates to ('black', 'black', {'name': 'Pooka', 'age': 5, 'color': 'black'})"@en ; chx:input "(lambda d: (d.setdefault('color', 'black'), d.setdefault('color', 'white'), d))({'name': 'Pooka', 'age': 5})" ; chx:output "('black', 'black', {'name': 'Pooka', 'age': 5, 'color': 'black'})" .
chx:X_SetdefaultMethod rd:hasIOExample chx:IO_SetdefaultMethod .
chx:X_AddOrReplacePair a owl:NamedIndividual, chx:AddOrReplacePair ; rdfs:label "birthdays[name] = bday"@en ; skos:definition "Assigning to a key adds the pair when the key is new and replaces the value when it exists; the chapter's birthday program uses it to grow its dictionary while it runs, and everything entered is lost when the program ends."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_AddOrReplacePair a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.__setitem__('Eve', 'Dec 5'), d.__setitem__('Alice', 'Apr 2'), d)[2])({'Alice': 'Apr 1', 'Bob': 'Dec 12'}) evaluates to {'Alice': 'Apr 2', 'Bob': 'Dec 12', 'Eve': 'Dec 5'}"@en ; chx:input "(lambda d: (d.__setitem__('Eve', 'Dec 5'), d.__setitem__('Alice', 'Apr 2'), d)[2])({'Alice': 'Apr 1', 'Bob': 'Dec 12'})" ; chx:output "{'Alice': 'Apr 2', 'Bob': 'Dec 12', 'Eve': 'Dec 5'}" .
chx:X_AddOrReplacePair rd:hasIOExample chx:IO_AddOrReplacePair .
chx:X_DeletePair a owl:NamedIndividual, chx:DeletePair ; rdfs:label "del main_board[response[1]]"@en ; skos:definition "The del statement removes the pair of a key and returns nothing, and raises KeyError when the key is absent; clear empties the whole dictionary."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DeletePair a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.__delitem__('e2'), d)[1])({'e2': 'wP', 'e4': 'bP'}) evaluates to {'e4': 'bP'}"@en ; chx:input "(lambda d: (d.__delitem__('e2'), d)[1])({'e2': 'wP', 'e4': 'bP'})" ; chx:output "{'e4': 'bP'}" .
chx:X_DeletePair rd:hasIOExample chx:IO_DeletePair .
chx:X_PopMethod a owl:NamedIndividual, chx:PopMethod ; rdfs:label "d.pop('e2', None)"@en ; skos:definition "The pop method removes a key and returns its value, returns the fallback when one is given and the key is absent, and raises KeyError when there is no fallback; popitem removes and returns the most recently inserted pair."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_PopMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.pop('e2'), d.pop('zz', 'absent'), d.popitem(), d))({'e2': 'wP', 'e4': 'bP', 'e7': 'bP'}) evaluates to ('wP', 'absent', ('e7', 'bP'), {'e4': 'bP'})"@en ; chx:input "(lambda d: (d.pop('e2'), d.pop('zz', 'absent'), d.popitem(), d))({'e2': 'wP', 'e4': 'bP', 'e7': 'bP'})" ; chx:output "('wP', 'absent', ('e7', 'bP'), {'e4': 'bP'})" .
chx:X_PopMethod rd:hasIOExample chx:IO_PopMethod .
chx:X_UpdateAndMerge a owl:NamedIndividual, chx:UpdateAndMerge ; rdfs:label "defaults | overrides"@en ; skos:definition "The update method copies the pairs of another mapping or of keyword arguments into a dictionary and returns None; since Python 3.9 the | operator gives a new merged dictionary and |= updates in place, and in both the right-hand values win."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_UpdateAndMerge a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, b: (a | b, a))({'x': 1, 'y': 2}, {'y': 20, 'z': 3}) evaluates to ({'x': 1, 'y': 20, 'z': 3}, {'x': 1, 'y': 2})"@en ; chx:input "(lambda a, b: (a | b, a))({'x': 1, 'y': 2}, {'y': 20, 'z': 3})" ; chx:output "({'x': 1, 'y': 20, 'z': 3}, {'x': 1, 'y': 2})" .
chx:X_UpdateAndMerge rd:hasIOExample chx:IO_UpdateAndMerge .
chx:X_FromkeysMethod a owl:NamedIndividual, chx:FromkeysMethod ; rdfs:label "dict.fromkeys('abc', 0)"@en ; skos:definition "The class method fromkeys builds a dictionary from an iterable of keys that all share one value, which is safe for a number and a trap for a list, since every key then holds the same list."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_FromkeysMethod a owl:NamedIndividual, rd:IOExample ; rdfs:label "dict.fromkeys('abc', 0) evaluates to {'a': 0, 'b': 0, 'c': 0}"@en ; chx:input "dict.fromkeys('abc', 0)" ; chx:output "{'a': 0, 'b': 0, 'c': 0}" .
chx:X_FromkeysMethod rd:hasIOExample chx:IO_FromkeysMethod .
chx:X_BirthdayLookup a owl:NamedIndividual, chx:BirthdayLookup ; rdfs:label "birthdays.py"@en ; skos:definition "The chapter's first program keeps names and birthdays in a dictionary, looks a name up with in, answers from the dictionary and asks for a birthday to add when the name is new, looping until a blank name."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_BirthdayLookup a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b, n: b[n] + ' is the birthday of ' + n if n in b else 'I do not have birthday information for ' + n)({'Alice': 'Apr 1', 'Bob': 'Dec 12', 'Carol': 'Mar 4'}, 'Alice') evaluates to 'Apr 1 is the birthday of Alice'"@en ; chx:input "(lambda b, n: b[n] + ' is the birthday of ' + n if n in b else 'I do not have birthday information for ' + n)({'Alice': 'Apr 1', 'Bob': 'Dec 12', 'Carol': 'Mar 4'}, 'Alice')" ; chx:output "'Apr 1 is the birthday of Alice'" .
chx:X_BirthdayLookup rd:hasIOExample chx:IO_BirthdayLookup .
chx:X_KeysValuesItems a owl:NamedIndividual, chx:KeysValuesItems ; rdfs:label "spam.items()"@en ; skos:definition "The methods keys, values and items return dict_keys, dict_values and dict_items views that can be looped over and tested with in but are not lists, cannot be changed and have no append; list() turns a view into a list, and the items are tuples of key and value."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_KeysValuesItems a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (list(d.keys()), list(d.values()), list(d.items()), type(d.keys()).__name__, hasattr(d.keys(), 'append')))({'color': 'red', 'age': 42}) evaluates to (['color', 'age'], ['red', 42], [('color', 'red'), ('age', 42)], 'dict_keys', False)"@en ; chx:input "(lambda d: (list(d.keys()), list(d.values()), list(d.items()), type(d.keys()).__name__, hasattr(d.keys(), 'append')))({'color': 'red', 'age': 42})" ; chx:output "(['color', 'age'], ['red', 42], [('color', 'red'), ('age', 42)], 'dict_keys', False)" .
chx:X_KeysValuesItems rd:hasIOExample chx:IO_KeysValuesItems .
chx:X_LiveAndSetLikeViews a owl:NamedIndividual, chx:LiveAndSetLikeViews ; rdfs:label "keys & {'eggs', 'salad'}"@en ; skos:definition "A view is a live window on its dictionary, so it shows later changes, and a keys view or an items view supports the set operators such as & and <= against any iterable."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_LiveAndSetLikeViews a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (lambda k: (d.__setitem__('b', 2), list(k), k & {'a', 'z'})[1:])(d.keys()))({'a': 1}) evaluates to (['a', 'b'], {'a'})"@en ; chx:input "(lambda d: (lambda k: (d.__setitem__('b', 2), list(k), k & {'a', 'z'})[1:])(d.keys()))({'a': 1})" ; chx:output "(['a', 'b'], {'a'})" .
chx:X_LiveAndSetLikeViews rd:hasIOExample chx:IO_LiveAndSetLikeViews .
chx:X_ItemsLoop a owl:NamedIndividual, chx:ItemsLoop ; rdfs:label "for k, v in spam.items():"@en ; skos:definition "A for loop over items() with two names takes the key and the value of every pair in turn, using the same multiple assignment as for a list of pairs."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ItemsLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "[k + '=' + str(v) for k, v in {'color': 'red', 'age': 42}.items()] evaluates to ['color=red', 'age=42']"@en ; chx:input "[k + '=' + str(v) for k, v in {'color': 'red', 'age': 42}.items()]" ; chx:output "['color=red', 'age=42']" .
chx:X_ItemsLoop rd:hasIOExample chx:IO_ItemsLoop .
chx:X_SortedAndReversedLoops a owl:NamedIndividual, chx:SortedAndReversedLoops ; rdfs:label "sorted(d)"@en ; skos:definition "A loop visits the keys in insertion order; sorted(d) gives the keys in sorted order, reversed(d) in reverse insertion order (since Python 3.8), and sorted(d.items(), key=...) orders pairs by a chosen part."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_SortedAndReversedLoops a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (sorted(d), list(reversed(d)), sorted(d.items(), key=lambda p: p[1])))({'b': 1, 'c': 3, 'a': 2}) evaluates to (['a', 'b', 'c'], ['a', 'c', 'b'], [('b', 1), ('a', 2), ('c', 3)])"@en ; chx:input "(lambda d: (sorted(d), list(reversed(d)), sorted(d.items(), key=lambda p: p[1])))({'b': 1, 'c': 3, 'a': 2})" ; chx:output "(['a', 'b', 'c'], ['a', 'c', 'b'], [('b', 1), ('a', 2), ('c', 3)])" .
chx:X_SortedAndReversedLoops rd:hasIOExample chx:IO_SortedAndReversedLoops .
chx:X_ChangeWhileLooping a owl:NamedIndividual, chx:ChangeWhileLooping ; rdfs:label "for k in d: d[k + 'x'] = 0"@en ; skos:definition "Adding or deleting keys while looping over a dictionary raises RuntimeError, because the size changed; looping over list(d) or building a new dictionary avoids it, while replacing the value of an existing key is allowed."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChangeWhileLooping a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: ([d.pop(k) for k in list(d) if d[k] < 2], d)[1])({'a': 1, 'b': 2, 'c': 0}) evaluates to {'b': 2}"@en ; chx:input "(lambda d: ([d.pop(k) for k in list(d) if d[k] < 2], d)[1])({'a': 1, 'b': 2, 'c': 0})" ; chx:output "{'b': 2}" .
chx:X_ChangeWhileLooping rd:hasIOExample chx:IO_ChangeWhileLooping .
chx:X_DictComprehension a owl:NamedIndividual, chx:DictComprehension ; rdfs:label "{x: x**2 for x in (2, 4, 6)}"@en ; skos:definition "A dictionary comprehension builds a dictionary from a key expression, a value expression, a for clause and optional if clauses, so inverting or filtering a dictionary needs no loop with assignments."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DictComprehension a owl:NamedIndividual, rd:IOExample ; rdfs:label "{x: x**2 for x in (2, 4, 6)} evaluates to {2: 4, 4: 16, 6: 36}"@en ; chx:input "{x: x**2 for x in (2, 4, 6)}" ; chx:output "{2: 4, 4: 16, 6: 36}" .
chx:X_DictComprehension rd:hasIOExample chx:IO_DictComprehension .
chx:X_CharacterCount a owl:NamedIndividual, chx:CharacterCount ; rdfs:label "count.setdefault(character, 0)"@en ; skos:definition "The chapter's characterCount program counts the characters of a string by making sure each has a key with setdefault and then adding one, so it works for a string of any length."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_CharacterCount a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda m, c: ([c.__setitem__(ch, c.setdefault(ch, 0) + 1) for ch in m], c)[1])('mississippi', {}) evaluates to {'m': 1, 'i': 4, 's': 4, 'p': 2}"@en ; chx:input "(lambda m, c: ([c.__setitem__(ch, c.setdefault(ch, 0) + 1) for ch in m], c)[1])('mississippi', {})" ; chx:output "{'m': 1, 'i': 4, 's': 4, 'p': 2}" .
chx:X_CharacterCount rd:hasIOExample chx:IO_CharacterCount .
chx:X_CounterClass a owl:NamedIndividual, chx:CounterClass ; rdfs:label "Counter('mississippi')"@en ; skos:definition "collections.Counter is a dictionary subclass that counts the items of an iterable in one call, answers 0 for a missing key instead of raising, and lists the commonest items with most_common."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_CounterClass a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda C: (C('mississippi').most_common(2), C('mississippi')['z']))(__import__('collections').Counter) evaluates to ([('i', 4), ('s', 4)], 0)"@en ; chx:input "(lambda C: (C('mississippi').most_common(2), C('mississippi')['z']))(__import__('collections').Counter)" ; chx:output "([('i', 4), ('s', 4)], 0)" .
chx:X_CounterClass rd:hasIOExample chx:IO_CounterClass .
chx:X_DefaultdictCounting a owl:NamedIndividual, chx:DefaultdictCounting ; rdfs:label "defaultdict(int)"@en ; skos:definition "A defaultdict is a dictionary with a factory that makes the value of a missing key, so defaultdict(int) starts every count at 0 and d[key] += 1 needs no setdefault."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_DefaultdictCounting a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda dd: ([dd.__setitem__(ch, dd[ch] + 1) for ch in 'mississippi'], dict(dd))[1])(__import__('collections').defaultdict(int)) evaluates to {'m': 1, 'i': 4, 's': 4, 'p': 2}"@en ; chx:input "(lambda dd: ([dd.__setitem__(ch, dd[ch] + 1) for ch in 'mississippi'], dict(dd))[1])(__import__('collections').defaultdict(int))" ; chx:output "{'m': 1, 'i': 4, 's': 4, 'p': 2}" .
chx:X_DefaultdictCounting rd:hasIOExample chx:IO_DefaultdictCounting .
chx:X_GroupingIntoLists a owl:NamedIndividual, chx:GroupingIntoLists ; rdfs:label "groups.setdefault(key, []).append(value)"@en ; skos:definition "Grouping values by key keeps a list per key, made either with setdefault(key, []) or with defaultdict(list), and the result holds every value under its key in the order met."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_GroupingIntoLists a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (lambda d: ([d.setdefault(k, []).append(v) for k, v in s], d)[1])({}))([('yellow', 1), ('blue', 2), ('yellow', 3)]) evaluates to {'yellow': [1, 3], 'blue': [2]}"@en ; chx:input "(lambda s: (lambda d: ([d.setdefault(k, []).append(v) for k, v in s], d)[1])({}))([('yellow', 1), ('blue', 2), ('yellow', 3)])" ; chx:output "{'yellow': [1, 3], 'blue': [2]}" .
chx:X_GroupingIntoLists rd:hasIOExample chx:IO_GroupingIntoLists .
chx:X_MissingKeyHook a owl:NamedIndividual, chx:MissingKeyHook ; rdfs:label "defaultdict(list)['x']"@en ; skos:definition "A defaultdict fills in a missing key only when it is subscripted, because that calls the method __missing__; get and in do not, so dd.get('y') is None and 'y' in dd is False while dd['x'] creates the key."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_MissingKeyHook a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda dd: (dd['x'], 'x' in dd, dd.get('y'), 'y' in dd))(__import__('collections').defaultdict(list)) evaluates to ([], True, None, False)"@en ; chx:input "(lambda dd: (dd['x'], 'x' in dd, dd.get('y'), 'y' in dd))(__import__('collections').defaultdict(list))" ; chx:output "([], True, None, False)" .
chx:X_MissingKeyHook rd:hasIOExample chx:IO_MissingKeyHook .
chx:X_OrderedDictType a owl:NamedIndividual, chx:OrderedDictType ; rdfs:label "OrderedDict(a=1, b=2)"@en ; skos:definition "collections.OrderedDict is a dictionary whose equality also compares the order of the keys and that can move a key to the end, which a plain dictionary since Python 3.7 cannot do in one call."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_OrderedDictType a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda O: (O([('a', 1), ('b', 2)]) == O([('b', 2), ('a', 1)]), {'a': 1, 'b': 2} == {'b': 2, 'a': 1}))(__import__('collections').OrderedDict) evaluates to (False, True)"@en ; chx:input "(lambda O: (O([('a', 1), ('b', 2)]) == O([('b', 2), ('a', 1)]), {'a': 1, 'b': 2} == {'b': 2, 'a': 1}))(__import__('collections').OrderedDict)" ; chx:output "(False, True)" .
chx:X_OrderedDictType rd:hasIOExample chx:IO_OrderedDictType .
chx:X_ChessboardModel a owl:NamedIndividual, chx:ChessboardModel ; rdfs:label "{'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'}"@en ; skos:definition "The chapter models a chessboard as a dictionary whose keys are square names such as 'e3' and whose values are two-character piece names such as 'wK'; an empty square is a missing key, and one key per square means one piece per square."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChessboardModel a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b: (len(b), b.get('d4', 'empty'), 'e3' in b))({'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'}) evaluates to (5, 'empty', True)"@en ; chx:input "(lambda b: (len(b), b.get('d4', 'empty'), 'e3' in b))({'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'})" ; chx:output "(5, 'empty', True)" .
chx:X_ChessboardModel rd:hasIOExample chx:IO_ChessboardModel .
chx:X_ChessboardPrinter a owl:NamedIndividual, chx:ChessboardPrinter ; rdfs:label "print_chessboard(board)"@en ; skos:definition "The function print_chessboard visits the 64 squares from a8 to h1 with two nested loops, collects a piece string or a white or black empty-square string for each, and prints the multiline template with format(*squares)."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChessboardPrinter a owl:NamedIndividual, rd:IOExample ; rdfs:label "[x + y for y in '87' for x in 'abc'] evaluates to ['a8', 'b8', 'c8', 'a7', 'b7', 'c7']"@en ; chx:input "[x + y for y in '87' for x in 'abc']" ; chx:output "['a8', 'b8', 'c8', 'a7', 'b7', 'c7']" .
chx:X_ChessboardPrinter rd:hasIOExample chx:IO_ChessboardPrinter .
chx:X_StarSyntax a owl:NamedIndividual, chx:StarSyntax ; rdfs:label "BOARD_TEMPLATE.format(*squares)"@en ; skos:definition "A star before a list in a call passes its items as separate arguments, so print(*spam) means print('cat', 'dog', 'rat'), and the template's 64 pairs of braces take the 64 strings of the list."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_StarSyntax a owl:NamedIndividual, rd:IOExample ; rdfs:label "'{}-{}-{}'.format(*['cat', 'dog', 'rat']) evaluates to 'cat-dog-rat'"@en ; chx:input "'{}-{}-{}'.format(*['cat', 'dog', 'rat'])" ; chx:output "'cat-dog-rat'" .
chx:X_StarSyntax rd:hasIOExample chx:IO_StarSyntax .
chx:X_ChessboardCommands a owl:NamedIndividual, chx:ChessboardCommands ; rdfs:label "response = input('> ').split()"@en ; skos:definition "The interactive simulator splits each typed line into a list and uses its first word to choose among move, remove, set, reset, clear, fill and quit, each of which is one or two dictionary operations; it checks nothing, so a command about an empty square raises KeyError."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChessboardCommands a owl:NamedIndividual, rd:IOExample ; rdfs:label "'move e2 e4'.split() evaluates to ['move', 'e2', 'e4']"@en ; chx:input "'move e2 e4'.split()" ; chx:output "['move', 'e2', 'e4']" .
chx:X_ChessboardCommands rd:hasIOExample chx:IO_ChessboardCommands .
chx:X_NestedDictionaries a owl:NamedIndividual, chx:NestedDictionaries ; rdfs:label "all_guests['Alice']['apples']"@en ; skos:definition "A dictionary value can itself be a dictionary or a list, so a dictionary of dictionaries models a picnic in which each guest has their own items, and two subscripts reach an inner value."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_NestedDictionaries a owl:NamedIndividual, rd:IOExample ; rdfs:label "{'Alice': {'apples': 5, 'pretzels': 12}}['Alice']['apples'] evaluates to 5"@en ; chx:input "{'Alice': {'apples': 5, 'pretzels': 12}}['Alice']['apples']" ; chx:output "5" .
chx:X_NestedDictionaries rd:hasIOExample chx:IO_NestedDictionaries .
chx:X_TotalBrought a owl:NamedIndividual, chx:TotalBrought ; rdfs:label "v.get(item, 0)"@en ; skos:definition "The function total_brought loops over the guests' inner dictionaries and adds the quantity of an item with get(item, 0), so a guest who brings none of it adds nothing and no KeyError arises."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_TotalBrought a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: sum(v.get('apples', 0) for v in g.values()))({'Alice': {'apples': 5, 'pretzels': 12}, 'Bob': {'ham sandwiches': 3, 'apples': 2}, 'Carol': {'cups': 3, 'apple pies': 1}}) evaluates to 7"@en ; chx:input "(lambda g: sum(v.get('apples', 0) for v in g.values()))({'Alice': {'apples': 5, 'pretzels': 12}, 'Bob': {'ham sandwiches': 3, 'apples': 2}, 'Carol': {'cups': 3, 'apple pies': 1}})" ; chx:output "7" .
chx:X_TotalBrought rd:hasIOExample chx:IO_TotalBrought .
chx:X_CopyingDictionaries a owl:NamedIndividual, chx:CopyingDictionaries ; rdfs:label "copy.copy(STARTING_PIECES)"@en ; skos:definition "copy.copy, d.copy() and dict(d) make a shallow copy: a flat dictionary such as the starting position is then independent of its copy, but a nested one still shares its inner dictionaries, for which copy.deepcopy is needed."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_CopyingDictionaries a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda c, d: (lambda s, dp: (d['a'].__setitem__('x', 9), s['a']['x'], dp['a']['x'])[1:])(d.copy(), c.deepcopy(d)))(__import__('copy'), {'a': {'x': 1}}) evaluates to (9, 1)"@en ; chx:input "(lambda c, d: (lambda s, dp: (d['a'].__setitem__('x', 9), s['a']['x'], dp['a']['x'])[1:])(d.copy(), c.deepcopy(d)))(__import__('copy'), {'a': {'x': 1}})" ; chx:output "(9, 1)" .
chx:X_CopyingDictionaries rd:hasIOExample chx:IO_CopyingDictionaries .
chx:X_PrettyPrinting a owl:NamedIndividual, chx:PrettyPrinting ; rdfs:label "pprint.pprint(data)"@en ; skos:definition "The pprint module prints a nested structure over several lines when it is too wide; pprint.pprint sorts the keys of a dictionary by default and pprint.pp keeps their insertion order, and pformat returns the text instead of printing it."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_PrettyPrinting a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('pprint').pformat({2: 0, 1: 0}), __import__('pprint').pformat({2: 0, 1: 0}, sort_dicts=False)) evaluates to ('{1: 0, 2: 0}', '{2: 0, 1: 0}')"@en ; chx:input "(__import__('pprint').pformat({2: 0, 1: 0}), __import__('pprint').pformat({2: 0, 1: 0}, sort_dicts=False))" ; chx:output "('{1: 0, 2: 0}', '{2: 0, 1: 0}')" .
chx:X_PrettyPrinting rd:hasIOExample chx:IO_PrettyPrinting .
chx:X_TypedModels a owl:NamedIndividual, chx:TypedModels ; rdfs:label "class Piece(TypedDict):"@en ; skos:definition "A TypedDict names the keys a dictionary should have and their types for a type checker, but at run time it is an ordinary dict; a dataclass or a named tuple is the alternative when the record should be an object with attributes."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_TypedModels a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda P: (P(color='w', kind='K'), type(P(color='w', kind='K')).__name__))(__import__('typing').TypedDict('P', {'color': str, 'kind': str})) evaluates to ({'color': 'w', 'kind': 'K'}, 'dict')"@en ; chx:input "(lambda P: (P(color='w', kind='K'), type(P(color='w', kind='K')).__name__))(__import__('typing').TypedDict('P', {'color': str, 'kind': str}))" ; chx:output "({'color': 'w', 'kind': 'K'}, 'dict')" .
chx:X_TypedModels rd:hasIOExample chx:IO_TypedModels .
chx:X_MappingPattern a owl:NamedIndividual, chx:MappingPattern ; rdfs:label "case {'op': 'move', 'to': t}:"@en ; skos:definition "A match statement can test the keys of a dictionary with a mapping pattern, which succeeds when the listed keys are present, binds names to their values, ignores extra keys and can collect them with **rest."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_MappingPattern a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ns: (exec(chr(10).join(['def f(v):', '    match v:', '        case {1: a, **rest}:', '            return a, sorted(rest)', '        case _:', '            return None']), ns), ns['f']({1: 'e2', 2: 'e4', 3: 0}), ns['f']([1]))[1:])({}) evaluates to (('e2', [2, 3]), None)"@en ; chx:input "(lambda ns: (exec(chr(10).join(['def f(v):', '    match v:', '        case {1: a, **rest}:', '            return a, sorted(rest)', '        case _:', '            return None']), ns), ns['f']({1: 'e2', 2: 'e4', 3: 0}), ns['f']([1]))[1:])({})" ; chx:output "(('e2', [2, 3]), None)" .
chx:X_MappingPattern rd:hasIOExample chx:IO_MappingPattern .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "spam = {'bar': 100}; spam['foo']"@en ; skos:definition "The eight practice questions ask for an empty dictionary, a one-pair dictionary, the difference between a dictionary and a list, the KeyError of a missing key, in against keys() and values(), the setdefault shortcut and pprint for printing a dictionary."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_PracticeQuestions a owl:NamedIndividual, rd:IOExample ; rdfs:label "({}, {'foo': 42}, 'cat' in {'cat': 1}.values()) evaluates to ({}, {'foo': 42}, False)"@en ; chx:input "({}, {'foo': 42}, 'cat' in {'cat': 1}.values())" ; chx:output "({}, {'foo': 42}, False)" .
chx:X_PracticeQuestions rd:hasIOExample chx:IO_PracticeQuestions .
chx:X_ChessValidator a owl:NamedIndividual, chx:ChessValidator ; rdfs:label "isValidChessBoard(board)"@en ; skos:definition "The first practice program asks for a function that tells whether a chessboard dictionary is valid: exactly one king of each colour, at most 16 pieces and 8 pawns each, and every piece on a real square; the chapter's wording of the square and piece names differs from its own notation."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_ChessValidator a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b: (sum(v == 'bK' for v in b.values()), sum(v == 'wK' for v in b.values())))({'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'}) evaluates to (1, 1)"@en ; chx:input "(lambda b: (sum(v == 'bK' for v in b.values()), sum(v == 'wK' for v in b.values())))({'h1': 'bK', 'c6': 'wQ', 'g2': 'bB', 'h5': 'bQ', 'e3': 'wK'})" ; chx:output "(1, 1)" .
chx:X_ChessValidator rd:hasIOExample chx:IO_ChessValidator .
chx:X_FantasyInventory a owl:NamedIndividual, chx:FantasyInventory ; rdfs:label "display_inventory(stuff)"@en ; skos:definition "The second practice program models a game inventory as a dictionary from item name to count and prints each pair followed by the total number of items, summing the values while looping over items()."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_FantasyInventory a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum({'rope': 1, 'torch': 6, 'gold coin': 42, 'dagger': 1, 'arrow': 12}.values()) evaluates to 62"@en ; chx:input "sum({'rope': 1, 'torch': 6, 'gold coin': 42, 'dagger': 1, 'arrow': 12}.values())" ; chx:output "62" .
chx:X_FantasyInventory rd:hasIOExample chx:IO_FantasyInventory .
chx:X_LootConversion a owl:NamedIndividual, chx:LootConversion ; rdfs:label "add_to_inventory(inventory, added_items)"@en ; skos:definition "The third practice program turns a list that may repeat items into counts in a dictionary, adding one to the current count of each item, which get(item, 0) makes safe for a new item."@en ; dcterms:source <http://example.org/sen0414/ch07/research> .
chx:IO_LootConversion a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda inv, loot: [inv.__setitem__(i, inv.get(i, 0) + 1) for i in loot] and inv)({'gold coin': 42, 'rope': 1}, ['gold coin', 'dagger', 'gold coin', 'gold coin', 'ruby']) evaluates to {'gold coin': 45, 'rope': 1, 'dagger': 1, 'ruby': 1}"@en ; chx:input "(lambda inv, loot: [inv.__setitem__(i, inv.get(i, 0) + 1) for i in loot] and inv)({'gold coin': 42, 'rope': 1}, ['gold coin', 'dagger', 'gold coin', 'gold coin', 'ruby'])" ; chx:output "{'gold coin': 45, 'rope': 1, 'dagger': 1, 'ruby': 1}" .
chx:X_LootConversion rd:hasIOExample chx:IO_LootConversion .
