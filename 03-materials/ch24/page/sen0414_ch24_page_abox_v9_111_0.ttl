pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Chapter 24 interactive page"@en ;
    skos:definition "The interactive page sen0414_ch24_page_v9_111_0.html teaches chapter 24 of the book, Text-to-speech and speech recognition engines for an advanced course: chapter 24 and today's pyttsx3, Whisper, yt-dlp and the speech engines of Windows, macOS and Linux, through 104 sections and 104 widgets that run or draw the chapter's examples."@en ; dcterms:source <http://example.org/sen0414/ch24/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4, pg:CO5 ;
    sen0414:navigationRule "One top menu of 9 items, with one row of tabs under the item that is open, a chapter explorer tree on the left and a detail card on the right that opens only when a reader asks for it." ;
    sen0414:pageFile "03-materials/ch24/page/sen0414_ch24_page_v9_111_0.html" ;
    sen0414:pythonUsed "Python 3.14.6" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Explorer, main area and detail card"@en ;
    skos:definition "The layout puts the chapter explorer tree on the left, the main area with the open tab in the middle and the detail card on the right, which opens only on request."@en ; dcterms:source "03-materials/ch24/page/sen0414_ch24_page_v9_111_0.html" .
pg:Header a ipo:Header ; rdfs:label "Header with the chapter title and the main menu"@en ;
    skos:definition "The header holds the chapter title, the buttons to go back and forward, the search, the progress badge, the text-size control and the main menu with 9 items."@en ; dcterms:source "03-materials/ch24/page/sen0414_ch24_page_v9_111_0.html" .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Chapter explorer tree"@en ;
    skos:definition "The sidebar is the chapter explorer, a tree of the 104 sections of the chapter whose choice opens the matching tab."@en ; dcterms:source "03-materials/ch24/page/sen0414_ch24_page_v9_111_0.html" .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en ;
    skos:definition "The main area shows the open tab of the open menu item, with the widgets of the chapter's concepts placed in the text they explain."@en ; dcterms:source "03-materials/ch24/page/sen0414_ch24_page_v9_111_0.html" .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Main menu"@en ;
    skos:definition "The main menu is the permanent top bar with the items Start, Learn, Run examples in order, Maps, Lab, Agents, Practice, Reference, About, and a click on an item changes the main area first."@en ; dcterms:source "03-materials/ch24/page/sen0414_ch24_page_v9_111_0.html" .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Chapter explorer tree of sections"@en ;
    skos:definition "The explorer tree lists the 6 subjects of the chapter with their groups and concepts, and it stays in step with the tab row."@en ; dcterms:source "03-materials/ch24/page/sen0414_ch24_page_v9_111_0.html" .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 24 Stage 3 document"@en ;
    skos:definition "The source document is the Stage 3 document of chapter 24, which has one section for each of the 104 concepts of the chapter."@en ; dcterms:source <http://example.org/sen0414/ch24/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4, pg:CO5 .
