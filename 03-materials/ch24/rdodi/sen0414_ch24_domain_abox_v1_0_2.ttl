chx:X_VolumeScale a owl:NamedIndividual, chx:VolumeScale ; rdfs:label "engine.setProperty('volume', 0.5)"@en ; skos:definition "The peak sample of the fox sentence was 26394 at volume 1.0, 13024 at 0.5, 2222 at 0.1 and 0 at 0.0, so the volume scales the samples of the WAV file (49 percent at 0.5)."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_VolumeScale a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\np = [say(T, \\'v%s.wav\\' % v, volume=v)[5] for v in (1.0, 0.5, 0.1, 0.0)]\\nout = (p[0], p[1], p[2], p[3], round(100 * p[1] / p[0]))\\n', g), g['out'])[1])({}) evaluates to (26394, 13024, 2222, 0, 49)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\np = [say(T, \\'v%s.wav\\' % v, volume=v)[5] for v in (1.0, 0.5, 0.1, 0.0)]\\nout = (p[0], p[1], p[2], p[3], round(100 * p[1] / p[0]))\\n', g), g['out'])[1])({})" ; chx:output "(26394, 13024, 2222, 0, 49)" .
chx:X_VolumeScale rd:hasIOExample chx:IO_VolumeScale .
chx:X_OutOfRangeValues a owl:NamedIndividual, chx:OutOfRangeValues ; rdfs:label "engine.setProperty('volume', 5)"@en ; skos:definition "A volume of 5 gave a peak of 32768 (the 16-bit range ends at 32767, so the samples were clipped), against 26394 at 1.0, and a volume of -1 gave 26393, about the same as 1.0; a rate of 'fast' left the length at 2.7 s, as at the default rate: setProperty accepts values it cannot use."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_OutOfRangeValues a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nout = (say(T, \\'v5.wav\\', volume=5)[5], say(T, \\'v1.wav\\', volume=1.0)[5], say(T, \\'vm.wav\\', volume=-1)[5], say(T, \\'rf.wav\\', rate=\\'fast\\')[4])\\n', g), g['out'])[1])({}) evaluates to (32768, 26394, 26393, 2.7)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nout = (say(T, \\'v5.wav\\', volume=5)[5], say(T, \\'v1.wav\\', volume=1.0)[5], say(T, \\'vm.wav\\', volume=-1)[5], say(T, \\'rf.wav\\', rate=\\'fast\\')[4])\\n', g), g['out'])[1])({})" ; chx:output "(32768, 26394, 26393, 2.7)" .
chx:X_OutOfRangeValues rd:hasIOExample chx:IO_OutOfRangeValues .
chx:X_WavFormat a owl:NamedIndividual, chx:WavFormat ; rdfs:label "engine.save_to_file('Hello. How are you doing?', 'hello.wav')"@en ; skos:definition "The file that save_to_file wrote for the chapter's sentence has 1 channel, 2 bytes per sample, 22050 Hz and 33948 frames, which is 1.54 s and 67940 bytes on disk, with a peak sample of 25045; it is written with the wave module of the standard library, and the engine, not the file, sets the format."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_WavFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nw = say(\\'Hello. How are you doing?\\', \\'h.wav\\'); out = w + (os.path.getsize(\\'h.wav\\'),)\\n', g), g['out'])[1])({}) evaluates to (1, 2, 22050, 33948, 1.54, 25045, 67940)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nw = say(\\'Hello. How are you doing?\\', \\'h.wav\\'); out = w + (os.path.getsize(\\'h.wav\\'),)\\n', g), g['out'])[1])({})" ; chx:output "(1, 2, 22050, 33948, 1.54, 25045, 67940)" .
chx:X_WavFormat rd:hasIOExample chx:IO_WavFormat .
chx:X_ExtensionIgnored a owl:NamedIndividual, chx:ExtensionIgnored ; rdfs:label "engine.save_to_file('Hello.', 'hello.mp3')"@en ; skos:definition "With pyttsx3 2.99 a file named hello.mp3 begins with b'RIFF' and b'WAVE' and ffprobe calls its format wav; hello.aiff is the same ((b'RIFF', b'WAVE')): the eSpeak driver writes a WAV whatever the extension says. With the pinned 2.98 the driver calls ffmpeg, and a.mp3 was a real mp3 file and a.ogg a real ogg file, while without ffmpeg no file was written (False); the chapter's statement that only .wav files can be saved holds for 2.99 only."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_ExtensionIgnored a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ncode = \\x22import pyttsx3\\\\ne = pyttsx3.init()\\\\ne.save_to_file(\\'Hello.\\', \\'h.mp3\\')\\\\ne.runAndWait()\\\\ne.save_to_file(\\'Hello.\\', \\'h.aiff\\')\\\\ne.runAndWait()\\x22\\npy(code); stable(\\'h.mp3\\'); stable(\\'h.aiff\\')\\nb = open(\\'h.mp3\\', \\'rb\\').read(12); c = open(\\'h.aiff\\', \\'rb\\').read(12)\\nfmt = lambda p: subprocess.run([\\'ffprobe\\', \\'-v\\', \\'error\\', \\'-show_entries\\', \\'format=format_name\\', \\'-of\\', \\'csv=p=0\\', p], capture_output=True, text=True).stdout.strip()\\nf = fmt(\\'h.mp3\\')\\ncode2 = \\x22import pyttsx3\\\\ne = pyttsx3.init()\\\\ne.save_to_file(\\'The quick brown fox jumps over the yellow lazy dog.\\', %r)\\\\ne.runAndWait()\\x22\\npy(code2 % \\'p.mp3\\', PINS); stable(\\'p.mp3\\', limit=8); py(code2 % \\'p.ogg\\', PINS); stable(\\'p.ogg\\', limit=8)\\nenv = dict(os.environ, PATH=os.path.dirname(PINS)); py(code2 % \\'q.wav\\', PINS, env=env); time.sleep(3)\\nout = (b[:4], b[8:12], f, (c[:4], c[8:12]), fmt(\\'p.mp3\\'), fmt(\\'p.ogg\\'), os.path.exists(\\'q.wav\\'))\\n', g), g['out'])[1])({}) evaluates to (b'RIFF', b'WAVE', 'wav', (b'RIFF', b'WAVE'), 'mp3', 'ogg', False)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ncode = \\x22import pyttsx3\\\\ne = pyttsx3.init()\\\\ne.save_to_file(\\'Hello.\\', \\'h.mp3\\')\\\\ne.runAndWait()\\\\ne.save_to_file(\\'Hello.\\', \\'h.aiff\\')\\\\ne.runAndWait()\\x22\\npy(code); stable(\\'h.mp3\\'); stable(\\'h.aiff\\')\\nb = open(\\'h.mp3\\', \\'rb\\').read(12); c = open(\\'h.aiff\\', \\'rb\\').read(12)\\nfmt = lambda p: subprocess.run([\\'ffprobe\\', \\'-v\\', \\'error\\', \\'-show_entries\\', \\'format=format_name\\', \\'-of\\', \\'csv=p=0\\', p], capture_output=True, text=True).stdout.strip()\\nf = fmt(\\'h.mp3\\')\\ncode2 = \\x22import pyttsx3\\\\ne = pyttsx3.init()\\\\ne.save_to_file(\\'The quick brown fox jumps over the yellow lazy dog.\\', %r)\\\\ne.runAndWait()\\x22\\npy(code2 % \\'p.mp3\\', PINS); stable(\\'p.mp3\\', limit=8); py(code2 % \\'p.ogg\\', PINS); stable(\\'p.ogg\\', limit=8)\\nenv = dict(os.environ, PATH=os.path.dirname(PINS)); py(code2 % \\'q.wav\\', PINS, env=env); time.sleep(3)\\nout = (b[:4], b[8:12], f, (c[:4], c[8:12]), fmt(\\'p.mp3\\'), fmt(\\'p.ogg\\'), os.path.exists(\\'q.wav\\'))\\n', g), g['out'])[1])({})" ; chx:output "(b'RIFF', b'WAVE', 'wav', (b'RIFF', b'WAVE'), 'mp3', 'ogg', False)" .
chx:X_ExtensionIgnored rd:hasIOExample chx:IO_ExtensionIgnored .
chx:X_FirstCallRace a owl:NamedIndividual, chx:FirstCallRace ; rdfs:label "engine.runAndWait()  # then open hello.wav"@en ; skos:definition "In five fresh processes each, a 33-word text was not yet complete when the first runAndWait() returned in at least one process (True), and a 5-word text was complete in all five (True): the file can still be written after the call that is meant to wait for it, so a program must wait for the file before it opens it."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_FirstCallRace a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nRACE = \\x22import pyttsx3, os, sys, time\\\\nf = \\'race.wav\\'\\\\ne = pyttsx3.init(); e.save_to_file(sys.argv[1], f); e.runAndWait(); a = os.path.getsize(f) if os.path.exists(f) else 0; time.sleep(2.5); b = os.path.getsize(f) if os.path.exists(f) else 0; print(a, b)\\x22\\ndef trial(text, n):\\n    bad = 0\\n    for _ in range(n):\\n        if os.path.exists(\\'race.wav\\'): os.remove(\\'race.wav\\')\\n        a, b = (int(x) for x in subprocess.run([LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', RACE, text], capture_output=True, text=True, timeout=60).stdout.split()[-2:])\\n        bad += (a != b)\\n    return bad\\nlong_bad = trial(\\' \\'.join([\\'Alice was beginning to get very tired of sitting by her sister on the bank\\'] * 3), 5); short_bad = trial(H, 5)\\nout = (long_bad > 0, short_bad == 0)\\n', g), g['out'])[1])({}) evaluates to (True, True)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nRACE = \\x22import pyttsx3, os, sys, time\\\\nf = \\'race.wav\\'\\\\ne = pyttsx3.init(); e.save_to_file(sys.argv[1], f); e.runAndWait(); a = os.path.getsize(f) if os.path.exists(f) else 0; time.sleep(2.5); b = os.path.getsize(f) if os.path.exists(f) else 0; print(a, b)\\x22\\ndef trial(text, n):\\n    bad = 0\\n    for _ in range(n):\\n        if os.path.exists(\\'race.wav\\'): os.remove(\\'race.wav\\')\\n        a, b = (int(x) for x in subprocess.run([LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', RACE, text], capture_output=True, text=True, timeout=60).stdout.split()[-2:])\\n        bad += (a != b)\\n    return bad\\nlong_bad = trial(\\' \\'.join([\\'Alice was beginning to get very tired of sitting by her sister on the bank\\'] * 3), 5); short_bad = trial(H, 5)\\nout = (long_bad > 0, short_bad == 0)\\n', g), g['out'])[1])({})" ; chx:output "(True, True)" .
