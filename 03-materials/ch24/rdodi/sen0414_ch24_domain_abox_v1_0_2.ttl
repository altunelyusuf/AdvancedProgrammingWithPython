chx:X_HumanReadings a owl:NamedIndividual, chx:HumanReadings ; rdfs:label "model.transcribe('gettysburg.mp3')"@en ; skos:definition "On four LibriVox readings of the Gettysburg Address (public domain, 100 to 161 s) the word error rate against the Wikipedia copy of the Bliss text lay between 0.1636 and 0.3123 for tiny, between 0.1524 and 0.2565 for base and between 0.0186 and 0.2416 for small; part of it is the readers' own wording and the spoken LibriVox announcement, so the figures only compare the models."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_HumanReadings a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nr = J(\\'model_runtimes\\')[\\'results\\']\\nout = tuple([min(x[\\'WER\\'] for x in r[m][\\'four human readings of the Gettysburg Address\\']), max(x[\\'WER\\'] for x in r[m][\\'four human readings of the Gettysburg Address\\'])] for m in (\\'tiny\\', \\'base\\', \\'small\\'))\\n', g), g['out'])[1])({}) evaluates to ([0.1636, 0.3123], [0.1524, 0.2565], [0.0186, 0.2416])"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nr = J(\\'model_runtimes\\')[\\'results\\']\\nout = tuple([min(x[\\'WER\\'] for x in r[m][\\'four human readings of the Gettysburg Address\\']), max(x[\\'WER\\'] for x in r[m][\\'four human readings of the Gettysburg Address\\'])] for m in (\\'tiny\\', \\'base\\', \\'small\\'))\\n', g), g['out'])[1])({})" ; chx:output "([0.1636, 0.3123], [0.1524, 0.2565], [0.0186, 0.2416])" .
chx:X_HumanReadings rd:hasIOExample chx:IO_HumanReadings .
chx:X_SilenceHallucination a owl:NamedIndividual, chx:SilenceHallucination ; rdfs:label "model.transcribe('silence.wav')"@en ; skos:definition "Ten seconds of digital silence were transcribed by tiny as  You in 1 segment, and ten seconds of seeded noise as  in 0 segments: Whisper can write words where nobody spoke, so a transcript is not proof of speech."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_SilenceHallucination a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nimport random\\ndef mk(path, f):\\n    w = wave.open(path, \\'wb\\'); w.setnchannels(1); w.setsampwidth(2); w.setframerate(16000); w.writeframes(array.array(\\'h\\', [f() for _ in range(160000)]).tobytes()); w.close()\\nrandom.seed(1); mk(\\'s.wav\\', lambda: 0); mk(\\'n.wav\\', lambda: random.randint(-3000, 3000))\\ncode = \\x22import whisper\\\\nm = whisper.load_model(\\'tiny\\')\\\\nfor f in (\\'s.wav\\', \\'n.wav\\'):\\\\n    r = m.transcribe(f, language=\\'en\\'); print(repr(r[\\'text\\']), len(r[\\'segments\\']))\\x22\\na, b = py(code)[1].split(\\'\\\\n\\')\\nout = (eval(a.rsplit(\\' \\', 1)[0]), int(a.rsplit(\\' \\', 1)[1]), eval(b.rsplit(\\' \\', 1)[0]), int(b.rsplit(\\' \\', 1)[1]))\\n', g), g['out'])[1])({}) evaluates to (' You', 1, '', 0)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nimport random\\ndef mk(path, f):\\n    w = wave.open(path, \\'wb\\'); w.setnchannels(1); w.setsampwidth(2); w.setframerate(16000); w.writeframes(array.array(\\'h\\', [f() for _ in range(160000)]).tobytes()); w.close()\\nrandom.seed(1); mk(\\'s.wav\\', lambda: 0); mk(\\'n.wav\\', lambda: random.randint(-3000, 3000))\\ncode = \\x22import whisper\\\\nm = whisper.load_model(\\'tiny\\')\\\\nfor f in (\\'s.wav\\', \\'n.wav\\'):\\\\n    r = m.transcribe(f, language=\\'en\\'); print(repr(r[\\'text\\']), len(r[\\'segments\\']))\\x22\\na, b = py(code)[1].split(\\'\\\\n\\')\\nout = (eval(a.rsplit(\\' \\', 1)[0]), int(a.rsplit(\\' \\', 1)[1]), eval(b.rsplit(\\' \\', 1)[0]), int(b.rsplit(\\' \\', 1)[1]))\\n', g), g['out'])[1])({})" ; chx:output "(' You', 1, '', 0)" .
