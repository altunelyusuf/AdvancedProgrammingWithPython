chx:X_LanguagesAndDetection a owl:NamedIndividual, chx:LanguagesAndDetection ; rdfs:label "model.transcribe('hello.wav', language='Turkish')"@en ; skos:definition "Whisper knows 100 languages and raised ValueError for 'Klingon'; given eSpeak NG speech in six languages, tiny named the language right 3 times out of 6 and base 4 times, hearing the Turkish sentence as Thai both times, so the language should be given when it is known."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_LanguagesAndDetection a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nt = J(\\'corpus_run\\')[\\'programs\\'][\\'languagesAndDetection_v1_0_0.py\\'][\\'stdout\\'].splitlines()\\nexp = {\\'tr\\': \\'tr\\', \\'de\\': \\'de\\', \\'fr\\': \\'fr\\', \\'es\\': \\'es\\', \\'cmn\\': \\'zh\\', \\'en-us\\': \\'en\\'}\\ndef score(m):\\n    n = 0\\n    for l in t:\\n        p = l.split()\\n        if p and p[0] == m and \\' -> language \\' in l:\\n            n += l.split(\\' -> language \\')[1].split(\\',\\')[0].split()[0] == exp[p[1]]\\n    return n\\ncode = \\x22import whisper.tokenizer as t\\\\nprint(len(t.LANGUAGES))\\\\ntry:\\\\n    t.get_tokenizer(True, language=\\'Klingon\\')\\\\nexcept BaseException as e:\\\\n    print(type(e).__name__ + \\': \\' + str(e))\\x22\\na, b = py(code)[1].split(\\'\\\\n\\')\\nout = (score(\\'tiny\\'), score(\\'base\\'), 6, int(a), b.split(\\':\\')[0])\\n', g), g['out'])[1])({}) evaluates to (3, 4, 6, 100, 'ValueError')"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nt = J(\\'corpus_run\\')[\\'programs\\'][\\'languagesAndDetection_v1_0_0.py\\'][\\'stdout\\'].splitlines()\\nexp = {\\'tr\\': \\'tr\\', \\'de\\': \\'de\\', \\'fr\\': \\'fr\\', \\'es\\': \\'es\\', \\'cmn\\': \\'zh\\', \\'en-us\\': \\'en\\'}\\ndef score(m):\\n    n = 0\\n    for l in t:\\n        p = l.split()\\n        if p and p[0] == m and \\' -> language \\' in l:\\n            n += l.split(\\' -> language \\')[1].split(\\',\\')[0].split()[0] == exp[p[1]]\\n    return n\\ncode = \\x22import whisper.tokenizer as t\\\\nprint(len(t.LANGUAGES))\\\\ntry:\\\\n    t.get_tokenizer(True, language=\\'Klingon\\')\\\\nexcept BaseException as e:\\\\n    print(type(e).__name__ + \\': \\' + str(e))\\x22\\na, b = py(code)[1].split(\\'\\\\n\\')\\nout = (score(\\'tiny\\'), score(\\'base\\'), 6, int(a), b.split(\\':\\')[0])\\n', g), g['out'])[1])({})" ; chx:output "(3, 4, 6, 100, 'ValueError')" .
chx:X_LanguagesAndDetection rd:hasIOExample chx:IO_LanguagesAndDetection .
chx:X_SrtListing a owl:NamedIndividual, chx:SrtListing ; rdfs:label "get_writer('srt', '.')(result, 'audio')"@en ; skos:definition "Whisper's SRT writer wrote 223 bytes for the two segments the book prints, as blocks of a number, a time range with a comma before the milliseconds and the text, starting ['1', '00:00:00,000 --> 00:00:05,640']; the file equals the chapter's listing 7 (True), also under the pinned release (True)."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_SrtListing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\nBOOKRES = {\\'text\\': \\' Dinosaurs are a diverse group of reptiles of the clade dinosauria. They first appeared during the triassic period. Between 245 and 233.23 million years ago.\\', \\'language\\': \\'en\\', \\'segments\\': [{\\'id\\': 0, \\'start\\': 0.0, \\'end\\': 5.64, \\'text\\': \\' Dinosaurs are a diverse group of reptiles of the clade dinosauria. They first\\'}, {\\'id\\': 1, \\'start\\': 5.64, \\'end\\': 14.96, \\'text\\': \\' appeared during the triassic period. Between 245 and 233.23 million years ago.\\'}]}\\nfrom whisper.utils import get_writer, format_timestamp\\ndef write(fmt, base=\\'audio\\', folder=\\'.\\'):\\n    get_writer(fmt, folder)(BOOKRES, base); return open(os.path.join(folder, base + \\'.\\' + fmt), encoding=\\'utf-8\\').read()\\ntp = J(\\'third_party_record\\')[\\'items\\'][2][\\'output\\'][\\'results\\'][6][\\'statements\\'][0][\\'as printed\\']\\n\\nt = write(\\'srt\\'); tpp = J(\\'third_party_record\\')[\\'items\\'][3][\\'output\\'][\\'results\\'][6][\\'statements\\'][0][\\'as printed\\']\\nout = (len(t.encode()), t.split(\\'\\\\n\\')[:2], tp[\\'matches the book\\'], tpp[\\'matches the book\\'])\\n', g), g['out'])[1])({}) evaluates to (223, ['1', '00:00:00,000 --> 00:00:05,640'], True, True)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24