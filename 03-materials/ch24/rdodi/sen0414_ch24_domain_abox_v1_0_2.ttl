chx:X_EspeakDependency a owl:NamedIndividual, chx:EspeakDependency ; rdfs:label "sudo apt install espeak"@en ; skos:definition "On Ubuntu 24.04 pyttsx3 2.99 started with no eSpeak package gave RuntimeError: This means you probably do not have eSpeak or eSpeak-ng installed!; with only the package the chapter names (espeak 1.48.15) it gave ValueError: SetVoiceByName failed with unknown return code -1 for voice: gmw/en; with only espeak-ng it started and listed 131 voices (ok); with both it started (ok)."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_EspeakDependency a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nit = [i for i in J(\\'live_observations\\')[\\'items\\'] if i[\\'what\\'].startswith(\\'the engine experiment\\')][0][\\'saw\\']\\npk = it[\\'packages after the experiment\\']\\nout = (it[\\'none (espeak and espeak-ng removed)\\'][\\'init\\'], it[\\'espeak only, as the chapter says (sudo apt install espeak)\\'][\\'init\\'], it[\\'espeak-ng only\\'][\\'init\\'], it[\\'espeak-ng only\\'][\\'voices\\'], pk[0].split()[1].split(\\'+\\')[0], md.version(\\'pyttsx3\\'), it[\\'restored state: both\\'][\\'init\\'])\\n', g), g['out'])[1])({}) evaluates to ('RuntimeError: This means you probably do not have eSpeak or eSpeak-ng installed!', 'ValueError: SetVoiceByName failed with unknown return code -1 for voice: gmw/en', 'ok', 131, '1.48.15', '2.99', 'ok')"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nit = [i for i in J(\\'live_observations\\')[\\'items\\'] if i[\\'what\\'].startswith(\\'the engine experiment\\')][0][\\'saw\\']\\npk = it[\\'packages after the experiment\\']\\nout = (it[\\'none (espeak and espeak-ng removed)\\'][\\'init\\'], it[\\'espeak only, as the chapter says (sudo apt install espeak)\\'][\\'init\\'], it[\\'espeak-ng only\\'][\\'init\\'], it[\\'espeak-ng only\\'][\\'voices\\'], pk[0].split()[1].split(\\'+\\')[0], md.version(\\'pyttsx3\\'), it[\\'restored state: both\\'][\\'init\\'])\\n', g), g['out'])[1])({})" ; chx:output "('RuntimeError: This means you probably do not have eSpeak or eSpeak-ng installed!', 'ValueError: SetVoiceByName failed with unknown return code -1 for voice: gmw/en', 'ok', 131, '1.48.15', '2.99', 'ok')" .
