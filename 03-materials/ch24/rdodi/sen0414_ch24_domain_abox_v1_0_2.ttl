chx:X_SetPropertyQueued a owl:NamedIndividual, chx:SetPropertyQueued ; rdfs:label "engine.setProperty('rate', 300)"@en ; skos:definition "In a fresh process the rate is 200, still 200 right after setProperty('rate', 300), and 300 after a runAndWait() that had an utterance to say: setProperty only queues the change."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_SetPropertyQueued a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ncode = \\x22import pyttsx3, time, os\\\\ne = pyttsx3.init(); a = e.getProperty(\\'rate\\'); e.setProperty(\\'rate\\', 300); b = e.getProperty(\\'rate\\'); e.save_to_file(\\'Hello there my friend\\', \\'q.wav\\'); e.runAndWait(); time.sleep(1.5); print((a, b, e.getProperty(\\'rate\\')))\\x22\\nout = eval(py(code)[1])\\n', g), g['out'])[1])({}) evaluates to (200, 200, 300)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ncode = \\x22import pyttsx3, time, os\\\\ne = pyttsx3.init(); a = e.getProperty(\\'rate\\'); e.setProperty(\\'rate\\', 300); b = e.getProperty(\\'rate\\'); e.save_to_file(\\'Hello there my friend\\', \\'q.wav\\'); e.runAndWait(); time.sleep(1.5); print((a, b, e.getProperty(\\'rate\\')))\\x22\\nout = eval(py(code)[1])\\n', g), g['out'])[1])({})" ; chx:output "(200, 200, 300)" .
chx:X_SetPropertyQueued rd:hasIOExample chx:IO_SetPropertyQueued .
chx:X_PersistentVoice a owl:NamedIndividual, chx:PersistentVoice ; rdfs:label "engine.setProperty('voice', voices[1].id)"@en ; skos:definition "The chapter's listing 4 sets the rate to 300, the volume to 0.5 and the voice to voices[1].id, which is sem/am here (Amharic), and the same engine object makes the hello.wav of listing 5: it was 0.89 s long, while a fresh engine makes 1.54 s of the same sentence."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_PersistentVoice a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ntp = J(\\'third_party_record\\')[\\'items\\'][2][\\'output\\']\\ncode = \\x22import pyttsx3\\\\ne = pyttsx3.init(); print(e.getProperty(\\'voices\\')[1].id)\\x22\\nout = (tp[\\'probes after the listings\\'][\\'hello.wav\\'][3], say(\\'Hello. How are you doing?\\', \\'d.wav\\')[4], py(code)[1])\\n', g), g['out'])[1])({}) evaluates to (0.89, 1.54, 'sem/am')"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ntp = J(\\'third_party_record\\')[\\'items\\'][2][\\'output\\']\\ncode = \\x22import pyttsx3\\\\ne = pyttsx3.init(); print(e.getProperty(\\'voices\\')[1].id)\\x22\\nout = (tp[\\'probes after the listings\\'][\\'hello.wav\\'][3], say(\\'Hello. How are you doing?\\', \\'d.wav\\')[4], py(code)[1])\\n', g), g['out'])[1])({})" ; chx:output "(0.89, 1.54, 'sem/am')" .
chx:X_PersistentVoice rd:hasIOExample chx:IO_PersistentVoice .
chx:X_RateDuration a owl:NamedIndividual, chx:RateDuration ; rdfs:label "engine.setProperty('rate', 300)"@en ; skos:definition "The ten-word fox sentence of the chapter lasted 5.44 s at rate 100, 2.7 s at 200 (the default) and 1.76 s at 300 when each setting was made in a fresh process, so the rate is words per minute only roughly (222 measured at 200)."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_RateDuration a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nd = [say(T, \\'r%d.wav\\' % r, rate=r)[4] for r in (100, 200, 300)]\\nout = (d[0], d[1], d[2], round(10 / d[1] * 60))\\n', g), g['out'])[1])({}) evaluates to (5.44, 2.7, 1.76, 222)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nd = [say(T, \\'r%d.wav\\' % r, rate=r)[4] for r in (100, 200, 300)]\\nout = (d[0], d[1], d[2], round(10 / d[1] * 60))\\n', g), g['out'])[1])({})" ; chx:output "(5.44, 2.7, 1.76, 222)" .
