chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 24 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch24/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 24 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which parts of a program that speaks text, saves it as audio, recognises it and writes subtitles can be shown to work, and which can only be shown to fail or be read from documentation, on a machine that has no sound card, no microphone, no GPU, no Windows or macOS and no way to download from YouTube, and how large is the spread between interpreter, model and package releases?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, programs, version numbers and statements of the chapter differ in current releases of Python, pyttsx3, openai-whisper and yt-dlp, with or without ffmpeg and eSpeak, or in the files and pages it points to, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 24 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 24 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch24/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-14."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py" .

