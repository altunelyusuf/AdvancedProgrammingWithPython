t l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\na = py(\\'import pyttsx3; e = pyttsx3.init(); e.save_to_file(\\x22Hi\\x22, \\x22/nonexistent/x.wav\\x22); e.runAndWait()\\', limit=15)[0]\\nb = py(\\'import pyttsx3; e = pyttsx3.init(); e.save_to_file(\\x22Hello.\\x22, \\x22a.wav\\x22); e.runAndWait(); e.save_to_file(\\x22Hi\\x22, \\x22/nonexistent/x.wav\\x22); e.runAndWait()\\', limit=15)[1]\\nc = py(\\'import pyttsx3; e = pyttsx3.init(); e.setProperty(\\x22rate\\x22, 150); e.runAndWait(); e.runAndWait()\\', limit=15)[1]\\nout = (a, b, c)\\n', g), g['out'])[1])({})" ; chx:output "(0, 'NO RETURN', 'NO RETURN')" .
