chx:X_SanitizeInfo a owl:NamedIndividual, chx:SanitizeInfo ; rdfs:label "ydl.sanitize_info(info)"@en ; skos:definition "The chapter's prose names ydl.sanitize() but the listing calls ydl.sanitize_info(): the class YoutubeDL has sanitize (False) and sanitize_info (True) in yt-dlp 2026.8.19, and the result of sanitize_info is a plain dictionary that json.dumps can write (dict)."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_SanitizeInfo a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ncode = \\x22import yt_dlp, json\\\\nY = yt_dlp.YoutubeDL\\\\nsi = Y.sanitize_info({\\'a\\': 1, \\'b\\': [1, 2], \\'c\\': object})\\\\nprint((hasattr(Y, \\'sanitize\\'), hasattr(Y, \\'sanitize_info\\'), yt_dlp.version.__version__, type(si).__name__))\\x22\\na = eval(py(code)[1]); out = (a[0], a[1], md.version(\\'yt-dlp\\'), a[3])\\n', g), g['out'])[1])({}) evaluates to (False, True, '2026.8.19', 'dict')"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ncode = \\x22import yt_dlp, json\\\\nY = yt_dlp.YoutubeDL\\\\nsi = Y.sanitize_info({\\'a\\': 1, \\'b\\': [1, 2], \\'c\\': object})\\\\nprint((hasattr(Y, \\'sanitize\\'), hasattr(Y, \\'sanitize_info\\'), yt_dlp.version.__version__, type(si).__name__))\\x22\\na = eval(py(code)[1]); out = (a[0], a[1], md.version(\\'yt-dlp\\'), a[3])\\n', g), g['out'])[1])({})" ; chx:output "(False, True, '2026.8.19', 'dict')" .
chx:X_SanitizeInfo rd:hasIOExample chx:IO_SanitizeInfo .
chx:X_KeysOfBook a owl:NamedIndividual, chx:KeysOfBook ; rdfs:label "print('KEYS:', json_info.keys())"@en ; skos:definition "Of the keys the chapter prints for the video, 13 of 13 were present in what yt-dlp returned on the day and none was missing (True), and the first 13 keys came in the book's order (True); the listing prints a dict_keys, which is a view and not a list."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_KeysOfBook a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\ncr = J(\\'corpus_run\\')[\\'programs\\']\\n\\nt = cr[\\'ytdlpMetadata_v1_0_0.py\\'][\\'stdout\\'].splitlines()\\nl = [x for x in t if x.startswith(\\'keys printed\\')][0]\\nks = eval(l.split(\\'has: \\')[1].split(\\' | \\')[0])\\nout = (len(ks), 13, eval(l.split(\\'missing: \\')[1]) == [], [x for x in t if x.startswith(\\'the first 13 keys\\')][0].endswith(\\'True\\'))\\n', g), g['out'])[1])({}) evaluates to (13, 13, True, True)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\ncr = J(\\'corpus_run\\')[\\'programs\\']\\n\\nt = cr[\\'ytdlpMetadata_v1_0_0.py\\'][\\'stdout\\'].splitlines()\\nl = [x for x in t if x.startswith(\\'keys printed\\')][0]\\nks = eval(l.split(\\'has: \\')[1].split(\\' | \\')[0])\\nout = (len(ks), 13, eval(l.split(\\'missing: \\')[1]) == [], [x for x in t if x.startswith(\\'the first 13 keys\\')][0].endswith(\\'True\\'))\\n', g), g['out'])[1])({})" ; chx:output "(13, 13, True, True)" .
