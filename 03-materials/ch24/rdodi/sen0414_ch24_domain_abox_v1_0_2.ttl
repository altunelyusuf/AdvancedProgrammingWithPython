chx:X_AnswersAppendixB a owl:NamedIndividual, chx:AnswersAppendixB ; rdfs:label "Appendix B, answers to chapter 24"@en ; skos:definition "Appendix B gives 7 answers to the questions of chapter 24 and says in the fifth that Whisper's default model is 'base', in the third that neither pyttsx3 nor Whisper needs an online service, and in the seventh that yt-dlp can download from hundreds of websites (True)."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_AnswersAppendixB a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nt = [i for i in J(\\'live_observations\\')[\\'items\\'] if i[\\'what\\'].startswith(\\'Appendix B of the book\\')][0][\\'saw\\'][1]\\nimport re as _re\\na = _re.findall(r\\'\\\\d\\\\. \\', t.split(\\'Chapter 24\\', 1)[1])\\nout = (len(a), \\'default model is\\' in t and \\x22\\'base\\'\\x22 in t and \\'hundred\\' in t)\\n', g), g['out'])[1])({}) evaluates to (7, True)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nt = [i for i in J(\\'live_observations\\')[\\'items\\'] if i[\\'what\\'].startswith(\\'Appendix B of the book\\')][0][\\'saw\\'][1]\\nimport re as _re\\na = _re.findall(r\\'\\\\d\\\\. \\', t.split(\\'Chapter 24\\', 1)[1])\\nout = (len(a), \\'default model is\\' in t and \\x22\\'base\\'\\x22 in t and \\'hundred\\' in t)\\n', g), g['out'])[1])({})" ; chx:output "(7, True)" .
chx:X_AnswersAppendixB rd:hasIOExample chx:IO_AnswersAppendixB .
chx:X_DefaultModelAnswer a owl:NamedIndividual, chx:DefaultModelAnswer ; rdfs:label "whisper.load_model()  # no name"@en ; skos:definition "load_model has the parameters ['name', 'device', 'download_root', 'in_memory'] and no default for name, so whisper.load_model() raised TypeError; the command-line tool whisper takes 'turbo' as its default model in 20250625 and 'small' in the pinned 20231117, so the 'base' of Appendix B answer 5 is the model of the chapter's listing, not a default of either."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_DefaultModelAnswer a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ncode = \\x22import whisper, inspect, re\\\\nprint(list(inspect.signature(whisper.load_model).parameters))\\\\ntry:\\\\n    whisper.load_model()\\\\nexcept BaseException as e:\\\\n    print(type(e).__name__)\\\\nimport sys\\\\nprint(re.search(r\\'--model.{0,5}default=.(\\\\\\\\w+)\\', inspect.getsource(sys.modules[\\'whisper.transcribe\\'].cli)).group(1))\\x22\\na, b, c = py(code)[1].split(\\'\\\\n\\'); c2 = py(code, PINS)[1].split(\\'\\\\n\\')[2]\\nout = (eval(a), b, c, c2)\\n', g), g['out'])[1])({}) evaluates to (['name', 'device', 'download_root', 'in_memory'], 'TypeError', 'turbo', 'small')"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\ncode = \\x22import whisper, inspect, re\\\\nprint(list(inspect.signature(whisper.load_model).parameters))\\\\ntry:\\\\n    whisper.load_model()\\\\nexcept BaseException as e:\\\\n    print(type(e).__name__)\\\\nimport sys\\\\nprint(re.search(r\\'--model.{0,5}default=.(\\\\\\\\w+)\\', inspect.getsource(sys.modules[\\'whisper.transcribe\\'].cli)).group(1))\\x22\\na, b, c = py(code)[1].split(\\'\\\\n\\'); c2 = py(code, PINS)[1].split(\\'\\\\n\\')[2]\\nout = (eval(a), b, c, c2)\\n', g), g['out'])[1])({})" ; chx:output "(['name', 'device', 'download_root', 'in_memory'], 'TypeError', 'turbo', 'small')" .
chx:X_DefaultModelAnswer rd:hasIOExample chx:IO_DefaultModelAnswer .
chx:X_OfflineAnswer a owl:NamedIndividual, chx:OfflineAnswer ; rdfs:label "Appendix B answer 3: no online service or internet access"@en ; skos:definition "With the tiny model already on disk, a program that saved speech and transcribed it ran with exit code 0 inside a network namespace with no interface; with no model file and no route it raised URLError, and with the internet it downloaded 75572083 bytes: the answer is true after the first download."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_OfflineAnswer a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\ncr = J(\\'corpus_run\\')[\\'programs\\']\\n\\nt = cr[\\'offlineClaim_v1_0_0.py\\'][\\'stdout\\'].splitlines()\\nrc = int([l for l in t if l.startswith(\\'inside a network namespace\\')][0].split(\\'return code \\')[1].split()[0])\\nimport re as _re\\nlast = [l for l in t if l.startswith(\\'the same with the internet\\')][0]\\nout = (rc, eval([l for l in t if l.startswith(\\'no model file\\')][0].split(\\': \\', 1)[1])[0].split()[0], int(_re.findall(r\\'\\\\[(\\\\d+)\\\\]\\', last)[-1]))\\n', g), g['out'])[1])({}) evaluates to (0, 'URLError', 75572083)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\ncr = J(\\'corpus_run\\')[\\'programs\\']\\n\\nt = cr[\\'offlineClaim_v1_0_0.py\\'][\\'stdout\\'].splitlines()\\nrc = int([l for l in t if l.startswith(\\'inside a network namespace\\')][0].split(\\'return code \\')[1].split()[0])\\nimport re as _re\\nlast = [l for l in t if l.startswith(\\'the same with the internet\\')][0]\\nout = (rc, eval([l for l in t if l.startswith(\\'no model file\\')][0].split(\\': \\', 1)[1])[0].split()[0], int(_re.findall(r\\'\\\\[(\\\\d+)\\\\]\\', last)[-1]))\\n', g), g['out'])[1])({})" ; chx:output "(0, 'URLError', 75572083)" .
chx:X_OfflineAnswer rd:hasIOExample chx:IO_OfflineAnswer .
chx:X_PythonSeries a owl:NamedIndividual, chx:PythonSeries ; rdfs:label "uv run --python 3.13 --with pyttsx3"@en ; skos:definition "One program that saves speech, lists voices and asks yt-dlp questions ran under 11 interpreters (3.11, 3.12, 3.13, the seven 3.14 releases 3.14.0 to 3.14.6, and the beta 3.15.0b4) and compared 14 items: only 2 differed, both about the standard-library modules aifc and the others that Python 3.13 removed; the same program with Whisper compared 16 items and 2 differed, only in how a type is printed."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_PythonSeries a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nd = J(\\'interpreter_record\\')\\nout = (len(d[\\'interpreters\\']), d[\\'items compared\\'], len(d[\\'differ\\']), d[\\'whisper items compared\\'], len(d[\\'whisper differ\\']))\\n', g), g['out'])[1])({}) evaluates to (11, 14, 2, 16, 2)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nd = J(\\'interpreter_record\\')\\nout = (len(d[\\'interpreters\\']), d[\\'items compared\\'], len(d[\\'differ\\']), d[\\'whisper items compared\\'], len(d[\\'whisper differ\\']))\\n', g), g['out'])[1])({})" ; chx:output "(11, 14, 2, 16, 2)" .
chx:X_PythonSeries rd:hasIOExample chx:IO_PythonSeries .
chx:X_Pep594Modules a owl:NamedIndividual, chx:Pep594Modules ; rdfs:label "import aifc"@en ; skos:definition "Python 3.13 removed the modules aifc, audioop, chunk, sndhdr and sunau (PEP 594) and kept wave: on this interpreter {'aifc': False, 'audioop': False, 'sunau': False, 'chunk': False, 'sndhdr': False, 'wave': True}; under 3.11.17 and 3.12.3 all six imported (['3.11.17', '3.12.3']), under 3.13.14 and later none of the five did (3.13.14 to 3.15.0b4); the wave module, which pyttsx3 uses to write its file, is unaffected."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_Pep594Modules a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nimport importlib.util as iu\\nhere = {m: iu.find_spec(m) is not None for m in (\\'aifc\\', \\'audioop\\', \\'sunau\\', \\'chunk\\', \\'sndhdr\\', \\'wave\\')}\\nd = J(\\'interpreter_record\\')[\\'differ\\'][\\'modules removed by PEP 594 that can be imported (aifc, audioop, sunau, chunk, sndhdr, wave)\\']\\nold = [x for x in d if x[0][\\'aifc\\']][0]; new = [x for x in d if not x[0][\\'aifc\\']][0]\\nout = (here, old[1], new[1][0] + \\' to \\' + new[1][-1])\\n', g), g['out'])[1])({}) evaluates to ({'aifc': False, 'audioop': False, 'sunau': False, 'chunk': False, 'sndhdr': False, 'wave': True}, ['3.11.17', '3.12.3'], '3.13.14 to 3.15.0b4')"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nimport importlib.util as iu\\nhere = {m: iu.find_spec(m) is not None for m in (\\'aifc\\', \\'audioop\\', \\'sunau\\', \\'chunk\\', \\'sndhdr\\', \\'wave\\')}\\nd = J(\\'interpreter_record\\')[\\'differ\\'][\\'modules removed by PEP 594 that can be imported (aifc, audioop, sunau, chunk, sndhdr, wave)\\']\\nold = [x for x in d if x[0][\\'aifc\\']][0]; new = [x for x in d if not x[0][\\'aifc\\']][0]\\nout = (here, old[1], new[1][0] + \\' to \\' + new[1][-1])\\n', g), g['out'])[1])({})" ; chx:output "({'aifc': False, 'audioop': False, 'sunau': False, 'chunk': False, 'sndhdr': False, 'wave': True}, ['3.11.17', '3.12.3'], '3.13.14 to 3.15.0b4')" .
chx:X_Pep594Modules rd:hasIOExample chx:IO_Pep594Modules .
chx:X_PyttsxReleases a owl:NamedIndividual, chx:PyttsxReleases ; rdfs:label "pip install pyttsx3==2.97"@en ; skos:definition "PyPI lists 22 releases of pyttsx3, the newest 2.99 of 2025-07-08; on Python 3.14.6 8 of them ran, 9 crashed with a segmentation fault (every release from 2.71 to 2.95 that could be installed) and 5 could not be installed because their pyobjc requirement needs macOS; the items that differ between the ones that ran are ['drivers in the package', 'module-level speak() exists', 'requires', 'save_to_file then runAndWait: wav', 'say(empty)', 'voices: count and first'], and releases before 2.97 listed 75 voices instead of 131, and the first five have no save_to_file at all."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_PyttsxReleases a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nd = J(\\'interpreter_record\\'); r = d[\\'pyttsx3 releases\\']; ok = [v for v in r if \\'NOT EXECUTED or failed\\' not in r[v]]\\nvs = sorted(r, key=lambda v: [int(x) for x in v.split(\\'.\\')])\\ndif = d[\\'pyttsx3 differ\\']\\nseg = sum(1 for v in r if \\'SIGSEGV\\' in r[v].get(\\'NOT EXECUTED or failed\\', \\'\\'))\\nmac = sum(1 for v in r if \\'macOS\\' in r[v].get(\\'NOT EXECUTED or failed\\', \\'\\') or \\'sw_vers\\' in r[v].get(\\'NOT EXECUTED or failed\\', \\'\\'))\\nout = (len(r), vs[-1], d[\\'pyttsx3 release dates\\'][vs[-1]], len(ok), sorted(dif), dif[\\'voices: count and first\\'][0][0][0][0], dif[\\'voices: count and first\\'][1][0][0][0], seg, mac)\\n', g), g['out'])[1])({}) evaluates to (22, '2.99', '2025-07-08', 8, ['drivers in the package', 'module-level speak() exists', 'requires', 'save_to_file then runAndWait: wav', 'say(empty)', 'voices: count and first'], 75, 131, 9, 5)"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120,