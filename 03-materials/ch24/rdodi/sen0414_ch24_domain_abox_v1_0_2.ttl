chx:X_MemoryAndGpuLimits a owl:NamedIndividual, chx:MemoryAndGpuLimits ; rdfs:label "whisper.load_model('large-v3')"@en ; skos:definition "On this machine with 8029 MiB of memory, loading medium and turbo ended with return code -9 and return code -9 (the kernel's out-of-memory killer), and large-v3 (a 3087371615-byte file) could not be loaded under a 6.5 GB limit (RuntimeError); device='cuda' raised RuntimeError because torch.cuda.is_available() is False: no GPU was used and none of the larger models was transcribed."@en ; dcterms:source <http://example.org/sen0414/ch24/research> .
chx:IO_MemoryAndGpuLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nr = J(\\'model_runtimes\\'); m = r[\\'results\\']\\ncode = \\x22import whisper\\\\ntry:\\\\n    whisper.load_model(\\'tiny\\', device=\\'cuda\\')\\\\nexcept BaseException as e:\\\\n    print(type(e).__name__)\\\\nimport torch\\\\nprint(torch.cuda.is_available())\\x22\\na, b = py(code)[1].split(\\'\\\\n\\')\\nout = (r[\\'machine\\'][\\'memory MiB\\'], \\'return code \\' + m[\\'medium\\'][\\'NOT EXECUTED or failed\\'].split(\\'return code \\')[1].split(\\' \\')[0], \\'return code \\' + m[\\'turbo\\'][\\'NOT EXECUTED or failed\\'].split(\\'return code \\')[1].split(\\' \\')[0], m[\\'large-v3\\'][\\'file bytes\\'], m[\\'large-v3\\'][\\'load attempt under an address-space limit of 6.5 GB\\'].split(\\':\\')[0].split(\\' \\')[0], a, b)\\n', g), g['out'])[1])({}) evaluates to (8029, 'return code -9', 'return code -9', 3087371615, 'RuntimeError', 'RuntimeError', 'False')"@en ; chx:input "(lambda g: (exec('import io, os, sys, re, json, time, shutil, tempfile, warnings, subprocess, wave, array, importlib.metadata as md\\nwarnings.simplefilter(\\'ignore\\')\\nLATEST = os.environ.get(\\'CH24_LATEST\\', \\'/home/claude/venv314_ch24_latest/bin/python\\')\\nPINS = os.environ.get(\\'CH24_PINS\\', \\'/home/claude/venv312_ch24_pins/bin/python\\')\\nBARE = os.environ.get(\\'CH24_BARE\\', \\'/home/claude/venv314_ch24_bare/bin/python\\')\\nR = \\'/home/claude/AdvancedProgrammingWithPython/08-tooling/ch24-page/\\'\\nT = \\'The quick brown fox jumps over the yellow lazy dog.\\'\\nH = \\'Hello. How are you doing?\\'\\ndef J(n): return json.load(open(R + n + \\'_v1_0_0.json\\'))\\ndef py(code, exe=None, limit=120, env=None):\\n    try: r = subprocess.run([exe or LATEST, \\'-W\\', \\'ignore\\', \\'-c\\', code], capture_output=True, text=True, timeout=limit, stdin=subprocess.DEVNULL, env=env)\\n    except subprocess.TimeoutExpired: return (None, \\'NO RETURN\\', [])\\n    return (r.returncode, \\'\\\\n\\'.join(l for l in r.stdout.splitlines() if not l.startswith(\\'Audio saved to\\')).strip(), [l for l in r.stderr.splitlines() if \\'ALSA\\' not in l and \\'aplay\\' not in l][-1:])\\ndef stable(p, quiet=0.8, limit=120):\\n    t0 = time.time(); last = -1; since = None\\n    while time.time() - t0 < limit:\\n        if os.path.exists(p):\\n            n = os.path.getsize(p)\\n            if n == last and n > 44:\\n                if since is not None and time.time() - since >= quiet: return True\\n            else: since = time.time(); last = n\\n        time.sleep(0.05)\\n    return False\\ndef wav(p):\\n    for _ in range(40):\\n        try:\\n            w = wave.open(p); n = w.getnframes(); a = array.array(\\'h\\', w.readframes(n)); return (w.getnchannels(), w.getsampwidth(), w.getframerate(), n, round(n / w.getframerate(), 2), max(abs(x) for x in a) if len(a) else 0)\\n        except (EOFError, wave.Error): time.sleep(0.25)\\n    raise EOFError(p)\\ndef say(text, path, **props):\\n    py(\\'import pyttsx3\\\\ne = pyttsx3.init()\\\\n\\' + \\'\\'.join(\\'e.setProperty(%r, %r)\\\\n\\' % kv for kv in props.items()) + \\'e.save_to_file(%r, %r)\\\\ne.runAndWait()\\' % (text, path)); stable(path); return wav(path)\\nos.chdir(tempfile.mkdtemp())\\n\\nr = J(\\'model_runtimes\\'); m = r[\\'results\\']\\ncode = \\x22import whisper\\\\ntry:\\\\n    whisper.load_model(\\'tiny\\', device=\\'cuda\\')\\\\nexcept BaseException as e:\\\\n    print(type(e).__name__)\\\\nimport torch\\\\nprint(torch.cuda.is_available())\\x22\\na, b = py(code)[1].split(\\'\\\\n\\')\\nout = (r[\\'machine\\'][\\'memory MiB\\'], \\'return code \\' + m[\\'medium\\'][\\'NOT EXECUTED or failed\\'].split(\\'return code \\')[1].split(\\' \\')[0], \\'return code \\' + m[\\'turbo\\'][\\'NOT EXECUTED or failed\\'].split(\\'return code \\')[1].split(\\' \\')[0], m[\\'large-v3\\'][\\'file bytes\\'], m[\\'large-v3\\'][\\'load attempt under an address-space limit of 6.5 GB\\'].split(\\':\\')[0].split(\\' \\')[0], a, b)\\n', g), g['out'])[1])({})" ; chx:output "(8029, 'return code -9', 'return code -9', 3087371615, 'RuntimeError', 'RuntimeError', 'False')" .
