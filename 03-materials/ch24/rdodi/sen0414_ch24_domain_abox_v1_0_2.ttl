peared during the triassic period. Between 245 and 233.23 million years ago.\\', \\'language\\': \\'en\\', \\'segments\\': [{\\'id\\': 0, \\'start\\': 0.0, \\'end\\': 5.64, \\'text\\': \\' Dinosaurs are a diverse group of reptiles of the clade dinosauria. They first\\'}, {\\'id\\': 1, \\'start\\': 5.64, \\'end\\': 14.96, \\'text\\': \\' appeared during the triassic period. Between 245 and 233.23 million years ago.\\'}]}\\nfrom whisper.utils import get_writer, format_timestamp\\ndef write(fmt, base=\\'audio\\', folder=\\'.\\'):\\n    get_writer(fmt, folder)(BOOKRES, base); return open(os.path.join(folder, base + \\'.\\' + fmt), encoding=\\'utf-8\\').read()\\ntp = J(\\'third_party_record\\')[\\'items\\'][2][\\'output\\'][\\'results\\'][6][\\'statements\\'][0][\\'as printed\\']\\n\\nt = write(\\'srt\\'); tpp = J(\\'third_party_record\\')[\\'items\\'][3][\\'output\\'][\\'results\\'][6][\\'statements\\'][0][\\'as printed\\']\\nout = (len(t.encode()), t.split(\\'\\\\n\\')[:2], tp[\\'matches the book\\'], tpp[\\'matches the book\\'])\\n', g), g['out'])[1])({})" ; chx:output "(223, ['1', '00:00:00,000 --> 00:00:05,640'], True, True)" .
