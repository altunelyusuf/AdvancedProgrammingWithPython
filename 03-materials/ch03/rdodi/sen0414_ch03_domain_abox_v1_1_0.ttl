ch03:X_Loop a owl:NamedIndividual, ch03:Loop ; rdfs:label "the if and while versions of the same block"@en ; skos:definition "A loop is a block that Python runs repeatedly: at the end of the block, execution jumps back to the start instead of moving on."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_Iteration a owl:NamedIndividual, ch03:Iteration ; rdfs:label "the five iterations of the while example"@en ; skos:definition "One execution of a loop's block; a while loop tests its condition at the start of every iteration."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_WhileStatement a owl:NamedIndividual, ch03:WhileStatement ; rdfs:label "while name != 'your name':"@en ; skos:definition "A while statement repeats its block as long as its condition is true, and tests the condition again after every pass."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_InfiniteLoop a owl:NamedIndividual, ch03:InfiniteLoop ; rdfs:label "while True:"@en ; skos:definition "A loop whose condition never becomes false runs until something inside it leaves: break, return, sys.exit() or an exception."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ForStatement a owl:NamedIndividual, ch03:ForStatement ; rdfs:label "for i in range(5):"@en ; skos:definition "A for statement takes each item of an iterable in turn, assigns it to its variable and runs the block once for each."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ForWhileEquivalence a owl:NamedIndividual, ch03:ForWhileEquivalence ; rdfs:label "i = 0, while i < 5, i = i + 1"@en ; skos:definition "A while loop with a counter set before the loop, tested in its condition and increased at the end of the block does what a for loop over a range does."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_Accumulator a owl:NamedIndividual, ch03:Accumulator ; rdfs:label "total = total + num"@en ; skos:definition "A variable that starts at a known value before the loop and is updated on every iteration, so that it holds the running result when the loop ends."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_Accumulator a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum(range(101)) evaluates to 5050"@en ; ch03:input "sum(range(101))" ; ch03:output "5050" .
ch03:X_Accumulator rd:hasIOExample ch03:IO_Accumulator .
ch03:X_NestedLoop a owl:NamedIndividual, ch03:NestedLoop ; rdfs:label "a while loop inside a while loop"@en ; skos:definition "A loop placed in the block of another loop: the inner loop runs completely on every iteration of the outer one, and break leaves only the inner loop."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_GuessTheNumber a owl:NamedIndividual, ch03:GuessTheNumber ; rdfs:label "guessTheNumber.py"@en ; skos:definition "A program that imports random, picks a secret number and gives the player at most six guesses in a for loop that ends early with break."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_RockPaperScissors a owl:NamedIndividual, ch03:RockPaperScissors ; rdfs:label "rpsGame.py"@en ; skos:definition "A program built from two nested while True loops: an input loop that keeps asking until the move is valid, and a main loop that plays one game per iteration."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_RangeStop a owl:NamedIndividual, ch03:RangeStop ; rdfs:label "range(5)"@en ; skos:definition "range(n) yields the integers from 0 up to but not including n."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_RangeStop a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(5)) evaluates to [0, 1, 2, 3, 4]"@en ; ch03:input "list(range(5))" ; ch03:output "[0, 1, 2, 3, 4]" .
ch03:X_RangeStop rd:hasIOExample ch03:IO_RangeStop .
ch03:X_RangeStartStop a owl:NamedIndividual, ch03:RangeStartStop ; rdfs:label "range(12, 16)"@en ; skos:definition "range(start, stop) begins at start and ends before stop."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_RangeStartStop a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(12, 16)) evaluates to [12, 13, 14, 15]"@en ; ch03:input "list(range(12, 16))" ; ch03:output "[12, 13, 14, 15]" .
ch03:X_RangeStartStop rd:hasIOExample ch03:IO_RangeStartStop .
ch03:X_RangeStep a owl:NamedIndividual, ch03:RangeStep ; rdfs:label "range(0, 10, 2)"@en ; skos:definition "A third argument is the step between values."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_RangeStep a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(0, 10, 2)) evaluates to [0, 2, 4, 6, 8]"@en ; ch03:input "list(range(0, 10, 2))" ; ch03:output "[0, 2, 4, 6, 8]" .
ch03:X_RangeStep rd:hasIOExample ch03:IO_RangeStep .
ch03:X_RangeDescending a owl:NamedIndividual, ch03:RangeDescending ; rdfs:label "range(5, -1, -1)"@en ; skos:definition "A negative step counts down, and the stop value is still excluded."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_RangeDescending a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(5, -1, -1)) evaluates to [5, 4, 3, 2, 1, 0]"@en ; ch03:input "list(range(5, -1, -1))" ; ch03:output "[5, 4, 3, 2, 1, 0]" .
ch03:X_RangeDescending rd:hasIOExample ch03:IO_RangeDescending .
ch03:X_LazyRange a owl:NamedIndividual, ch03:LazyRange ; rdfs:label "range(10)"@en ; skos:definition "A range is an object that produces its values when iterated, not a list holding them."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_LazyRange a owl:NamedIndividual, rd:IOExample ; rdfs:label "range(10) evaluates to range(0, 10)"@en ; ch03:input "range(10)" ; ch03:output "range(0, 10)" .
ch03:X_LazyRange rd:hasIOExample ch03:IO_LazyRange .
ch03:X_HalfOpenRange a owl:NamedIndividual, ch03:HalfOpenRange ; rdfs:label "range(0, 24) for the hours of a day"@en ; skos:definition "A range includes its start and excludes its end, so its length is stop minus start and neighbouring ranges join without a gap."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_HalfOpenRange a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(range(0, 24)) evaluates to 24"@en ; ch03:input "len(range(0, 24))" ; ch03:output "24" .
ch03:X_HalfOpenRange rd:hasIOExample ch03:IO_HalfOpenRange .
ch03:X_RangeOperations a owl:NamedIndividual, ch03:RangeOperations ; rdfs:label "range(0, 20, 2)[5]"@en ; skos:definition "A range supports length, membership tests, indexing, slicing and index lookup, but not concatenation or repetition."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_RangeOperations a owl:NamedIndividual, rd:IOExample ; rdfs:label "range(0, 20, 2)[5] evaluates to 10"@en ; ch03:input "range(0, 20, 2)[5]" ; ch03:output "10" .
ch03:X_RangeOperations rd:hasIOExample ch03:IO_RangeOperations .
ch03:X_EnumerateFunction a owl:NamedIndividual, ch03:EnumerateFunction ; rdfs:label "enumerate(['tic', 'tac', 'toe'])"@en ; skos:definition "enumerate pairs each item with a running count, replacing range(len(a)) when both are needed."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_EnumerateFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(enumerate(['tic', 'tac', 'toe'])) evaluates to [(0, 'tic'), (1, 'tac'), (2, 'toe')]"@en ; ch03:input "list(enumerate(['tic', 'tac', 'toe']))" ; ch03:output "[(0, 'tic'), (1, 'tac'), (2, 'toe')]" .
ch03:X_EnumerateFunction rd:hasIOExample ch03:IO_EnumerateFunction .
ch03:X_ZipStrict a owl:NamedIndividual, ch03:ZipStrict ; rdfs:label "zip(a, b, strict=True)"@en ; skos:definition "zip walks several iterables together; strict=True raises ValueError when their lengths differ instead of stopping at the shortest."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_ZipStrict a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(zip('ab', [1, 2], strict=True)) evaluates to [('a', 1), ('b', 2)]"@en ; ch03:input "list(zip('ab', [1, 2], strict=True))" ; ch03:output "[('a', 1), ('b', 2)]" .
ch03:X_ZipStrict rd:hasIOExample ch03:IO_ZipStrict .
ch03:X_TargetUnpacking a owl:NamedIndividual, ch03:TargetUnpacking ; rdfs:label "for i, v in enumerate(...):"@en ; skos:definition "A loop variable list receives the parts of each item: a pair is unpacked into two names, and the number of names must match the number of parts."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_IterableObject a owl:NamedIndividual, ch03:IterableObject ; rdfs:label "for ch in 'abc':"@en ; skos:definition "An iterable is an object that can return its members one at a time, so it can be the subject of a for loop."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_IterableObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "list('abc') evaluates to ['a', 'b', 'c']"@en ; ch03:input "list('abc')" ; ch03:output "['a', 'b', 'c']" .
ch03:X_IterableObject rd:hasIOExample ch03:IO_IterableObject .
ch03:X_IteratorObject a owl:NamedIndividual, ch03:IteratorObject ; rdfs:label "next(iter('hello'))"@en ; skos:definition "An iterator is an object that supplies the items of an iterable one at a time through next() and raises StopIteration when none are left."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_IteratorObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "next(iter('hello')) evaluates to 'h'"@en ; ch03:input "next(iter('hello'))" ; ch03:output "'h'" .
ch03:X_IteratorObject rd:hasIOExample ch03:IO_IteratorObject .
ch03:X_SequenceKind a owl:NamedIndividual, ch03:SequenceKind ; rdfs:label "'hello'[1]"@en ; skos:definition "A sequence is an ordered collection whose members are reached by integer position, counted from 0, and which has a length."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_SequenceKind a owl:NamedIndividual, rd:IOExample ; rdfs:label "'hello'[1] evaluates to 'e'"@en ; ch03:input "'hello'[1]" ; ch03:output "'e'" .
ch03:X_SequenceKind rd:hasIOExample ch03:IO_SequenceKind .
ch03:X_ListValue a owl:NamedIndividual, ch03:ListValue ; rdfs:label "[10, 20, 30]"@en ; skos:definition "A list is a mutable sequence written between square brackets; its items can be replaced, added and removed."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_ListValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(3)) + [9] evaluates to [0, 1, 2, 9]"@en ; ch03:input "list(range(3)) + [9]" ; ch03:output "[0, 1, 2, 9]" .
ch03:X_ListValue rd:hasIOExample ch03:IO_ListValue .
ch03:X_TupleValue a owl:NamedIndividual, ch03:TupleValue ; rdfs:label "(0, 'tic')"@en ; skos:definition "A tuple is an immutable sequence of values separated by commas, usually written in parentheses; enumerate and zip produce their pairs as tuples."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_TupleValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "tuple(range(3)) evaluates to (0, 1, 2)"@en ; ch03:input "tuple(range(3))" ; ch03:output "(0, 1, 2)" .
ch03:X_TupleValue rd:hasIOExample ch03:IO_TupleValue .
ch03:X_DictionaryValue a owl:NamedIndividual, ch03:DictionaryValue ; rdfs:label "{'Ada': 'active', 'Can': 'inactive'}"@en ; skos:definition "A dictionary is a collection of key and value pairs written between braces; a value is looked up by its key."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_DictionaryValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "{'Ada': 'active', 'Can': 'inactive'}['Can'] evaluates to 'inactive'"@en ; ch03:input "{'Ada': 'active', 'Can': 'inactive'}['Can']" ; ch03:output "'inactive'" .
ch03:X_DictionaryValue rd:hasIOExample ch03:IO_DictionaryValue .
ch03:X_BreakStatement a owl:NamedIndividual, ch03:BreakStatement ; rdfs:label "break"@en ; skos:definition "break ends the innermost enclosing loop at once and skips the loop's else clause."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ExitFunction a owl:NamedIndividual, ch03:ExitFunction ; rdfs:label "sys.exit()"@en ; skos:definition "sys.exit() raises SystemExit, which ends the program unless something intercepts it; finally clauses still run."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_KeyboardInterruptStop a owl:NamedIndividual, ch03:KeyboardInterruptStop ; rdfs:label "Control-C"@en ; skos:definition "Control-C raises KeyboardInterrupt in the running program, which stops it unless a handler catches the exception."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:IO_KeyboardInterruptStop a owl:NamedIndividual, rd:IOExample ; rdfs:label "issubclass(KeyboardInterrupt, Exception) evaluates to False"@en ; ch03:input "issubclass(KeyboardInterrupt, Exception)" ; ch03:output "False" .
ch03:X_KeyboardInterruptStop rd:hasIOExample ch03:IO_KeyboardInterruptStop .
ch03:X_ReturnFromLoop a owl:NamedIndividual, ch03:ReturnFromLoop ; rdfs:label "return inside a for loop"@en ; skos:definition "A return statement leaves the function that contains it, and with it any loop that is running inside the function."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ContinueStatement a owl:NamedIndividual, ch03:ContinueStatement ; rdfs:label "continue"@en ; skos:definition "continue skips the rest of the block and goes back to test the condition, or to take the next item."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_LoopElseClause a owl:NamedIndividual, ch03:LoopElseClause ; rdfs:label "for ... else:"@en ; skos:definition "An else clause on a loop runs when the loop finishes without executing break."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_LoopVariableScope a owl:NamedIndividual, ch03:LoopVariableScope ; rdfs:label "the variable after the loop"@en ; skos:definition "The loop variable is overwritten on each pass and is not deleted when the loop ends; after a loop over an empty sequence it was never assigned."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_LoopEnding a owl:NamedIndividual, ch03:LoopEnding ; rdfs:label "five ways a loop can end"@en ; skos:definition "A loop ends when its condition is false or its sequence is exhausted (both run the else clause), or when break, return or an unhandled exception leaves it (none run the else clause)."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ExceptionSignal a owl:NamedIndividual, ch03:ExceptionSignal ; rdfs:label "10 * (1/0)"@en ; skos:definition "An exception is an error detected during execution; unless a handler catches it, the program stops and prints the type of the exception and a message."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_FinallyClause a owl:NamedIndividual, ch03:FinallyClause ; rdfs:label "try: ... finally:"@en ; skos:definition "A finally clause runs as the last task of a try statement, whether the block finished normally, raised an exception, or was left by break, continue, return or sys.exit()."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_SyntaxWarning a owl:NamedIndividual, ch03:SyntaxWarning ; rdfs:label "SyntaxWarning: 'break' in a 'finally' block"@en ; skos:definition "A SyntaxWarning is reported while the code is compiled when it is legal but probably wrong; it does not stop the program."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ImportStatement a owl:NamedIndividual, ch03:ImportStatement ; rdfs:label "import random"@en ; skos:definition "import makes a module's names available under the module's name, as random.randint(1, 10)."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_MultipleImport a owl:NamedIndividual, ch03:MultipleImport ; rdfs:label "import random, sys, os, math"@en ; skos:definition "One import statement can name several modules separated by commas."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_StarImport a owl:NamedIndividual, ch03:StarImport ; rdfs:label "from random import *"@en ; skos:definition "from module import * brings every public name into the program without the module prefix."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_FromImport a owl:NamedIndividual, ch03:FromImport ; rdfs:label "from math import sqrt"@en ; skos:definition "from module import name binds only the listed names, which are then used without the module prefix; as gives a different name."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ModuleFile a owl:NamedIndividual, ch03:ModuleFile ; rdfs:label "math.__name__"@en ; skos:definition "A module is a file of Python definitions and statements; importing it creates a module object that carries its own name and namespace."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_StandardLibrary a owl:NamedIndividual, ch03:StandardLibrary ; rdfs:label "import math"@en ; skos:definition "The standard library is the set of modules that come with Python; the built-in functions need no import, the modules do."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ModuleNamespace a owl:NamedIndividual, ch03:ModuleNamespace ; rdfs:label "math.sqrt(16)"@en ; skos:definition "Every module keeps its names in its own namespace; a dotted name such as random.randint reaches into it."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ModuleSearchPath a owl:NamedIndividual, ch03:ModuleSearchPath ; rdfs:label "sys.path"@en ; skos:definition "Python looks for an imported module first in a cache of loaded modules and among the built-in modules, then in the directories listed in sys.path, beginning with the script's directory."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ModuleNameClash a owl:NamedIndividual, ch03:ModuleNameClash ; rdfs:label "a script saved as random.py"@en ; skos:definition "A file or variable that has the name of a Python module or built-in function hides the real one and produces confusing errors."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_RandomModule a owl:NamedIndividual, ch03:RandomModule ; rdfs:label "random.randint(1, 20)"@en ; skos:definition "random.randint(a, b) returns a pseudo-random integer N with a <= N <= b, both ends included."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_SysModule a owl:NamedIndividual, ch03:SysModule ; rdfs:label "sys.exit()"@en ; skos:definition "The sys module gives a program access to the interpreter: sys.exit() ends it, sys.path lists the module search directories and sys.modules holds the modules already loaded."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_AssignmentExpressionLoop a owl:NamedIndividual, ch03:AssignmentExpressionLoop ; rdfs:label "while chunk := file.read(8192):"@en ; skos:definition "An assignment expression names a value inside a condition, so a loop can read and test in one line."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_ImportStyle a owl:NamedIndividual, ch03:ImportStyle ; rdfs:label "import os on one line, import sys on the next"@en ; skos:definition "PEP 8 advises one import per line and against wildcard imports."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_MutationWhileIterating a owl:NamedIndividual, ch03:MutationWhileIterating ; rdfs:label "for user in users: del users[user]"@en ; skos:definition "Changing a collection while iterating over it is tricky to get right; loop over a copy or build a new collection."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_FinallyExit a owl:NamedIndividual, ch03:FinallyExit ; rdfs:label "break inside a finally block"@en ; skos:definition "Python 3.14 emits a SyntaxWarning when return, break or continue leaves a finally block."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:X_RangeStartStop ch03:hasOwner ch03:X_RangeStop .
ch03:X_RangeStep ch03:hasOwner ch03:X_RangeStop .
ch03:X_RangeDescending ch03:hasOwner ch03:X_RangeStep .
ch03:X_MultipleImport ch03:hasOwner ch03:X_ImportStatement .
ch03:X_StarImport ch03:hasOwner ch03:X_ImportStatement .
ch03:X_FromImport ch03:hasOwner ch03:X_ImportStatement .
ch03:X_ForWhileEquivalence ch03:hasOwner ch03:X_ForStatement .
ch03:X_IteratorObject ch03:hasOwner ch03:X_IterableObject .
ch03:Err_Accumulator a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "exec('for num in range(101):\\n    total = total + num') raises NameError: name 'total' is not defined"@en .
ch03:X_Accumulator rd:hasErrorCondition ch03:Err_Accumulator .
ch03:Err_RangeStep a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "range(0, 10, 0) raises ValueError: range() arg 3 must not be zero"@en .
ch03:X_RangeStep rd:hasErrorCondition ch03:Err_RangeStep .
ch03:Err_RangeStop a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "range(2.5) raises TypeError: 'float' object cannot be interpreted as an integer"@en .
ch03:X_RangeStop rd:hasErrorCondition ch03:Err_RangeStop .
ch03:Err_ZipStrict a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "list(zip('ab', [1], strict=True)) raises ValueError: zip() argument 2 is shorter than argument 1"@en .
ch03:X_ZipStrict rd:hasErrorCondition ch03:Err_ZipStrict .
ch03:Err_IterableObject a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "iter(5) raises TypeError: 'int' object is not iterable"@en .
ch03:X_IterableObject rd:hasErrorCondition ch03:Err_IterableObject .
ch03:Err_IteratorObject a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "next([1, 2]) raises TypeError: 'list' object is not an iterator"@en .
ch03:X_IteratorObject rd:hasErrorCondition ch03:Err_IteratorObject .
ch03:Err_DictionaryValue a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "{'Ada': 'active'}['Eda'] raises KeyError: 'Eda'"@en .
ch03:X_DictionaryValue rd:hasErrorCondition ch03:Err_DictionaryValue .
ch03:Err_TupleValue a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "exec('t = (1, 2)\\nt[0] = 99') raises TypeError: 'tuple' object does not support item assignment"@en .
ch03:X_TupleValue rd:hasErrorCondition ch03:Err_TupleValue .
ch03:Err_BreakStatement a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "exec('break') raises SyntaxError: 'break' outside loop"@en .
ch03:X_BreakStatement rd:hasErrorCondition ch03:Err_BreakStatement .
ch03:Err_ContinueStatement a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "exec('continue') raises SyntaxError: 'continue' not properly in loop"@en .
ch03:X_ContinueStatement rd:hasErrorCondition ch03:Err_ContinueStatement .
ch03:Err_ReturnFromLoop a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "exec('return') raises SyntaxError: 'return' outside function"@en .
ch03:X_ReturnFromLoop rd:hasErrorCondition ch03:Err_ReturnFromLoop .
ch03:Err_ExitFunction a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "sys.exit() raises NameError: name 'sys' is not defined"@en .
ch03:X_ExitFunction rd:hasErrorCondition ch03:Err_ExitFunction .
ch03:Err_LoopVariableScope a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "exec('for j in []:\\n    pass\\nprint(j)') raises NameError: name 'j' is not defined"@en .
ch03:X_LoopVariableScope rd:hasErrorCondition ch03:Err_LoopVariableScope .
ch03:Err_StarImport a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "exec('def f():\\n    from math import *') raises SyntaxError: import * only allowed at module level"@en .
ch03:X_StarImport rd:hasErrorCondition ch03:Err_StarImport .
ch03:Err_ModuleNamespace a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('math').nope raises AttributeError: module 'math' has no attribute 'nope'"@en .
ch03:X_ModuleNamespace rd:hasErrorCondition ch03:Err_ModuleNamespace .
ch03:Err_StandardLibrary a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "math.sqrt(16) raises NameError: name 'math' is not defined"@en .
ch03:X_StandardLibrary rd:hasErrorCondition ch03:Err_StandardLibrary .
ch03:Err_ImportStatement a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('no_such_module_x') raises ModuleNotFoundError: No module named 'no_such_module_x'"@en .
ch03:X_ImportStatement rd:hasErrorCondition ch03:Err_ImportStatement .
ch03:Err_MutationWhileIterating a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "exec('users = {1: 2}\\nfor u in users:\\n    del users[u]') raises RuntimeError: dictionary changed size during iteration"@en .
ch03:X_MutationWhileIterating rd:hasErrorCondition ch03:Err_MutationWhileIterating .

ch03:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 3 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch03/research> ;
    rd:hasCompetencyQuestion ch03:CQs ; rd:hasSourceProvenance ch03:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment ch03:Env .
ch03:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 3 competency questions"@en ;
    rd:containsCompetencyQuestion ch03:CQ1, ch03:CQ2, ch03:CQ3, ch03:CQ4, ch03:CQ5 .
ch03:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which constructs repeat a block, and what decides when each one stops?"@en .
ch03:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which statements leave or skip part of a loop, and what do they leave behind?"@en .
ch03:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which operations raise an error, and which error with which message?"@en .
ch03:CQ4 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which concepts reach beyond the 3rd edition into current Python, and on what source?"@en .
ch03:CQ5 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which terms does the chapter use without defining them, and where are they defined here?"@en .
ch03:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 3 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 3 through the Stage 1 research artefact; the loop mechanics, the module background and the modern-practice branch are drawn from that artefact's secondary sources (the Python documentation and PEPs), not from the book."@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> .
ch03:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.12.11 and CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (233 checks listed in sen0414_ch03_corpus_v1_0_0.py), executed under CPython 3.12.11 and CPython 3.14.4: identical output where more than one was used."@en ;
    dcterms:source "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch03_corpus_v1_0_0.py" .

