@prefix chx: <http://example.org/sen0414/ch03#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rd: <http://example.org/rdodi/domain-ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chx:Artifact a rd:DomainOntologyArtifact,
        owl:NamedIndividual ;
    rdfs:label "SEN0414 chapter 3 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch03/research> ;
    rd:hasCompetencyQuestion chx:CQs ;
    rd:hasResolutionEnvironment chx:Env ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ;
    rd:hasSourceProvenance chx:Provenance .

chx:X_Accumulator a chx:Accumulator,
        owl:NamedIndividual ;
    rdfs:label "total = total + num"@en ;
    rd:hasErrorCondition chx:Err_Accumulator ;
    rd:hasIOExample chx:IO_Accumulator ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A variable that starts at a known value before the loop and is updated on every iteration, so that it holds the running result when the loop ends."@en .

chx:X_AssignmentExpressionLoop a chx:AssignmentExpressionLoop,
        owl:NamedIndividual ;
    rdfs:label "while chunk := file.read(8192):"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "An assignment expression names a value inside a condition, so a loop can read and test in one line."@en .

chx:X_BreakStatement a chx:BreakStatement,
        owl:NamedIndividual ;
    rdfs:label "break"@en ;
    rd:hasErrorCondition chx:Err_BreakStatement ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "break ends the innermost enclosing loop at once and skips the loop's else clause."@en .

chx:X_ContinueStatement a chx:ContinueStatement,
        owl:NamedIndividual ;
    rdfs:label "continue"@en ;
    rd:hasErrorCondition chx:Err_ContinueStatement ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "continue skips the rest of the block and goes back to test the condition, or to take the next item."@en .

chx:X_DictionaryValue a chx:DictionaryValue,
        owl:NamedIndividual ;
    rdfs:label "{'Ada': 'active', 'Can': 'inactive'}"@en ;
    rd:hasErrorCondition chx:Err_DictionaryValue ;
    rd:hasIOExample chx:IO_DictionaryValue ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A dictionary is a collection of key and value pairs written between braces; a value is looked up by its key."@en .

chx:X_EnumerateFunction a chx:EnumerateFunction,
        owl:NamedIndividual ;
    rdfs:label "enumerate(['tic', 'tac', 'toe'])"@en ;
    rd:hasIOExample chx:IO_EnumerateFunction ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "enumerate pairs each item with a running count, replacing range(len(a)) when both are needed."@en .

chx:X_ExceptionSignal a chx:ExceptionSignal,
        owl:NamedIndividual ;
    rdfs:label "10 * (1/0)"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "An exception is an error detected during execution; unless a handler catches it, the program stops and prints the type of the exception and a message."@en .

chx:X_ExitFunction a chx:ExitFunction,
        owl:NamedIndividual ;
    rdfs:label "sys.exit()"@en ;
    rd:hasErrorCondition chx:Err_ExitFunction ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "sys.exit() raises SystemExit, which ends the program unless something intercepts it; finally clauses still run."@en .

chx:X_FinallyClause a chx:FinallyClause,
        owl:NamedIndividual ;
    rdfs:label "try: ... finally:"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A finally clause runs as the last task of a try statement, whether the block finished normally, raised an exception, or was left by break, continue, return or sys.exit()."@en .

chx:X_FinallyExit a chx:FinallyExit,
        owl:NamedIndividual ;
    rdfs:label "break inside a finally block"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "Python 3.14 emits a SyntaxWarning when return, break or continue leaves a finally block."@en .

chx:X_ForWhileEquivalence a chx:ForWhileEquivalence,
        owl:NamedIndividual ;
    rdfs:label "i = 0, while i < 5, i = i + 1"@en ;
    chx:hasOwner chx:X_ForStatement ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A while loop with a counter set before the loop, tested in its condition and increased at the end of the block does what a for loop over a range does."@en .

chx:X_FromImport a chx:FromImport,
        owl:NamedIndividual ;
    rdfs:label "from math import sqrt"@en ;
    chx:hasOwner chx:X_ImportStatement ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "from module import name binds only the listed names, which are then used without the module prefix; as gives a different name."@en .

chx:X_GuessTheNumber a chx:GuessTheNumber,
        owl:NamedIndividual ;
    rdfs:label "guessTheNumber.py"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A program that imports random, picks a secret number and gives the player at most six guesses in a for loop that ends early with break."@en .

chx:X_HalfOpenRange a chx:HalfOpenRange,
        owl:NamedIndividual ;
    rdfs:label "range(0, 24) for the hours of a day"@en ;
    rd:hasIOExample chx:IO_HalfOpenRange ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A range includes its start and excludes its end, so its length is stop minus start and neighbouring ranges join without a gap."@en .

chx:X_ImportStyle a chx:ImportStyle,
        owl:NamedIndividual ;
    rdfs:label "import os on one line, import sys on the next"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "PEP 8 advises one import per line and against wildcard imports."@en .

chx:X_InfiniteLoop a chx:InfiniteLoop,
        owl:NamedIndividual ;
    rdfs:label "while True:"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A loop whose condition never becomes false runs until something inside it leaves: break, return, sys.exit() or an exception."@en .

chx:X_Iteration a chx:Iteration,
        owl:NamedIndividual ;
    rdfs:label "the five iterations of the while example"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "One execution of a loop's block; a while loop tests its condition at the start of every iteration."@en .

chx:X_IteratorObject a chx:IteratorObject,
        owl:NamedIndividual ;
    rdfs:label "next(iter('hello'))"@en ;
    rd:hasErrorCondition chx:Err_IteratorObject ;
    rd:hasIOExample chx:IO_IteratorObject ;
    chx:hasOwner chx:X_IterableObject ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "An iterator is an object that supplies the items of an iterable one at a time through next() and raises StopIteration when none are left."@en .

chx:X_KeyboardInterruptStop a chx:KeyboardInterruptStop,
        owl:NamedIndividual ;
    rdfs:label "Control-C"@en ;
    rd:hasIOExample chx:IO_KeyboardInterruptStop ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "Control-C raises KeyboardInterrupt in the running program, which stops it unless a handler catches the exception."@en .

chx:X_LazyRange a chx:LazyRange,
        owl:NamedIndividual ;
    rdfs:label "range(10)"@en ;
    rd:hasIOExample chx:IO_LazyRange ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A range is an object that produces its values when iterated, not a list holding them."@en .

chx:X_ListValue a chx:ListValue,
        owl:NamedIndividual ;
    rdfs:label "[10, 20, 30]"@en ;
    rd:hasIOExample chx:IO_ListValue ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A list is a mutable sequence written between square brackets; its items can be replaced, added and removed."@en .

chx:X_Loop a chx:Loop,
        owl:NamedIndividual ;
    rdfs:label "the if and while versions of the same block"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A loop is a block that Python runs repeatedly: at the end of the block, execution jumps back to the start instead of moving on."@en .

chx:X_LoopElseClause a chx:LoopElseClause,
        owl:NamedIndividual ;
    rdfs:label "for ... else:"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "An else clause on a loop runs when the loop finishes without executing break."@en .

chx:X_LoopEnding a chx:LoopEnding,
        owl:NamedIndividual ;
    rdfs:label "five ways a loop can end"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A loop ends when its condition is false or its sequence is exhausted (both run the else clause), or when break, return or an unhandled exception leaves it (none run the else clause)."@en .

chx:X_LoopVariableScope a chx:LoopVariableScope,
        owl:NamedIndividual ;
    rdfs:label "the variable after the loop"@en ;
    rd:hasErrorCondition chx:Err_LoopVariableScope ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "The loop variable is overwritten on each pass and is not deleted when the loop ends; after a loop over an empty sequence it was never assigned."@en .

chx:X_ModuleFile a chx:ModuleFile,
        owl:NamedIndividual ;
    rdfs:label "math.__name__"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A module is a file of Python definitions and statements; importing it creates a module object that carries its own name and namespace."@en .

chx:X_ModuleNameClash a chx:ModuleNameClash,
        owl:NamedIndividual ;
    rdfs:label "a script saved as random.py"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A file or variable that has the name of a Python module or built-in function hides the real one and produces confusing errors."@en .

chx:X_ModuleNamespace a chx:ModuleNamespace,
        owl:NamedIndividual ;
    rdfs:label "math.sqrt(16)"@en ;
    rd:hasErrorCondition chx:Err_ModuleNamespace ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "Every module keeps its names in its own namespace; a dotted name such as random.randint reaches into it."@en .

chx:X_ModuleSearchPath a chx:ModuleSearchPath,
        owl:NamedIndividual ;
    rdfs:label "sys.path"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "Python looks for an imported module first in a cache of loaded modules and among the built-in modules, then in the directories listed in sys.path, beginning with the script's directory."@en .

chx:X_MultipleImport a chx:MultipleImport,
        owl:NamedIndividual ;
    rdfs:label "import random, sys, os, math"@en ;
    chx:hasOwner chx:X_ImportStatement ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "One import statement can name several modules separated by commas."@en .

chx:X_MutationWhileIterating a chx:MutationWhileIterating,
        owl:NamedIndividual ;
    rdfs:label "for user in users: del users[user]"@en ;
    rd:hasErrorCondition chx:Err_MutationWhileIterating ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "Changing a collection while iterating over it is tricky to get right; loop over a copy or build a new collection."@en .

chx:X_NestedLoop a chx:NestedLoop,
        owl:NamedIndividual ;
    rdfs:label "a while loop inside a while loop"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A loop placed in the block of another loop: the inner loop runs completely on every iteration of the outer one, and break leaves only the inner loop."@en .

chx:X_RandomModule a chx:RandomModule,
        owl:NamedIndividual ;
    rdfs:label "random.randint(1, 20)"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "random.randint(a, b) returns a pseudo-random integer N with a <= N <= b, both ends included."@en .

chx:X_RangeDescending a chx:RangeDescending,
        owl:NamedIndividual ;
    rdfs:label "range(5, -1, -1)"@en ;
    rd:hasIOExample chx:IO_RangeDescending ;
    chx:hasOwner chx:X_RangeStep ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A negative step counts down, and the stop value is still excluded."@en .

chx:X_RangeOperations a chx:RangeOperations,
        owl:NamedIndividual ;
    rdfs:label "range(0, 20, 2)[5]"@en ;
    rd:hasIOExample chx:IO_RangeOperations ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A range supports length, membership tests, indexing, slicing and index lookup, but not concatenation or repetition."@en .

chx:X_RangeStartStop a chx:RangeStartStop,
        owl:NamedIndividual ;
    rdfs:label "range(12, 16)"@en ;
    rd:hasIOExample chx:IO_RangeStartStop ;
    chx:hasOwner chx:X_RangeStop ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "range(start, stop) begins at start and ends before stop."@en .

chx:X_ReturnFromLoop a chx:ReturnFromLoop,
        owl:NamedIndividual ;
    rdfs:label "return inside a for loop"@en ;
    rd:hasErrorCondition chx:Err_ReturnFromLoop ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A return statement leaves the function that contains it, and with it any loop that is running inside the function."@en .

chx:X_RockPaperScissors a chx:RockPaperScissors,
        owl:NamedIndividual ;
    rdfs:label "rpsGame.py"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A program built from two nested while True loops: an input loop that keeps asking until the move is valid, and a main loop that plays one game per iteration."@en .

chx:X_SequenceKind a chx:SequenceKind,
        owl:NamedIndividual ;
    rdfs:label "'hello'[1]"@en ;
    rd:hasIOExample chx:IO_SequenceKind ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A sequence is an ordered collection whose members are reached by integer position, counted from 0, and which has a length."@en .

chx:X_StandardLibrary a chx:StandardLibrary,
        owl:NamedIndividual ;
    rdfs:label "import math"@en ;
    rd:hasErrorCondition chx:Err_StandardLibrary ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "The standard library is the set of modules that come with Python; the built-in functions need no import, the modules do."@en .

chx:X_StarImport a chx:StarImport,
        owl:NamedIndividual ;
    rdfs:label "from random import *"@en ;
    rd:hasErrorCondition chx:Err_StarImport ;
    chx:hasOwner chx:X_ImportStatement ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "from module import * brings every public name into the program without the module prefix."@en .

chx:X_SyntaxWarning a chx:SyntaxWarning,
        owl:NamedIndividual ;
    rdfs:label "SyntaxWarning: 'break' in a 'finally' block"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A SyntaxWarning is reported while the code is compiled when it is legal but probably wrong; it does not stop the program."@en .

chx:X_SysModule a chx:SysModule,
        owl:NamedIndividual ;
    rdfs:label "sys.exit()"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "The sys module gives a program access to the interpreter: sys.exit() ends it, sys.path lists the module search directories and sys.modules holds the modules already loaded."@en .

chx:X_TargetUnpacking a chx:TargetUnpacking,
        owl:NamedIndividual ;
    rdfs:label "for i, v in enumerate(...):"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A loop variable list receives the parts of each item: a pair is unpacked into two names, and the number of names must match the number of parts."@en .

chx:X_TupleValue a chx:TupleValue,
        owl:NamedIndividual ;
    rdfs:label "(0, 'tic')"@en ;
    rd:hasErrorCondition chx:Err_TupleValue ;
    rd:hasIOExample chx:IO_TupleValue ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A tuple is an immutable sequence of values separated by commas, usually written in parentheses; enumerate and zip produce their pairs as tuples."@en .

chx:X_WhileStatement a chx:WhileStatement,
        owl:NamedIndividual ;
    rdfs:label "while name != 'your name':"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A while statement repeats its block as long as its condition is true, and tests the condition again after every pass."@en .

chx:X_ZipStrict a chx:ZipStrict,
        owl:NamedIndividual ;
    rdfs:label "zip(a, b, strict=True)"@en ;
    rd:hasErrorCondition chx:Err_ZipStrict ;
    rd:hasIOExample chx:IO_ZipStrict ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "zip walks several iterables together; strict=True raises ValueError when their lengths differ instead of stopping at the shortest."@en .

