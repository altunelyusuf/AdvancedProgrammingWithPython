chx:CQ1 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which constructs repeat a block, and what decides when each one stops?"@en .

chx:CQ2 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which concepts reach beyond the 3rd edition into current Python, and on what source?"@en,
        "Which statements leave or skip part of a loop, and what do they leave behind?"@en .

chx:CQ3 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which operations raise an error, and which error with which message?"@en .

chx:CQ4 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which concepts reach beyond the 3rd edition into current Python, and on what source?"@en .

chx:CQ5 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which terms does the chapter use without defining them, and where are they defined here?"@en .

chx:CQs a rd:CompetencyQuestionSet,
        owl:NamedIndividual ;
    rdfs:label "Chapter 3 competency questions"@en ;
    rd:containsCompetencyQuestion chx:CQ1,
        chx:CQ2,
        chx:CQ3,
        chx:CQ4,
        chx:CQ5 .

chx:Env a rd:ResolutionEnvironment,
        owl:NamedIndividual ;
    rdfs:label "CPython 3.12.11 and CPython 3.14.4"@en,
        "CPython 3.14.4"@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py",
        "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch03_corpus_v1_0_0.py" ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (233 checks listed in sen0414_ch03_corpus_v1_0_0.py), executed under CPython 3.12.11 and CPython 3.14.4: identical output where more than one was used."@en,
        "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-25."@en .

chx:Err_Accumulator a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "exec('for num in range(101):\\n    total = total + num') raises NameError: name 'total' is not defined"@en .

chx:Err_BreakStatement a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "exec('break') raises SyntaxError: 'break' outside loop"@en .

chx:Err_ContinueStatement a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "exec('continue') raises SyntaxError: 'continue' not properly in loop"@en .

chx:Err_DictionaryValue a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "{'Ada': 'active'}['Eda'] raises KeyError: 'Eda'"@en .

chx:Err_ExitFunction a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "sys.exit() raises NameError: name 'sys' is not defined"@en .

chx:Err_ImportStatement a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "__import__('no_such_module_x') raises ModuleNotFoundError: No module named 'no_such_module_x'"@en .

chx:Err_IterableObject a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "iter(5) raises TypeError: 'int' object is not iterable"@en .

chx:Err_IteratorObject a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "next([1, 2]) raises TypeError: 'list' object is not an iterator"@en .

chx:Err_LoopVariableScope a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "exec('for j in []:\\n    pass\\nprint(j)') raises NameError: name 'j' is not defined"@en .

chx:Err_ModuleNamespace a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "__import__('math').nope raises AttributeError: module 'math' has no attribute 'nope'"@en .

chx:Err_MutationWhileIterating a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "exec('users = {1: 2}\\nfor u in users:\\n    del users[u]') raises RuntimeError: dictionary changed size during iteration"@en .

chx:Err_RangeStep a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "range(0, 10, 0) raises ValueError: range() arg 3 must not be zero"@en .

chx:Err_RangeStop a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "range(2.5) raises TypeError: 'float' object cannot be interpreted as an integer"@en .

chx:Err_ReturnFromLoop a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "exec('return') raises SyntaxError: 'return' outside function"@en .

chx:Err_StandardLibrary a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "math.sqrt(16) raises NameError: name 'math' is not defined"@en .

chx:Err_StarImport a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "exec('def f():\\n    from math import *') raises SyntaxError: import * only allowed at module level"@en .

chx:Err_TupleValue a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "exec('t = (1, 2)\\nt[0] = 99') raises TypeError: 'tuple' object does not support item assignment"@en .

chx:Err_ZipStrict a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "list(zip('ab', [1], strict=True)) raises ValueError: zip() argument 2 is shorter than argument 1"@en .

chx:IO_Accumulator a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "sum(range(101)) evaluates to 5050"@en ;
    chx:input "sum(range(101))" ;
    chx:output "5050" .

chx:IO_DictionaryValue a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "{'Ada': 'active', 'Can': 'inactive'}['Can'] evaluates to 'inactive'"@en ;
    chx:input "{'Ada': 'active', 'Can': 'inactive'}['Can']" ;
    chx:output "'inactive'" .

chx:IO_EnumerateFunction a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "list(enumerate(['tic', 'tac', 'toe'])) evaluates to [(0, 'tic'), (1, 'tac'), (2, 'toe')]"@en ;
    chx:input "list(enumerate(['tic', 'tac', 'toe']))" ;
    chx:output "[(0, 'tic'), (1, 'tac'), (2, 'toe')]" .

chx:IO_HalfOpenRange a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "len(range(0, 24)) evaluates to 24"@en ;
    chx:input "len(range(0, 24))" ;
    chx:output "24" .

chx:IO_IterableObject a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "list('abc') evaluates to ['a', 'b', 'c']"@en ;
    chx:input "list('abc')" ;
    chx:output "['a', 'b', 'c']" .

chx:IO_IteratorObject a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "next(iter('hello')) evaluates to 'h'"@en ;
    chx:input "next(iter('hello'))" ;
    chx:output "'h'" .

chx:IO_KeyboardInterruptStop a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "issubclass(KeyboardInterrupt, Exception) evaluates to False"@en ;
    chx:input "issubclass(KeyboardInterrupt, Exception)" ;
    chx:output "False" .

chx:IO_LazyRange a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "range(10) evaluates to range(0, 10)"@en ;
    chx:input "range(10)" ;
    chx:output "range(0, 10)" .

chx:IO_ListValue a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "list(range(3)) + [9] evaluates to [0, 1, 2, 9]"@en ;
    chx:input "list(range(3)) + [9]" ;
    chx:output "[0, 1, 2, 9]" .

chx:IO_RangeDescending a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "list(range(5, -1, -1)) evaluates to [5, 4, 3, 2, 1, 0]"@en ;
    chx:input "list(range(5, -1, -1))" ;
    chx:output "[5, 4, 3, 2, 1, 0]" .

chx:IO_RangeOperations a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "range(0, 20, 2)[5] evaluates to 10"@en ;
    chx:input "range(0, 20, 2)[5]" ;
    chx:output "10" .

chx:IO_RangeStartStop a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "list(range(12, 16)) evaluates to [12, 13, 14, 15]"@en ;
    chx:input "list(range(12, 16))" ;
    chx:output "[12, 13, 14, 15]" .

chx:IO_RangeStep a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "list(range(0, 10, 2)) evaluates to [0, 2, 4, 6, 8]"@en ;
    chx:input "list(range(0, 10, 2))" ;
    chx:output "[0, 2, 4, 6, 8]" .

chx:IO_RangeStop a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "list(range(5)) evaluates to [0, 1, 2, 3, 4]"@en ;
    chx:input "list(range(5))" ;
    chx:output "[0, 1, 2, 3, 4]" .

chx:IO_SequenceKind a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "'hello'[1] evaluates to 'e'"@en ;
    chx:input "'hello'[1]" ;
    chx:output "'e'" .

chx:IO_TupleValue a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "tuple(range(3)) evaluates to (0, 1, 2)"@en ;
    chx:input "tuple(range(3))" ;
    chx:output "(0, 1, 2)" .

chx:IO_ZipStrict a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "list(zip('ab', [1, 2], strict=True)) evaluates to [('a', 1), ('b', 2)]"@en ;
    chx:input "list(zip('ab', [1, 2], strict=True))" ;
    chx:output "[('a', 1), ('b', 2)]" .

chx:Provenance a rd:ResearchSubjectInput,
        owl:NamedIndividual ;
    rdfs:label "Derived from the chapter 3 research artefact"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 3 through the Stage 1 research artefact; the loop mechanics, the module background and the modern-practice branch are drawn from that artefact's secondary sources (the Python documentation and PEPs), not from the book."@en,
        "Concepts are corpus-derived from the 3rd edition's chapter 3 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en .

chx:X_ForStatement a chx:ForStatement,
        owl:NamedIndividual ;
    rdfs:label "for i in range(5):"@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A for statement takes each item of an iterable in turn, assigns it to its variable and runs the block once for each."@en .

chx:X_IterableObject a chx:IterableObject,
        owl:NamedIndividual ;
    rdfs:label "for ch in 'abc':"@en ;
    rd:hasErrorCondition chx:Err_IterableObject ;
    rd:hasIOExample chx:IO_IterableObject ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "An iterable is an object that can return its members one at a time, so it can be the subject of a for loop."@en .

chx:X_RangeStep a chx:RangeStep,
        owl:NamedIndividual ;
    rdfs:label "range(0, 10, 2)"@en ;
    rd:hasErrorCondition chx:Err_RangeStep ;
    rd:hasIOExample chx:IO_RangeStep ;
    chx:hasOwner chx:X_RangeStop ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "A third argument is the step between values."@en .

chx:X_RangeStop a chx:RangeStop,
        owl:NamedIndividual ;
    rdfs:label "range(5)"@en ;
    rd:hasErrorCondition chx:Err_RangeStop ;
    rd:hasIOExample chx:IO_RangeStop ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "range(n) yields the integers from 0 up to but not including n."@en .

chx:X_ImportStatement a chx:ImportStatement,
        owl:NamedIndividual ;
    rdfs:label "import random"@en ;
    rd:hasErrorCondition chx:Err_ImportStatement ;
    dcterms:source <http://example.org/sen0414/ch03/research> ;
    skos:definition "import makes a module's names available under the module's name, as random.randint(1, 10)."@en .

