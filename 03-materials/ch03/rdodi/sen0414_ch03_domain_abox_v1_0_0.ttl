chx:X_WhileStatement a owl:NamedIndividual, chx:WhileStatement ; rdfs:label "while name != 'your name':"@en ; skos:definition "A while statement repeats its block as long as its condition is true, and tests the condition again after every pass."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_InfiniteLoop a owl:NamedIndividual, chx:InfiniteLoop ; rdfs:label "while True:"@en ; skos:definition "A loop whose condition never becomes false runs until something inside it leaves: break, return, sys.exit() or an exception."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_ForStatement a owl:NamedIndividual, chx:ForStatement ; rdfs:label "for i in range(5):"@en ; skos:definition "A for statement takes each item of an iterable in turn, assigns it to its variable and runs the block once for each."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_RangeStop a owl:NamedIndividual, chx:RangeStop ; rdfs:label "range(5)"@en ; skos:definition "range(n) yields the integers from 0 up to but not including n."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:IO_RangeStop a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(5)) evaluates to [0, 1, 2, 3, 4]"@en ; chx:input "list(range(5))" ; chx:output "[0, 1, 2, 3, 4]" .
chx:X_RangeStop rd:hasIOExample chx:IO_RangeStop .
chx:X_RangeStartStop a owl:NamedIndividual, chx:RangeStartStop ; rdfs:label "range(12, 16)"@en ; skos:definition "range(start, stop) begins at start and ends before stop."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:IO_RangeStartStop a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(12, 16)) evaluates to [12, 13, 14, 15]"@en ; chx:input "list(range(12, 16))" ; chx:output "[12, 13, 14, 15]" .
chx:X_RangeStartStop rd:hasIOExample chx:IO_RangeStartStop .
chx:X_RangeStep a owl:NamedIndividual, chx:RangeStep ; rdfs:label "range(0, 10, 2)"@en ; skos:definition "A third argument is the step between values."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:IO_RangeStep a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(0, 10, 2)) evaluates to [0, 2, 4, 6, 8]"@en ; chx:input "list(range(0, 10, 2))" ; chx:output "[0, 2, 4, 6, 8]" .
chx:X_RangeStep rd:hasIOExample chx:IO_RangeStep .
chx:X_RangeDescending a owl:NamedIndividual, chx:RangeDescending ; rdfs:label "range(5, -1, -1)"@en ; skos:definition "A negative step counts down, and the stop value is still excluded."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:IO_RangeDescending a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(5, -1, -1)) evaluates to [5, 4, 3, 2, 1, 0]"@en ; chx:input "list(range(5, -1, -1))" ; chx:output "[5, 4, 3, 2, 1, 0]" .
chx:X_RangeDescending rd:hasIOExample chx:IO_RangeDescending .
chx:X_LazyRange a owl:NamedIndividual, chx:LazyRange ; rdfs:label "range(10)"@en ; skos:definition "A range is an object that produces its values when iterated, not a list holding them."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:IO_LazyRange a owl:NamedIndividual, rd:IOExample ; rdfs:label "range(10) evaluates to range(0, 10)"@en ; chx:input "range(10)" ; chx:output "range(0, 10)" .
chx:X_LazyRange rd:hasIOExample chx:IO_LazyRange .
chx:X_EnumerateFunction a owl:NamedIndividual, chx:EnumerateFunction ; rdfs:label "enumerate(['tic', 'tac', 'toe'])"@en ; skos:definition "enumerate pairs each item with a running count, replacing range(len(a)) when both are needed."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:IO_EnumerateFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(enumerate(['tic', 'tac', 'toe'])) evaluates to [(0, 'tic'), (1, 'tac'), (2, 'toe')]"@en ; chx:input "list(enumerate(['tic', 'tac', 'toe']))" ; chx:output "[(0, 'tic'), (1, 'tac'), (2, 'toe')]" .
chx:X_EnumerateFunction rd:hasIOExample chx:IO_EnumerateFunction .
chx:X_ZipStrict a owl:NamedIndividual, chx:ZipStrict ; rdfs:label "zip(a, b, strict=True)"@en ; skos:definition "zip walks several iterables together; strict=True raises ValueError when their lengths differ instead of stopping at the shortest."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:IO_ZipStrict a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(zip('ab', [1, 2], strict=True)) evaluates to [('a', 1), ('b', 2)]"@en ; chx:input "list(zip('ab', [1, 2], strict=True))" ; chx:output "[('a', 1), ('b', 2)]" .
chx:X_ZipStrict rd:hasIOExample chx:IO_ZipStrict .
chx:X_BreakStatement a owl:NamedIndividual, chx:BreakStatement ; rdfs:label "break"@en ; skos:definition "break ends the innermost enclosing loop at once and skips the loop's else clause."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_ExitFunction a owl:NamedIndividual, chx:ExitFunction ; rdfs:label "sys.exit()"@en ; skos:definition "sys.exit() raises SystemExit, which ends the program unless something intercepts it; finally clauses still run."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_ContinueStatement a owl:NamedIndividual, chx:ContinueStatement ; rdfs:label "continue"@en ; skos:definition "continue skips the rest of the block and goes back to test the condition, or to take the next item."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_LoopElseClause a owl:NamedIndividual, chx:LoopElseClause ; rdfs:label "for ... else:"@en ; skos:definition "An else clause on a loop runs when the loop finishes without executing break."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_LoopVariableScope a owl:NamedIndividual, chx:LoopVariableScope ; rdfs:label "the variable after the loop"@en ; skos:definition "The loop variable is overwritten on each pass and is not deleted when the loop ends; after a loop over an empty sequence it was never assigned."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_ImportStatement a owl:NamedIndividual, chx:ImportStatement ; rdfs:label "import random"@en ; skos:definition "import makes a module's names available under the module's name, as random.randint(1, 10)."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_MultipleImport a owl:NamedIndividual, chx:MultipleImport ; rdfs:label "import random, sys, os, math"@en ; skos:definition "One import statement can name several modules separated by commas."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_StarImport a owl:NamedIndividual, chx:StarImport ; rdfs:label "from random import *"@en ; skos:definition "from module import * brings every public name into the program without the module prefix."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_AssignmentExpressionLoop a owl:NamedIndividual, chx:AssignmentExpressionLoop ; rdfs:label "while chunk := file.read(8192):"@en ; skos:definition "An assignment expression names a value inside a condition, so a loop can read and test in one line."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_ImportStyle a owl:NamedIndividual, chx:ImportStyle ; rdfs:label "import os on one line, import sys on the next"@en ; skos:definition "PEP 8 advises one import per line and against wildcard imports."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_MutationWhileIterating a owl:NamedIndividual, chx:MutationWhileIterating ; rdfs:label "for user in users: del users[user]"@en ; skos:definition "Changing a collection while iterating over it is tricky to get right; loop over a copy or build a new collection."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:X_FinallyExit a owl:NamedIndividual, chx:FinallyExit ; rdfs:label "break inside a finally block"@en ; skos:definition "Python 3.14 emits a SyntaxWarning when return, break or continue leaves a finally block."@en ; dcterms:source <http://example.org/sen0414/ch03/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 3 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch03/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 3 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which constructs repeat a block, and what decides when each one stops?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which concepts reach beyond the 3rd edition into current Python, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 3 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 3 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch03/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-28."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

