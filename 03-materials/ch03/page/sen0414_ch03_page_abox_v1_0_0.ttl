pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Chapter 3 interactive page"@en ;
    dcterms:source <http://example.org/sen0414/ch03/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 ;
    sen0414:navigationRule "BP-D34: 37 sections falls in 26-50, so a grouped permanent top bar with a sub-section sidebar; the named single flowing anchor-page variation of procedure v1.6.0 section 5.3." ;
    sen0414:pythonUsed "Python 3.14.4" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Sidebar and main content"@en .
pg:Header a ipo:Header ; rdfs:label "Sticky header with grouped section bar"@en .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Section tree"@en .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Grouped permanent top bar"@en .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 3 Stage 3 document"@en ; dcterms:source <http://example.org/sen0414/ch03/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Trace a while or for loop pass by pass, including break, continue and the loop else"@en ; ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Choose between while and for, and between range, enumerate and zip, for a given repetition"@en ; ld:bloomLevel ld:Analyze  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Predict the values range() makes from one, two and three arguments, and explain why a range is not a list"@en ; ld:bloomLevel ld:Understand  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Use the import forms and sys.exit() correctly, and justify the import style PEP 8 recommends"@en ; ld:bloomLevel ld:Apply  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does list(range(5, -1, -1)) produce?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "The stop value -1 is excluded, but 0 comes before it when counting down, so 0 is included." ; ld:distractorRationale "A negative step counts down, so the range is not empty when the start is above the stop." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "[5, 4, 3, 2, 1, 0]" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "[5, 4, 3, 2, 1]" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "[]" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "When does the else clause of a for or while loop run?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "A loop can have an else clause." ; ld:distractorRationale "It runs after a full loop too; running zero times is just one way of finishing without a break." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "Never; else belongs only to if" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "When the loop finishes without executing break" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "Only when the loop ran zero times" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What is the value of i after for i in range(3): pass?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O2 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "Names in the target list are not deleted when the loop ends." ; ld:distractorRationale "range(3) stops before 3, so the last value assigned is 2." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "It no longer exists" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "3" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "2" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does list(zip('abc', [1, 2], strict=True)) do?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "That is what zip does by default, stopping at the shortest; strict=True changes it." ; ld:distractorRationale "zip never pads with None; itertools.zip_longest does." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "Raises ValueError, because the lengths differ" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "Returns [('a', 1), ('b', 2)]" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "Returns [('a', 1), ('b', 2), ('c', None)]" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which import style does PEP 8 advise against?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "That is the style PEP 8 recommends: imports on separate lines." ; ld:distractorRationale "A plain import is fine; it keeps every name under its module's name." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "import os on one line and import sys on the next" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "from random import *" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "import random" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "You need each item of a list together with its position. Which loop is the best fit?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O2 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "It works, but enumerate gives position and item directly, as the tutorial advises." ; ld:distractorRationale "It needs a counter you must remember to update, an easy way to write an endless loop." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "for i in range(len(a)):" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "while i < len(a):" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "for i, x in enumerate(a):" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A program calls sys.exit() inside a try block that has a finally clause. What happens?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "sys.exit() raises SystemExit, and finally clauses are honored as the exception passes." ; ld:distractorRationale "sys.exit() only raises an exception; it can be called anywhere." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "The program exits at once and the finally clause is skipped" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "The finally clause still runs, and then the program exits" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "sys.exit() only works outside try blocks" .
