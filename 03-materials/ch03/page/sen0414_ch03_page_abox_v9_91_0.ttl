pg:CE_01 a ipo:CodeExample ; rdfs:label "while repeats while its test is true"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 6 of the deck and runs 5 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 6 ; sen0414:orderInTab 1 ;
    sen0414:code "spam = 0\nwhile spam < 5:\n    print('pass', spam, 'spam < 5 is', spam < 5)\n    spam = spam + 1\nprint('stop: spam is', spam, 'and spam < 5 is', spam < 5)" ; sen0414:expectedOutput "pass 0 spam < 5 is True\npass 1 spam < 5 is True\npass 2 spam < 5 is True\npass 3 spam < 5 is True\npass 4 spam < 5 is True\nstop: spam is 5 and spam < 5 is False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "An accumulator adds 1 to 100"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 7 of the deck and runs 7 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 2 ;
    sen0414:code "total, n, steps = 0, 1, []\nwhile n <= 100:\n    total = total + n\n    if n % 20 == 0:\n        steps.append(total)\n    n = n + 1\nprint(total, 100 * 101 // 2, steps)" ; sen0414:expectedOutput "5050 5050 [210, 820, 1830, 3240, 5050]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "while True leaves with break"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 9 of the deck and runs 7 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 3 ;
    sen0414:code "answers = iter(['', 'Al', 'Alice'])\nwhile True:\n    name = next(answers)\n    print('typed', repr(name), '- is it Alice?', name == 'Alice')\n    if name == 'Alice':\n        break\nprint('Welcome,', name)" ; sen0414:expectedOutput "typed '' - is it Alice? False\ntyped 'Al' - is it Alice? False\ntyped 'Alice' - is it Alice? True\nWelcome, Alice\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "continue returns to the test"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 10 of the deck and runs 8 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 4 ;
    sen0414:code "n, shown, skipped = 0, [], []\nwhile n < 8:\n    n = n + 1\n    if n % 2 == 0:\n        skipped.append(n)\n        continue\n    shown.append(n)\nprint('shown', shown, 'skipped', skipped)" ; sen0414:expectedOutput "shown [1, 3, 5, 7] skipped [2, 4, 6, 8]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "The walrus names a value in the test"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 11 of the deck and runs 5 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 11 ; sen0414:orderInTab 5 ;
    sen0414:code "import io\nf = io.StringIO('Loops repeat work.')\nwhile chunk := f.read(5):\n    print(repr(chunk))\nprint(repr(f.read(5)), bool(''))" ; sen0414:expectedOutput "'Loops'\n' repe'\n'at wo'\n'rk.'\n'' False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "for takes the values of range(5)"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 15 of the deck and runs 5 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 15 ; sen0414:orderInTab 6 ;
    sen0414:code "total = 0\nfor i in range(5):\n    total = total + i\n    print('i is', i, 'total is', total)\nprint('after the loop i is still', i)" ; sen0414:expectedOutput "i is 0 total is 0\ni is 1 total is 1\ni is 2 total is 3\ni is 3 total is 6\ni is 4 total is 10\nafter the loop i is still 4\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "range(start, stop, step)"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 16 of the deck and runs 3 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 7 ;
    sen0414:code "print(list(range(5)), list(range(2, 8)))\nprint(list(range(0, 10, 3)), list(range(5, 0, -2)))\nprint(list(range(0, 3)) + list(range(3, 7)) == list(range(7)))" ; sen0414:expectedOutput "[0, 1, 2, 3, 4] [2, 3, 4, 5, 6, 7]\n[0, 3, 6, 9] [5, 3, 1]\nTrue\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "range is lazy"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 18 of the deck and runs 4 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 18 ; sen0414:orderInTab 8 ;
    sen0414:code "r = range(10 ** 9)\nprint(len(r), r[999999999])\nprint(123456789 in r, r[:3])\nprint(r, type(r).__name__)" ; sen0414:expectedOutput "1000000000 999999999\nTrue range(0, 3)\nrange(0, 1000000000) range\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "for visits a list and a tuple"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 21 of the deck and runs 6 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 21 ; sen0414:orderInTab 9 ;
    sen0414:code "pets = ['cat', 'tiger', 'owl']\nfor pet in pets:\n    print(pet.upper(), len(pet))\npoint = (3, 4)\nfor coordinate in point:\n    print(coordinate * 2)" ; sen0414:expectedOutput "CAT 3\nTIGER 5\nOWL 3\n6\n8\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "for visits a dictionary"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 22 of the deck and runs 4 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 10 ;
    sen0414:code "ages = {'cat': 4, 'dog': 7, 'owl': 2}\nfor name, age in ages.items():\n    print(name, 'is', age)\nprint(sum(ages.values()), list(ages))" ; sen0414:expectedOutput "cat is 4\ndog is 7\nowl is 2\n13 ['cat', 'dog', 'owl']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "enumerate and zip"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 23 of the deck and runs 6 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 11 ;
    sen0414:code "names = ['ann', 'bo', 'cy']\nscores = [90, 75, 82]\nfor i, name in enumerate(names, start=1):\n    print(i, name)\nfor name, score in zip(names, scores):\n    print(name, score)" ; sen0414:expectedOutput "1 ann\n2 bo\n3 cy\nann 90\nbo 75\ncy 82\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "zip checks lengths with strict"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 24 of the deck and runs 6 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 12 ;
    sen0414:code "try:\n    for a, b in zip([1, 2, 3], ['x', 'y'], strict=True):\n        print(a, b)\nexcept ValueError as err:\n    print('ValueError:', err)\nprint(list(zip([1, 2, 3], ['x', 'y'])))" ; sen0414:expectedOutput "1 x\n2 y\nValueError: zip() argument 2 is shorter than argument 1\n[(1, 'x'), (2, 'y')]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "iter and next under every for"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 25 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 13 ;
    sen0414:code "it = iter(['a', 'b'])\nprint(next(it), next(it))\ntry:\n    next(it)\nexcept StopIteration:\n    print('exhausted')\nprint(iter(it) is it, iter([1]) is [1])" ; sen0414:expectedOutput "a b\nexhausted\nTrue False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "else on a loop runs without break"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 26 of the deck and runs 7 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 14 ;
    sen0414:code "for nums in ([3, 5, 8], [3, 5]):\n    for n in nums:\n        if n % 2 == 0:\n            print(nums, 'first even', n)\n            break\n    else:\n        print(nums, 'no even number')" ; sen0414:expectedOutput "[3, 5, 8] first even 8\n[3, 5] no even number\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "import random with a seed"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 29 of the deck and runs 6 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 15 ;
    sen0414:code "import random\nrandom.seed(42)\nrolls = []\nfor _ in range(6):\n    rolls.append(random.randint(1, 6))\nprint(rolls, random.__name__, type(random).__name__)" ; sen0414:expectedOutput "[6, 1, 1, 6, 3, 2] random module\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "import forms and namespaces"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 30 of the deck and runs 7 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 30 ; sen0414:orderInTab 16 ;
    sen0414:code "import math\nfrom math import sqrt as root\nprint(math.sqrt(16), root(16))\ntry:\n    sqrt(16)\nexcept NameError as err:\n    print('NameError:', err)" ; sen0414:expectedOutput "4.0 4.0\nNameError: name 'sqrt' is not defined\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "A module that cannot be found"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 31 of the deck and runs 6 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 31 ; sen0414:orderInTab 17 ;
    sen0414:code "import sys\nprint(type(sys.path).__name__, len(sys.path) > 0)\ntry:\n    import nosuchmodule\nexcept ModuleNotFoundError as err:\n    print(type(err).__name__, '-', err)" ; sen0414:expectedOutput "list True\nModuleNotFoundError - No module named 'nosuchmodule'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "sys.exit raises SystemExit"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 33 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 33 ; sen0414:orderInTab 18 ;
    sen0414:code "import sys\ntry:\n    print('working')\n    sys.exit(3)\n    print('never printed')\nexcept SystemExit as err:\n    print('SystemExit with code', err.code)\nfinally:\n    print('finally still runs')" ; sen0414:expectedOutput "working\nSystemExit with code 3\nfinally still runs\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "Guess the Number: the loop"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 36 of the deck and runs 10 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 36 ; sen0414:orderInTab 19 ;
    sen0414:code "import random\nrandom.seed(7)\nsecret = random.randint(1, 20)\nguesses = iter([10, 15, 12, 11])\nfor taken in range(1, 7):\n    guess = next(guesses)\n    if guess == secret:\n        break\n    print(guess, 'low' if guess < secret else 'high')\nprint('stopped after', taken, 'guesses; secret', secret)" ; sen0414:expectedOutput "10 low\n15 high\n12 high\nstopped after 4 guesses; secret 11\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "Guess the Number: win or lose"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 37 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 20 ;
    sen0414:code "secret = 11\nfor guesses in ([10, 15, 12, 11], [1, 2, 3, 4, 5, 6]):\n    for taken, guess in enumerate(guesses, start=1):\n        if guess == secret:\n            print('Good job! You got it in', taken, 'guesses.')\n            break\n    else:\n        print('Nope. The number was', secret)" ; sen0414:expectedOutput "Good job! You got it in 4 guesses.\nNope. The number was 11\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "Rock, Paper, Scissors: one round"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 38 of the deck and runs 9 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 38 ; sen0414:orderInTab 21 ;
    sen0414:code "beats = {'r': 's', 'p': 'r', 's': 'p'}\nplayer, computer = 'p', 'r'\nif player == computer:\n    result = 'tie'\nelif beats[player] == computer:\n    result = 'win'\nelse:\n    result = 'lose'\nprint(player, 'vs', computer, '->', result)" ; sen0414:expectedOutput "p vs r -> win\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
pg:CE_22 a ipo:CodeExample ; rdfs:label "Rock, Paper, Scissors: keeping score"@en ;
    skos:definition "Example 22 of the chapter-code tab comes from slide 39 of the deck and runs 9 lines of Python that print 7 lines of output."@en ; dcterms:source "03-materials/ch03/page/chapter_code_ch03_v1_1_0.json" ;
    sen0414:slideNumber 39 ; sen0414:orderInTab 22 ;
    sen0414:code "beats = {'r': 's', 'p': 'r', 's': 'p'}\nscore = {'win': 0, 'lose': 0, 'tie': 0}\nfor player, computer in zip('rpsrps', 'rrrprs'):\n    key = 'win' if beats[player] == computer else 'lose'\n    if player == computer:\n        key = 'tie'\n    print(player, 'vs', computer, key)\n    score[key] += 1\nprint(score)" ; sen0414:expectedOutput "r vs r tie\np vs r win\ns vs r lose\nr vs p lose\np vs r win\ns vs s tie\n{'win': 2, 'lose': 2, 'tie': 2}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_22 .
