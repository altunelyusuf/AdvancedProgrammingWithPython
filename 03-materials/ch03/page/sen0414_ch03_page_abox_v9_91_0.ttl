pg:wv_StarImport a ipo:InstructionalWidget ; rdfs:label "StarImport step-through widget"@en ;
    skos:definition "The widget for Star import states that from random import * brings in 26 names and lists a sample of them (Random, SystemRandom, betavariate, binomialvariate), so that the reader sees how many names enter the program with no prefix to say where each came from."@en ; dcterms:source <http://example.org/sen0414/ch03#S_StarImport> ; dcterms:isPartOf pg:StarImport ;
