chx:X_AddressParsing a owl:NamedIndividual, chx:AddressParsing ; rdfs:label "email.utils.parseaddr('Al Sweigart <al@inventwithpython.com>')"@en ; skos:definition "parseaddr splits a header value that holds a display name and an address into the two parts, and formataddr puts them together again, which matters because the sender and recipient attributes of a message keep both."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_AddressParsing a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('email.utils', fromlist=['x']).parseaddr('Al Sweigart <al@inventwithpython.com>') evaluates to ('Al Sweigart', 'al@inventwithpython.com')"@en ; chx:input "__import__('email.utils', fromlist=['x']).parseaddr('Al Sweigart <al@inventwithpython.com>')" ; chx:output "('Al Sweigart', 'al@inventwithpython.com')" .
chx:X_AddressParsing rd:hasIOExample chx:IO_AddressParsing .
chx:X_LegacyMimeClasses a owl:NamedIndividual, chx:LegacyMimeClasses ; rdfs:label "MIMEText('Body', 'plain')"@en ; skos:definition "MIMEText, MIMEMultipart and the other classes of email.mime belong to the older interface with the compat32 policy, which the documentation keeps for existing code; new code uses EmailMessage, whose policy is the current one."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_LegacyMimeClasses a owl:NamedIndividual, rd:IOExample ; rdfs:label "(type(__import__('email.mime.text', fromlist=['MIMEText']).MIMEText('x').policy).__name__, type(__import__('email.message', fromlist=['EmailMessage']).EmailMessage().policy).__name__) evaluates to ('Compat32', 'EmailPolicy')"@en ; chx:input "(type(__import__('email.mime.text', fromlist=['MIMEText']).MIMEText('x').policy).__name__, type(__import__('email.message', fromlist=['EmailMessage']).EmailMessage().policy).__name__)" ; chx:output "('Compat32', 'EmailPolicy')" .
