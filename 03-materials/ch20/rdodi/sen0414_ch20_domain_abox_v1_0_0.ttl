chx:X_GatewayAddress a owl:NamedIndividual, chx:GatewayAddress ; rdfs:label "2125551234@vtext.com"@en ; skos:definition "A text is sent through a gateway by mailing the phone number at the carrier's gateway domain; the subject and body then appear in the text."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_GatewayAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "'%s@%s' % ('2125551234', {'Verizon': 'vtext.com', 'T-Mobile': 'tmomail.net'}['Verizon']) evaluates to '2125551234@vtext.com'"@en ; chx:input "'%s@%s' % ('2125551234', {'Verizon': 'vtext.com', 'T-Mobile': 'tmomail.net'}['Verizon'])" ; chx:output "'2125551234@vtext.com'" .
chx:X_GatewayAddress rd:hasIOExample chx:IO_GatewayAddress .
chx:X_ProviderTable a owl:NamedIndividual, chx:ProviderTable ; rdfs:label "number@txt.att.net, number@tmomail.net, number@vtext.com"@en ; skos:definition "The chapter's table names an SMS gateway, and for most providers a separate MMS gateway, for twelve providers; a provider's address is found by a web search, and the table is a snapshot that goes out of date."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_SmsLengthLimit a owl:NamedIndividual, chx:SmsLengthLimit ; rdfs:label "len(text) <= 160"@en ; skos:definition "A text through an SMS gateway is limited to 160 characters, where the MMS gateway has no character limit and is the route for a photo; a longer message has to be shortened or split by the program."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_SmsLengthLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "[len(p) for p in __import__('textwrap').wrap('The backup finished on all servers and the report is ready. ' * 4, width=160)] evaluates to [158, 80]"@en ; chx:input "[len(p) for p in __import__('textwrap').wrap('The backup finished on all servers and the report is ready. ' * 4, width=160)]" ; chx:output "[158, 80]" .
chx:X_SmsLengthLimit rd:hasIOExample chx:IO_SmsLengthLimit .
chx:X_GatewayDisadvantages a owl:NamedIndividual, chx:GatewayDisadvantages ; rdfs:label "no delivery guarantee, no failure notice, no reply"@en ; skos:definition "Five disadvantages: no guarantee that the text arrives promptly or at all, no way to know it failed, no way for the recipient to reply, a block that may come without a known limit, and no promise that a gateway that works today works tomorrow."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_PaidApiProviders a owl:NamedIndividual, chx:PaidApiProviders ; rdfs:label "a telecom provider's API such as Twilio"@en ; skos:definition "For reliable or bulk texts the chapter points to the API of a telecom service provider such as Twilio, which usually needs a subscription or usage fees and possibly an application, under rules that differ by country."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_TopicAsSecret a owl:NamedIndividual, chx:TopicAsSecret ; rdfs:label "AlSweigartZPgxBQ42"@en ; skos:definition "A topic is the name of a channel: anyone may publish to it and anyone may subscribe, so a topic meant for one person needs a long random suffix and is treated like a password; names are case-sensitive, and a secrets token is the right source of the random part."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_TopicAsSecret a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(__import__('secrets').token_urlsafe(8)) evaluates to 11"@en ; chx:input "len(__import__('secrets').token_urlsafe(8))" ; chx:output "11" .
chx:X_TopicAsSecret rd:hasIOExample chx:IO_TopicAsSecret .
chx:X_SensitiveData a owl:NamedIndividual, chx:SensitiveData ; rdfs:label "never send passwords or card numbers"@en ; skos:definition "A topic is open to whoever learns its name and the service does not say who posted a message, so a notification carries short status text and never a password or a card number."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_PostRequest a owl:NamedIndividual, chx:PostRequest ; rdfs:label "resp = requests.post('https://ntfy.sh/AlSweigartZPgxBQ42', 'Hello, world!')"@en ; skos:definition "A notification is sent by one HTTP POST whose body is the message text, where reading uses GET; in the standard library a request that carries data is a POST and one without is a GET."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_PostRequest a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('urllib.request', fromlist=['x']).Request('https://ntfy.sh/AlSweigartZPgxBQ42', data=b'Hello, world!').get_method(), __import__('urllib.request', fromlist=['x']).Request('https://ntfy.sh/AlSweigartZPgxBQ42').get_method()) evaluates to ('POST', 'GET')"@en ; chx:input "(__import__('urllib.request', fromlist=['x']).Request('https://ntfy.sh/AlSweigartZPgxBQ42', data=b'Hello, world!').get_method(), __import__('urllib.request', fromlist=['x']).Request('https://ntfy.sh/AlSweigartZPgxBQ42').get_method())" ; chx:output "('POST', 'GET')" .
chx:X_PostRequest rd:hasIOExample chx:IO_PostRequest .
chx:X_MessageSizeLimit a owl:NamedIndividual, chx:MessageSizeLimit ; rdfs:label "len(text.encode('utf-8')) <= 4096"@en ; skos:definition "A message may be at most 4,096 bytes, and a byte count is not a character count: a letter outside ASCII such as ı or ş takes two bytes in UTF-8; on the free service at most 250 messages a day may be sent."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_MessageSizeLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(len('Kırmızı alarm'), len('Kırmızı alarm'.encode('utf-8'))) evaluates to (13, 16)"@en ; chx:input "(len('Kırmızı alarm'), len('Kırmızı alarm'.encode('utf-8')))" ; chx:output "(13, 16)" .
chx:X_MessageSizeLimit rd:hasIOExample chx:IO_MessageSizeLimit .
chx:X_MetadataHeaders a owl:NamedIndividual, chx:MetadataHeaders ; rdfs:label "headers={'Title': 'Important: Read this!', 'Tags': 'warning,neutral_face', 'Priority': '5'}"@en ; skos:definition "A title, tags and a priority travel as HTTP headers next to the message text; in the requests library they are a dictionary passed as headers, and in urllib they are a dictionary passed to Request."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_MetadataHeaders a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('urllib.request', fromlist=['x']).Request('https://ntfy.sh/AlSweigartZPgxBQ42', data=b'The rent is too high!', headers={'Title': 'Important: Read this!', 'Tags': 'warning,neutral_face', 'Priority': '5'}).header_items() evaluates to [('Title', 'Important: Read this!'), ('Tags', 'warning,neutral_face'), ('Priority', '5')]"@en ; chx:input "__import__('urllib.request', fromlist=['x']).Request('https://ntfy.sh/AlSweigartZPgxBQ42', data=b'The rent is too high!', headers={'Title': 'Important: Read this!', 'Tags': 'warning,neutral_face', 'Priority': '5'}).header_items()" ; chx:output "[('Title', 'Important: Read this!'), ('Tags', 'warning,neutral_face'), ('Priority', '5')]" .
chx:X_MetadataHeaders rd:hasIOExample chx:IO_MetadataHeaders .
chx:X_PriorityLevels a owl:NamedIndividual, chx:PriorityLevels ; rdfs:label "Priority: 5"@en ; skos:definition "A priority is a whole number from 1 (min) to 5 (max) with 3 as the default; a higher priority does not deliver faster, it only lets a subscriber choose which messages make a sound."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_PriorityLevels a owl:NamedIndividual, rd:IOExample ; rdfs:label "dict(zip(range(1, 6), ['min', 'low', 'default', 'high', 'max'])) evaluates to {1: 'min', 2: 'low', 3: 'default', 4: 'high', 5: 'max'}"@en ; chx:input "dict(zip(range(1, 6), ['min', 'low', 'default', 'high', 'max']))" ; chx:output "{1: 'min', 2: 'low', 3: 'default', 4: 'high', 5: 'max'}" .
chx:X_PriorityLevels rd:hasIOExample chx:IO_PriorityLevels .
chx:X_HeaderEncoding a owl:NamedIndividual, chx:HeaderEncoding ; rdfs:label "Title: =?utf-8?b?...?="@en ; skos:definition "HTTP libraries send header values as Latin-1, so a title with a letter outside it fails; an RFC 2047 encoded word, which email.header.Header makes, is plain ASCII and is accepted by ntfy."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_HeaderEncoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('email.header', fromlist=['x']).Header('Şifre', 'utf-8').encode() evaluates to '=?utf-8?b?xZ5pZnJl?='"@en ; chx:input "__import__('email.header', fromlist=['x']).Header('Şifre', 'utf-8').encode()" ; chx:output "'=?utf-8?b?xZ5pZnJl?='" .
chx:X_HeaderEncoding rd:hasIOExample chx:IO_HeaderEncoding .
chx:X_ResponseStatus a owl:NamedIndividual, chx:ResponseStatus ; rdfs:label "<Response [200]> and <Response [403]>"@en ; skos:definition "The number in a response says what happened: 200 for accepted, 403 when a reserved topic refuses the sender; the standard library names the codes in http.HTTPStatus."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_ResponseStatus a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('http').HTTPStatus(200).phrase, __import__('http').HTTPStatus(403).phrase) evaluates to ('OK', 'Forbidden')"@en ; chx:input "(__import__('http').HTTPStatus(200).phrase, __import__('http').HTTPStatus(403).phrase)" ; chx:output "('OK', 'Forbidden')" .
chx:X_ResponseStatus rd:hasIOExample chx:IO_ResponseStatus .
chx:X_StructuredPayload a owl:NamedIndividual, chx:StructuredPayload ; rdfs:label "json.dumps({'to': 'Yusuf', 'from': 'backup', 'text': 'done'})"@en ; skos:definition "The service does not tell who posted a message, so a sender and a recipient are written into the text itself, best as JSON so that a receiving program can read the parts."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_StructuredPayload a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('json').loads(__import__('json').dumps({'to': 'Yusuf', 'from': 'backup', 'text': 'done'}))['from'] evaluates to 'backup'"@en ; chx:input "__import__('json').loads(__import__('json').dumps({'to': 'Yusuf', 'from': 'backup', 'text': 'done'}))['from']" ; chx:output "'backup'" .
chx:X_StructuredPayload rd:hasIOExample chx:IO_StructuredPayload .
chx:X_PollRequest a owl:NamedIndividual, chx:PollRequest ; rdfs:label "resp = requests.get('https://ntfy.sh/AlSweigartZPgxBQ42/json?poll=1')"@en ; skos:definition "A GET to the topic's /json address with poll=1 returns every message the server still holds and ends the connection; the options after the question mark are a query string that urllib.parse can take apart."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_PollRequest a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('urllib.parse', fromlist=['x']).parse_qs(__import__('urllib.parse', fromlist=['x']).urlsplit('https://ntfy.sh/AlSweigartZPgxBQ42/json?poll=1&since=10m').query) evaluates to {'poll': ['1'], 'since': ['10m']}"@en ; chx:input "__import__('urllib.parse', fromlist=['x']).parse_qs(__import__('urllib.parse', fromlist=['x']).urlsplit('https://ntfy.sh/AlSweigartZPgxBQ42/json?poll=1&since=10m').query)" ; chx:output "{'poll': ['1'], 'since': ['10m']}" .
chx:X_PollRequest rd:hasIOExample chx:IO_PollRequest .
chx:X_SinceParameter a owl:NamedIndividual, chx:SinceParameter ; rdfs:label "/json?poll=1&since=wZ22cjyKXw1F"@en ; skos:definition "A since option limits the poll to messages after a time span, a Unix timestamp or a message id; urllib.parse.urlencode builds the query string and separates options with an ampersand."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_SinceParameter a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('urllib.parse', fromlist=['x']).urlencode({'poll': 1, 'since': 'wZ22cjyKXw1F'}) evaluates to 'poll=1&since=wZ22cjyKXw1F'"@en ; chx:input "__import__('urllib.parse', fromlist=['x']).urlencode({'poll': 1, 'since': 'wZ22cjyKXw1F'})" ; chx:output "'poll=1&since=wZ22cjyKXw1F'" .
chx:X_SinceParameter rd:hasIOExample chx:IO_SinceParameter .
chx:X_LineJsonParsing a owl:NamedIndividual, chx:LineJsonParsing ; rdfs:label "for json_text in resp.text.splitlines(): json.loads(json_text)"@en ; skos:definition "The response is one JSON object per line, which as a whole is not valid JSON, so the text is split into lines and each line is parsed by json.loads into a dictionary."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_LineJsonParsing a owl:NamedIndividual, rd:IOExample ; rdfs:label "[__import__('json').loads(l)['message'] for l in '''{'id':'1jnHKeFNqwnS','time':1797823340,'event':'message','message':'Hello, world!'}\\n{'id':'wZ22cjyKXw1F','time':1797823712,'event':'message','title':'Important: Read this!','message':'The rent is too high!','priority':5}\\n'''.replace(chr(39), chr(34)).splitlines()] evaluates to ['Hello, world!', 'The rent is too high!']"@en ; chx:input "[__import__('json').loads(l)['message'] for l in '''{'id':'1jnHKeFNqwnS','time':1797823340,'event':'message','message':'Hello, world!'}\\n{'id':'wZ22cjyKXw1F','time':1797823712,'event':'message','title':'Important: Read this!','message':'The rent is too high!','priority':5}\\n'''.replace(chr(39), chr(34)).splitlines()]" ; chx:output "['Hello, world!', 'The rent is too high!']" .
chx:X_LineJsonParsing rd:hasIOExample chx:IO_LineJsonParsing .
chx:X_EpochTimestamp a owl:NamedIndividual, chx:EpochTimestamp ; rdfs:label "'time':1797823712"@en ; skos:definition "The time and expires keys are Unix timestamps in seconds; fromtimestamp without a zone shows the clock time of the reading computer, so the same number prints differently in different zones, while a timestamp with a zone argument does not."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_EpochTimestamp a owl:NamedIndividual, rd:IOExample ; rdfs:label "str(__import__('datetime').datetime.fromtimestamp(1797823712, tz=__import__('datetime').timezone.utc)) evaluates to '2026-12-21 03:28:32+00:00'"@en ; chx:input "str(__import__('datetime').datetime.fromtimestamp(1797823712, tz=__import__('datetime').timezone.utc))" ; chx:output "'2026-12-21 03:28:32+00:00'" .
chx:X_EpochTimestamp rd:hasIOExample chx:IO_EpochTimestamp .
chx:X_EventTypes a owl:NamedIndividual, chx:EventTypes ; rdfs:label "if note['event'] == 'message': keep(note)"@en ; skos:definition "Each line has an event key: message for a notification, open and keepalive for the connection, poll_request for a poll, and in the current documentation also message_delete and message_clear; a reading program keeps only the message events."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_EventTypes a owl:NamedIndividual, rd:IOExample ; rdfs:label "[m['message'] for m in map(__import__('json').loads, '''{'id':'a1','event':'open'}\\n{'id':'a2','event':'message','message':'Hello, world!'}\\n{'id':'a3','event':'keepalive'}\\n'''.replace(chr(39), chr(34)).splitlines()) if m['event'] == 'message'] evaluates to ['Hello, world!']"@en ; chx:input "[m['message'] for m in map(__import__('json').loads, '''{'id':'a1','event':'open'}\\n{'id':'a2','event':'message','message':'Hello, world!'}\\n{'id':'a3','event':'keepalive'}\\n'''.replace(chr(39), chr(34)).splitlines()) if m['event'] == 'message']" ; chx:output "['Hello, world!']" .
chx:X_EventTypes rd:hasIOExample chx:IO_EventTypes .
chx:X_OptionalKeys a owl:NamedIndividual, chx:OptionalKeys ; rdfs:label "title = notification.get('title')"@en ; skos:definition "The title, priority and tags keys are present only when the sender set them, so indexing a missing key raises KeyError and get returns a default instead."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_OptionalKeys a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda n: (n.get('title'), n.get('priority', 3)))(__import__('json').loads('''{'id':'1','event':'message','message':'Hello'}'''.replace(chr(39), chr(34)))) evaluates to (None, 3)"@en ; chx:input "(lambda n: (n.get('title'), n.get('priority', 3)))(__import__('json').loads('''{'id':'1','event':'message','message':'Hello'}'''.replace(chr(39), chr(34))))" ; chx:output "(None, 3)" .
chx:X_OptionalKeys rd:hasIOExample chx:IO_OptionalKeys .
chx:X_PollingEtiquette a owl:NamedIndividual, chx:PollingEtiquette ; rdfs:label "since = last_id"@en ; skos:definition "A program that polls should ask once a minute or less often and pass the id of the last message it has handled as since, so that the server returns only what is new."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_PollingEtiquette a owl:NamedIndividual, rd:IOExample ; rdfs:label "[__import__('json').loads(l)['id'] for l in '''{'id':'1jnHKeFNqwnS','time':1797823340,'event':'message','message':'Hello, world!'}\\n{'id':'wZ22cjyKXw1F','time':1797823712,'event':'message','title':'Important: Read this!','message':'The rent is too high!','priority':5}\\n'''.replace(chr(39), chr(34)).splitlines()][-1] evaluates to 'wZ22cjyKXw1F'"@en ; chx:input "[__import__('json').loads(l)['id'] for l in '''{'id':'1jnHKeFNqwnS','time':1797823340,'event':'message','message':'Hello, world!'}\\n{'id':'wZ22cjyKXw1F','time':1797823712,'event':'message','title':'Important: Read this!','message':'The rent is too high!','priority':5}\\n'''.replace(chr(39), chr(34)).splitlines()][-1]" ; chx:output "'wZ22cjyKXw1F'" .
chx:X_PollingEtiquette rd:hasIOExample chx:IO_PollingEtiquette .
chx:X_PracticeQuestions a owl:NamedIndividual, chx:PracticeQuestions ; rdfs:label "ezgmail.search('has:attachment')"@en ; skos:definition "The chapter closes with five practice questions: the credentials and token files, thread against message, finding attachments with a search, the drawbacks of an SMS gateway, and the library that talks to ntfy."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_UmbrellaReminder a owl:NamedIndividual, chx:UmbrellaReminder ; rdfs:label "'rain' in forecast.lower()"@en ; skos:definition "The first practice program reads a forecast early in the morning and sends a text when rain is expected; the test that decides can be written and checked on sample forecast text without any network."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_UmbrellaReminder a owl:NamedIndividual, rd:IOExample ; rdfs:label "[any(w in f.lower() for w in ('rain', 'showers')) for f in ('Sunny, with a high near 75.', 'Showers likely, mainly after 2pm.')] evaluates to [False, True]"@en ; chx:input "[any(w in f.lower() for w in ('rain', 'showers')) for f in ('Sunny, with a high near 75.', 'Showers likely, mainly after 2pm.')]" ; chx:output "[False, True]" .
chx:X_UmbrellaReminder rd:hasIOExample chx:IO_UmbrellaReminder .
chx:X_AutoUnsubscriber a owl:NamedIndividual, chx:AutoUnsubscriber ; rdfs:label "'unsubscribe' in link_text.lower()"@en ; skos:definition "The second program reads the mail, finds links that hold the word unsubscribe and opens them in a browser; the finding can be done with the standard library's HTML parser, and opening the links and completing the forms stays manual."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_CommandByMail a owl:NamedIndividual, chx:CommandByMail ; rdfs:label "if password == 'open-sesame': run(command)"@en ; skos:definition "The third program acts on commands that arrive by mail or as a notification, so the sender is checked by a password in the text, since a From address is easily faked, only listed commands are run, and what was done is logged and confirmed."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_CommandByMail a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('hmac').compare_digest(b'open-sesame', b'open-sesame') evaluates to True"@en ; chx:input "__import__('hmac').compare_digest(b'open-sesame', b'open-sesame')" ; chx:output "True" .
chx:X_CommandByMail rd:hasIOExample chx:IO_CommandByMail .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 20 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch20/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 20 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which parts of sending and reading mail, texts and push notifications can be executed and checked without an account, a phone or a network, and which can only be read from the book and its sources?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which statements of the chapter differ from current documentation or current behaviour, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 20 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 20 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch20/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-01."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

