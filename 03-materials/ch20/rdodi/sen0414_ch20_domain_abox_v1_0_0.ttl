chx:X_OverwriteDefault a owl:NamedIndividual, chx:OverwriteDefault ; rdfs:label "downloadAttachment('tulips.jpg') when tulips.jpg exists"@en ; skos:definition "A file that already has the attachment's name is overwritten without a question, because the file is opened for writing; nothing of the old file remains."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_OverwriteDefault a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda os, tf: (lambda d: (open(os.path.join(d, 'a.txt'), 'wb').write(b'one'), open(os.path.join(d, 'a.txt'), 'wb').write(b'two'), open(os.path.join(d, 'a.txt'), 'rb').read())[2])(tf.mkdtemp()))(__import__('os'), __import__('tempfile')) evaluates to b'two'"@en ; chx:input "(lambda os, tf: (lambda d: (open(os.path.join(d, 'a.txt'), 'wb').write(b'one'), open(os.path.join(d, 'a.txt'), 'wb').write(b'two'), open(os.path.join(d, 'a.txt'), 'rb').read())[2])(tf.mkdtemp()))(__import__('os'), __import__('tempfile'))" ; chx:output "b'two'" .
chx:X_OverwriteDefault rd:hasIOExample chx:IO_OverwriteDefault .
