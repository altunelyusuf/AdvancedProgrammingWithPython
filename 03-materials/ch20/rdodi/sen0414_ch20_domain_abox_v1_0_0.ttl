chx:X_CredentialsAndToken a owl:NamedIndividual, chx:CredentialsAndToken ; rdfs:label "ezgmail.init()"@en ; skos:definition "Reaching Gmail from a program needs two files made once in the Google Cloud console: a credentials file that identifies the program and a token file that records the owner's permission; the token works like a password and must not be shared."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_DryRun a owl:NamedIndividual, chx:DryRun ; rdfs:label "print(message) instead of ezgmail.send(message)"@en ; skos:definition "A dry run replaces the line that sends or deletes with a print, so a program can be tested without touching real mail; a send function passed as an argument makes the switch a one-word change."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_DryRun a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda notify: (notify('Backup finished'), notify('Backup finished', send=str.upper)))(lambda text, send=None: 'DRY RUN: ' + text if send is None else send(text)) evaluates to ('DRY RUN: Backup finished', 'BACKUP FINISHED')"@en ; chx:input "(lambda notify: (notify('Backup finished'), notify('Backup finished', send=str.upper)))(lambda text, send=None: 'DRY RUN: ' + text if send is None else send(text))" ; chx:output "('DRY RUN: Backup finished', 'BACKUP FINISHED')" .
chx:X_DryRun rd:hasIOExample chx:IO_DryRun .
chx:X_SendCall a owl:NamedIndividual, chx:SendCall ; rdfs:label "ezgmail.send('recipient@example.com', 'Subject line', 'Body of the email')"@en ; skos:definition "One call gives recipient, subject and body; the library builds a text message with those header fields and hands it to the Gmail API, and the sender argument is ignored because Gmail uses the account's own address."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_SendCall a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda m: (m.__setitem__('to', 'recipient@example.com'), m.__setitem__('subject', 'Subject line'), (m['To'], m['Subject'], m.get_content_type(), m.get_payload()))[2])(__import__('email.mime.text', fromlist=['MIMEText']).MIMEText('Body of the email', 'plain')) evaluates to ('recipient@example.com', 'Subject line', 'text/plain', 'Body of the email')"@en ; chx:input "(lambda m: (m.__setitem__('to', 'recipient@example.com'), m.__setitem__('subject', 'Subject line'), (m['To'], m['Subject'], m.get_content_type(), m.get_payload()))[2])(__import__('email.mime.text', fromlist=['MIMEText']).MIMEText('Body of the email', 'plain'))" ; chx:output "('recipient@example.com', 'Subject line', 'text/plain', 'Body of the email')" .
chx:X_SendCall rd:hasIOExample chx:IO_SendCall .
chx:X_AttachmentSend a owl:NamedIndividual, chx:AttachmentSend ; rdfs:label "ezgmail.send(to, subject, body, ['attachment1.jpg'])"@en ; skos:definition "An extra list of file names makes the message a multipart one with the text as its first part and each file as a further part that carries the file's name."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_AttachmentSend a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda m: (m.set_content('Body'), m.add_attachment(b'xyz', maintype='application', subtype='octet-stream', filename='notes.bin'), [p.get_content_type() for p in m.walk()], [a.get_filename() for a in m.iter_attachments()])[2:])(__import__('email.message', fromlist=['EmailMessage']).EmailMessage()) evaluates to (['multipart/mixed', 'text/plain', 'application/octet-stream'], ['notes.bin'])"@en ; chx:input "(lambda m: (m.set_content('Body'), m.add_attachment(b'xyz', maintype='application', subtype='octet-stream', filename='notes.bin'), [p.get_content_type() for p in m.walk()], [a.get_filename() for a in m.iter_attachments()])[2:])(__import__('email.message', fromlist=['EmailMessage']).EmailMessage())" ; chx:output "(['multipart/mixed', 'text/plain', 'application/octet-stream'], ['notes.bin'])" .
chx:X_AttachmentSend rd:hasIOExample chx:IO_AttachmentSend .
chx:X_CcBccFields a owl:NamedIndividual, chx:CcBccFields ; rdfs:label "ezgmail.send(to, subject, body, cc='a@example.com', bcc='b@example.com,c@example.com')"@en ; skos:definition "The cc and bcc keyword arguments are strings of comma-separated addresses that become header fields of the message; splitting such a string into single addresses is done by email.utils.getaddresses."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_CcBccFields a owl:NamedIndividual, rd:IOExample ; rdfs:label "[a for _, a in __import__('email.utils', fromlist=['x']).getaddresses(['otherfriend@example.com,someoneelse@example.com'])] evaluates to ['otherfriend@example.com', 'someoneelse@example.com']"@en ; chx:input "[a for _, a in __import__('email.utils', fromlist=['x']).getaddresses(['otherfriend@example.com,someoneelse@example.com'])]" ; chx:output "['otherfriend@example.com', 'someoneelse@example.com']" .
chx:X_CcBccFields rd:hasIOExample chx:IO_CcBccFields .
chx:X_HtmlSubtype a owl:NamedIndividual, chx:HtmlSubtype ; rdfs:label "ezgmail.send(to, subject, body, mimeSubtype='html')"@en ; skos:definition "The mimeSubtype argument is 'plain' by default and 'html' sends the body as HTML; any other string is refused by the library."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_HtmlSubtype a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('email.mime.text', fromlist=['MIMEText']).MIMEText('<b>Hello</b>', 'html').get_content_type() evaluates to 'text/html'"@en ; chx:input "__import__('email.mime.text', fromlist=['MIMEText']).MIMEText('<b>Hello</b>', 'html').get_content_type()" ; chx:output "'text/html'" .
chx:X_HtmlSubtype rd:hasIOExample chx:IO_HtmlSubtype .
chx:X_ThreadVersusMessage a owl:NamedIndividual, chx:ThreadVersusMessage ; rdfs:label "message = ezgmail.unread()[0].messages[0]"@en ; skos:definition "Gmail groups replies into conversation threads; a thread object holds a list of message objects, and ezgmail.unread(), recent() and search() return threads, not single messages."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_MessageAttributes a owl:NamedIndividual, chx:MessageAttributes ; rdfs:label "message.subject, message.sender, message.body"@en ; skos:definition "A message object has subject, sender, recipient, body and timestamp attributes; the sender and recipient keep the display name in front of the address."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_MessageAttributes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda m: (m['subject'], m['from'], m.get_payload()))(__import__('email').message_from_string('From: Al Sweigart <al@inventwithpython.com>\\nTo: Jon Doe <example@gmail.com>\\nSubject: RoboCop\\n\\nDo you want to watch RoboCop this weekend?\\r\\n')) evaluates to ('RoboCop', 'Al Sweigart <al@inventwithpython.com>', 'Do you want to watch RoboCop this weekend?\\r\\n')"@en ; chx:input "(lambda m: (m['subject'], m['from'], m.get_payload()))(__import__('email').message_from_string('From: Al Sweigart <al@inventwithpython.com>\\nTo: Jon Doe <example@gmail.com>\\nSubject: RoboCop\\n\\nDo you want to watch RoboCop this weekend?\\r\\n'))" ; chx:output "('RoboCop', 'Al Sweigart <al@inventwithpython.com>', 'Do you want to watch RoboCop this weekend?\\r\\n')" .
chx:X_MessageAttributes rd:hasIOExample chx:IO_MessageAttributes .
chx:X_InternalDateTimestamp a owl:NamedIndividual, chx:InternalDateTimestamp ; rdfs:label "when = message.timestamp"@en ; skos:definition "Gmail gives a message's date as milliseconds since the Unix epoch; dividing by 1000 and passing the seconds to datetime.fromtimestamp gives a datetime, which without a time zone argument is the clock time of the computer running the program."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_InternalDateTimestamp a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime.fromtimestamp(int('1797823712000') // 1000, tz=__import__('datetime').timezone.utc) evaluates to datetime.datetime(2026, 12, 21, 3, 28, 32, tzinfo=datetime.timezone.utc)"@en ; chx:input "__import__('datetime').datetime.fromtimestamp(int('1797823712000') // 1000, tz=__import__('datetime').timezone.utc)" ; chx:output "datetime.datetime(2026, 12, 21, 3, 28, 32, tzinfo=datetime.timezone.utc)" .
chx:X_InternalDateTimestamp rd:hasIOExample chx:IO_InternalDateTimestamp .
chx:X_SummaryLine a owl:NamedIndividual, chx:SummaryLine ; rdfs:label "ezgmail.summary(unread_threads)"@en ; skos:definition "summary prints one line per thread made of the first names of the senders, the snippet and the month and day of the latest message; a first name is the sender text up to the first space."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_SummaryLine a owl:NamedIndividual, rd:IOExample ; rdfs:label "', '.join(n[:n.find(' ')] for n in ['Al Sweigart <al@inventwithpython.com>', 'Jon Doe <example@gmail.com>']) evaluates to 'Al, Jon'"@en ; chx:input "', '.join(n[:n.find(' ')] for n in ['Al Sweigart <al@inventwithpython.com>', 'Jon Doe <example@gmail.com>'])" ; chx:output "'Al, Jon'" .
chx:X_SummaryLine rd:hasIOExample chx:IO_SummaryLine .
chx:X_SearchOperators a owl:NamedIndividual, chx:SearchOperators ; rdfs:label "found = ezgmail.search('has:attachment')"@en ; skos:definition "search takes the same query text as the Gmail search box, including operators such as label:UNREAD, from:, subject: and has:attachment, and returns threads; recent() and unread() are searches with fixed queries."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_SearchOperators a owl:NamedIndividual, rd:IOExample ; rdfs:label "' '.join(['from:al@inventwithpython.com', 'has:attachment', 'subject:hello']) evaluates to 'from:al@inventwithpython.com has:attachment subject:hello'"@en ; chx:input "' '.join(['from:al@inventwithpython.com', 'has:attachment', 'subject:hello'])" ; chx:output "'from:al@inventwithpython.com has:attachment subject:hello'" .
chx:X_SearchOperators rd:hasIOExample chx:IO_SearchOperators .
chx:X_AttachmentDownload a owl:NamedIndividual, chx:AttachmentDownload ; rdfs:label "message.downloadAllAttachments(downloadFolder='vacation2026')"@en ; skos:definition "A message lists its attachment file names and downloadAttachment or downloadAllAttachments saves them to the current folder or to downloadFolder; the Gmail API delivers the file contents in URL-safe base64."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_AttachmentDownload a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b: b.urlsafe_b64decode(b.urlsafe_b64encode(bytes([251, 255, 254]))) == bytes([251, 255, 254]))(__import__('base64')) evaluates to True"@en ; chx:input "(lambda b: b.urlsafe_b64decode(b.urlsafe_b64encode(bytes([251, 255, 254]))) == bytes([251, 255, 254]))(__import__('base64'))" ; chx:output "True" .
