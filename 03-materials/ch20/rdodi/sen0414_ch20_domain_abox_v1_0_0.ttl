chx:IO_ImapPorts a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.IMAP4_PORT, s.IMAP4_SSL_PORT))(__import__('imaplib')) evaluates to (143, 993)"@en ; chx:input "(lambda s: (s.IMAP4_PORT, s.IMAP4_SSL_PORT))(__import__('imaplib'))" ; chx:output "(143, 993)" .
chx:X_ImapPorts rd:hasIOExample chx:IO_ImapPorts .
chx:X_SendMessageMethod a owl:NamedIndividual, chx:SendMessageMethod ; rdfs:label "server.send_message(msg)"@en ; skos:definition "send_message takes a message object, reads the sender and the recipients from its From, To, Cc and Bcc fields and sends the text without the Bcc field, so blind copies are delivered but not shown."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_EmailMessageClass a owl:NamedIndividual, chx:EmailMessageClass ; rdfs:label "msg = EmailMessage(); msg.set_content('Body')"@en ; skos:definition "email.message.EmailMessage is the current class for building and reading messages: fields are set like dictionary entries, set_content sets the body and its type, and add_attachment makes the message multipart."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
