chx:IO_SmtpPorts a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: (s.SMTP_PORT, s.SMTP_SSL_PORT))(__import__('smtplib')) evaluates to (25, 465)"@en ; chx:input "(lambda s: (s.SMTP_PORT, s.SMTP_SSL_PORT))(__import__('smtplib'))" ; chx:output "(25, 465)" .
chx:X_SmtpPorts rd:hasIOExample chx:IO_SmtpPorts .
