chx:X_ReplyThreading a owl:NamedIndividual, chx:ReplyThreading ; rdfs:label "GmailMessage.reply(body)"@en ; skos:definition "GmailMessage.reply posts a message with the original sender as the recipient and the threadId of the original, but with the subject unchanged (RoboCop, no Re:) and without In-Reply-To or References headers, which Google's sending guide names as what makes a message join a thread together with a matching subject; GmailMessage.replyAll made no API call at all and returned None."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_ReplyThreading a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({}, {})\\nm0 = ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Jon Doe <example@gmail.com>\\', \\'RoboCop\\', \\'Do you want to watch RoboCop this weekend?\\', 1797000000000))\\nm0.reply(\\'Yes, Saturday works.\\')\\nbody = json.loads(h.log[0][2]); m = raw_of(h)\\nout = (h.log[0][1], sorted(body), body[\\'threadId\\'], m[\\'to\\'], m[\\'subject\\'], [k for k in m.keys() if k.lower() in (\\'in-reply-to\\', \\'references\\')], ezgmail.GmailMessage.replyAll(m0, \\'x\\'), len(h.log))', g), g['out'])[1])({}) evaluates to ('users/me/messages/send?alt=json', ['raw', 'threadId'], 'T1', 'Al Sweigart <al@inventwithpython.com>', 'RoboCop', [], None, 1)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({}, {})\\nm0 = ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Jon Doe <example@gmail.com>\\', \\'RoboCop\\', \\'Do you want to watch RoboCop this weekend?\\', 1797000000000))\\nm0.reply(\\'Yes, Saturday works.\\')\\nbody = json.loads(h.log[0][2]); m = raw_of(h)\\nout = (h.log[0][1], sorted(body), body[\\'threadId\\'], m[\\'to\\'], m[\\'subject\\'], [k for k in m.keys() if k.lower() in (\\'in-reply-to\\', \\'references\\')], ezgmail.GmailMessage.replyAll(m0, \\'x\\'), len(h.log))', g), g['out'])[1])({})" ; chx:output "('users/me/messages/send?alt=json', ['raw', 'threadId'], 'T1', 'Al Sweigart <al@inventwithpython.com>', 'RoboCop', [], None, 1)" .
