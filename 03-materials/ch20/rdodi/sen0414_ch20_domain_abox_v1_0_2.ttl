chx:X_DmarcRecordParse a owl:NamedIndividual, chx:DmarcRecordParse ; rdfs:label "dig TXT _dmarc.gmail.com"@en ; skos:definition "A DMARC record is tag=value pairs separated by semicolons: the record observed for _dmarc.gmail.com on 2026-10-13 was v=DMARC1; p=none; sp=quarantine; rua=mailto:mailauth-reports@google.com, a policy of none for the domain and quarantine for subdomains, and a stricter sample has p=reject, pct=100, adkim=s and aspf=r; Google's sender guidelines require DMARC from senders of more than 5,000 messages a day."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_DmarcRecordParse a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef tags(txt): return dict(p.strip().split(\\'=\\', 1) for p in txt.split(\\';\\') if \\'=\\' in p)\\nseen = \\'v=DMARC1; p=none; sp=quarantine; rua=mailto:mailauth-reports@google.com\\'\\nstrict = \\'v=DMARC1; p=reject; sp=reject; rua=mailto:reports@example.com; adkim=s; aspf=r; pct=100\\'\\na = tags(seen); b = tags(strict)\\nout = (a[\\'v\\'], a[\\'p\\'], a[\\'sp\\'], a[\\'rua\\'], sorted(a), a.get(\\'pct\\', \\'100\\'), b[\\'p\\'], b[\\'pct\\'], b[\\'adkim\\'], b[\\'aspf\\'], tags(\\'v=DMARC1;p=quarantine;\\')[\\'p\\'])', g), g['out'])[1])({}) evaluates to ('DMARC1', 'none', 'quarantine', 'mailto:mailauth-reports@google.com', ['p', 'rua', 'sp', 'v'], '100', 'reject', '100', 's', 'r', 'quarantine')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef tags(txt): return dict(p.strip().split(\\'=\\', 1) for p in txt.split(\\';\\') if \\'=\\' in p)\\nseen = \\'v=DMARC1; p=none; sp=quarantine; rua=mailto:mailauth-reports@google.com\\'\\nstrict = \\'v=DMARC1; p=reject; sp=reject; rua=mailto:reports@example.com; adkim=s; aspf=r; pct=100\\'\\na = tags(seen); b = tags(strict)\\nout = (a[\\'v\\'], a[\\'p\\'], a[\\'sp\\'], a[\\'rua\\'], sorted(a), a.get(\\'pct\\', \\'100\\'), b[\\'p\\'], b[\\'pct\\'], b[\\'adkim\\'], b[\\'aspf\\'], tags(\\'v=DMARC1;p=quarantine;\\')[\\'p\\'])', g), g['out'])[1])({})" ; chx:output "('DMARC1', 'none', 'quarantine', 'mailto:mailauth-reports@google.com', ['p', 'rua', 'sp', 'v'], '100', 'reject', '100', 's', 'r', 'quarantine')" .
