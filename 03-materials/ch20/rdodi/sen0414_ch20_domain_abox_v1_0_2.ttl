chx:X_JsonLines rd:hasIOExample chx:IO_JsonLines .
chx:X_EventFields a owl:NamedIndividual, chx:EventFields ; rdfs:label "notifications[1]['expires']"@en ; skos:definition "The first message has the keys id, time, expires, event, topic and message and the second adds title, priority 5 and tags; expires minus time is 43200 seconds, 12 hours; the documentation lists the event types open, keepalive, message, message_delete, message_clear and poll_request, 2 more than the chapter's four; and time 1797823712 is 2026-12-21T03:28:32 in UTC."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_EventFields a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nTXT = (\\'{\\x22id\\x22:\\x221jnHKeFNqwnS\\x22,\\x22time\\x22:1797823340,\\x22expires\\x22:1797866540,\\x22event\\x22:\\x22message\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22,\\x22message\\x22:\\x22Hello, world!\\x22}\\\\n\\'\\n       \\'{\\x22id\\x22:\\x22wZ22cjyKXw1F\\x22,\\x22time\\x22:1797823712,\\x22expires\\x22:1797866912,\\x22event\\x22:\\x22message\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22,\\x22title\\x22:\\x22Important: Read this!\\x22,\\x22message\\x22:\\x22The rent is too high!\\x22,\\x22priority\\x22:5,\\x22tags\\x22:[\\x22warning\\x22,\\x22neutral_face\\x22]}\\\\n\\')\\nn = [json.loads(x) for x in TXT.splitlines()]\\nbook = {\\'message\\', \\'open\\', \\'keepalive\\', \\'poll_request\\'}; docs = {\\'open\\', \\'keepalive\\', \\'message\\', \\'message_delete\\', \\'message_clear\\', \\'poll_request\\'}\\nt = n[1][\\'time\\']\\nout = (sorted(n[0]), sorted(n[1]), n[1][\\'expires\\'] - n[1][\\'time\\'], (n[1][\\'expires\\'] - n[1][\\'time\\']) / 3600, DT.fromtimestamp(t, UTC).isoformat(), sorted(docs - book), n[1][\\'priority\\'], n[1][\\'tags\\'], [x[\\'event\\'] for x in n])', g), g['out'])[1])({}) evaluates to (['event', 'expires', 'id', 'message', 'time', 'topic'], ['event', 'expires', 'id', 'message', 'priority', 'tags', 'time', 'title', 'topic'], 43200, 12.0, '2026-12-21T03:28:32+00:00', ['message_clear', 'message_delete'], 5, ['warning', 'neutral_face'], ['message', 'message'])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nTXT = (\\'{\\x22id\\x22:\\x221jnHKeFNqwnS\\x22,\\x22time\\x22:1797823340,\\x22expires\\x22:1797866540,\\x22event\\x22:\\x22message\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22,\\x22message\\x22:\\x22Hello, world!\\x22}\\\\n\\'\\n       \\'{\\x22id\\x22:\\x22wZ22cjyKXw1F\\x22,\\x22time\\x22:1797823712,\\x22expires\\x22:1797866912,\\x22event\\x22:\\x22message\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22,\\x22title\\x22:\\x22Important: Read this!\\x22,\\x22message\\x22:\\x22The rent is too high!\\x22,\\x22priority\\x22:5,\\x22tags\\x22:[\\x22warning\\x22,\\x22neutral_face\\x22]}\\\\n\\')\\nn = [json.loads(x) for x in TXT.splitlines()]\\nbook = {\\'message\\', \\'open\\', \\'keepalive\\', \\'poll_request\\'}; docs = {\\'open\\', \\'keepalive\\', \\'message\\', \\'message_delete\\', \\'message_clear\\', \\'poll_request\\'}\\nt = n[1][\\'time\\']\\nout = (sorted(n[0]), sorted(n[1]), n[1][\\'expires\\'] - n[1][\\'time\\'], (n[1][\\'expires\\'] - n[1][\\'time\\']) / 3600, DT.fromtimestamp(t, UTC).isoformat(), sorted(docs - book), n[1][\\'priority\\'], n[1][\\'tags\\'], [x[\\'event\\'] for x in n])', g), g['out'])[1])({})" ; chx:output "(['event', 'expires', 'id', 'message', 'time', 'topic'], ['event', 'expires', 'id', 'message', 'priority', 'tags', 'time', 'title', 'topic'], 43200, 12.0, '2026-12-21T03:28:32+00:00', ['message_clear', 'message_delete'], 5, ['warning', 'neutral_face'], ['message', 'message'])" .
chx:X_EventFields rd:hasIOExample chx:IO_EventFields .
chx:X_TopicSecrecy a owl:NamedIndividual, chx:TopicSecrecy ; rdfs:label "secrets.token_urlsafe(16)"@en ; skos:definition "The random part of the chapter's topic, ZPgxBQ42, is 8 characters of 62, 47.6 bits, and its first half is the author's name; secrets.token_urlsafe(16) gives 22 characters of 128 bits; the topic is part of the URL path, so it appears in logs, and ntfy's FAQ says that without access control the topic name is the password."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_TopicSecrecy a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport math\\nbook = \\'AlSweigartZPgxBQ42\\'; rnd = book[len(\\'AlSweigart\\'):]\\nt = secrets.token_urlsafe(16)\\nout = (len(rnd), round(len(rnd) * math.log2(62), 1), round(math.log2(62 ** len(rnd) * 1), 1), 62 ** 8, round(16 * 8, 0), len(t), set(t) <= set(\\'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\\'), round(math.log2(62 ** 8) / 8, 2), \\'https://ntfy.sh/\\' + book)', g), g['out'])[1])({}) evaluates to (8, 47.6, 47.6, 218340105584896, 128, 22, True, 5.95, 'https://ntfy.sh/AlSweigartZPgxBQ42')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport math\\nbook = \\'AlSweigartZPgxBQ42\\'; rnd = book[len(\\'AlSweigart\\'):]\\nt = secrets.token_urlsafe(16)\\nout = (len(rnd), round(len(rnd) * math.log2(62), 1), round(math.log2(62 ** len(rnd) * 1), 1), 62 ** 8, round(16 * 8, 0), len(t), set(t) <= set(\\'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\\'), round(math.log2(62 ** 8) / 8, 2), \\'https://ntfy.sh/\\' + book)', g), g['out'])[1])({})" ; chx:output "(8, 47.6, 47.6, 218340105584896, 128, 22, True, 5.95, 'https://ntfy.sh/AlSweigartZPgxBQ42')" .
chx:X_TopicSecrecy rd:hasIOExample chx:IO_TopicSecrecy .
chx:X_DailyAndSize a owl:NamedIndividual, chx:DailyAndSize ; rdfs:label "len(text.encode('utf-8'))"@en ; skos:definition "The limit of 4,096 bytes is bytes, not characters: 4096 ASCII characters are 4096 bytes and 4097 are over, while 2049 dotless i characters are 4098 bytes; 250 messages of 4096 bytes are 1,024,000 bytes a day, one message every 345.6 seconds on average; the ntfy documentation says a message over the limit is turned into an attachment, which the chapter does not."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_DailyAndSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nok = \\'a\\' * 4096; no = \\'a\\' * 4097; tr = \\'ı\\' * 2048; tr2 = \\'ı\\' * 2049\\nout = (len(ok.encode()), len(no.encode()), len(tr), len(tr.encode()), len(tr2.encode()), len(tr2.encode()) > 4096, 250 * 4096, 250 * 4096 // 1024, 24 * 60 // 250, 86400 / 250)', g), g['out'])[1])({}) evaluates to (4096, 4097, 2048, 4096, 4098, True, 1024000, 1000, 5, 345.6)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nok = \\'a\\' * 4096; no = \\'a\\' * 4097; tr = \\'ı\\' * 2048; tr2 = \\'ı\\' * 2049\\nout = (len(ok.encode()), len(no.encode()), len(tr), len(tr.encode()), len(tr2.encode()), len(tr2.encode()) > 4096, 250 * 4096, 250 * 4096 // 1024, 24 * 60 // 250, 86400 / 250)', g), g['out'])[1])({})" ; chx:output "(4096, 4097, 2048, 4096, 4098, True, 1024000, 1000, 5, 345.6)" .
chx:X_DailyAndSize rd:hasIOExample chx:IO_DailyAndSize .
chx:X_ServiceHealth a owl:NamedIndividual, chx:ServiceHealth ; rdfs:label "GET https://ntfy.sh/v1/health"@en ; skos:definition "GET https://ntfy.sh/v1/health answered 200 with {'healthy':true}, and a GET poll of a random, unused topic answered 200 with an empty body and the content type application/x-ndjson; nothing was published to ntfy.sh by this study. Recorded in the live observations."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_EnvelopeVersusHeader a owl:NamedIndividual, chx:EnvelopeVersusHeader ; rdfs:label "smtp.sendmail(from_addr, to_addrs, msg)"@en ; skos:definition "The envelope and the header are separate: the local server received MAIL FROM bounces@mallory.example and RCPT TO jon@example.org and hidden@example.org while the message said From: CEO <ceo@bank.example> and To: Jon Doe <jon@example.org>, with no login and no TLS, so the hidden address is nowhere in the text and the From is whatever the sender wrote; the chapter's remark that a from address is trivial to fake is right."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_EnvelopeVersusHeader a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nimport ipaddress, logging\\nlogging.getLogger(\\'mail.log\\').setLevel(logging.CRITICAL)\\nfrom aiosmtpd.controller import Controller\\nfrom aiosmtpd.smtp import AuthResult, LoginPassword\\nfrom cryptography import x509\\nfrom cryptography.x509.oid import NameOID\\nfrom cryptography.hazmat.primitives import hashes, serialization\\nfrom cryptography.hazmat.primitives.asymmetric import ec\\ndef serve(**kw):\\n    d = tempfile.mkdtemp(); key = ec.generate_private_key(ec.SECP256R1()); nm = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, \\'localhost\\')]); t0 = datetime.datetime(2026, 1, 1)\\n    crt = (x509.CertificateBuilder().subject_name(nm).issuer_name(nm).public_key(key.public_key()).serial_number(1).not_valid_before(t0).not_valid_after(t0 + datetime.timedelta(days=3650))\\n           .add_extension(x509.SubjectAlternativeName([x509.DNSName(\\'localhost\\'), x509.IPAddress(ipaddress.ip_address(\\'127.0.0.1\\'))]), critical=False).sign(key, hashes.SHA256()))\\n    cp, kp = d + \\'/c.pem\\', d + \\'/k.pem\\'\\n    open(cp, \\'wb\\').write(crt.public_bytes(serialization.Encoding.PEM)); open(kp, \\'wb\\').write(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()))\\n    sc = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); sc.load_cert_chain(cp, kp); box = []\\n    class H:\\n        async def handle_RCPT(s, server, session, envelope, address, rcpt_options):\\n            if address.endswith(\\'@refused.example\\'): return \\'550 5.1.1 no such mailbox\\'\\n            envelope.rcpt_tos.append(address); return \\'250 OK\\'\\n        async def handle_DATA(s, server, session, envelope):\\n            box.append({\\'from\\': envelope.mail_from, \\'to\\': list(envelope.rcpt_tos), \\'data\\': envelope.original_content, \\'tls\\': session.ssl is not None, \\'auth\\': bool(session.authenticated), \\'opts\\': list(envelope.mail_options)}); return \\'250 OK queued\\'\\n    def authn(server, session, envelope, mechanism, data):\\n        ok = isinstance(data, LoginPassword) and data.login == b\\'user\\' and data.password == b\\'secret\\'\\n        return AuthResult(success=ok, handled=ok)\\n    so = socket.socket(); so.bind((\\'127.0.0.1\\', 0)); port = so.getsockname()[1]; so.close()\\n    c = Controller(H(), hostname=\\'127.0.0.1\\', port=port, tls_context=sc, authenticator=authn, auth_required=kw.get(\\'auth_required\\', False), auth_require_tls=kw.get(\\'auth_require_tls\\', True), require_starttls=kw.get(\\'require_starttls\\', False), enable_SMTPUTF8=True)\\n    c.start(); return c, box, port, cp\\nc, box, port, cp = serve()\\ntry:\\n    s = smtplib.SMTP(\\'127.0.0.1\\', port, timeout=10); s.ehlo()\\n    m = mk(frm=\\'CEO <ceo@bank.example>\\', to=\\'Jon Doe <jon@example.org>\\')\\n    s.sendmail(\\'bounces@mallory.example\\', [\\'jon@example.org\\', \\'hidden@example.org\\'], m.as_bytes()); s.quit()\\n    hdr = email.message_from_bytes(box[0][\\'data\\'], policy=policy.default)\\n    out = (box[0][\\'from\\'], box[0][\\'to\\'], hdr[\\'From\\'], hdr[\\'To\\'], \\'hidden@example.org\\' in box[0][\\'data\\'].decode(), box[0][\\'auth\\'], box[0][\\'tls\\'])\\nfinally: c.stop()', g), g['out'])[1])({}) evaluates to ('bounces@mallory.example', ['jon@example.org', 'hidden@example.org'], 'CEO <ceo@bank.example>', 'Jon Doe <jon@example.org>', False, False, False)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nimport ipaddress, logging\\nlogging.getLogger(\\'mail.log\\').setLevel(logging.CRITICAL)\\nfrom aiosmtpd.controller import Controller\\nfrom aiosmtpd.smtp import AuthResult, LoginPassword\\nfrom cryptography import x509\\nfrom cryptography.x509.oid import NameOID\\nfrom cryptography.hazmat.primitives import hashes, serialization\\nfrom cryptography.hazmat.primitives.asymmetric import ec\\ndef serve(**kw):\\n    d = tempfile.mkdtemp(); key = ec.generate_private_key(ec.SECP256R1()); nm = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, \\'localhost\\')]); t0 = datetime.datetime(2026, 1, 1)\\n    crt = (x509.CertificateBuilder().subject_name(nm).issuer_name(nm).public_key(key.public_key()).serial_number(1).not_valid_before(t0).not_valid_after(t0 + datetime.timedelta(days=3650))\\n           .add_extension(x509.SubjectAlternativeName([x509.DNSName(\\'localhost\\'), x509.IPAddress(ipaddress.ip_address(\\'127.0.0.1\\'))]), critical=False).sign(key, hashes.SHA256()))\\n    cp, kp = d + \\'/c.pem\\', d + \\'/k.pem\\'\\n    open(cp, \\'wb\\').write(crt.public_bytes(serialization.Encoding.PEM)); open(kp, \\'wb\\').write(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()))\\n    sc = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); sc.load_cert_chain(cp, kp); box = []\\n    class H:\\n        async def handle_RCPT(s, server, session, envelope, address, rcpt_options):\\n            if address.endswith(\\'@refused.example\\'): return \\'550 5.1.1 no such mailbox\\'\\n            envelope.rcpt_tos.append(address); return \\'250 OK\\'\\n        async def handle_DATA(s, server, session, envelope):\\n            box.append({\\'from\\': envelope.mail_from, \\'to\\': list(envelope.rcpt_tos), \\'data\\': envelope.original_content, \\'tls\\': session.ssl is not None, \\'auth\\': bool(session.authenticated), \\'opts\\': list(envelope.mail_options)}); return \\'250 OK queued\\'\\n    def authn(server, session, envelope, mechanism, data):\\n        ok = isinstance(data, LoginPassword) and data.login == b\\'user\\' and data.password == b\\'secret\\'\\n        return AuthResult(success=ok, handled=ok)\\n    so = socket.socket(); so.bind((\\'127.0.0.1\\', 0)); port = so.getsockname()[1]; so.close()\\n    c = Controller(H(), hostname=\\'127.0.0.1\\', port=port, tls_context=sc, authenticator=authn, auth_required=kw.get(\\'auth_required\\', False), auth_require_tls=kw.get(\\'auth_require_tls\\', True), require_starttls=kw.get(\\'require_starttls\\', False), enable_SMTPUTF8=True)\\n    c.start(); return c, box, port, cp\\nc, box, port, cp = serve()\\ntry:\\n    s = smtplib.SMTP(\\'127.0.0.1\\', port, timeout=10); s.ehlo()\\n    m = mk(frm=\\'CEO <ceo@bank.example>\\', to=\\'Jon Doe <jon@example.org>\\')\\n    s.sendmail(\\'bounces@mallory.example\\', [\\'jon@example.org\\', \\'hidden@example.org\\'], m.as_bytes()); s.quit()\\n    hdr = email.message_from_bytes(box[0][\\'data\\'], policy=policy.default)\\n    out = (box[0][\\'from\\'], box[0][\\'to\\'], hdr[\\'From\\'], hdr[\\'To\\'], \\'hidden@example.org\\' in box[0][\\'data\\'].decode(), box[0][\\'auth\\'], box[0][\\'tls\\'])\\nfinally: c.stop()', g), g['out'])[1])({})" ; chx:output "('bounces@mallory.example', ['jon@example.org', 'hidden@example.org'], 'CEO <ceo@bank.example>', 'Jon Doe <jon@example.org>', False, False, False)" .
chx:X_EnvelopeVersusHeader rd:hasIOExample chx:IO_EnvelopeVersusHeader .
chx:X_HeaderLineLimits a owl:NamedIndividual, chx:HeaderLineLimits ; rdfs:label "policy.default.max_line_length"@en ; skos:definition "The default policy folds headers at 78 characters (policy.SMTP also has 78 and CRLF as linesep): a 300-character Subject of words became 5 lines of at most 78, and a 1200-character Subject without spaces was written as encoded words (Subject: =?utf-8?q?x...) over 19 lines of at most 78, and read back as the original."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_HeaderLineLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nm = mk(subj=\\'word \\' * 60); raw = m.as_bytes().split(b\\'\\\\r\\\\n\\') if False else m.as_bytes().splitlines()\\nlongone = mk(subj=\\'x\\' * 1200)\\nr2 = longone.as_bytes().splitlines()\\nfold = [l for l in raw if l.startswith(b\\'Subject\\') or l.startswith(b\\' \\')]\\nout = (max(len(l) for l in raw), len(fold), max(len(l) for l in fold), max(len(l) for l in r2), policy.default.max_line_length, policy.SMTP.max_line_length, policy.SMTP.linesep, [l for l in r2 if l.startswith(b\\'Subject\\')][0][:20], len([l for l in r2 if l.startswith(b\\'Subject\\') or l.startswith(b\\' \\')]), email.message_from_bytes(longone.as_bytes(), policy=policy.default)[\\'subject\\'] == \\'x\\' * 1200)', g), g['out'])[1])({}) evaluates to (78, 5, 78, 78, 78, 78, '\\r\\n', b'Subject: =?utf-8?q?x', 19, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nm = mk(subj=\\'word \\' * 60); raw = m.as_bytes().split(b\\'\\\\r\\\\n\\') if False else m.as_bytes().splitlines()\\nlongone = mk(subj=\\'x\\' * 1200)\\nr2 = longone.as_bytes().splitlines()\\nfold = [l for l in raw if l.startswith(b\\'Subject\\') or l.startswith(b\\' \\')]\\nout = (max(len(l) for l in raw), len(fold), max(len(l) for l in fold), max(len(l) for l in r2), policy.default.max_line_length, policy.SMTP.max_line_length, policy.SMTP.linesep, [l for l in r2 if l.startswith(b\\'Subject\\')][0][:20], len([l for l in r2 if l.startswith(b\\'Subject\\') or l.startswith(b\\' \\')]), email.message_from_bytes(longone.as_bytes(), policy=policy.default)[\\'subject\\'] == \\'x\\' * 1200)', g), g['out'])[1])({})" ; chx:output "(78, 5, 78, 78, 78, 78, '\\r\\n', b'Subject: =?utf-8?q?x', 19, True)" .
