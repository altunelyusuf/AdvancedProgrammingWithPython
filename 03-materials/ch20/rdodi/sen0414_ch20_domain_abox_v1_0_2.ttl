chx:X_AttNotice a owl:NamedIndividual, chx:AttNotice ; rdfs:label "txt.att.net"@en ; skos:definition "AT&T's support article KM1061254 says that on June 17, 2025 its email-to-text and text-to-email service was shut down, which is 483 days before 2026-10-13 and a Tuesday; Table 20-1 still lists txt.att.net and mms.att.net first, and the chapter's own warning that a gateway that works today may not work tomorrow came true for them."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_AttNotice a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nT = {\\'AT&T\\': (\\'txt.att.net\\', \\'mms.att.net\\'), \\'Boost Mobile\\': (\\'sms.myboostmobile.com\\', None), \\'Cricket\\': (\\'sms.cricketwireless.net\\', \\'mms.cricketwireless.net\\'), \\'Google Fi\\': (\\'msg.fi.google.com\\', None),\\n     \\'Metro PCS\\': (\\'mymetropcs.com\\', None), \\'Republic Wireless\\': (\\'text.republicwireless.com\\', None), \\'Sprint\\': (\\'messaging.sprintpcs.com\\', \\'pm.sprint.com\\'), \\'T-Mobile\\': (\\'tmomail.net\\', None),\\n     \\'U.S. Cellular\\': (\\'email.uscc.net\\', \\'mms.uscc.net\\'), \\'Verizon\\': (\\'vtext.com\\', \\'vzwpix.com\\'), \\'Virgin Mobile\\': (\\'vmobl.com\\', \\'vmpix.com\\'), \\'Xfinity Mobile\\': (\\'vtext.com\\', \\'mypixmessages.com\\')}\\ndef addr(number, carrier, mms=False):\\n    sms, m = T[carrier]; return \\'%s@%s\\' % (number, (m or sms) if mms else sms)\\nshut = D(2025, 6, 17); on = D(2026, 10, 13)\\nout = (T[\\'AT&T\\'], (on - shut).days, shut.strftime(\\'%A\\'), D(2026, 12, 20) > shut, \\'txt.att.net\\' in [v[0] for v in T.values()])', g), g['out'])[1])({}) evaluates to (('txt.att.net', 'mms.att.net'), 483, 'Tuesday', True, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nT = {\\'AT&T\\': (\\'txt.att.net\\', \\'mms.att.net\\'), \\'Boost Mobile\\': (\\'sms.myboostmobile.com\\', None), \\'Cricket\\': (\\'sms.cricketwireless.net\\', \\'mms.cricketwireless.net\\'), \\'Google Fi\\': (\\'msg.fi.google.com\\', None),\\n     \\'Metro PCS\\': (\\'mymetropcs.com\\', None), \\'Republic Wireless\\': (\\'text.republicwireless.com\\', None), \\'Sprint\\': (\\'messaging.sprintpcs.com\\', \\'pm.sprint.com\\'), \\'T-Mobile\\': (\\'tmomail.net\\', None),\\n     \\'U.S. Cellular\\': (\\'email.uscc.net\\', \\'mms.uscc.net\\'), \\'Verizon\\': (\\'vtext.com\\', \\'vzwpix.com\\'), \\'Virgin Mobile\\': (\\'vmobl.com\\', \\'vmpix.com\\'), \\'Xfinity Mobile\\': (\\'vtext.com\\', \\'mypixmessages.com\\')}\\ndef addr(number, carrier, mms=False):\\n    sms, m = T[carrier]; return \\'%s@%s\\' % (number, (m or sms) if mms else sms)\\nshut = D(2025, 6, 17); on = D(2026, 10, 13)\\nout = (T[\\'AT&T\\'], (on - shut).days, shut.strftime(\\'%A\\'), D(2026, 12, 20) > shut, \\'txt.att.net\\' in [v[0] for v in T.values()])', g), g['out'])[1])({})" ; chx:output "(('txt.att.net', 'mms.att.net'), 483, 'Tuesday', True, True)" .
