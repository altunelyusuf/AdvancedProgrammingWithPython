chx:X_AddressParsing a owl:NamedIndividual, chx:AddressParsing ; rdfs:label "email.utils.parseaddr(text)"@en ; skos:definition "parseaddr splits Al Sweigart <al@inventwithpython.com> into a name and an address; given two addresses in one string it returns ('', '') under Python 3.14 and the other releases of this study, and ('', 'real@example.com') only with strict=False, and getaddresses keeps a quoted name with a comma ('Doe, Jon') whole but splits it in two without the quotes."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_AddressParsing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ns = \\'\\x22Doe, Jon\\x22 <jon@example.org>, Al Sweigart <al@inventwithpython.com>, plain@example.com\\'\\nbad = \\'real@example.com, evil@example.net\\'\\nout = (eu.parseaddr(\\'Al Sweigart <al@inventwithpython.com>\\'), eu.getaddresses([s]), eu.getaddresses([s.replace(\\'\\x22Doe, Jon\\x22\\', \\'Doe, Jon\\')]), eu.parseaddr(bad), eu.parseaddr(bad, strict=False), eu.formataddr((\\'Yılmaz, Ayşe\\', \\'ayse@example.org\\')), eu.formataddr((\\'Jon Doe\\', \\'jon@example.org\\')), getattr(eu, \\'supports_strict_parsing\\', None))', g), g['out'])[1])({}) evaluates to (('Al Sweigart', 'al@inventwithpython.com'), [('Doe, Jon', 'jon@example.org'), ('Al Sweigart', 'al@inventwithpython.com'), ('', 'plain@example.com')], [('', 'Doe'), ('Jon', 'jon@example.org'), ('Al Sweigart', 'al@inventwithpython.com'), ('', 'plain@example.com')], ('', ''), ('', 'real@example.com'), '=?utf-8?b?WcSxbG1heiwgQXnFn2U=?= <ayse@example.org>', 'Jon Doe <jon@example.org>', True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ns = \\'\\x22Doe, Jon\\x22 <jon@example.org>, Al Sweigart <al@inventwithpython.com>, plain@example.com\\'\\nbad = \\'real@example.com, evil@example.net\\'\\nout = (eu.parseaddr(\\'Al Sweigart <al@inventwithpython.com>\\'), eu.getaddresses([s]), eu.getaddresses([s.replace(\\'\\x22Doe, Jon\\x22\\', \\'Doe, Jon\\')]), eu.parseaddr(bad), eu.parseaddr(bad, strict=False), eu.formataddr((\\'Yılmaz, Ayşe\\', \\'ayse@example.org\\')), eu.formataddr((\\'Jon Doe\\', \\'jon@example.org\\')), getattr(eu, \\'supports_strict_parsing\\', None))', g), g['out'])[1])({})" ; chx:output "(('Al Sweigart', 'al@inventwithpython.com'), [('Doe, Jon', 'jon@example.org'), ('Al Sweigart', 'al@inventwithpython.com'), ('', 'plain@example.com')], [('', 'Doe'), ('Jon', 'jon@example.org'), ('Al Sweigart', 'al@inventwithpython.com'), ('', 'plain@example.com')], ('', ''), ('', 'real@example.com'), '=?utf-8?b?WcSxbG1heiwgQXnFn2U=?= <ayse@example.org>', 'Jon Doe <jon@example.org>', True)" .
