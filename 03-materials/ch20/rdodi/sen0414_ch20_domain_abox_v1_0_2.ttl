chx:X_ListingsReplay a owl:NamedIndividual, chx:ListingsReplay ; rdfs:label "ezgmail.send(...) with no credentials"@en ; skos:definition "Run as printed with no credentials, ezgmail.init(), send, unread, search and recent all raised EZGmailException with the same text (Can't find credentials file at DIR/credentials.json.), LOGGED_IN and EMAIL_ADDRESS stayed False; the full replay of the 15 listings in 3 environments is in the third-party record."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_ListingsReplay a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nd = wd()\\nimport ezgmail\\ndef a(): ezgmail.send(\\'recipient@example.com\\', \\'Subject line\\', \\'Body of the email\\')\\ndef b(): ezgmail.unread()\\ndef c(): ezgmail.search(\\'has:attachment\\')\\ndef e(): ezgmail.recent()\\ndef f(): ezgmail.summary([])\\nezgmail.SERVICE_GMAIL = None\\nres = [err(x) for x in (a, b, c, e, f)]\\nout = ([r[0] for r in res], res[0][1].split(\\' You can\\')[0].replace(d, \\'DIR\\'), ezgmail.LOGGED_IN, ezgmail.EMAIL_ADDRESS, [r[1].split(\\' You can\\')[0].replace(d, \\'DIR\\') == res[0][1].split(\\' You can\\')[0].replace(d, \\'DIR\\') for r in res])', g), g['out'])[1])({}) evaluates to (['EZGmailException', 'EZGmailException', 'EZGmailException', 'EZGmailException', 'EZGmailException'], 'Can't find credentials file at DIR/credentials.json.', False, False, [True, True, True, True, True])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nd = wd()\\nimport ezgmail\\ndef a(): ezgmail.send(\\'recipient@example.com\\', \\'Subject line\\', \\'Body of the email\\')\\ndef b(): ezgmail.unread()\\ndef c(): ezgmail.search(\\'has:attachment\\')\\ndef e(): ezgmail.recent()\\ndef f(): ezgmail.summary([])\\nezgmail.SERVICE_GMAIL = None\\nres = [err(x) for x in (a, b, c, e, f)]\\nout = ([r[0] for r in res], res[0][1].split(\\' You can\\')[0].replace(d, \\'DIR\\'), ezgmail.LOGGED_IN, ezgmail.EMAIL_ADDRESS, [r[1].split(\\' You can\\')[0].replace(d, \\'DIR\\') == res[0][1].split(\\' You can\\')[0].replace(d, \\'DIR\\') for r in res])', g), g['out'])[1])({})" ; chx:output "(['EZGmailException', 'EZGmailException', 'EZGmailException', 'EZGmailException', 'EZGmailException'], 'Can't find credentials file at DIR/credentials.json.', False, False, [True, True, True, True, True])" .
