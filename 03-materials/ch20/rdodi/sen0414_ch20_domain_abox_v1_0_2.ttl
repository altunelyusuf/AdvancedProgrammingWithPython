chx:X_AttachmentNames a owl:NamedIndividual, chx:AttachmentNames ; rdfs:label "threads[0].messages[0].attachments"@en ; skos:definition "attachments is a list of file names, with duplicates (tulips.jpg, canal.jpg, canal.jpg), and the body of a multipart message is the text part only; downloadAttachment with a name that is not in the list raises AttributeError, not a message that names the file."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_AttachmentNames a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nparts = [{\\'mimeType\\': \\'text/plain\\', \\'filename\\': \\'\\', \\'headers\\': [{\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}], \\'body\\': {\\'size\\': 5, \\'data\\': b64(\\'Photos\\')}},\\n         {\\'mimeType\\': \\'image/jpeg\\', \\'filename\\': \\'tulips.jpg\\', \\'headers\\': [], \\'body\\': {\\'attachmentId\\': \\'A1\\', \\'size\\': 11}}, {\\'mimeType\\': \\'image/jpeg\\', \\'filename\\': \\'canal.jpg\\', \\'headers\\': [], \\'body\\': {\\'attachmentId\\': \\'A2\\', \\'size\\': 12}},\\n         {\\'mimeType\\': \\'image/jpeg\\', \\'filename\\': \\'canal.jpg\\', \\'headers\\': [], \\'body\\': {\\'attachmentId\\': \\'A3\\', \\'size\\': 13}}]\\nm = ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'a@example.com\\', \\'b@example.com\\', \\'vacation photos\\', \\'Photos\\', 1797000000000, parts))\\nout = (m.attachments, m._attachmentsInfo[0], repr(m.body), type(m.attachments).__name__, err(lambda: m.downloadAttachment(\\'nothere.jpg\\'))[0], err(lambda: m.downloadAllAttachments(\\'x\\', overwrite=False))[0])', g), g['out'])[1])({}) evaluates to (['tulips.jpg', 'canal.jpg', 'canal.jpg'], {'filename': 'tulips.jpg', 'id': 'A1', 'size': 11}, ''Photos'', 'list', 'AttributeError', 'EZGmailException')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, ti