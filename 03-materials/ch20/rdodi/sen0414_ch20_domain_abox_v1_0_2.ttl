chx:X_JsonLines a owl:NamedIndividual, chx:JsonLines ; rdfs:label "resp.text.splitlines()"@en ; skos:definition "The poll answer is one JSON object per line: json.loads of the whole text raised JSONDecodeError (Extra data: line 2 column 1), splitlines then loads gave the 2 messages Hello, world! and The rent is too high!, and a blank line, which a stream can contain, raised JSONDecodeError again."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_JsonLines a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nTXT = (\\'{\\x22id\\x22:\\x221jnHKeFNqwnS\\x22,\\x22time\\x22:1797823340,\\x22expires\\x22:1797866540,\\x22event\\x22:\\x22message\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22,\\x22message\\x22:\\x22Hello, world!\\x22}\\\\n\\'\\n       \\'{\\x22id\\x22:\\x22wZ22cjyKXw1F\\x22,\\x22time\\x22:1797823712,\\x22expires\\x22:1797866912,\\x22event\\x22:\\x22message\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22,\\x22title\\x22:\\x22Important: Read this!\\x22,\\x22message\\x22:\\x22The rent is too high!\\x22,\\x22priority\\x22:5,\\x22tags\\x22:[\\x22warning\\x22,\\x22neutral_face\\x22]}\\\\n\\')\\ne = err(lambda: json.loads(TXT))\\nn = [json.loads(x) for x in TXT.splitlines()]\\nka = TXT + \\'\\\\n{\\x22id\\x22:\\x22k1\\x22,\\x22time\\x22:1797823800,\\x22expires\\x22:0,\\x22event\\x22:\\x22keepalive\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22}\\\\n\\'\\ne2 = err(lambda: [json.loads(x) for x in (TXT + \\'\\\\n\\').splitlines()])\\nout = (e[0], e[1], len(n), n[0][\\'message\\'], n[1][\\'message\\'], e2[0], len([json.loads(x) for x in ka.splitlines() if x.strip()]), TXT.count(\\'\\\\n\\'))', g), g['out'])[1])({}) evaluates to ('JSONDecodeError', 'Extra data: line 2 column 1 (char 134)', 2, 'Hello, world!', 'The rent is too high!', 'JSONDecodeError', 3, 2)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nTXT = (\\'{\\x22id\\x22:\\x221jnHKeFNqwnS\\x22,\\x22time\\x22:1797823340,\\x22expires\\x22:1797866540,\\x22event\\x22:\\x22message\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22,\\x22message\\x22:\\x22Hello, world!\\x22}\\\\n\\'\\n       \\'{\\x22id\\x22:\\x22wZ22cjyKXw1F\\x22,\\x22time\\x22:1797823712,\\x22expires\\x22:1797866912,\\x22event\\x22:\\x22message\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22,\\x22title\\x22:\\x22Important: Read this!\\x22,\\x22message\\x22:\\x22The rent is too high!\\x22,\\x22priority\\x22:5,\\x22tags\\x22:[\\x22warning\\x22,\\x22neutral_face\\x22]}\\\\n\\')\\ne = err(lambda: json.loads(TXT))\\nn = [json.loads(x) for x in TXT.splitlines()]\\nka = TXT + \\'\\\\n{\\x22id\\x22:\\x22k1\\x22,\\x22time\\x22:1797823800,\\x22expires\\x22:0,\\x22event\\x22:\\x22keepalive\\x22,\\x22topic\\x22:\\x22AlSweigartZPgxBQ42\\x22}\\\\n\\'\\ne2 = err(lambda: [json.loads(x) for x in (TXT + \\'\\\\n\\').splitlines()])\\nout = (e[0], e[1], len(n), n[0][\\'message\\'], n[1][\\'message\\'], e2[0], len([json.loads(x) for x in ka.splitlines() if x.strip()]), TXT.count(\\'\\\\n\\'))', g), g['out'])[1])({})" ; chx:output "('JSONDecodeError', 'Extra data: line 2 column 1 (char 134)', 2, 'Hello,