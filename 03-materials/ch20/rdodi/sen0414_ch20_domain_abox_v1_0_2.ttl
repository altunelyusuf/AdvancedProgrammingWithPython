chx:X_ThreadVersusMessage a owl:NamedIndividual, chx:ThreadVersusMessage ; rdfs:label "str(unread_threads[0])"@en ; skos:definition "A GmailThread holds an id, a snippet and a historyId and fetches its GmailMessage objects with one more GET (users/me/threads/T1) the first time messages is read; its repr is <GmailThread numMessages=2 snippet='Do you want to watch RoboCop this weekend?'> and building that text itself costs an API call, which is not the text the chapter prints (<GmailThread len=2 snippet= Do you ...'>)."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_ThreadVersusMessage a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nt = {\\'id\\': \\'T1\\', \\'snippet\\': \\'Do you want to watch RoboCop this weekend?\\', \\'historyId\\': \\'9\\'}\\nfull = {\\'id\\': \\'T1\\', \\'messages\\': [api_msg(\\'M1\\', \\'T1\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Jon Doe <example@gmail.com>\\', \\'RoboCop\\', \\'Do you want to watch RoboCop this weekend?\\\\r\\\\n\\', 1797000000000), api_msg(\\'M2\\', \\'T1\\', \\'Jon Doe <example@gmail.com>\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Re: RoboCop\\', \\'Yes.\\\\r\\\\n\\', 1797000100000)]}\\nh = gm(full); th = ezgmail.GmailThread(t)\\nn0 = len(h.log); s = str(th); n1 = len(h.log); _ = th.messages; n2 = len(h.log)\\nbook = \\x22<GmailThread len=2 snippet= Do you want to watch RoboCop this weekend?\\'>\\x22\\nout = (n0, n1, h.log[0][:2], s, s == book, n2, len(th.messages), type(th.messages[0]).__name__, th.text, th.senders())', g), g['out'])[1])({}) evaluates to (0, 1, ('GET', 'users/me/threads/T1?alt=json'), '<GmailThread numMessages=2 snippet='Do you want to watch RoboCop this weekend?'>', False, 1, 2, 'GmailMessage', ['Do you want to watch RoboCop this weekend?\\r\\n', 'Yes.\\r\\n'], ['Al Sweigart <al@inventwithpython.com>', 'Jon Doe <example@gmail.com>'])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nt = {\\'id\\': \\'T1\\', \\'snippet\\': \\'Do you want to watch RoboCop this weekend?\\', \\'historyId\\': \\'9\\'}\\nfull = {\\'id\\': \\'T1\\', \\'messages\\': [api_msg(\\'M1\\', \\'T1\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Jon Doe <example@gmail.com>\\', \\'RoboCop\\', \\'Do you want to watch RoboCop this weekend?\\\\r\\\\n\\', 1797000000000), api_msg(\\'M2\\', \\'T1\\', \\'Jon Doe <example@gmail.com>\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Re: RoboCop\\', \\'Yes.\\\\r\\\\n\\', 1797000100000)]}\\nh = gm(full); th = ezgmail.GmailThread(t)\\nn0 = len(h.log); s = str(th); n1 = len(h.log); _ = th.messages; n2 = len(h.log)\\nbook = \\x22<GmailThread len=2 snippet= Do you want to watch RoboCop this weekend?\\'>\\x22\\nout = (n0, n1, h.log[0][:2], s, s == book, n2, len(th.messages), type(th.messages[0]).__name__, th.text, th.senders())', g), g['out'])[1])({})" ; chx:output "(0, 1, ('GET', 'users/me/threads/T1?alt=json'), '<GmailThread numMessages=2 snippet='Do you want to watch RoboCop this weekend?'>', False, 1, 2, 'GmailMessage', ['Do you want to watch RoboCop this weekend?\\r\\n', 'Yes.\\r\\n'], ['Al Sweigart <al@inventwithpython.com>', 'Jon Doe <example@gmail.com>'])" .
