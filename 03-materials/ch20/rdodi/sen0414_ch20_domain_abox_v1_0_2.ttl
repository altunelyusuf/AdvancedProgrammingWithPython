chx:X_UnreadRecentSearch a owl:NamedIndividual, chx:UnreadRecentSearch ; rdfs:label "ezgmail.unread(maxResults=50)"@en ; skos:definition "unread, recent and search all call threads.list with a query and maxResults: unread asks q=label:UNREAD, recent asks q=label:INBOX, search passes the text as q (has:attachment, from:... subject:...), and the default maxResults of all three is 25, where Google's API default is 100 and its maximum is 500."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_UnreadRecentSearch a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({}, {}, {}, {}, {})\\na = ezgmail.unread(); b = ezgmail.unread(maxResults=50); c = ezgmail.recent(); d = ezgmail.search(\\'has:attachment\\'); e = ezgmail.search(\\'from:al@inventwithpython.com subject:hello\\', maxResults=3)\\nout = ([x[1] for x in h.log], a, ezgmail.unread.__defaults__, ezgmail.recent.__defaults__, ezgmail.search.__defaults__)', g), g['out'])[1])({}) evaluates to (['users/me/threads?q=label%3AUNREAD&maxResults=25&alt=json', 'users/me/threads?q=label%3AUNREAD&maxResults=50&alt=json', 'users/me/threads?q=label%3AINBOX&maxResults=25&alt=json', 'users/me/threads?q=has%3Aattachment&maxResults=25&alt=json', 'users/me/threads?q=from%3Aal%40inventwithpython.com+subject%3Ahello&maxResults=3&alt=json'], [], (25, 'me'), (25, 'me'), (25, 'me'))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({}, {}, {}, {}, {})\\na = ezgmail.unread(); b = ezgmail.unread(maxResults=50); c = ezgmail.recent(); d = ezgmail.search(\\'has:attachment\\'); e = ezgmail.search(\\'from:al@inventwithpython.com subject:hello\\', maxResults=3)\\nout = ([x[1] for x in h.log], a, ezgmail.unread.__defaults__, ezgmail.recent.__defaults__, ezgmail.search.__defaults__)', g), g['out'])[1])({})" ; chx:output "(['users/me/threads?q=label%3AUNREAD&maxResults=25&alt=json', 'users/me/threads?q=label%3AUNREAD&maxResults=50&alt=json', 'users/me/threads?q=label%3AINBOX&maxResults=25&alt=json', 'users/me/threads?q=has%3Aattachment&maxResults=25&alt=json', 'users/me/threads?q=from%3Aal%40inventwithpython.com+subject%3Ahello&maxResults=3&alt=json'], [], (25, 'me'), (25, 'me'), (25, 'me'))" .
chx:X_UnreadRecentSearch rd:hasIOExample chx:IO_UnreadRecentSearch .
chx:X_MessageFields a owl:NamedIndividual, chx:MessageFields ; rdfs:label "unread_threads[0].messages[0].timestamp"@en ; skos:definition "A GmailMessage gets subject, sender, recipient, body, snippet and timestamp from the API's message; timestamp is a naive datetime made from internalDate with fromtimestamp, so the same message reads 08:48:48 in America/Chicago, 14:48:48 in UTC and 17:48:48 in Europe/Istanbul, and a message with no Subject header raises AttributeError on .subject and on str()."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_MessageFields a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nm = ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Jon Doe <example@gmail.com>\\', \\'RoboCop\\', \\'Do you want to watch RoboCop this weekend?\\\\r\\\\n\\', 1797000528000))\\nres = []\\nfor z in (\\'UTC\\', \\'America/Chicago\\', \\'Europe/Istanbul\\'):\\n    os.environ[\\'TZ\\'] = z; time.tzset(); res.append((z, str(ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'a\\', \\'b\\', \\'c\\', \\'d\\', 1797000528000)).timestamp)))\\nbare = api_msg(\\'M2\\', \\'T2\\', \\'x@example.com\\', \\'y@example.com\\', \\'S\\', \\'text\\', 1)\\nbare[\\'payload\\'][\\'headers\\'] = [h for h in bare[\\'payload\\'][\\'headers\\'] if h[\\'name\\'] != \\'Subject\\']\\nnm = ezgmail.GmailMessage(bare)\\nout = (m.subject, m.sender, m.recipient, repr(m.body), m.snippet, res, err(lambda: nm.subject)[0], err(lambda: str(nm))[0], err(lambda: nm.subject)[1])', g), g['out'])[1])({}) evaluates to ('RoboCop', 'Al Sweigart <al@inventwithpython.com>', 'Jon Doe <example@gmail.com>', ''Do you want to watch RoboCop this weekend?\\\\r\\\\n'', 'Do you want to watch RoboCop this weekend?\\r\\n', [('UTC', '2026-12-11 14:48:48'), ('America/Chicago', '2026-12-11 08:48:48'), ('Europe/Istanbul', '2026-12-11 17:48:48')], 'AttributeError', 'AttributeError', ''GmailMessage' object has no attribute 'subject'')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nm = ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Jon Doe <example@gmail.com>\\', \\'RoboCop\\', \\'Do you want to watch RoboCop this weekend?\\\\r\\\\n\\', 1797000528000))\\nres = []\\nfor z in (\\'UTC\\', \\'America/Chicago\\', \\'Europe/Istanbul\\'):\\n    os.environ[\\'TZ\\'] = z; time.tzset(); res.append((z, str(ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'a\\', \\'b\\', \\'c\\', \\'d\\', 1797000528000)).timestamp)))\\nbare = api_msg(\\'M2\\', \\'T2\\', \\'x@example.com\\', \\'y@example.com\\', \\'S\\', \\'text\\', 1)\\nbare[\\'payload\\'][\\'headers\\'] = [h for h in bare[\\'payload\\'][\\'headers\\'] if h[\\'name\\'] != \\'Subject\\']\\nnm = ezgmail.GmailMessage(bare)\\nout = (m.subject, m.sender, m.recipient, repr(m.body), m.snippet, res, err(lambda: nm.subject)[0], err(lambda: str(nm))[0], err(lambda: nm.subject)[1])', g), g['out'])[1])({})" ; chx:output "('RoboCop', 'Al Sweigart <al@inventwithpython.com>', 'Jon Doe <example@gmail.com>', ''Do you want to watch RoboCop this weekend?\\\\r\\\\n'', 'Do you want to watch RoboCop this weekend?\\r\\n', [('UTC', '2026-12-11 14:48:48'), ('America/Chicago', '2026-12-11 08:48:48'), ('Europe/Istanbul', '2026-12-11 17:48:48')], 'AttributeError', 'AttributeError', ''GmailMessage' object has no attribute 'subject'')" .
chx:X_MessageFields rd:hasIOExample chx:IO_MessageFields .
chx:X_QuotedTextCut a owl:NamedIndividual, chx:QuotedTextCut ; rdfs:label "ezgmail.removeQuotedParts(text)"@en ; skos:definition "removeQuotedParts cuts a reply at the English line On Sun, Jan 1, 2018 at 12:00 PM Name <address> wrote: and keeps the text before it (0 quote marks left), and it cut the same line with a short sender, Al <a@b.c>; it did not cut a reply written On Sun, 1 Jan 2018 at 12:00, a Turkish 1 Oca 2018 Paz 12:00 tarihinde ... yazdi: line, or the English line in which the space before PM is the narrow no-break space U+202F (the regular expression wants a plain space); each uncut reply kept its 2 > characters. This study did not observe which mail programs write the narrow space."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_QuotedTextCut a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nq1 = \\'Sounds good.\\\\n\\\\nOn Sun, Jan 1, 2018 at 12:00 PM Al Sweigart <al@inventwithpython.com> wrote:\\\\n> Do you want to watch?\\'\\nq2 = \\'Sounds good.\\\\n\\\\nOn Sun, 1 Jan 2018 at 12:00, Al Sweigart <al@inventwithpython.com> wrote:\\\\n> Do you want to watch?\\'\\nq3 = \\'Tamam.\\\\n\\\\n1 Oca 2018 Paz 12:00 tarihinde Al Sweigart <al@inventwithpython.com> yazdi:\\\\n> Film izleyelim mi?\\'\\nq4 = q1.replace(\\'12:00 PM\\', \\'12:00 PM\\')\\nq5 = \\'Sounds good.\\\\n\\\\nOn Sun, Jan 1, 2018 at 12:00 PM Al <a@b.c> wrote:\\\\n> hi\\'\\nout = ([ezgmail.removeQuotedParts(q).count(\\'>\\') for q in (q1, q2, q3, q4, q5)], repr(ezgmail.removeQuotedParts(q1)), q4 != q1, len(q1) - len(q4))', g), g['out'])[1])({}) evaluates to ([0, 2, 2, 2, 0], ''Sounds good.\\\\n\\\\n'', True, 0)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nq1 = \\'Sounds good.\\\\n\\\\nOn Sun, Jan 1, 2018 at 12:00 PM Al Sweigart <al@inventwithpython.com> wrote:\\\\n> Do you want to watch?\\'\\nq2 = \\'Sounds good.\\\\n\\\\nOn Sun, 1 Jan 2018 at 12:00, Al Sweigart <al@inventwithpython.com> wrote:\\\\n> Do you want to watch?\\'\\nq3 = \\'Tamam.\\\\n\\\\n1 Oca 2018 Paz 12:00 tarihinde Al Sweigart <al@inventwithpython.com> yazdi:\\\\n> Film izleyelim mi?\\'\\nq4 = q1.replace(\\'12:00 PM\\', \\'12:00 PM\\')\\nq5 = \\'Sounds good.\\\\n\\\\nOn Sun, Jan 1, 2018 at 12:00 PM Al <a@b.c> wrote:\\\\n> hi\\'\\nout = ([ezgmail.removeQuotedParts(q).count(\\'>\\') for q in (q1, q2, q3, q4, q5)], repr(ezgmail.removeQuotedParts(q1)), q4 != q1, len(q1) - len(q4))', g), g['out'])[1])({})" ; chx:output "([0, 2, 2, 2, 0], ''Sounds good.\\\\n\\\\n'', True, 0)" .
