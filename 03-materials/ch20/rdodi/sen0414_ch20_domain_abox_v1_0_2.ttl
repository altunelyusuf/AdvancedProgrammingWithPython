chx:X_MessageIdAndDate a owl:NamedIndividual, chx:MessageIdAndDate ; rdfs:label "email.utils.make_msgid()"@en ; skos:definition "make_msgid(idstring='job1', domain='example.com') gives <...job1@example.com> and two calls differ; formatdate(1797000528, usegmt=True) is Fri, 11 Dec 2026 14:48:48 GMT, without usegmt it ends -0000, and format_datetime of an aware UTC moment ends +0000 and parses back to the same instant."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_MessageIdAndDate a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nmid = eu.make_msgid(idstring=\\'job1\\', domain=\\'example.com\\')\\nout = (bool(re.fullmatch(r\\'<\\\\d{14}\\\\.\\\\d+\\\\.[0-9]+job1@example\\\\.com>\\', mid)) or bool(re.fullmatch(r\\'<[0-9.]+job1@example\\\\.com>\\', mid)), mid.startswith(\\'<\\') and mid.endswith(\\'@example.com>\\'), eu.formatdate(1797000528, usegmt=True), eu.formatdate(1797000528, localtime=False), eu.format_datetime(DT(2026, 12, 9, 13, 28, 48, tzinfo=UTC)), eu.parsedate_to_datetime(\\'Wed, 09 Dec 2026 07:28:48 -0600\\').astimezone(UTC).isoformat(), eu.make_msgid() != eu.make_msgid())', g), g['out'])[1])({}) evaluates to (True, True, 'Fri, 11 Dec 2026 14:48:48 GMT', 'Fri, 11 Dec 2026 14:48:48 -0000', 'Wed, 09 Dec 2026 13:28:48 +0000', '2026-12-09T13:28:48+00:00', True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nmid = eu.make_msgid(idstring=\\'job1\\', domain=\\'example.com\\')\\nout = (bool(re.fullmatch(r\\'<\\\\d{14}\\\\.\\\\d+\\\\.[0-9]+job1@example\\\\.com>\\', mid)) or bool(re.fullmatch(r\\'<[0-9.]+job1@example\\\\.com>\\', mid)), mid.startswith(\\'<\\') and mid.endswith(\\'@example.com>\\'), eu.formatdate(1797000528, usegmt=True), eu.formatdate(1797000528, localtime=False), eu.format_datetime(DT(2026, 12, 9, 13, 28, 48, tzinfo=UTC)), eu.parsedate_to_datetime(\\'Wed, 09 Dec 2026 07:28:48 -0600\\').astimezone(UTC).isoformat(), eu.make_msgid() != eu.make_msgid())', g), g['out'])[1])({})" ; chx:output "(True, True, 'Fri, 11 Dec 2026 14:48:48 GMT', 'Fri, 11 Dec 2026 14:48:48 -0000', 'Wed, 09 Dec 2026 13:28:48 +0000', '2026-12-09T13:28:48+00:00', True)" .
