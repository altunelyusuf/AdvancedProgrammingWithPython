chx:X_ImapSession a owl:NamedIndividual, chx:ImapSession ; rdfs:label "imaplib.IMAP4(host).starttls(ssl_context=ctx)"@en ; skos:definition "Against dovecot 2.3.21 on 127.0.0.1, a local stand-in for imap.gmail.com, imaplib did STARTTLS, LOGIN, SELECT, SEARCH UNSEEN, FETCH, STORE +FLAGS \\Deleted and EXPUNGE: a fetch with BODY.PEEK left the message unseen, a fetch of RFC822 set \\Seen, the expunge left the INBOX empty, and a wrong password raised imaplib.IMAP4.error ([AUTHENTICATIONFAILED]); imapclient 4.1.0 did the same search, fetch and delete. Recorded in the live observations; not run against Gmail."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_ImapParsing a owl:NamedIndividual, chx:ImapParsing ; rdfs:label "imaplib.ParseFlags(data)"@en ; skos:definition "ParseFlags returns the flags of a FETCH answer as bytes (b'\\Seen', b'\\Flagged'), Internaldate2tuple turns '17-Jul-1996 02:44:25 -0700' into a time tuple, Time2Internaldate writes an aware datetime as '09-Dec-2026 13:28:48 +0000', the ports are 143 and 993, and the Commands table has 43 entries."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_ImapParsing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport imaplib\\nd = b\\'1 (FLAGS (\\\\\\\\Seen \\\\\\\\Flagged) INTERNALDATE \\x2217-Jul-1996 02:44:25 -0700\\x22 RFC822.SIZE 4286)\\'\\nt = imaplib.Internaldate2tuple(d)\\nout = (imaplib.ParseFlags(d), t[:6], imaplib.Time2Internaldate(datetime.datetime(2026, 12, 9, 13, 28, 48, tzinfo=datetime.timezone.utc)), imaplib.Int2AP(1234567), imaplib.IMAP4_PORT, imaplib.IMAP4_SSL_PORT, sorted(imaplib.Commands)[:3], len(imaplib.Commands), \\'IDLE\\' in imaplib.Commands)', g), g['out'])[1])({}) evaluates to ((b'\\\\Seen', b'\\\\Flagged'), (1996, 7, 17, 12, 44, 25), ''09-Dec-2026 13:28:48 +0000'', b'BCNGIH', 143, 993, ['APPEND', 'AUTHENTICATE', 'CAPABILITY'], 43, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport imaplib\\nd = b\\'1 (FLAGS (\\\\\\\\Seen \\\\\\\\Flagged) INTERNALDATE \\x2217-Jul-1996 02:44:25 -0700\\x22 RFC822.SIZE 4286)\\'\\nt = imaplib.Internaldate2tuple(d)\\nout = (imaplib.ParseFlags(d), t[:6], imaplib.Time2Internaldate(datetime.datetime(2026, 12, 9, 13, 28, 48, tzinfo=datetime.timezone.utc)), imaplib.Int2AP(1234567), imaplib.IMAP4_PORT, imaplib.IMAP4_SSL_PORT, sorted(imaplib.Commands)[:3], len(imaplib.Commands), \\'IDLE\\' in imaplib.Commands)', g), g['out'])[1])({})" ; chx:output "((b'\\\\Seen', b'\\\\Flagged'), (1996, 7, 17, 12, 44, 25), ''09-Dec-2026 13:28:48 +0000'', b'BCNGIH', 143, 993, ['APPEND', 'AUTHENTICATE', 'CAPABILITY'], 43, True)" .
chx:X_ImapParsing rd:hasIOExample chx:IO_ImapParsing .
chx:X_ImapIdle a owl:NamedIndividual, chx:ImapIdle ; rdfs:label "imaplib.IMAP4.idle()"@en ; skos:definition "Python 3.14 added IMAP4.idle() for the IDLE command of RFC 2177; under 3.14.6 imaplib.IMAP4 has idle and IDLE is in imaplib.Commands for the states AUTH and SELECTED, and the interpreter record shows 3.11, 3.12 and 3.13 without it."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_ImapIdle a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport imaplib\\nout = (hasattr(imaplib.IMAP4, \\'idle\\'), \\'IDLE\\' in imaplib.Commands, imaplib.Commands.get(\\'IDLE\\'), [n for n in (\\'idle\\', \\'starttls\\', \\'login\\', \\'authenticate\\', \\'uid\\', \\'search\\', \\'fetch\\', \\'store\\', \\'expunge\\') if hasattr(imaplib.IMAP4, n)], sys.version_info[:2] >= (3, 14))', g), g['out'])[1])({}) evaluates to (True, True, ('AUTH', 'SELECTED'), ['idle', 'starttls', 'login', 'authenticate', 'uid', 'search', 'fetch', 'store', 'expunge'], True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport imaplib\\nout = (hasattr(imaplib.IMAP4, \\'idle\\'), \\'IDLE\\' in imaplib.Commands, imaplib.Commands.get(\\'IDLE\\'), [n for n in (\\'idle\\', \\'starttls\\', \\'login\\', \\'authenticate\\', \\'uid\\', \\'search\\', \\'fetch\\', \\'store\\', \\'expunge\\') if hasattr(imaplib.IMAP4, n)], sys.version_info[:2] >= (3, 14))', g), g['out'])[1])({})" ; chx:output "(True, True, ('AUTH', 'SELECTED'), ['idle', 'starttls', 'login', 'authenticate', 'uid', 'search', 'fetch', 'store', 'expunge'], True)" .
chx:X_ImapIdle rd:hasIOExample chx:IO_ImapIdle .
chx:X_GmailEndpoints a owl:NamedIndividual, chx:GmailEndpoints ; rdfs:label "imap.gmail.com:993"@en ; skos:definition "Google documents imap.gmail.com on 993 with SSL and smtp.gmail.com on 465 with SSL or 587 with STARTTLS, and says the Gmail IMAP, POP and SMTP servers support OAuth 2.0 through the SASL XOAUTH2 mechanism; a TCP connection from this machine to all three ports timed out after 10 seconds, so no Gmail server was reached and no login was tried. Recorded in the live observations."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_XoauthString a owl:NamedIndividual, chx:XoauthString ; rdfs:label "base64('user=... \\x01auth=Bearer ... \\x01\\x01')"@en ; skos:definition "The SASL XOAUTH2 initial response is the string user=NAME, Control-A, auth=Bearer TOKEN, Control-A, Control-A in base64: for someuser@example.com and ya29.vF9dfd39 it is 72 characters of base64 that decode to those 3 control-A separated fields; the construction follows the format Google documents and was not sent to Google."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_XoauthString a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ns = \\'user=someuser@example.com\\\\x01auth=Bearer ya29.vF9dfd39\\\\x01\\\\x01\\'\\nb = base64.b64encode(s.encode()).decode()\\nout = (b, base64.b64decode(b).split(b\\'\\\\x01\\'), len(b), \\'user=\\' + \\'someuser@example.com\\' == s.split(\\'\\\\x01\\')[0])', g), g['out'])[1])({}) evaluates to ('dXNlcj1zb21ldXNlckBleGFtcGxlLmNvbQFhdXRoPUJlYXJlciB5YTI5LnZGOWRmZDM5AQE=', [b'user=someuser@example.com', b'auth=Bearer ya29.vF9dfd39', b'', b''], 72, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ns = \\'user=someuser@example.com\\\\x01auth=Bearer ya29.vF9dfd39\\\\x01\\\\x01\\'\\nb = base64.b64encode(s.encode()).decode()\\nout = (b, base64.b64decode(b).split(b\\'\\\\x01\\'), len(b), \\'user=\\' + \\'someuser@example.com\\' == s.split(\\'\\\\x01\\')[0])', g), g['out'])[1])({})" ; chx:output "('dXNlcj1zb21ldXNlckBleGFtcGxlLmNvbQFhdXRoPUJlYXJlciB5YTI5LnZGOWRmZDM5AQE=', [b'user=someuser@example.com', b'auth=Bearer ya29.vF9dfd39', b'', b''], 72, True)" .
chx:X_XoauthString rd:hasIOExample chx:IO_XoauthString .
chx:X_GatewayAddress a owl:NamedIndividual, chx:GatewayAddress ; rdfs:label "number@txt.att.net"@en ; skos:definition "Table 20-1 lists 12 providers; an address is the number, an @ and the provider's SMS or MMS domain (5555550100@txt.att.net, 5555550100@mms.att.net), 5 of the 12 say Same as SMS for MMS, and nothing in the table says how the number is written for a provider that wants a country code or no dashes."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_GatewayAddress a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nT = {\\'AT&T\\': (\\'txt.att.net\\', \\'mms.att.net\\'), \\'Boost Mobile\\': (\\'sms.myboostmobile.com\\', None), \\'Cricket\\': (\\'sms.cricketwireless.net\\', \\'mms.cricketwireless.net\\'), \\'Google Fi\\': (\\'msg.fi.google.com\\', None),\\n     \\'Metro PCS\\': (\\'mymetropcs.com\\', None), \\'Republic Wireless\\': (\\'text.republicwireless.com\\', None), \\'Sprint\\': (\\'messaging.sprintpcs.com\\', \\'pm.sprint.com\\'), \\'T-Mobile\\': (\\'tmomail.net\\', None),\\n     \\'U.S. Cellular\\': (\\'email.uscc.net\\', \\'mms.uscc.net\\'), \\'Verizon\\': (\\'vtext.com\\', \\'vzwpix.com\\'), \\'Virgin Mobile\\': (\\'vmobl.com\\', \\'vmpix.com\\'), \\'Xfinity Mobile\\': (\\'vtext.com\\', \\'mypixmessages.com\\')}\\ndef addr(number, carrier, mms=False):\\n    sms, m = T[carrier]; return \\'%s@%s\\' % (number, (m or sms) if mms else sms)\\nout = (len(T), addr(\\'5555550100\\', \\'AT&T\\'), addr(\\'5555550100\\', \\'AT&T\\', mms=True), addr(\\'5555550100\\', \\'Boost Mobile\\', mms=True), sum(1 for v in T.values() if v[1] is None), addr(\\'5555550100\\', \\'Google Fi\\'), sorted(T)[:3])', g), g['out'])[1])({}) evaluates to (12, '5555550100@txt.att.net', '5555550100@mms.att.net', '5555550100@sms.myboostmobile.com', 5, '5555550100@msg.fi.google.com', ['AT&T', 'Boost Mobile', 'Cricket'])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nT = {\\'AT&T\\': (\\'txt.att.net\\', \\'mms.att.net\\'), \\'Boost Mobile\\': (\\'sms.myboostmobile.com\\', None), \\'Cricket\\': (\\'sms.cricketwireless.net\\', \\'mms.cricketwireless.net\\'), \\'Google Fi\\': (\\'msg.fi.google.com\\', None),\\n     \\'Metro PCS\\': (\\'mymetropcs.com\\', None), \\'Republic Wireless\\': (\\'text.republicwireless.com\\', None), \\'Sprint\\': (\\'messaging.sprintpcs.com\\', \\'pm.sprint.com\\'), \\'T-Mobile\\': (\\'tmomail.net\\', None),\\n     \\'U.S. Cellular\\': (\\'email.uscc.net\\', \\'mms.uscc.net\\'), \\'Verizon\\': (\\'vtext.com\\', \\'vzwpix.com\\'), \\'Virgin Mobile\\': (\\'vmobl.com\\', \\'vmpix.com\\'), \\'Xfinity Mobile\\': (\\'vtext.com\\', \\'mypixmessages.com\\')}\\ndef addr(number, carrier, mms=False):\\n    sms, m = T[carrier]; return \\'%s@%s\\' % (number, (m or sms) if mms else sms)\\nout = (len(T), addr(\\'5555550100\\', \\'AT&T\\'), addr(\\'5555550100\\', \\'AT&T\\', mms=True), addr(\\'5555550100\\', \\'Boost Mobile\\', mms=True), sum(1 for v in T.values() if v[1] is None), addr(\\'5555550100\\', \\'Google Fi\\'), sorted(T)[:3])', g), g['out'])[1])({})" ; chx:output "(12, '5555550100@txt.att.net', '5555550100@mms.att.net', '5555550100@sms.myboostmobile.com', 5, '5555550100@msg.fi.google.com', ['AT&T', 'Boost Mobile', 'Cricket'])" .
