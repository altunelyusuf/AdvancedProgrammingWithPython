chx:X_SpfRecordParse a owl:NamedIndividual, chx:SpfRecordParse ; rdfs:label "dig TXT gmail.com"@en ; skos:definition "An SPF record is a version, mechanisms and a modifier: the TXT record observed for gmail.com on 2026-10-13 was v=spf1 redirect=_spf.google.com, which sends the check to another name, and a sample with 2 include mechanisms, an ip4 range and ~all (softfail) has 2 mechanisms that cost a DNS lookup."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_SpfRecordParse a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nseen = \\'v=spf1 redirect=_spf.google.com\\'\\nmine = \\'v=spf1 include:_spf.google.com include:mailgun.org ip4:203.0.113.0/24 ~all\\'\\ndef parse(r):\\n    parts = r.split(); return parts[0], [p for p in parts[1:] if \\'=\\' in p.split(\\':\\')[0]], [p for p in parts[1:] if p.split(\\':\\')[0].lstrip(\\'+-~?\\') in (\\'include\\', \\'a\\', \\'mx\\', \\'ptr\\', \\'exists\\', \\'ip4\\', \\'ip6\\')], parts[-1]\\nq = {\\'+\\': \\'pass\\', \\'-\\': \\'fail\\', \\'~\\': \\'softfail\\', \\'?\\': \\'neutral\\'}\\nv, mods, mech, last = parse(mine)\\nout = (parse(seen), v, mods, mech, last, q[last[0]], sum(1 for m in mech if m.split(\\':\\')[0] in (\\'include\\', \\'a\\', \\'mx\\', \\'ptr\\', \\'exists\\')))', g), g['out'])[1])({}) evaluates to (('v=spf1', ['redirect=_spf.google.com'], [], 'redirect=_spf.google.com'), 'v=spf1', [], ['include:_spf.google.com', 'include:mailgun.org', 'ip4:203.0.113.0/24'], '~all', 'softfail', 2)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nseen = \\'v=spf1 redirect=_spf.google.com\\'\\nmine = \\'v=spf1 include:_spf.google.com include:mailgun.org ip4:203.0.113.0/24 ~all\\'\\ndef parse(r):\\n    parts = r.split(); return parts[0], [p for p in parts[1:] if \\'=\\' in p.split(\\':\\')[0]], [p for p in parts[1:] if p.split(\\':\\')[0].lstrip(\\'+-~?\\') in (\\'include\\', \\'a\\', \\'mx\\', \\'ptr\\', \\'exists\\', \\'ip4\\', \\'ip6\\')], parts[-1]\\nq = {\\'+\\': \\'pass\\', \\'-\\': \\'fail\\', \\'~\\': \\'softfail\\', \\'?\\': \\'neutral\\'}\\nv, mods, mech, last = parse(mine)\\nout = (parse(seen), v, mods, mech, last, q[last[0]], sum(1 for m in mech if m.split(\\':\\')[0] in (\\'include\\', \\'a\\', \\'mx\\', \\'ptr\\', \\'exists\\')))', g), g['out'])[1])({})" ; chx:output "(('v=spf1', ['redirect=_spf.google.com'], [], 'redirect=_spf.google.com'), 'v=spf1', [], ['include:_spf.google.com', 'include:mailgun.org', 'ip4:203.0.113.0/24'], '~all', 'softfail', 2)" .
