e_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nd = wd()\\nparts = [{\\'mimeType\\': \\'text/plain\\', \\'filename\\': \\'\\', \\'headers\\': [], \\'body\\': {\\'size\\': 1, \\'data\\': b64(\\'x\\')}}, {\\'mimeType\\': \\'image/jpeg\\', \\'filename\\': \\'tulips.jpg\\', \\'headers\\': [], \\'body\\': {\\'attachmentId\\': \\'A1\\', \\'size\\': 4}}, {\\'mimeType\\': \\'image/jpeg\\', \\'filename\\': \\'canal.jpg\\', \\'headers\\': [], \\'body\\': {\\'attachmentId\\': \\'A2\\', \\'size\\': 4}}]\\nm = ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'a@example.com\\', \\'b@example.com\\', \\'s\\', \\'x\\', 1797000000000, parts))\\nopen(\\'tulips.jpg\\', \\'wb\\').write(b\\'MINE\\')\\nh = gm({\\'data\\': b64(b\\'AAAA\\'), \\'size\\': 4}, {\\'data\\': b64(b\\'BBBB\\'), \\'size\\': 4}, {\\'data\\': b64(b\\'CCCC\\'), \\'size\\': 4})\\nr0 = m.downloadAttachment(\\'tulips.jpg\\'); first = open(\\'tulips.jpg\\', \\'rb\\').read()\\nr1 = m.downloadAllAttachments(downloadFolder=\\'vacation2026\\')\\nout = (r0, first, r1, sorted(os.listdir(\\'vacation2026\\')), [x[1].split(\\'?\\')[0] for x in h.log], open(\\'vacation2026/canal.jpg\\', \\'rb\\').read())', g), g['out'])[1])({})" ; chx:output "(None, b'AAAA', ['tulips.jpg', 'canal.jpg'], ['canal.jpg', 'tulips.jpg'], ['users/me/messages/M1/attachments/A1', 'users/me/messages/M1/attachments/A1', 'users/me/messages/M1/attachments/A2'], b'CCCC')" .
chx:X_DownloadOverwrite rd:hasIOExample chx:IO_DownloadOverwrite .
chx:X_FilenameTraversal a owl:NamedIndividual, chx:FilenameTraversal ; rdfs:label "downloadAllAttachments(downloadFolder='inbox')"@en ; skos:definition "An attachment named ../evil.txt was written one level above the download folder: inbox stayed empty, evil.txt appeared beside it, and downloadAllAttachments returned ['../evil.txt'], so a program that downloads attachments from strangers must reduce each name to its last part (os.path.basename gives evil.txt)."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_FilenameTraversal a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nd = wd(); os.mkdir(\\'inbox\\')\\nparts = [{\\'mimeType\\': \\'text/plain\\', \\'filename\\': \\'\\', \\'headers\\': [], \\'body\\': {\\'size\\': 1, \\'data\\': b64(\\'x\\')}}, {\\'mimeType\\': \\'text/plain\\', \\'filename\\': \\'../evil.txt\\', \\'headers\\': [], \\'body\\': {\\'attachmentId\\': \\'A9\\', \\'size\\': 4}}]\\nm = ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'a@example.com\\', \\'b@example.com\\', \\'s\\', \\'x\\', 1797000000000, parts))\\nh = gm({\\'data\\': b64(b\\'PWNED\\'), \\'size\\': 5})\\ndone = m.downloadAllAttachments(downloadFolder=\\'inbox\\')\\nout = (done, os.listdir(\\'inbox\\'), sorted(os.listdir(\\'.\\')), open(\\'evil.txt\\').read(), os.path.basename(\\'../evil.txt\\'), os.path.realpath(\\'inbox/../evil.txt\\') == os.path.realpath(\\'evil.txt\\'))', g), g['out'])[1])({}) evaluates to (['../evil.txt'], [], ['evil.txt', 'inbox'], 'PWNED', 'evil.txt', True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nd = wd(); os.mkdir(\\'inbox\\')\\nparts = [{\\'mimeType\\': \\'text/plain\\', \\'filename\\': \\'\\', \\'headers\\': [], \\'body\\': {\\'size\\': 1, \\'data\\': b64(\\'x\\')}}, {\\'mimeType\\': \\'text/plain\\', \\'filename\\': \\'../evil.txt\\', \\'headers\\': [], \\'body\\': {\\'attachmentId\\': \\'A9\\', \\'size\\': 4}}]\\nm = ezgmail.GmailMessage(api_msg(\\'M1\\', \\'T1\\', \\'a@example.com\\', \\'b@example.com\\', \\'s\\', \\'x\\', 1797000000000, parts))\\nh = gm({\\'data\\': b64(b\\'PWNED\\'), \\'size\\': 5})\\ndone = m.downloadAllAttachments(downloadFolder=\\'inbox\\')\\nout = (done, os.listdir(\\'inbox\\'), sorted(os.listdir(\\'.\\')), open(\\'evil.txt\\').read(), os.path.basename(\\'../evil.txt\\'), os.path.realpath(\\'inbox/../evil.txt\\') == os.path.realpath(\\'evil.txt\\'))', g), g['out'])[1])({})" ; chx:output "(['../evil.txt'], [], ['evil.txt', 'inbox'], 'PWNED', 'evil.txt', True)" .
chx:X_FilenameTraversal rd:hasIOExample chx:IO_FilenameTraversal .
chx:X_EmailMessageBuild a owl:NamedIndividual, chx:EmailMessageBuild ; rdfs:label "EmailMessage()"@en ; skos:definition "EmailMessage with set_content builds a text/plain message whose headers are written in the order they were set (From, To, Subject, Date, Message-ID, then Content-Type, Content-Transfer-Encoding 7bit and MIME-Version); as_bytes() ends lines with LF (0 CRLF) and as_bytes(policy=policy.SMTP) with CRLF (10), and a message read back keeps display name Jon Doe and address jon@example.org apart."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_EmailMessageBuild a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nm = mk()\\nraw = m.as_bytes(); smtp = m.as_bytes(policy=policy.SMTP); back = email.message_from_bytes(raw, policy=policy.default)\\nout = (type(m).__name__, type(m.policy).__name__, raw.decode().splitlines(), raw.count(b\\'\\\\r\\\\n\\'), smtp.count(b\\'\\\\r\\\\n\\'), back[\\'to\\'].addresses[0].display_name, back[\\'to\\'].addresses[0].addr_spec, back.get_content())', g), g['out'])[1])({}) evaluates to ('EmailMessage', 'EmailPolicy', ['From: Al Sweigart <al@example.com>', 'To: Jon Doe <jon@example.org>', 'Subject: RoboCop', 'Date: Fri, 11 Dec 2026 14:48:48 +0000', 'Message-ID: <fixed-1@example.com>', 'Content-Type: text/plain; charset='utf-8'', 'Content-Transfer-Encoding: 7bit', 'MIME-Version: 1.0', '', 'Do you want to watch RoboCop this weekend?'], 0, 10, 'Jon Doe', 'jon@example.org', 'Do you want to watch RoboCop this weekend?\\n')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nm = mk()\\nraw = m.as_bytes(); smtp = m.as_bytes(policy=policy.SMTP); back = email.message_from_bytes(raw, policy=policy.default)\\nout = (type(m).__name__, type(m.policy).__name__, raw.decode().splitlines(), raw.count(b\\'\\\\r\\\\n\\'), smtp.count(b\\'\\\\r\\\\n\\'), back[\\'to\\'].addresses[0].display_name, back[\\'to\\'].addresses[0].addr_spec, back.get_content())', g), g['out'])[1])({})" ; chx:output "('EmailMessage', 'EmailPolicy', ['From: Al Sweigart <al@example.com>', 'To: Jon Doe <jon@example.org>', 'Subject: RoboCop', 'Date: Fri, 11 Dec 2026 14:48:48 +0000', 'Message-ID: <fixed-1@example.com>', 'Content-Type: text/plain; charset='utf-8'', 'Content-Transfer-Encoding: 7bit', 'MIME-Version: 1.0', '', 'Do you want to watch RoboCop this weekend?'], 0, 10, 'Jon Doe', 'jon@example.org', 'Do you want to watch RoboCop this weekend?\\n')" .
chx:X_EmailMessageBuild rd:hasIOExample chx:IO_EmailMessageBuild .
chx:X_MimeTree a owl:NamedIndividual, chx:MimeTree ; rdfs:label "msg.add_alternative(html, subtype='html')"@en ; skos:definition "add_alternative and add_attachment turn the message into multipart/mixed holding multipart/alternative (text/plain and text/html) and application/octet-stream; get_body with preference html and plain returns the html part, and iter_attachments finds poster.bin."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_MimeTree a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nm = mk(); m.add_alternative(\\'<p>Do you want to watch <b>RoboCop</b>?</p>\\', subtype=\\'html\\'); m.add_attachment(b\\'\\\\x00\\\\x01\\\\x02\\', maintype=\\'application\\', subtype=\\'octet-stream\\', filename=\\'poster.bin\\')\\ntree = []\\ndef walk(p, d=0):\\n    tree.append((\\'  \\' * d) + p.get_content_type())\\n    for c in p.iter_parts(): walk(c, d + 1)\\nwalk(m)\\nout = (tree, m.get_body(preferencelist=(\\'plain\\',)).get_content().strip(), m.get_body(preferencelist=(\\'html\\', \\'plain\\')).get_content_type(), [a.get_filename() for a in m.iter_attachments()], m.get_boundary() is not None, m.is_multipart())', g), g['out'])[1])({}) evaluates to (['multipart/mixed', '  multipart/alternative', '    text/plain', '    text/html', '  application/octet-stream'], 'Do you want to watch RoboCop this weekend?', 'text/html', ['poster.bin'], False, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nm = mk(); m.add_alternative(\\'<p>Do you want to watch <b>RoboCop</b>?</p>\\', subtype=\\'html\\'); m.add_attachment(b\\'\\\\x00\\\\x01\\\\x02\\', maintype=\\'application\\', subtype=\\'octet-stream\\', filename=\\'poster.bin\\')\\ntree = []\\ndef walk(p, d=0):\\n    tree.append((\\'  \\' * d) + p.get_content_type())\\n    for c in p.iter_parts(): walk(c, d + 1)\\nwalk(m)\\nout = (tree, m.get_body(preferencelist=(\\'plain\\',)).get_content().strip(), m.get_body(preferencelist=(\\'html\\', \\'plain\\')).get_content_type(), [a.get_filename() for a in m.iter_attachments()], m.get_boundary() is not None, m.is_multipart())', g), g['out'])[1])({})" ; chx:output "(['multipart/mixed', '  multipart/alternative', '    text/plain', '    text/html', '  application/octet-stream'], 'Do you want to watch RoboCop this weekend?', 'text/html', ['poster.bin'], False, True)" .
