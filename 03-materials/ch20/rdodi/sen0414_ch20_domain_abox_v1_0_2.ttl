chx:X_ExampleDates a owl:NamedIndividual, chx:ExampleDates ; rdfs:label "datetime.datetime.fromtimestamp(1797823712)"@en ; skos:definition "str(datetime.datetime.fromtimestamp(1797823712)) is 2026-12-20 21:28:32 only in a zone at UTC-6 such as America/Chicago (offset -6.0 hours); in UTC it is 2026-12-21 03:28:32, in Europe/Istanbul 2026-12-21 06:28:32, and that moment is a Monday 69 days after 2026-10-13."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_ExampleDates a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nts = 1797823712\\nos.environ[\\'TZ\\'] = \\'America/Chicago\\'; time.tzset(); chi = str(DT.fromtimestamp(ts))\\nos.environ[\\'TZ\\'] = \\'UTC\\'; time.tzset(); utc = str(DT.fromtimestamp(ts))\\nos.environ[\\'TZ\\'] = \\'Europe/Istanbul\\'; time.tzset(); ist = str(DT.fromtimestamp(ts))\\nout = (chi, utc, ist, str(DT.fromtimestamp(ts, ZoneInfo(\\'America/Chicago\\'))), DT.fromtimestamp(ts, ZoneInfo(\\'America/Chicago\\')).utcoffset().total_seconds() / 3600, DT.fromtimestamp(ts, UTC).strftime(\\'%A\\'), (DT.fromtimestamp(ts, UTC).date() - D(2026, 10, 13)).days)', g), g['out'])[1])({}) evaluates to ('2026-12-20 21:28:32', '2026-12-21 03:28:32', '2026-12-21 06:28:32', '2026-12-20 21:28:32-06:00', -6.0, 'Monday', 69)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nts = 1797823712\\nos.environ[\\'TZ\\'] = \\'America/Chicago\\'; time.tzset(); chi = str(DT.fromtimestamp(ts))\\nos.environ[\\'TZ\\'] = \\'UTC\\'; time.tzset(); utc = str(DT.fromtimestamp(ts))\\nos.environ[\\'TZ\\'] = \\'Europe/Istanbul\\'; time.tzset(); ist = str(DT.fromtimestamp(ts))\\nout = (chi, utc, ist, str(DT.fromtimestamp(ts, ZoneInfo(\\'America/Chicago\\'))), DT.fromtimestamp(ts, ZoneInfo(\\'America/Chicago\\')).utcoffset().total_seconds() / 3600, DT.fromtimestamp(ts, UTC).strftime(\\'%A\\'), (DT.fromtimestamp(ts, UTC).date() - D(2026, 10, 13)).days)', g), g['out'])[1])({})" ; chx:output "('2026-12-20 21:28:32', '2026-12-21 03:28:32', '2026-12-21 06:28:32', '2026-12-20 21:28:32-06:00', -6.0, 'Monday', 69)" .
chx:X_ExampleDates rd:hasIOExample chx:IO_ExampleDates .
chx:X_AppendixAnswers a owl:NamedIndividual, chx:AppendixAnswers ; rdfs:label "ezgmail.search('has:attachment')"@en ; skos:definition "Appendix B answers Question 3 with the text has:attachment passed to search(), which asked the API for users/me/threads?q=has:attachment&maxResults=25 and returned GmailThread objects, and Question 5 with the Requests library, which is true and means no ntfy-specific package is needed; Question 1 says the two files tell EZGmail which account to use, which describes token.json more than credentials.json."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_AppendixAnswers a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({\\'threads\\': [{\\'id\\': \\'T1\\', \\'snippet\\': \\'s\\', \\'historyId\\': \\'1\\'}]})\\nr = ezgmail.search(\\'has:attachment\\')\\nq = h.log[0][1]\\nout = (q, [type(x).__name__ for x in r], ezgmail.search.__defaults__, \\'has:attachment\\' in q.replace(\\'%3A\\', \\':\\'))', g), g['out'])[1])({}) evaluates to ('users/me/threads?q=has%3Aattachment&maxResults=25&alt=json', ['GmailThread'], (25, 'me'), True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({\\'threads\\': [{\\'id\\': \\'T1\\', \\'snippet\\': \\'s\\', \\'historyId\\': \\'1\\'}]})\\nr = ezgmail.search(\\'has:attachment\\')\\nq = h.log[0][1]\\nout = (q, [type(x).__name__ for x in r], ezgmail.search.__defaults__, \\'has:attachment\\' in q.replace(\\'%3A\\', \\':\\'))', g), g['out'])[1])({})" ; chx:output "('users/me/threads?q=has%3Aattachment&maxResults=25&alt=json', ['GmailThread'], (25, 'me'), True)" .
