chx:X_SharedGateway a owl:NamedIndividual, chx:SharedGateway ; rdfs:label "number@vtext.com"@en ; skos:definition "Verizon and Xfinity Mobile share the SMS domain vtext.com, so of the 12 rows only 11 SMS domains are distinct and the address 5555550100@vtext.com does not say which carrier is meant; their MMS domains differ (vzwpix.com and mypixmessages.com)."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_SharedGateway a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nT = {\\'AT&T\\': (\\'txt.att.net\\', \\'mms.att.net\\'), \\'Boost Mobile\\': (\\'sms.myboostmobile.com\\', None), \\'Cricket\\': (\\'sms.cricketwireless.net\\', \\'mms.cricketwireless.net\\'), \\'Google Fi\\': (\\'msg.fi.google.com\\', None),\\n     \\'Metro PCS\\': (\\'mymetropcs.com\\', None), \\'Republic Wireless\\': (\\'text.republicwireless.com\\', None), \\'Sprint\\': (\\'messaging.sprintpcs.com\\', \\'pm.sprint.com\\'), \\'T-Mobile\\': (\\'tmomail.net\\', None),\\n     \\'U.S. Cellular\\': (\\'email.uscc.net\\', \\'mms.uscc.net\\'), \\'Verizon\\': (\\'vtext.com\\', \\'vzwpix.com\\'), \\'Virgin Mobile\\': (\\'vmobl.com\\', \\'vmpix.com\\'), \\'Xfinity Mobile\\': (\\'vtext.com\\', \\'mypixmessages.com\\')}\\ndef addr(number, carrier, mms=False):\\n    sms, m = T[carrier]; return \\'%s@%s\\' % (number, (m or sms) if mms else sms)\\nfrom collections import Counter\\ncnt = Counter(v[0] for v in T.values()); dup = [k for k, n in cnt.items() if n > 1]\\nout = (len(set(v[0] for v in T.values())), dup, [c for c, v in T.items() if v[0] == \\'vtext.com\\'], addr(\\'5555550100\\', \\'Verizon\\') == addr(\\'5555550100\\', \\'Xfinity Mobile\\'), addr(\\'5555550100\\', \\'Verizon\\', True) == addr(\\'5555550100\\', \\'Xfinity Mobile\\', True))', g), g['out'])[1])({}) evaluates to (11, ['vtext.com'], ['Verizon', 'Xfinity Mobile'], True, False)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nT = {\\'AT&T\\': (\\'txt.att.net\\', \\'mms.att.net\\'), \\'Boost Mobile\\': (\\'sms.myboostmobile.com\\', None), \\'Cricket\\': (\\'sms.cricketwireless.net\\', \\'mms.cricketwireless.net\\'), \\'Google Fi\\': (\\'msg.fi.google.com\\', None),\\n     \\'Metro PCS\\': (\\'mymetropcs.com\\', None), \\'Republic Wireless\\': (\\'text.republicwireless.com\\', None), \\'Sprint\\': (\\'messaging.sprintpcs.com\\', \\'pm.sprint.com\\'), \\'T-Mobile\\': (\\'tmomail.net\\', None),\\n     \\'U.S. Cellular\\': (\\'email.uscc.net\\', \\'mms.uscc.net\\'), \\'Verizon\\': (\\'vtext.com\\', \\'vzwpix.com\\'), \\'Virgin Mobile\\': (\\'vmobl.com\\', \\'vmpix.com\\'), \\'Xfinity Mobile\\': (\\'vtext.com\\', \\'mypixmessages.com\\')}\\ndef addr(number, carrier, mms=False):\\n    sms, m = T[carrier]; return \\'%s@%s\\' % (number, (m or sms) if mms else sms)\\nfrom collections import Counter\\ncnt = Counter(v[0] for v in T.values()); dup = [k for k, n in cnt.items() if n > 1]\\nout = (len(set(v[0] for v in T.values())), dup, [c for c, v in T.items() if v[0] == \\'vtext.com\\'], addr(\\'5555550100\\', \\'Verizon\\') == addr(\\'5555550100\\', \\'Xfinity Mobile\\'), addr(\\'5555550100\\', \\'Verizon\\', True) == addr(\\'5555550100\\', \\'Xfinity Mobile\\', True))', g), g['out'])[1])({})" ; chx:output "(11, ['vtext.com'], ['Verizon', 'Xfinity Mobile'], True, False)" .
