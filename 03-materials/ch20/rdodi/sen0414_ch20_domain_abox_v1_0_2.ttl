chx:X_VerizonNotice a owl:NamedIndividual, chx:VerizonNotice ; rdfs:label "vtext.com"@en ; skos:definition "Verizon's notice says it has begun to shut down email-to-text for vtext.com and vzwpix.com, expects it to be complete by 03/31/2027 (a Wednesday, 169 days after 2026-10-13) and says some senders may lose access earlier, so the gateway the chapter uses in its example (2125551234@vtext.com) is on a schedule to end."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_VerizonNotice a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nT = {\\'AT&T\\': (\\'txt.att.net\\', \\'mms.att.net\\'), \\'Boost Mobile\\': (\\'sms.myboostmobile.com\\', None), \\'Cricket\\': (\\'sms.cricketwireless.net\\', \\'mms.cricketwireless.net\\'), \\'Google Fi\\': (\\'msg.fi.google.com\\', None),\\n     \\'Metro PCS\\': (\\'mymetropcs.com\\', None), \\'Republic Wireless\\': (\\'text.republicwireless.com\\', None), \\'Sprint\\': (\\'messaging.sprintpcs.com\\', \\'pm.sprint.com\\'), \\'T-Mobile\\': (\\'tmomail.net\\', None),\\n     \\'U.S. Cellular\\': (\\'email.uscc.net\\', \\'mms.uscc.net\\'), \\'Verizon\\': (\\'vtext.com\\', \\'vzwpix.com\\'), \\'Virgin Mobile\\': (\\'vmobl.com\\', \\'vmpix.com\\'), \\'Xfinity Mobile\\': (\\'vtext.com\\', \\'mypixmessages.com\\')}\\ndef addr(number, carrier, mms=False):\\n    sms, m = T[carrier]; return \\'%s@%s\\' % (number, (m or sms) if mms else sms)\\nend = D(2027, 3, 31); on = D(2026, 10, 13)\\nout = (T[\\'Verizon\\'], (end - on).days, end.strftime(\\'%A\\'), (end - D(2025, 6, 17)).days)', g), g['out'])[1])({}) evaluates to (('vtext.com', 'vzwpix.com'), 169, 'Wednesday', 652)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nT = {\\'AT&T\\': (\\'txt.att.net\\', \\'mms.att.net\\'), \\'Boost Mobile\\': (\\'sms.myboostmobile.com\\', None), \\'Cricket\\': (\\'sms.cricketwireless.net\\', \\'mms.cricketwireless.net\\'), \\'Google Fi\\': (\\'msg.fi.google.com\\', None),\\n     \\'Metro PCS\\': (\\'mymetropcs.com\\', None), \\'Republic Wireless\\': (\\'text.republicwireless.com\\', None), \\'Sprint\\': (\\'messaging.sprintpcs.com\\', \\'pm.sprint.com\\'), \\'T-Mobile\\': (\\'tmomail.net\\', None),\\n     \\'U.S. Cellular\\': (\\'email.uscc.net\\', \\'mms.uscc.net\\'), \\'Verizon\\': (\\'vtext.com\\', \\'vzwpix.com\\'), \\'Virgin Mobile\\': (\\'vmobl.com\\', \\'vmpix.com\\'), \\'Xfinity Mobile\\': (\\'vtext.com\\', \\'mypixmessages.com\\')}\\ndef addr(number, carrier, mms=False):\\n    sms, m = T[carrier]; return \\'%s@%s\\' % (number, (m or sms) if mms else sms)\\nend = D(2027, 3, 31); on = D(2026, 10, 13)\\nout = (T[\\'Verizon\\'], (end - on).days, end.strftime(\\'%A\\'), (end - D(2025, 6, 17)).days)', g), g['out'])[1])({})" ; chx:output "(('vtext.com', 'vzwpix.com'), 169, 'Wednesday', 652)" .
chx:X_VerizonNotice rd:hasIOExample chx:IO_VerizonNotice .
chx:X_DomainStatus a owl:NamedIndividual, chx:DomainStatus ; rdfs:label "dig MX txt.att.net"@en ; skos:definition "A DNS-over-HTTPS query on 2026-10-13 for the MX records of the 18 gateway domains of Table 20-1 found no MX for txt.att.net and mms.att.net (answered NOERROR with no records) and none for sms.cricketwireless.net (NOERROR, with names that carry no MX priority), NXDOMAIN for messaging.sprintpcs.com and pm.sprint.com and SERVFAIL for sms.myboostmobile.com, and mail exchangers for the other 12; a missing MX is a symptom, not proof that delivery fails. Recorded in the live observations."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_TwilioInstead a owl:NamedIndividual, chx:TwilioInstead ; rdfs:label "GET https://api.twilio.com/2010-04-01/Accounts.json"@en ; skos:definition "The chapter names Twilio as the reliable way to send texts and describes it as a service that may need a subscription, fees and an application; Twilio's REST API answered a request with no credentials with HTTP 401 and {'code':20003,'message':'Authentication Error - No credentials provided'}, which is all this study could observe without an account. Recorded in the live observations; no message was sent."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_Gsm7Length a owl:NamedIndividual, chx:Gsm7Length ; rdfs:label "(140 bytes * 8 bits) / 7 bits"@en ; skos:definition "A text message carries 140 bytes, which hold 160 characters of 7 bits (GSM-7): 160 characters of the basic set fit one message and 161 need 2, a character of the extension table ({ } [ ] \\ ^ ~ | €) counts twice so {x} costs 5, and Yedekleme tamamlandi without the dotless i is 20 GSM-7 characters; a longer text is split into segments of 153 characters, a figure that comes from the 6-byte concatenation header (134 bytes of 8 bits as 7-bit characters) and not from a page opened by this study."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_Gsm7Length a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nBASIC = \\'@£$¥èéùìòÇ\\\\nØø\\\\rÅåΔ_ΦΓΛΩΠΨΣΘΞ\\\\x1bÆæßÉ !\\x22#¤%&\\\\\\'()*+,-./0123456789:;<=>?¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà\\'\\nEXT = \\'^{}\\\\\\\\[~]|€\\'\\ndef septets(t):\\n    n = 0\\n    for ch in t:\\n        if ch in BASIC: n += 1\\n        elif ch in EXT: n += 2\\n        else: return None\\n    return n\\ndef segments(t):\\n    s = septets(t)\\n    if s is not None: return (\\'GSM-7\\', s, 1 if s <= 160 else -(-s // 153))\\n    u = len(t.encode(\\'utf-16-le\\')) // 2; return (\\'UCS-2\\', u, 1 if u <= 70 else -(-u // 67))\\nt160 = \\'a\\' * 160\\nout = (140 * 8 // 7, septets(\\'Hello, world!\\'), segments(t160), segments(t160 + \\'a\\'), segments(\\'a\\' * 306), segments(\\'a\\' * 307), septets(\\'{x}\\'), septets(\\'€5\\'), segments(\\'Yedekleme tamamlandi\\'), segments(\\'Umbrella: bring one \\\\u2602\\'))', g), g['out'])[1])({}) evaluates to (160, 13, ('GSM-7', 160, 1), ('GSM-7', 161, 2), ('GSM-7', 306, 2), ('GSM-7', 307, 3), 5, 3, ('GSM-7', 20, 1), ('UCS-2', 21, 1))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nBASIC = \\'@£$¥èéùìòÇ\\\\nØø\\\\rÅåΔ_ΦΓΛΩΠΨΣΘΞ\\\\x1bÆæßÉ !\\x22#¤%&\\\\\\'()*+,-./0123456789:;<=>?¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà\\'\\nEXT = \\'^{}\\\\\\\\[~]|€\\'\\ndef septets(t):\\n    n = 0\\n    for ch in t:\\n        if ch in BASIC: n += 1\\n        elif ch in EXT: n += 2\\n        else: return None\\n    return n\\ndef segments(t):\\n    s = septets(t)\\n    if s is not None: return (\\'GSM-7\\', s, 1 if s <= 160 else -(-s // 153))\\n    u = len(t.encode(\\'utf-16-le\\')) // 2; return (\\'UCS-2\\', u, 1 if u <= 70 else -(-u // 67))\\nt160 = \\'a\\' * 160\\nout = (140 * 8 // 7, septets(\\'Hello, world!\\'), segments(t160), segments(t160 + \\'a\\'), segments(\\'a\\' * 306), segments(\\'a\\' * 307), septets(\\'{x}\\'), septets(\\'€5\\'), segments(\\'Yedekleme tamamlandi\\'), segments(\\'Umbrella: bring one \\\\u2602\\'))', g), g['out'])[1])({})" ; chx:output "(160, 13, ('GSM-7', 160, 1), ('GSM-7', 161, 2), ('GSM-7', 306, 2), ('GSM-7', 307, 3), 5, 3, ('GSM-7', 20, 1), ('UCS-2', 21, 1))" .
chx:X_Gsm7Length rd:hasIOExample chx:IO_Gsm7Length .
chx:X_Ucs2Length a owl:NamedIndividual, chx:Ucs2Length ; rdfs:label "len(text.encode('utf-16-le')) // 2"@en ; skos:definition "A character outside the GSM-7 sets, such as the dotless i of Yedekleme tamamlandı, makes the whole text UCS-2 at 16 bits a character: 70 characters fit one message (140 bytes / 2 bytes), 71 need 2, and an emoji is 2 code units, so 35 emoji fit and 36 do not; a long UCS-2 text is split into segments of 67 characters by the same concatenation arithmetic (134 bytes / 2), not confirmed from a page opened by this study."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_Ucs2Length a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nBASIC = \\'@£$¥èéùìòÇ\\\\nØø\\\\rÅåΔ_ΦΓΛΩΠΨΣΘΞ\\\\x1bÆæßÉ !\\x22#¤%&\\\\\\'()*+,-./0123456789:;<=>?¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà\\'\\nEXT = \\'^{}\\\\\\\\[~]|€\\'\\ndef septets(t):\\n    n = 0\\n    for ch in t:\\n        if ch in BASIC: n += 1\\n        elif ch in EXT: n += 2\\n        else: return None\\n    return n\\ndef segments(t):\\n    s = septets(t)\\n    if s is not None: return (\\'GSM-7\\', s, 1 if s <= 160 else -(-s // 153))\\n    u = len(t.encode(\\'utf-16-le\\')) // 2; return (\\'UCS-2\\', u, 1 if u <= 70 else -(-u // 67))\\nt = \\'Yedekleme tamamlandı\\'\\nout = (segments(t), \\'ı\\' in BASIC, len(t), segments(\\'ş\\' * 70), segments(\\'ş\\' * 71), segments(\\'ş\\' * 134), segments(\\'ş\\' * 135), len(\\'\\\\U0001F600\\'), len(\\'\\\\U0001F600\\'.encode(\\'utf-16-le\\')) // 2, segments(\\'\\\\U0001F600\\' * 35), segments(\\'\\\\U0001F600\\' * 36))', g), g['out'])[1])({}) evaluates to (('UCS-2', 20, 1), False, 20, ('UCS-2', 70, 1), ('UCS-2', 71, 2), ('UCS-2', 134, 2), ('UCS-2', 135, 3), 1, 2, ('UCS-2', 70, 1), ('UCS-2', 72, 2))"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nBASIC = \\'@£$¥èéùìòÇ\\\\nØø\\\\rÅåΔ_ΦΓΛΩΠΨΣΘΞ\\\\x1bÆæßÉ !\\x22#¤%&\\\\\\'()*+,-./0123456789:;<=>?¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà\\'\\nEXT = \\'^{}\\\\\\\\[~]|€\\'\\ndef septets(t):\\n    n = 0\\n    for ch in t:\\n        if ch in BASIC: n += 1\\n        elif ch in EXT: n += 2\\n        else: return None\\n    return n\\ndef segments(t):\\n    s = septets(t)\\n    if s is not None: return (\\'GSM-7\\', s, 1 if s <= 160 else -(-s // 153))\\n    u = len(t.encode(\\'utf-16-le\\')) // 2; return (\\'UCS-2\\', u, 1 if u <= 70 else -(-u // 67))\\nt = \\'Yedekleme tamamlandı\\'\\nout = (segments(t), \\'ı\\' in BASIC, len(t), segments(\\'ş\\' * 70), segments(\\'ş\\' * 71), segments(\\'ş\\' * 134), segments(\\'ş\\' * 135), len(\\'\\\\U0001F600\\'), len(\\'\\\\U0001F600\\'.encode(\\'utf-16-le\\')) // 2, segments(\\'\\\\U0001F600\\' * 35), segments(\\'\\\\U0001F600\\' * 36))', g), g['out'])[1])({})" ; chx:output "(('UCS-2', 20, 1), False, 20, ('UCS-2', 70, 1), ('UCS-2', 71, 2), ('UCS-2', 134, 2), ('UCS-2', 135, 3), 1, 2, ('UCS-2', 70, 1), ('UCS-2', 72, 2))" .
chx:X_Ucs2Length rd:hasIOExample chx:IO_Ucs2Length .
chx:X_PostBody a owl:NamedIndividual, chx:PostBody ; rdfs:label "requests.post('https://ntfy.sh/topic', 'Hello, world!')"@en ; skos:definition "On a local recorder that stands in for the service, requests.post(url, 'Hello, world!') sent a POST to the path /AlSweigartZPgxBQ42 with the 13 bytes as the body, Content-Length 13, no Content-Type and a python-requests User-Agent, and returned a Response with status 200; the recorder is not ntfy."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_PostBody a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(200, \\'{}\\')\\nr = requests.post(base + \\'/AlSweigartZPgxBQ42\\', \\'Hello, world!\\')\\nq = log[0]\\nout = (r.status_code, r.ok, q[\\'method\\'], q[\\'path\\'], q[\\'body\\'], q[\\'headers\\'].get(\\'Content-Length\\'), q[\\'headers\\'].get(\\'Content-Type\\'), q[\\'headers\\'][\\'User-Agent\\'].startswith(\\'python-requests/\\'), q[\\'headers\\'][\\'Host\\'].startswith(\\'127.0.0.1:\\'))\\nsrv.shutdown()', g), g['out'])[1])({}) evaluates to (200, True, 'POST', '/AlSweigartZPgxBQ42', b'Hello, world!', '13', None, True, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(200, \\'{}\\')\\nr = requests.post(base + \\'/AlSweigartZPgxBQ42\\', \\'Hello, world!\\')\\nq = log[0]\\nout = (r.status_code, r.ok, q[\\'method\\'], q[\\'path\\'], q[\\'body\\'], q[\\'headers\\'].get(\\'Content-Length\\'), q[\\'headers\\'].get(\\'Content-Type\\'), q[\\'headers\\'][\\'User-Agent\\'].startswith(\\'python-requests/\\'), q[\\'headers\\'][\\'Host\\'].startswith(\\'127.0.0.1:\\'))\\nsrv.shutdown()', g), g['out'])[1])({})" ; chx:output "(200, True, 'POST', '/AlSweigartZPgxBQ42', b'Hello, world!', '13', None, True, True)" .
chx:X_PostBody rd:hasIOExample chx:IO_PostBody .
chx:X_MetadataHeaders a owl:NamedIndividual, chx:MetadataHeaders ; rdfs:label "headers={'Title': ..., 'Tags': ..., 'Priority': '5'}"@en ; skos:definition "The three headers arrived unchanged (Title Important: Read this!, Tags warning,neutral_face, Priority 5), a Priority given as the integer 5 raised InvalidHeader because header values must be str or bytes, and a Title with a dotless i raised UnicodeEncodeError because requests encodes header values as latin-1."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_MetadataHeaders a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(200, \\'{}\\')\\nrequests.post(base + \\'/t\\', \\'The rent is too high!\\', headers={\\'Title\\': \\'Important: Read this!\\', \\'Tags\\': \\'warning,neutral_face\\', \\'Priority\\': \\'5\\'})\\nh = log[0][\\'headers\\']\\ne1 = err(lambda: requests.post(base + \\'/t\\', \\'x\\', headers={\\'Priority\\': 5}))\\ne2 = err(lambda: requests.post(base + \\'/t\\', \\'x\\', headers={\\'Title\\': \\'Yedekleme tamamlandı\\'}))\\nout = ({k: h[k] for k in (\\'Title\\', \\'Tags\\', \\'Priority\\')}, e1[0], e1[1][:60], e2[0], e2[1][:50], len(log))\\nsrv.shutdown()', g), g['out'])[1])({}) evaluates to ({'Title': 'Important: Read this!', 'Tags': 'warning,neutral_face', 'Priority': '5'}, 'InvalidHeader', 'Header part (5) from ('Priority', 5) must be of type str or ', 'UnicodeEncodeError', ''latin-1' codec can't encode character '\\\\u0131' in', 1)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(200, \\'{}\\')\\nrequests.post(base + \\'/t\\', \\'The rent is too high!\\', headers={\\'Title\\': \\'Important: Read this!\\', \\'Tags\\': \\'warning,neutral_face\\', \\'Priority\\': \\'5\\'})\\nh = log[0][\\'headers\\']\\ne1 = err(lambda: requests.post(base + \\'/t\\', \\'x\\', headers={\\'Priority\\': 5}))\\ne2 = err(lambda: requests.post(base + \\'/t\\', \\'x\\', headers={\\'Title\\': \\'Yedekleme tamamlandı\\'}))\\nout = ({k: h[k] for k in (\\'Title\\', \\'Tags\\', \\'Priority\\')}, e1[0], e1[1][:60], e2[0], e2[1][:50], len(log))\\nsrv.shutdown()', g), g['out'])[1])({})" ; chx:output "({'Title': 'Important: Read this!', 'Tags': 'warning,neutral_face', 'Priority': '5'}, 'InvalidHeader', 'Header part (5) from ('Priority', 5) must be of type str or ', 'UnicodeEncodeError', ''latin-1' codec can't encode character '\\\\u0131' in', 1)" .
chx:X_MetadataHeaders rd:hasIOExample chx:IO_MetadataHeaders .
chx:X_BodyEncoding a owl:NamedIndividual, chx:BodyEncoding ; rdfs:label "requests.post(url, 'Yedekleme tamamlandı')"@en ; skos:definition "With urllib3 2.8.0 a str body is sent as UTF-8 (b'Yedekleme tamamland\\xc4\\xb1'), 21 bytes for 20 characters, with no Content-Type header, so a receiver has to assume the charset; encoding by hand to latin-1 with replace gave b'Yedekleme tamamland?', and an explicit Content-Type text/plain; charset=utf-8 was passed through."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_BodyEncoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(200, \\'{}\\')\\nt = \\'Yedekleme tamamlandı\\'\\nrequests.post(base + \\'/t\\', t); requests.post(base + \\'/t\\', \\'café\\'); requests.post(base + \\'/t\\', t.encode(\\'latin-1\\', \\'replace\\')); requests.post(base + \\'/t\\', t, headers={\\'Content-Type\\': \\'text/plain; charset=utf-8\\'})\\nout = (log[0][\\'body\\'], log[0][\\'headers\\'][\\'Content-Length\\'], len(t), len(t.encode()), log[0][\\'body\\'].decode(\\'utf-8\\'), log[1][\\'body\\'], log[2][\\'body\\'], log[0][\\'headers\\'].get(\\'Content-Type\\'), log[3][\\'headers\\'][\\'Content-Type\\'], md.version(\\'urllib3\\'))\\nsrv.shutdown()', g), g['out'])[1])({}) evaluates to (b'Yedekleme tamamland\\xc4\\xb1', '21', 20, 21, 'Yedekleme tamamlandı', b'caf\\xc3\\xa9', b'Yedekleme tamamland?', None, 'text/plain; charset=utf-8', '2.8.0')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(200, \\'{}\\')\\nt = \\'Yedekleme tamamlandı\\'\\nrequests.post(base + \\'/t\\', t); requests.post(base + \\'/t\\', \\'café\\'); requests.post(base + \\'/t\\', t.encode(\\'latin-1\\', \\'replace\\')); requests.post(base + \\'/t\\', t, headers={\\'Content-Type\\': \\'text/plain; charset=utf-8\\'})\\nout = (log[0][\\'body\\'], log[0][\\'headers\\'][\\'Content-Length\\'], len(t), len(t.encode()), log[0][\\'body\\'].decode(\\'utf-8\\'), log[1][\\'body\\'], log[2][\\'body\\'], log[0][\\'headers\\'].get(\\'Content-Type\\'), log[3][\\'headers\\'][\\'Content-Type\\'], md.version(\\'urllib3\\'))\\nsrv.shutdown()', g), g['out'])[1])({})" ; chx:output "(b'Yedekleme tamamland\\xc4\\xb1', '21', 20, 21, 'Yedekleme tamamlandı', b'caf\\xc3\\xa9', b'Yedekleme tamamland?', None, 'text/plain; charset=utf-8', '2.8.0')" .
