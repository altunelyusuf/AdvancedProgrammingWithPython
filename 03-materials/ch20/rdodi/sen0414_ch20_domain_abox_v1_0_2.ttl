chx:X_PollUrl a owl:NamedIndividual, chx:PollUrl ; rdfs:label "requests.get('https://ntfy.sh/topic/json?poll=1&since=10m')"@en ; skos:definition "The poll is a GET of /topic/json with poll=1 and optionally since=10m, since=2h30m or since=1737866912, and requests builds the same query from params={'poll': 1, 'since': '2h30m'}; all four requests reached the recorder as GET."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_PollUrl a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(200, \\'\\')\\nrequests.get(base + \\'/AlSweigartZPgxBQ42/json?poll=1\\'); requests.get(base + \\'/AlSweigartZPgxBQ42/json?poll=1&since=10m\\')\\nrequests.get(base + \\'/AlSweigartZPgxBQ42/json\\', params={\\'poll\\': 1, \\'since\\': \\'2h30m\\'}); requests.get(base + \\'/AlSweigartZPgxBQ42/json\\', params={\\'poll\\': 1, \\'since\\': 1737866912})\\nout = ([x[\\'path\\'] for x in log], [x[\\'method\\'] for x in log], requests.Request(\\'GET\\', \\'https://ntfy.sh/t/json\\', params={\\'poll\\': 1}).prepare().url)\\nsrv.shutdown()', g), g['out'])[1])({}) evaluates to (['/AlSweigartZPgxBQ42/json?poll=1', '/AlSweigartZPgxBQ42/json?poll=1&since=10m', '/AlSweigartZPgxBQ42/json?poll=1&since=2h30m', '/AlSweigartZPgxBQ42/json?poll=1&since=1737866912'], ['GET', 'GET', 'GET', 'GET'], 'https://ntfy.sh/t/json?poll=1')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(200, \\'\\')\\nrequests.get(base + \\'/AlSweigartZPgxBQ42/json?poll=1\\'); requests.get(base + \\'/AlSweigartZPgxBQ42/json?poll=1&since=10m\\')\\nrequests.get(base + \\'/AlSweigartZPgxBQ42/json\\', params={\\'poll\\': 1, \\'since\\': \\'2h30m\\'}); requests.get(base + \\'/AlSweigartZPgxBQ42/json\\', params={\\'poll\\': 1, \\'since\\': 1737866912})\\nout = ([x[\\'path\\'] for x in log], [x[\\'method\\'] for x in log], requests.Request(\\'GET\\', \\'https://ntfy.sh/t/json\\', params={\\'poll\\': 1}).prepare().url)\\nsrv.shutdown()', g), g['out'])[1])({})" ; chx:output "(['/AlSweigartZPgxBQ42/json?poll=1', '/AlSweigartZPgxBQ42/json?poll=1&since=10m', '/AlSweigartZPgxBQ42/json?poll=1&since=2h30m', '/AlSweigartZPgxBQ42/json?poll=1&since=1737866912'], ['GET', 'GET', 'GET', 'GET'], 'https://ntfy.sh/t/json?poll=1')" .
