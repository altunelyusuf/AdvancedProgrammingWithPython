chx:X_SummaryLine a owl:NamedIndividual, chx:SummaryLine ; rdfs:label "ezgmail.summary(threads)"@en ; skos:definition "summary prints the first names of the senders, the snippet and the month and day of each thread, as in Al, Jon - Do you want to watch RoboCop this weekend? - Dec 11, and it cuts the last character off a sender written without a space: noreply@example.com is printed as noreply@example.co."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_SummaryLine a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({\\'id\\': \\'T1\\', \\'messages\\': [api_msg(\\'M1\\', \\'T1\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Jon <j@example.com>\\', \\'RoboCop\\', \\'Do you want to watch RoboCop this weekend?\\', 1797000000000), api_msg(\\'M2\\', \\'T1\\', \\'Jon Doe <j@example.com>\\', \\'Al <a@example.com>\\', \\'Re: RoboCop\\', \\'Yes\\', 1797000100000)]},\\n        {\\'id\\': \\'T2\\', \\'messages\\': [api_msg(\\'M3\\', \\'T2\\', \\'noreply@example.com\\', \\'j@example.com\\', \\'News\\', \\'Thanks for stopping me from buying Bitcoin.\\', 1797000200000)]})\\nths = [ezgmail.GmailThread({\\'id\\': \\'T1\\', \\'snippet\\': \\'Do you want to watch RoboCop this weekend?\\', \\'historyId\\': \\'1\\'}), ezgmail.GmailThread({\\'id\\': \\'T2\\', \\'snippet\\': \\'Thanks for stopping me from buying Bitcoin.\\', \\'historyId\\': \\'1\\'})]\\nbuf = io.StringIO()\\nwith contextlib.redirect_stdout(buf): ezgmail.summary(ths)\\nraw = ezgmail.summary(ths, printInfo=False)\\nout = (buf.getvalue().splitlines(), [(x[0], x[1][:12]) for x in raw], \\'noreply@example.com\\'[: \\'noreply@example.com\\'.find(\\' \\')])', g), g['out'])[1])({}) evaluates to (['Al, Jon - Do you want to watch RoboCop this weekend? - Dec 11', 'noreply@example.co - Thanks for stopping me from buying Bitcoin. - Dec 11'], [(['Al Sweigart <al@inventwithpython.com>', 'Jon Doe <j@example.com>'], 'Do you want '), (['noreply@example.com'], 'Thanks for s')], 'noreply@example.co')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({\\'id\\': \\'T1\\', \\'messages\\': [api_msg(\\'M1\\', \\'T1\\', \\'Al Sweigart <al@inventwithpython.com>\\', \\'Jon <j@example.com>\\', \\'RoboCop\\', \\'Do you want to watch RoboCop this weekend?\\', 1797000000000), api_msg(\\'M2\\', \\'T1\\', \\'Jon Doe <j@example.com>\\', \\'Al <a@example.com>\\', \\'Re: RoboCop\\', \\'Yes\\', 1797000100000)]},\\n        {\\'id\\': \\'T2\\', \\'messages\\': [api_msg(\\'M3\\', \\'T2\\', \\'noreply@example.com\\', \\'j@example.com\\', \\'News\\', \\'Thanks for stopping me from buying Bitcoin.\\', 1797000200000)]})\\nths = [ezgmail.GmailThread({\\'id\\': \\'T1\\', \\'snippet\\': \\'Do you want to watch RoboCop this weekend?\\', \\'historyId\\': \\'1\\'}), ezgmail.GmailThread({\\'id\\': \\'T2\\', \\'snippet\\': \\'Thanks for stopping me from buying Bitcoin.\\', \\'historyId\\': \\'1\\'})]\\nbuf = io.StringIO()\\nwith contextlib.redirect_stdout(buf): ezgmail.summary(ths)\\nraw = ezgmail.summary(ths, printInfo=False)\\nout = (buf.getvalue().splitlines(), [(x[0], x[1][:12]) for x in raw], \\'noreply@example.com\\'[: \\'noreply@example.com\\'.find(\\' \\')])', g), g['out'])[1])({})" ; chx:output "(['Al, Jon - Do you want to watch RoboCop this weekend? - Dec 11', 'noreply@example.co - Thanks for stopping me from buying Bitcoin. - Dec 11'], [(['Al Sweigart <al@inventwithpython.com>', 'Jon Doe <j@example.com>'], 'Do you want '), (['noreply@example.com'], 'Thanks for s')], 'noreply@example.co')" .
