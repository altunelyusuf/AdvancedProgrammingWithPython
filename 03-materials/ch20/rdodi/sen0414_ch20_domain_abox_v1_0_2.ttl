chx:X_CommandInjectionRefused a owl:NamedIndividual, chx:CommandInjectionRefused ; rdfs:label "subprocess.run('echo ' + subject, shell=True)"@en ; skos:definition "A subject of status; echo PWNED run through a shell printed 2 lines, status and PWNED; the same text as an argument of a list printed it whole; an allow-list lookup answered 0 for status and 'refused' for the text status; echo PWNED and for rm -rf /, and shlex.quote made the shell version safe."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_CommandInjectionRefused a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nsubj = \\'status; echo PWNED\\'\\na = subprocess.run(\\'echo \\' + subj, shell=True, capture_output=True, text=True).stdout.splitlines()\\nb = subprocess.run([\\'echo\\', subj], capture_output=True, text=True).stdout.splitlines()\\nALLOWED = {\\'status\\': [\\'uptime\\'], \\'time\\': [\\'date\\', \\'+%Y\\']}\\ndef handle(s): return subprocess.run(ALLOWED[s.strip()], capture_output=True, text=True).returncode if s.strip() in ALLOWED else \\'refused\\'\\nout = (a, b, handle(\\'status\\'), handle(\\'status; echo PWNED\\'), handle(\\'rm -rf /\\'), shlex.quote(subj), subprocess.run(\\'echo \\' + shlex.quote(subj), shell=True, capture_output=True, text=True).stdout.splitlines())', g), g['out'])[1])({}) evaluates to (['status', 'PWNED'], ['status; echo PWNED'], 0, 'refused', 'refused', ''status; echo PWNED'', ['status; echo PWNED'])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nsubj = \\'status; echo PWNED\\'\\na = subprocess.run(\\'echo \\' + subj, shell=True, capture_output=True, text=True).stdout.splitlines()\\nb = subprocess.run([\\'echo\\', subj], capture_output=True, text=True).stdout.splitlines()\\nALLOWED = {\\'status\\': [\\'uptime\\'], \\'time\\': [\\'date\\', \\'+%Y\\']}\\ndef handle(s): return subprocess.run(ALLOWED[s.strip()], capture_output=True, text=True).returncode if s.strip() in ALLOWED else \\'refused\\'\\nout = (a, b, handle(\\'status\\'), handle(\\'status; echo PWNED\\'), handle(\\'rm -rf /\\'), shlex.quote(subj), subprocess.run(\\'echo \\' + shlex.quote(subj), shell=True, capture_output=True, text=True).stdout.splitlines())', g), g['out'])[1])({})" ; chx:output "(['status', 'PWNED'], ['status; echo PWNED'], 0, 'refused', 'refused', ''status; echo PWNED'', ['status; echo PWNED'])" .
