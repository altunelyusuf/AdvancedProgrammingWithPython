chx:X_CredentialsAndToken a owl:NamedIndividual, chx:CredentialsAndToken ; rdfs:label "ezgmail.init()"@en ; skos:definition "ezgmail 2026.4.28 reads credentials.json and token.json from the working directory and asks for the one scope https://mail.google.com/; with no credentials.json, ezgmail.init() raises EZGmailException (Can't find credentials file at DIR/credentials.json.) and ezgmail.LOGGED_IN and ezgmail.EMAIL_ADDRESS stay False, so the chapter's 'If no error appears' test fails on a machine where the Google Cloud steps of chapter 15 were not done."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_CredentialsAndToken a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail\\nd = wd()\\ne = err(lambda: ezgmail.init())\\nout = (e[0], e[1].split(\\' You can\\')[0].replace(d, \\'DIR\\'), ezgmail.LOGGED_IN, ezgmail.EMAIL_ADDRESS, ezgmail.SCOPES, ezgmail.__version__)', g), g['out'])[1])({}) evaluates to ('EZGmailException', 'Can't find credentials file at DIR/credentials.json.', False, False, 'https://mail.google.com/', '2026.4.28')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail\\nd = wd()\\ne = err(lambda: ezgmail.init())\\nout = (e[0], e[1].split(\\' You can\\')[0].replace(d, \\'DIR\\'), ezgmail.LOGGED_IN, ezgmail.EMAIL_ADDRESS, ezgmail.SCOPES, ezgmail.__version__)', g), g['out'])[1])({})" ; chx:output "('EZGmailException', 'Can't find credentials file at DIR/credentials.json.', False, False, 'https://mail.google.com/', '2026.4.28')" .
chx:X_CredentialsAndToken rd:hasIOExample chx:IO_CredentialsAndToken .
chx:X_ImportRunsInit a owl:NamedIndividual, chx:ImportRunsInit ; rdfs:label "import ezgmail"@en ; skos:definition "The last line of the ezgmail package is the call init(_raiseException=False), so import ezgmail already tries to log in and hides the failure; init takes userId, tokenFile (default token.json), credentialsFile (default credentials.json) and _raiseException (default True), and its source calls run_flow, the browser authorisation of oauth2client."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_ImportRunsInit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail\\nsrc = inspect.getsource(ezgmail).rstrip().splitlines()\\nsig = inspect.signature(ezgmail.init)\\nout = (src[-1], list(sig.parameters), sig.parameters[\\'tokenFile\\'].default, sig.parameters[\\'credentialsFile\\'].default, sig.parameters[\\'_raiseException\\'].default, \\'run_flow\\' in inspect.getsource(ezgmail.init))', g), g['out'])[1])({}) evaluates to ('init(_raiseException=False)', ['userId', 'tokenFile', 'credentialsFile', '_raiseException'], 'token.json', 'credentials.json', True, True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail\\nsrc = inspect.getsource(ezgmail).rstrip().splitlines()\\nsig = inspect.signature(ezgmail.init)\\nout = (src[-1], list(sig.parameters), sig.parameters[\\'tokenFile\\'].default, sig.parameters[\\'credentialsFile\\'].default, sig.parameters[\\'_raiseException\\'].default, \\'run_flow\\' in inspect.getsource(ezgmail.init))', g), g['out'])[1])({})" ; chx:output "('init(_raiseException=False)', ['userId', 'tokenFile', 'credentialsFile', '_raiseException'], 'token.json', 'credentials.json', True, True)" .
chx:X_ImportRunsInit rd:hasIOExample chx:IO_ImportRunsInit .
chx:X_TokenFileContents a owl:NamedIndividual, chx:TokenFileContents ; rdfs:label "token.json"@en ; skos:definition "A token.json written by oauth2client holds 16 keys as plain JSON, among them client_id, client_secret, access_token and refresh_token, with the file mode 0o600 (owner only), and reading it back gives the same refresh token; the chapter's advice to treat token.json like a password is right, because the file carries everything needed to act as the user."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_TokenFileContents a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nfrom oauth2client import client, file\\nd = wd()\\nc = client.OAuth2Credentials(\\'dummy-access-token\\', \\'dummy-client-id\\', \\'dummy-client-secret\\', \\'dummy-refresh-token\\', None, \\'https://oauth2.googleapis.com/token\\', \\'ezgmail-test\\', scopes=[\\'https://mail.google.com/\\'])\\nst = file.Storage(\\'token.json\\'); st.put(c)\\nj = json.load(open(\\'token.json\\'))\\nout = (sorted(j), j[\\'client_secret\\'], j[\\'refresh_token\\'], j[\\'scopes\\'], oct(os.stat(\\'token.json\\').st_mode & 0o777), file.Storage(\\'token.json\\').get().refresh_token)', g), g['out'])[1])({}) evaluates to (['_class', '_module', 'access_token', 'client_id', 'client_secret', 'id_token', 'id_token_jwt', 'invalid', 'refresh_token', 'revoke_uri', 'scopes', 'token_expiry', 'token_info_uri', 'token_response', 'token_uri', 'user_agent'], 'dummy-client-secret', 'dummy-refresh-token', ['https://mail.google.com/'], '0o600', 'dummy-refresh-token')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nfrom oauth2client import client, file\\nd = wd()\\nc = client.OAuth2Credentials(\\'dummy-access-token\\', \\'dummy-client-id\\', \\'dummy-client-secret\\', \\'dummy-refresh-token\\', None, \\'https://oauth2.googleapis.com/token\\', \\'ezgmail-test\\', scopes=[\\'https://mail.google.com/\\'])\\nst = file.Storage(\\'token.json\\'); st.put(c)\\nj = json.load(open(\\'token.json\\'))\\nout = (sorted(j), j[\\'client_secret\\'], j[\\'refresh_token\\'], j[\\'scopes\\'], oct(os.stat(\\'token.json\\').st_mode & 0o777), file.Storage(\\'token.json\\').get().refresh_token)', g), g['out'])[1])({})" ; chx:output "(['_class', '_module', 'access_token', 'client_id', 'client_secret', 'id_token', 'id_token_jwt', 'invalid', 'refresh_token', 'revoke_uri', 'scopes', 'token_expiry', 'token_info_uri', 'token_response', 'token_uri', 'user_agent'], 'dummy-client-secret', 'dummy-refresh-token', ['https://mail.google.com/'], '0o600', 'dummy-refresh-token')" .
chx:X_TokenFileContents rd:hasIOExample chx:IO_TokenFileContents .
chx:X_TestingModeExpiry a owl:NamedIndividual, chx:TestingModeExpiry ; rdfs:label "publishing status Testing"@en ; skos:definition "Google's OAuth page says a Google Cloud project whose consent screen is of the external user type and in the publishing status Testing is issued a refresh token that expires in 7 days, unless the scopes are only name, address and profile, so a script that worked last week can ask for the browser authorisation again; the chapter does not say this. Not executed: it needs a Google account and a week."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:X_DeprecatedOauthLibrary a owl:NamedIndividual, chx:DeprecatedOauthLibrary ; rdfs:label "md.version('oauth2client')"@en ; skos:definition "ezgmail 2026.4.28 requires google-api-python-client and oauth2client; oauth2client 4.1.3 was uploaded on 2018-09-07 and is classified Development Status 7 - Inactive on PyPI, while google-api-python-client is at 2.201.0, so the chapter's library stands on an authorisation package that has not changed in eight years."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_DeprecatedOauthLibrary a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nout = (md.version(\\'oauth2client\\'), md.requires(\\'ezgmail\\'), md.version(\\'google-api-python-client\\'), md.version(\\'ezgmail\\'), [x for x in md.requires(\\'ezgmail\\') if \\'oauthlib\\' in x])', g), g['out'])[1])({}) evaluates to ('4.1.3', ['google-api-python-client', 'oauth2client'], '2.201.0', '2026.4.28', [])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nout = (md.version(\\'oauth2client\\'), md.requires(\\'ezgmail\\'), md.version(\\'google-api-python-client\\'), md.version(\\'ezgmail\\'), [x for x in md.requires(\\'ezgmail\\') if \\'oauthlib\\' in x])', g), g['out'])[1])({})" ; chx:output "('4.1.3', ['google-api-python-client', 'oauth2client'], '2.201.0', '2026.4.28', [])" .
chx:X_DeprecatedOauthLibrary rd:hasIOExample chx:IO_DeprecatedOauthLibrary .
chx:X_SendCall a owl:NamedIndividual, chx:SendCall ; rdfs:label "ezgmail.send('recipient@example.com', 'Subject line', 'Body of the email')"@en ; skos:definition "ezgmail.send makes one POST to users/me/messages/send whose JSON body has the single key raw, the message as base64url; the message is a legacy MIMEText with the headers Content-Type, MIME-Version, Content-Transfer-Encoding, to, from and subject, type text/plain and encoding 7bit for an ASCII body."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_SendCall a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({})\\nezgmail.send(\\'recipient@example.com\\', \\'Subject line\\', \\'Body of the email\\')\\nm = raw_of(h)\\nout = (h.log[0][0], h.log[0][1], list(m.keys()), m.get_content_type(), m[\\'Content-Transfer-Encoding\\'], m.get_content(), list(json.loads(h.log[0][2])))', g), g['out'])[1])({}) evaluates to ('POST', 'users/me/messages/send?alt=json', ['Content-Type', 'MIME-Version', 'Content-Transfer-Encoding', 'to', 'from', 'subject'], 'text/plain', '7bit', 'Body of the email', ['raw'])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({})\\nezgmail.send(\\'recipient@example.com\\', \\'Subject line\\', \\'Body of the email\\')\\nm = raw_of(h)\\nout = (h.log[0][0], h.log[0][1], list(m.keys()), m.get_content_type(), m[\\'Content-Transfer-Encoding\\'], m.get_content(), list(json.loads(h.log[0][2])))', g), g['out'])[1])({})" ; chx:output "('POST', 'users/me/messages/send?alt=json', ['Content-Type', 'MIME-Version', 'Content-Transfer-Encoding', 'to', 'from', 'subject'], 'text/plain', '7bit', 'Body of the email', ['raw'])" .
chx:X_SendCall rd:hasIOExample chx:IO_SendCall .
chx:X_AttachmentParts a owl:NamedIndividual, chx:AttachmentParts ; rdfs:label "ezgmail.send(to, subject, body, ['attachment1.jpg', 'attachment2.mp3'])"@en ; skos:definition "With a list of file names ezgmail.send builds a multipart/mixed message with the text first and one base64 part per file, typed by its extension (image/jpeg, audio/mpeg, application/x-msdos-program for setup.exe, application/zip for notes.zip); it does not refuse an .exe or a .zip, and a name that does not exist raises EZGmailException. Google's help page lists .exe among the types Gmail does not let you attach and says a .zip is refused only for what is inside it, which is more exact than the chapter's sentence about .exe or .zip attachments."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_AttachmentParts a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nd = wd()\\nopen(\\'attachment1.jpg\\', \\'wb\\').write(b\\'\\\\xff\\\\xd8\\\\xff\\\\xe0\\' + b\\'0\\' * 20); open(\\'attachment2.mp3\\', \\'wb\\').write(b\\'ID3\\' + b\\'0\\' * 20); open(\\'setup.exe\\', \\'wb\\').write(b\\'MZ\\' + b\\'0\\' * 8); open(\\'notes.zip\\', \\'wb\\').write(b\\'PK\\' + b\\'0\\' * 8)\\nh = gm({})\\nezgmail.send(\\'recipient@example.com\\', \\'Subject line\\', \\'Body of the email\\', [\\'attachment1.jpg\\', \\'attachment2.mp3\\', \\'setup.exe\\', \\'notes.zip\\'])\\nm = raw_of(h)\\nout = (m.get_content_type(), [(p.get_content_type(), p.get_filename(), p[\\'Content-Transfer-Encoding\\']) for p in m.iter_parts()], err(lambda: ezgmail.send(\\'a@example.com\\', \\'s\\', \\'b\\', [\\'missing.pdf\\']))[0])', g), g['out'])[1])({}) evaluates to ('multipart/mixed', [('text/plain', None, '7bit'), ('image/jpeg', 'attachment1.jpg', 'base64'), ('audio/mpeg', 'attachment2.mp3', 'base64'), ('application/x-msdos-program', 'setup.exe', 'base64'), ('application/zip', 'notes.zip', 'base64')], 'EZGmailException')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nd = wd()\\nopen(\\'attachment1.jpg\\', \\'wb\\').write(b\\'\\\\xff\\\\xd8\\\\xff\\\\xe0\\' + b\\'0\\' * 20); open(\\'attachment2.mp3\\', \\'wb\\').write(b\\'ID3\\' + b\\'0\\' * 20); open(\\'setup.exe\\', \\'wb\\').write(b\\'MZ\\' + b\\'0\\' * 8); open(\\'notes.zip\\', \\'wb\\').write(b\\'PK\\' + b\\'0\\' * 8)\\nh = gm({})\\nezgmail.send(\\'recipient@example.com\\', \\'Subject line\\', \\'Body of the email\\', [\\'attachment1.jpg\\', \\'attachment2.mp3\\', \\'setup.exe\\', \\'notes.zip\\'])\\nm = raw_of(h)\\nout = (m.get_content_type(), [(p.get_content_type(), p.get_filename(), p[\\'Content-Transfer-Encoding\\']) for p in m.iter_parts()], err(lambda: ezgmail.send(\\'a@example.com\\', \\'s\\', \\'b\\', [\\'missing.pdf\\']))[0])', g), g['out'])[1])({})" ; chx:output "('multipart/mixed', [('text/plain', None, '7bit'), ('image/jpeg', 'attachment1.jpg', 'base64'), ('audio/mpeg', 'attachment2.mp3', 'base64'), ('application/x-msdos-program', 'setup.exe', 'base64'), ('application/zip', 'notes.zip', 'base64')], 'EZGmailException')" .
chx:X_AttachmentParts rd:hasIOExample chx:IO_AttachmentParts .
chx:X_CcAndBccHeaders a owl:NamedIndividual, chx:CcAndBccHeaders ; rdfs:label "ezgmail.send(..., cc='friend@example.com', bcc='a@example.com,b@example.com')"@en ; skos:definition "The cc and bcc arguments become the Cc and Bcc headers of the message that is sent: a comma-joined bcc string is parsed into 2 addresses, and the Bcc header is part of the raw message that ezgmail posts to the Gmail API, where Google's guide says the recipients of Bcc are taken from the headers."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_CcAndBccHeaders a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({})\\nezgmail.send(\\'recipient@example.com\\', \\'Subject line\\', \\'Body of the email\\', cc=\\'friend@example.com\\', bcc=\\'otherfriend@example.com,someoneelse@example.com\\')\\nm = raw_of(h)\\nout = (m[\\'to\\'], m[\\'cc\\'], m[\\'bcc\\'], [a.addr_spec for a in m[\\'bcc\\'].addresses], len(json.loads(h.log[0][2])[\\'raw\\']) > 0)', g), g['out'])[1])({}) evaluates to ('recipient@example.com', 'friend@example.com', 'otherfriend@example.com, someoneelse@example.com', ['otherfriend@example.com', 'someoneelse@example.com'], True)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({})\\nezgmail.send(\\'recipient@example.com\\', \\'Subject line\\', \\'Body of the email\\', cc=\\'friend@example.com\\', bcc=\\'otherfriend@example.com,someoneelse@example.com\\')\\nm = raw_of(h)\\nout = (m[\\'to\\'], m[\\'cc\\'], m[\\'bcc\\'], [a.addr_spec for a in m[\\'bcc\\'].addresses], len(json.loads(h.log[0][2])[\\'raw\\']) > 0)', g), g['out'])[1])({})" ; chx:output "('recipient@example.com', 'friend@example.com', 'otherfriend@example.com, someoneelse@example.com', ['otherfriend@example.com', 'someoneelse@example.com'], True)" .
chx:X_CcAndBccHeaders rd:hasIOExample chx:IO_CcAndBccHeaders .
chx:X_NonAsciiText a owl:NamedIndividual, chx:NonAsciiText ; rdfs:label "ezgmail.send('a@example.com', 'Rapor: şğı', 'Yedekleme tamamlandı')"@en ; skos:definition "Non-ASCII text survives ezgmail.send: the body becomes charset utf-8 in base64 (Yedekleme tamamlandı: ğüşiöç İI came back unchanged), the subject becomes an encoded word (=?utf-8?b?...?=), and a mimeSubtype that is not plain or html raises EZGmailValueError."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_NonAsciiText a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({}, {})\\nezgmail.send(\\'a@example.com\\', \\'Yedekleme bitti\\', \\'Yedekleme tamamlandı: ğüşiöç İI\\')\\nezgmail.send(\\'a@example.com\\', \\'Rapor: şğı\\', \\'plain ascii body\\')\\nr1 = base64.urlsafe_b64decode(json.loads(h.log[0][2])[\\'raw\\']).decode(\\'ascii\\').splitlines(); r2 = base64.urlsafe_b64decode(json.loads(h.log[1][2])[\\'raw\\']).decode(\\'ascii\\').splitlines()\\nm1 = raw_of(h, 0); m2 = raw_of(h, 1)\\nout = ([x for x in r1 if x.lower().startswith(\\'content-\\')], m1.get_content().strip(), [x for x in r2 if x.startswith(\\'subject\\')], m2[\\'subject\\'], err(lambda: ezgmail.send(\\'a@example.com\\', \\'s\\', \\'b\\', mimeSubtype=\\'rich\\'))[0])', g), g['out'])[1])({}) evaluates to (['Content-Type: text/plain; charset='utf-8'', 'Content-Transfer-Encoding: base64'], 'Yedekleme tamamlandı: ğüşiöç İI', ['subject: =?utf-8?b?UmFwb3I6IMWfxJ/EsQ==?='], 'Rapor: şğı', 'EZGmailValueError')"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\nh = gm({}, {})\\nezgmail.send(\\'a@example.com\\', \\'Yedekleme bitti\\', \\'Yedekleme tamamlandı: ğüşiöç İI\\')\\nezgmail.send(\\'a@example.com\\', \\'Rapor: şğı\\', \\'plain ascii body\\')\\nr1 = base64.urlsafe_b64decode(json.loads(h.log[0][2])[\\'raw\\']).decode(\\'ascii\\').splitlines(); r2 = base64.urlsafe_b64decode(json.loads(h.log[1][2])[\\'raw\\']).decode(\\'ascii\\').splitlines()\\nm1 = raw_of(h, 0); m2 = raw_of(h, 1)\\nout = ([x for x in r1 if x.lower().startswith(\\'content-\\')], m1.get_content().strip(), [x for x in r2 if x.startswith(\\'subject\\')], m2[\\'subject\\'], err(lambda: ezgmail.send(\\'a@example.com\\', \\'s\\', \\'b\\', mimeSubtype=\\'rich\\'))[0])', g), g['out'])[1])({})" ; chx:output "(['Content-Type: text/plain; charset='utf-8'', 'Content-Transfer-Encoding: base64'], 'Yedekleme tamamlandı: ğüşiöç İI', ['subject: =?utf-8?b?UmFwb3I6IMWfxJ/EsQ==?='], 'Rapor: şğı', 'EZGmailValueError')" .
