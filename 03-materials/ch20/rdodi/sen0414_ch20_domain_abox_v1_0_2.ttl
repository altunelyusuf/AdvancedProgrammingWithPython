chx:X_ResponseObject a owl:NamedIndividual, chx:ResponseObject ; rdfs:label "requests.post(...).ok"@en ; skos:definition "The chapter ignores the Response: when the recorder answered 429 with a JSON body written by this study (not a reply of ntfy) post returned a Response with ok False, nothing was raised, and only raise_for_status() raised HTTPError (429 Client Error: Too Many Requests), so a program that notifies you about a long job fails silently when the limit is reached."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_ResponseObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(429, \\'{\\x22code\\x22:42908,\\x22http\\x22:429,\\x22error\\x22:\\x22limit reached\\x22}\\')\\nr = requests.post(base + \\'/t\\', \\'Hello, world!\\')\\ne = err(lambda: r.raise_for_status())\\nr2 = None\\nout = (r.status_code, r.ok, bool(r), r.text, r.json()[\\'http\\'], e[0], e[1][:48], len(log))\\nsrv.shutdown()', g), g['out'])[1])({}) evaluates to (429, False, False, '{'code':42908,'http':429,'error':'limit reached'}', 429, 'HTTPError', '429 Client Error: Too Many Requests for url: htt', 1)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport http.server, requests\\ndef recorder(status=200, text=\\'\\'):\\n    log = []\\n    class Hd(http.server.BaseHTTPRequestHandler):\\n        def _do(s):\\n            n = int(s.headers.get(\\'Content-Length\\') or 0); body = s.rfile.read(n) if n else b\\'\\'\\n            log.append({\\'method\\': s.command, \\'path\\': s.path, \\'headers\\': dict(s.headers.items()), \\'body\\': body})\\n            s.send_response(status); s.send_header(\\'Content-Length\\', str(len(text.encode()))); s.end_headers(); s.wfile.write(text.encode())\\n        do_GET = do_POST = do_PUT = _do\\n        def log_message(s, *a): pass\\n    srv = http.server.ThreadingHTTPServer((\\'127.0.0.1\\', 0), Hd); threading.Thread(target=srv.serve_forever, daemon=True).start()\\n    return srv, log, \\'http://127.0.0.1:%d\\' % srv.server_address[1]\\nsrv, log, base = recorder(429, \\'{\\x22code\\x22:42908,\\x22http\\x22:429,\\x22error\\x22:\\x22limit reached\\x22}\\')\\nr = requests.post(base + \\'/t\\', \\'Hello, world!\\')\\ne = err(lambda: r.raise_for_status())\\nr2 = None\\nout = (r.status_code, r.ok, bool(r), r.text, r.json()[\\'http\\'], e[0], e[1][:48], len(log))\\nsrv.shutdown()', g), g['out'])[1])({})" ; chx:output "(429, False, False, '{'code':42908,'http':429,'error':'limit reached'}', 429, 'HTTPError', '429 Client Error: Too Many Requests for url: htt', 1)" .
