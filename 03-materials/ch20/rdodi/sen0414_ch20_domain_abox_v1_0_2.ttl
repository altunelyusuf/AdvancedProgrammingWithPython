chx:X_NewlineInHeader a owl:NamedIndividual, chx:NewlineInHeader ; rdfs:label "msg['Subject'] = 'hi\\r\\nBcc: evil@example.net'"@en ; skos:definition "EmailMessage refuses a header value with a line break (ValueError: Header values may not contain linefeed or carriage return characters), the legacy MIMEText that ezgmail uses raised HeaderParseError (header value appears to contain an embedded header) when the text was written, and ezgmail.send with a subject that contained a linefeed raised the same error before any API call was made."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_NewlineInHeader a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\ndef modern():\\n    m = EmailMessage(); m[\\'Subject\\'] = \\'hello\\\\r\\\\nBcc: evil@example.net\\'\\ndef legacy():\\n    m = MIMEText(\\'body\\'); m[\\'To\\'] = \\'a@example.com\\'; m[\\'Subject\\'] = \\'hello\\\\r\\\\nBcc: evil@example.net\\'; return m.as_string()\\ne1 = err(modern); e2 = err(legacy)\\nh = gm({})\\ne3 = err(lambda: ezgmail.send(\\'a@example.com\\', \\'hello\\\\nBcc: evil@example.net\\', \\'body\\'))\\nout = (e1[0], e1[1][:60], e2[0] if e2[0] != \\'ok\\' else [x for x in e2[1].splitlines() if x.lower().startswith((\\'subject\\', \\'bcc\\', \\' \\'))], e3[0], e3[1][:60], len(h.log))', g), g['out'])[1])({}) evaluates to ('ValueError', 'Header values may not contain linefeed or carriage return ch', 'HeaderParseError', 'HeaderParseError', 'header value appears to contain an embedded header: 'hello\\\\n', 0)"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\nimport ezgmail, httplib2\\nfrom googleapiclient.discovery import build\\nclass Rec(httplib2.Http):\\n    def __init__(s, replies=()): super().__init__(); s.log = []; s.replies = list(replies)\\n    def request(s, uri, method=\\'GET\\', body=None, headers=None, **k):\\n        s.log.append((method, uri.split(\\'/gmail/v1/\\')[-1], body)); r = s.replies.pop(0) if s.replies else {}\\n        return httplib2.Response({\\'status\\': \\'200\\', \\'content-type\\': \\'application/json\\'}), json.dumps(r).encode()\\ndef gm(*replies):\\n    h = Rec(replies); ezgmail.SERVICE_GMAIL = build(\\'gmail\\', \\'v1\\', http=h); ezgmail.EMAIL_ADDRESS = \\'me@example.com\\'; return h\\ndef b64(t): return base64.urlsafe_b64encode(t if isinstance(t, bytes) else t.encode()).decode()\\ndef api_msg(i, tid, frm, to, subj, text, ms, parts=None):\\n    h = [{\\'name\\': \\'From\\', \\'value\\': frm}, {\\'name\\': \\'To\\', \\'value\\': to}, {\\'name\\': \\'Subject\\', \\'value\\': subj}, {\\'name\\': \\'Content-Type\\', \\'value\\': \\'text/plain; charset=\\x22UTF-8\\x22\\'}]\\n    if parts is None: pl = {\\'headers\\': h, \\'mimeType\\': \\'text/plain\\', \\'body\\': {\\'size\\': len(text), \\'data\\': b64(text)}}\\n    else: pl = {\\'headers\\': h, \\'mimeType\\': \\'multipart/mixed\\', \\'body\\': {\\'size\\': 0}, \\'parts\\': parts}\\n    return {\\'id\\': i, \\'threadId\\': tid, \\'snippet\\': text[:60], \\'historyId\\': \\'1\\', \\'internalDate\\': str(ms), \\'payload\\': pl}\\ndef raw_of(h, n=0): return email.message_from_bytes(base64.urlsafe_b64decode(json.loads(h.log[n][2])[\\'raw\\']), policy=policy.default)\\ndef modern():\\n    m = EmailMessage(); m[\\'Subject\\'] = \\'hello\\\\r\\\\nBcc: evil@example.net\\'\\ndef legacy():\\n    m = MIMEText(\\'body\\'); m[\\'To\\'] = \\'a@example.com\\'; m[\\'Subject\\'] = \\'hello\\\\r\\\\nBcc: evil@example.net\\'; return m.as_string()\\ne1 = err(modern); e2 = err(legacy)\\nh = gm({})\\ne3 = err(lambda: ezgmail.send(\\'a@example.com\\', \\'hello\\\\nBcc: evil@example.net\\', \\'body\\'))\\nout = (e1[0], e1[1][:60], e2[0] if e2[0] != \\'ok\\' else [x for x in e2[1].splitlines() if x.lower().startswith((\\'subject\\', \\'bcc\\', \\' \\'))], e3[0], e3[1][:60], len(h.log))', g), g['out'])[1])({})" ; chx:output "('ValueError', 'Header values may not contain linefeed or carriage return ch', 'HeaderParseError', 'HeaderParseError', 'header value appears to contain an embedded header: 'hello\\\\n', 0)" .
