chx:X_HeaderEncoding a owl:NamedIndividual, chx:HeaderEncoding ; rdfs:label "msg['Subject'] = 'Yedekleme bitti ✓ şğı'"@en ; skos:definition "A Subject with non-ASCII characters is written as an encoded word (=?utf-8?b?4pyTIMWfxJ/EsQ==?=), a display name with a comma and a dotless i as =?utf-8?q?Y=C4=B1lmaz=2C_Ay=C5=9Fe?=, and decode_header with make_header gives the text back; with a policy that has utf8=True the same header is written as raw UTF-8."@en ; dcterms:source <http://example.org/sen0414/ch20/research> .
chx:IO_HeaderEncoding a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nfrom email.header import decode_header, make_header\\nm = mk(subj=\\'Yedekleme bitti ✓ şğı\\', to=\\'\\x22Yılmaz, Ayşe\\x22 <ayse@example.org>\\')\\na = m.as_bytes().decode(\\'ascii\\').splitlines(); u = m.as_bytes(policy=policy.default.clone(utf8=True)).decode(\\'utf-8\\').splitlines()\\nsubj = [x for x in a if x.startswith(\\'Subject\\')][0]\\nout = (subj, [x for x in a if x.startswith(\\'To\\')], [x for x in u if x.startswith(\\'Subject\\')], str(make_header(decode_header(subj.split(\\': \\', 1)[1]))), decode_header(subj.split(\\': \\', 1)[1])[0][1], m[\\'subject\\'], [x for x in a if x.startswith(\\'Content-Type\\')])', g), g['out'])[1])({}) evaluates to ('Subject: Yedekleme bitti =?utf-8?b?4pyTIMWfxJ/EsQ==?=', ['To: =?utf-8?q?Y=C4=B1lmaz=2C_Ay=C5=9Fe?= <ayse@example.org>'], ['Subject: Yedekleme bitti ✓ şğı'], 'Yedekleme bitti ✓ şğı', None, 'Yedekleme bitti ✓ şğı', ['Content-Type: text/plain; charset='utf-8''])"@en ; chx:input "(lambda g: (exec('import io, os, re, sys, math, shlex, subprocess, json, time, base64, shutil, socket, ssl, smtplib, tempfile, threading, datetime, hashlib, hmac, mimetypes, secrets, warnings, email, inspect, contextlib, importlib.metadata as md\\nfrom datetime import datetime as DT, timedelta as TD, date as D, timezone, UTC\\nfrom zoneinfo import ZoneInfo\\nfrom email import policy, utils as eu\\nfrom email.message import EmailMessage\\nfrom email.mime.text import MIMEText\\nfrom email.mime.multipart import MIMEMultipart\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except BaseException as e: return (type(e).__name__, str(e))\\ndef wd():\\n    d = tempfile.mkdtemp(); os.chdir(d); return d\\ndef mk(**kw):\\n    m = EmailMessage(); m[\\'From\\'] = kw.get(\\'frm\\', \\'Al Sweigart <al@example.com>\\'); m[\\'To\\'] = kw.get(\\'to\\', \\'Jon Doe <jon@example.org>\\'); m[\\'Subject\\'] = kw.get(\\'subj\\', \\'RoboCop\\')\\n    m[\\'Date\\'] = eu.formatdate(1797000528, usegmt=True); m[\\'Message-ID\\'] = \\'<fixed-1@example.com>\\'\\n    for k, v in kw.get(\\'extra\\', {}).items(): m[k] = v\\n    m.set_content(kw.get(\\'body\\', \\'Do you want to watch RoboCop this weekend?\\')); return m\\nfrom email.header import decode_header, make_header\\nm = mk(subj=\\'Yedekleme bitti ✓ şğı\\', to=\\'\\x22Yılmaz, Ayşe\\x22 <ayse@example.org>\\')\\na = m.as_bytes().decode(\\'ascii\\').splitlines(); u = m.as_bytes(policy=policy.default.clone(utf8=True)).decode(\\'utf-8\\').splitlines()\\nsubj = [x for x in a if x.startswith(\\'Subject\\')][0]\\nout = (subj, [x for x in a if x.startswith(\\'To\\')], [x for x in u if x.startswith(\\'Subject\\')], str(make_header(decode_header(subj.split(\\': \\', 1)[1]))), decode_header(subj.split(\\': \\', 1)[1])[0][1], m[\\'subject\\'], [x for x in a if x.startswith(\\'Content-Type\\')])', g), g['out'])[1])({})" ; chx:output "('Subject: Yedekleme bitti =?utf-8?b?4pyTIMWfxJ/EsQ==?=', ['To: =?utf-8?q?Y=C4=B1lmaz=2C_Ay=C5=9Fe?= <ayse@example.org>'], ['Subject: Yedekleme bitti ✓ şğı'], 'Yedekleme bitti ✓ şğı', None, 'Yedekleme bitti ✓ şğı', ['Content-Type: text/plain; charset='utf-8''])" .
