pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Tell the Gmail API's objects apart (thread, message, attachment) and read their attributes, including what a timestamp depends on"@en ;
    skos:definition "The objective is met when the reader can tell the Gmail API's objects apart (thread, message, attachment) and read their attributes, including what a timestamp depends on, at the understand level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter20.html> ;
    ld:bloomLevel ld:Understand  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Build and take apart a mail message with the standard library (headers, body, attachment, addresses) and predict what send_message transmits"@en ;
    skos:definition "The objective is met when the reader can build and take apart a mail message with the standard library (headers, body, attachment, addresses) and predict what send_message transmits, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter20.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Judge an SMS email gateway: build its address, respect its length limit and name its disadvantages"@en ;
    skos:definition "The objective is met when the reader can judge an SMS email gateway: build its address, respect its length limit and name its disadvantages, at the analyze level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter20.html> ;
    ld:bloomLevel ld:Analyze  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Send a notification as an HTTP request with headers and read a poll response line by line, allowing for keys that are absent"@en ;
    skos:definition "The objective is met when the reader can send a notification as an HTTP request with headers and read a poll response line by line, allowing for keys that are absent, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter20.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain what makes a notification or command channel safe: a secret topic, no sensitive data, a password check and a fixed list of commands"@en ;
    skos:definition "The objective is met when the reader can explain what makes a notification or command channel safe: a secret topic, no sensitive data, a password check and a fixed list of commands, at the analyze level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter20.html> ;
    ld:bloomLevel ld:Analyze  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "ezgmail.unread() is called on an account with three unread conversations. What does it return?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O1 ; ld:cognitiveLevel ld:Remember ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "It asks the Gmail API for threads (users/me/threads with the query label:UNREAD), so the objects are threads; a thread fetches its messages with one more request when messages is first read." ;
    ld:distractorRationale "The subject is an attribute of a message that a thread holds; the function returns the thread objects, not text." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "A list of GmailMessage objects, one for each unread email" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "A list of GmailThread objects, one for each unread conversation" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "A list of strings that hold the subject lines" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "An EmailMessage is built with set_content(text), add_alternative(html, subtype='html') and add_attachment(data, ...). What is the content type of the whole message?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O2 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "multipart/alternative is the inner part that holds the text and the HTML; with an attachment added, the message becomes a multipart/mixed that holds it." ;
    ld:distractorRationale "text/html is the type of one inner part, not of the message." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "multipart/alternative" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "text/html" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "multipart/mixed" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does email.utils.parseaddr('real@example.com, evil@example.net') return in Python 3.13 and 3.14?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "That is the answer only with strict=False; the default is strict, so a string that holds two addresses is not an address." ;
    ld:distractorRationale "parseaddr does not raise; it returns empty strings for input it cannot take as one address." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "('', 'real@example.com')" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "('', '')" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "It raises ValueError" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A program sends a message whose To header says jon@example.org, but passes ['jon@example.org', 'hidden@example.org'] as the recipients. Who receives it?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "The server delivers to the recipients of the envelope (RCPT TO), not to the header; the header is only text." ;
    ld:distractorRationale "The server never compares the two; on the local server the message was accepted with the From header being whatever the sender wrote." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "Both addresses, and the hidden one appears nowhere in the text" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "Only jon@example.org, because the header lists only him" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "Neither, because the server refuses a header that does not match" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A plain text of 161 characters from the basic GSM set is sent as an SMS. How many messages does it use?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "One message holds 160 characters of 7 bits (140 bytes), so the 161st character needs another." ;
    ld:distractorRationale "A character is not a message; a message carries 140 bytes." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "1" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "2" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "161" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A 100-character text has one dotless i (ı) in it. Compared with the same text without it, how many messages does it need?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O1 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "One character outside the GSM sets changes the encoding of the whole text." ;
    ld:distractorRationale "UCS-2 uses 16 bits a character, twice the 7 bits of GSM-7 in a message of 140 bytes, so fewer characters fit." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "The same number; one character does not matter" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "More: the whole text is sent as UCS-2, which holds 70 characters a message" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "Fewer: Unicode is a more compact encoding" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "AT&T's support article says its email-to-text service was shut down on June 17, 2025. What does that show about an address such as 5555550100@txt.att.net?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "A correct address is not enough when the provider has ended the service." ;
    ld:distractorRationale "The notice names the email-to-text and text-to-email service, so both the SMS and MMS domains are affected." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "It still works, because the address is correct" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "A gateway that worked once can stop working, and the chapter's table still lists it" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "Only the MMS address stopped working" .
pg:Q8 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A poll answer holds two JSON objects, one on each line. What does json.loads(text) do with the whole text?"@en ; ld:hasOption pg:Q8_O0, pg:Q8_O1, pg:Q8_O2 ; ld:hasCorrectOption pg:Q8_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "JSON has no format that holds two objects after one another; a list needs brackets and commas." ;
    ld:distractorRationale "It does not stop after the first object; it checks that nothing follows it." .
pg:Q8_O0 a ld:AnswerOption ; rdfs:label "It returns a list of the two objects" .
pg:Q8_O1 a ld:AnswerOption ; rdfs:label "It raises JSONDecodeError (Extra data)" .
pg:Q8_O2 a ld:AnswerOption ; rdfs:label "It returns only the first object" .
pg:Q9 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A message to ntfy has 2049 characters, each a dotless i (ı), and the limit is 4,096 bytes. Is it within the limit?"@en ; ld:hasOption pg:Q9_O0, pg:Q9_O1, pg:Q9_O2 ; ld:hasCorrectOption pg:Q9_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "The limit counts bytes, and the dotless i takes two bytes in UTF-8." ;
    ld:distractorRationale "The limit is in bytes." .
pg:Q9_O0 a ld:AnswerOption ; rdfs:label "Yes, 2049 is less than 4096" .
pg:Q9_O1 a ld:AnswerOption ; rdfs:label "No, it is 4098 bytes in UTF-8" .
pg:Q9_O2 a ld:AnswerOption ; rdfs:label "Yes, ntfy counts characters" .
pg:Q10 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "The chapter's topic is the name 'AlSweigart' and 8 random characters (ZPgxBQ42). Why is secrets.token_urlsafe(16) a better topic?"@en ; ld:hasOption pg:Q10_O0, pg:Q10_O1, pg:Q10_O2 ; ld:hasCorrectOption pg:Q10_O1 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "It is longer (22 characters), and being easy to type is the opposite of secret." ;
    ld:distractorRationale "ntfy does not encrypt the topic; it is part of the URL and shows in logs, and without access control the topic name is the password." .
pg:Q10_O0 a ld:AnswerOption ; rdfs:label "It is shorter, so it is easier to type" .
pg:Q10_O1 a ld:AnswerOption ; rdfs:label "It gives 128 bits, where 8 characters of 62 give 47.6 bits, and the topic is the only secret" .
pg:Q10_O2 a ld:AnswerOption ; rdfs:label "It is encrypted by ntfy" .
pg:Q11 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "The command-by-mail program checks a password in the message body and not the From address. Why?"@en ; ld:hasOption pg:Q11_O0, pg:Q11_O1, pg:Q11_O2 ; ld:hasCorrectOption pg:Q11_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "The header is plain text." ;
    ld:distractorRationale "Gmail keeps the header, and the sender can write any address there." .
pg:Q11_O0 a ld:AnswerOption ; rdfs:label "A From header is whatever the sender wrote, so it proves nothing" .
pg:Q11_O1 a ld:AnswerOption ; rdfs:label "The From address is encrypted" .
pg:Q11_O2 a ld:AnswerOption ; rdfs:label "Gmail removes the From address from incoming messages" .
pg:GmailApi a ipo:ChapterSection ; rdfs:label "Gmail api"@en ;
    skos:definition "The longest section of the chapter teaches the Gmail API through the EZGmail module: the credentials file and token file, send() with attachments, cc and bcc, the GmailThread and GmailMessage objects that unread(), recent() and search() return, and the download of attachments (Sweigart, 2025). EZGmail is the author's wrapper over the official Gmail API, and the chapter prefers it to smtplib and imaplib because of the security and anti-spam measures of Gmail (Sweigart, 2025)(Sweigart, 2024)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GmailApi> ;
    sen0414:anchor "#s-GmailApi" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:GmailApi .
pg:GmailSetup a ipo:ChapterSection ; rdfs:label "Gmail setup"@en ;
    skos:definition "The chapter says to enable the Gmail API in the Google Cloud console as for EZSheets in chapter 15, to add the scope https://mail.google.com, and to end with a credentials file and a token file; running import ezgmail and ezgmail.init() without an error shows that it works, and token.json is to be treated like a password (Sweigart, 2025). Google documents the flow and the scope that EZGmail asks for (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GmailSetup> ;
    sen0414:anchor "#s-GmailSetup" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:GmailApi .
pg:Page ipo:coversChapterSection pg:GmailSetup .
pg:CredentialsAndToken a ipo:ChapterSection ; rdfs:label "Credentials and token"@en ;
    skos:definition "The chapter ends the setup with a credentials file and a token file and tests it with import ezgmail and ezgmail.init(): if no error appears, EZGmail has been correctly installed (Sweigart, 2025). The README of EZGmail says the same two files must be in the folder of the program (Sweigart, 2024)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_CredentialsAndToken> ;
    sen0414:anchor "#s-CredentialsAndToken" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSetup .
pg:Page ipo:coversChapterSection pg:CredentialsAndToken .
pg:ImportRunsInit a ipo:ChapterSection ; rdfs:label "Import runs init"@en ;
    skos:definition "The chapter shows import ezgmail and ezgmail.init() as two lines, as if the import did nothing (Sweigart, 2025). The source of the package ends with a call of init that hides its exception (Sweigart, 2024)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ImportRunsInit> ;
    sen0414:anchor "#s-ImportRunsInit" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSetup .
pg:Page ipo:coversChapterSection pg:ImportRunsInit .
pg:TokenFileContents a ipo:ChapterSection ; rdfs:label "Token file contents"@en ;
    skos:definition "The chapter says token.json is to be treated like a password, because anyone who has it can use the Gmail account but cannot change its password, and that a token is revoked in the Google Cloud console (Sweigart, 2025). Google's page on OAuth 2.0 describes the refresh token that such a file holds (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_TokenFileContents> ;
    sen0414:anchor "#s-TokenFileContents" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSetup .
pg:Page ipo:coversChapterSection pg:TokenFileContents .
pg:TestingModeExpiry a ipo:ChapterSection ; rdfs:label "Testing mode expiry"@en ;
    skos:definition "The chapter says nothing about the publishing status of the Google Cloud project (Sweigart, 2025). Google's OAuth page says that a project whose consent screen is of the external type and in the status Testing is issued a refresh token that expires in 7 days (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_TestingModeExpiry> ;
    sen0414:anchor "#s-TestingModeExpiry" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSetup .
pg:Page ipo:coversChapterSection pg:TestingModeExpiry .
pg:DeprecatedOauthLibrary a ipo:ChapterSection ; rdfs:label "Deprecated oauth library"@en ;
    skos:definition "The chapter does not name the library under the login of EZGmail (Sweigart, 2025). The package metadata of ezgmail lists google-api-python-client and oauth2client as requirements (Python Package Index, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_DeprecatedOauthLibrary> ;
    sen0414:anchor "#s-DeprecatedOauthLibrary" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSetup .
pg:Page ipo:coversChapterSection pg:DeprecatedOauthLibrary .
pg:GmailSending a ipo:ChapterSection ; rdfs:label "Gmail sending"@en ;
    skos:definition "The chapter sends mail with ezgmail.send(recipient, subject, body), an optional list of attachment names, and the keyword arguments cc and bcc, and notes that Gmail may refuse repeated text and .exe or .zip attachments (Sweigart, 2025). The Gmail API takes the whole message as one base64url string in the raw field and joins a reply to a thread by threadId, References and In-Reply-To headers and a matching subject (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GmailSending> ;
    sen0414:anchor "#s-GmailSending" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:GmailApi .
pg:Page ipo:coversChapterSection pg:GmailSending .
pg:SendCall a ipo:ChapterSection ; rdfs:label "Send call"@en ;
    skos:definition "The chapter sends mail with one call, ezgmail.send('recipient@example.com', 'Subject line', 'Body of the email') (Sweigart, 2025). The Gmail API accepts the message as one base64url string in the raw field of a POST to users/me/messages/send (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_SendCall> ;
    sen0414:anchor "#s-SendCall" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSending .
pg:Page ipo:coversChapterSection pg:SendCall .
pg:AttachmentParts a ipo:ChapterSection ; rdfs:label "Attachment parts"@en ;
    skos:definition "The chapter attaches files by an extra list argument, and says Gmail might refuse .exe or .zip attachments (Sweigart, 2025). Google's help page lists .exe among the file types Gmail blocks and gives 25 MB as the size limit of an attachment (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_AttachmentParts> ;
    sen0414:anchor "#s-AttachmentParts" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSending .
pg:Page ipo:coversChapterSection pg:AttachmentParts .
pg:CcAndBccHeaders a ipo:ChapterSection ; rdfs:label "Cc and bcc headers"@en ;
    skos:definition "The chapter sends carbon copies with cc and blind copies with bcc, the latter as a comma-joined string (Sweigart, 2025). Google's sending guide takes the recipients from the To, Cc and Bcc headers of the message (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_CcAndBccHeaders> ;
    sen0414:anchor "#s-CcAndBccHeaders" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSending .
pg:Page ipo:coversChapterSection pg:CcAndBccHeaders .
pg:NonAsciiText a ipo:ChapterSection ; rdfs:label "Non ascii text"@en ;
    skos:definition "The chapter's examples are English and ASCII (Sweigart, 2025). The MIME standards encode non-ASCII text with a charset and a transfer encoding, and non-ASCII header text as encoded words (Freed and Borenstein, 1996)(Moore, 1996)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_NonAsciiText> ;
    sen0414:anchor "#s-NonAsciiText" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSending .
pg:Page ipo:coversChapterSection pg:NonAsciiText .
pg:ReplyThreading a ipo:ChapterSection ; rdfs:label "Reply threading"@en ;
    skos:definition "The chapter does not use GmailMessage.reply (Sweigart, 2025). Google's sending guide says a message joins a thread when its threadId is given, its References and In-Reply-To headers follow RFC 2822 and its Subject headers match (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ReplyThreading> ;
    sen0414:anchor "#s-ReplyThreading" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailSending .
pg:Page ipo:coversChapterSection pg:ReplyThreading .
pg:GmailReading a ipo:ChapterSection ; rdfs:label "Gmail reading"@en ;
    skos:definition "The chapter reads mail with unread(), recent() and search(), which return GmailThread objects of up to 25 threads; each thread holds GmailMessage objects with subject, body, timestamp, sender and recipient, and summary() prints a line for each thread (Sweigart, 2025). Google's thread listing takes a query q and maxResults, with a default of 100 and a maximum of 500 (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GmailReading> ;
    sen0414:anchor "#s-GmailReading" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:GmailApi .
pg:Page ipo:coversChapterSection pg:GmailReading .
pg:ThreadVersusMessage a ipo:ChapterSection ; rdfs:label "Thread versus message"@en ;
    skos:definition "The chapter says a GmailThread holds a messages list of GmailMessage objects, that Gmail shows conversations, and prints the text of the first thread as a GmailThread with len=2 and a snippet (Sweigart, 2025)(Sweigart, 2025). Question 2 of Appendix B answers that a message is a single email and a thread a conversation of several (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ThreadVersusMessage> ;
    sen0414:anchor "#s-ThreadVersusMessage" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailReading .
pg:Page ipo:coversChapterSection pg:ThreadVersusMessage .
pg:UnreadRecentSearch a ipo:ChapterSection ; rdfs:label "Unread recent search"@en ;
    skos:definition "The chapter says unread() and recent() return the 25 most recent threads, that maxResults changes the limit, and that search() takes the operators of the Gmail search box (Sweigart, 2025)(Google, 2026). Google's list call has a default of 100 and a maximum of 500 for maxResults (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_UnreadRecentSearch> ;
    sen0414:anchor "#s-UnreadRecentSearch" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailReading .
pg:Page ipo:coversChapterSection pg:UnreadRecentSearch .
pg:MessageFields a ipo:ChapterSection ; rdfs:label "Message fields"@en ;
    skos:definition "The chapter lists subject, body, timestamp, sender and recipient as the attributes of a message and prints a timestamp of datetime.datetime(2026, 12, 9, 13, 28, 48) (Sweigart, 2025). The package takes the time from the internalDate field of the API reply (Sweigart, 2024)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_MessageFields> ;
    sen0414:anchor "#s-MessageFields" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailReading .
pg:Page ipo:coversChapterSection pg:MessageFields .
pg:QuotedTextCut a ipo:ChapterSection ; rdfs:label "Quoted text cut"@en ;
    skos:definition "The chapter does not mention removeQuotedParts (Sweigart, 2025). The README of EZGmail says the body may carry the quoted earlier mails of a reply (Sweigart, 2024)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_QuotedTextCut> ;
    sen0414:anchor "#s-QuotedTextCut" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailReading .
pg:Page ipo:coversChapterSection pg:QuotedTextCut .
pg:SummaryLine a ipo:ChapterSection ; rdfs:label "Summary line"@en ;
    skos:definition "The chapter prints summary() as Al, Jon - Do you want to watch RoboCop this weekend? - Dec 09 (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_SummaryLine> ;
    sen0414:anchor "#s-SummaryLine" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailReading .
pg:Page ipo:coversChapterSection pg:SummaryLine .
pg:GmailAttachments a ipo:ChapterSection ; rdfs:label "Gmail attachments"@en ;
    skos:definition "The chapter says a GmailMessage has an attachments list of file names, that downloadAttachment() and downloadAllAttachments() save to the working directory or to a downloadFolder, and that an existing file with the same name is overwritten (Sweigart, 2025). A mail from a stranger controls the file name it carries (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GmailAttachments> ;
    sen0414:anchor "#s-GmailAttachments" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:GmailApi .
pg:Page ipo:coversChapterSection pg:GmailAttachments .
pg:AttachmentNames a ipo:ChapterSection ; rdfs:label "Attachment names"@en ;
    skos:definition "The chapter says attachments is a list of file names and that any of them can be passed to downloadAttachment (Sweigart, 2025). The names are returned as found in the message, one for each attached file (Sweigart, 2024)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_AttachmentNames> ;
    sen0414:anchor "#s-AttachmentNames" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailAttachments .
pg:Page ipo:coversChapterSection pg:AttachmentNames .
pg:DownloadOverwrite a ipo:ChapterSection ; rdfs:label "Download overwrite"@en ;
    skos:definition "The chapter says that a file of the same name is overwritten by the download and shows downloadAllAttachments(downloadFolder='vacation2026') (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_DownloadOverwrite> ;
    sen0414:anchor "#s-DownloadOverwrite" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailAttachments .
pg:Page ipo:coversChapterSection pg:DownloadOverwrite .
pg:FilenameTraversal a ipo:ChapterSection ; rdfs:label "Filename traversal"@en ;
    skos:definition "The chapter does not say that an attachment name comes from the sender (Sweigart, 2025). A message from a stranger controls the file name it carries (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_FilenameTraversal> ;
    sen0414:anchor "#s-FilenameTraversal" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailAttachments .
pg:Page ipo:coversChapterSection pg:FilenameTraversal .
pg:StandardLibraryMail a ipo:ChapterSection ; rdfs:label "Standard library mail"@en ;
    skos:definition "The chapter names smtplib and imaplib only to say that EZGmail is the better way to reach Gmail (Sweigart, 2025). The Python 3.14 documentation describes the modules the chapter leaves out: email builds and parses messages, smtplib is an SMTP client with STARTTLS and login, and imaplib is an IMAP4 client, new in 3.14 with the IDLE command (Python Software Foundation, 2026)(Klensin, 2008)(Crispin, 2003)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_StandardLibraryMail> ;
    sen0414:anchor "#s-StandardLibraryMail" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:StandardLibraryMail .
pg:MessageObjects a ipo:ChapterSection ; rdfs:label "Message objects"@en ;
    skos:definition "The email package builds a message as an EmailMessage with set_content(), add_alternative() and add_attachment(), writes headers in the order they were set, encodes non-ASCII header text as encoded words, and parses addresses with email.utils (Python Software Foundation, 2026)(Resnick, 2008)(Freed and Borenstein, 1996)(Moore, 1996). The chapter uses none of this directly, because EZGmail builds the message (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_MessageObjects> ;
    sen0414:anchor "#s-MessageObjects" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:StandardLibraryMail .
pg:Page ipo:coversChapterSection pg:MessageObjects .
pg:EmailMessageBuild a ipo:ChapterSection ; rdfs:label "Email message build"@en ;
    skos:definition "EmailMessage is the class of the email package that builds a message: headers are set like dictionary items and set_content() writes the body, with a default policy that serialises with LF line ends (Python Software Foundation, 2026)(Resnick, 2008). The chapter never builds a message, because EZGmail does (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_EmailMessageBuild> ;
    sen0414:anchor "#s-EmailMessageBuild" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:MessageObjects .
pg:Page ipo:coversChapterSection pg:EmailMessageBuild .
pg:MimeTree a ipo:ChapterSection ; rdfs:label "Mime tree"@en ;
    skos:definition "A message with text, HTML and a file is a tree of MIME parts: multipart/mixed holding multipart/alternative and the attachment (Freed and Borenstein, 1996)(Python Software Foundation, 2026). The chapter's attachments are always files, never an HTML alternative (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_MimeTree> ;
    sen0414:anchor "#s-MimeTree" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:MessageObjects .
pg:Page ipo:coversChapterSection pg:MimeTree .
pg:HeaderEncoding a ipo:ChapterSection ; rdfs:label "Header encoding"@en ;
    skos:definition "RFC 2047 encodes non-ASCII header text as encoded words, and the email package does it automatically, or writes raw UTF-8 under a policy with utf8=True (Moore, 1996)(Python Software Foundation, 2026). The chapter sends English subjects only (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_HeaderEncoding> ;
    sen0414:anchor "#s-HeaderEncoding" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:MessageObjects .
pg:Page ipo:coversChapterSection pg:HeaderEncoding .
pg:AddressParsing a ipo:ChapterSection ; rdfs:label "Address parsing"@en ;
    skos:definition "email.utils.parseaddr and getaddresses split a header value into display names and addresses; the 3.14 documentation says that strict, added in 3.13, makes parseaddr return ('', '') for malformed input, which is now the default (Python Software Foundation, 2026). The chapter writes addresses as plain strings (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_AddressParsing> ;
    sen0414:anchor "#s-AddressParsing" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:MessageObjects .
pg:Page ipo:coversChapterSection pg:AddressParsing .
pg:SmtpClient a ipo:ChapterSection ; rdfs:label "Smtp client"@en ;
    skos:definition "smtplib.SMTP connects to a server, ehlo() learns its extensions, starttls() upgrades the connection with RFC 3207, login() authenticates with RFC 4954 and send_message() sends the message to the recipients in To, Cc and Bcc (Python Software Foundation, 2026)(Hoffman, 2002)(Siemborski and Melnikov, 2007). RFC 8314 prefers TLS from the start of a submission connection, which is port 465 (Moore and Newman, 2018)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_SmtpClient> ;
    sen0414:anchor "#s-SmtpClient" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:StandardLibraryMail .
pg:Page ipo:coversChapterSection pg:SmtpClient .
pg:StarttlsSession a ipo:ChapterSection ; rdfs:label "Starttls session"@en ;
    skos:definition "A client connects on port 587, calls ehlo(), upgrades with starttls() (RFC 3207) and only then logs in; Google names smtp.gmail.com for these steps (Python Software Foundation, 2026)(Hoffman, 2002)(Google, 2026). The chapter does not use smtplib (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_StarttlsSession> ;
    sen0414:anchor "#s-StarttlsSession" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SmtpClient .
pg:Page ipo:coversChapterSection pg:StarttlsSession .
pg:CertificateVerification a ipo:ChapterSection ; rdfs:label "Certificate verification"@en ;
    skos:definition "The ssl documentation recommends create_default_context() for a client because it turns on certificate and host name checking (Python Software Foundation, 2026). A server with a self-signed certificate is therefore refused by a default context."@en ; dcterms:source <http://example.org/sen0414/ch20#S_CertificateVerification> ;
    sen0414:anchor "#s-CertificateVerification" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SmtpClient .
pg:Page ipo:coversChapterSection pg:CertificateVerification .
pg:LoginAfterTls a ipo:ChapterSection ; rdfs:label "Login after tls"@en ;
    skos:definition "RFC 4954 defines the AUTH command, and a server may offer it only on an encrypted connection; smtplib.login() raises SMTPNotSupportedError if AUTH is not offered (Siemborski and Melnikov, 2007)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_LoginAfterTls> ;
    sen0414:anchor "#s-LoginAfterTls" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SmtpClient .
pg:Page ipo:coversChapterSection pg:LoginAfterTls .
pg:EnvelopeRecipients a ipo:ChapterSection ; rdfs:label "Envelope recipients"@en ;
    skos:definition "smtplib.send_message() takes the recipients from the To, Cc and Bcc headers and, as its documentation says, does not transmit any Bcc header (Python Software Foundation, 2026)(Klensin, 2008). The chapter's bcc argument relies on the same idea (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_EnvelopeRecipients> ;
    sen0414:anchor "#s-EnvelopeRecipients" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SmtpClient .
pg:Page ipo:coversChapterSection pg:EnvelopeRecipients .
pg:RefusedRecipients a ipo:ChapterSection ; rdfs:label "Refused recipients"@en ;
    skos:definition "send_message() returns a dictionary of the recipients the server refused and raises SMTPRecipientsRefused only when all were refused (Python Software Foundation, 2026)(Klensin, 2008). The chapter has no word on refused recipients (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_RefusedRecipients> ;
    sen0414:anchor "#s-RefusedRecipients" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SmtpClient .
pg:Page ipo:coversChapterSection pg:RefusedRecipients .
pg:ImapClient a ipo:ChapterSection ; rdfs:label "Imap client"@en ;
    skos:definition "imaplib.IMAP4 is the client of RFC 3501 with SELECT, SEARCH, FETCH, STORE and EXPUNGE; Python 3.14 added IDLE from RFC 2177, and the ports are 143 and 993 (Python Software Foundation, 2026)(Crispin, 2003)(Leiba, 1997). The 2nd edition used the imapclient package for the same work (Sweigart, 2019)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ImapClient> ;
    sen0414:anchor "#s-ImapClient" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:StandardLibraryMail .
pg:Page ipo:coversChapterSection pg:ImapClient .
pg:ImapSession a ipo:ChapterSection ; rdfs:label "Imap session"@en ;
    skos:definition "imaplib.IMAP4 connects, upgrades with starttls(), logs in, selects a mailbox, searches, fetches, marks messages deleted and expunges, as RFC 3501 describes (Python Software Foundation, 2026)(Crispin, 2003). The chapter leaves this to EZGmail (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ImapSession> ;
    sen0414:anchor "#s-ImapSession" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ImapClient .
pg:Page ipo:coversChapterSection pg:ImapSession .
pg:ImapParsing a ipo:ChapterSection ; rdfs:label "Imap parsing"@en ;
    skos:definition "imaplib provides ParseFlags, Internaldate2tuple, Time2Internaldate and Int2AP for the strings of the protocol (Python Software Foundation, 2026)(Crispin, 2003)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ImapParsing> ;
    sen0414:anchor "#s-ImapParsing" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ImapClient .
pg:Page ipo:coversChapterSection pg:ImapParsing .
pg:ImapIdle a ipo:ChapterSection ; rdfs:label "Imap idle"@en ;
    skos:definition "IDLE (RFC 2177) lets the server tell the client about new mail, and Python 3.14 added IMAP4.idle() for it (Leiba, 1997)(Python Software Foundation, 2026). The chapter's control program polls every 15 minutes instead (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ImapIdle> ;
    sen0414:anchor "#s-ImapIdle" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ImapClient .
pg:Page ipo:coversChapterSection pg:ImapIdle .
pg:GmailByProtocol a ipo:ChapterSection ; rdfs:label "Gmail by protocol"@en ;
    skos:definition "Google documents imap.gmail.com on port 993 and smtp.gmail.com on 465 or 587, and says that these servers accept OAuth 2.0 through the SASL XOAUTH2 mechanism (Google, 2026). The chapter says only that Gmail does not let a program use the standard protocols as easily as EZGmail does (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GmailByProtocol> ;
    sen0414:anchor "#s-GmailByProtocol" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:StandardLibraryMail .
pg:Page ipo:coversChapterSection pg:GmailByProtocol .
pg:GmailEndpoints a ipo:ChapterSection ; rdfs:label "Gmail endpoints"@en ;
    skos:definition "Google documents imap.gmail.com on 993 with SSL, and smtp.gmail.com on 465 with SSL or 587 with STARTTLS (Google, 2026). The chapter names no host (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GmailEndpoints> ;
    sen0414:anchor "#s-GmailEndpoints" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailByProtocol .
pg:Page ipo:coversChapterSection pg:GmailEndpoints .
pg:XoauthString a ipo:ChapterSection ; rdfs:label "Xoauth string"@en ;
    skos:definition "The SASL XOAUTH2 initial response is user=NAME, Control-A, auth=Bearer TOKEN, two Control-A, in base64, as Google documents (Google, 2026). The chapter does not touch this level (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_XoauthString> ;
    sen0414:anchor "#s-XoauthString" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GmailByProtocol .
pg:Page ipo:coversChapterSection pg:XoauthString .
pg:SmsGateways a ipo:ChapterSection ; rdfs:label "Sms gateways"@en ;
    skos:definition "The chapter's second section sends a text message as an email to the SMS gateway of a phone company, lists 12 providers in Table 20-1, and warns that a gateway that works today may not work tomorrow; for reliability it names Twilio (Sweigart, 2025). Two providers have since published the end of their gateways (ATT, 2025)(Verizon, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_SmsGateways> ;
    sen0414:anchor "#s-SmsGateways" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:SmsGateways .
pg:GatewayAddressing a ipo:ChapterSection ; rdfs:label "Gateway addressing"@en ;
    skos:definition "An SMS gateway address is the phone number, an @ and the domain of the phone company, as in 2125551234@vtext.com, and Table 20-1 gives an SMS domain and an MMS domain for 12 providers (Sweigart, 2025). The subject and body of the email become the body of the text message (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GatewayAddressing> ;
    sen0414:anchor "#s-GatewayAddressing" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SmsGateways .
pg:Page ipo:coversChapterSection pg:GatewayAddressing .
pg:GatewayAddress a ipo:ChapterSection ; rdfs:label "Gateway address"@en ;
    skos:definition "Table 20-1 lists 12 providers with an SMS gateway and an MMS gateway, written number@domain, and the text says the number and the domain of the phone company make up the recipient address (Sweigart, 2025). Five rows say Same as SMS for the MMS gateway (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GatewayAddress> ;
    sen0414:anchor "#s-GatewayAddress" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GatewayAddressing .
pg:Page ipo:coversChapterSection pg:GatewayAddress .
pg:SharedGateway a ipo:ChapterSection ; rdfs:label "Shared gateway"@en ;
    skos:definition "Verizon and Xfinity Mobile have the same SMS gateway, number@vtext.com, in Table 20-1, and different MMS gateways, vzwpix.com and mypixmessages.com (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_SharedGateway> ;
    sen0414:anchor "#s-SharedGateway" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GatewayAddressing .
pg:Page ipo:coversChapterSection pg:SharedGateway .
pg:GatewayRetreat a ipo:ChapterSection ; rdfs:label "Gateway retreat"@en ;
    skos:definition "The chapter lists five disadvantages of the gateways and says that one that works today may not work tomorrow (Sweigart, 2025). ATT's support article says its gateway ended in 2025, Verizon's notice says its gateway is being shut down, and Twilio is the paid service the chapter names instead (ATT, 2025)(Verizon, 2026)(Twilio, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_GatewayRetreat> ;
    sen0414:anchor "#s-GatewayRetreat" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SmsGateways .
pg:Page ipo:coversChapterSection pg:GatewayRetreat .
pg:AttNotice a ipo:ChapterSection ; rdfs:label "Att notice"@en ;
    skos:definition "Table 20-1 begins with ATT and its txt.att.net and mms.att.net gateways, and the chapter warns that a gateway that works today may not work tomorrow (Sweigart, 2025). ATT's support article says that on June 17, 2025 its email-to-text and text-to-email service was shut down (ATT, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_AttNotice> ;
    sen0414:anchor "#s-AttNotice" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GatewayRetreat .
pg:Page ipo:coversChapterSection pg:AttNotice .
pg:VerizonNotice a ipo:ChapterSection ; rdfs:label "Verizon notice"@en ;
    skos:definition "The chapter's own example sends a text to 2125551234@vtext.com (Sweigart, 2025). Verizon's notice says it has begun to shut down email-to-text for Vtext.com and VZWPix.com, expects to complete it by 03/31/2027, and says some senders may lose access earlier (Verizon, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_VerizonNotice> ;
    sen0414:anchor "#s-VerizonNotice" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GatewayRetreat .
pg:Page ipo:coversChapterSection pg:VerizonNotice .
pg:DomainStatus a ipo:ChapterSection ; rdfs:label "Domain status"@en ;
    skos:definition "The chapter says a gateway is an email server of the phone company, which means its domain should have mail exchanger records in DNS (Sweigart, 2025)(Klensin, 2008)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_DomainStatus> ;
    sen0414:anchor "#s-DomainStatus" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GatewayRetreat .
pg:Page ipo:coversChapterSection pg:DomainStatus .
pg:TwilioInstead a ipo:ChapterSection ; rdfs:label "Twilio instead"@en ;
    skos:definition "The chapter names the API of a telecom service provider such as Twilio as the more reliable way to send texts, and says such services often require a subscription or fees and an application (Sweigart, 2025). Twilio's compliance documentation describes the registration that senders of application-to-person texts to US numbers go through (Twilio, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_TwilioInstead> ;
    sen0414:anchor "#s-TwilioInstead" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:GatewayRetreat .
pg:Page ipo:coversChapterSection pg:TwilioInstead .
pg:SmsLimits a ipo:ChapterSection ; rdfs:label "Sms limits"@en ;
    skos:definition "The chapter says that SMS gateways limit a message to 160 characters and MMS has no limit (Sweigart, 2025). The limit comes from the encoding: 140 bytes hold 160 characters of 7 bits in GSM-7, and 70 characters of 16 bits when a character outside the set forces UCS-2 (Twilio, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_SmsLimits> ;
    sen0414:anchor "#s-SmsLimits" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:SmsGateways .
pg:Page ipo:coversChapterSection pg:SmsLimits .
pg:Gsm7Length a ipo:ChapterSection ; rdfs:label "Gsm7 length"@en ;
    skos:definition "The chapter says an SMS gateway limits a message to 160 characters (Sweigart, 2025). Twilio's page explains that an SMS carries 140 bytes, which hold 160 characters of 7 bits in GSM-7, and that a character such as { or ] needs an escape and counts as two (Twilio, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_Gsm7Length> ;
    sen0414:anchor "#s-Gsm7Length" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SmsLimits .
pg:Page ipo:coversChapterSection pg:Gsm7Length .
pg:Ucs2Length a ipo:ChapterSection ; rdfs:label "Ucs2 length"@en ;
    skos:definition "Twilio's page says devices change to UCS-2, which uses 16 bits per character, when a text needs a character outside the GSM-7 tables (Twilio, 2026). The chapter does not mention encodings (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_Ucs2Length> ;
    sen0414:anchor "#s-Ucs2Length" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SmsLimits .
pg:Page ipo:coversChapterSection pg:Ucs2Length .
pg:NtfyPush a ipo:ChapterSection ; rdfs:label "Ntfy push"@en ;
    skos:definition "The chapter's third section sends and receives push notifications through the free service ntfy with the Requests library: a POST to a topic URL, the headers Title, Tags and Priority, and a GET of the topic with /json?poll=1 and since (Sweigart, 2025). The ntfy documentation describes the same interface, its limits and its event types (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_NtfyPush> ;
    sen0414:anchor "#s-NtfyPush" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:NtfyPush .
pg:NtfyPublishing a ipo:ChapterSection ; rdfs:label "Ntfy publishing"@en ;
    skos:definition "The chapter publishes with requests.post(url, 'Hello, world!') and adds the headers Title, Tags and Priority as a dictionary; it says the free limits are 250 messages a day and 4,096 bytes a message (Sweigart, 2025). The ntfy documentation says the body is the message and the headers carry the metadata (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_NtfyPublishing> ;
    sen0414:anchor "#s-NtfyPublishing" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:NtfyPush .
pg:Page ipo:coversChapterSection pg:NtfyPublishing .
pg:PostBody a ipo:ChapterSection ; rdfs:label "Post body"@en ;
    skos:definition "The chapter publishes with requests.post('https://ntfy.sh/AlSweigartZPgxBQ42', 'Hello, world!') and says it is a POST, unlike the GET of chapter 13 (Sweigart, 2025). The ntfy documentation says the body of the request is the message (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_PostBody> ;
    sen0414:anchor "#s-PostBody" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfyPublishing .
pg:Page ipo:coversChapterSection pg:PostBody .
pg:MetadataHeaders a ipo:ChapterSection ; rdfs:label "Metadata headers"@en ;
    skos:definition "The chapter sends Title, Tags and Priority as HTTP headers in a dictionary, with a priority from 1 to 5 whose default is 3 (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_MetadataHeaders> ;
    sen0414:anchor "#s-MetadataHeaders" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfyPublishing .
pg:Page ipo:coversChapterSection pg:MetadataHeaders .
pg:BodyEncoding a ipo:ChapterSection ; rdfs:label "Body encoding"@en ;
    skos:definition "The chapter posts English text only (Sweigart, 2025). HTTP says nothing of the charset of a body without a Content-Type, and ntfy's documentation speaks of messages that consist of non UTF-8 characters being turned into attachments (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_BodyEncoding> ;
    sen0414:anchor "#s-BodyEncoding" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfyPublishing .
pg:Page ipo:coversChapterSection pg:BodyEncoding .
pg:ResponseObject a ipo:ChapterSection ; rdfs:label "Response object"@en ;
    skos:definition "The chapter does not use the Response that post returns, and says that a reserved topic gives a Response with status 403 (Sweigart, 2025). Requests raises for a bad status only when raise_for_status() is called."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ResponseObject> ;
    sen0414:anchor "#s-ResponseObject" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfyPublishing .
pg:Page ipo:coversChapterSection pg:ResponseObject .
pg:NtfySubscribing a ipo:ChapterSection ; rdfs:label "Ntfy subscribing"@en ;
    skos:definition "The chapter reads a topic with requests.get(url + '/json?poll=1'), optionally with since=10m, since=2h30m, a timestamp or a message id, and parses the answer line by line with json.loads (Sweigart, 2025). The ntfy documentation lists six event types and the fields of a message (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_NtfySubscribing> ;
    sen0414:anchor "#s-NtfySubscribing" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:NtfyPush .
pg:Page ipo:coversChapterSection pg:NtfySubscribing .
pg:PollUrl a ipo:ChapterSection ; rdfs:label "Poll url"@en ;
    skos:definition "The chapter polls with a GET of https://ntfy.sh/AlSweigartZPgxBQ42/json?poll=1 and a since parameter that takes 10m, 2h30m, a Unix timestamp or a message id (Sweigart, 2025)(Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_PollUrl> ;
    sen0414:anchor "#s-PollUrl" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfySubscribing .
pg:Page ipo:coversChapterSection pg:PollUrl .
pg:JsonLines a ipo:ChapterSection ; rdfs:label "Json lines"@en ;
    skos:definition "The chapter says the answer is not valid JSON, because it holds a JSON object on each line, so it uses splitlines() and json.loads() on each line (Sweigart, 2025). The ntfy documentation names a way to subscribe as a JSON stream, with the fields of a message in a table (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_JsonLines> ;
    sen0414:anchor "#s-JsonLines" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfySubscribing .
pg:Page ipo:coversChapterSection pg:JsonLines .
pg:EventFields a ipo:ChapterSection ; rdfs:label "Event fields"@en ;
    skos:definition "The chapter lists the keys id, time, expires, event, topic, title, message, priority and tags, and four event values: message, open, keepalive and poll_request (Sweigart, 2025). The ntfy documentation lists six: open, keepalive, message, message_delete, message_clear and poll_request (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_EventFields> ;
    sen0414:anchor "#s-EventFields" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfySubscribing .
pg:Page ipo:coversChapterSection pg:EventFields .
pg:NtfyServiceLimits a ipo:ChapterSection ; rdfs:label "Ntfy service limits"@en ;
    skos:definition "The chapter says that the topic name is a password, that the free limits are 250 messages a day and 4,096 bytes, and that flooding may get an IP address blocked (Sweigart, 2025). The ntfy FAQ says that without access control the name of a topic is the only protection (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_NtfyServiceLimits> ;
    sen0414:anchor "#s-NtfyServiceLimits" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:NtfyPush .
pg:Page ipo:coversChapterSection pg:NtfyServiceLimits .
pg:TopicSecrecy a ipo:ChapterSection ; rdfs:label "Topic secrecy"@en ;
    skos:definition "The chapter says to treat the topic name as a password and uses AlSweigartZPgxBQ42 in its examples (Sweigart, 2025). ntfy's FAQ says that without access control the topic name is the password and that a randomly generated name is as good as a good password (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_TopicSecrecy> ;
    sen0414:anchor "#s-TopicSecrecy" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfyServiceLimits .
pg:Page ipo:coversChapterSection pg:TopicSecrecy .
pg:DailyAndSize a ipo:ChapterSection ; rdfs:label "Daily and size"@en ;
    skos:definition "The chapter says free users are limited to 250 messages a day and messages to 4,096 bytes (Sweigart, 2025). The ntfy documentation says a longer message is treated as an attachment (Heckel, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_DailyAndSize> ;
    sen0414:anchor "#s-DailyAndSize" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfyServiceLimits .
pg:Page ipo:coversChapterSection pg:DailyAndSize .
pg:ServiceHealth a ipo:ChapterSection ; rdfs:label "Service health"@en ;
    skos:definition "The ntfy server has a health endpoint at /v1/health, and the chapter's link https://ntfy.sh answers the web app (Heckel, 2026)(Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ServiceHealth> ;
    sen0414:anchor "#s-ServiceHealth" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NtfyServiceLimits .
pg:Page ipo:coversChapterSection pg:ServiceHealth .
pg:EmailTrust a ipo:ChapterSection ; rdfs:label "Email trust"@en ;
    skos:definition "The chapter says in its last practice program that it is fairly trivial for hackers to fake a from address, and that the program should require a password (Sweigart, 2025). The standards separate the envelope of SMTP from the header of the message, and SPF and DMARC are the records through which a receiver judges the sender (Klensin, 2008)(Resnick, 2008)(Kitterman, 2014)(Kucherawy and Zwicky, 2015)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_EmailTrust> ;
    sen0414:anchor "#s-EmailTrust" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:EmailTrust .
pg:EnvelopeAndHeaders a ipo:ChapterSection ; rdfs:label "Envelope and headers"@en ;
    skos:definition "SMTP carries an envelope, MAIL FROM and RCPT TO, and a message with headers From, To and Date; RFC 5321 defines the envelope and RFC 5322 the message, whose lines are capped at 998 characters with 78 recommended (Klensin, 2008)(Resnick, 2008). The chapter's remark that a from address is easy to fake rests on this split (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_EnvelopeAndHeaders> ;
    sen0414:anchor "#s-EnvelopeAndHeaders" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:EmailTrust .
pg:Page ipo:coversChapterSection pg:EnvelopeAndHeaders .
pg:EnvelopeVersusHeader a ipo:ChapterSection ; rdfs:label "Envelope versus header"@en ;
    skos:definition "SMTP separates the envelope from the message: MAIL FROM and RCPT TO name the sender and recipients, while the From and To headers are text that the sender writes (Klensin, 2008)(Resnick, 2008). The chapter says it is fairly trivial for hackers to fake a from address (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_EnvelopeVersusHeader> ;
    sen0414:anchor "#s-EnvelopeVersusHeader" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:EnvelopeAndHeaders .
pg:Page ipo:coversChapterSection pg:EnvelopeVersusHeader .
pg:HeaderLineLimits a ipo:ChapterSection ; rdfs:label "Header line limits"@en ;
    skos:definition "RFC 5322 caps a line at 998 characters and recommends 78, and long header values are folded (Resnick, 2008). The policy objects of the email package carry a max_line_length (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_HeaderLineLimits> ;
    sen0414:anchor "#s-HeaderLineLimits" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:EnvelopeAndHeaders .
pg:Page ipo:coversChapterSection pg:HeaderLineLimits .
pg:MessageIdAndDate a ipo:ChapterSection ; rdfs:label "Message id and date"@en ;
    skos:definition "Every message should carry a Message-ID and a Date header (Resnick, 2008). The email.utils module provides make_msgid(), formatdate() and format_datetime() for them (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_MessageIdAndDate> ;
    sen0414:anchor "#s-MessageIdAndDate" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:EnvelopeAndHeaders .
pg:Page ipo:coversChapterSection pg:MessageIdAndDate .
pg:SenderAuthentication a ipo:ChapterSection ; rdfs:label "Sender authentication"@en ;
    skos:definition "SPF publishes in DNS which hosts may send for a domain, and DMARC publishes what a receiver should do with a message that fails both SPF and DKIM alignment; both are TXT records (Kitterman, 2014)(Kucherawy and Zwicky, 2015). Google's sender guidelines require them from senders of more than 5,000 messages a day to Gmail (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_SenderAuthentication> ;
    sen0414:anchor "#s-SenderAuthentication" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:EmailTrust .
pg:Page ipo:coversChapterSection pg:SenderAuthentication .
pg:DmarcRecordParse a ipo:ChapterSection ; rdfs:label "Dmarc record parse"@en ;
    skos:definition "A DMARC record is a TXT record at _dmarc.domain of tag=value pairs separated by semicolons, with the tags v, p, sp, rua, pct, adkim and aspf (Kucherawy and Zwicky, 2015). Google's sender guidelines require DMARC from senders of more than 5,000 messages a day (Google, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_DmarcRecordParse> ;
    sen0414:anchor "#s-DmarcRecordParse" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SenderAuthentication .
pg:Page ipo:coversChapterSection pg:DmarcRecordParse .
pg:SpfRecordParse a ipo:ChapterSection ; rdfs:label "Spf record parse"@en ;
    skos:definition "An SPF record is a TXT record that begins v=spf1 followed by mechanisms and modifiers, such as include, ip4, redirect and the qualifier at the end, and a check is limited to 10 mechanisms and modifiers that cause DNS lookups (Kitterman, 2014). The chapter does not mention it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_SpfRecordParse> ;
    sen0414:anchor "#s-SpfRecordParse" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:SenderAuthentication .
pg:Page ipo:coversChapterSection pg:SpfRecordParse .
pg:HeaderInjection a ipo:ChapterSection ; rdfs:label "Header injection"@en ;
    skos:definition "A header value that contains a line break lets its writer add headers of his own; the email package and ezgmail refuse it, and a subject that reaches a shell can add commands the same way (Python Software Foundation, 2026)(Resnick, 2008). The chapter's last program runs programs on the strength of an email, which is the risky case (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_HeaderInjection> ;
    sen0414:anchor "#s-HeaderInjection" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:EmailTrust .
pg:Page ipo:coversChapterSection pg:HeaderInjection .
pg:NewlineInHeader a ipo:ChapterSection ; rdfs:label "Newline in header"@en ;
    skos:definition "A line break in a header value lets its writer start another header, Bcc for instance; the email package refuses it (Python Software Foundation, 2026)(Resnick, 2008). The chapter takes the subject from the caller (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_NewlineInHeader> ;
    sen0414:anchor "#s-NewlineInHeader" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:HeaderInjection .
pg:Page ipo:coversChapterSection pg:NewlineInHeader .
pg:CommandInjectionRefused a ipo:ChapterSection ; rdfs:label "Command injection refused"@en ;
    skos:definition "The last practice program runs the instruction found in an email with subprocess.Popen, and requires a password in the mail (Sweigart, 2025). Text from a stranger's email that reaches a shell is the case that follows from this."@en ; dcterms:source <http://example.org/sen0414/ch20#S_CommandInjectionRefused> ;
    sen0414:anchor "#s-CommandInjectionRefused" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:HeaderInjection .
pg:Page ipo:coversChapterSection pg:CommandInjectionRefused .
pg:BookAndPractice a ipo:ChapterSection ; rdfs:label "Book and practice"@en ;
    skos:definition "This subject holds what the chapter itself shows and asks: 15 listings with printed outputs, five practice questions with the answers of Appendix B, and three practice programs, Umbrella Reminder, Auto Unsubscriber and Email-Based Computer Control (Sweigart, 2025)(Sweigart, 2025). The chapter replaces chapter 18 of the 2nd edition, which taught smtplib, imapclient, pyzmail and Twilio (Sweigart, 2019)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_BookAndPractice> ;
    sen0414:anchor "#s-BookAndPractice" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:BookAndPractice .
pg:ListingsAsPrinted a ipo:ChapterSection ; rdfs:label "Listings as printed"@en ;
    skos:definition "The chapter prints 15 listings with their outputs and a date in 2026 in several of them (Sweigart, 2025). A reader who types the listings meets the Google Cloud steps first, because ezgmail cannot send or read without a credentials file (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ListingsAsPrinted> ;
    sen0414:anchor "#s-ListingsAsPrinted" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BookAndPractice .
pg:Page ipo:coversChapterSection pg:ListingsAsPrinted .
pg:ListingsReplay a ipo:ChapterSection ; rdfs:label "Listings replay"@en ;
    skos:definition "The chapter's listings are typed into the interactive shell in order, from import ezgmail to the Popen of qBittorrent (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ListingsReplay> ;
    sen0414:anchor "#s-ListingsReplay" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ListingsAsPrinted .
pg:Page ipo:coversChapterSection pg:ListingsReplay .
pg:ExampleDates a ipo:ChapterSection ; rdfs:label "Example dates"@en ;
    skos:definition "The chapter prints datetime.datetime.fromtimestamp(1797823712) as 2026-12-20 21:28:32 and a message timestamp of 2026-12-09 13:28:48 (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_ExampleDates> ;
    sen0414:anchor "#s-ExampleDates" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ListingsAsPrinted .
pg:Page ipo:coversChapterSection pg:ExampleDates .
pg:AppendixAnswers a ipo:ChapterSection ; rdfs:label "Appendix answers"@en ;
    skos:definition "Appendix B answers Question 1 with the credentials.json and token.json files telling EZGmail which Google account to use, Question 3 with the text has:attachment passed to search(), and Question 5 with the Requests library (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_AppendixAnswers> ;
    sen0414:anchor "#s-AppendixAnswers" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ListingsAsPrinted .
pg:Page ipo:coversChapterSection pg:AppendixAnswers .
pg:PracticePrograms a ipo:ChapterSection ; rdfs:label "Practice programs"@en ;
    skos:definition "The chapter asks for three programs: an Umbrella Reminder that checks weather.gov and texts the reader, an Auto Unsubscriber that finds unsubscribe links in all mail and opens them with webbrowser, and an Email-Based Computer Control that checks mail or ntfy every 15 minutes, requires a password, runs the instruction and deletes the mail (Sweigart, 2025). The National Weather Service documents the API that the first one can use (National Weather Service, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_PracticePrograms> ;
    sen0414:anchor "#s-PracticePrograms" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BookAndPractice .
pg:Page ipo:coversChapterSection pg:PracticePrograms .
pg:UmbrellaReminder a ipo:ChapterSection ; rdfs:label "Umbrella reminder"@en ;
    skos:definition "The first practice program asks for a program that checks whether rain is in the forecast for the day and texts a reminder, using weather.gov as in chapter 13 (Sweigart, 2025). The National Weather Service documents an API whose forecast periods carry a short forecast and a probability of precipitation (National Weather Service, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_UmbrellaReminder> ;
    sen0414:anchor "#s-UmbrellaReminder" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticePrograms .
pg:Page ipo:coversChapterSection pg:UmbrellaReminder .
pg:AutoUnsubscriber a ipo:ChapterSection ; rdfs:label "Auto unsubscriber"@en ;
    skos:definition "The second practice program scans all mail for links whose text says unsubscribe, with Beautiful Soup, and opens them with webbrowser.open() (Sweigart, 2025). RFC 2369 defines the List-Unsubscribe header and RFC 8058 the one-click form (Neufeld and Baer, 1998)(Leonard, 2017)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_AutoUnsubscriber> ;
    sen0414:anchor "#s-AutoUnsubscriber" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticePrograms .
pg:Page ipo:coversChapterSection pg:AutoUnsubscriber .
pg:EmailControlLoop a ipo:ChapterSection ; rdfs:label "Email control loop"@en ;
    skos:definition "The third practice program checks mail or ntfy every 15 minutes, requires a password in the message, launches a program with subprocess.Popen, waits for it, and deletes the mail it handled (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_EmailControlLoop> ;
    sen0414:anchor "#s-EmailControlLoop" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticePrograms .
pg:Page ipo:coversChapterSection pg:EmailControlLoop .
pg:EditionChange a ipo:ChapterSection ; rdfs:label "Edition change"@en ;
    skos:definition "Chapter 20 of the 3rd edition replaces chapter 18 of the 2nd edition, Sending Email and Text Messages, which taught smtplib, imapclient, pyzmail and Twilio (Sweigart, 2025)(Sweigart, 2019). The chapter ends by pointing to the book's page for an example implementation (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_EditionChange> ;
    sen0414:anchor "#s-EditionChange" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BookAndPractice .
pg:Page ipo:coversChapterSection pg:EditionChange .
pg:SecondEditionContent a ipo:ChapterSection ; rdfs:label "Second edition content"@en ;
    skos:definition "Chapter 18 of the 2nd edition, Sending Email and Text Messages, taught smtplib, imapclient, pyzmail and Twilio (Sweigart, 2019). The 3rd edition's chapter 20 says EZGmail is better than smtplib and imaplib for Gmail (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_SecondEditionContent> ;
    sen0414:anchor "#s-SecondEditionContent" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:EditionChange .
pg:Page ipo:coversChapterSection pg:SecondEditionContent .
pg:MissingExampleImplementation a ipo:ChapterSection ; rdfs:label "Missing example implementation"@en ;
    skos:definition "Chapter 20 says that a reader who is stuck on the Email-Based Computer Control program can download an example implementation from the book page of No Starch Press (Sweigart, 2025)(No Starch Press, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch20#S_MissingExampleImplementation> ;
    sen0414:anchor "#s-MissingExampleImplementation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:EditionChange .
