chx:X_RaiseStatement a owl:NamedIndividual, chx:RaiseStatement ; rdfs:label "raise Exception('message')"@en ; skos:definition "A raise statement stops the running code and passes an exception to the nearest matching except clause, which is how a function tells its caller that a call was invalid."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_ExceptionMessage a owl:NamedIndividual, chx:ExceptionMessage ; rdfs:label "except Exception as err:"@en ; skos:definition "The text passed to an exception is kept in its args and printed by str, so an except clause can show a message written for the user instead of a traceback."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_ExceptionMessage a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda e: (e.args, str(e)))(Exception('custom message')) evaluates to (('custom message',), 'custom message')"@en ; chx:input "(lambda e: (e.args, str(e)))(Exception('custom message'))" ; chx:output "(('custom message',), 'custom message')" .
chx:X_ExceptionMessage rd:hasIOExample chx:IO_ExceptionMessage .
chx:X_ExceptionUnwinding a owl:NamedIndividual, chx:ExceptionUnwinding ; rdfs:label "process calls load calls read_age"@en ; skos:definition "An exception that no function handles leaves each function in turn, up the call stack, until an except clause matches it or the program ends with a traceback."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_TracebackReading a owl:NamedIndividual, chx:TracebackReading ; rdfs:label "File, line, in, source line"@en ; skos:definition "A traceback lists the calls from the outermost to the one that raised, each with file, line, function and source line, and ends with the exception class and message."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_FineGrainedLocations a owl:NamedIndividual, chx:FineGrainedLocations ; rdfs:label "~~~~^^^^^"@en ; skos:definition "Since Python 3.11 a traceback marks the failing part of a line, so which subscript or call failed in a chained expression can be read from it."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_ExceptionNotes a owl:NamedIndividual, chx:ExceptionNotes ; rdfs:label "e.add_note('while reading the age field')"@en ; skos:definition "An exception can carry notes added with add_note, kept in __notes__ and printed after the traceback, so code that re-raises can add context."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_ExceptionNotes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda e: (e.add_note('n'), e.__notes__)[1])(ValueError('x')) evaluates to ['n']"@en ; chx:input "(lambda e: (e.add_note('n'), e.__notes__)[1])(ValueError('x'))" ; chx:output "['n']" .
chx:X_ExceptionNotes rd:hasIOExample chx:IO_ExceptionNotes .
chx:X_AssertStatement a owl:NamedIndividual, chx:AssertStatement ; rdfs:label "assert ages[0] <= ages[-1]"@en ; skos:definition "An assert statement checks a condition the programmer believes is true and raises AssertionError when it is false."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_AssertionFailure a owl:NamedIndividual, chx:AssertionFailure ; rdfs:label "AssertionError"@en ; skos:definition "A failed assertion is an ordinary exception of class AssertionError; the chapter advises against catching it, since it reports a programmer error."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_AssertionFailure a owl:NamedIndividual, rd:IOExample ; rdfs:label "issubclass(AssertionError, Exception) evaluates to True"@en ; chx:input "issubclass(AssertionError, Exception)" ; chx:output "True" .
chx:X_AssertionFailure rd:hasIOExample chx:IO_AssertionFailure .
chx:X_AssertMessage a owl:NamedIndividual, chx:AssertMessage ; rdfs:label "assert x > 0, f'x must be positive, got {x}'"@en ; skos:definition "An assert statement can carry a second expression, evaluated only on failure, whose text becomes the message of the AssertionError."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_AssertVersusRaise a owl:NamedIndividual, chx:AssertVersusRaise ; rdfs:label "user error or programmer error"@en ; skos:definition "An error the user can cause is checked with an if and a raise; an assert states what must be true if the program is correct."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_OptimisedMode a owl:NamedIndividual, chx:OptimisedMode ; rdfs:label "python -O"@en ; skos:definition "Under the -O option, and in code compiled with optimisation, assert statements produce no code at all, so a check that must always run is not written as an assertion."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_OptimisedMode a owl:NamedIndividual, rd:IOExample ; rdfs:label "__debug__ evaluates to True"@en ; chx:input "__debug__" ; chx:output "True" .
chx:X_OptimisedMode rd:hasIOExample chx:IO_OptimisedMode .
chx:X_BasicConfig a owl:NamedIndividual, chx:BasicConfig ; rdfs:label "logging.basicConfig(level=logging.DEBUG)"@en ; skos:definition "basicConfig sets the threshold, the format and the destination of the root logger; the chapter calls it once at the top of a program."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_LogFormat a owl:NamedIndividual, chx:LogFormat ; rdfs:label "%(asctime)s - %(levelname)s - %(message)s"@en ; skos:definition "A format string with named fields decides what each log line shows; the chapter's shows time, level and message."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_LogToFile a owl:NamedIndividual, chx:LogToFile ; rdfs:label "basicConfig(filename='myProgramLog.txt')"@en ; skos:definition "Passing filename to basicConfig sends the messages to a text file instead of the screen."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_ForceReconfigure a owl:NamedIndividual, chx:ForceReconfigure ; rdfs:label "basicConfig(force=True)"@en ; skos:definition "basicConfig does nothing if the root logger already has handlers, so a second call is ignored unless force=True is passed."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_LoggingLevels a owl:NamedIndividual, chx:LoggingLevels ; rdfs:label "DEBUG, INFO, WARNING, ERROR, CRITICAL"@en ; skos:definition "The five levels run from lowest to highest importance, and each has a number: 10, 20, 30, 40 and 50."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_LoggingLevels a owl:NamedIndividual, rd:IOExample ; rdfs:label "[getattr(__import__('logging'), n) for n in ('DEBUG','INFO','WARNING','ERROR','CRITICAL')] evaluates to [10, 20, 30, 40, 50]"@en ; chx:input "[getattr(__import__('logging'), n) for n in ('DEBUG','INFO','WARNING','ERROR','CRITICAL')]" ; chx:output "[10, 20, 30, 40, 50]" .
chx:X_LoggingLevels rd:hasIOExample chx:IO_LoggingLevels .
chx:X_LevelThreshold a owl:NamedIndividual, chx:LevelThreshold ; rdfs:label "level=logging.INFO"@en ; skos:definition "A message is shown only if its level is at least the threshold, so raising the threshold hides the lower levels without deleting any call."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_DefaultLevel a owl:NamedIndividual, chx:DefaultLevel ; rdfs:label "the default threshold is WARNING"@en ; skos:definition "Without basicConfig the threshold is WARNING, so debug and info calls print nothing and warning and error calls print to standard error."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_DefaultLevel a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('logging').getLogger().getEffectiveLevel() evaluates to 30"@en ; chx:input "__import__('logging').getLogger().getEffectiveLevel()" ; chx:output "30" .
chx:X_DefaultLevel rd:hasIOExample chx:IO_DefaultLevel .
chx:X_DisablingLogging a owl:NamedIndividual, chx:DisablingLogging ; rdfs:label "logging.disable(logging.CRITICAL)"@en ; skos:definition "logging.disable silences the given level and all below it; disabling CRITICAL turns every message off, and NOTSET turns them back on."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_LoggingVersusPrint a owl:NamedIndividual, chx:LoggingVersusPrint ; rdfs:label "print or logging.debug"@en ; skos:definition "Log messages are for the programmer and print is for the user; log calls stay in the program and one setting switches them all off, where print calls would each have to be deleted."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_LazyFormatting a owl:NamedIndividual, chx:LazyFormatting ; rdfs:label "log.debug('value is %s', obj)"@en ; skos:definition "A message given arguments is formatted only when it is emitted, so a disabled debug call costs no string conversion, unlike an f-string built before the call."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_Breakpoint a owl:NamedIndividual, chx:Breakpoint ; rdfs:label "a red dot at a line number"@en ; skos:definition "A breakpoint marks a line at which the debugger pauses the running program so its variables can be read."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_ContinueControl a owl:NamedIndividual, chx:ContinueControl ; rdfs:label "Continue"@en ; skos:definition "Continue runs the program until the next breakpoint or the end."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_StepIn a owl:NamedIndividual, chx:StepIn ; rdfs:label "Step In"@en ; skos:definition "Step In executes the next line and, if that line is a call, pauses on the first line of the called function."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_StepOver a owl:NamedIndividual, chx:StepOver ; rdfs:label "Step Over"@en ; skos:definition "Step Over executes the next line as a whole, running a called function without pausing inside it."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_StepOut a owl:NamedIndividual, chx:StepOut ; rdfs:label "Step Out"@en ; skos:definition "Step Out runs the rest of the current function and pauses back in the caller."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_BreakpointFunction a owl:NamedIndividual, chx:BreakpointFunction ; rdfs:label "breakpoint()"@en ; skos:definition "The built-in breakpoint() pauses the program in the debugger at that line; it calls sys.breakpointhook, and PYTHONBREAKPOINT=0 makes it do nothing."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_BreakpointFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sys').breakpointhook.__name__ evaluates to 'breakpointhook'"@en ; chx:input "__import__('sys').breakpointhook.__name__" ; chx:output "'breakpointhook'" .
chx:X_BreakpointFunction rd:hasIOExample chx:IO_BreakpointFunction .
chx:X_PdbCommands a owl:NamedIndividual, chx:PdbCommands ; rdfs:label "step, next, return, continue, break, where"@en ; skos:definition "The standard debugger pdb offers the chapter's controls as commands: step, next, return, continue and break, and where lists the call stack."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_PdbCommands a owl:NamedIndividual, rd:IOExample ; rdfs:label "[c for c in ('do_step','do_next','do_return','do_continue','do_break','do_where') if hasattr(__import__('pdb').Pdb, c)] evaluates to ['do_step', 'do_next', 'do_return', 'do_continue', 'do_break', 'do_where']"@en ; chx:input "[c for c in ('do_step','do_next','do_return','do_continue','do_break','do_where') if hasattr(__import__('pdb').Pdb, c)]" ; chx:output "['do_step', 'do_next', 'do_return', 'do_continue', 'do_break', 'do_where']" .
chx:X_PdbCommands rd:hasIOExample chx:IO_PdbCommands .
chx:X_RemoteAttach a owl:NamedIndividual, chx:RemoteAttach ; rdfs:label "python -m pdb -p PID"@en ; skos:definition "Since Python 3.14 the debugger can attach to a running process by its identifier, using sys.remote_exec."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_RemoteAttach a owl:NamedIndividual, rd:IOExample ; rdfs:label "callable(__import__('sys').breakpointhook) evaluates to True"@en ; chx:input "callable(__import__('sys').breakpointhook)" ; chx:output "True" .
chx:X_RemoteAttach rd:hasIOExample chx:IO_RemoteAttach .
chx:X_OffByOneRange a owl:NamedIndividual, chx:OffByOneRange ; rdfs:label "range(n + 1) in factorial"@en ; skos:definition "The chapter's factorial multiplies by zero because its range starts at 0; the log shows i as 0 and total as 0 on the first pass, and range(1, n + 1) fixes it."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_StringConcatenation a owl:NamedIndividual, chx:StringConcatenation ; rdfs:label "'5' + '3' + '42'"@en ; skos:definition "input and a list of typed answers give strings, and adding strings joins them, so the sum prints as 5342 until each answer is converted with int."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:X_TypeMismatchComparison a owl:NamedIndividual, chx:TypeMismatchComparison ; rdfs:label "toss == 'heads'"@en ; skos:definition "A number never equals a string, so comparing the integer from randint with 'heads' is always false and the game reports every guess as wrong."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
chx:IO_TypeMismatchComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "0 == 'heads' evaluates to False"@en ; chx:input "0 == 'heads'" ; chx:output "False" .
chx:X_TypeMismatchComparison rd:hasIOExample chx:IO_TypeMismatchComparison .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 5 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch05/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 5 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which constructs signal, check, record and inspect a program's behaviour, and what decides which of them a given problem calls for?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs and concepts of the chapter differ in current Python, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 5 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 5 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-29."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

