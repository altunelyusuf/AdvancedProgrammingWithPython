chx:IO_LogFormat a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "__import__('logging').Formatter('%(levelname)s - %(message)s').format(__import__('logging').LogRecord('app', 10, 'p.py', 1, 'hello', None, None)) evaluates to 'DEBUG - hello'"@en ;
    chx:input "__import__('logging').Formatter('%(levelname)s - %(message)s').format(__import__('logging').LogRecord('app', 10, 'p.py', 1, 'hello', None, None))" ;
    chx:output "'DEBUG - hello'" .

chx:IO_LogRecord a rd:IOExample,
