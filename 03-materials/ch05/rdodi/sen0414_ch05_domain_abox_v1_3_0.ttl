chx:Provenance a rd:ResearchSubjectInput,
        owl:NamedIndividual ;
    rdfs:label "Derived from the chapter 5 research artefact"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 5 through the Stage 1 research artefact; the modern-practice branch and the concepts added in 1.1.0 for terms the chapter uses without explaining (bug, exception class, standard error stream, logger, handler, process, random integer and others) come from that artefact's secondary sources, not from the book."@en,
        "Concepts are corpus-derived from the 3rd edition's chapter 5 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en .

chx:X_AssertStatement a chx:AssertStatement,
        owl:NamedIndividual ;
    rdfs:label "assert ages[0] <= ages[-1]"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "An assert statement checks a condition the programmer believes is true and raises AssertionError when it is false."@en .

chx:X_RaiseStatement a chx:RaiseStatement,
        owl:NamedIndividual ;
    rdfs:label "raise Exception('message')"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A raise statement stops the running code and passes an exception to the nearest matching except clause, which is how a function tells its caller that a call was invalid."@en .

chx:X_BasicConfig a chx:BasicConfig,
        owl:NamedIndividual ;
    rdfs:label "logging.basicConfig(level=logging.DEBUG)"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "basicConfig sets the threshold, the format and the destination of the root logger; the chapter calls it once at the top of a program."@en .

chx:X_Breakpoint a chx:Breakpoint,
        owl:NamedIndividual ;
    rdfs:label "a red dot at a line number"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A breakpoint marks a line at which the debugger pauses the running program so its variables can be read."@en .

chx:X_LoggingLevels a chx:LoggingLevels,
        owl:NamedIndividual ;
    rdfs:label "DEBUG, INFO, WARNING, ERROR, CRITICAL"@en ;
    rd:hasIOExample chx:IO_LoggingLevels ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The five levels run from lowest to highest importance, and each has a number: 10, 20, 30, 40 and 50."@en .

