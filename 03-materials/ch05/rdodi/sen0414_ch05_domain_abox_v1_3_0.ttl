@prefix chx: <http://example.org/sen0414/ch05#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rd: <http://example.org/rdodi/domain-ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chx:Artifact a rd:DomainOntologyArtifact,
        owl:NamedIndividual ;
    rdfs:label "SEN0414 chapter 5 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch05/research> ;
    rd:hasCompetencyQuestion chx:CQs ;
    rd:hasResolutionEnvironment chx:Env ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ;
    rd:hasSourceProvenance chx:Provenance .

chx:X_AccumulatorStart a chx:AccumulatorStart,
        owl:NamedIndividual ;
    rdfs:label "total = 1 before the loop"@en ;
    rd:hasIOExample chx:IO_AccumulatorStart ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The value that an accumulator holds before its loop must suit the operation: 1 for a product, 0 for a sum; a wrong start gives a wrong result without any error."@en .

chx:X_ArgumentValidation a chx:ArgumentValidation,
        owl:NamedIndividual ;
    rdfs:label "if width <= 0: raise ValueError(...)"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Checking the arguments a function receives before using them and raising an exception that names the problem when they are unusable."@en .

chx:X_AssertMessage a chx:AssertMessage,
        owl:NamedIndividual ;
    rdfs:label "assert x > 0, f'x must be positive, got {x}'"@en ;
    chx:hasOwner chx:X_AssertStatement ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "An assert statement can carry a second expression, evaluated only on failure, whose text becomes the message of the AssertionError."@en .

chx:X_AssertVersusRaise a chx:AssertVersusRaise,
        owl:NamedIndividual ;
    rdfs:label "user error or programmer error"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "An error the user can cause is checked with an if and a raise; an assert states what must be true if the program is correct."@en .

chx:X_AssertionFailure a chx:AssertionFailure,
        owl:NamedIndividual ;
    rdfs:label "AssertionError"@en ;
    rd:hasIOExample chx:IO_AssertionFailure ;
    chx:hasOwner chx:X_AssertStatement ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A failed assertion is an ordinary exception of class AssertionError; the chapter advises against catching it, since it reports a programmer error."@en .

chx:X_BreakpointFunction a chx:BreakpointFunction,
        owl:NamedIndividual ;
    rdfs:label "breakpoint()"@en ;
    rd:hasIOExample chx:IO_BreakpointFunction ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The built-in breakpoint() pauses the program in the debugger at that line; it calls sys.breakpointhook, and PYTHONBREAKPOINT=0 makes it do nothing."@en .

chx:X_BreakpointHook a chx:BreakpointHook,
        owl:NamedIndividual ;
    rdfs:label "PYTHONBREAKPOINT=builtins.print"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The function sys.breakpointhook is what breakpoint() calls; by default it starts pdb, but the environment variable PYTHONBREAKPOINT or a replacement function can change it."@en .

chx:X_Bug a chx:Bug,
        owl:NamedIndividual ;
    rdfs:label "the product 1 * 0 * 1 * 2 * 3 * 4 * 5"@en ;
    rd:hasIOExample chx:IO_Bug ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A place where a program does something other than what its author intended; the chapter's factorial multiplies by 0 and so returns 0 instead of 120."@en .

chx:X_CommandLine a chx:CommandLine,
        owl:NamedIndividual ;
    rdfs:label "python myscript.py"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The command line is the line of text typed in a terminal to start a program: the interpreter, then options, then what to run, then arguments for the program."@en .

chx:X_CommandLineOption a chx:CommandLineOption,
        owl:NamedIndividual ;
    rdfs:label "python -O script.py"@en ;
    rd:hasIOExample chx:IO_CommandLineOption ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A flag written after the python command, such as -O, -c, -m or -V, that changes how the interpreter runs."@en .

chx:X_ContinueControl a chx:ContinueControl,
        owl:NamedIndividual ;
    rdfs:label "Continue"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Continue runs the program until the next breakpoint or the end."@en .

chx:X_Debugging a chx:Debugging,
        owl:NamedIndividual ;
    rdfs:label "printing i and total in the loop"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The method of finding the root cause of a bug by making the program show its state, forming a guess about the cause and testing it."@en .

chx:X_DefaultLevel a chx:DefaultLevel,
        owl:NamedIndividual ;
    rdfs:label "the default threshold is WARNING"@en ;
    rd:hasIOExample chx:IO_DefaultLevel ;
    chx:hasOwner chx:X_LoggingLevels ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Without basicConfig the threshold is WARNING, so debug and info calls print nothing and warning and error calls print to standard error."@en .

chx:X_DisablingLogging a chx:DisablingLogging,
        owl:NamedIndividual ;
    rdfs:label "logging.disable(logging.CRITICAL)"@en ;
    chx:hasOwner chx:X_LoggingLevels ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "logging.disable silences the given level and all below it; disabling CRITICAL turns every message off, and NOTSET turns them back on."@en .

chx:X_EnvironmentVariable a chx:EnvironmentVariable,
        owl:NamedIndividual ;
    rdfs:label "PYTHONBREAKPOINT=0"@en ;
    rd:hasIOExample chx:IO_EnvironmentVariable ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A named text setting that the operating system hands to a process when it starts; Python reads it through os.environ."@en .

chx:X_ExceptionClass a chx:ExceptionClass,
        owl:NamedIndividual ;
    rdfs:label "ValueError"@en ;
    rd:hasErrorCondition chx:Err_ExceptionClass ;
    rd:hasIOExample chx:IO_ExceptionClass ;
    chx:hasOwner chx:X_RaiseStatement ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The kind of an exception: ValueError, TypeError and the others are classes derived from Exception, and an except clause catches the classes it names."@en .

chx:X_ExceptionMessage a chx:ExceptionMessage,
        owl:NamedIndividual ;
    rdfs:label "except Exception as err:"@en ;
    rd:hasIOExample chx:IO_ExceptionMessage ;
    chx:hasOwner chx:X_RaiseStatement ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The text passed to an exception is kept in its args and printed by str, so an except clause can show a message written for the user instead of a traceback."@en .

chx:X_ExceptionNotes a chx:ExceptionNotes,
        owl:NamedIndividual ;
    rdfs:label "e.add_note('while reading the age field')"@en ;
    rd:hasIOExample chx:IO_ExceptionNotes ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "An exception can carry notes added with add_note, kept in __notes__ and printed after the traceback, so code that re-raises can add context."@en .

chx:X_ExceptionUnwinding a chx:ExceptionUnwinding,
        owl:NamedIndividual ;
    rdfs:label "process calls load calls read_age"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "An exception that no function handles leaves each function in turn, up the call stack, until an except clause matches it or the program ends with a traceback."@en .

chx:X_FailFast a chx:FailFast,
        owl:NamedIndividual ;
    rdfs:label "assert at the point of the assumption"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Stopping a program as soon as a necessary condition is violated, so that the failure appears near its cause."@en .

chx:X_FileAndDirectory a chx:FileAndDirectory,
        owl:NamedIndividual ;
    rdfs:label "open('workfile', 'w', encoding='utf-8')"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A file is a named piece of stored data that a program can read and write; a directory holds files, and a path says where a file is."@en .

chx:X_FineGrainedLocations a chx:FineGrainedLocations,
        owl:NamedIndividual ;
    rdfs:label "~~~~^^^^^"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Since Python 3.11 a traceback marks the failing part of a line, so which subscript or call failed in a chained expression can be read from it."@en .

chx:X_ForceReconfigure a chx:ForceReconfigure,
        owl:NamedIndividual ;
    rdfs:label "basicConfig(force=True)"@en ;
    chx:hasOwner chx:X_BasicConfig ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "basicConfig does nothing if the root logger already has handlers, so a second call is ignored unless force=True is passed."@en .

chx:X_Handler a chx:Handler,
        owl:NamedIndividual ;
    rdfs:label "logging.StreamHandler / logging.FileHandler"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The object that sends a log record to a destination; basicConfig creates a StreamHandler for the screen or, with filename, a FileHandler for a file."@en .

chx:X_InspectorPane a chx:InspectorPane,
        owl:NamedIndividual ;
    rdfs:label "first, second and third shown as strings"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The pane at the right of the Mu window that lists the current value of each variable of the paused program."@en .

chx:X_InstrumentChoice a chx:InstrumentChoice,
        owl:NamedIndividual ;
    rdfs:label "raise, assert, log or step through?"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Raise when the caller can react to the error, assert when the programmer's belief must hold, log when the run must leave a record, and use the debugger when the state at one point is the question."@en .

chx:X_LazyFormatting a chx:LazyFormatting,
        owl:NamedIndividual ;
    rdfs:label "log.debug('value is %s', obj)"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A message given arguments is formatted only when it is emitted, so a disabled debug call costs no string conversion, unlike an f-string built before the call."@en .

chx:X_LevelThreshold a chx:LevelThreshold,
        owl:NamedIndividual ;
    rdfs:label "level=logging.INFO"@en ;
    chx:hasOwner chx:X_LoggingLevels ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A message is shown only if its level is at least the threshold, so raising the threshold hides the lower levels without deleting any call."@en .

chx:X_LogFormat a chx:LogFormat,
        owl:NamedIndividual ;
    rdfs:label "%(asctime)s - %(levelname)s - %(message)s"@en ;
    rd:hasIOExample chx:IO_LogFormat ;
    chx:hasOwner chx:X_BasicConfig ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A format string with named fields decides what each log line shows; the chapter's shows time, level and message."@en .

chx:X_LogRecord a chx:LogRecord,
        owl:NamedIndividual ;
    rdfs:label "logging.LogRecord(...)"@en ;
    rd:hasIOExample chx:IO_LogRecord ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The object created for every logging event; it carries the logger name, the level, the message and its arguments, and the place of the call."@en .

chx:X_LogToFile a chx:LogToFile,
        owl:NamedIndividual ;
    rdfs:label "basicConfig(filename='myProgramLog.txt')"@en ;
    chx:hasOwner chx:X_BasicConfig ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Passing filename to basicConfig sends the messages to a text file instead of the screen."@en .

chx:X_Logger a chx:Logger,
        owl:NamedIndividual ;
    rdfs:label "logging.getLogger('app')"@en ;
    rd:hasIOExample chx:IO_Logger ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The object that receives log calls; the module-level functions use the root logger, and named loggers form a hierarchy by dotted names."@en .

chx:X_LoggingVersusPrint a chx:LoggingVersusPrint,
        owl:NamedIndividual ;
    rdfs:label "print or logging.debug"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Log messages are for the programmer and print is for the user; log calls stay in the program and one setting switches them all off, where print calls would each have to be deleted."@en .

chx:X_LogicError a chx:LogicError,
        owl:NamedIndividual ;
    rdfs:label "buggy adding program"@en ;
    rd:hasIOExample chx:IO_LogicError ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A mistake that lets the program run to the end without any exception but produces a wrong result, so only the person who knows the right answer can notice it."@en .

chx:X_MembershipTest a chx:MembershipTest,
        owl:NamedIndividual ;
    rdfs:label "guess not in ('heads', 'tails')"@en ;
    rd:hasErrorCondition chx:Err_MembershipTest ;
    rd:hasIOExample chx:IO_MembershipTest ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The in and not in operators test whether a value is a member of a collection; for a string they test whether one string is a substring of another."@en .

chx:X_MuEditor a chx:MuEditor,
        owl:NamedIndividual ;
    rdfs:label "the Mu window with a Debug button next to Run"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The code editor used in the chapter; it has a Run button, a Debug button and a Debug Inspector pane, and its output pane is where a running program receives typed input."@en .

chx:X_ObjectVocabulary a chx:ObjectVocabulary,
        owl:NamedIndividual ;
    rdfs:label "'abc'.upper()"@en ;
    rd:hasIOExample chx:IO_ObjectVocabulary ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "An object is data with state and behaviour; an attribute is a value reached from it by a dotted name, and a method is a function reached the same way and called with parentheses."@en .

chx:X_OffByOneRange a chx:OffByOneRange,
        owl:NamedIndividual ;
    rdfs:label "range(n + 1) in factorial"@en ;
    rd:hasIOExample chx:IO_OffByOneRange ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The chapter's factorial multiplies by zero because its range starts at 0; the log shows i as 0 and total as 0 on the first pass, and range(1, n + 1) fixes it."@en .

chx:X_OptimisedMode a chx:OptimisedMode,
        owl:NamedIndividual ;
    rdfs:label "python -O"@en ;
    rd:hasIOExample chx:IO_OptimisedMode ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Under the -O option, and in code compiled with optimisation, assert statements produce no code at all, so a check that must always run is not written as an assertion."@en .

chx:X_PdbCommands a chx:PdbCommands,
        owl:NamedIndividual ;
    rdfs:label "step, next, return, continue, break, where"@en ;
    rd:hasIOExample chx:IO_PdbCommands ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The standard debugger pdb offers the chapter's controls as commands: step, next, return, continue and break, and where lists the call stack."@en .

chx:X_PercentPlaceholder a chx:PercentPlaceholder,
        owl:NamedIndividual ;
    rdfs:label "'%s has %d quote types.' % ('Python', 2)"@en ;
    rd:hasIOExample chx:IO_PercentPlaceholder ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The old-style way of putting values into a string: % conversion specifications in the string are replaced by the values to the right of the % operator."@en .

chx:X_Process a chx:Process,
        owl:NamedIndividual ;
    rdfs:label "os.getpid()"@en ;
    rd:hasIOExample chx:IO_Process ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A process is a running program as the operating system sees it; each process has its own identifier, which os.getpid() returns."@en .

chx:X_ProgramState a chx:ProgramState,
        owl:NamedIndividual ;
    rdfs:label "heads is 500 at the halfway point"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The state of a program at a moment is the values of its variables together with the line that is about to run; the debugger shows both."@en .

chx:X_RandomInteger a chx:RandomInteger,
        owl:NamedIndividual ;
    rdfs:label "random.randint(0, 1)"@en ;
    rd:hasErrorCondition chx:Err_RandomInteger ;
    rd:hasIOExample chx:IO_RandomInteger ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "random.randint(a, b) returns a random whole number N with a <= N <= b, both ends included."@en .

chx:X_RemoteAttach a chx:RemoteAttach,
        owl:NamedIndividual ;
    rdfs:label "python -m pdb -p PID"@en ;
    rd:hasIOExample chx:IO_RemoteAttach ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Since Python 3.14 the debugger can attach to a running process by its identifier, using sys.remote_exec."@en .

chx:X_RunUnderDebugger a chx:RunUnderDebugger,
        owl:NamedIndividual ;
    rdfs:label "clicking Debug instead of Run"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Running a program under the debugger starts it paused just before its first line, so that the programmer decides how it goes on from there."@en .

chx:X_SanityCheck a chx:SanityCheck,
        owl:NamedIndividual ;
    rdfs:label "ages[0] <= ages[-1] after sorting"@en ;
    rd:hasIOExample chx:IO_SanityCheck ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A cheap test of a result that must hold if the code before it is correct, written to catch an obvious mistake early."@en .

chx:X_SortedOrderCheck a chx:SortedOrderCheck,
        owl:NamedIndividual ;
    rdfs:label "assert ages[0] <= ages[-1]"@en ;
    rd:hasIOExample chx:IO_SortedOrderCheck ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The chapter's example of a sanity check on a list: after sort() the first item is not larger than the last, and after reverse() it is."@en .

chx:X_StandardErrorStream a chx:StandardErrorStream,
        owl:NamedIndividual ;
    rdfs:label "print('...', file=sys.stderr)"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The second output channel of a program, used by the interpreter for tracebacks and error messages, separate from the standard output that print uses."@en .

chx:X_StepIn a chx:StepIn,
        owl:NamedIndividual ;
    rdfs:label "Step In"@en ;
    chx:hasOwner chx:X_Breakpoint ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Step In executes the next line and, if that line is a call, pauses on the first line of the called function."@en .

chx:X_StepOut a chx:StepOut,
        owl:NamedIndividual ;
    rdfs:label "Step Out"@en ;
    chx:hasOwner chx:X_Breakpoint ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Step Out runs the rest of the current function at full speed until it returns."@en .

chx:X_StepOver a chx:StepOver,
        owl:NamedIndividual ;
    rdfs:label "Step Over"@en ;
    chx:hasOwner chx:X_Breakpoint ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "Step Over executes the next line as a whole, running a called function without pausing inside it."@en .

chx:X_StopControl a chx:StopControl,
        owl:NamedIndividual ;
    rdfs:label "the usual Stop button"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "The Stop button ends the debugging session at once and terminates the program without running its remaining lines."@en .

chx:X_StringConcatenation a chx:StringConcatenation,
        owl:NamedIndividual ;
    rdfs:label "'5' + '3' + '42'"@en ;
    rd:hasIOExample chx:IO_StringConcatenation ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "input and a list of typed answers give strings, and adding strings joins them, so the sum prints as 5342 until each answer is converted with int."@en .

chx:X_TracebackReading a chx:TracebackReading,
        owl:NamedIndividual ;
    rdfs:label "File, line, in, source line"@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A traceback lists the calls from the outermost to the one that raised, each with file, line, function and source line, and ends with the exception class and message."@en .

chx:X_TypeMismatchComparison a chx:TypeMismatchComparison,
        owl:NamedIndividual ;
    rdfs:label "toss == 'heads'"@en ;
    rd:hasErrorCondition chx:Err_TypeMismatchComparison ;
    rd:hasIOExample chx:IO_TypeMismatchComparison ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "A number never equals a string, so comparing the integer from randint with 'heads' is always false and the game reports every guess as wrong."@en .

chx:X_UnhandledException a chx:UnhandledException,
        owl:NamedIndividual ;
    rdfs:label "a raise with no except"@en ;
    rd:hasIOExample chx:IO_UnhandledException ;
    dcterms:source <http://example.org/sen0414/ch05/research> ;
    skos:definition "An exception that no except clause matches ends the program: Python prints a traceback on the error stream and the process finishes with a nonzero exit status."@en .

<http://example.org/sen0414/ch05/abox> a owl:Ontology ;
    rdfs:label "SEN0414 chapter 5 domain ontology - ABox"@en ;
