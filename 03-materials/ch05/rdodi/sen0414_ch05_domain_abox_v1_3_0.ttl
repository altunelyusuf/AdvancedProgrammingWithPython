chx:Err_ExceptionClass a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "int('abc') raises ValueError: invalid literal for int() with base 10: 'abc'"@en .

chx:Err_MembershipTest a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "1 in 'abc' raises TypeError: 'in <string>' requires string as left operand, not int"@en .

