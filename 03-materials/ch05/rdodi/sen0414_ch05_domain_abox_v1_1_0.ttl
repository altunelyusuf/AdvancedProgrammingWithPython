@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0414/ch05/abox> a owl:Ontology ;
    rdfs:label "SEN0414 chapter 5 domain ontology - ABox"@en ; owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0414/ch05/abox/1.1.0> ; rdfs:comment "1.1.0 adds concepts for the terms and tools the chapter text used without explaining them, and rewrites every concept as four to six paragraphs of connected prose with executed examples; no concept is removed or renamed, so MINOR."@en ;
