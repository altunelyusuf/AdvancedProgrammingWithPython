    dcterms:created "2026-09-29"^^xsd:date ; dcterms:modified "2026-10-01"^^xsd:date ;
    dcterms:identifier "sen0414_ch05_domain_abox_v1_1_0" ; prov:wasRevisionOf <http://example.org/sen0414/ch05/abox/1.0.0> ;
    prov:wasGeneratedBy <http://example.org/sen0414/activity/ch05-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

ch05:X_Bug a owl:NamedIndividual, ch05:Bug ; rdfs:label "the product 1 * 0 * 1 * 2 * 3 * 4 * 5"@en ; skos:definition "A place where a program does something other than what its author intended; the chapter's factorial multiplies by 0 and so returns 0 instead of 120."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_Bug a owl:NamedIndividual, rd:IOExample ; rdfs:label "1 * 0 * 1 * 2 * 3 * 4 * 5 evaluates to 0"@en ; ch05:input "1 * 0 * 1 * 2 * 3 * 4 * 5" ; ch05:output "0" .
ch05:X_Bug rd:hasIOExample ch05:IO_Bug .
ch05:X_LogicError a owl:NamedIndividual, ch05:LogicError ; rdfs:label "buggy adding program"@en ; skos:definition "A mistake that lets the program run to the end without any exception but produces a wrong result, so only the person who knows the right answer can notice it."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_LogicError a owl:NamedIndividual, rd:IOExample ; rdfs:label "'The sum is ' + '5' + '3' + '42' evaluates to 'The sum is 5342'"@en ; ch05:input "'The sum is ' + '5' + '3' + '42'" ; ch05:output "'The sum is 5342'" .
ch05:X_LogicError rd:hasIOExample ch05:IO_LogicError .
ch05:X_Debugging a owl:NamedIndividual, ch05:Debugging ; rdfs:label "printing i and total in the loop"@en ; skos:definition "The method of finding the root cause of a bug by making the program show its state, forming a guess about the cause and testing it."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_InstrumentChoice a owl:NamedIndividual, ch05:InstrumentChoice ; rdfs:label "raise, assert, log or step through?"@en ; skos:definition "Raise when the caller can react to the error, assert when the programmer's belief must hold, log when the run must leave a record, and use the debugger when the state at one point is the question."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_ObjectVocabulary a owl:NamedIndividual, ch05:ObjectVocabulary ; rdfs:label "'abc'.upper()"@en ; skos:definition "An object is data with state and behaviour; an attribute is a value reached from it by a dotted name, and a method is a function reached the same way and called with parentheses."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_ObjectVocabulary a owl:NamedIndividual, rd:IOExample ; rdfs:label "'abc'.upper() evaluates to 'ABC'"@en ; ch05:input "'abc'.upper()" ; ch05:output "'ABC'" .
ch05:X_ObjectVocabulary rd:hasIOExample ch05:IO_ObjectVocabulary .
ch05:X_CommandLine a owl:NamedIndividual, ch05:CommandLine ; rdfs:label "python myscript.py"@en ; skos:definition "The command line is the line of text typed in a terminal to start a program: the interpreter, then options, then what to run, then arguments for the program."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_FileAndDirectory a owl:NamedIndividual, ch05:FileAndDirectory ; rdfs:label "open('workfile', 'w', encoding='utf-8')"@en ; skos:definition "A file is a named piece of stored data that a program can read and write; a directory holds files, and a path says where a file is."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_RaiseStatement a owl:NamedIndividual, ch05:RaiseStatement ; rdfs:label "raise Exception('message')"@en ; skos:definition "A raise statement stops the running code and passes an exception to the nearest matching except clause, which is how a function tells its caller that a call was invalid."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_ExceptionClass a owl:NamedIndividual, ch05:ExceptionClass ; rdfs:label "ValueError"@en ; skos:definition "The kind of an exception: ValueError, TypeError and the others are classes derived from Exception, and an except clause catches the classes it names."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_ExceptionClass a owl:NamedIndividual, rd:IOExample ; rdfs:label "issubclass(ValueError, Exception) evaluates to True"@en ; ch05:input "issubclass(ValueError, Exception)" ; ch05:output "True" .
ch05:X_ExceptionClass rd:hasIOExample ch05:IO_ExceptionClass .
ch05:X_ExceptionMessage a owl:NamedIndividual, ch05:ExceptionMessage ; rdfs:label "except Exception as err:"@en ; skos:definition "The text passed to an exception is kept in its args and printed by str, so an except clause can show a message written for the user instead of a traceback."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_ExceptionMessage a owl:NamedIndividual, rd:IOExample ; rdfs:label "Exception('custom message').args evaluates to ('custom message',)"@en ; ch05:input "Exception('custom message').args" ; ch05:output "('custom message',)" .
ch05:X_ExceptionMessage rd:hasIOExample ch05:IO_ExceptionMessage .
ch05:X_ArgumentValidation a owl:NamedIndividual, ch05:ArgumentValidation ; rdfs:label "if width <= 0: raise ValueError(...)"@en ; skos:definition "Checking the arguments a function receives before using them and raising an exception that names the problem when they are unusable."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_UnhandledException a owl:NamedIndividual, ch05:UnhandledException ; rdfs:label "a raise with no except"@en ; skos:definition "An exception that no except clause matches ends the program: Python prints a traceback on the error stream and the process finishes with a nonzero exit status."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_UnhandledException a owl:NamedIndividual, rd:IOExample ; rdfs:label "callable(__import__('sys').excepthook) evaluates to True"@en ; ch05:input "callable(__import__('sys').excepthook)" ; ch05:output "True" .
ch05:X_UnhandledException rd:hasIOExample ch05:IO_UnhandledException .
ch05:X_ExceptionUnwinding a owl:NamedIndividual, ch05:ExceptionUnwinding ; rdfs:label "process calls load calls read_age"@en ; skos:definition "An exception that no function handles leaves each function in turn, up the call stack, until an except clause matches it or the program ends with a traceback."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_TracebackReading a owl:NamedIndividual, ch05:TracebackReading ; rdfs:label "File, line, in, source line"@en ; skos:definition "A traceback lists the calls from the outermost to the one that raised, each with file, line, function and source line, and ends with the exception class and message."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_FineGrainedLocations a owl:NamedIndividual, ch05:FineGrainedLocations ; rdfs:label "~~~~^^^^^"@en ; skos:definition "Since Python 3.11 a traceback marks the failing part of a line, so which subscript or call failed in a chained expression can be read from it."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_ExceptionNotes a owl:NamedIndividual, ch05:ExceptionNotes ; rdfs:label "e.add_note('while reading the age field')"@en ; skos:definition "An exception can carry notes added with add_note, kept in __notes__ and printed after the traceback, so code that re-raises can add context."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_ExceptionNotes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda e: (e.add_note('n'), e.__notes__)[1])(ValueError('x')) evaluates to ['n']"@en ; ch05:input "(lambda e: (e.add_note('n'), e.__notes__)[1])(ValueError('x'))" ; ch05:output "['n']" .
ch05:X_ExceptionNotes rd:hasIOExample ch05:IO_ExceptionNotes .
ch05:X_StandardErrorStream a owl:NamedIndividual, ch05:StandardErrorStream ; rdfs:label "print('...', file=sys.stderr)"@en ; skos:definition "The second output channel of a program, used by the interpreter for tracebacks and error messages, separate from the standard output that print uses."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_SanityCheck a owl:NamedIndividual, ch05:SanityCheck ; rdfs:label "ages[0] <= ages[-1] after sorting"@en ; skos:definition "A cheap test of a result that must hold if the code before it is correct, written to catch an obvious mistake early."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_SanityCheck a owl:NamedIndividual, rd:IOExample ; rdfs:label "sorted([3, 1, 2]) == [1, 2, 3] evaluates to True"@en ; ch05:input "sorted([3, 1, 2]) == [1, 2, 3]" ; ch05:output "True" .
ch05:X_SanityCheck rd:hasIOExample ch05:IO_SanityCheck .
ch05:X_AssertStatement a owl:NamedIndividual, ch05:AssertStatement ; rdfs:label "assert ages[0] <= ages[-1]"@en ; skos:definition "An assert statement checks a condition the programmer believes is true and raises AssertionError when it is false."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_SortedOrderCheck a owl:NamedIndividual, ch05:SortedOrderCheck ; rdfs:label "assert ages[0] <= ages[-1]"@en ; skos:definition "The chapter's example of a sanity check on a list: after sort() the first item is not larger than the last, and after reverse() it is."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_SortedOrderCheck a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a: (a.sort(), a[0] <= a[-1])[1])([26, 57, 92, 54, 22]) evaluates to True"@en ; ch05:input "(lambda a: (a.sort(), a[0] <= a[-1])[1])([26, 57, 92, 54, 22])" ; ch05:output "True" .
ch05:X_SortedOrderCheck rd:hasIOExample ch05:IO_SortedOrderCheck .
ch05:X_AssertionFailure a owl:NamedIndividual, ch05:AssertionFailure ; rdfs:label "AssertionError"@en ; skos:definition "A failed assertion is an ordinary exception of class AssertionError; the chapter advises against catching it, since it reports a programmer error."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_AssertionFailure a owl:NamedIndividual, rd:IOExample ; rdfs:label "issubclass(AssertionError, Exception) evaluates to True"@en ; ch05:input "issubclass(AssertionError, Exception)" ; ch05:output "True" .
ch05:X_AssertionFailure rd:hasIOExample ch05:IO_AssertionFailure .
ch05:X_AssertMessage a owl:NamedIndividual, ch05:AssertMessage ; rdfs:label "assert x > 0, f'x must be positive, got {x}'"@en ; skos:definition "An assert statement can carry a second expression, evaluated only on failure, whose text becomes the message of the AssertionError."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_FailFast a owl:NamedIndividual, ch05:FailFast ; rdfs:label "assert at the point of the assumption"@en ; skos:definition "Stopping a program as soon as a necessary condition is violated, so that the failure appears near its cause."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_AssertVersusRaise a owl:NamedIndividual, ch05:AssertVersusRaise ; rdfs:label "user error or programmer error"@en ; skos:definition "An error the user can cause is checked with an if and a raise; an assert states what must be true if the program is correct."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_OptimisedMode a owl:NamedIndividual, ch05:OptimisedMode ; rdfs:label "python -O"@en ; skos:definition "Under the -O option, and in code compiled with optimisation, assert statements produce no code at all, so a check that must always run is not written as an assertion."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_OptimisedMode a owl:NamedIndividual, rd:IOExample ; rdfs:label "__debug__ evaluates to True"@en ; ch05:input "__debug__" ; ch05:output "True" .
ch05:X_OptimisedMode rd:hasIOExample ch05:IO_OptimisedMode .
ch05:X_CommandLineOption a owl:NamedIndividual, ch05:CommandLineOption ; rdfs:label "python -O script.py"@en ; skos:definition "A flag written after the python command, such as -O, -c, -m or -V, that changes how the interpreter runs."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_CommandLineOption a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sys').flags.optimize evaluates to 0"@en ; ch05:input "__import__('sys').flags.optimize" ; ch05:output "0" .
ch05:X_CommandLineOption rd:hasIOExample ch05:IO_CommandLineOption .
ch05:X_BasicConfig a owl:NamedIndividual, ch05:BasicConfig ; rdfs:label "logging.basicConfig(level=logging.DEBUG)"@en ; skos:definition "basicConfig sets the threshold, the format and the destination of the root logger; the chapter calls it once at the top of a program."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_LogFormat a owl:NamedIndividual, ch05:LogFormat ; rdfs:label "%(asctime)s - %(levelname)s - %(message)s"@en ; skos:definition "A format string with named fields decides what each log line shows; the chapter's shows time, level and message."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_LogFormat a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('logging').Formatter('%(levelname)s - %(message)s').format(__import__('logging').LogRecord('app', 10, 'p.py', 1, 'hello', None, None)) evaluates to 'DEBUG - hello'"@en ; ch05:input "__import__('logging').Formatter('%(levelname)s - %(message)s').format(__import__('logging').LogRecord('app', 10, 'p.py', 1, 'hello', None, None))" ; ch05:output "'DEBUG - hello'" .
ch05:X_LogFormat rd:hasIOExample ch05:IO_LogFormat .
ch05:X_PercentPlaceholder a owl:NamedIndividual, ch05:PercentPlaceholder ; rdfs:label "'%s has %d quote types.' % ('Python', 2)"@en ; skos:definition "The old-style way of putting values into a string: % conversion specifications in the string are replaced by the values to the right of the % operator."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_PercentPlaceholder a owl:NamedIndividual, rd:IOExample ; rdfs:label "'%s has %d quote types.' % ('Python', 2) evaluates to 'Python has 2 quote types.'"@en ; ch05:input "'%s has %d quote types.' % ('Python', 2)" ; ch05:output "'Python has 2 quote types.'" .
ch05:X_PercentPlaceholder rd:hasIOExample ch05:IO_PercentPlaceholder .
ch05:X_LogToFile a owl:NamedIndividual, ch05:LogToFile ; rdfs:label "basicConfig(filename='myProgramLog.txt')"@en ; skos:definition "Passing filename to basicConfig sends the messages to a text file instead of the screen."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_ForceReconfigure a owl:NamedIndividual, ch05:ForceReconfigure ; rdfs:label "basicConfig(force=True)"@en ; skos:definition "basicConfig does nothing if the root logger already has handlers, so a second call is ignored unless force=True is passed."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_Logger a owl:NamedIndividual, ch05:Logger ; rdfs:label "logging.getLogger('app')"@en ; skos:definition "The object that receives log calls; the module-level functions use the root logger, and named loggers form a hierarchy by dotted names."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_Logger a owl:NamedIndividual, rd:IOExample ; rdfs:label "type(__import__('logging').getLogger()).__name__ evaluates to 'RootLogger'"@en ; ch05:input "type(__import__('logging').getLogger()).__name__" ; ch05:output "'RootLogger'" .
ch05:X_Logger rd:hasIOExample ch05:IO_Logger .
ch05:X_Handler a owl:NamedIndividual, ch05:Handler ; rdfs:label "logging.StreamHandler / logging.FileHandler"@en ; skos:definition "The object that sends a log record to a destination; basicConfig creates a StreamHandler for the screen or, with filename, a FileHandler for a file."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_LogRecord a owl:NamedIndividual, ch05:LogRecord ; rdfs:label "logging.LogRecord(...)"@en ; skos:definition "The object created for every logging event; it carries the logger name, the level, the message and its arguments, and the place of the call."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_LogRecord a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('logging').LogRecord('app', 20, 'p.py', 3, 'hello %s', ('world',), None).getMessage() evaluates to 'hello world'"@en ; ch05:input "__import__('logging').LogRecord('app', 20, 'p.py', 3, 'hello %s', ('world',), None).getMessage()" ; ch05:output "'hello world'" .
ch05:X_LogRecord rd:hasIOExample ch05:IO_LogRecord .
ch05:X_LoggingLevels a owl:NamedIndividual, ch05:LoggingLevels ; rdfs:label "DEBUG, INFO, WARNING, ERROR, CRITICAL"@en ; skos:definition "The five levels run from lowest to highest importance, and each has a number: 10, 20, 30, 40 and 50."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_LoggingLevels a owl:NamedIndividual, rd:IOExample ; rdfs:label "[getattr(__import__('logging'), n) for n in ('DEBUG','INFO','WARNING','ERROR','CRITICAL')] evaluates to [10, 20, 30, 40, 50]"@en ; ch05:input "[getattr(__import__('logging'), n) for n in ('DEBUG','INFO','WARNING','ERROR','CRITICAL')]" ; ch05:output "[10, 20, 30, 40, 50]" .
ch05:X_LoggingLevels rd:hasIOExample ch05:IO_LoggingLevels .
ch05:X_LevelThreshold a owl:NamedIndividual, ch05:LevelThreshold ; rdfs:label "level=logging.INFO"@en ; skos:definition "A message is shown only if its level is at least the threshold, so raising the threshold hides the lower levels without deleting any call."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_DefaultLevel a owl:NamedIndividual, ch05:DefaultLevel ; rdfs:label "the default threshold is WARNING"@en ; skos:definition "Without basicConfig the threshold is WARNING, so debug and info calls print nothing and warning and error calls print to standard error."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_DefaultLevel a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('logging').getLogger().getEffectiveLevel() evaluates to 30"@en ; ch05:input "__import__('logging').getLogger().getEffectiveLevel()" ; ch05:output "30" .
ch05:X_DefaultLevel rd:hasIOExample ch05:IO_DefaultLevel .
ch05:X_DisablingLogging a owl:NamedIndividual, ch05:DisablingLogging ; rdfs:label "logging.disable(logging.CRITICAL)"@en ; skos:definition "logging.disable silences the given level and all below it; disabling CRITICAL turns every message off, and NOTSET turns them back on."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_LoggingVersusPrint a owl:NamedIndividual, ch05:LoggingVersusPrint ; rdfs:label "print or logging.debug"@en ; skos:definition "Log messages are for the programmer and print is for the user; log calls stay in the program and one setting switches them all off, where print calls would each have to be deleted."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_LazyFormatting a owl:NamedIndividual, ch05:LazyFormatting ; rdfs:label "log.debug('value is %s', obj)"@en ; skos:definition "A message given arguments is formatted only when it is emitted, so a disabled debug call costs no string conversion, unlike an f-string built before the call."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_MuEditor a owl:NamedIndividual, ch05:MuEditor ; rdfs:label "the Mu window with a Debug button next to Run"@en ; skos:definition "The code editor used in the chapter; it has a Run button, a Debug button and a Debug Inspector pane, and its output pane is where a running program receives typed input."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_RunUnderDebugger a owl:NamedIndividual, ch05:RunUnderDebugger ; rdfs:label "clicking Debug instead of Run"@en ; skos:definition "Running a program under the debugger starts it paused just before its first line, so that the programmer decides how it goes on from there."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_ProgramState a owl:NamedIndividual, ch05:ProgramState ; rdfs:label "heads is 500 at the halfway point"@en ; skos:definition "The state of a program at a moment is the values of its variables together with the line that is about to run; the debugger shows both."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_InspectorPane a owl:NamedIndividual, ch05:InspectorPane ; rdfs:label "first, second and third shown as strings"@en ; skos:definition "The pane at the right of the Mu window that lists the current value of each variable of the paused program."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_StopControl a owl:NamedIndividual, ch05:StopControl ; rdfs:label "the usual Stop button"@en ; skos:definition "The Stop button ends the debugging session at once and terminates the program without running its remaining lines."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_Breakpoint a owl:NamedIndividual, ch05:Breakpoint ; rdfs:label "a red dot at a line number"@en ; skos:definition "A breakpoint marks a line at which the debugger pauses the running program so its variables can be read."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_ContinueControl a owl:NamedIndividual, ch05:ContinueControl ; rdfs:label "Continue"@en ; skos:definition "Continue runs the program until the next breakpoint or the end."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_StepIn a owl:NamedIndividual, ch05:StepIn ; rdfs:label "Step In"@en ; skos:definition "Step In executes the next line and, if that line is a call, pauses on the first line of the called function."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_StepOver a owl:NamedIndividual, ch05:StepOver ; rdfs:label "Step Over"@en ; skos:definition "Step Over executes the next line as a whole, running a called function without pausing inside it."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_StepOut a owl:NamedIndividual, ch05:StepOut ; rdfs:label "Step Out"@en ; skos:definition "Step Out runs the rest of the current function at full speed until it returns."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_Process a owl:NamedIndividual, ch05:Process ; rdfs:label "os.getpid()"@en ; skos:definition "A process is a running program as the operating system sees it; each process has its own identifier, which os.getpid() returns."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_Process a owl:NamedIndividual, rd:IOExample ; rdfs:label "isinstance(__import__('os').getpid(), int) evaluates to True"@en ; ch05:input "isinstance(__import__('os').getpid(), int)" ; ch05:output "True" .
ch05:X_Process rd:hasIOExample ch05:IO_Process .
ch05:X_EnvironmentVariable a owl:NamedIndividual, ch05:EnvironmentVariable ; rdfs:label "PYTHONBREAKPOINT=0"@en ; skos:definition "A named text setting that the operating system hands to a process when it starts; Python reads it through os.environ."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_EnvironmentVariable a owl:NamedIndividual, rd:IOExample ; rdfs:label "type(__import__('os').environ).__name__ evaluates to '_Environ'"@en ; ch05:input "type(__import__('os').environ).__name__" ; ch05:output "'_Environ'" .
ch05:X_EnvironmentVariable rd:hasIOExample ch05:IO_EnvironmentVariable .
ch05:X_BreakpointFunction a owl:NamedIndividual, ch05:BreakpointFunction ; rdfs:label "breakpoint()"@en ; skos:definition "The built-in breakpoint() pauses the program in the debugger at that line; it calls sys.breakpointhook, and PYTHONBREAKPOINT=0 makes it do nothing."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_BreakpointFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sys').breakpointhook.__name__ evaluates to 'breakpointhook'"@en ; ch05:input "__import__('sys').breakpointhook.__name__" ; ch05:output "'breakpointhook'" .
ch05:X_BreakpointFunction rd:hasIOExample ch05:IO_BreakpointFunction .
ch05:X_BreakpointHook a owl:NamedIndividual, ch05:BreakpointHook ; rdfs:label "PYTHONBREAKPOINT=builtins.print"@en ; skos:definition "The function sys.breakpointhook is what breakpoint() calls; by default it starts pdb, but the environment variable PYTHONBREAKPOINT or a replacement function can change it."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:X_PdbCommands a owl:NamedIndividual, ch05:PdbCommands ; rdfs:label "step, next, return, continue, break, where"@en ; skos:definition "The standard debugger pdb offers the chapter's controls as commands: step, next, return, continue and break, and where lists the call stack."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_PdbCommands a owl:NamedIndividual, rd:IOExample ; rdfs:label "[c for c in ('do_step','do_next','do_return','do_continue','do_break','do_where') if hasattr(__import__('pdb').Pdb, c)] evaluates to ['do_step', 'do_next', 'do_return', 'do_continue', 'do_break', 'do_where']"@en ; ch05:input "[c for c in ('do_step','do_next','do_return','do_continue','do_break','do_where') if hasattr(__import__('pdb').Pdb, c)]" ; ch05:output "['do_step', 'do_next', 'do_return', 'do_continue', 'do_break', 'do_where']" .
ch05:X_PdbCommands rd:hasIOExample ch05:IO_PdbCommands .
ch05:X_RemoteAttach a owl:NamedIndividual, ch05:RemoteAttach ; rdfs:label "python -m pdb -p PID"@en ; skos:definition "Since Python 3.14 the debugger can attach to a running process by its identifier, using sys.remote_exec."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_RemoteAttach a owl:NamedIndividual, rd:IOExample ; rdfs:label "callable(__import__('sys').breakpointhook) evaluates to True"@en ; ch05:input "callable(__import__('sys').breakpointhook)" ; ch05:output "True" .
ch05:X_RemoteAttach rd:hasIOExample ch05:IO_RemoteAttach .
ch05:X_OffByOneRange a owl:NamedIndividual, ch05:OffByOneRange ; rdfs:label "range(n + 1) in factorial"@en ; skos:definition "The chapter's factorial multiplies by zero because its range starts at 0; the log shows i as 0 and total as 0 on the first pass, and range(1, n + 1) fixes it."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_OffByOneRange a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(5 + 1)) evaluates to [0, 1, 2, 3, 4, 5]"@en ; ch05:input "list(range(5 + 1))" ; ch05:output "[0, 1, 2, 3, 4, 5]" .
ch05:X_OffByOneRange rd:hasIOExample ch05:IO_OffByOneRange .
ch05:X_AccumulatorStart a owl:NamedIndividual, ch05:AccumulatorStart ; rdfs:label "total = 1 before the loop"@en ; skos:definition "The value that an accumulator holds before its loop must suit the operation: 1 for a product, 0 for a sum; a wrong start gives a wrong result without any error."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_AccumulatorStart a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum(range(1, 5 + 1)) evaluates to 15"@en ; ch05:input "sum(range(1, 5 + 1))" ; ch05:output "15" .
ch05:X_AccumulatorStart rd:hasIOExample ch05:IO_AccumulatorStart .
ch05:X_StringConcatenation a owl:NamedIndividual, ch05:StringConcatenation ; rdfs:label "'5' + '3' + '42'"@en ; skos:definition "input and a list of typed answers give strings, and adding strings joins them, so the sum prints as 5342 until each answer is converted with int."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_StringConcatenation a owl:NamedIndividual, rd:IOExample ; rdfs:label "'5' + '3' + '42' evaluates to '5342'"@en ; ch05:input "'5' + '3' + '42'" ; ch05:output "'5342'" .
ch05:X_StringConcatenation rd:hasIOExample ch05:IO_StringConcatenation .
ch05:X_RandomInteger a owl:NamedIndividual, ch05:RandomInteger ; rdfs:label "random.randint(0, 1)"@en ; skos:definition "random.randint(a, b) returns a random whole number N with a <= N <= b, both ends included."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_RandomInteger a owl:NamedIndividual, rd:IOExample ; rdfs:label "isinstance(__import__('random').randint(1, 6), int) evaluates to True"@en ; ch05:input "isinstance(__import__('random').randint(1, 6), int)" ; ch05:output "True" .
ch05:X_RandomInteger rd:hasIOExample ch05:IO_RandomInteger .
ch05:X_MembershipTest a owl:NamedIndividual, ch05:MembershipTest ; rdfs:label "guess not in ('heads', 'tails')"@en ; skos:definition "The in and not in operators test whether a value is a member of a collection; for a string they test whether one string is a substring of another."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_MembershipTest a owl:NamedIndividual, rd:IOExample ; rdfs:label "'heads' in ('heads', 'tails') evaluates to True"@en ; ch05:input "'heads' in ('heads', 'tails')" ; ch05:output "True" .
ch05:X_MembershipTest rd:hasIOExample ch05:IO_MembershipTest .
ch05:X_TypeMismatchComparison a owl:NamedIndividual, ch05:TypeMismatchComparison ; rdfs:label "toss == 'heads'"@en ; skos:definition "A number never equals a string, so comparing the integer from randint with 'heads' is always false and the game reports every guess as wrong."@en ; dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:IO_TypeMismatchComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "0 == 'heads' evaluates to False"@en ; ch05:input "0 == 'heads'" ; ch05:output "False" .
ch05:X_TypeMismatchComparison rd:hasIOExample ch05:IO_TypeMismatchComparison .
ch05:X_ExceptionMessage ch05:hasOwner ch05:X_RaiseStatement .
ch05:X_ExceptionClass ch05:hasOwner ch05:X_RaiseStatement .
ch05:X_AssertMessage ch05:hasOwner ch05:X_AssertStatement .
ch05:X_AssertionFailure ch05:hasOwner ch05:X_AssertStatement .
ch05:X_LogFormat ch05:hasOwner ch05:X_BasicConfig .
ch05:X_LogToFile ch05:hasOwner ch05:X_BasicConfig .
ch05:X_ForceReconfigure ch05:hasOwner ch05:X_BasicConfig .
ch05:X_LevelThreshold ch05:hasOwner ch05:X_LoggingLevels .
ch05:X_DefaultLevel ch05:hasOwner ch05:X_LoggingLevels .
ch05:X_DisablingLogging ch05:hasOwner ch05:X_LoggingLevels .
ch05:X_StepIn ch05:hasOwner ch05:X_Breakpoint .
ch05:X_StepOver ch05:hasOwner ch05:X_Breakpoint .
ch05:X_StepOut ch05:hasOwner ch05:X_Breakpoint .
ch05:Err_ExceptionClass a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "int('abc') raises ValueError: invalid literal for int() with base 10: 'abc'"@en .
ch05:X_ExceptionClass rd:hasErrorCondition ch05:Err_ExceptionClass .
ch05:Err_TypeMismatchComparison a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "0 < 'heads' raises TypeError: '<' not supported between instances of 'int' and 'str'"@en .
ch05:X_TypeMismatchComparison rd:hasErrorCondition ch05:Err_TypeMismatchComparison .
ch05:Err_MembershipTest a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "1 in 'abc' raises TypeError: 'in <string>' requires string as left operand, not int"@en .
ch05:X_MembershipTest rd:hasErrorCondition ch05:Err_MembershipTest .
ch05:Err_RandomInteger a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "__import__('random').randint(2, 1) raises ValueError: empty range in randint(2, 1)"@en .
ch05:X_RandomInteger rd:hasErrorCondition ch05:Err_RandomInteger .

ch05:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 5 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch05/research> ;
    rd:hasCompetencyQuestion ch05:CQs ; rd:hasSourceProvenance ch05:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment ch05:Env .
ch05:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 5 competency questions"@en ;
    rd:containsCompetencyQuestion ch05:CQ1, ch05:CQ2, ch05:CQ3 .
ch05:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which constructs signal, check, record and inspect a program's behaviour, and what decides which of them a given problem calls for?"@en .
ch05:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs and concepts of the chapter differ in current Python, and on what source?"@en .
ch05:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which terms does the chapter use that a learner would have to look up, and which concept of the corpus explains each one?"@en .
ch05:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 5 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 5 through the Stage 1 research artefact; the modern-practice branch and the concepts added in 1.1.0 for terms the chapter uses without explaining (bug, exception class, standard error stream, logger, handler, process, random integer and others) come from that artefact's secondary sources, not from the book."@en ;
    dcterms:source <http://example.org/sen0414/ch05/research> .
ch05:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.12.11 and CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (208 checks listed in sen0414_ch05_corpus_v1_0_0.py), executed under CPython 3.12.11 and CPython 3.14.4: identical output where more than one was used."@en ;
    dcterms:source "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch05_corpus_v1_0_0.py" .

