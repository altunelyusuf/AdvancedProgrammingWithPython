chx:Document a doc:ReportSection ; rdfs:label "Debugging for an advanced course: chapter 5 of the 3rd edition and today's Python"@en ; skos:definition "This document renews chapter 5 of the 3rd edition for an advanced course (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05/research> ;
    doc:hasSection chx:S_ErrorSignalling, chx:S_Assertion, chx:S_Logging, chx:S_Debugger, chx:S_ModernPractice .
chx:S_ErrorSignalling a doc:TaxonomicSection ; rdfs:label "Error signalling"@en ; doc:sectionTitle "Error signalling" ; doc:hierarchyLevel 1 ; doc:sectionOrder 1 ;
    skos:definition "Raising Exceptions and the traceback that an unhandled exception prints are how a program says that something went wrong (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#ErrorSignalling> .
chx:S_Raising a doc:TaxonomicSection ; rdfs:label "Raising"@en ; doc:sectionTitle "Raising" ; doc:hierarchyLevel 2 ; doc:sectionOrder 2 ;
    doc:hasParentSection chx:S_ErrorSignalling ;
    skos:definition "Raising Exceptions shows how a function refuses a call it cannot serve and how the caller recovers (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Raising> .
chx:S_RaiseStatement a doc:ConceptSection ; rdfs:label "Raise statement"@en ; doc:sectionTitle "Raise statement" ; doc:hierarchyLevel 3 ; doc:sectionOrder 3 ;
    doc:hasParentSection chx:S_Raising ;
    skos:definition "The chapter's box_print() function raises Exception with a message when the symbol is not a single character or the width or height is not greater than 2, and the messages are the ones the chapter shows: 'Width must be greater than 2.' and 'Symbol must be a single character string.' (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#RaiseStatement> .
chx:S_ExceptionMessage a doc:ConceptSection ; rdfs:label "Exception message"@en ; doc:sectionTitle "Exception message" ; doc:hierarchyLevel 3 ; doc:sectionOrder 4 ;
    doc:hasParentSection chx:S_Raising ;
    skos:definition "The except clause of the chapter stores the exception with as err and prints str(err) after 'An exception happened: ', and the message given to the exception is kept in its args (Sweigart, 2025) (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#ExceptionMessage> .
chx:S_Tracebacks a doc:TaxonomicSection ; rdfs:label "Tracebacks"@en ; doc:sectionTitle "Tracebacks" ; doc:hierarchyLevel 2 ; doc:sectionOrder 5 ;
    doc:hasParentSection chx:S_ErrorSignalling ;
    skos:definition "Tracebacks are the record of where an exception passed on its way out (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#Tracebacks> .
chx:S_ExceptionUnwinding a doc:ConceptSection ; rdfs:label "Exception unwinding"@en ; doc:sectionTitle "Exception unwinding" ; doc:hierarchyLevel 3 ; doc:sectionOrder 6 ;
    doc:hasParentSection chx:S_Tracebacks ;
    skos:definition "An exception that is not handled in read_age leaves it, then load, then process, and is caught by the try around the call to process, where the message is invalid literal for int() with base 10: 'abc'; with no handler the same climb ends the program with a traceback (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#ExceptionUnwinding> .
chx:S_TracebackReading a doc:ConceptSection ; rdfs:label "Traceback reading"@en ; doc:sectionTitle "Traceback reading" ; doc:hierarchyLevel 3 ; doc:sectionOrder 7 ;
    doc:hasParentSection chx:S_Tracebacks ;
    skos:definition "A traceback lists the calls from the outermost to the one that raised, each with its file, line, function and source line, then the exception class and message (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#TracebackReading> .
chx:S_FineGrainedLocations a doc:ConceptSection ; rdfs:label "Fine grained locations"@en ; doc:sectionTitle "Fine grained locations" ; doc:hierarchyLevel 3 ; doc:sectionOrder 8 ;
    doc:hasParentSection chx:S_Tracebacks ;
    skos:definition "Since Python 3.11 a traceback underlines the failing part of the source line with tildes and carets, so for print(data['a']['b']['c']) the marks lie under the last subscript, which raises TypeError: 'NoneType' object is not subscriptable (Galindo Salgado et al., 2021)." ; dcterms:source <http://example.org/sen0414/ch05#FineGrainedLocations> .
chx:S_ExceptionNotes a doc:ConceptSection ; rdfs:label "Exception notes"@en ; doc:sectionTitle "Exception notes" ; doc:hierarchyLevel 3 ; doc:sectionOrder 9 ;
    doc:hasParentSection chx:S_Tracebacks ;
    skos:definition "An exception can be given notes with add_note, which are stored in __notes__, so an except clause that re-raises can add where in the work the error occurred, as ['while reading the age field'] (Hatfield-Dodds, 2021) (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#ExceptionNotes> .
chx:S_Assertion a doc:TaxonomicSection ; rdfs:label "Assertion"@en ; doc:sectionTitle "Assertion" ; doc:hierarchyLevel 1 ; doc:sectionOrder 10 ;
    skos:definition "Assertions are the sanity checks of Chapter 5, meant for errors of the programmer and not of the user (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Assertion> .
chx:S_Assert a doc:TaxonomicSection ; rdfs:label "Assert"@en ; doc:sectionTitle "Assert" ; doc:hierarchyLevel 2 ; doc:sectionOrder 11 ;
    doc:hasParentSection chx:S_Assertion ;
    skos:definition "An assertion states what must be true at a point in a program (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Assert> .
chx:S_AssertStatement a doc:ConceptSection ; rdfs:label "Assert statement"@en ; doc:sectionTitle "Assert statement" ; doc:hierarchyLevel 3 ; doc:sectionOrder 12 ;
    doc:hasParentSection chx:S_Assert ;
    skos:definition "An assert statement consists of the keyword, a condition, and optionally a message; if the condition is false it raises AssertionError, as assert ages[0] <= ages[-1] does when the list was reversed instead of sorted (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#AssertStatement> .
chx:S_AssertionFailure a doc:ConceptSection ; rdfs:label "Assertion failure"@en ; doc:sectionTitle "Assertion failure" ; doc:hierarchyLevel 3 ; doc:sectionOrder 13 ;
    doc:hasParentSection chx:S_Assert ;
    skos:definition "A failed assert raises AssertionError, a subclass of Exception, whose message is empty when none was given; the chapter's advice is not to catch it with try and except, since the program should stop and be fixed (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#AssertionFailure> .
chx:S_AssertMessage a doc:ConceptSection ; rdfs:label "Assert message"@en ; doc:sectionTitle "Assert message" ; doc:hierarchyLevel 3 ; doc:sectionOrder 14 ;
    doc:hasParentSection chx:S_Assert ;
    skos:definition "The second expression of an assert statement is evaluated only when the condition is false and becomes the message of the AssertionError, as 'x must be positive, got -1' (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#AssertMessage> .
chx:S_AssertVersusRaise a doc:ConceptSection ; rdfs:label "Assert versus raise"@en ; doc:sectionTitle "Assert versus raise" ; doc:hierarchyLevel 3 ; doc:sectionOrder 15 ;
    doc:hasParentSection chx:S_Assert ;
    skos:definition "The chapter separates errors of the user, which are handled with exceptions, from errors of the programmer, which are checked with assertions; the reference defines assert as equivalent to raising AssertionError only when __debug__ is true (Sweigart, 2025) (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#AssertVersusRaise> .
chx:S_OptimisedMode a doc:ConceptSection ; rdfs:label "Optimised mode"@en ; doc:sectionTitle "Optimised mode" ; doc:hierarchyLevel 3 ; doc:sectionOrder 16 ;
    doc:hasParentSection chx:S_Assert ;
    skos:definition "Code compiled with optimisation, as under the -O option, contains no assert statements, so exec of compile(src, 'x', 'exec', optimize=1) reaches the line after assert False and prints reached, while a normal run raises; the chapter does not cover this (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#OptimisedMode> .
chx:S_Logging a doc:TaxonomicSection ; rdfs:label "Logging"@en ; doc:sectionTitle "Logging" ; doc:hierarchyLevel 1 ; doc:sectionOrder 17 ;
    skos:definition "Logging leaves a record of what a program did, without stopping it (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Logging> .
chx:S_Setup a doc:TaxonomicSection ; rdfs:label "Setup"@en ; doc:sectionTitle "Setup" ; doc:hierarchyLevel 2 ; doc:sectionOrder 18 ;
    doc:hasParentSection chx:S_Logging ;
    skos:definition "Setting up logging means choosing a threshold, a format and a destination (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Setup> .
chx:S_BasicConfig a doc:ConceptSection ; rdfs:label "Basic config"@en ; doc:sectionTitle "Basic config" ; doc:hierarchyLevel 3 ; doc:sectionOrder 19 ;
    doc:hasParentSection chx:S_Setup ;
    skos:definition "logging.basicConfig(level=logging.DEBUG, format='%(asctime)s - %(levelname)s - %(message)s') is the chapter's setup call, placed after import logging at the top of the program (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#BasicConfig> .
chx:S_LogFormat a doc:ConceptSection ; rdfs:label "Log format"@en ; doc:sectionTitle "Log format" ; doc:hierarchyLevel 3 ; doc:sectionOrder 20 ;
    doc:hasParentSection chx:S_Setup ;
    skos:definition "The format string names the fields of each line, and the chapter's %(asctime)s - %(levelname)s - %(message)s prints the time, the level and the message separated by dashes (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#LogFormat> .
chx:S_LogToFile a doc:ConceptSection ; rdfs:label "Log to file"@en ; doc:sectionTitle "Log to file" ; doc:hierarchyLevel 3 ; doc:sectionOrder 21 ;
    doc:hasParentSection chx:S_Setup ;
    skos:definition "Passing filename='myProgramLog.txt' to basicConfig writes the messages to that file, so with the format '%(levelname)s - %(message)s' it holds the lines DEBUG - to the file and CRITICAL - also to the file (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#LogToFile> .
chx:S_ForceReconfigure a doc:ConceptSection ; rdfs:label "Force reconfigure"@en ; doc:sectionTitle "Force reconfigure" ; doc:hierarchyLevel 3 ; doc:sectionOrder 22 ;
    doc:hasParentSection chx:S_Setup ;
    skos:definition "basicConfig does nothing if the root logger already has handlers, so a second call with another level is ignored and force=True is needed to replace the first; the chapter does not mention this (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#ForceReconfigure> .
chx:S_Levels a doc:TaxonomicSection ; rdfs:label "Levels"@en ; doc:sectionTitle "Levels" ; doc:hierarchyLevel 2 ; doc:sectionOrder 23 ;
    doc:hasParentSection chx:S_Logging ;
    skos:definition "Logging levels let one program produce much or little output (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Levels> .
chx:S_LoggingLevels a doc:ConceptSection ; rdfs:label "Logging levels"@en ; doc:sectionTitle "Logging levels" ; doc:hierarchyLevel 3 ; doc:sectionOrder 24 ;
    doc:hasParentSection chx:S_Levels ;
    skos:definition "The five levels are DEBUG, INFO, WARNING, ERROR and CRITICAL, called with logging.debug(), logging.info(), logging.warning(), logging.error() and logging.critical(), and they have the numbers 10, 20, 30, 40 and 50 (Sweigart, 2025) (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#LoggingLevels> .
chx:S_LevelThreshold a doc:ConceptSection ; rdfs:label "Level threshold"@en ; doc:sectionTitle "Level threshold" ; doc:hierarchyLevel 3 ; doc:sectionOrder 25 ;
    doc:hasParentSection chx:S_Levels ;
    skos:definition "Setting the level in basicConfig to INFO hides the DEBUG messages and shows the others, so raising the threshold removes output without editing the program (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#LevelThreshold> .
chx:S_DefaultLevel a doc:ConceptSection ; rdfs:label "Default level"@en ; doc:sectionTitle "Default level" ; doc:hierarchyLevel 3 ; doc:sectionOrder 26 ;
    doc:hasParentSection chx:S_Levels ;
    skos:definition "Without basicConfig the root logger's threshold is WARNING, so logging.debug and logging.info print nothing and logging.warning and logging.error print WARNING:root:w and ERROR:root:e to standard error (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#DefaultLevel> .
chx:S_DisablingLogging a doc:ConceptSection ; rdfs:label "Disabling logging"@en ; doc:sectionTitle "Disabling logging" ; doc:hierarchyLevel 3 ; doc:sectionOrder 27 ;
    doc:hasParentSection chx:S_Levels ;
    skos:definition "logging.disable(logging.CRITICAL) at the top of the program silences every message, and logging.disable(logging.NOTSET) restores them (Sweigart, 2025) (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#DisablingLogging> .
chx:S_Practice a doc:TaxonomicSection ; rdfs:label "Practice"@en ; doc:sectionTitle "Practice" ; doc:hierarchyLevel 2 ; doc:sectionOrder 28 ;
    doc:hasParentSection chx:S_Logging ;
    skos:definition "Practice in logging is choosing between it and print, and writing the calls well (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Practice> .
chx:S_LoggingVersusPrint a doc:ConceptSection ; rdfs:label "Logging versus print"@en ; doc:sectionTitle "Logging versus print" ; doc:hierarchyLevel 3 ; doc:sectionOrder 29 ;
    doc:hasParentSection chx:S_Practice ;
    skos:definition "Practice question 8 asks why logging messages are better than print() for the same message, and the chapter's answer is that log messages are for the programmer while messages the user should see, such as File not found, use print(); its own examples add that one call, logging.disable(logging.CRITICAL), turns every log message off where print calls would each have to be removed (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#LoggingVersusPrint> .
chx:S_LazyFormatting a doc:ConceptSection ; rdfs:label "Lazy formatting"@en ; doc:sectionTitle "Lazy formatting" ; doc:hierarchyLevel 3 ; doc:sectionOrder 30 ;
    doc:hasParentSection chx:S_Practice ;
    skos:definition "A call such as log.debug('value is %s', obj) formats the message only if it is emitted, so with the level at INFO the object's __str__ runs zero times, while an f-string builds the text first and runs it once; the chapter does not cover this (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#LazyFormatting> .
chx:S_Debugger a doc:TaxonomicSection ; rdfs:label "Debugger"@en ; doc:sectionTitle "Debugger" ; doc:hierarchyLevel 1 ; doc:sectionOrder 31 ;
    skos:definition "The debugger is the fourth instrument, and the one for a question about the state at one line (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Debugger> .
chx:S_Controls a doc:TaxonomicSection ; rdfs:label "Controls"@en ; doc:sectionTitle "Controls" ; doc:hierarchyLevel 2 ; doc:sectionOrder 32 ;
    doc:hasParentSection chx:S_Debugger ;
    skos:definition "The chapter names five controls of the Mu debugger and the breakpoint they work with (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Controls> .
chx:S_Breakpoint a doc:ConceptSection ; rdfs:label "Breakpoint"@en ; doc:sectionTitle "Breakpoint" ; doc:hierarchyLevel 3 ; doc:sectionOrder 33 ;
    doc:hasParentSection chx:S_Controls ;
    skos:definition "A breakpoint is set by clicking a line number, which shows a red dot, and the debugger pauses when the program reaches that line; clicking again removes it, and the Inspector pane shows the values of the variables (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#Breakpoint> .
chx:S_ContinueControl a doc:ConceptSection ; rdfs:label "Continue control"@en ; doc:sectionTitle "Continue control" ; doc:hierarchyLevel 3 ; doc:sectionOrder 34 ;
    doc:hasParentSection chx:S_Controls ;
    skos:definition "Continue runs the program until it reaches a breakpoint or ends (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#ContinueControl> .
chx:S_StepIn a doc:ConceptSection ; rdfs:label "Step in"@en ; doc:sectionTitle "Step in" ; doc:hierarchyLevel 3 ; doc:sectionOrder 35 ;
    doc:hasParentSection chx:S_Controls ;
    skos:definition "Step In executes the next line and, if the line calls a function, moves into that function (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#StepIn> .
chx:S_StepOver a doc:ConceptSection ; rdfs:label "Step over"@en ; doc:sectionTitle "Step over" ; doc:hierarchyLevel 3 ; doc:sectionOrder 36 ;
    doc:hasParentSection chx:S_Controls ;
    skos:definition "Step Over executes the next line, running any function it calls at full speed without stepping into it (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#StepOver> .
chx:S_StepOut a doc:ConceptSection ; rdfs:label "Step out"@en ; doc:sectionTitle "Step out" ; doc:hierarchyLevel 3 ; doc:sectionOrder 37 ;
    doc:hasParentSection chx:S_Controls ;
    skos:definition "Step Out executes lines at full speed until the debugger returns from the current function (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#StepOut> .
chx:S_PythonDebugger a doc:TaxonomicSection ; rdfs:label "Python debugger"@en ; doc:sectionTitle "Python debugger" ; doc:hierarchyLevel 2 ; doc:sectionOrder 38 ;
    doc:hasParentSection chx:S_Debugger ;
    skos:definition "The standard library has its own debugger, so the technique does not depend on one editor (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#PythonDebugger> .
chx:S_BreakpointFunction a doc:ConceptSection ; rdfs:label "Breakpoint function"@en ; doc:sectionTitle "Breakpoint function" ; doc:hierarchyLevel 3 ; doc:sectionOrder 39 ;
    doc:hasParentSection chx:S_PythonDebugger ;
    skos:definition "Since Python 3.7 the built-in breakpoint() calls sys.breakpointhook, which starts pdb, and setting PYTHONBREAKPOINT to 0 makes the call do nothing, so 'the program went on' prints (Warsaw, 2017) (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#BreakpointFunction> .
chx:S_PdbCommands a doc:ConceptSection ; rdfs:label "Pdb commands"@en ; doc:sectionTitle "Pdb commands" ; doc:hierarchyLevel 3 ; doc:sectionOrder 40 ;
    doc:hasParentSection chx:S_PythonDebugger ;
    skos:definition "pdb has the commands step, next, return, continue, break and where, which correspond to Step In, Step Over, Step Out, Continue, a breakpoint and the call stack (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#PdbCommands> .
chx:S_RemoteAttach a doc:ConceptSection ; rdfs:label "Remote attach"@en ; doc:sectionTitle "Remote attach" ; doc:hierarchyLevel 3 ; doc:sectionOrder 41 ;
    doc:hasParentSection chx:S_PythonDebugger ;
    skos:definition "Python 3.14 lets pdb attach to a running process with python -m pdb -p and its identifier, using sys.remote_exec, and a hardcoded breakpoint() reuses the last debugger instance (Galindo Salgado, Wozniski and Stojanovic, 2024) (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch05#RemoteAttach> .
chx:S_ModernPractice a doc:TaxonomicSection ; rdfs:label "Modern practice"@en ; doc:sectionTitle "Modern practice" ; doc:hierarchyLevel 1 ; doc:sectionOrder 42 ;
    skos:definition "The chapter's worked programs show which instrument finds which kind of bug (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#ModernPractice> .
chx:S_WorkedCases a doc:TaxonomicSection ; rdfs:label "Worked cases"@en ; doc:sectionTitle "Worked cases" ; doc:hierarchyLevel 2 ; doc:sectionOrder 43 ;
    doc:hasParentSection chx:S_ModernPractice ;
    skos:definition "Three bugs of the chapter's programs are found with logging or the debugger (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#WorkedCases> .
chx:S_OffByOneRange a doc:ConceptSection ; rdfs:label "Off by one range"@en ; doc:sectionTitle "Off by one range" ; doc:hierarchyLevel 3 ; doc:sectionOrder 44 ;
    doc:hasParentSection chx:S_WorkedCases ;
    skos:definition "The chapter's factorial loops over range(n + 1), so the first pass multiplies by 0 and factorial(5) returns 0; the log shows i is 0, total is 0, and range(1, n + 1) gives 120 (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#OffByOneRange> .
chx:S_StringConcatenation a doc:ConceptSection ; rdfs:label "String concatenation"@en ; doc:sectionTitle "String concatenation" ; doc:hierarchyLevel 3 ; doc:sectionOrder 45 ;
    doc:hasParentSection chx:S_WorkedCases ;
    skos:definition "The buggy adding program stores '5', '3' and '42' as strings, so the program prints The sum is 5342 where 50 is intended (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#StringConcatenation> .
chx:S_TypeMismatchComparison a doc:ConceptSection ; rdfs:label "Type mismatch comparison"@en ; doc:sectionTitle "Type mismatch comparison" ; doc:hierarchyLevel 3 ; doc:sectionOrder 46 ;
    doc:hasParentSection chx:S_WorkedCases ;
    skos:definition "The Buggy Coin Toss Game asks for 'heads' or 'tails' and then tests toss == guess, where toss is the integer from random.randint(0, 1), so the comparison is always false and no guess is ever right (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch05#TypeMismatchComparison> .
