chd:Document a doc:ReportSection ; rdfs:label "Python basics for an advanced course"@en ; skos:definition "This document renews chapter 1 of the 3rd edition for an advanced course, pairing the book's basics with the Python students now run (Sweigart, 2025)." ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    doc:hasSection chd:S_Value, chd:S_Operation, chd:S_BuiltInFunction, chd:S_ExecutionEnvironment, chd:S_ModernPractice .

chd:S_Value a doc:TaxonomicSection ; rdfs:label "Value"@en ; doc:sectionTitle "Value" ; doc:hierarchyLevel 1 ; doc:sectionOrder 1 ;
    skos:definition "Every Python expression reduces to a value, and every value has a data type that decides what can be done with it (Sweigart, 2025). Chapter 1 works with three, in its section The Integer, Floating-Point, and String Data Types: integers, floating-point numbers and strings (Python Software Foundation, 2026)." ;
    dcterms:source <http://example.org/sen0414/ch01#Value> .
chd:S_NumericValue a doc:TaxonomicSection ; rdfs:label "Numeric value"@en ; doc:sectionTitle "Numeric value" ; doc:hierarchyLevel 2 ; doc:sectionOrder 2 ;
    skos:definition "Integers and floating-point numbers look alike in the shell but are stored differently: integers exactly, floats in binary with a fixed precision (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_Value ;
    dcterms:source <http://example.org/sen0414/ch01#NumericValue> .
chd:S_Integer a doc:ConceptSection ; rdfs:label "Integer"@en ; doc:sectionTitle "Integer" ; doc:hierarchyLevel 3 ; doc:sectionOrder 3 ;
    skos:definition "A Python integer has unlimited precision, so 2 ** 100 evaluates exactly to 1267650600228229401496703205376 rather than overflowing as in many languages (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_NumericValue ;
    dcterms:source <http://example.org/sen0414/ch01#Integer> .
chd:S_FloatingPoint a doc:ConceptSection ; rdfs:label "Floating point"@en ; doc:sectionTitle "Floating point" ; doc:hierarchyLevel 3 ; doc:sectionOrder 4 ;
    skos:definition "Floats are stored in binary, so some decimal fractions cannot be represented exactly: 0.1 + 0.2 evaluates to 0.30000000000000004, and round(0.1 + 0.2, 2) gives 0.3 - the reason behind the chapter's closing section, How Computers Store Data with Binary Numbers (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_NumericValue ;
    dcterms:source <http://example.org/sen0414/ch01#FloatingPoint> .
chd:S_TextValue a doc:TaxonomicSection ; rdfs:label "Text value"@en ; doc:sectionTitle "Text value" ; doc:hierarchyLevel 2 ; doc:sectionOrder 5 ;
    skos:definition "Text is a value like any other, and the chapter treats strings with the same expression rules it uses for numbers (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_Value ;
    dcterms:source <http://example.org/sen0414/ch01#TextValue> .
chd:S_String a doc:ConceptSection ; rdfs:label "String"@en ; doc:sectionTitle "String" ; doc:hierarchyLevel 3 ; doc:sectionOrder 6 ;
    skos:definition "A string is a sequence of characters between quotes, and the same operators that act on numbers act on strings with a different meaning (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_TextValue ;
    dcterms:source <http://example.org/sen0414/ch01#String> .
chd:S_Operation a doc:TaxonomicSection ; rdfs:label "Operation"@en ; doc:sectionTitle "Operation" ; doc:hierarchyLevel 1 ; doc:sectionOrder 7 ;
    skos:definition "Operators combine values into new values, and the rules for which operator applies first are fixed by the language, not by the reader (Python Software Foundation, 2026)." ;
    dcterms:source <http://example.org/sen0414/ch01#Operation> .
chd:S_ArithmeticOperation a doc:TaxonomicSection ; rdfs:label "Arithmetic operation"@en ; doc:sectionTitle "Arithmetic operation" ; doc:hierarchyLevel 2 ; doc:sectionOrder 8 ;
    skos:definition "The chapter introduces seven arithmetic operators - +, -, *, /, //, % and ** - evaluated in a documented order (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_Operation ;
    dcterms:source <http://example.org/sen0414/ch01#ArithmeticOperation> .
chd:S_Precedence a doc:ConceptSection ; rdfs:label "Precedence"@en ; doc:sectionTitle "Precedence" ; doc:hierarchyLevel 3 ; doc:sectionOrder 9 ;
    skos:definition "Operator precedence decides the result: 2 + 3 * 6 evaluates to 20, while (2 + 3) * 6 evaluates to 30, because ** binds first, then *, /, // and %, then + and -, and parentheses override the order (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_ArithmeticOperation ;
    dcterms:source <http://example.org/sen0414/ch01#Precedence> .
chd:S_IntegerDivision a doc:ConceptSection ; rdfs:label "Integer division"@en ; doc:sectionTitle "Integer division" ; doc:hierarchyLevel 3 ; doc:sectionOrder 10 ;
    skos:definition "Floor division and the modulus operator split a division into its whole part and its remainder: 23 // 7 is 3 and 23 % 7 is 2, while 23 / 7 gives the float 3.2857142857142856 (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_ArithmeticOperation ;
    dcterms:source <http://example.org/sen0414/ch01#IntegerDivision> .
chd:S_TextOperation a doc:TaxonomicSection ; rdfs:label "Text operation"@en ; doc:sectionTitle "Text operation" ; doc:hierarchyLevel 2 ; doc:sectionOrder 11 ;
    skos:definition "Two operators work on strings: + joins them and * repeats them, which the chapter calls string concatenation and replication (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_Operation ;
    dcterms:source <http://example.org/sen0414/ch01#TextOperation> .
chd:S_Concatenation a doc:ConceptSection ; rdfs:label "Concatenation"@en ; doc:sectionTitle "Concatenation" ; doc:hierarchyLevel 3 ; doc:sectionOrder 12 ;
    skos:definition "String concatenation joins two strings with +, so 'Alice' + 'Bob' gives 'AliceBob'; joining a string to a number raises a TypeError, because Python does not convert types silently (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_TextOperation ;
    dcterms:source <http://example.org/sen0414/ch01#Concatenation> .
chd:S_Replication a doc:ConceptSection ; rdfs:label "Replication"@en ; doc:sectionTitle "Replication" ; doc:hierarchyLevel 3 ; doc:sectionOrder 13 ;
    skos:definition "String replication repeats a string with an integer, so 'Alice' * 3 gives 'AliceAliceAlice' (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_TextOperation ;
    dcterms:source <http://example.org/sen0414/ch01#Replication> .
chd:S_BindingOperation a doc:TaxonomicSection ; rdfs:label "Binding operation"@en ; doc:sectionTitle "Binding operation" ; doc:hierarchyLevel 2 ; doc:sectionOrder 14 ;
    skos:definition "Assignment is the operation that gives a value a name, so later expressions can use it (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_Operation ;
    dcterms:source <http://example.org/sen0414/ch01#BindingOperation> .
chd:S_Assignment a doc:ConceptSection ; rdfs:label "Assignment"@en ; doc:sectionTitle "Assignment" ; doc:hierarchyLevel 3 ; doc:sectionOrder 15 ;
    skos:definition "An assignment statement stores a value in a variable with the = operator, as the chapter's section Storing Values in Variables shows; PEP 8 recommends lower_case names with underscores for variables (Van Rossum et al., 2001)." ;
    doc:hasParentSection chd:S_BindingOperation ;
    dcterms:source <http://example.org/sen0414/ch01#Assignment> .
chd:S_BuiltInFunction a doc:TaxonomicSection ; rdfs:label "Built-in function"@en ; doc:sectionTitle "Built-in function" ; doc:hierarchyLevel 1 ; doc:sectionOrder 16 ;
    skos:definition "Chapter 1's first program uses six built-in functions - print, input, len, str, int and float - which are always available without importing anything; the sections Your First Program and Dissecting the Program walk through them line by line (Python Software Foundation, 2026)." ;
    dcterms:source <http://example.org/sen0414/ch01#BuiltInFunction> .
chd:S_IOFunction a doc:TaxonomicSection ; rdfs:label "Input-output function"@en ; doc:sectionTitle "Input-output function" ; doc:hierarchyLevel 2 ; doc:sectionOrder 17 ;
    skos:definition "Two built-in functions connect a program to its user: print sends text out, and input reads text in (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_BuiltInFunction ;
    dcterms:source <http://example.org/sen0414/ch01#IOFunction> .
chd:S_Output a doc:ConceptSection ; rdfs:label "Output"@en ; doc:sectionTitle "Output" ; doc:hierarchyLevel 3 ; doc:sectionOrder 18 ;
    skos:definition "The print function writes its arguments to the screen as text, which is how the first program says hello (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_IOFunction ;
    dcterms:source <http://example.org/sen0414/ch01#Output> .
chd:S_Input a doc:ConceptSection ; rdfs:label "Input"@en ; doc:sectionTitle "Input" ; doc:hierarchyLevel 3 ; doc:sectionOrder 19 ;
    skos:definition "The input function waits for the user to type and always returns a string, so a number typed at the keyboard arrives as text - the chapter's point about input as text (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_IOFunction ;
    dcterms:source <http://example.org/sen0414/ch01#Input> .
chd:S_ConversionFunction a doc:TaxonomicSection ; rdfs:label "Conversion function"@en ; doc:sectionTitle "Conversion function" ; doc:hierarchyLevel 2 ; doc:sectionOrder 20 ;
    skos:definition "Because input returns text, programs convert values between types with str, int and float (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_BuiltInFunction ;
    dcterms:source <http://example.org/sen0414/ch01#ConversionFunction> .
chd:S_TypeConversion a doc:ConceptSection ; rdfs:label "Type conversion"@en ; doc:sectionTitle "Type conversion" ; doc:hierarchyLevel 3 ; doc:sectionOrder 21 ;
    skos:definition "The conversion functions change a value's type, so int('42') gives 42 and str(29) gives '29'; int('4.2') raises a ValueError because the text is not a whole number (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_ConversionFunction ;
    dcterms:source <http://example.org/sen0414/ch01#TypeConversion> .
chd:S_MeasurementFunction a doc:TaxonomicSection ; rdfs:label "Measurement function"@en ; doc:sectionTitle "Measurement function" ; doc:hierarchyLevel 2 ; doc:sectionOrder 22 ;
    skos:definition "Some built-in functions measure a value rather than convert it, and len is the first the chapter uses (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_BuiltInFunction ;
    dcterms:source <http://example.org/sen0414/ch01#MeasurementFunction> .
chd:S_Length a doc:ConceptSection ; rdfs:label "Length"@en ; doc:sectionTitle "Length" ; doc:hierarchyLevel 3 ; doc:sectionOrder 23 ;
    skos:definition "The len function returns the number of characters in a string, so len('hello') is 5 (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_MeasurementFunction ;
    dcterms:source <http://example.org/sen0414/ch01#Length> .
chd:S_ExecutionEnvironment a doc:TaxonomicSection ; rdfs:label "Execution environment"@en ; doc:sectionTitle "Execution environment" ; doc:hierarchyLevel 1 ; doc:sectionOrder 24 ;
    skos:definition "Where code runs matters as much as what it says, and the Python students run in 2026 is newer than the one the chapter describes: 3.14 is the current release and 3.15 arrives on 1 October 2026 (Python Software Foundation, 2026)." ;
    dcterms:source <http://example.org/sen0414/ch01#ExecutionEnvironment> .
chd:S_InteractiveEnvironment a doc:TaxonomicSection ; rdfs:label "Interactive environment"@en ; doc:sectionTitle "Interactive environment" ; doc:hierarchyLevel 2 ; doc:sectionOrder 25 ;
    skos:definition "The chapter starts with Entering Expressions into the Interactive Shell, where each expression is evaluated as soon as it is entered (Sweigart, 2025)." ;
    doc:hasParentSection chd:S_ExecutionEnvironment ;
    dcterms:source <http://example.org/sen0414/ch01#InteractiveEnvironment> .
chd:S_InteractiveShell a doc:ConceptSection ; rdfs:label "Interactive shell"@en ; doc:sectionTitle "Interactive shell" ; doc:hierarchyLevel 3 ; doc:sectionOrder 26 ;
    skos:definition "Python 3.13 replaced the interactive shell with a better interactive interpreter and improved its error messages, which changes what students see from their first expression (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_InteractiveEnvironment ;
    dcterms:source <http://example.org/sen0414/ch01#InteractiveShell> .
chd:S_InterpreterBuild a doc:TaxonomicSection ; rdfs:label "Interpreter build"@en ; doc:sectionTitle "Interpreter build" ; doc:hierarchyLevel 2 ; doc:sectionOrder 27 ;
    skos:definition "CPython is built in more than one way, and the build decides how programs can use the machine (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_ExecutionEnvironment ;
    dcterms:source <http://example.org/sen0414/ch01#InterpreterBuild> .
chd:S_FreeThreadedBuild a doc:ConceptSection ; rdfs:label "Free-threaded build"@en ; doc:sectionTitle "Free-threaded build" ; doc:hierarchyLevel 3 ; doc:sectionOrder 28 ;
    skos:definition "Python 3.13 introduced an experimental free-threaded build of CPython and an experimental just-in-time compiler, which previews the course's multithreading outcome (Python Software Foundation, 2026)." ;
    doc:hasParentSection chd:S_InterpreterBuild ;
    dcterms:source <http://example.org/sen0414/ch01#FreeThreadedBuild> .
chd:S_ModernPractice a doc:TaxonomicSection ; rdfs:label "Modern practice"@en ; doc:sectionTitle "Modern practice" ; doc:hierarchyLevel 1 ; doc:sectionOrder 29 ;
    skos:definition "An advanced course teaches the current idiom alongside the book's basics, so the chapter's string building and first program are paired with today's tools (Galindo Salgado et al., 2022)." ;
    dcterms:source <http://example.org/sen0414/ch01#ModernPractice> .
chd:S_StringFormatting a doc:TaxonomicSection ; rdfs:label "String formatting"@en ; doc:sectionTitle "String formatting" ; doc:hierarchyLevel 2 ; doc:sectionOrder 30 ;
    skos:definition "Building strings by concatenation works, but formatted string literals are the idiomatic way to mix text and values (Galindo Salgado et al., 2022)." ;
    doc:hasParentSection chd:S_ModernPractice ;
    dcterms:source <http://example.org/sen0414/ch01#StringFormatting> .
chd:S_FString a doc:ConceptSection ; rdfs:label "F-string"@en ; doc:sectionTitle "F-string" ; doc:hierarchyLevel 3 ; doc:sectionOrder 31 ;
    skos:definition "An f-string evaluates expressions inside braces as it builds the string, so f'{2 ** 8}' gives '256'; PEP 701 gave f-strings a formal grammar for Python 3.12 (Galindo Salgado et al., 2022)." ;
    doc:hasParentSection chd:S_StringFormatting ;
    dcterms:source <http://example.org/sen0414/ch01#FString> .
chd:S_Tooling a doc:TaxonomicSection ; rdfs:label "Tooling"@en ; doc:sectionTitle "Tooling" ; doc:hierarchyLevel 2 ; doc:sectionOrder 32 ;
    skos:definition "A Python programmer works through tools as much as through the language, starting with how packages and interpreters are installed (Stack Overflow, 2025)." ;
    doc:hasParentSection chd:S_ModernPractice ;
    dcterms:source <http://example.org/sen0414/ch01#Tooling> .
chd:S_PackageManager a doc:ConceptSection ; rdfs:label "Package manager"@en ; doc:sectionTitle "Package manager" ; doc:hierarchyLevel 3 ; doc:sectionOrder 33 ;
    skos:definition "uv installs Python packages and interpreters; built in Rust, it was the most admired technology in the 2025 Stack Overflow survey at 74 per cent, and it installed the Python 3.14.4 used to check this chapter's examples (Stack Overflow, 2025)." ;
    doc:hasParentSection chd:S_Tooling ;
    dcterms:source <http://example.org/sen0414/ch01#PackageManager> .
