ch01:X_Integer a owl:NamedIndividual, ch01:Integer ; rdfs:label "the integer 2 ** 100"@en ; skos:definition "A whole number. Python integers have unlimited precision, so 2 ** 100 is exact."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:IO_Integer a owl:NamedIndividual, rd:IOExample ; rdfs:label "2 ** 100 evaluates to 1267650600228229401496703205376"@en ; ch01:input "2 ** 100" ; ch01:output "1267650600228229401496703205376" .
ch01:X_Integer rd:hasIOExample ch01:IO_Integer .
ch01:X_FloatingPoint a owl:NamedIndividual, ch01:FloatingPoint ; rdfs:label "the float sum 0.1 + 0.2"@en ; skos:definition "A number with a fractional part, stored in binary, so some decimal values cannot be represented exactly."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:IO_FloatingPoint a owl:NamedIndividual, rd:IOExample ; rdfs:label "0.1 + 0.2 evaluates to 0.30000000000000004"@en ; ch01:input "0.1 + 0.2" ; ch01:output "0.30000000000000004" .
ch01:X_FloatingPoint rd:hasIOExample ch01:IO_FloatingPoint .
ch01:X_String a owl:NamedIndividual, ch01:String ; rdfs:label "the string 'Alice'"@en ; skos:definition "A sequence of characters written between quotes."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:IO_String a owl:NamedIndividual, rd:IOExample ; rdfs:label "'Alice' * 3 evaluates to 'AliceAliceAlice'"@en ; ch01:input "'Alice' * 3" ; ch01:output "'AliceAliceAlice'" .
ch01:X_String rd:hasIOExample ch01:IO_String .
ch01:X_Precedence a owl:NamedIndividual, ch01:Precedence ; rdfs:label "2 + 3 * 6 evaluated"@en ; skos:definition "The order in which operators apply: ** first, then *, /, //, %, then + and -; parentheses override it."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:IO_Precedence a owl:NamedIndividual, rd:IOExample ; rdfs:label "2 + 3 * 6 evaluates to 20"@en ; ch01:input "2 + 3 * 6" ; ch01:output "20" .
ch01:X_Precedence rd:hasIOExample ch01:IO_Precedence .
ch01:X_IntegerDivision a owl:NamedIndividual, ch01:IntegerDivision ; rdfs:label "23 // 7 and 23 % 7"@en ; skos:definition "Floor division gives the whole-number quotient; the modulus operator gives the remainder."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:IO_IntegerDivision a owl:NamedIndividual, rd:IOExample ; rdfs:label "23 // 7 evaluates to 3"@en ; ch01:input "23 // 7" ; ch01:output "3" .
ch01:X_IntegerDivision rd:hasIOExample ch01:IO_IntegerDivision .
ch01:X_Concatenation a owl:NamedIndividual, ch01:Concatenation ; rdfs:label "'Alice' + 'Bob'"@en ; skos:definition "Joining two strings with +. Joining a string to a number raises a TypeError."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:X_Concatenation ch01:hasOwner ch01:X_String .
ch01:IO_Concatenation a owl:NamedIndividual, rd:IOExample ; rdfs:label "'Alice' + 'Bob' evaluates to 'AliceBob'"@en ; ch01:input "'Alice' + 'Bob'" ; ch01:output "'AliceBob'" .
ch01:X_Concatenation rd:hasIOExample ch01:IO_Concatenation .
ch01:X_Replication a owl:NamedIndividual, ch01:Replication ; rdfs:label "'Alice' * 3"@en ; skos:definition "Repeating a string an integer number of times with *."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:X_Replication ch01:hasOwner ch01:X_String .
ch01:IO_Replication a owl:NamedIndividual, rd:IOExample ; rdfs:label "'Alice' * 3 evaluates to 'AliceAliceAlice'"@en ; ch01:input "'Alice' * 3" ; ch01:output "'AliceAliceAlice'" .
ch01:X_Replication rd:hasIOExample ch01:IO_Replication .
ch01:X_Assignment a owl:NamedIndividual, ch01:Assignment ; rdfs:label "spam = 42"@en ; skos:definition "Storing a value in a variable with =; the variable names the value, and the name follows PEP 8's lower_case convention."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:X_Output a owl:NamedIndividual, ch01:Output ; rdfs:label "print('Hello, world!')"@en ; skos:definition "print() writes its arguments as text to the screen."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:X_Input a owl:NamedIndividual, ch01:Input ; rdfs:label "input() reading a name"@en ; skos:definition "input() waits for the user to type and always returns a string - input as text."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:X_TypeConversion a owl:NamedIndividual, ch01:TypeConversion ; rdfs:label "int('42')"@en ; skos:definition "str(), int() and float() convert a value between types; int() refuses a string that is not a whole number."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:IO_TypeConversion a owl:NamedIndividual, rd:IOExample ; rdfs:label "int('42') evaluates to 42"@en ; ch01:input "int('42')" ; ch01:output "42" .
ch01:X_TypeConversion rd:hasIOExample ch01:IO_TypeConversion .
ch01:X_Length a owl:NamedIndividual, ch01:Length ; rdfs:label "len('hello')"@en ; skos:definition "len() returns the number of characters in a string."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:IO_Length a owl:NamedIndividual, rd:IOExample ; rdfs:label "len('hello') evaluates to 5"@en ; ch01:input "len('hello')" ; ch01:output "5" .
ch01:X_Length rd:hasIOExample ch01:IO_Length .
ch01:X_InteractiveShell a owl:NamedIndividual, ch01:InteractiveShell ; rdfs:label "the Python 3.13+ interactive interpreter"@en ; skos:definition "The shell that evaluates expressions as they are typed. Python 3.13 replaced it with a better interactive interpreter."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:X_FreeThreadedBuild a owl:NamedIndividual, ch01:FreeThreadedBuild ; rdfs:label "CPython's experimental free-threaded build"@en ; skos:definition "A build of CPython, experimental since 3.13, that can run threads in parallel - the preview of the course's multithreading outcome."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:X_FString a owl:NamedIndividual, ch01:FString ; rdfs:label "f'{2 ** 8}'"@en ; skos:definition "An f-string evaluates expressions inside braces as it builds the string; PEP 701 gave f-strings a formal grammar."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:IO_FString a owl:NamedIndividual, rd:IOExample ; rdfs:label "f'{2 ** 8}' evaluates to '256'"@en ; ch01:input "f'{2 ** 8}'" ; ch01:output "'256'" .
ch01:X_FString rd:hasIOExample ch01:IO_FString .
ch01:X_PackageManager a owl:NamedIndividual, ch01:PackageManager ; rdfs:label "uv"@en ; skos:definition "A tool that installs Python packages and interpreters. uv, built in Rust, was the most admired technology in the 2025 Stack Overflow survey."@en ; dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:Err_Concatenation a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "'Alice' + 42 raises TypeError: can only concatenate str (not int) to str"@en .
ch01:X_Concatenation rd:hasErrorCondition ch01:Err_Concatenation .
ch01:Err_TypeConversion a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "int('4.2') raises ValueError: invalid literal for int() with base 10"@en .
ch01:X_TypeConversion rd:hasErrorCondition ch01:Err_TypeConversion .

ch01:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 1 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch01/research> ;
    rd:hasCompetencyQuestion ch01:CQs ; rd:hasSourceProvenance ch01:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment ch01:Env .
ch01:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 1 competency questions"@en ;
    rd:containsCompetencyQuestion ch01:CQ1, ch01:CQ2, ch01:CQ3 .
ch01:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which operations can raise an error, and which error?"@en .
ch01:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which examples show a value the chapter's own arithmetic might surprise a student with?"@en .
ch01:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which concepts reach beyond the 3rd edition into current Python, and on what source?"@en .
ch01:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 1 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 1 through the Stage 1 research artefact; the execution-environment and modern-practice branches are drawn from that artefact's secondary sources, not from the book."@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> .
ch01:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.12.3 and CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition executed under CPython 3.12.3 (system) and CPython 3.14.4 (installed with uv 2026-09-24): identical output in both."@en ;
    dcterms:source "The execution run recorded with this ontology's build, 08-tooling/sen0414_ch01_domain_build_v1_0_0.py" .

