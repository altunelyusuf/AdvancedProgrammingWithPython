@prefix chx: <http://example.org/sen0414/ch01#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rd: <http://example.org/rdodi/domain-ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chx:Artifact a rd:DomainOntologyArtifact,
        owl:NamedIndividual ;
    rdfs:label "SEN0414 chapter 1 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch01/research> ;
    rd:hasCompetencyQuestion chx:CQs ;
    rd:hasResolutionEnvironment chx:Env ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ;
    rd:hasSourceProvenance chx:Provenance .

chx:X_Assignment a chx:Assignment,
        owl:NamedIndividual ;
    rdfs:label "spam = 42"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "Storing a value in a variable with =; the variable names the value, and the name follows PEP 8's lower_case convention."@en .

chx:X_Bytecode a chx:Bytecode,
        owl:NamedIndividual ;
    rdfs:label "dis.dis('a + b * 2')"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "The internal representation of a program inside CPython, produced by compiling source code and executed by a virtual machine."@en .

chx:X_CPython a chx:CPython,
        owl:NamedIndividual ;
    rdfs:label "sys.implementation.name"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "The canonical implementation of Python as distributed on python.org; the name distinguishes it from others such as Jython or IronPython."@en .

chx:X_Concatenation a chx:Concatenation,
        owl:NamedIndividual ;
    rdfs:label "'Alice' + 'Bob'"@en ;
    rd:hasErrorCondition chx:Err_Concatenation ;
    rd:hasIOExample chx:IO_Concatenation ;
    chx:hasOwner chx:X_String ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "Joining two strings with +. Joining a string to a number raises a TypeError."@en .

chx:X_DataType a chx:DataType,
        owl:NamedIndividual ;
    rdfs:label "type(3.5)"@en ;
    rd:hasIOExample chx:IO_DataType ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "The kind of a value, which decides which operations apply to it; the type function reports it."@en .

chx:X_Expression a chx:Expression,
        owl:NamedIndividual ;
    rdfs:label "3 * (2 + 4)"@en ;
    rd:hasIOExample chx:IO_Expression ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A piece of code that evaluates to a value, built from values, operators, names and function calls."@en .

chx:X_FString a chx:FString,
        owl:NamedIndividual ;
    rdfs:label "f'{2 ** 8}'"@en ;
    rd:hasIOExample chx:IO_FString ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "An f-string evaluates expressions inside braces as it builds the string; PEP 701 gave f-strings a formal grammar."@en .

chx:X_FloatingPoint a chx:FloatingPoint,
        owl:NamedIndividual ;
    rdfs:label "the float sum 0.1 + 0.2"@en ;
    rd:hasIOExample chx:IO_FloatingPoint ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A number with a fractional part, stored in binary, so some decimal values cannot be represented exactly."@en .

chx:X_FreeThreadedBuild a chx:FreeThreadedBuild,
        owl:NamedIndividual ;
    rdfs:label "a CPython built with --disable-gil"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A build of CPython, configured with --disable-gil, in which several threads can run Python bytecode at the same time."@en .

chx:X_FunctionCall a chx:FunctionCall,
        owl:NamedIndividual ;
    rdfs:label "round(3.14159, 2)"@en ;
    rd:hasIOExample chx:IO_FunctionCall ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "Running a function by writing its name followed by parentheses that hold its arguments; the call evaluates to the function's return value."@en .

chx:X_GlobalInterpreterLock a chx:GlobalInterpreterLock,
        owl:NamedIndividual ;
    rdfs:label "sys._is_gil_enabled()"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "The lock that lets only one thread run Python bytecode at a time in the default CPython build."@en .

chx:X_Input a chx:Input,
        owl:NamedIndividual ;
    rdfs:label "input() reading a name"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "input() waits for the user to type and always returns a string - input as text."@en .

chx:X_Integer a chx:Integer,
        owl:NamedIndividual ;
    rdfs:label "the integer 2 ** 100"@en ;
    rd:hasIOExample chx:IO_Integer ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A whole number. Python integers have unlimited precision, so 2 ** 100 is exact."@en .

chx:X_IntegerDivision a chx:IntegerDivision,
        owl:NamedIndividual ;
    rdfs:label "23 // 7 and 23 % 7"@en ;
    rd:hasIOExample chx:IO_IntegerDivision ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "Floor division gives the whole-number quotient; the modulus operator gives the remainder."@en .

chx:X_InteractiveShell a chx:InteractiveShell,
        owl:NamedIndividual ;
    rdfs:label "the Python 3.13+ interactive interpreter"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "The shell that evaluates expressions as they are typed. Python 3.13 replaced it with a better interactive interpreter."@en .

chx:X_Length a chx:Length,
        owl:NamedIndividual ;
    rdfs:label "len('hello')"@en ;
    rd:hasIOExample chx:IO_Length ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "len() returns the number of characters in a string."@en .

chx:X_Operator a chx:Operator,
        owl:NamedIndividual ;
    rdfs:label "7 % 3"@en ;
    rd:hasIOExample chx:IO_Operator ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A symbol such as +, * or % that performs an operation on its operands; the type of the operands decides its meaning."@en .

chx:X_Output a chx:Output,
        owl:NamedIndividual ;
    rdfs:label "print('Hello, world!')"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "print() writes its arguments as text to the screen."@en .

chx:X_PEP a chx:PEP,
        owl:NamedIndividual ;
    rdfs:label "PEP 8"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A design document that proposes a new feature for Python or records a design decision, such as PEP 8 for style."@en .

chx:X_Package a chx:Package,
        owl:NamedIndividual ;
    rdfs:label "import random"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A Python module that can contain submodules; packages are how code is shared and installed, from the standard library to third-party libraries."@en .

chx:X_PackageManager a chx:PackageManager,
        owl:NamedIndividual ;
    rdfs:label "uv"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A tool that installs Python packages and interpreters. uv, built in Rust, was the most admired technology in the 2025 Stack Overflow survey."@en .

chx:X_Precedence a chx:Precedence,
        owl:NamedIndividual ;
    rdfs:label "2 + 3 * 6 evaluated"@en ;
    rd:hasIOExample chx:IO_Precedence ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "The order in which operators apply: ** first, then *, /, //, %, then + and -; parentheses override it."@en .

chx:X_PythonInterpreter a chx:PythonInterpreter,
        owl:NamedIndividual ;
    rdfs:label "python3.14 script.py"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "The program that reads Python source code and runs it, either line by line in the shell or from a file."@en .

chx:X_PythonVersion a chx:PythonVersion,
        owl:NamedIndividual ;
    rdfs:label "python --version"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "The number that identifies a Python release, such as 3.14.4; sys.version_info reports its major, minor and micro parts."@en .

chx:X_Replication a chx:Replication,
        owl:NamedIndividual ;
    rdfs:label "'Alice' * 3"@en ;
    rd:hasIOExample chx:IO_Replication ;
    chx:hasOwner chx:X_String ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "Repeating a string an integer number of times with *."@en .

chx:X_Thread a chx:Thread,
        owl:NamedIndividual ;
    rdfs:label "threading.Thread(target=f)"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A separate flow of execution inside one program; all threads of a program share the same memory."@en .

chx:X_TypeConversion a chx:TypeConversion,
        owl:NamedIndividual ;
    rdfs:label "int('42')"@en ;
    rd:hasErrorCondition chx:Err_TypeConversion ;
    rd:hasIOExample chx:IO_TypeConversion ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "str(), int() and float() convert a value between types; int() refuses a string that is not a whole number."@en .

chx:X_Variable a chx:Variable,
        owl:NamedIndividual ;
    rdfs:label "spam = 42"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A name that refers to a value; assigning to the name again makes it refer to a new value."@en .

chx:X_VirtualEnvironment a chx:VirtualEnvironment,
        owl:NamedIndividual ;
    rdfs:label "python -m venv .venv"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A self-contained directory with its own Python interpreter and packages, so that different projects can use different versions of the same library."@en .

<http://example.org/sen0414/ch01/abox> a owl:Ontology ;
    rdfs:label "SEN0414 chapter 1 domain ontology - ABox"@en ;
    dcterms:created "2026-10-25"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:identifier "sen0414_ch01_abox_v1_3_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-25"^^xsd:date ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    owl:versionIRI <http://example.org/sen0414/ch01/abox/1.3.0> ;
    owl:versionInfo "1.3.0" ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://example.org/sen0414/activity/ch01-rdodi-run> .

chx:CQ1 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which operations can raise an error, and which error?"@en .

chx:CQ2 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which examples show a value the chapter's own arithmetic might surprise a student with?"@en .

chx:CQ3 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which concepts reach beyond the 3rd edition into current Python, and on what source?"@en .

chx:CQs a rd:CompetencyQuestionSet,
        owl:NamedIndividual ;
    rdfs:label "Chapter 1 competency questions"@en ;
    rd:containsCompetencyQuestion chx:CQ1,
        chx:CQ2,
        chx:CQ3 .

chx:Env a rd:ResolutionEnvironment,
        owl:NamedIndividual ;
    rdfs:label "CPython 3.12.3 and CPython 3.14.4"@en ;
    dcterms:source "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch01_corpus_v1_2_0.py" ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (51 checks listed in sen0414_ch01_corpus_v1_2_0.py), executed under CPython 3.12.3 and CPython 3.14.4: identical output where more than one was used."@en .

chx:Err_Concatenation a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "'Alice' + 42 raises TypeError: can only concatenate str (not int) to str"@en .

chx:Err_TypeConversion a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "int('4.2') raises ValueError: invalid literal for int() with base 10"@en .

chx:IO_Concatenation a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "'Alice' + 'Bob' evaluates to 'AliceBob'"@en ;
    chx:input "'Alice' + 'Bob'" ;
    chx:output "'AliceBob'" .

chx:IO_DataType a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "type(3.5) evaluates to <class 'float'>"@en ;
    chx:input "type(3.5)" ;
    chx:output "<class 'float'>" .

chx:IO_Expression a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "3 * (2 + 4) evaluates to 18"@en ;
    chx:input "3 * (2 + 4)" ;
    chx:output "18" .

chx:IO_FString a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "f'{2 ** 8}' evaluates to '256'"@en ;
    chx:input "f'{2 ** 8}'" ;
    chx:output "'256'" .

chx:IO_FloatingPoint a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "0.1 + 0.2 evaluates to 0.30000000000000004"@en ;
    chx:input "0.1 + 0.2" ;
    chx:output "0.30000000000000004" .

chx:IO_FunctionCall a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "round(3.14159, 2) evaluates to 3.14"@en ;
    chx:input "round(3.14159, 2)" ;
    chx:output "3.14" .

chx:IO_Integer a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "2 ** 100 evaluates to 1267650600228229401496703205376"@en ;
    chx:input "2 ** 100" ;
    chx:output "1267650600228229401496703205376" .

chx:IO_IntegerDivision a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "23 // 7 evaluates to 3"@en ;
    chx:input "23 // 7" ;
    chx:output "3" .

chx:IO_Length a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "len('hello') evaluates to 5"@en ;
    chx:input "len('hello')" ;
    chx:output "5" .

chx:IO_Operator a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "7 % 3 evaluates to 1"@en ;
    chx:input "7 % 3" ;
    chx:output "1" .

chx:IO_Precedence a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "2 + 3 * 6 evaluates to 20"@en ;
    chx:input "2 + 3 * 6" ;
    chx:output "20" .

chx:IO_Replication a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "'Alice' * 3 evaluates to 'AliceAliceAlice'"@en ;
    chx:input "'Alice' * 3" ;
    chx:output "'AliceAliceAlice'" .

chx:IO_String a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "'Alice' * 3 evaluates to 'AliceAliceAlice'"@en ;
    chx:input "'Alice' * 3" ;
    chx:output "'AliceAliceAlice'" .

chx:IO_TypeConversion a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "int('42') evaluates to 42"@en ;
    chx:input "int('42')" ;
    chx:output "42" .

chx:Provenance a rd:ResearchSubjectInput,
        owl:NamedIndividual ;
    rdfs:label "Derived from the chapter 1 research artefact"@en ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 1 through the Stage 1 research artefact; the execution-environment and modern-practice branches are drawn from that artefact's secondary sources, not from the book."@en .

chx:X_String a chx:String,
        owl:NamedIndividual ;
    rdfs:label "the string 'Alice'"@en ;
    rd:hasIOExample chx:IO_String ;
    dcterms:source <http://example.org/sen0414/ch01/research> ;
    skos:definition "A sequence of characters written between quotes."@en .

