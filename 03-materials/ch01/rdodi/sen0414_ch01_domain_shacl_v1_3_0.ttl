@prefix chx: <http://example.org/sen0414/ch01#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rd: <http://example.org/rdodi/domain-ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chx:ExemplarShape a sh:NodeShape ;
    sh:property [ sh:message "Every individual needs a label." ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ] ;
    sh:targetClass owl:NamedIndividual .

chx:ExemplarSourcedShape a sh:NodeShape ;
    sh:property [ sh:message "A defined exemplar must cite its source." ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetSubjectsOf skos:definition .

chx:IOShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "An I/O example needs exactly one input." ;
            sh:minCount 1 ;
            sh:path chx:input ;
            sh:severity sh:Violation ],
        [ sh:maxCount 1 ;
            sh:message "An I/O example needs exactly one output." ;
            sh:minCount 1 ;
            sh:path chx:output ;
            sh:severity sh:Violation ] ;
    sh:targetClass rd:IOExample .

<http://example.org/sen0414/ch01/shacl> a owl:Ontology ;
    rdfs:label "SEN0414 chapter 1 domain ontology - shapes"@en ;
    dcterms:created "2026-10-25"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:identifier "sen0414_ch01_shacl_v1_3_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-25"^^xsd:date ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    owl:versionIRI <http://example.org/sen0414/ch01/shacl/1.3.0> ;
    owl:versionInfo "1.3.0" ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://example.org/sen0414/activity/ch01-rdodi-run> .

