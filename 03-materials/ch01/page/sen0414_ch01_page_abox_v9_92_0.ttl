pg:wv_FloatingPoint a ipo:InstructionalWidget ; rdfs:label "FloatingPoint step-through widget"@en ;
    skos:definition "The widget for Floating point lets the reader type a number or an expression, here 0.1, and shows the 64 bits of its IEEE 754 double with the exact decimal value those bits stand for and the exponent, so that the reader sees what Python stores against the decimal it prints."@en ; dcterms:source <http://example.org/sen0414/ch01#S_FloatingPoint> ; dcterms:isPartOf pg:FloatingPoint ;
    ipo:demonstratesSubject <http://example.org/sen0414/ch01#FloatingPoint> ;
    wp:instantiatesPrimitive wp:Primitive_CoupledVariableExplorer ; ds:selectionWarrant "Feature_AsymmetricContrast: the learner types a number and sees the bits Python stores, against the decimal it shows" ;
    wp:demonstratesConcept <http://example.org/sen0414/ch01#FloatingPoint> ;
    wp:hasDesignTest "Exercised in headless Chromium by 08-tooling/sen0414_page_test_v9_37_0.py: 64 bits match the build interpreter's" ; wp:designTestPassed true .
