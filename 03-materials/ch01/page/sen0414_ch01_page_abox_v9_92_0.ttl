pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Predict the value of an expression using Python's operator precedence"@en ;
    skos:definition "The objective is met when the reader can predict the value of an expression using Python's operator precedence, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter1.html> ;
    ld:bloomLevel ld:Apply  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain why floating-point arithmetic can be inexact while integer arithmetic is exact"@en ;
    skos:definition "The objective is met when the reader can explain why floating-point arithmetic can be inexact while integer arithmetic is exact, at the understand level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter1.html> ;
    ld:bloomLevel ld:Understand  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Convert values between types and anticipate the errors conversion and concatenation raise"@en ;
    skos:definition "The objective is met when the reader can convert values between types and anticipate the errors conversion and concatenation raise, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter1.html> ;
    ld:bloomLevel ld:Apply  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Build strings from values with f-strings rather than concatenation"@en ;
    skos:definition "The objective is met when the reader can build strings from values with f-strings rather than concatenation, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter1.html> ;
    ld:bloomLevel ld:Apply  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Install a package into a virtual environment with a package manager, and explain why a project keeps its dependencies apart from the system interpreter"@en ;
    skos:definition "The objective is met when the reader can install a package into a virtual environment with a package manager, and explain why a project keeps its dependencies apart from the system interpreter, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter1.html> ;
    ld:bloomLevel ld:Apply  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:CO6 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain what the global interpreter lock does, what the free-threaded build changes, and when running work in threads can help"@en ;
    skos:definition "The objective is met when the reader can explain what the global interpreter lock does, what the free-threaded build changes, and when running work in threads can help, at the understand level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter1.html> ;
    ld:bloomLevel ld:Understand  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does 2 + 3 * 6 evaluate to?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "30 is what you get if + ran first; * binds tighter than +." ;
    ld:distractorRationale "36 would need (2 + 4) * 6; nothing in the expression groups that way." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "20" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "30" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "36" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why does 0.1 + 0.2 not print 0.3?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "Python does not round the sum at all - it shows the nearest binary value exactly." ;
    ld:distractorRationale "It is not a bug: Python 3.14.4 prints the same result, because the cause is binary representation." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "Floats are stored in binary, and 0.1 has no exact binary form" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "Python rounds floats badly" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "It is a bug fixed in Python 3.14" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What type of value does input() return when the user types 42?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "input() never converts: digits arrive as text until int() converts them." ;
    ld:distractorRationale "Python cannot know intent; input() always returns a string." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "A string" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "An integer" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "Whatever type the user intended" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What happens when you run 'Alice' + 42?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "Python does not convert 42 to text silently; you must write str(42)." ;
    ld:distractorRationale "+ never discards its left operand; the operation fails instead." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "It raises a TypeError" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "It gives 'Alice42'" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "It gives 42" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which is the modern way to build 'Hello, Alice!' from name = 'Alice'?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "Concatenation works, but every value must already be a string and it is harder to read; f-strings are the current idiom (PEP 701)." ;
    ld:distractorRationale "* repeats a string by an integer; a string name cannot be a repeat count." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "f'Hello, {name}!'" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "'Hello, ' + name + '!'" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "'Hello, ' * name" .
pg:Value a ipo:ChapterSection ; rdfs:label "Value"@en ;
    skos:definition "A value is a piece of data that a Python program can compute with, store and print. The whole number 42, the decimal 3.14 and the text 'Alice' are all values, and each has a data type that decides what can be done with it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Value> ;
    sen0414:anchor "#s-Value" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Value .
pg:NumericValue a ipo:ChapterSection ; rdfs:label "Numeric value"@en ;
    skos:definition "Numeric values are numbers that a program can do arithmetic with. The chapter meets two kinds of them: integers, which are whole numbers, and floating-point numbers, which have a fractional part (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_NumericValue> ;
    sen0414:anchor "#s-NumericValue" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Value .
pg:Page ipo:coversChapterSection pg:NumericValue .
pg:Integer a ipo:ChapterSection ; rdfs:label "Integer"@en ;
    skos:definition "An integer is a whole number without a fractional part, such as 42, 0 or -7. In Python it belongs to the type int, the same name that the int function uses when it converts a value (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Integer> ;
    sen0414:anchor "#s-Integer" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NumericValue .
pg:Page ipo:coversChapterSection pg:Integer .
pg:FloatingPoint a ipo:ChapterSection ; rdfs:label "Floating point"@en ;
    skos:definition "A floating-point number, or float, is a number with a fractional part, such as 3.14 or -0.5. In Python it belongs to the type float (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_FloatingPoint> ;
    sen0414:anchor "#s-FloatingPoint" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NumericValue .
pg:Page ipo:coversChapterSection pg:FloatingPoint .
pg:TextValue a ipo:ChapterSection ; rdfs:label "Text value"@en ;
    skos:definition "Text values are sequences of characters that a program reads, stores and prints. Chapter 1 treats text as a value like any other, with the same expression rules it uses for numbers (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_TextValue> ;
    sen0414:anchor "#s-TextValue" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Value .
pg:Page ipo:coversChapterSection pg:TextValue .
pg:String a ipo:ChapterSection ; rdfs:label "String"@en ;
    skos:definition "A string is a sequence of characters written between quotes, such as 'Alice' or 'Hello, world!'. Python names the type str, and either single or double quotes can enclose the text (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_String> ;
    sen0414:anchor "#s-String" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TextValue .
pg:Page ipo:coversChapterSection pg:String .
pg:ValueModel a ipo:ChapterSection ; rdfs:label "Value model"@en ;
    skos:definition "The value model is the pair of ideas that explain what a value is: every value has a data type, and an expression is the piece of code that evaluates to a value. The two ideas depend on each other, because the type of an expression's result is decided by the types of the values it combines."@en ; dcterms:source <http://example.org/sen0414/ch01#S_ValueModel> ;
    sen0414:anchor "#s-ValueModel" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Value .
pg:Page ipo:coversChapterSection pg:ValueModel .
pg:DataType a ipo:ChapterSection ; rdfs:label "Data type"@en ;
    skos:definition "A data type is the kind of a value, and it decides what the value can do and what can be done with it. Every Python object has a type, which can be read with the type function (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_DataType> ;
    sen0414:anchor "#s-DataType" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ValueModel .
pg:Page ipo:coversChapterSection pg:DataType .
pg:Expression a ipo:ChapterSection ; rdfs:label "Expression"@en ;
    skos:definition "An expression is a piece of code that Python can evaluate to a value. It is built from literals, names, operators and function calls; 2 + 3 * 6 is an expression whose value is 20 (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Expression> ;
    sen0414:anchor "#s-Expression" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ValueModel .
pg:Page ipo:coversChapterSection pg:Expression .
pg:Operation a ipo:ChapterSection ; rdfs:label "Operation"@en ;
    skos:definition "An operation combines values into a new value, and in Python most operations are written with operators placed between their operands. The chapter covers arithmetic on numbers, joining and repeating of strings, and the assignment that gives a value a name."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Operation> ;
    sen0414:anchor "#s-Operation" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Operation .
pg:ArithmeticOperation a ipo:ChapterSection ; rdfs:label "Arithmetic operation"@en ;
    skos:definition "Arithmetic operations calculate with numbers. The chapter introduces seven operators for them: +, -, *, /, //, % and ** (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_ArithmeticOperation> ;
    sen0414:anchor "#s-ArithmeticOperation" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Operation .
pg:Page ipo:coversChapterSection pg:ArithmeticOperation .
pg:Operator a ipo:ChapterSection ; rdfs:label "Operator"@en ;
    skos:definition "An operator is a symbol that tells Python to perform an operation on the values around it, which are called its operands. In 7 % 3 the symbol % is the operator and 7 and 3 are its operands (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Operator> ;
    sen0414:anchor "#s-Operator" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ArithmeticOperation .
pg:Page ipo:coversChapterSection pg:Operator .
pg:Precedence a ipo:ChapterSection ; rdfs:label "Precedence"@en ;
    skos:definition "Operator precedence is the rule that decides which operator is applied first when an expression contains several. It is fixed by the language: ** binds first, then *, /, // and %, then + and - (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Precedence> ;
    sen0414:anchor "#s-Precedence" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ArithmeticOperation .
pg:Page ipo:coversChapterSection pg:Precedence .
pg:IntegerDivision a ipo:ChapterSection ; rdfs:label "Integer division"@en ;
    skos:definition "Integer division splits a division into a whole-number quotient and a remainder. Floor division, written //, gives the quotient rounded down, and the modulus operator, written %, gives the remainder (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_IntegerDivision> ;
    sen0414:anchor "#s-IntegerDivision" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ArithmeticOperation .
pg:Page ipo:coversChapterSection pg:IntegerDivision .
pg:TextOperation a ipo:ChapterSection ; rdfs:label "Text operation"@en ;
    skos:definition "Text operations build new strings from existing ones. Two operators work on strings in the chapter: + joins them and * repeats them, which the chapter calls string concatenation and string replication (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_TextOperation> ;
    sen0414:anchor "#s-TextOperation" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Operation .
pg:Page ipo:coversChapterSection pg:TextOperation .
pg:Concatenation a ipo:ChapterSection ; rdfs:label "Concatenation"@en ;
    skos:definition "String concatenation joins two strings into one with the + operator, so 'Alice' + 'Bob' gives 'AliceBob' (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Concatenation> ;
    sen0414:anchor "#s-Concatenation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TextOperation .
pg:Page ipo:coversChapterSection pg:Concatenation .
pg:Replication a ipo:ChapterSection ; rdfs:label "Replication"@en ;
    skos:definition "String replication repeats a string a whole number of times with the * operator, so 'Alice' * 3 gives 'AliceAliceAlice' (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Replication> ;
    sen0414:anchor "#s-Replication" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:TextOperation .
pg:Page ipo:coversChapterSection pg:Replication .
pg:BindingOperation a ipo:ChapterSection ; rdfs:label "Binding operation"@en ;
    skos:definition "A binding operation gives a value a name, so that later lines can refer to it. In Python the main binding operation is the assignment statement (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_BindingOperation> ;
    sen0414:anchor "#s-BindingOperation" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Operation .
pg:Page ipo:coversChapterSection pg:BindingOperation .
pg:Variable a ipo:ChapterSection ; rdfs:label "Variable"@en ;
    skos:definition "A variable is a name that refers to a value stored in the computer's memory. After spam = 42, the name spam refers to the integer 42 and can be used wherever that value is needed (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Variable> ;
    sen0414:anchor "#s-Variable" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:BindingOperation .
pg:Page ipo:coversChapterSection pg:Variable .
pg:Assignment a ipo:ChapterSection ; rdfs:label "Assignment"@en ;
    skos:definition "An assignment statement stores a value in a variable with the equals sign. In spam = 42 the name on the left is bound to the value of the expression on the right (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Assignment> ;
    sen0414:anchor "#s-Assignment" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:BindingOperation .
pg:Page ipo:coversChapterSection pg:Assignment .
pg:BuiltInFunction a ipo:ChapterSection ; rdfs:label "Built-in function"@en ;
    skos:definition "A built-in function is a function that Python provides ready to use, without importing anything. The chapter's first program uses six of them: print, input, len, str, int and float (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_BuiltInFunction> ;
    sen0414:anchor "#s-BuiltInFunction" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:BuiltInFunction .
pg:CallMechanism a ipo:ChapterSection ; rdfs:label "Calling a function"@en ;
    skos:definition "Calling a function means asking Python to run it now, with given values. The call is written as the function's name followed by parentheses, and the values inside the parentheses are the arguments (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_CallMechanism> ;
    sen0414:anchor "#s-CallMechanism" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BuiltInFunction .
pg:Page ipo:coversChapterSection pg:CallMechanism .
pg:FunctionCall a ipo:ChapterSection ; rdfs:label "Function call"@en ;
    skos:definition "A function call runs a function with the values given inside parentheses, called its arguments, and the call evaluates to the function's return value. In round(3.14159, 2) the name round is the function, 3.14159 and 2 are the arguments, and the value is 3.14 (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_FunctionCall> ;
    sen0414:anchor "#s-FunctionCall" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CallMechanism .
pg:Page ipo:coversChapterSection pg:FunctionCall .
pg:IOFunction a ipo:ChapterSection ; rdfs:label "Input-output function"@en ;
    skos:definition "Input-output functions connect a program to its user: print sends text out, and input reads text in (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_IOFunction> ;
    sen0414:anchor "#s-IOFunction" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BuiltInFunction .
pg:Page ipo:coversChapterSection pg:IOFunction .
pg:Output a ipo:ChapterSection ; rdfs:label "Output"@en ;
    skos:definition "The print function writes its arguments to the screen as text. The call print('Hello, world!') displays Hello, world!"@en ; dcterms:source <http://example.org/sen0414/ch01#S_Output> ;
    sen0414:anchor "#s-Output" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:IOFunction .
pg:Page ipo:coversChapterSection pg:Output .
pg:Input a ipo:ChapterSection ; rdfs:label "Input"@en ;
    skos:definition "The input function waits for the user to type a line and returns it. If it is given a prompt, input writes that text first, without a trailing newline (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Input> ;
    sen0414:anchor "#s-Input" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:IOFunction .
pg:Page ipo:coversChapterSection pg:Input .
pg:ConversionFunction a ipo:ChapterSection ; rdfs:label "Conversion function"@en ;
    skos:definition "Conversion functions change a value from one data type to another. The chapter uses three of them: str, int and float (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_ConversionFunction> ;
    sen0414:anchor "#s-ConversionFunction" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BuiltInFunction .
pg:Page ipo:coversChapterSection pg:ConversionFunction .
pg:TypeConversion a ipo:ChapterSection ; rdfs:label "Type conversion"@en ;
    skos:definition "Type conversion produces a value of another type from an existing one. The call int('42') gives the integer 42, float('3.5') gives the float 3.5 and str(29) gives the string '29' (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_TypeConversion> ;
    sen0414:anchor "#s-TypeConversion" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ConversionFunction .
pg:Page ipo:coversChapterSection pg:TypeConversion .
pg:MeasurementFunction a ipo:ChapterSection ; rdfs:label "Measurement function"@en ;
    skos:definition "A measurement function reports a property of a value without changing it. The first one the chapter uses is len (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_MeasurementFunction> ;
    sen0414:anchor "#s-MeasurementFunction" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BuiltInFunction .
pg:Page ipo:coversChapterSection pg:MeasurementFunction .
pg:Length a ipo:ChapterSection ; rdfs:label "Length"@en ;
    skos:definition "The len function returns the number of items in an object; for a string it is the number of characters, so len('hello') is 5 (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Length> ;
    sen0414:anchor "#s-Length" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:MeasurementFunction .
pg:Page ipo:coversChapterSection pg:Length .
pg:ExecutionEnvironment a ipo:ChapterSection ; rdfs:label "Execution environment"@en ;
    skos:definition "An execution environment is the software that reads a Python program and carries it out: the interpreter, the way it was built and the version in use. The same program can behave slightly differently in different environments."@en ; dcterms:source <http://example.org/sen0414/ch01#S_ExecutionEnvironment> ;
    sen0414:anchor "#s-ExecutionEnvironment" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:ExecutionEnvironment .
pg:InteractiveEnvironment a ipo:ChapterSection ; rdfs:label "Interactive environment"@en ;
    skos:definition "An interactive environment lets a learner type Python and see the result immediately. The chapter starts with Entering Expressions into the Interactive Shell, where each expression is evaluated as soon as it is entered (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_InteractiveEnvironment> ;
    sen0414:anchor "#s-InteractiveEnvironment" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ExecutionEnvironment .
pg:Page ipo:coversChapterSection pg:InteractiveEnvironment .
pg:InteractiveShell a ipo:ChapterSection ; rdfs:label "Interactive shell"@en ;
    skos:definition "The interactive shell is the program in which a learner types Python statements and expressions at a prompt and sees the results at once. It is also called the interactive interpreter or the REPL, an acronym for read-eval-print loop (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_InteractiveShell> ;
    sen0414:anchor "#s-InteractiveShell" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:InteractiveEnvironment .
pg:Page ipo:coversChapterSection pg:InteractiveShell .
pg:PythonImplementation a ipo:ChapterSection ; rdfs:label "Python implementation"@en ;
    skos:definition "Python is a language, and a Python implementation is a program that reads code written in that language and carries it out. The language defines what a program means; the implementation decides how the computer does it."@en ; dcterms:source <http://example.org/sen0414/ch01#S_PythonImplementation> ;
    sen0414:anchor "#s-PythonImplementation" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ExecutionEnvironment .
pg:Page ipo:coversChapterSection pg:PythonImplementation .
pg:PythonInterpreter a ipo:ChapterSection ; rdfs:label "Python interpreter"@en ;
    skos:definition "The Python interpreter is the program that reads Python code and runs it. Python is an interpreted language, as opposed to a compiled one, which means that source files can be run directly without explicitly creating an executable first (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_PythonInterpreter> ;
    sen0414:anchor "#s-PythonInterpreter" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PythonImplementation .
pg:Page ipo:coversChapterSection pg:PythonInterpreter .
pg:CPython a ipo:ChapterSection ; rdfs:label "CPython"@en ;
    skos:definition "CPython is the canonical implementation of the Python programming language, as distributed on python.org. The name CPython is used when it is necessary to distinguish this implementation from others such as Jython or IronPython (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_CPython> ;
    sen0414:anchor "#s-CPython" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PythonImplementation .
pg:Page ipo:coversChapterSection pg:CPython .
pg:Bytecode a ipo:ChapterSection ; rdfs:label "Bytecode"@en ;
    skos:definition "Bytecode is the internal representation of a Python program inside the CPython interpreter. Python source code is compiled into bytecode, which is said to run on a virtual machine that executes the machine code corresponding to each bytecode (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Bytecode> ;
    sen0414:anchor "#s-Bytecode" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PythonImplementation .
pg:Page ipo:coversChapterSection pg:Bytecode .
pg:InterpreterBuild a ipo:ChapterSection ; rdfs:label "Interpreter build"@en ;
    skos:definition "An interpreter build is one particular way of compiling the CPython interpreter from its source code. The default build and the free-threaded build behave alike for most programs but differ in how threads can use the processor (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_InterpreterBuild> ;
    sen0414:anchor "#s-InterpreterBuild" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ExecutionEnvironment .
pg:Page ipo:coversChapterSection pg:InterpreterBuild .
pg:Thread a ipo:ChapterSection ; rdfs:label "Thread"@en ;
    skos:definition "A thread is a separate flow of execution inside one program, so that several activities can be in progress at once. In the threading module the Thread class represents an activity that is run in a separate thread of control (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Thread> ;
    sen0414:anchor "#s-Thread" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:InterpreterBuild .
pg:Page ipo:coversChapterSection pg:Thread .
pg:GlobalInterpreterLock a ipo:ChapterSection ; rdfs:label "Global interpreter lock"@en ;
    skos:definition "The global interpreter lock, or GIL, is the mechanism the CPython interpreter uses to ensure that only one thread executes Python bytecode at a time (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_GlobalInterpreterLock> ;
    sen0414:anchor "#s-GlobalInterpreterLock" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:InterpreterBuild .
pg:Page ipo:coversChapterSection pg:GlobalInterpreterLock .
pg:FreeThreadedBuild a ipo:ChapterSection ; rdfs:label "Free-threaded build"@en ;
    skos:definition "A free-threaded build is a build of CPython that supports free threading, a threading model in which multiple threads can run Python bytecode simultaneously within the same interpreter. It is configured with the --disable-gil option before compilation (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_FreeThreadedBuild> ;
    sen0414:anchor "#s-FreeThreadedBuild" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:InterpreterBuild .
pg:Page ipo:coversChapterSection pg:FreeThreadedBuild .
pg:PythonRelease a ipo:ChapterSection ; rdfs:label "Python release"@en ;
    skos:definition "A Python release is a published version of the language and its interpreter, identified by a version number, together with the proposals and the schedule that lead up to it."@en ; dcterms:source <http://example.org/sen0414/ch01#S_PythonRelease> ;
    sen0414:anchor "#s-PythonRelease" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ExecutionEnvironment .
pg:Page ipo:coversChapterSection pg:PythonRelease .
pg:PythonVersion a ipo:ChapterSection ; rdfs:label "Python version"@en ;
    skos:definition "A Python version is the number that identifies a release, such as 3.14.4. Python reports it with python --version, and a program can read it from sys.version_info, whose fields include major, minor and micro."@en ; dcterms:source <http://example.org/sen0414/ch01#S_PythonVersion> ;
    sen0414:anchor "#s-PythonVersion" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PythonRelease .
pg:Page ipo:coversChapterSection pg:PythonVersion .
pg:PEP a ipo:ChapterSection ; rdfs:label "Python Enhancement Proposal"@en ;
    skos:definition "A Python Enhancement Proposal, or PEP, is a design document that provides information to the Python community or describes a new feature for Python or its processes or environment (Warsaw et al., 2000)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_PEP> ;
    sen0414:anchor "#s-PEP" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PythonRelease .
pg:Page ipo:coversChapterSection pg:PEP .
pg:ModernPractice a ipo:ChapterSection ; rdfs:label "Modern practice"@en ;
    skos:definition "Modern practice is the way Python programmers work today: the idioms that experienced developers prefer and the tools they use to install, run and organise code. An advanced course teaches this practice alongside the basics of the textbook."@en ; dcterms:source <http://example.org/sen0414/ch01#S_ModernPractice> ;
    sen0414:anchor "#s-ModernPractice" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:ModernPractice .
pg:StringFormatting a ipo:ChapterSection ; rdfs:label "String formatting"@en ;
    skos:definition "String formatting builds a string out of text and values in one step. Building strings by concatenation works, but a formatted string literal lets a program write an expression between braces inside the string, and the Python tutorial notes that the older str.format() method requires more manual effort (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_StringFormatting> ;
    sen0414:anchor "#s-StringFormatting" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ModernPractice .
pg:Page ipo:coversChapterSection pg:StringFormatting .
pg:FString a ipo:ChapterSection ; rdfs:label "F-string"@en ;
    skos:definition "An f-string, short for formatted string literal, is a string literal prefixed with f or F whose braces hold expressions (Python Software Foundation, 2026). Python evaluates each expression and inserts its value into the text, so f'{2 ** 8}' gives '256'."@en ; dcterms:source <http://example.org/sen0414/ch01#S_FString> ;
    sen0414:anchor "#s-FString" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:StringFormatting .
pg:Page ipo:coversChapterSection pg:FString .
pg:Tooling a ipo:ChapterSection ; rdfs:label "Tooling"@en ;
    skos:definition "Tooling is the set of programs a Python developer uses around the language itself: to install interpreters and packages, to keep projects apart and to run code. Working with these tools is part of programming as much as writing code is."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Tooling> ;
    sen0414:anchor "#s-Tooling" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ModernPractice .
pg:Page ipo:coversChapterSection pg:Tooling .
pg:Package a ipo:ChapterSection ; rdfs:label "Package"@en ;
    skos:definition "A package is a Python module that can contain submodules or, recursively, subpackages. A module is an object that serves as an organizational unit of Python code, and it is loaded into a program by importing it (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_Package> ;
    sen0414:anchor "#s-Package" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Tooling .
pg:Page ipo:coversChapterSection pg:Package .
pg:VirtualEnvironment a ipo:ChapterSection ; rdfs:label "Virtual environment"@en ;
    skos:definition "A virtual environment is a self-contained directory tree that contains a Python installation for a particular version of Python, plus a number of additional packages (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_VirtualEnvironment> ;
    sen0414:anchor "#s-VirtualEnvironment" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Tooling .
pg:Page ipo:coversChapterSection pg:VirtualEnvironment .
pg:PackageManager a ipo:ChapterSection ; rdfs:label "Package manager"@en ;
    skos:definition "A package manager is a tool that installs, upgrades and removes packages and keeps track of the versions a project needs. The tool uv is a package and project manager for Python, written in Rust, whose documentation promises a single tool to replace pip, pip-tools, pipx, poetry, pyenv, twine, virtualenv and more (Astral, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch01#S_PackageManager> ;
    sen0414:anchor "#s-PackageManager" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Tooling .
pg:Page ipo:coversChapterSection pg:PackageManager .
pg:NumericValue sen0414:hasPanel pg:Integer, pg:FloatingPoint .
pg:TextValue sen0414:hasPanel pg:String .
pg:ValueModel sen0414:hasPanel pg:DataType, pg:Expression .
pg:ArithmeticOperation sen0414:hasPanel pg:Operator, pg:Precedence, pg:IntegerDivision .
pg:TextOperation sen0414:hasPanel pg:Concatenation, pg:Replication .
pg:BindingOperation sen0414:hasPanel pg:Variable, pg:Assignment .
pg:CallMechanism sen0414:hasPanel pg:FunctionCall .
pg:IOFunction sen0414:hasPanel pg:Output, pg:Input .
pg:ConversionFunction sen0414:hasPanel pg:TypeConversion .
pg:MeasurementFunction sen0414:hasPanel pg:Length .
pg:InteractiveEnvironment sen0414:hasPanel pg:InteractiveShell .
pg:PythonImplementation sen0414:hasPanel pg:PythonInterpreter, pg:CPython, pg:Bytecode .
pg:InterpreterBuild sen0414:hasPanel pg:Thread, pg:GlobalInterpreterLock, pg:FreeThreadedBuild .
pg:PythonRelease sen0414:hasPanel pg:PythonVersion, pg:PEP .
pg:StringFormatting sen0414:hasPanel pg:FString .
pg:Tooling sen0414:hasPanel pg:Package, pg:VirtualEnvironment, pg:PackageManager .
pg:CE_01 a ipo:CodeExample ; rdfs:label "The prompt as a calculator"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 6 of the deck and runs 4 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 6 ; sen0414:orderInTab 1 ;
    sen0414:code "print(2 + 2)\nprint('Py' + 'thon')\nprint(2 + 3 * 6)\nprint(3 * (2 + 4))" ; sen0414:expectedOutput "4\nPython\n20\n18\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "Three data types"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 8 of the deck and runs 5 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 2 ;
    sen0414:code "print(type(7))\nprint(type(3.5))\nprint(type('Alice'))\nprint(type(7 + 1))\nprint(type(7 + 1.0))" ; sen0414:expectedOutput "<class 'int'>\n<class 'float'>\n<class 'str'>\n<class 'int'>\n<class 'float'>\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "Integers are exact"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 9 of the deck and runs 5 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 3 ;
    sen0414:code "print(7 + 1)\nprint(2 ** 100)\nprint(len(str(2 ** 100)))\nprint(int('42') + 1)\nprint(int(4.7))" ; sen0414:expectedOutput "8\n1267650600228229401496703205376\n31\n43\n4\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Floats are approximate"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 10 of the deck and runs 6 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 4 ;
    sen0414:code "print(0.1 + 0.2)\nprint(round(0.1 + 0.2, 2))\nprint(0.1 + 0.2 == 0.3)\nprint(6 / 3)\nprint(type(6 / 3))\nprint(4 * 3.75 - 1)" ; sen0414:expectedOutput "0.30000000000000004\n0.3\nFalse\n2.0\n<class 'float'>\n14.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "Strings are text"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 11 of the deck and runs 4 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 11 ; sen0414:orderInTab 5 ;
    sen0414:code "print('Hello, world!')\nprint(len('Hello, world!'))\nprint('7' == 7)\nprint(type('7'), type(7))" ; sen0414:expectedOutput "Hello, world!\n13\nFalse\n<class 'str'> <class 'int'>\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Seven arithmetic operators"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 14 of the deck and runs 7 lines of Python that print 7 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 6 ;
    sen0414:code "print(5 + 2)\nprint(5 - 2)\nprint(5 * 2)\nprint(5 / 2)\nprint(5 // 2)\nprint(5 % 2)\nprint(5 ** 2)" ; sen0414:expectedOutput "7\n3\n10\n2.5\n2\n1\n25\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "Operator precedence"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 15 of the deck and runs 5 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 15 ; sen0414:orderInTab 7 ;
    sen0414:code "print(2 + 3 * 6)\nprint((2 + 3) * 6)\nprint(-3 ** 2)\nprint((-3) ** 2)\nprint(8 / 2 * 3)" ; sen0414:expectedOutput "20\n30\n-9\n9\n12.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Quotient and remainder"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 16 of the deck and runs 5 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 8 ;
    sen0414:code "print(23 // 7)\nprint(23 % 7)\nprint(23 // 7 * 7 + 23 % 7)\nprint(-7 // 2)\nprint(23 / 7)" ; sen0414:expectedOutput "3\n2\n23\n-4\n3.2857142857142856\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Joining strings"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 18 of the deck and runs 5 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 18 ; sen0414:orderInTab 9 ;
    sen0414:code "print('Alice' + 'Bob')\nprint('Hello' + ' ' + 'world')\ntry: print('Alice' + 42)\nexcept TypeError as e: print('TypeError:', e)\nprint('Alice' + str(42))" ; sen0414:expectedOutput "AliceBob\nHello world\nTypeError: can only concatenate str (not 'int') to str\nAlice42\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "Repeating strings"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 19 of the deck and runs 5 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 10 ;
    sen0414:code "print('Alice' * 3)\nprint(3 * 'ab')\nprint(repr('ab' * 0))\ntry: print('Alice' * 2.5)\nexcept TypeError as e: print('TypeError:', e)" ; sen0414:expectedOutput "AliceAliceAlice\nababab\n''\nTypeError: can't multiply sequence by non-int of type 'float'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "Variables"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 22 of the deck and runs 6 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 11 ;
    sen0414:code "spam = 42\nprint(spam)\nspam = spam + 1\nprint(spam)\ntry: print(Spam)\nexcept NameError as e: print('NameError:', e)" ; sen0414:expectedOutput "42\n43\nNameError: name 'Spam' is not defined\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "print() and its options"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 23 of the deck and runs 4 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 12 ;
    sen0414:code "print('Hello,', 'world!')\nprint('Hello,', 'world!', sep='-', end=' <end>\\n')\nprint()\nprint('the line above is empty')" ; sen0414:expectedOutput "Hello, world!\nHello,-world! <end>\n\nthe line above is empty\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "str, int, float and len"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 25 of the deck and runs 6 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 13 ;
    sen0414:code "print(str(29))\nprint(int('42'))\nprint(float('3.5'))\nprint(int(4.7))\nprint(len('hello'))\nprint(len(str(12345)))" ; sen0414:expectedOutput "29\n42\n3.5\n4\n5\n5\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "Errors that teach"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 26 of the deck and runs 5 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 14 ;
    sen0414:code "print(int('42'))\ntry: print(int('4.2'))\nexcept ValueError as e: print('ValueError:', e)\ntry: print(len(12345))\nexcept TypeError as e: print('TypeError:', e)" ; sen0414:expectedOutput "42\nValueError: invalid literal for int() with base 10: '4.2'\nTypeError: object of type 'int' has no len()\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "input() gives text"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 27 of the deck and runs 4 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 27 ; sen0414:orderInTab 15 ;
    sen0414:code "typed = '20'  # the text input() would return\nprint(type(typed).__name__)\nprint(typed + '1')\nprint(int(typed) + 1)" ; sen0414:expectedOutput "str\n201\n21\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "import opens a module"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 28 of the deck and runs 4 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 28 ; sen0414:orderInTab 16 ;
    sen0414:code "import math\nprint(type(math).__name__)\nprint(math.sqrt(16))\nprint(math.pi)" ; sen0414:expectedOutput "module\n4.0\n3.141592653589793\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "Your first program"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 32 of the deck and runs 9 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 17 ;
    sen0414:code "print('Hello, world!')\nprint('What is your name?')\nmy_name = 'Ayse'  # the text input() would return\nprint('It is good to meet you, ' + my_name)\nprint('The length of your name is:')\nprint(len(my_name))\nmy_age = '20'  # input() returns text\nnext_age = int(my_age) + 1\nprint('You will be ' + str(next_age) + ' next year.')" ; sen0414:expectedOutput "Hello, world!\nWhat is your name?\nIt is good to meet you, Ayse\nThe length of your name is:\n4\nYou will be 21 next year.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "Dissecting the program"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 33 of the deck and runs 4 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 33 ; sen0414:orderInTab 18 ;
    sen0414:code "name = 'Alice'\nage = 20\nprint('Hello, ' + name + '! You are ' + str(age) + '.')\nprint(f'Hello, {name}! You are {age}.')" ; sen0414:expectedOutput "Hello, Alice! You are 20.\nHello, Alice! You are 20.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "Binary numbers"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 35 of the deck and runs 5 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch01/page/chapter_code_ch01_v1_1_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 19 ;
    sen0414:code "print(bin(5))\nprint(int('101', 2))\nprint(2 ** 8)\nprint(format(5, '08b'))\nprint(format(255, '08b'))" ; sen0414:expectedOutput "0b101\n5\n256\n00000101\n11111111\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
