pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Chapter 1 interactive page"@en ;
    dcterms:source <http://example.org/sen0414/ch01/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 ;
    sen0414:navigationRule "BP-D34: 33 sections falls in 26-50, so a grouped permanent top bar with a sub-section sidebar; the named single flowing anchor-page variation of procedure v1.6.0 section 5.3." ;
    sen0414:pythonUsed "Python 3.14.4" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Sidebar and main content"@en .
pg:Header a ipo:Header ; rdfs:label "Sticky header with grouped section bar"@en .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Section tree"@en .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Grouped permanent top bar"@en .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 1 Stage 3 document"@en ; dcterms:source <http://example.org/sen0414/ch01/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Predict the value of an expression using Python's operator precedence"@en ; ld:bloomLevel ld:Apply  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Explain why floating-point arithmetic can be inexact while integer arithmetic is exact"@en ; ld:bloomLevel ld:Understand  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Convert values between types and anticipate the errors conversion and concatenation raise"@en ; ld:bloomLevel ld:Apply  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Build strings from values with f-strings rather than concatenation"@en ; ld:bloomLevel ld:Apply  ; sen0414:servesOutcome <http://example.org/sen0414#LO1>, <http://example.org/sen0414#LO4> .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does 2 + 3 * 6 evaluate to?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "30 is what you get if + ran first; * binds tighter than +." ; ld:distractorRationale "36 would need (2 + 4) * 6; nothing in the expression groups that way." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "20" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "30" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "36" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Why does 0.1 + 0.2 not print 0.3?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O0 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "Python does not round the sum at all - it shows the nearest binary value exactly." ; ld:distractorRationale "It is not a bug: Python 3.14.4 prints the same result, because the cause is binary representation." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "Floats are stored in binary, and 0.1 has no exact binary form" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "Python rounds floats badly" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "It is a bug fixed in Python 3.14" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What type of value does input() return when the user types 42?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "input() never converts: digits arrive as text until int() converts them." ; ld:distractorRationale "Python cannot know intent; input() always returns a string." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "A string" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "An integer" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "Whatever type the user intended" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What happens when you run 'Alice' + 42?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "Python does not convert 42 to text silently; you must write str(42)." ; ld:distractorRationale "+ never discards its left operand; the operation fails instead." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "It raises a TypeError" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "It gives 'Alice42'" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "It gives 42" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which is the modern way to build 'Hello, Alice!' from name = 'Alice'?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "Concatenation works, but every value must already be a string and it is harder to read; f-strings are the current idiom (PEP 701)." ; ld:distractorRationale "* repeats a string by an integer; a string name cannot be a repeat count." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "f'Hello, {name}!'" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "'Hello, ' + name + '!'" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "'Hello, ' * name" .
