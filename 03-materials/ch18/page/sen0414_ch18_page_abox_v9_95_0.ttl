pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Read and write CSV files with reader, writer, DictReader and DictWriter, opening files with newline='' and choosing the delimiter and line terminator"@en ;
    skos:definition "The objective is met when the reader can read and write CSV files with reader, writer, DictReader and DictWriter, opening files with newline='' and choosing the delimiter and line terminator, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter18.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Predict what a CSV reader gives back (strings, line_num, quoting) and find the flaw in a header-removal program"@en ;
    skos:definition "The objective is met when the reader can predict what a CSV reader gives back (strings, line_num, quoting) and find the flaw in a header-removal program, at the analyze level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter18.html> ;
    ld:bloomLevel ld:Analyze  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Convert between JSON text and Python values with loads and dumps, and say which values survive the round trip"@en ;
    skos:definition "The objective is met when the reader can convert between JSON text and Python values with loads and dumps, and say which values survive the round trip, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter18.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Parse, search and build XML with ElementTree, and explain why every XML value is text"@en ;
    skos:definition "The objective is met when the reader can parse, search and build XML with ElementTree, and explain why every XML value is text, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter18.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Choose between CSV, JSON, XML and TOML for given data, and name the precautions for XML from an untrusted source"@en ;
    skos:definition "The objective is met when the reader can choose between CSV, JSON, XML and TOML for given data, and name the precautions for XML from an untrusted source, at the evaluate level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter18.html> ;
    ld:bloomLevel ld:Evaluate  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "line = 'Alice,30,'San Francisco, CA''. What do len(line.split(',')) and len(next(csv.reader([line]))) give?"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "Not three pieces: split cuts at every comma, quoted or not, so it gives four, while the reader keeps the quoted field whole and gives three." ;
    ld:distractorRationale "The reader respects the quotes, so it gives three fields, not four." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "4 and 3" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "3 and 3" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "4 and 4" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does csv.writer(io.StringIO()).writerow(['spam', 'eggs', 'bacon', 'ham']) return?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "19 is the length of 'spam,eggs,bacon,ham' without the line terminator." ;
    ld:distractorRationale "4 is the number of values, not the number of characters written." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "19" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "21" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "4" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "row = next(csv.reader(['4/5/2035 13:34,Apples,73'])). What is type(row[2]).__name__?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "The csv module does no conversion; a program calls int itself." ;
    ld:distractorRationale "Only quoting=csv.QUOTE_NONNUMERIC reads unquoted values as floats." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "int" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "str" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "float" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A file saved by Excel as 'CSV UTF-8' starts with a byte order mark. It is read with open(name, encoding='utf-8'), and the first row is ['Name', 'City']. What is the first field of the row as Python sees it?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O1 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "That is what encoding='utf-8-sig' gives, because it strips the mark." ;
    ld:distractorRationale "utf-8 decodes the three bytes of the mark as the character U+FEFF without complaint; it stays in the first field." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "'Name'" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "'\\ufeffName'" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "an error is raised" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "json.loads(json.dumps({1: 'a'})) returns what?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "JSON object keys are always strings, so the integer key comes back as the string '1'." ;
    ld:distractorRationale "dumps accepts int keys and writes them as strings; it refuses only keys that are not str, int, float, bool or None." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "{1: 'a'}" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "{'1': 'a'}" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "an error is raised" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A tuple (1, 2) is written with json.dumps and read back with json.loads. What comes back?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "JSON has no tuple, so the round trip gives a list." ;
    ld:distractorRationale "loads returns the Python value the text describes; the string is the text that dumps wrote." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "(1, 2)" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "[1, 2]" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "'[1, 2]'" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "json.loads('['spam', 'eggs',]') is run. What happens?"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "That is how a Python list literal behaves; JSON does not allow the trailing comma." ;
    ld:distractorRationale "Nothing is added after the comma; the text is refused." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "It returns ['spam', 'eggs']" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "It raises json.JSONDecodeError, a kind of ValueError" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "It returns ['spam', 'eggs', None]" .
pg:Q8 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "ET.fromstring('<a><b>1</b></a>').find('b').text is what?"@en ; ld:hasOption pg:Q8_O0, pg:Q8_O1, pg:Q8_O2 ; ld:hasCorrectOption pg:Q8_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "Every value in XML is text; a program converts it with int()." ;
    ld:distractorRationale "text is the string between the tags, here '1'; find returned the element and .text is its text." .
pg:Q8_O0 a ld:AnswerOption ; rdfs:label "the integer 1" .
pg:Q8_O1 a ld:AnswerOption ; rdfs:label "the string '1'" .
pg:Q8_O2 a ld:AnswerOption ; rdfs:label "the element b" .
pg:Q9 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "In xmltodict, xmltodict.parse('<a><b>1</b></a>')['a']['b'] and xmltodict.parse('<a><b>1</b><b>2</b></a>')['a']['b'] have which types?"@en ; ld:hasOption pg:Q9_O0, pg:Q9_O1, pg:Q9_O2 ; ld:hasCorrectOption pg:Q9_O0 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "A repeated tag becomes a list and a single tag a plain value, so a program has to handle both shapes." ;
    ld:distractorRationale "A single tag gives its text, not a list." .
pg:Q9_O0 a ld:AnswerOption ; rdfs:label "str and list" .
pg:Q9_O1 a ld:AnswerOption ; rdfs:label "str and str" .
pg:Q9_O2 a ld:AnswerOption ; rdfs:label "list and list" .
pg:Q10 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "doc = '<!DOCTYPE a [<!ENTITY e 'xxxx'>]><a>&e;&e;</a>'. What does ET.fromstring(doc).text give, and what does defusedxml.ElementTree.fromstring(doc) do?"@en ; ld:hasOption pg:Q10_O0, pg:Q10_O1, pg:Q10_O2 ; ld:hasCorrectOption pg:Q10_O1 ; ld:cognitiveLevel ld:Evaluate ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "ElementTree expands an entity defined in the document itself, so the text is the expanded value." ;
    ld:distractorRationale "defusedxml refuses documents that declare entities, which is why it is the choice for XML from an untrusted source." .
pg:Q10_O0 a ld:AnswerOption ; rdfs:label "'&e;&e;' and the same" .
pg:Q10_O1 a ld:AnswerOption ; rdfs:label "'xxxxxxxx' and it raises EntitiesForbidden" .
pg:Q10_O2 a ld:AnswerOption ; rdfs:label "'xxxxxxxx' and the same" .
pg:Q11 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A row a,,'' (the third field is an empty quoted string) is read with quoting=csv.QUOTE_NOTNULL. What does list(csv.reader(..., quoting=csv.QUOTE_NOTNULL)) give for that row?"@en ; ld:hasOption pg:Q11_O0, pg:Q11_O1, pg:Q11_O2 ; ld:hasCorrectOption pg:Q11_O1 ; ld:cognitiveLevel ld:Analyze ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "With QUOTE_NOTNULL an empty field without quotes is read as None." ;
    ld:distractorRationale "Only the unquoted empty field becomes None; the quoted one stays an empty string." .
pg:Q11_O0 a ld:AnswerOption ; rdfs:label "[['a', '', '']]" .
pg:Q11_O1 a ld:AnswerOption ; rdfs:label "[['a', None, '']]" .
pg:Q11_O2 a ld:AnswerOption ; rdfs:label "[['a', None, None]]" .
pg:CsvFormat a ipo:ChapterSection ; rdfs:label "Csv format"@en ;
    skos:definition "The chapter opens by saying that CSV, JSON and XML are data serialization formats that store data as plaintext files, and that a CSV file is a simplified spreadsheet stored as plaintext whose lines are rows and whose values are separated by commas (Sweigart, 2025). RFC 4180 describes the format as records on lines, fields separated by commas, quotes around fields with commas, line breaks or quotes, and CRLF line ends (Shafranovich, 2005)(Internet Assigned Numbers Authority, n.d.)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_CsvFormat> ;
    sen0414:anchor "#s-CsvFormat" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:CsvFormat .
pg:CsvRules a ipo:ChapterSection ; rdfs:label "Csv rules"@en ;
    skos:definition "The chapter describes a CSV file as lines of values separated by commas and warns that splitting a line on commas fails when a value contains a comma, which is why the csv module exists (Sweigart, 2025). RFC 4180 gives seven rules: a line break ends each record, the last may lack one, an optional header comes first, fields are separated by commas, quotes enclose special fields, and a quote inside a quoted field is doubled (Shafranovich, 2005)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_CsvRules> ;
    sen0414:anchor "#s-CsvRules" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:CsvFormat .
pg:Page ipo:coversChapterSection pg:CsvRules .
pg:FieldsAndRecords a ipo:ChapterSection ; rdfs:label "Fields and records"@en ;
    skos:definition "The chapter says each line of a CSV file represents a row of a spreadsheet and commas separate the cells in the row, and prints example3.xlsx as lines of comma-separated values (Sweigart, 2025). RFC 4180 says each record is on a separate line and the fields of a record are separated by commas (Shafranovich, 2005)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_FieldsAndRecords> ;
    sen0414:anchor "#s-FieldsAndRecords" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvRules .
pg:Page ipo:coversChapterSection pg:FieldsAndRecords .
pg:QuotedCommaField a ipo:ChapterSection ; rdfs:label "Quoted comma field"@en ;
    skos:definition "The chapter warns that calling split(',') on each line of text does not work because not every comma separates two cells, and notes that the writer escapes the comma in 'Hello, world!' with double quotes (Sweigart, 2025). RFC 4180 says fields containing commas, double quotes or line breaks should be enclosed in double quotes (Shafranovich, 2005)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_QuotedCommaField> ;
    sen0414:anchor "#s-QuotedCommaField" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvRules .
pg:Page ipo:coversChapterSection pg:QuotedCommaField .
pg:DoubledQuoteEscape a ipo:ChapterSection ; rdfs:label "Doubled quote escape"@en ;
    skos:definition "The chapter does not say how a double quote inside a value is written (Sweigart, 2025). RFC 4180 says a double quote appearing inside a field must be escaped by preceding it with another double quote, and the csv module's doublequote parameter defaults to True (Shafranovich, 2005)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_DoubledQuoteEscape> ;
    sen0414:anchor "#s-DoubledQuoteEscape" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvRules .
pg:Page ipo:coversChapterSection pg:DoubledQuoteEscape .
pg:EmbeddedLineBreak a ipo:ChapterSection ; rdfs:label "Embedded line break"@en ;
    skos:definition "The chapter does not say that a value can hold a line break (Sweigart, 2025). RFC 4180 says fields containing line breaks must be enclosed in double quotes, and the csv documentation says line_num counts lines, not records, because records can span several lines (Shafranovich, 2005)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_EmbeddedLineBreak> ;
    sen0414:anchor "#s-EmbeddedLineBreak" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvRules .
pg:Page ipo:coversChapterSection pg:EmbeddedLineBreak .
pg:LastRecordNoBreak a ipo:ChapterSection ; rdfs:label "Last record no break"@en ;
    skos:definition "The chapter prints its CSV files as lines and says nothing about the end of the file (Sweigart, 2025). RFC 4180 says the last record in the file may or may not have an ending line break, and that a header line is optional (Shafranovich, 2005)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_LastRecordNoBreak> ;
    sen0414:anchor "#s-LastRecordNoBreak" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvRules .
pg:Page ipo:coversChapterSection pg:LastRecordNoBreak .
pg:CsvDialects a ipo:ChapterSection ; rdfs:label "Csv dialects"@en ;
    skos:definition "The chapter changes the delimiter to a tab with the delimiter keyword and the line ending with lineterminator, and does not use the word dialect (Sweigart, 2025). The Python documentation says that, because of the lack of a strict CSV specification, applications produce subtly different data, and that a dialect is a set of formatting parameters such as delimiter, quotechar, doublequote, skipinitialspace, lineterminator and quoting (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_CsvDialects> ;
    sen0414:anchor "#s-CsvDialects" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:CsvFormat .
pg:Page ipo:coversChapterSection pg:CsvDialects .
pg:ExcelDialect a ipo:ChapterSection ; rdfs:label "Excel dialect"@en ;
    skos:definition "The chapter changes the delimiter and the line terminator with keyword arguments and does not name the dialect they modify (Sweigart, 2025). The Python documentation says a dialect is a set of formatting parameters, that csv.excel is the default and describes the usual properties of an Excel-generated CSV file, and that excel-tab and unix are also registered (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ExcelDialect> ;
    sen0414:anchor "#s-ExcelDialect" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvDialects .
pg:Page ipo:coversChapterSection pg:ExcelDialect .
pg:TabDelimited a ipo:ChapterSection ; rdfs:label "Tab delimited"@en ;
    skos:definition "The chapter writes a tab-separated file with delimiter='\\t' and lineterminator='\\n\\n', and prints the return values 21, 30 and 16 (Sweigart, 2025). The Python documentation registers the dialect excel-tab for tab-delimited files (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_TabDelimited> ;
    sen0414:anchor "#s-TabDelimited" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvDialects .
pg:Page ipo:coversChapterSection pg:TabDelimited .
pg:QuotingConstants a ipo:ChapterSection ; rdfs:label "Quoting constants"@en ;
    skos:definition "The chapter never names a quoting mode (Sweigart, 2025). The Python documentation lists QUOTE_MINIMAL, QUOTE_ALL, QUOTE_NONNUMERIC and QUOTE_NONE, and QUOTE_STRINGS and QUOTE_NOTNULL which Python 3.12 added (Python Software Foundation, 2026)(Python Software Foundation, 2026, What's New)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_QuotingConstants> ;
    sen0414:anchor "#s-QuotingConstants" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvDialects .
pg:Page ipo:coversChapterSection pg:QuotingConstants .
pg:CsvEncoding a ipo:ChapterSection ; rdfs:label "Csv encoding"@en ;
    skos:definition "The chapter's listings open files with open('example3.csv') and open('output.csv', 'w', newline=''), and the chapter does not mention an encoding (Sweigart, 2025). The Python documentation says that in text mode, if the encoding is not specified, it is platform-dependent and given by locale.getencoding() (Python Software Foundation, 2026)(Python Software Foundation, 2026, locale)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_CsvEncoding> ;
    sen0414:anchor "#s-CsvEncoding" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:CsvFormat .
pg:Page ipo:coversChapterSection pg:CsvEncoding .
pg:DefaultEncodingIsLocale a ipo:ChapterSection ; rdfs:label "Default encoding is locale"@en ;
    skos:definition "The chapter's listings call open() without an encoding and never mention one (Sweigart, 2025). The Python documentation says that if the encoding is not specified in text mode it is platform-dependent, given by locale.getencoding(), and PEP 686 makes UTF-8 mode the default from Python 3.15 (Python Software Foundation, 2026)(Inada, 2022)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_DefaultEncodingIsLocale> ;
    sen0414:anchor "#s-DefaultEncodingIsLocale" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvEncoding .
pg:Page ipo:coversChapterSection pg:DefaultEncodingIsLocale .
pg:BomUtf8Sig a ipo:ChapterSection ; rdfs:label "Bom utf8 sig"@en ;
    skos:definition "The chapter does not say that a CSV file can start with a byte order mark (Sweigart, 2025). The Python documentation describes utf-8-sig as the variant that writes and skips the mark that Microsoft Notepad introduced, and RFC 8259 forbids adding one to JSON that is sent over a network (Python Software Foundation, 2026)(Python Software Foundation, 2026, codecs)(Bray, 2017)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_BomUtf8Sig> ;
    sen0414:anchor "#s-BomUtf8Sig" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvEncoding .
pg:Page ipo:coversChapterSection pg:BomUtf8Sig .
pg:Cp1252Mojibake a ipo:ChapterSection ; rdfs:label "Cp1252 mojibake"@en ;
    skos:definition "The chapter does not say what happens when the file's encoding and the program's differ (Sweigart, 2025). The Python documentation lists cp1252 as Western Europe and cp1254 as Turkish among its standard encodings, and says the default depends on the locale (Python Software Foundation, 2026, codecs)(Python Software Foundation, 2026, locale)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_Cp1252Mojibake> ;
    sen0414:anchor "#s-Cp1252Mojibake" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvEncoding .
pg:Page ipo:coversChapterSection pg:Cp1252Mojibake .
pg:CsvModule a ipo:ChapterSection ; rdfs:label "Csv module"@en ;
    skos:definition "The first half of the chapter teaches the csv module: pass a file object to csv.reader() or csv.writer(), loop over the reader or call writerow(), pass delimiter and lineterminator to change the format, and use DictReader and DictWriter when the first row is a header (Sweigart, 2025). The Python documentation lists the same objects with their parameters and says the module follows PEP 305 (Python Software Foundation, 2026)(Altis et al., 2003)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_CsvModule> ;
    sen0414:anchor "#s-CsvModule" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:CsvModule .
pg:ReaderObjects a ipo:ChapterSection ; rdfs:label "Reader objects"@en ;
    skos:definition "The chapter reads a CSV file by passing the file object that open() returns to csv.reader(), converts the reader to a list with list(), or loops over it in a for loop, which it says saves memory with large files, and notes that a reader can be looped over only once (Sweigart, 2025). A reader gives each row as a list of strings (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ReaderObjects> ;
    sen0414:anchor "#s-ReaderObjects" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:CsvModule .
pg:Page ipo:coversChapterSection pg:ReaderObjects .
pg:ReaderEveryValueString a ipo:ChapterSection ; rdfs:label "Reader every value string"@en ;
    skos:definition "The chapter lists what CSV files lack, no data types among them, and says that every value is a string, and it prints the rows of example3.csv as lists of strings (Sweigart, 2025). The Python documentation says each row read from the file is returned as a list of strings unless QUOTE_NONNUMERIC is set (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ReaderEveryValueString> ;
    sen0414:anchor "#s-ReaderEveryValueString" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReaderObjects .
pg:Page ipo:coversChapterSection pg:ReaderEveryValueString .
pg:ReaderUsedOnce a ipo:ChapterSection ; rdfs:label "Reader used once"@en ;
    skos:definition "The chapter says you can loop over the reader object only once and must call open() and csv.reader() again to read the file again (Sweigart, 2025). A reader is an iterator over the lines of the file object (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ReaderUsedOnce> ;
    sen0414:anchor "#s-ReaderUsedOnce" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReaderObjects .
pg:Page ipo:coversChapterSection pg:ReaderUsedOnce .
pg:LineNumVsRecords a ipo:ChapterSection ; rdfs:label "Line num vs records"@en ;
    skos:definition "The chapter uses reader.line_num to print the row number and to test for row 1 and skip the header, and says line numbers begin at 1 (Sweigart, 2025). The Python documentation says line_num is the number of lines read from the source iterator and is not the same as the number of records returned, as records can span multiple lines (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_LineNumVsRecords> ;
    sen0414:anchor "#s-LineNumVsRecords" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReaderObjects .
pg:Page ipo:coversChapterSection pg:LineNumVsRecords .
pg:LoopSavesMemory a ipo:ChapterSection ; rdfs:label "Loop saves memory"@en ;
    skos:definition "The chapter says that for large CSV files a for loop over the reader saves loading the entire file into memory at once (Sweigart, 2025). The tracemalloc module reports the current and peak size of traced memory blocks (Python Software Foundation, 2026, tracemalloc)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_LoopSavesMemory> ;
    sen0414:anchor "#s-LoopSavesMemory" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReaderObjects .
pg:Page ipo:coversChapterSection pg:LoopSavesMemory .
pg:WriterObjects a ipo:ChapterSection ; rdfs:label "Writer objects"@en ;
    skos:definition "The chapter writes a CSV file by opening it with 'w' and newline='', passing it to csv.writer() and calling writerow() with a list, and says writerow() returns the number of characters written (Sweigart, 2025). The Python documentation says the writer converts None to an empty string and everything else with str() (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_WriterObjects> ;
    sen0414:anchor "#s-WriterObjects" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:CsvModule .
pg:Page ipo:coversChapterSection pg:WriterObjects .
pg:WriterReturnsLength a ipo:ChapterSection ; rdfs:label "Writer returns length"@en ;
    skos:definition "The chapter writes output.csv with three calls of writerow() and prints the return values 21, 32 and 16, and says the method returns the number of characters written to the file (Sweigart, 2025). The Python documentation says writerow returns the return value of the call to the write method of the file object (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_WriterReturnsLength> ;
    sen0414:anchor "#s-WriterReturnsLength" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WriterObjects .
pg:Page ipo:coversChapterSection pg:WriterReturnsLength .
pg:WriterTypes a ipo:ChapterSection ; rdfs:label "Writer types"@en ;
    skos:definition "The chapter writes strings, an int and a float and says the writer escapes the comma of 'Hello, world!' (Sweigart, 2025). The Python documentation says all other non-string data is stringified with str() before being written and that None is written as the empty string (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_WriterTypes> ;
    sen0414:anchor "#s-WriterTypes" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WriterObjects .
pg:Page ipo:coversChapterSection pg:WriterTypes .
pg:WriterDoubleSpacing a ipo:ChapterSection ; rdfs:label "Writer double spacing"@en ;
    skos:definition "The chapter says that on Windows you must pass newline='' to open() or the rows of output.csv will be double-spaced, as shown in Figure 18-1, for technical reasons beyond the scope of the book (Sweigart, 2025). The Python documentation says that without newline='' an extra carriage return is added on platforms that use CRLF on write (Python Software Foundation, 2026)(Python Software Foundation, 2026, io)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_WriterDoubleSpacing> ;
    sen0414:anchor "#s-WriterDoubleSpacing" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:WriterObjects .
pg:Page ipo:coversChapterSection pg:WriterDoubleSpacing .
pg:DictReadersWriters a ipo:ChapterSection ; rdfs:label "Dict readers writers"@en ;
    skos:definition "The chapter says DictReader uses the first row as the keys of each dictionary and that DictWriter writes dictionaries when it is given the field names, and prints a list of the rows as dictionaries (Sweigart, 2025). The Python documentation describes restkey, restval, extrasaction and the dict rows that replaced OrderedDict in Python 3.8 (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_DictReadersWriters> ;
    sen0414:anchor "#s-DictReadersWriters" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:CsvModule .
pg:Page ipo:coversChapterSection pg:DictReadersWriters .
pg:DictReaderFirstRowKeys a ipo:ChapterSection ; rdfs:label "Dict reader first row keys"@en ;
    skos:definition "The chapter says DictReader treats the values in the first row as keys, that it skips the header for you, that without headers the first row would become the keys, and that a second argument can supply made-up names such as time, name and amount (Sweigart, 2025). The documentation adds that rows are dicts since Python 3.8 (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_DictReaderFirstRowKeys> ;
    sen0414:anchor "#s-DictReaderFirstRowKeys" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:DictReadersWriters .
pg:Page ipo:coversChapterSection pg:DictReaderFirstRowKeys .
pg:RestkeyRestval a ipo:ChapterSection ; rdfs:label "Restkey restval"@en ;
    skos:definition "The chapter does not mention restkey or restval (Sweigart, 2025). The documentation says that if a row has more fields than fieldnames the remaining data goes in a list under restkey, which defaults to None, and that a shorter row is filled with restval, which defaults to None (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_RestkeyRestval> ;
    sen0414:anchor "#s-RestkeyRestval" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:DictReadersWriters .
pg:Page ipo:coversChapterSection pg:RestkeyRestval .
pg:DictWriterExtraKey a ipo:ChapterSection ; rdfs:label "Dict writer extra key"@en ;
    skos:definition "The chapter writes a header with writeheader(), prints return values 16, 20, 15 and 20, and says a key missing from a dictionary becomes an empty cell and that the order of keys in a dictionary does not matter (Sweigart, 2025). The documentation says a key that is not in fieldnames raises ValueError unless extrasaction is 'ignore' (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_DictWriterExtraKey> ;
    sen0414:anchor "#s-DictWriterExtraKey" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:DictReadersWriters .
pg:Page ipo:coversChapterSection pg:DictWriterExtraKey .
pg:CsvLimits a ipo:ChapterSection ; rdfs:label "Csv limits"@en ;
    skos:definition "The chapter does not mention a limit of the reader or the modes added in later releases of Python (Sweigart, 2025). The Python documentation gives field_size_limit() with a default of 131,072 and says QUOTE_NOTNULL and QUOTE_STRINGS were added in Python 3.12 (Python Software Foundation, 2026)(Python Software Foundation, 2026, What's New)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_CsvLimits> ;
    sen0414:anchor "#s-CsvLimits" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:CsvModule .
pg:Page ipo:coversChapterSection pg:CsvLimits .
pg:FieldSizeLimit a ipo:ChapterSection ; rdfs:label "Field size limit"@en ;
    skos:definition "The chapter does not mention a limit on the size of a field (Sweigart, 2025). The documentation says field_size_limit() returns the current maximum field size the parser allows and that a field larger than it raises Error (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_FieldSizeLimit> ;
    sen0414:anchor "#s-FieldSizeLimit" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvLimits .
pg:Page ipo:coversChapterSection pg:FieldSizeLimit .
pg:QuoteStringsNotNull a ipo:ChapterSection ; rdfs:label "Quote strings not null"@en ;
    skos:definition "The chapter's reader treats an unquoted empty field and a quoted empty field the same (Sweigart, 2025). Python 3.12 added QUOTE_NOTNULL and QUOTE_STRINGS so that a reader and a writer can tell None from an empty string (Python Software Foundation, 2026)(Python Software Foundation, 2026, What's New)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_QuoteStringsNotNull> ;
    sen0414:anchor "#s-QuoteStringsNotNull" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CsvLimits .
pg:Page ipo:coversChapterSection pg:QuoteStringsNotNull .
pg:JsonFormat a ipo:ChapterSection ; rdfs:label "Json format"@en ;
    skos:definition "The chapter says JSON is a text format with the six value types string, number, object, array, Boolean and null, written with double quotes and no trailing commas, and that the json module converts between JSON text and Python data with json.loads() and json.dumps() (Sweigart, 2025). RFC 8259 and ECMA-404 define the syntax and the Python documentation describes what the module accepts beyond it (Bray, 2017)(Ecma International, 2017)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_JsonFormat> ;
    sen0414:anchor "#s-JsonFormat" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:JsonFormat .
pg:JsonSyntax a ipo:ChapterSection ; rdfs:label "Json syntax"@en ;
    skos:definition "The chapter lists the six value types of JSON and says the format does not allow trailing commas, comments or single quotes, with an invalid list as its example (Sweigart, 2025). RFC 8259 states the grammar of the six types and says implementations may accept more than the grammar, and the Python module does (Bray, 2017)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_JsonSyntax> ;
    sen0414:anchor "#s-JsonSyntax" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:JsonFormat .
pg:Page ipo:coversChapterSection pg:JsonSyntax .
pg:SixValueTypes a ipo:ChapterSection ; rdfs:label "Six value types"@en ;
    skos:definition "The chapter says JSON uses curly brackets for objects and square brackets for arrays, null for None, lowercase true and false, and that json.loads() returns a Python dictionary from a string whose strings use double quotes (Sweigart, 2025). RFC 8259 names six value types: object, array, number, string and the three literals false, null and true (Bray, 2017)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_SixValueTypes> ;
    sen0414:anchor "#s-SixValueTypes" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonSyntax .
pg:Page ipo:coversChapterSection pg:SixValueTypes .
pg:TrailingCommaRefused a ipo:ChapterSection ; rdfs:label "Trailing comma refused"@en ;
    skos:definition "The chapter says JSON does not allow JavaScript comments or multiline strings, that all strings must use double quotes and that ['spam', 'eggs'] is valid and ['spam', 'eggs',] is not (Sweigart, 2025). The RFC grammar has no trailing comma, comment or single-quoted string (Bray, 2017)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_TrailingCommaRefused> ;
    sen0414:anchor "#s-TrailingCommaRefused" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonSyntax .
pg:Page ipo:coversChapterSection pg:TrailingCommaRefused .
pg:RawNewlineInString a ipo:ChapterSection ; rdfs:label "Raw newline in string"@en ;
    skos:definition "The chapter says JSON does not allow multiline strings (Sweigart, 2025). RFC 8259 says control characters, U+0000 to U+001F, must be escaped inside a string, and the Python documentation describes the strict argument that allows them (Bray, 2017)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_RawNewlineInString> ;
    sen0414:anchor "#s-RawNewlineInString" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonSyntax .
pg:Page ipo:coversChapterSection pg:RawNewlineInString .
pg:NaNAcceptedByPython a ipo:ChapterSection ; rdfs:label "Na n accepted by python"@en ;
    skos:definition "The chapter does not mention NaN or Infinity (Sweigart, 2025). RFC 8259 says numeric values that cannot be represented in the grammar, such as Infinity and NaN, are not permitted, and the Python documentation says the module by default writes and reads them as JavaScript does (Bray, 2017)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_NaNAcceptedByPython> ;
    sen0414:anchor "#s-NaNAcceptedByPython" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonSyntax .
pg:Page ipo:coversChapterSection pg:NaNAcceptedByPython .
pg:JsonTypes a ipo:ChapterSection ; rdfs:label "Json types"@en ;
    skos:definition "The chapter says JSON represents a Python dictionary as an object, a list as an array, None as null and True and False as true and false, and does not list what JSON cannot hold (Sweigart, 2025). The Python documentation has a conversion table that maps tuples to arrays and says keys are coerced to strings and that other types need a default function (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_JsonTypes> ;
    sen0414:anchor "#s-JsonTypes" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:JsonFormat .
pg:Page ipo:coversChapterSection pg:JsonTypes .
pg:TupleBecomesList a ipo:ChapterSection ; rdfs:label "Tuple becomes list"@en ;
    skos:definition "The chapter says the value passed to json.dumps() can consist only of strings, integers, floats, Booleans, lists, dictionaries and NoneType (Sweigart, 2025). The Python documentation's conversion table writes a tuple as an array and reads an array as a list (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_TupleBecomesList> ;
    sen0414:anchor "#s-TupleBecomesList" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonTypes .
pg:Page ipo:coversChapterSection pg:TupleBecomesList .
pg:KeysBecomeStrings a ipo:ChapterSection ; rdfs:label "Keys become strings"@en ;
    skos:definition "The chapter says Python dictionaries and JSON objects both hold key-value pairs (Sweigart, 2025). RFC 8259 says the name of an object member is a string, and the Python documentation says that when a dictionary is converted into JSON all its keys are converted to strings (Bray, 2017)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_KeysBecomeStrings> ;
    sen0414:anchor "#s-KeysBecomeStrings" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonTypes .
pg:Page ipo:coversChapterSection pg:KeysBecomeStrings .
pg:UnsupportedTypesRaise a ipo:ChapterSection ; rdfs:label "Unsupported types raise"@en ;
    skos:definition "The chapter says JSON cannot represent Python-specific objects such as File objects and CSV reader or writer objects (Sweigart, 2025). The Python documentation says an object that is not serializable raises TypeError unless a default function is given (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_UnsupportedTypesRaise> ;
    sen0414:anchor "#s-UnsupportedTypesRaise" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonTypes .
pg:Page ipo:coversChapterSection pg:UnsupportedTypesRaise .
pg:JsonFiles a ipo:ChapterSection ; rdfs:label "Json files"@en ;
    skos:definition "The chapter shows json.loads() and json.dumps() on strings and says dumps() takes an indent argument for readable output, but not how to read or write a file (Sweigart, 2025). The Python documentation describes json.load() and json.dump() for file objects, the ensure_ascii argument, the byte order mark rule of RFC 8259 and, in 3.14, notes on serialization errors (Python Software Foundation, 2026)(Bray, 2017)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_JsonFiles> ;
    sen0414:anchor "#s-JsonFiles" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:JsonFormat .
pg:Page ipo:coversChapterSection pg:JsonFiles .
pg:IndentAndSeparators a ipo:ChapterSection ; rdfs:label "Indent and separators"@en ;
    skos:definition "The chapter writes the Alice data with json.dumps(python_data, indent=2) and says the text is then in separate lines with two spaces of indentation per nesting level, and that the compact form is fine between programs (Sweigart, 2025). The documentation describes indent, separators and sort_keys (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_IndentAndSeparators> ;
    sen0414:anchor "#s-IndentAndSeparators" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonFiles .
pg:Page ipo:coversChapterSection pg:IndentAndSeparators .
pg:EnsureAscii a ipo:ChapterSection ; rdfs:label "Ensure ascii"@en ;
    skos:definition "The chapter does not say that dumps() escapes non-ASCII characters (Sweigart, 2025). The Python documentation says that with ensure_ascii true, the default, the output has all incoming non-ASCII characters escaped (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_EnsureAscii> ;
    sen0414:anchor "#s-EnsureAscii" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonFiles .
pg:Page ipo:coversChapterSection pg:EnsureAscii .
pg:FileRoundTrip a ipo:ChapterSection ; rdfs:label "File round trip"@en ;
    skos:definition "The chapter says that once you have the JSON text as a string you can write it to a .json file, and it shows no file call (Sweigart, 2025). The Python documentation describes json.dump() and json.load() for file objects and says json.loads() takes a string, bytes or bytearray (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_FileRoundTrip> ;
    sen0414:anchor "#s-FileRoundTrip" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonFiles .
pg:Page ipo:coversChapterSection pg:FileRoundTrip .
pg:BomHandling a ipo:ChapterSection ; rdfs:label "Bom handling"@en ;
    skos:definition "The chapter does not mention encodings of JSON text (Sweigart, 2025). RFC 8259 says JSON exchanged between systems must be encoded in UTF-8, that implementations must not add a byte order mark and that parsers may ignore one (Bray, 2017)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_BomHandling> ;
    sen0414:anchor "#s-BomHandling" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonFiles .
pg:Page ipo:coversChapterSection pg:BomHandling .
pg:SerializationErrorNotes a ipo:ChapterSection ; rdfs:label "Serialization error notes"@en ;
    skos:definition "The chapter does not show a serialization error (Sweigart, 2025). Python 3.14 adds exception notes to JSON serialization errors that identify the source of the error, and allows python -m json (Python Software Foundation, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_SerializationErrorNotes> ;
    sen0414:anchor "#s-SerializationErrorNotes" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:JsonFiles .
pg:Page ipo:coversChapterSection pg:SerializationErrorNotes .
pg:XmlFormat a ipo:ChapterSection ; rdfs:label "Xml format"@en ;
    skos:definition "The chapter says XML stores data in nested elements between opening and closing tags, that a valid document must have a single root element and a document with several roots is not valid, that all text is a string, that whitespace outside the tags is insignificant and that names can be written in any case but are lowercase by convention (Sweigart, 2025). The W3C Recommendation calls a document that obeys its syntax rules well-formed and one that also complies with its document type declaration valid, and requires an end-tag to match its start-tag with no case folding (World Wide Web Consortium, 2008)(World Wide Web Consortium, 1998)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_XmlFormat> ;
    sen0414:anchor "#s-XmlFormat" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:XmlFormat .
pg:XmlSyntax a ipo:ChapterSection ; rdfs:label "Xml syntax"@en ;
    skos:definition "The chapter says a valid document must have a single root element, that names can be written in any case, that attribute values may be in single or double quotes and that whitespace outside the tags is insignificant (Sweigart, 2025). The W3C Recommendation uses well-formed for the syntax rules and valid for compliance with a document type declaration, and says the Name in an end-tag must match the element type in the start-tag (World Wide Web Consortium, 2008)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_XmlSyntax> ;
    sen0414:anchor "#s-XmlSyntax" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:XmlFormat .
pg:Page ipo:coversChapterSection pg:XmlSyntax .
pg:CaseSensitiveTags a ipo:ChapterSection ; rdfs:label "Case sensitive tags"@en ;
    skos:definition "The chapter says tag and attribute names can be written in any case but are lowercase by convention, and that each element has an opening and a closing tag (Sweigart, 2025). The W3C Recommendation says the Name in an element's end-tag must match the element type in the start-tag and that no case folding is performed (World Wide Web Consortium, 2008)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_CaseSensitiveTags> ;
    sen0414:anchor "#s-CaseSensitiveTags" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlSyntax .
pg:Page ipo:coversChapterSection pg:CaseSensitiveTags .
pg:AttributeQuotesRequired a ipo:ChapterSection ; rdfs:label "Attribute quotes required"@en ;
    skos:definition "The chapter says attributes are key-value pairs written as key='value' inside the opening tag and that values can be in single or double quotes, but double quotes are standard (Sweigart, 2025). XML requires a quoted value, unlike HTML, which allows an unquoted one (World Wide Web Consortium, 2008)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_AttributeQuotesRequired> ;
    sen0414:anchor "#s-AttributeQuotesRequired" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlSyntax .
pg:Page ipo:coversChapterSection pg:AttributeQuotesRequired .
pg:SingleRootRequired a ipo:ChapterSection ; rdfs:label "Single root required"@en ;
    skos:definition "The chapter says valid XML documents must have a single root element that contains all the others, and that a document with several roots, such as three person elements one after the other, is not valid (Sweigart, 2025). The W3C Recommendation requires a well-formed document to have one element that contains all the others, the root (World Wide Web Consortium, 2008)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_SingleRootRequired> ;
    sen0414:anchor "#s-SingleRootRequired" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlSyntax .
pg:Page ipo:coversChapterSection pg:SingleRootRequired .
pg:EscapesRequired a ipo:ChapterSection ; rdfs:label "Escapes required"@en ;
    skos:definition "The chapter does not say how to write an ampersand or a less-than sign in text, and says the comments of XML are identical to HTML's (Sweigart, 2025). The W3C Recommendation says the characters < and & must be escaped as &lt; and &amp; and defines only five entities, so an HTML entity like &nbsp; is not defined (World Wide Web Consortium, 2008)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_EscapesRequired> ;
    sen0414:anchor "#s-EscapesRequired" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlSyntax .
pg:Page ipo:coversChapterSection pg:EscapesRequired .
pg:WellFormedNotValid a ipo:ChapterSection ; rdfs:label "Well formed not valid"@en ;
    skos:definition "The chapter calls a document with several roots not valid (Sweigart, 2025). The W3C Recommendation defines a well-formed document by its syntax and a valid document as one with a document type declaration that it complies with (World Wide Web Consortium, 2008)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_WellFormedNotValid> ;
    sen0414:anchor "#s-WellFormedNotValid" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlSyntax .
pg:Page ipo:coversChapterSection pg:WellFormedNotValid .
pg:XmlNamespaces a ipo:ChapterSection ; rdfs:label "Xml namespaces"@en ;
    skos:definition "The chapter's person has a car element with the attribute xsi:nil='true' and the namespace attribute xmlns:xsi, and says a self-closing tag has None as its text (Sweigart, 2025). Namespaces in XML says a name with a prefix belongs to the namespace that the prefix is bound to, and XML Schema says an element labeled xsi:nil true must be empty (World Wide Web Consortium, 2009)(World Wide Web Consortium, 2004)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_XmlNamespaces> ;
    sen0414:anchor "#s-XmlNamespaces" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:XmlFormat .
pg:Page ipo:coversChapterSection pg:XmlNamespaces .
pg:NamespaceClarkName a ipo:ChapterSection ; rdfs:label "Namespace clark name"@en ;
    skos:definition "The chapter writes xmlns:xsi as an ordinary attribute and does not explain namespaces (Sweigart, 2025). Namespaces in XML binds a prefix to a namespace name with a xmlns attribute, and ElementTree names a qualified element {namespace}local (World Wide Web Consortium, 2009)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_NamespaceClarkName> ;
    sen0414:anchor "#s-NamespaceClarkName" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlNamespaces .
pg:Page ipo:coversChapterSection pg:NamespaceClarkName .
pg:XsiNilNotUnderstood a ipo:ChapterSection ; rdfs:label "Xsi nil not understood"@en ;
    skos:definition "The chapter says there is no null value in XML but one can be approximated with xsi:nil='true' and xmlns:xsi, and that a self-closing tag has None as its text (Sweigart, 2025). XML Schema says an element labeled xsi:nil true must be empty, and it is a schema processor that acts on the attribute (World Wide Web Consortium, 2004)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_XsiNilNotUnderstood> ;
    sen0414:anchor "#s-XsiNilNotUnderstood" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlNamespaces .
pg:Page ipo:coversChapterSection pg:XsiNilNotUnderstood .
pg:XmlSecurity a ipo:ChapterSection ; rdfs:label "Xml security"@en ;
    skos:definition "The chapter parses XML text with ET.fromstring() and xmltodict.parse() and gives no warning about untrusted input (Sweigart, 2025). The Python documentation says the built-in XML parsers rely on Expat, that versions lower than 2.7.2 may be vulnerable to billion laughs, quadratic blowup and large tokens, and CWE lists entity expansion and external entities as weaknesses (Python Software Foundation, 2026)(MITRE, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_XmlSecurity> ;
    sen0414:anchor "#s-XmlSecurity" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:XmlFormat .
pg:Page ipo:coversChapterSection pg:XmlSecurity .
pg:BillionLaughsLimit a ipo:ChapterSection ; rdfs:label "Billion laughs limit"@en ;
    skos:definition "The chapter does not warn about entity expansion (Sweigart, 2025). The Python documentation describes the billion laughs attack as multiple levels of nested entities that each refer to another several times, and Wikipedia gives the example of 10 entities, each of 10 of the previous one, expanding to a billion lol (Python Software Foundation, 2026)(Wikipedia, 2026)(MITRE, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_BillionLaughsLimit> ;
    sen0414:anchor "#s-BillionLaughsLimit" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlSecurity .
pg:Page ipo:coversChapterSection pg:BillionLaughsLimit .
pg:ExternalEntityNotFetched a ipo:ChapterSection ; rdfs:label "External entity not fetched"@en ;
    skos:definition "The chapter does not warn about external entities (Sweigart, 2025). CWE-611 names the weakness of an XML document that references an external entity and OWASP describes the attack that reads local files, and the Python documentation says Expat itself does not by default access local files or create network connections (MITRE, 2026)(OWASP, 2026)(Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ExternalEntityNotFetched> ;
    sen0414:anchor "#s-ExternalEntityNotFetched" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlSecurity .
pg:Page ipo:coversChapterSection pg:ExternalEntityNotFetched .
pg:DefusedxmlForbids a ipo:ChapterSection ; rdfs:label "Defusedxml forbids"@en ;
    skos:definition "The chapter does not mention defusedxml (Sweigart, 2025). The PyPI page of defusedxml says it defuses XML bombs and other exploits and lists denial-of-service workarounds for Python's XML libraries (Python Package Index, 2026)(defusedxml contributors, 2021)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_DefusedxmlForbids> ;
    sen0414:anchor "#s-DefusedxmlForbids" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlSecurity .
pg:Page ipo:coversChapterSection pg:DefusedxmlForbids .
pg:XmltodictEntitiesDisabled a ipo:ChapterSection ; rdfs:label "Xmltodict entities disabled"@en ;
    skos:definition "The chapter installs xmltodict by Appendix A, which pins version 0.13.0, and calls xmltodict.parse() on text (Sweigart, 2025)(Sweigart, 2025, Appendix A). The PyPI page lists xmltodict 1.0.4 as the newest release (Python Package Index, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_XmltodictEntitiesDisabled> ;
    sen0414:anchor "#s-XmltodictEntitiesDisabled" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmlSecurity .
pg:Page ipo:coversChapterSection pg:XmltodictEntitiesDisabled .
pg:XmlLibraries a ipo:ChapterSection ; rdfs:label "Xml libraries"@en ;
    skos:definition "The second half of the XML section teaches xml.etree.ElementTree: ET.fromstring() and ET.parse() give an Element whose tag, text and children can be read, Element and SubElement build a tree, set() adds an attribute and ET.tostring() writes it, and the third-party xmltodict turns XML into a Python dictionary (Sweigart, 2025)(Python Software Foundation, 2026). The chapter describes the DOM and SAX approaches in a paragraph and uses ElementTree to read the whole document at once (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_XmlLibraries> ;
    sen0414:anchor "#s-XmlLibraries" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:XmlLibraries .
pg:ElementTreeReading a ipo:ChapterSection ; rdfs:label "Element tree reading"@en ;
    skos:definition "The chapter reads XML with ET.fromstring() or ET.parse() and getroot(), then uses the tag and text attributes, indexes into an element, loops over its children and calls iter() with and without a tag name, and says XPath can locate elements (Sweigart, 2025). The Python documentation describes the same Element, the order of iter() and a limited XPath (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ElementTreeReading> ;
    sen0414:anchor "#s-ElementTreeReading" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:XmlLibraries .
pg:Page ipo:coversChapterSection pg:ElementTreeReading .
pg:RootTagAndChildren a ipo:ChapterSection ; rdfs:label "Root tag and children"@en ;
    skos:definition "The chapter parses the xml_string with ET.fromstring(), calls the Element root, and reads root.tag, root.text, list(root), root[0] and root[4][0], and says the children are reachable through an integer index like a list (Sweigart, 2025). The Python documentation shows children nested and reached by index, as in root[0][1].text (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_RootTagAndChildren> ;
    sen0414:anchor "#s-RootTagAndChildren" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ElementTreeReading .
pg:Page ipo:coversChapterSection pg:RootTagAndChildren .
pg:TextNoneOrString a ipo:ChapterSection ; rdfs:label "Text none or string"@en ;
    skos:definition "The chapter says any self-closing tag, like <car/>, will use None for its text attribute, and that XML text has no data type so everything between the tags is a string (Sweigart, 2025). The documentation says text is the text up to the first child or None and gives <a><b>1<c>2<d/>3</c></b>4</a>, where a has None for both text and tail (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_TextNoneOrString> ;
    sen0414:anchor "#s-TextNoneOrString" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ElementTreeReading .
pg:Page ipo:coversChapterSection pg:TextNoneOrString .
pg:ParentTextIsWhitespace a ipo:ChapterSection ; rdfs:label "Parent text is whitespace"@en ;
    skos:definition "The chapter prints None for the text of address and phone in a loop over the root's children, and says whitespace outside the opening and closing tags is insignificant (Sweigart, 2025). The documentation says the tail is the text between the element's end tag and the next tag, or None (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ParentTextIsWhitespace> ;
    sen0414:anchor "#s-ParentTextIsWhitespace" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ElementTreeReading .
pg:Page ipo:coversChapterSection pg:ParentTextIsWhitespace .
pg:IterDocumentOrder a ipo:ChapterSection ; rdfs:label "Iter document order"@en ;
    skos:definition "The chapter loops over the immediate children with for elem in root, and calls root.iter() to iterate over everything underneath and root.iter('number') to filter by tag (Sweigart, 2025). The documentation says iter() walks the element and all its descendants in document order, the element itself first (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_IterDocumentOrder> ;
    sen0414:anchor "#s-IterDocumentOrder" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ElementTreeReading .
pg:Page ipo:coversChapterSection pg:IterDocumentOrder .
pg:FindAndXPathSubset a ipo:ChapterSection ; rdfs:label "Find and x path subset"@en ;
    skos:definition "The chapter says a language called XPath can locate elements in an XML document and that this is beyond the scope of the chapter (Sweigart, 2025). The documentation says the module provides limited support for XPath expressions, a small subset of the abbreviated syntax (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_FindAndXPathSubset> ;
    sen0414:anchor "#s-FindAndXPathSubset" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ElementTreeReading .
pg:Page ipo:coversChapterSection pg:FindAndXPathSubset .
pg:ElementTruthDeprecated a ipo:ChapterSection ; rdfs:label "Element truth deprecated"@en ;
    skos:definition "The chapter tests an element's text against None and does not test an element itself (Sweigart, 2025). The documentation says testing the truth value of an Element emits DeprecationWarning since Python 3.12 and will always return True in a future release (Python Software Foundation, 2026)(Python Software Foundation, 2026, What's New)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ElementTruthDeprecated> ;
    sen0414:anchor "#s-ElementTruthDeprecated" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ElementTreeReading .
pg:Page ipo:coversChapterSection pg:ElementTruthDeprecated .
pg:ElementTreeWriting a ipo:ChapterSection ; rdfs:label "Element tree writing"@en ;
    skos:definition "The chapter builds XML with ET.Element(), ET.SubElement() and set(), sets the text attribute and calls ET.tostring(root, encoding='utf-8').decode('utf-8') to get a string (Sweigart, 2025). The Python documentation describes tostring with its encoding, xml_declaration and short_empty_elements parameters and ET.indent() (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ElementTreeWriting> ;
    sen0414:anchor "#s-ElementTreeWriting" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:XmlLibraries .
pg:Page ipo:coversChapterSection pg:ElementTreeWriting .
pg:SubElementAndSet a ipo:ChapterSection ; rdfs:label "Sub element and set"@en ;
    skos:definition "The chapter creates the person Element, adds children with SubElement(), sets the text attribute and sets xsi:nil and xmlns:xsi with set(), and calls ET.tostring(root, encoding='utf-8').decode('utf-8') (Sweigart, 2025). It says tostring() returns bytes and that decode() is needed to get a string (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_SubElementAndSet> ;
    sen0414:anchor "#s-SubElementAndSet" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ElementTreeWriting .
pg:Page ipo:coversChapterSection pg:SubElementAndSet .
pg:TostringSpaceBeforeSlash a ipo:ChapterSection ; rdfs:label "Tostring space before slash"@en ;
    skos:definition "The chapter prints the string with the car element ending in a slash and a closing bracket (Sweigart, 2025). The documentation says the short_empty_elements parameter chooses between a self-closing tag and an empty pair, and that an encoding of unicode returns a str (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_TostringSpaceBeforeSlash> ;
    sen0414:anchor "#s-TostringSpaceBeforeSlash" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ElementTreeWriting .
pg:Page ipo:coversChapterSection pg:TostringSpaceBeforeSlash .
pg:IndentPrettyPrint a ipo:ChapterSection ; rdfs:label "Indent pretty print"@en ;
    skos:definition "The chapter does not pretty-print XML (Sweigart, 2025). The documentation says ET.indent(tree, space, level) appends whitespace to the subtree to indent it visually and was added in Python 3.9 (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_IndentPrettyPrint> ;
    sen0414:anchor "#s-IndentPrettyPrint" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ElementTreeWriting .
pg:Page ipo:coversChapterSection pg:IndentPrettyPrint .
pg:XmltodictLibrary a ipo:ChapterSection ; rdfs:label "Xmltodict library"@en ;
    skos:definition "The chapter installs xmltodict, calls xmltodict.parse(xml_string) and prints a dictionary in which the namespace attribute of car is a key starting with an at sign and the phones are a list (Sweigart, 2025). The PyPI page says xmltodict makes working with XML feel like working with JSON, and Appendix A pins version 0.13.0 (Python Package Index, 2026)(Sweigart, 2025, Appendix A)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_XmltodictLibrary> ;
    sen0414:anchor "#s-XmltodictLibrary" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:XmlLibraries .
pg:Page ipo:coversChapterSection pg:XmltodictLibrary .
pg:ParseGivesStrings a ipo:ChapterSection ; rdfs:label "Parse gives strings"@en ;
    skos:definition "The chapter parses the same text with xmltodict.parse() and prints a dictionary, and says everything is a string, that programmer is the string true and that car is an awkward key-value pair instead of None (Sweigart, 2025). The PyPI page says xmltodict makes working with XML feel like working with JSON (Python Package Index, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ParseGivesStrings> ;
    sen0414:anchor "#s-ParseGivesStrings" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmltodictLibrary .
pg:Page ipo:coversChapterSection pg:ParseGivesStrings .
pg:OneEntryDictTwoList a ipo:ChapterSection ; rdfs:label "One entry dict two list"@en ;
    skos:definition "The chapter prints the phones as a list of dictionaries under phoneEntry and says to double-check the input and output of any XML module (Sweigart, 2025). The xmltodict documentation on PyPI describes the force_list option for elements that may occur once or many times (Python Package Index, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_OneEntryDictTwoList> ;
    sen0414:anchor "#s-OneEntryDictTwoList" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmltodictLibrary .
pg:Page ipo:coversChapterSection pg:OneEntryDictTwoList .
pg:UnparseRoundTrip a ipo:ChapterSection ; rdfs:label "Unparse round trip"@en ;
    skos:definition "The chapter shows xmltodict.parse() only (Sweigart, 2025). The xmltodict page says you can also convert in the other direction, using unparse() (Python Package Index, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_UnparseRoundTrip> ;
    sen0414:anchor "#s-UnparseRoundTrip" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:XmltodictLibrary .
pg:Page ipo:coversChapterSection pg:UnparseRoundTrip .
pg:OtherParsers a ipo:ChapterSection ; rdfs:label "Other parsers"@en ;
    skos:definition "The chapter describes the DOM approach, which reads the entire document into memory, and the SAX approach, which reads a stream of elements, names the modules xml.dom, xml.sax and xml.etree.ElementTree, and uses ElementTree for its examples (Sweigart, 2025). The Python documentation describes xml.dom.minidom as a minimal DOM implementation, xml.sax as event-driven and ElementTree.iterparse() as incremental parsing (Python Software Foundation, 2026)(Python Software Foundation, 2026, minidom)(Python Software Foundation, 2026, sax)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_OtherParsers> ;
    sen0414:anchor "#s-OtherParsers" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:XmlLibraries .
pg:Page ipo:coversChapterSection pg:OtherParsers .
pg:MinidomSameAnswer a ipo:ChapterSection ; rdfs:label "Minidom same answer"@en ;
    skos:definition "The chapter says the DOM approach reads the whole document into memory and names the xml.dom module (Sweigart, 2025). The documentation says xml.dom.minidom is a minimal implementation of the Document Object Model interface (Python Software Foundation, 2026, minidom)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_MinidomSameAnswer> ;
    sen0414:anchor "#s-MinidomSameAnswer" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OtherParsers .
pg:Page ipo:coversChapterSection pg:MinidomSameAnswer .
pg:IterparseClear a ipo:ChapterSection ; rdfs:label "Iterparse clear"@en ;
    skos:definition "The chapter says the SAX approach reads a stream of elements and is ideal for gigabyte-sized documents, and does not mention iterparse (Sweigart, 2025). The documentation says ElementTree builds the tree incrementally but does not free it, and that clear() on an element frees memory while iterparse is used (Python Software Foundation, 2026)(Python Software Foundation, 2026, sax)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_IterparseClear> ;
    sen0414:anchor "#s-IterparseClear" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:OtherParsers .
pg:Page ipo:coversChapterSection pg:IterparseClear .
pg:BookAndPractice a ipo:ChapterSection ; rdfs:label "Book and practice"@en ;
    skos:definition "The chapter ends with Project 13, which removes the header row from every CSV file of a folder in three steps, a summary, eleven practice questions with their answers in Appendix B and a practice program that converts Excel files to CSV with openpyxl (Sweigart, 2025)(Sweigart, 2025, Appendix B). The online materials ship the files the projects use (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_BookAndPractice> ;
    sen0414:anchor "#s-BookAndPractice" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:BookAndPractice .
pg:ChapterAccuracy a ipo:ChapterSection ; rdfs:label "Chapter accuracy"@en ;
    skos:definition "A listing of a book is a statement that a reader will type and compare with the output printed beside it; the chapter prints 97 interactive statements, and a reader who types them in the order of the page gets the printed output only if the page, the files and the Python release agree (Sweigart, 2025). The online materials were meant to supply the files (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ChapterAccuracy> ;
    sen0414:anchor "#s-ChapterAccuracy" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BookAndPractice .
pg:Page ipo:coversChapterSection pg:ChapterAccuracy .
pg:CurlyQuoteBreaksLiteral a ipo:ChapterSection ; rdfs:label "Curly quote breaks literal"@en ;
    skos:definition "The chapter prints two xml_string listings whose namespace URL ends with a curly closing quotation mark, and prints json_string over several lines inside its quotes (Sweigart, 2025). A Python string literal in single or double quotes cannot span lines, and an XML parser needs a straight quotation mark to close an attribute value (Python Software Foundation, 2026)(World Wide Web Consortium, 2008)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_CurlyQuoteBreaksLiteral> ;
    sen0414:anchor "#s-CurlyQuoteBreaksLiteral" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ChapterAccuracy .
pg:Page ipo:coversChapterSection pg:CurlyQuoteBreaksLiteral .
pg:PrintedNoneVsWhitespace a ipo:ChapterSection ; rdfs:label "Printed none vs whitespace"@en ;
    skos:definition "The chapter prints None as the text of address and phone in the loop over the root's children and in the loop over iter(), and prints car -- None (Sweigart, 2025). That holds for the compact xml_string, and the chapter parses my_data.xml in the statement before it and rebinds root (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_PrintedNoneVsWhitespace> ;
    sen0414:anchor "#s-PrintedNoneVsWhitespace" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ChapterAccuracy .
pg:Page ipo:coversChapterSection pg:PrintedNoneVsWhitespace .
pg:Project13 a ipo:ChapterSection ; rdfs:label "Project13"@en ;
    skos:definition "Project 13 removes the header row from every CSV file of the working directory in three steps: loop through the files that end in .csv, read each with csv.reader() and skip the first row, and write the other rows to a new file in a folder called headerRemoved (Sweigart, 2025). The online materials ship removeCsvHeader.py and a zip of 100 CSV files to run it on (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_Project13> ;
    sen0414:anchor "#s-Project13" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BookAndPractice .
pg:Page ipo:coversChapterSection pg:Project13 .
pg:SkipHeaderWithNext a ipo:ChapterSection ; rdfs:label "Skip header with next"@en ;
    skos:definition "Project 13 skips the first row with an if on line_num and a continue (Sweigart, 2025). The Python documentation describes the reader as an iterator, so the built-in next() gives its next row (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_SkipHeaderWithNext> ;
    sen0414:anchor "#s-SkipHeaderWithNext" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Project13 .
pg:Page ipo:coversChapterSection pg:SkipHeaderWithNext .
pg:EmptyAndHeaderOnly a ipo:ChapterSection ; rdfs:label "Empty and header only"@en ;
    skos:definition "Project 13 reads each file into csv_rows, writes the rows to a file in headerRemoved and opens every name that ends with .csv, and the shipped removeCsvHeader.py does the same (Sweigart, 2025). The online materials ship 100 CSV files with one-line headers (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_EmptyAndHeaderOnly> ;
    sen0414:anchor "#s-EmptyAndHeaderOnly" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Project13 .
pg:Page ipo:coversChapterSection pg:EmptyAndHeaderOnly .
pg:ExcelToCsv a ipo:ChapterSection ; rdfs:label "Excel to csv"@en ;
    skos:definition "The practice program asks for a program that reads every Excel file of the working directory with openpyxl and writes one CSV file per sheet, named for the file and the sheet, and gives a skeleton with nested loops over the rows and columns (Sweigart, 2025). The openpyxl documentation describes the library as reading and writing Excel 2010 xlsx files (openpyxl contributors, 2024)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_ExcelToCsv> ;
    sen0414:anchor "#s-ExcelToCsv" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BookAndPractice .
pg:Page ipo:coversChapterSection pg:ExcelToCsv .
pg:WorkbookCells a ipo:ChapterSection ; rdfs:label "Workbook cells"@en ;
    skos:definition "The practice program tells the reader to use openpyxl, load each workbook, loop over the sheet names and write one CSV per sheet named for the file and the sheet (Sweigart, 2025). The openpyxl documentation describes the library as reading and writing Excel 2010 xlsx files (openpyxl contributors, 2024)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_WorkbookCells> ;
    sen0414:anchor "#s-WorkbookCells" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExcelToCsv .
pg:Page ipo:coversChapterSection pg:WorkbookCells .
pg:MaxColumnQuadratic a ipo:ChapterSection ; rdfs:label "Max column quadratic"@en ;
    skos:definition "The practice program's skeleton loops for row_num in range(1, sheet.max_row + 1) and, inside it, for col_num in range(1, sheet.max_column + 1) (Sweigart, 2025). In openpyxl 3.1.5 the docstring of max_column says the maximum column index containing data and the code takes the maximum over every cell of the sheet on each call (This study, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_MaxColumnQuadratic> ;
    sen0414:anchor "#s-MaxColumnQuadratic" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ExcelToCsv .
pg:Page ipo:coversChapterSection pg:MaxColumnQuadratic .
pg:FormatChoice a ipo:ChapterSection ; rdfs:label "Format choice"@en ;
    skos:definition "The chapter's summary says CSV, JSON and XML are plaintext formats that can be edited in a text editor, that JSON is simpler than XML and more widely adopted than YAML, and that TOML is chiefly used for configuration (Sweigart, 2025). It names shelve as storing all Python data types in a binary file that other languages cannot read (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_FormatChoice> ;
    sen0414:anchor "#s-FormatChoice" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:BookAndPractice .
pg:Page ipo:coversChapterSection pg:FormatChoice .
pg:SizeComparison a ipo:ChapterSection ; rdfs:label "Size comparison"@en ;
    skos:definition "The chapter says the human-readable plaintext formats do not make the most efficient use of disk space or memory, and that XML is quite verbose compared to JSON (Sweigart, 2025). The Alice data of the chapter is written in each format (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_SizeComparison> ;
    sen0414:anchor "#s-SizeComparison" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FormatChoice .
pg:Page ipo:coversChapterSection pg:SizeComparison .
pg:TypesKept a ipo:ChapterSection ; rdfs:label "Types kept"@en ;
    skos:definition "The chapter says XML text has no data type, that CSV has no data types and every value is a string, that JSON keeps null and the Booleans, and that TOML is chiefly for configuration (Sweigart, 2025). The tomllib documentation says it parses TOML from a readable binary file and has no function to write (Python Software Foundation, 2026, tomllib)."@en ; dcterms:source <http://example.org/sen0414/ch18#S_TypesKept> ;
    sen0414:anchor "#s-TypesKept" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:FormatChoice .
pg:Page ipo:coversChapterSection pg:TypesKept .
