pg:CE_01 a ipo:CodeExample ; rdfs:label "Why not split on commas"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 7 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 1 ;
    sen0414:code "import csv\nline = 'Alice,30,'San Francisco, CA''\nprint('split:', line.split(','))\nprint('reader:', next(csv.reader([line])))\ntext = 'spam,eggs\\r\\nbacon,ham\\r\\n'\nrows = list(csv.reader(text.splitlines()))\nprint(len(rows), 'records of', len(rows[0]), 'fields')" ; sen0414:expectedOutput "split: ['Alice', '30', ''San Francisco', ' CA'']\nreader: ['Alice', '30', 'San Francisco, CA']\n2 records of 2 fields\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "reader and list()"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 8 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 2 ;
    sen0414:code "import csv, os, tempfile\nos.chdir(tempfile.mkdtemp())\nwith open('example.csv', 'w', newline='') as f:\n    f.write('Name,Age\\r\\nAlice,30\\r\\nBob,25\\r\\n')\nwith open('example.csv', encoding='utf-8', newline='') as f:\n    data = list(csv.reader(f))\nprint(data)\nprint(data[1][0], data[2][1])\nprint(type(data[1][1]).__name__)" ; sen0414:expectedOutput "[['Name', 'Age'], ['Alice', '30'], ['Bob', '25']]\nAlice 25\nstr\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "Reading in a for loop"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 9 of the deck and runs 8 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 9 ; sen0414:orderInTab 3 ;
    sen0414:code "import csv, io\ntext = 'Name,Note\\r\\nAlice,'two\\r\\nlines'\\r\\nBob,ok\\r\\n'\nf = io.StringIO(text, newline='')\nreader = csv.reader(f)\nfor row in reader:\n    print('Row #' + str(reader.line_num), row)\nprint('second pass:', list(reader))\nprint('has len:', hasattr(reader, '__len__'))" ; sen0414:expectedOutput "Row #1 ['Name', 'Note']\nRow #3 ['Alice', 'two\\r\\nlines']\nRow #4 ['Bob', 'ok']\nsecond pass: []\nhas len: False\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Handling header rows"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 10 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 4 ;
    sen0414:code "import csv, io\ntext = 'Name,Age\\r\\nAlice,30\\r\\nBob,25\\r\\n'\nreader = csv.reader(io.StringIO(text, newline=''))\nheader = next(reader)\nprint('header:', header)\nprint('rest:', list(reader))\ntricky = ''Name\\r\\n(first)',Age\\r\\nAlice,30\\r\\n'\nreader = csv.reader(io.StringIO(tricky, newline=''))\nprint([r for r in reader if reader.line_num != 1])" ; sen0414:expectedOutput "header: ['Name', 'Age']\nrest: [['Alice', '30'], ['Bob', '25']]\n[['Name\\r\\n(first)', 'Age'], ['Alice', '30']]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "writer and writerow()"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 14 of the deck and runs 7 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 5 ;
    sen0414:code "import csv, io\nout = io.StringIO(newline='')\nwriter = csv.writer(out)\nprint(writer.writerow(['spam', 'eggs', 'bacon', 'ham']))\nprint(writer.writerow(['Hello, world!', 'eggs', 'bacon', 'ham']))\nprint(writer.writerow([1, 3.141592, None, '', True]))\nprint(out.getvalue().encode())" ; sen0414:expectedOutput "21\n32\n19\nb'spam,eggs,bacon,ham\\r\\n'Hello, world!',eggs,bacon,ham\\r\\n1,3.141592,,,True\\r\\n'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Tabs instead of commas"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 15 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 15 ; sen0414:orderInTab 6 ;
    sen0414:code "import csv, io\nout = io.StringIO(newline='')\nw = csv.writer(out, delimiter='\\t', lineterminator='\\n')\nw.writerow(['apples', 8, 'two words'])\nw.writerows([['cats', 3, 'x'], ['dogs', 5, 'y']])\nprint(out.getvalue().encode())\nback = list(csv.reader(io.StringIO(out.getvalue()), delimiter='\\t'))\nprint(back)" ; sen0414:expectedOutput "b'apples\\t8\\ttwo words\\ncats\\t3\\tx\\ndogs\\t5\\ty\\n'\n[['apples', '8', 'two words'], ['cats', '3', 'x'], ['dogs', '5', 'y']]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "newline='' and the double-spaced file"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 16 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 7 ;
    sen0414:code "import csv, io\nrows = [['a', 'b'], ['c', 'd']]\ndef write(nl):\n    buf = io.BytesIO()\n    t = io.TextIOWrapper(buf, newline=nl)\n    csv.writer(t).writerows(rows); t.flush()\n    return buf.getvalue()\nfor nl in ('', '\\r\\n'):\n    data = write(nl)\n    text = io.StringIO(data.decode(), newline='')\n    print(repr(nl), data, len(list(csv.reader(text))))" ; sen0414:expectedOutput "'' b'a,b\\r\\nc,d\\r\\n' 2\n'\\r\\n' b'a,b\\r\\r\\nc,d\\r\\r\\n' 4\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Quoting and the quoting constants"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 17 of the deck and runs 9 lines of Python that print 6 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 17 ; sen0414:orderInTab 8 ;
    sen0414:code "import csv, io\nrow = ['a b', 'c,d', 7, None, '']\ndef line(q):\n    s = io.StringIO(newline='')\n    csv.writer(s, quoting=q, escapechar='\\\\').writerow(row)\n    return s.getvalue()\nnames = ['QUOTE_MINIMAL', 'QUOTE_ALL', 'QUOTE_NONNUMERIC',\n         'QUOTE_NONE', 'QUOTE_STRINGS', 'QUOTE_NOTNULL']\nfor q in names: print(q, repr(line(getattr(csv, q))))" ; sen0414:expectedOutput "QUOTE_MINIMAL 'a b,'c,d',7,,\\r\\n'\nQUOTE_ALL ''a b','c,d','7','',''\\r\\n'\nQUOTE_NONNUMERIC ''a b','c,d',7,'',''\\r\\n'\nQUOTE_NONE 'a b,c\\\\,d,7,,\\r\\n'\nQUOTE_STRINGS ''a b','c,d',7,,''\\r\\n'\nQUOTE_NOTNULL ''a b','c,d','7',,''\\r\\n'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Encoding and the byte order mark"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 18 of the deck and runs 7 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 18 ; sen0414:orderInTab 9 ;
    sen0414:code "import csv, io\ndata = 'Name,City\\r\\nZoe,İstanbul\\r\\n'.encode('utf-8-sig')\nprint(data[:3], data[3:12])\nprint(repr(data.decode('utf-8').split('\\r\\n')[0]))\nprint(repr(data.decode('utf-8-sig').split('\\r\\n')[0]))\nrows = list(csv.DictReader(io.StringIO(data.decode('utf-8'), newline='')))\nprint(list(rows[0]))" ; sen0414:expectedOutput "b'\\xef\\xbb\\xbf' b'Name,City'\n'\\ufeffName,City'\n'Name,City'\n['\\ufeffName', 'City']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "DictReader and DictWriter"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 19 of the deck and runs 10 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 10 ;
    sen0414:code "import csv, io\ntext = 'Name,Age\\r\\nAlice,30\\r\\nBob\\r\\n'\nfor row in csv.DictReader(io.StringIO(text, newline='')):\n    print(dict(row))\nout = io.StringIO(newline='')\nw = csv.DictWriter(out, ['Name', 'Age'])\nw.writeheader()\nw.writerow({'Name': 'Dave', 'Age': 5})\nw.writerow({'Name': 'Eve'})\nprint(out.getvalue().splitlines())" ; sen0414:expectedOutput "{'Name': 'Alice', 'Age': '30'}\n{'Name': 'Bob', 'Age': None}\n['Name,Age', 'Dave,5', 'Eve,']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "Project 13, step 1: loop through the files"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 22 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 11 ;
    sen0414:code "import os, tempfile\nos.chdir(tempfile.mkdtemp())\nnames = ('b.csv', 'a.csv', 'notes.txt', 'C.CSV')\nfor name in names: open(name, 'w').close()\nfor csv_filename in sorted(os.listdir('.')):\n    if not csv_filename.endswith('.csv'):\n        continue\n    print('Removing header from ' + csv_filename + '...')" ; sen0414:expectedOutput "Removing header from a.csv...\nRemoving header from b.csv...\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "Project 13, step 2: read the file"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 23 of the deck and runs 4 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 12 ;
    sen0414:code "import csv, io\nfor text in ('Name,Age\\r\\nAlice,30\\r\\n', ''):\n    reader = csv.reader(io.StringIO(text, newline=''))\n    print(next(reader, None), '->', list(reader))" ; sen0414:expectedOutput "['Name', 'Age'] -> [['Alice', '30']]\nNone -> []\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Project 13, step 3: write the new file"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 24 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 13 ;
    sen0414:code "import csv, os, tempfile\nos.chdir(tempfile.mkdtemp())\nsrc = {'f1.csv': 'h1,h2\\r\\n1,a\\r\\n2,b\\r\\n',\n       'f2.csv': 'h1,h2\\r\\n3,c\\r\\n'}\nfor name, text in src.items():\n    reader = csv.reader(text.splitlines())\n    next(reader, None)\n    rows = list(reader)\n    with open('new_' + name, 'w', newline='') as f_out:\n        csv.writer(f_out).writerows(rows)\n    print(name, len(rows) + 1, '->', len(rows))" ; sen0414:expectedOutput "f1.csv 3 -> 2\nf2.csv 2 -> 1\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "Ideas for similar programs: totals"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 25 of the deck and runs 6 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 14 ;
    sen0414:code "import csv, io\ntext = 'Region,Sales\\r\\nNorth,120\\r\\nSouth,80\\r\\nNorth,60\\r\\nEast,40\\r\\n'\ntotals = {}\nfor row in csv.DictReader(io.StringIO(text, newline='')):\n    totals[row['Region']] = totals.get(row['Region'], 0) + int(row['Sales'])\nprint(totals)" ; sen0414:expectedOutput "{'North': 180, 'South': 80, 'East': 40}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "Three plaintext formats"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 29 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 15 ;
    sen0414:code "import json\nrows = [('Alice', 30), ('Bob', 25)]\nas_csv = 'Name,Age\\r\\n' + ''.join('%s,%d\\r\\n' % r for r in rows)\nas_json = json.dumps([{'Name': n, 'Age': a} for n, a in rows])\nfmt = '<person><Name>%s</Name><Age>%d</Age></person>'\nas_xml = '<people>' + ''.join(fmt % r for r in rows) + '</people>'\nprint(as_json)\nprint('characters:', len(as_csv), len(as_json), len(as_xml))" ; sen0414:expectedOutput "[{'Name': 'Alice', 'Age': 30}, {'Name': 'Bob', 'Age': 25}]\ncharacters: 28 58 111\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "Reading JSON with loads()"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 30 of the deck and runs 6 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 30 ; sen0414:orderInTab 16 ;
    sen0414:code "import json\ntext = '{'name': 'Alice', 'age': 30, 'car': null, 'ok': true, 'tags': ['a', 'b']}'\ndata = json.loads(text)\nprint(data)\nprint(type(data).__name__, data['car'] is None, data['ok'] is True)\nprint([type(v).__name__ for v in data.values()])" ; sen0414:expectedOutput "{'name': 'Alice', 'age': 30, 'car': None, 'ok': True, 'tags': ['a', 'b']}\ndict True True\n['str', 'int', 'NoneType', 'bool', 'list']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "Writing JSON with dumps()"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 31 of the deck and runs 8 lines of Python that print 9 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 31 ; sen0414:orderInTab 17 ;
    sen0414:code "import json\nd = {'t': (1, 2), 1: 'a', 'city': 'İstanbul', 'ok': True, 'n': None}\ns = json.dumps(d)\nprint(s)\nback = json.loads(s)\nprint(back)\nprint(back == d)\nprint(json.dumps({'a': [1, 2]}, indent=2))" ; sen0414:expectedOutput "{'t': [1, 2], '1': 'a', 'city': '\\u0130stanbul', 'ok': true, 'n': null}\n{'t': [1, 2], '1': 'a', 'city': 'İstanbul', 'ok': True, 'n': None}\nFalse\n{\n  'a': [\n    1,\n    2\n  ]\n}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "What JSON refuses"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 32 of the deck and runs 7 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 18 ;
    sen0414:code "import json\ndef msg(t):\n    try: json.loads(t); return 'accepted'\n    except json.JSONDecodeError as e: return '%s (column %d)' % (e.msg, e.colno)\ntexts = ['['spam', 'eggs',]', '{'a': 1}', '[None]', '[NaN]', '']\nfor t in texts:\n    print(repr(t), '->', msg(t))" ; sen0414:expectedOutput "'['spam', 'eggs',]' -> Illegal trailing comma before end of array (column 16)\n'{'a': 1}' -> Expecting property name enclosed in double quotes (column 2)\n'[None]' -> Expecting value (column 2)\n'[NaN]' -> accepted\n'' -> Expecting value (column 1)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "JSON and files"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 33 of the deck and runs 11 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 33 ; sen0414:orderInTab 19 ;
    sen0414:code "import json, os, tempfile\nos.chdir(tempfile.mkdtemp())\ndata = {'city': 'İstanbul', 'n': [1, None, True]}\nwith open('p.json', 'w', encoding='utf-8') as f:\n    json.dump(data, f, ensure_ascii=False)\nprint(open('p.json', 'rb').read())\nwith open('p.json', encoding='utf-8') as f:\n    print(json.load(f) == data)\nprint(json.loads(b'\\xef\\xbb\\xbf[1]'))\ntry: json.loads('\\ufeff[1]')\nexcept json.JSONDecodeError as e: print('str with a BOM:', e.msg)" ; sen0414:expectedOutput "b'{'city': '\\xc4\\xb0stanbul', 'n': [1, null, true]}'\nTrue\n[1]\nstr with a BOM: Unexpected UTF-8 BOM (decode using utf-8-sig)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "Reading XML with ElementTree"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 37 of the deck and runs 10 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 20 ;
    sen0414:code "import xml.etree.ElementTree as ET\ndoc = ('<person><name>Alice Doe</name><age>30</age><car/>'\n       '<phone type='mobile'>415</phone>'\n       '<phone type='work'>123</phone></person>')\nroot = ET.fromstring(doc)\nprint(root.tag, [c.tag for c in root])\nprint(root.find('name').text, repr(root.find('car').text))\nprint([p.get('type') for p in root.findall('phone')])\nage = root.find('age').text\nprint(type(age).__name__, int(age) + 1)" ; sen0414:expectedOutput "person ['name', 'age', 'car', 'phone', 'phone']\nAlice Doe None\n['mobile', 'work']\nstr 31\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "Whitespace and errors in ElementTree"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 38 of the deck and runs 6 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 38 ; sen0414:orderInTab 21 ;
    sen0414:code "import xml.etree.ElementTree as ET\na = ET.fromstring('<a>\\n  <b>x</b>\\n</a>')\nprint(repr(a.text), repr(a[0].tail), repr(a[0].text))\nfor bad in ('<a><b></a>', '<a/><b/>', '<A></a>'):\n    try: ET.fromstring(bad)\n    except ET.ParseError as e: print(bad, '->', e)" ; sen0414:expectedOutput "'\\n  ' '\\n' 'x'\n<a><b></a> -> mismatched tag: line 1, column 8\n<a/><b/> -> junk after document element: line 1, column 4\n<A></a> -> mismatched tag: line 1, column 5\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
pg:CE_22 a ipo:CodeExample ; rdfs:label "Writing XML with ElementTree"@en ;
    skos:definition "Example 22 of the chapter-code tab comes from slide 39 of the deck and runs 11 lines of Python that print 7 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 39 ; sen0414:orderInTab 22 ;
    sen0414:code "import io, xml.etree.ElementTree as ET\np = ET.Element('person')\nET.SubElement(p, 'name').text = 'Alice Doe'\nET.SubElement(p, 'note').text = 'a < b & 'c''\nET.SubElement(p, 'car').set('type', 'electric')\nprint(ET.tostring(p, encoding='unicode'))\nET.indent(p)\nprint(ET.tostring(p, encoding='unicode'))\nbuf = io.BytesIO()\nET.ElementTree(p).write(buf, encoding='utf-8', xml_declaration=True)\nprint(buf.getvalue()[:38])" ; sen0414:expectedOutput "<person><name>Alice Doe</name><note>a &lt; b &amp; 'c'</note><car type='electric' /></person>\n<person>\n  <name>Alice Doe</name>\n  <note>a &lt; b &amp; 'c'</note>\n  <car type='electric' />\n</person>\nb'<?xml version='1.0' encoding='utf-8'?>'\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_22 .
pg:CE_23 a ipo:CodeExample ; rdfs:label "Namespaces and xsi:nil"@en ;
    skos:definition "Example 23 of the chapter-code tab comes from slide 40 of the deck and runs 8 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 40 ; sen0414:orderInTab 23 ;
    sen0414:code "import xml.etree.ElementTree as ET\nXSI = 'http://www.w3.org/2001/XMLSchema-instance'\nr = ET.fromstring('<p xmlns:xsi='%s'><car xsi:nil='true'/></p>' % XSI)\nprint(r[0].attrib)\nprint(repr(r[0].text))\nA = 'http://example.org/a'\nn = ET.fromstring('<a:r xmlns:a='%s'><a:i>1</a:i><i>2</i></a:r>' % A)\nprint(n.tag, n.find('{%s}i' % A).text, n.find('i').text)" ; sen0414:expectedOutput "{'{http://www.w3.org/2001/XMLSchema-instance}nil': 'true'}\nNone\n{http://example.org/a}r 1 2\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_23 .
pg:CE_24 a ipo:CodeExample ; rdfs:label "xmltodict: XML as a dictionary"@en ;
    skos:definition "Example 24 of the chapter-code tab comes from slide 41 of the deck and runs 9 lines of Python that print 10 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 41 ; sen0414:orderInTab 24 ;
    sen0414:code "import xmltodict\nx = ('<person><name>Alice</name><age>30</age>'\n     '<phone type='mobile'>415</phone></person>')\nd = xmltodict.parse(x)\nprint(d)\nprint(xmltodict.parse('<a><b>1</b></a>'))\nprint(xmltodict.parse('<a><b>1</b><b>2</b></a>'))\nprint(xmltodict.unparse(d, pretty=True))\nprint(xmltodict.parse(xmltodict.unparse(d)) == d)" ; sen0414:expectedOutput "{'person': {'name': 'Alice', 'age': '30', 'phone': {'@type': 'mobile', '#text': '415'}}}\n{'a': {'b': '1'}}\n{'a': {'b': ['1', '2']}}\n<?xml version='1.0' encoding='utf-8'?>\n<person>\n	<name>Alice</name>\n	<age>30</age>\n	<phone type='mobile'>415</phone>\n</person>\nTrue\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_24 .
pg:CE_25 a ipo:CodeExample ; rdfs:label "XML from someone else"@en ;
    skos:definition "Example 25 of the chapter-code tab comes from slide 43 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 43 ; sen0414:orderInTab 25 ;
    sen0414:code "import xml.etree.ElementTree as ET\nten = '&a;' * 10\ndoc = ('<!DOCTYPE d [<!ENTITY a 'lol'>'\n       '<!ENTITY b '%s'>]><d>&b;</d>' % ten)\nn = len(ET.fromstring(doc).text)\nprint('ElementTree expands it:', n, 'characters')\nimport defusedxml, defusedxml.ElementTree as DET\ntry: DET.fromstring(doc)\nexcept defusedxml.EntitiesForbidden:\n    print('defusedxml refuses the entities')" ; sen0414:expectedOutput "ElementTree expands it: 30 characters\ndefusedxml refuses the entities\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_25 .
pg:CE_26 a ipo:CodeExample ; rdfs:label "Excel-to-CSV converter: the workbook"@en ;
    skos:definition "Example 26 of the chapter-code tab comes from slide 47 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 47 ; sen0414:orderInTab 26 ;
    sen0414:code "import io, openpyxl\nwb = openpyxl.Workbook()\nws = wb.active\nws.title = 'Sales'\nrows = [['Region', 'Units'], ['North', 120], ['South', 80]]\nfor row in rows: ws.append(row)\nwb.create_sheet('Costs').append(['Item', 'Cost'])\nbuf = io.BytesIO(); wb.save(buf)\nagain = openpyxl.load_workbook(buf)\nprint(again.sheetnames, again['Sales']['B2'].value)" ; sen0414:expectedOutput "['Sales', 'Costs'] 120\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_26 .
pg:CE_27 a ipo:CodeExample ; rdfs:label "Excel-to-CSV converter: one CSV per sheet"@en ;
    skos:definition "Example 27 of the chapter-code tab comes from slide 48 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch18/page/chapter_code_ch18_v1_0_1.json" ;
    sen0414:slideNumber 48 ; sen0414:orderInTab 27 ;
    sen0414:code "import csv, os, tempfile, openpyxl\nos.chdir(tempfile.mkdtemp())\nwb = openpyxl.Workbook(); wb.active.title = 'Sales'\nfor row in (['Region', 'Units'], ['North', 120]): wb.active.append(row)\nwb.create_sheet('Costs').append(['Item', 'Cost'])\nfor ws in wb.worksheets:\n    with open('book-%s.csv' % ws.title, 'w', newline='') as f:\n        rows = list(ws.iter_rows(values_only=True))\n        csv.writer(f).writerows(rows)\n        print(f.name, len(rows), 'rows')" ; sen0414:expectedOutput "book-Sales.csv 2 rows\nbook-Costs.csv 1 rows\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_27 .
