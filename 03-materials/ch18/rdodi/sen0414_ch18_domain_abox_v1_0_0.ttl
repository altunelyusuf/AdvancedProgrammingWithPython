chx:X_CsvReader a owl:NamedIndividual, chx:CsvReader ; rdfs:label "csv.reader(example_file)"@en ; skos:definition "csv.reader takes a file object opened in text mode, or any iterable of lines, and gives an object that yields each row as a list of strings."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_CsvReader a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: list(csv.reader(io.StringIO('4/5/2035 13:34,Apples,73\\n4/5/2035 3:41,Cherries,85\\n4/6/2035 12:46,Pears,14\\n'))))(__import__('csv'), __import__('io')) evaluates to [['4/5/2035 13:34', 'Apples', '73'], ['4/5/2035 3:41', 'Cherries', '85'], ['4/6/2035 12:46', 'Pears', '14']]"@en ; chx:input "(lambda csv, io: list(csv.reader(io.StringIO('4/5/2035 13:34,Apples,73\\n4/5/2035 3:41,Cherries,85\\n4/6/2035 12:46,Pears,14\\n'))))(__import__('csv'), __import__('io'))" ; chx:output "[['4/5/2035 13:34', 'Apples', '73'], ['4/5/2035 3:41', 'Cherries', '85'], ['4/6/2035 12:46', 'Pears', '14']]" .
chx:X_CsvReader rd:hasIOExample chx:IO_CsvReader .
chx:X_RowsAndColumns a owl:NamedIndividual, chx:RowsAndColumns ; rdfs:label "example_data[row][col]"@en ; skos:definition "Converting the reader to a list gives a list of lists, so a cell is found by the row index and then the column index."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_RowsAndColumns a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: (lambda d: (d[0][0], d[0][1], d[1][1], d[2][2], len(d)))(list(csv.reader(io.StringIO('4/5/2035 13:34,Apples,73\\n4/5/2035 3:41,Cherries,85\\n4/6/2035 12:46,Pears,14\\n')))))(__import__('csv'), __import__('io')) evaluates to ('4/5/2035 13:34', 'Apples', 'Cherries', '14', 3)"@en ; chx:input "(lambda csv, io: (lambda d: (d[0][0], d[0][1], d[1][1], d[2][2], len(d)))(list(csv.reader(io.StringIO('4/5/2035 13:34,Apples,73\\n4/5/2035 3:41,Cherries,85\\n4/6/2035 12:46,Pears,14\\n')))))(__import__('csv'), __import__('io'))" ; chx:output "('4/5/2035 13:34', 'Apples', 'Cherries', '14', 3)" .
chx:X_RowsAndColumns rd:hasIOExample chx:IO_RowsAndColumns .
chx:X_StringValues a owl:NamedIndividual, chx:StringValues ; rdfs:label "int(row[2]) + 1"@en ; skos:definition "Every cell comes back as a string, so a number in a file is converted by the program with int or float."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_StringValues a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv: (lambda row: ([type(v).__name__ for v in row], row[2] + '1', int(row[2]) + 1))(next(csv.reader(['4/5/2035 13:34,Apples,73']))))(__import__('csv')) evaluates to (['str', 'str', 'str'], '731', 74)"@en ; chx:input "(lambda csv: (lambda row: ([type(v).__name__ for v in row], row[2] + '1', int(row[2]) + 1))(next(csv.reader(['4/5/2035 13:34,Apples,73']))))(__import__('csv'))" ; chx:output "(['str', 'str', 'str'], '731', 74)" .
chx:X_StringValues rd:hasIOExample chx:IO_StringValues .
chx:X_LineNumber a owl:NamedIndividual, chx:LineNumber ; rdfs:label "[(example_reader.line_num, row[1]) for row in example_reader]"@en ; skos:definition "The reader's line_num counts the lines read so far, from 1, and a reader can be looped over once; line_num is not the number of records when a record spans lines."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_LineNumber a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv: (lambda r: ([(r.line_num, row[1]) for row in r], len(list(r))))(csv.reader(['a,Apples', 'b,Cherries', 'c,Pears'])))(__import__('csv')) evaluates to ([(1, 'Apples'), (2, 'Cherries'), (3, 'Pears')], 0)"@en ; chx:input "(lambda csv: (lambda r: ([(r.line_num, row[1]) for row in r], len(list(r))))(csv.reader(['a,Apples', 'b,Cherries', 'c,Pears'])))(__import__('csv'))" ; chx:output "([(1, 'Apples'), (2, 'Cherries'), (3, 'Pears')], 0)" .
chx:X_LineNumber rd:hasIOExample chx:IO_LineNumber .
chx:X_SplitVersusReader a owl:NamedIndividual, chx:SplitVersusReader ; rdfs:label "line.split(',')"@en ; skos:definition "Splitting a line at every comma cuts a quoted value that contains a comma in two, which the csv reader does not."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_SplitVersusReader a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv: ('\\x22Hello, world!\\x22,eggs'.split(','), next(csv.reader(['\\x22Hello, world!\\x22,eggs']))))(__import__('csv')) evaluates to ([''Hello', ' world!'', 'eggs'], ['Hello, world!', 'eggs'])"@en ; chx:input "(lambda csv: ('\\x22Hello, world!\\x22,eggs'.split(','), next(csv.reader(['\\x22Hello, world!\\x22,eggs']))))(__import__('csv'))" ; chx:output "([''Hello', ' world!'', 'eggs'], ['Hello, world!', 'eggs'])" .
chx:X_SplitVersusReader rd:hasIOExample chx:IO_SplitVersusReader .
chx:X_CsvWriter a owl:NamedIndividual, chx:CsvWriter ; rdfs:label "output_writer.writerow(['spam', 'eggs'])"@en ; skos:definition "csv.writer wraps a file object, and writerow writes one list as a row and returns the number of characters written, line terminator included."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_CsvWriter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: (lambda s: (csv.writer(s).writerow(['spam', 'eggs', 'bacon', 'ham']), s.getvalue()))(io.StringIO()))(__import__('csv'), __import__('io')) evaluates to (21, 'spam,eggs,bacon,ham\\r\\n')"@en ; chx:input "(lambda csv, io: (lambda s: (csv.writer(s).writerow(['spam', 'eggs', 'bacon', 'ham']), s.getvalue()))(io.StringIO()))(__import__('csv'), __import__('io'))" ; chx:output "(21, 'spam,eggs,bacon,ham\\r\\n')" .
chx:X_CsvWriter rd:hasIOExample chx:IO_CsvWriter .
chx:X_NewlineArgument a owl:NamedIndividual, chx:NewlineArgument ; rdfs:label "open('output.csv', 'w', newline='')"@en ; skos:definition "A file given to the csv module is opened with newline='' so that the module's own line terminator is not translated a second time by the text layer."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_NewlineArgument a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: [(lambda b: (lambda t: (csv.writer(t).writerow(['a', 'b']), b.getvalue()))(io.TextIOWrapper(b, encoding='ascii', newline=n, write_through=True)))(io.BytesIO()) for n in ('', '\\r\\n')])(__import__('csv'), __import__('io')) evaluates to [(5, b'a,b\\r\\n'), (5, b'a,b\\r\\r\\n')]"@en ; chx:input "(lambda csv, io: [(lambda b: (lambda t: (csv.writer(t).writerow(['a', 'b']), b.getvalue()))(io.TextIOWrapper(b, encoding='ascii', newline=n, write_through=True)))(io.BytesIO()) for n in ('', '\\r\\n')])(__import__('csv'), __import__('io'))" ; chx:output "[(5, b'a,b\\r\\n'), (5, b'a,b\\r\\r\\n')]" .
chx:X_NewlineArgument rd:hasIOExample chx:IO_NewlineArgument .
chx:X_QuoteEscaping a owl:NamedIndividual, chx:QuoteEscaping ; rdfs:label "'Hello, world!'"@en ; skos:definition "The writer puts a value in double quotes when it holds the delimiter, a double quote or a line break, and doubles any double quote inside it."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_QuoteEscaping a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: (lambda s: (csv.writer(s, lineterminator='\\n').writerow(['Hello, world!', 'say \\x22hi\\x22', 'x']), s.getvalue()))(io.StringIO()))(__import__('csv'), __import__('io')) evaluates to (31, ''Hello, world!','say ''hi''',x\\n')"@en ; chx:input "(lambda csv, io: (lambda s: (csv.writer(s, lineterminator='\\n').writerow(['Hello, world!', 'say \\x22hi\\x22', 'x']), s.getvalue()))(io.StringIO()))(__import__('csv'), __import__('io'))" ; chx:output "(31, ''Hello, world!','say ''hi''',x\\n')" .
chx:X_QuoteEscaping rd:hasIOExample chx:IO_QuoteEscaping .
chx:X_TabSeparated a owl:NamedIndividual, chx:TabSeparated ; rdfs:label "csv.writer(f, delimiter='\\t', lineterminator='\\n\\n')"@en ; skos:definition "The delimiter and lineterminator keyword arguments change the character between cells and the characters at the end of a row, which makes a tab-separated file."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_TabSeparated a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: (lambda s: (csv.writer(s, delimiter='\\t', lineterminator='\\n\\n').writerow(['spam', 'eggs', 'bacon', 'ham']), s.getvalue()))(io.StringIO()))(__import__('csv'), __import__('io')) evaluates to (21, 'spam\\teggs\\tbacon\\tham\\n\\n')"@en ; chx:input "(lambda csv, io: (lambda s: (csv.writer(s, delimiter='\\t', lineterminator='\\n\\n').writerow(['spam', 'eggs', 'bacon', 'ham']), s.getvalue()))(io.StringIO()))(__import__('csv'), __import__('io'))" ; chx:output "(21, 'spam\\teggs\\tbacon\\tham\\n\\n')" .
chx:X_TabSeparated rd:hasIOExample chx:IO_TabSeparated .
chx:X_DictReader a owl:NamedIndividual, chx:DictReader ; rdfs:label "csv.DictReader(example_file)"@en ; skos:definition "DictReader takes the first row as the keys and gives each later row as a dictionary, so the header row is not in the results."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DictReader a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: list(csv.DictReader(io.StringIO('Timestamp,Fruit,Quantity\\n4/5/2035 13:34,Apples,73\\n4/5/2035 3:41,Cherries,85\\n'))))(__import__('csv'), __import__('io')) evaluates to [{'Timestamp': '4/5/2035 13:34', 'Fruit': 'Apples', 'Quantity': '73'}, {'Timestamp': '4/5/2035 3:41', 'Fruit': 'Cherries', 'Quantity': '85'}]"@en ; chx:input "(lambda csv, io: list(csv.DictReader(io.StringIO('Timestamp,Fruit,Quantity\\n4/5/2035 13:34,Apples,73\\n4/5/2035 3:41,Cherries,85\\n'))))(__import__('csv'), __import__('io'))" ; chx:output "[{'Timestamp': '4/5/2035 13:34', 'Fruit': 'Apples', 'Quantity': '73'}, {'Timestamp': '4/5/2035 3:41', 'Fruit': 'Cherries', 'Quantity': '85'}]" .
chx:X_DictReader rd:hasIOExample chx:IO_DictReader .
chx:X_FieldNames a owl:NamedIndividual, chx:FieldNames ; rdfs:label "csv.DictReader(f, ['time', 'name', 'amount'])"@en ; skos:definition "When a second argument gives the field names, DictReader uses them and treats the first row of the file as data."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_FieldNames a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: list(csv.DictReader(io.StringIO('4/5/2035 13:34,Apples,73\\n'), ['time', 'name', 'amount'])))(__import__('csv'), __import__('io')) evaluates to [{'time': '4/5/2035 13:34', 'name': 'Apples', 'amount': '73'}]"@en ; chx:input "(lambda csv, io: list(csv.DictReader(io.StringIO('4/5/2035 13:34,Apples,73\\n'), ['time', 'name', 'amount'])))(__import__('csv'), __import__('io'))" ; chx:output "[{'time': '4/5/2035 13:34', 'name': 'Apples', 'amount': '73'}]" .
chx:X_FieldNames rd:hasIOExample chx:IO_FieldNames .
chx:X_DictWriter a owl:NamedIndividual, chx:DictWriter ; rdfs:label "csv.DictWriter(f, ['Name', 'Pet', 'Phone'])"@en ; skos:definition "DictWriter takes the field names in the order the columns are to appear, writeheader writes them as the first row, and writerow takes a dictionary."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DictWriter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: (lambda s: (lambda w: (w.writeheader(), w.writerow({'Name': 'Alice', 'Pet': 'cat', 'Phone': '555-1234'}), w.writerow({'Phone': '555-5555', 'Name': 'Carol', 'Pet': 'dog'}), s.getvalue()))(csv.DictWriter(s, ['Name', 'Pet', 'Phone'], lineterminator='\\n')))(io.StringIO()))(__import__('csv'), __import__('io')) evaluates to (15, 19, 19, 'Name,Pet,Phone\\nAlice,cat,555-1234\\nCarol,dog,555-5555\\n')"@en ; chx:input "(lambda csv, io: (lambda s: (lambda w: (w.writeheader(), w.writerow({'Name': 'Alice', 'Pet': 'cat', 'Phone': '555-1234'}), w.writerow({'Phone': '555-5555', 'Name': 'Carol', 'Pet': 'dog'}), s.getvalue()))(csv.DictWriter(s, ['Name', 'Pet', 'Phone'], lineterminator='\\n')))(io.StringIO()))(__import__('csv'), __import__('io'))" ; chx:output "(15, 19, 19, 'Name,Pet,Phone\\nAlice,cat,555-1234\\nCarol,dog,555-5555\\n')" .
chx:X_DictWriter rd:hasIOExample chx:IO_DictWriter .
chx:X_MissingKeys a owl:NamedIndividual, chx:MissingKeys ; rdfs:label "{'Name': 'Bob', 'Phone': '555-9999'}"@en ; skos:definition "A key missing from the dictionary becomes an empty cell, while a key that is not among the field names raises ValueError unless extrasaction is 'ignore'."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_MissingKeys a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: (lambda s: (lambda w: (w.writerow({'Name': 'Bob', 'Phone': '555-9999'}), s.getvalue()))(csv.DictWriter(s, ['Name', 'Pet', 'Phone'], lineterminator='\\n')))(io.StringIO()))(__import__('csv'), __import__('io')) evaluates to (14, 'Bob,,555-9999\\n')"@en ; chx:input "(lambda csv, io: (lambda s: (lambda w: (w.writerow({'Name': 'Bob', 'Phone': '555-9999'}), s.getvalue()))(csv.DictWriter(s, ['Name', 'Pet', 'Phone'], lineterminator='\\n')))(io.StringIO()))(__import__('csv'), __import__('io'))" ; chx:output "(14, 'Bob,,555-9999\\n')" .
chx:X_MissingKeys rd:hasIOExample chx:IO_MissingKeys .
chx:X_QuoteModes a owl:NamedIndividual, chx:QuoteModes ; rdfs:label "quoting=csv.QUOTE_NONNUMERIC"@en ; skos:definition "The quoting option decides which values are quoted on writing and how unquoted values are read back; QUOTE_NONNUMERIC reads unquoted values as floats, and QUOTE_STRINGS and QUOTE_NOTNULL of Python 3.12 let None survive."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_QuoteModes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: (lambda s: (csv.writer(s, quoting=csv.QUOTE_NONNUMERIC, lineterminator='\\n').writerow(['a', 1, 2.5]), s.getvalue(), list(csv.reader(io.StringIO(s.getvalue()), quoting=csv.QUOTE_NONNUMERIC))))(io.StringIO()))(__import__('csv'), __import__('io')) evaluates to (10, ''a',1,2.5\\n', [['a', 1.0, 2.5]])"@en ; chx:input "(lambda csv, io: (lambda s: (csv.writer(s, quoting=csv.QUOTE_NONNUMERIC, lineterminator='\\n').writerow(['a', 1, 2.5]), s.getvalue(), list(csv.reader(io.StringIO(s.getvalue()), quoting=csv.QUOTE_NONNUMERIC))))(io.StringIO()))(__import__('csv'), __import__('io'))" ; chx:output "(10, ''a',1,2.5\\n', [['a', 1.0, 2.5]])" .
chx:X_QuoteModes rd:hasIOExample chx:IO_QuoteModes .
chx:X_SnifferDetection a owl:NamedIndividual, chx:SnifferDetection ; rdfs:label "csv.Sniffer().sniff(sample)"@en ; skos:definition "The Sniffer guesses the delimiter of a sample of text and whether its first row is a header, as a rough heuristic that can be wrong."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_SnifferDetection a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv: (csv.Sniffer().sniff('a;b;c\\n1;2;3\\n4;5;6\\n').delimiter, csv.Sniffer().has_header('name,qty\\nx,1\\ny,2\\nz,3\\n')))(__import__('csv')) evaluates to (';', True)"@en ; chx:input "(lambda csv: (csv.Sniffer().sniff('a;b;c\\n1;2;3\\n4;5;6\\n').delimiter, csv.Sniffer().has_header('name,qty\\nx,1\\ny,2\\nz,3\\n')))(__import__('csv'))" ; chx:output "(';', True)" .
chx:X_SnifferDetection rd:hasIOExample chx:IO_SnifferDetection .
chx:X_HeaderRemoval a owl:NamedIndividual, chx:HeaderRemoval ; rdfs:label "if reader_obj.line_num == 1: continue"@en ; skos:definition "Project 13 reads each CSV file, skips the row whose line_num is 1 and writes the others to a file of the same name in a new folder."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_HeaderRemoval a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: (lambda r: [row for row in r if r.line_num != 1])(csv.reader(io.StringIO('Timestamp,Fruit\\n4/5/2035 13:34,Apples\\n4/6/2035 12:46,Pears\\n'))))(__import__('csv'), __import__('io')) evaluates to [['4/5/2035 13:34', 'Apples'], ['4/6/2035 12:46', 'Pears']]"@en ; chx:input "(lambda csv, io: (lambda r: [row for row in r if r.line_num != 1])(csv.reader(io.StringIO('Timestamp,Fruit\\n4/5/2035 13:34,Apples\\n4/6/2035 12:46,Pears\\n'))))(__import__('csv'), __import__('io'))" ; chx:output "[['4/5/2035 13:34', 'Apples'], ['4/6/2035 12:46', 'Pears']]" .
chx:X_HeaderRemoval rd:hasIOExample chx:IO_HeaderRemoval .
chx:X_MultilineHeaderHazard a owl:NamedIndividual, chx:MultilineHeaderHazard ; rdfs:label "'Time\\nstamp',Fruit"@en ; skos:definition "A header whose name holds a line break is one row over two lines, so the test line_num == 1 does not find it and the header is kept."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_MultilineHeaderHazard a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, io: (lambda r: ([row for row in r if r.line_num != 1], r.line_num))(csv.reader(io.StringIO('\\x22Time\\nstamp\\x22,Fruit\\nx,y\\n'))))(__import__('csv'), __import__('io')) evaluates to ([['Time\\nstamp', 'Fruit'], ['x', 'y']], 3)"@en ; chx:input "(lambda csv, io: (lambda r: ([row for row in r if r.line_num != 1], r.line_num))(csv.reader(io.StringIO('\\x22Time\\nstamp\\x22,Fruit\\nx,y\\n'))))(__import__('csv'), __import__('io'))" ; chx:output "([['Time\\nstamp', 'Fruit'], ['x', 'y']], 3)" .
chx:X_MultilineHeaderHazard rd:hasIOExample chx:IO_MultilineHeaderHazard .
chx:X_JsonValues a owl:NamedIndividual, chx:JsonValues ; rdfs:label "{'car': null, 'programmer': true}"@en ; skos:definition "JSON writes missing as null and the two booleans as true and false in lowercase, with double-quoted strings and colons between names and values."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_JsonValues a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda json: json.dumps({'car': None, 'programmer': True, 'name': 'Alice Doe', 'age': 30}))(__import__('json')) evaluates to '{'car': null, 'programmer': true, 'name': 'Alice Doe', 'age': 30}'"@en ; chx:input "(lambda json: json.dumps({'car': None, 'programmer': True, 'name': 'Alice Doe', 'age': 30}))(__import__('json'))" ; chx:output "'{'car': null, 'programmer': true, 'name': 'Alice Doe', 'age': 30}'" .
