chx:X_FormatComparison a owl:NamedIndividual, chx:FormatComparison ; rdfs:label "CSV, JSON or XML"@en ; skos:definition "The formats differ in what a value becomes on reading: CSV gives a string for every cell, JSON keeps numbers, booleans and null, and XML gives text."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_FormatComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda csv, json, ET: [type(x).__name__ for x in (next(csv.reader(['30']))[0], json.loads('30'), ET.fromstring('<a>30</a>').text)])(__import__('csv'), __import__('json'), __import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to ['str', 'int', 'str']"@en ; chx:input "(lambda csv, json, ET: [type(x).__name__ for x in (next(csv.reader(['30']))[0], json.loads('30'), ET.fromstring('<a>30</a>').text)])(__import__('csv'), __import__('json'), __import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "['str', 'int', 'str']" .
