chx:X_EntityExpansion a owl:NamedIndividual, chx:EntityExpansion ; rdfs:label "<!ENTITY a '0123456789'>"@en ; skos:definition "An XML document can define entities that the parser expands, so a short document can become a very large text; data from an untrusted source needs the precautions of the XML security section."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_EntityExpansion a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET: (lambda x: (len(x), len(ET.fromstring(x).text)))('<!DOCTYPE l [<!ENTITY a \\x270123456789\\x27><!ENTITY b \\x27&a;&a;&a;&a;&a;&a;&a;&a;&a;&a;\\x27><!ENTITY c \\x27&b;&b;&b;&b;&b;&b;&b;&b;&b;&b;\\x27>]><r>&c;</r>'))(__import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to (137, 1000)"@en ; chx:input "(lambda ET: (lambda x: (len(x), len(ET.fromstring(x).text)))('<!DOCTYPE l [<!ENTITY a \\x270123456789\\x27><!ENTITY b \\x27&a;&a;&a;&a;&a;&a;&a;&a;&a;&a;\\x27><!ENTITY c \\x27&b;&b;&b;&b;&b;&b;&b;&b;&b;&b;\\x27>]><r>&c;</r>'))(__import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "(137, 1000)" .
chx:X_EntityExpansion rd:hasIOExample chx:IO_EntityExpansion .
chx:X_TextOnlyValues a owl:NamedIndividual, chx:TextOnlyValues ; rdfs:label "int(root.find('age').text) + 1"@en ; skos:definition "Every value in XML is text, a number or a boolean is converted by the program, and a missing value is only approximated with an xsi:nil attribute."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_TextOnlyValues a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET: (lambda r: (r.find('age').text, r.find('programmer').text, r.find('car').text, r.find('car').get('{http://www.w3.org/2001/XMLSchema-instance}nil'), int(r.find('age').text) + 1))(ET.fromstring('<p xmlns:xsi=\\x27http://www.w3.org/2001/XMLSchema-instance\\x27><age>30</age><programmer>true</programmer><car xsi:nil=\\x27true\\x27/></p>')))(__import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to ('30', 'true', None, 'true', 31)"@en ; chx:input "(lambda ET: (lambda r: (r.find('age').text, r.find('programmer').text, r.find('car').text, r.find('car').get('{http://www.w3.org/2001/XMLSchema-instance}nil'), int(r.find('age').text) + 1))(ET.fromstring('<p xmlns:xsi=\\x27http://www.w3.org/2001/XMLSchema-instance\\x27><age>30</age><programmer>true</programmer><car xsi:nil=\\x27true\\x27/></p>')))(__import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "('30', 'true', None, 'true', 31)" .
chx:X_TextOnlyValues rd:hasIOExample chx:IO_TextOnlyValues .
