chx:IO_TomlReading a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda tomllib: (tomllib.loads('name = \\x22Alice Doe\\x22\\nage = 30\\nprogrammer = true\\n'), hasattr(tomllib, 'dumps')))(__import__('tomllib')) evaluates to ({'name': 'Alice Doe', 'age': 30, 'programmer': True}, False)"@en ; chx:input "(lambda tomllib: (tomllib.loads('name = \\x22Alice Doe\\x22\\nage = 30\\nprogrammer = true\\n'), hasattr(tomllib, 'dumps')))(__import__('tomllib'))" ; chx:output "({'name': 'Alice Doe', 'age': 30, 'programmer': True}, False)" .
chx:X_TomlReading rd:hasIOExample chx:IO_TomlReading .
