chx:X_JsonDifferences a owl:NamedIndividual, chx:JsonDifferences ; rdfs:label "['spam', 'eggs',]"@en ; skos:definition "JSON allows no trailing comma, no single quotes, no comments and no line break inside a string, and whitespace outside strings does not matter."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_JsonDifferences a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda json: [json.loads('[\\x22spam\\x22, \\x22eggs\\x22]'), json.loads('null'), json.loads('true'), json.loads('{\\x22a\\x22:\\n  [1 , 2]}')])(__import__('json')) evaluates to [['spam', 'eggs'], None, True, {'a': [1, 2]}]"@en ; chx:input "(lambda json: [json.loads('[\\x22spam\\x22, \\x22eggs\\x22]'), json.loads('null'), json.loads('true'), json.loads('{\\x22a\\x22:\\n  [1 , 2]}')])(__import__('json'))" ; chx:output "[['spam', 'eggs'], None, True, {'a': [1, 2]}]" .
chx:X_JsonDifferences rd:hasIOExample chx:IO_JsonDifferences .
chx:X_LoadsFunction a owl:NamedIndividual, chx:LoadsFunction ; rdfs:label "json.loads(json_string)"@en ; skos:definition "json.loads takes a string of JSON text and returns the Python value, a dictionary for an object; json.load does the same for a file."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_LoadsFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda json: (lambda d: (d['name'], d['age'], d['car'], d['programmer'], type(d).__name__))(json.loads('{\\x22name\\x22: \\x22Alice Doe\\x22, \\x22age\\x22: 30, \\x22car\\x22: null, \\x22programmer\\x22: true}')))(__import__('json')) evaluates to ('Alice Doe', 30, None, True, 'dict')"@en ; chx:input "(lambda json: (lambda d: (d['name'], d['age'], d['car'], d['programmer'], type(d).__name__))(json.loads('{\\x22name\\x22: \\x22Alice Doe\\x22, \\x22age\\x22: 30, \\x22car\\x22: null, \\x22programmer\\x22: true}')))(__import__('json'))" ; chx:output "('Alice Doe', 30, None, True, 'dict')" .
chx:X_LoadsFunction rd:hasIOExample chx:IO_LoadsFunction .
chx:X_DecodeError a owl:NamedIndividual, chx:DecodeError ; rdfs:label "json.JSONDecodeError"@en ; skos:definition "Text that is not valid JSON raises JSONDecodeError, a kind of ValueError that carries the message and the line, column and character position of the fault."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DecodeError a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda json: (issubclass(json.JSONDecodeError, ValueError), json.JSONDecoder().raw_decode('[1, 2] extra')))(__import__('json')) evaluates to (True, ([1, 2], 6))"@en ; chx:input "(lambda json: (issubclass(json.JSONDecodeError, ValueError), json.JSONDecoder().raw_decode('[1, 2] extra')))(__import__('json'))" ; chx:output "(True, ([1, 2], 6))" .
chx:X_DecodeError rd:hasIOExample chx:IO_DecodeError .
chx:X_DumpsFunction a owl:NamedIndividual, chx:DumpsFunction ; rdfs:label "json.dumps(python_data)"@en ; skos:definition "json.dumps takes a Python value and returns the JSON text on one line; json.dump writes it to a file."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DumpsFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda json: json.dumps({'name': 'Alice Doe', 'car': None, 'phone': [{'type': 'mobile', 'number': '415-555-7890'}]}))(__import__('json')) evaluates to '{'name': 'Alice Doe', 'car': null, 'phone': [{'type': 'mobile', 'number': '415-555-7890'}]}'"@en ; chx:input "(lambda json: json.dumps({'name': 'Alice Doe', 'car': None, 'phone': [{'type': 'mobile', 'number': '415-555-7890'}]}))(__import__('json'))" ; chx:output "'{'name': 'Alice Doe', 'car': null, 'phone': [{'type': 'mobile', 'number': '415-555-7890'}]}'" .
chx:X_DumpsFunction rd:hasIOExample chx:IO_DumpsFunction .
chx:X_IndentOption a owl:NamedIndividual, chx:IndentOption ; rdfs:label "json.dumps(python_data, indent=2)"@en ; skos:definition "The indent option puts each array item and each member on its own line, indented by that many spaces per level, or by a string such as a tab."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_IndentOption a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda json: json.dumps({'a': [1, 2], 'b': {'c': None}}, indent=2))(__import__('json')) evaluates to '{\\n  'a': [\\n    1,\\n    2\\n  ],\\n  'b': {\\n    'c': null\\n  }\\n}'"@en ; chx:input "(lambda json: json.dumps({'a': [1, 2], 'b': {'c': None}}, indent=2))(__import__('json'))" ; chx:output "'{\\n  'a': [\\n    1,\\n    2\\n  ],\\n  'b': {\\n    'c': null\\n  }\\n}'" .
chx:X_IndentOption rd:hasIOExample chx:IO_IndentOption .
chx:X_JsonTool a owl:NamedIndividual, chx:JsonTool ; rdfs:label "python -m json"@en ; skos:definition "Running the json module as a script checks JSON text from a file or standard input and prints it indented, or reports where it is invalid."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:X_TypeMapping a owl:NamedIndividual, chx:TypeMapping ; rdfs:label "json.loads(json.dumps(x))"@en ; skos:definition "An object becomes a dict, an array a list, a number an int or a float; on the way out a tuple becomes an array and a dictionary key becomes a string, so the round trip does not always give back the original."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_TypeMapping a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda json: json.loads(json.dumps({'t': (1, 2), 'k': {1: 'a'}, 'f': 1.0, 'n': None})))(__import__('json')) evaluates to {'t': [1, 2], 'k': {'1': 'a'}, 'f': 1.0, 'n': None}"@en ; chx:input "(lambda json: json.loads(json.dumps({'t': (1, 2), 'k': {1: 'a'}, 'f': 1.0, 'n': None})))(__import__('json'))" ; chx:output "{'t': [1, 2], 'k': {'1': 'a'}, 'f': 1.0, 'n': None}" .
chx:X_TypeMapping rd:hasIOExample chx:IO_TypeMapping .
chx:X_UnsupportedTypes a owl:NamedIndividual, chx:UnsupportedTypes ; rdfs:label "json.dumps(sorted(my_set))"@en ; skos:definition "A value outside the basic types, such as a set, a date or a file object, raises TypeError when it is written, and is converted by the program first."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_UnsupportedTypes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda json: (json.dumps([1, 'a']), json.dumps({'s': sorted({3, 1, 2})})))(__import__('json')) evaluates to ('[1, 'a']', '{'s': [1, 2, 3]}')"@en ; chx:input "(lambda json: (json.dumps([1, 'a']), json.dumps({'s': sorted({3, 1, 2})})))(__import__('json'))" ; chx:output "('[1, 'a']', '{'s': [1, 2, 3]}')" .
chx:X_UnsupportedTypes rd:hasIOExample chx:IO_UnsupportedTypes .
chx:X_DefaultHook a owl:NamedIndividual, chx:DefaultHook ; rdfs:label "json.dumps(x, default=str)"@en ; skos:definition "The default argument names a function that JSON calls for a value it cannot write, and its result is written in place of the value."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DefaultHook a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda json, dt: json.dumps({'when': dt.date(2035, 4, 5)}, default=str))(__import__('json'), __import__('datetime')) evaluates to '{'when': '2035-04-05'}'"@en ; chx:input "(lambda json, dt: json.dumps({'when': dt.date(2035, 4, 5)}, default=str))(__import__('json'), __import__('datetime'))" ; chx:output "'{'when': '2035-04-05'}'" .
chx:X_DefaultHook rd:hasIOExample chx:IO_DefaultHook .
chx:X_ExceptionNotes a owl:NamedIndividual, chx:ExceptionNotes ; rdfs:label "e.__notes__"@en ; skos:definition "Since Python 3.14 a TypeError from json.dumps carries notes that name the dictionary keys and list positions leading to the value that could not be written."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:X_ElementsAndTags a owl:NamedIndividual, chx:ElementsAndTags ; rdfs:label "<name>Alice Doe</name>"@en ; skos:definition "An XML element is a pair of tags with text or other elements between them; the elements inside an element are its children and it is their parent."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ElementsAndTags a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET: (lambda r: (r.tag, [c.tag for c in r], r[0].text, r[1].text))(ET.fromstring('<person><name>Alice Doe</name><age>30</age></person>')))(__import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to ('person', ['name', 'age'], 'Alice Doe', '30')"@en ; chx:input "(lambda ET: (lambda r: (r.tag, [c.tag for c in r], r[0].text, r[1].text))(ET.fromstring('<person><name>Alice Doe</name><age>30</age></person>')))(__import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "('person', ['name', 'age'], 'Alice Doe', '30')" .
chx:X_ElementsAndTags rd:hasIOExample chx:IO_ElementsAndTags .
chx:X_SingleRoot a owl:NamedIndividual, chx:SingleRoot ; rdfs:label "<person>...</person>"@en ; skos:definition "A valid XML document has one root element that holds all the others, so text with two elements side by side at the top is not valid."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_SingleRoot a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET: (ET.fromstring('<person><name>Alice Doe</name></person>').tag, ET.fromstring('<person><name>Alice Doe</name></person>').find('name').text))(__import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to ('person', 'Alice Doe')"@en ; chx:input "(lambda ET: (ET.fromstring('<person><name>Alice Doe</name></person>').tag, ET.fromstring('<person><name>Alice Doe</name></person>').find('name').text))(__import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "('person', 'Alice Doe')" .
chx:X_SingleRoot rd:hasIOExample chx:IO_SingleRoot .
chx:X_AttributesVersusElements a owl:NamedIndividual, chx:AttributesVersusElements ; rdfs:label "<address street='100 Larkin St.' />"@en ; skos:definition "The same data can be written as child elements or as attributes of one self-closing element, and nothing in XML decides which, so the choice is a convention of the document."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_AttributesVersusElements a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET: (lambda a, b: (a.attrib, b.find('city').text, len(a), len(b)))(ET.fromstring('<address street=\\x27100 Larkin St.\\x27 city=\\x27San Francisco\\x27 />'), ET.fromstring('<address><city>San Francisco</city></address>')))(__import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to ({'street': '100 Larkin St.', 'city': 'San Francisco'}, 'San Francisco', 0, 1)"@en ; chx:input "(lambda ET: (lambda a, b: (a.attrib, b.find('city').text, len(a), len(b)))(ET.fromstring('<address street=\\x27100 Larkin St.\\x27 city=\\x27San Francisco\\x27 />'), ET.fromstring('<address><city>San Francisco</city></address>')))(__import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "({'street': '100 Larkin St.', 'city': 'San Francisco'}, 'San Francisco', 0, 1)" .
chx:X_AttributesVersusElements rd:hasIOExample chx:IO_AttributesVersusElements .
chx:X_ParseFunctions a owl:NamedIndividual, chx:ParseFunctions ; rdfs:label "ET.fromstring(xml_string)"@en ; skos:definition "ET.fromstring parses text and returns the root Element; ET.parse reads a file and returns an ElementTree, whose getroot gives the root Element."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ParseFunctions a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET, io: (lambda r, t: (r.tag, r.text, r.attrib, t.getroot().tag, type(t).__name__))(ET.fromstring('<a x=\\x271\\x27>hi</a>'), ET.parse(io.StringIO('<b/>'))))(__import__('xml.etree.ElementTree', fromlist=['_']), __import__('io')) evaluates to ('a', 'hi', {'x': '1'}, 'b', 'ElementTree')"@en ; chx:input "(lambda ET, io: (lambda r, t: (r.tag, r.text, r.attrib, t.getroot().tag, type(t).__name__))(ET.fromstring('<a x=\\x271\\x27>hi</a>'), ET.parse(io.StringIO('<b/>'))))(__import__('xml.etree.ElementTree', fromlist=['_']), __import__('io'))" ; chx:output "('a', 'hi', {'x': '1'}, 'b', 'ElementTree')" .
chx:X_ParseFunctions rd:hasIOExample chx:IO_ParseFunctions .
chx:X_ChildAccess a owl:NamedIndividual, chx:ChildAccess ; rdfs:label "[child.tag for child in root]"@en ; skos:definition "An Element is indexed like a list of its children, looped over for the children, and its iter method visits the element and all below it, optionally only those with one tag."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ChildAccess a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET: (lambda r: ([c.tag for c in r], [e.tag for e in r.iter()], [e.text for e in r.iter('number')]))(ET.fromstring('<p><n>A</n><ph><e><number>1</number></e><e><number>2</number></e></ph></p>')))(__import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to (['n', 'ph'], ['p', 'n', 'ph', 'e', 'number', 'e', 'number'], ['1', '2'])"@en ; chx:input "(lambda ET: (lambda r: ([c.tag for c in r], [e.tag for e in r.iter()], [e.text for e in r.iter('number')]))(ET.fromstring('<p><n>A</n><ph><e><number>1</number></e><e><number>2</number></e></ph></p>')))(__import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "(['n', 'ph'], ['p', 'n', 'ph', 'e', 'number', 'e', 'number'], ['1', '2'])" .
chx:X_ChildAccess rd:hasIOExample chx:IO_ChildAccess .
chx:X_FindElements a owl:NamedIndividual, chx:FindElements ; rdfs:label "[c.get('name') for c in root.findall('country')]"@en ; skos:definition "find and findall search the children by tag or by a small XPath path, and findall returns a list that is empty when nothing matches while find returns None."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_FindElements a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET: (lambda r: ([c.get('name') for c in r.findall('country')], r.find('country/rank').text, r.find('rank'), [n.get('name') for n in r.findall('.//neighbor[@direction=\\x27W\\x27]')]))(ET.fromstring('<data><country name=\\x27Liechtenstein\\x27><rank>1</rank><neighbor name=\\x27Austria\\x27 direction=\\x27E\\x27/><neighbor name=\\x27Switzerland\\x27 direction=\\x27W\\x27/></country><country name=\\x27Panama\\x27><rank>68</rank><neighbor name=\\x27Colombia\\x27 direction=\\x27E\\x27/></country></data>')))(__import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to (['Liechtenstein', 'Panama'], '1', None, ['Switzerland'])"@en ; chx:input "(lambda ET: (lambda r: ([c.get('name') for c in r.findall('country')], r.find('country/rank').text, r.find('rank'), [n.get('name') for n in r.findall('.//neighbor[@direction=\\x27W\\x27]')]))(ET.fromstring('<data><country name=\\x27Liechtenstein\\x27><rank>1</rank><neighbor name=\\x27Austria\\x27 direction=\\x27E\\x27/><neighbor name=\\x27Switzerland\\x27 direction=\\x27W\\x27/></country><country name=\\x27Panama\\x27><rank>68</rank><neighbor name=\\x27Colombia\\x27 direction=\\x27E\\x27/></country></data>')))(__import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "(['Liechtenstein', 'Panama'], '1', None, ['Switzerland'])" .
chx:X_FindElements rd:hasIOExample chx:IO_FindElements .
chx:X_BuildElements a owl:NamedIndividual, chx:BuildElements ; rdfs:label "ET.SubElement(person, 'name')"@en ; skos:definition "A document is built by making a root with Element and adding children with SubElement, setting text with the text attribute and attributes with set."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_BuildElements a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET: (lambda p: (lambda n: (n.set('first', 'Alice'), n.__setattr__('text', 'Alice Doe'), ET.tostring(p, encoding='unicode'))[2])(ET.SubElement(p, 'name')))(ET.Element('person')))(__import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to '<person><name first='Alice'>Alice Doe</name></person>'"@en ; chx:input "(lambda ET: (lambda p: (lambda n: (n.set('first', 'Alice'), n.__setattr__('text', 'Alice Doe'), ET.tostring(p, encoding='unicode'))[2])(ET.SubElement(p, 'name')))(ET.Element('person')))(__import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "'<person><name first='Alice'>Alice Doe</name></person>'" .
chx:X_BuildElements rd:hasIOExample chx:IO_BuildElements .
chx:X_ToStringBytes a owl:NamedIndividual, chx:ToStringBytes ; rdfs:label "ET.tostring(person, encoding='utf-8').decode('utf-8')"@en ; skos:definition "tostring returns bytes unless encoding='unicode' is given, which returns a string, and ET.indent adds line breaks and indentation before writing."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ToStringBytes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda ET: (lambda e: (type(ET.tostring(e)).__name__, type(ET.tostring(e, encoding='unicode')).__name__, ET.tostring(e, encoding='utf-8')))(ET.fromstring('<a><b/></a>')))(__import__('xml.etree.ElementTree', fromlist=['_'])) evaluates to ('bytes', 'str', b'<a><b /></a>')"@en ; chx:input "(lambda ET: (lambda e: (type(ET.tostring(e)).__name__, type(ET.tostring(e, encoding='unicode')).__name__, ET.tostring(e, encoding='utf-8')))(ET.fromstring('<a><b/></a>')))(__import__('xml.etree.ElementTree', fromlist=['_']))" ; chx:output "('bytes', 'str', b'<a><b /></a>')" .
chx:X_ToStringBytes rd:hasIOExample chx:IO_ToStringBytes .
chx:X_DomVersusSax a owl:NamedIndividual, chx:DomVersusSax ; rdfs:label "xml.dom, xml.sax"@en ; skos:definition "The DOM approach loads the whole document into memory and the SAX approach reads it as a stream of events, and ElementTree offers the tree plus iterparse for reading in steps."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DomVersusSax a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda md: [n.firstChild.data for n in md.parseString('<a><b>1</b><b>2</b></a>').getElementsByTagName('b')])(__import__('xml.dom.minidom', fromlist=['_'])) evaluates to ['1', '2']"@en ; chx:input "(lambda md: [n.firstChild.data for n in md.parseString('<a><b>1</b><b>2</b></a>').getElementsByTagName('b')])(__import__('xml.dom.minidom', fromlist=['_']))" ; chx:output "['1', '2']" .
