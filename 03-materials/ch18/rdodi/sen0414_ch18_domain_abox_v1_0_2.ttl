chx:X_FieldsAndRecords a owl:NamedIndividual, chx:FieldsAndRecords ; rdfs:label "spam,eggs\\r\\nbacon,ham"@en ; skos:definition "A CSV file is a list of records, one per line, and each record is a list of fields separated by commas; read from the text spam,eggs CRLF bacon,ham CRLF, csv.reader returned [['spam', 'eggs'], ['bacon', 'ham']], 2 records of 2 fields, 2 commas in the text, and every field a str."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_FieldsAndRecords a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'spam,eggs\\\\r\\\\nbacon,ham\\\\r\\\\n\\'\\nout = (rd(t), t.count(\\',\\'), len(rd(t)), {type(c).__name__ for r in rd(t) for c in r})', g), g['out'])[1])({}) evaluates to ([['spam', 'eggs'], ['bacon', 'ham']], 2, 2, {'str'})"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'spam,eggs\\\\r\\\\nbacon,ham\\\\r\\\\n\\'\\nout = (rd(t), t.count(\\',\\'), len(rd(t)), {type(c).__name__ for r in rd(t) for c in r})', g), g['out'])[1])({})" ; chx:output "([['spam', 'eggs'], ['bacon', 'ham']], 2, 2, {'str'})" .
chx:X_FieldsAndRecords rd:hasIOExample chx:IO_FieldsAndRecords .
chx:X_QuotedCommaField a owl:NamedIndividual, chx:QuotedCommaField ; rdfs:label "'Hello, world!',eggs"@en ; skos:definition "A field that contains a comma is enclosed in double quotes, and splitting on commas does not know it: the line 'Hello, world!',eggs,bacon,ham split into 5 pieces with str.split(',') and the first piece began with a quote, while csv.reader returned 4 fields and the first was Hello, world!."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_QuotedCommaField a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'\\x22Hello, world!\\x22,eggs,bacon,ham\\'\\nout = (t.split(\\',\\'), rd(t)[0])', g), g['out'])[1])({}) evaluates to ([''Hello', ' world!'', 'eggs', 'bacon', 'ham'], ['Hello, world!', 'eggs', 'bacon', 'ham'])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'\\x22Hello, world!\\x22,eggs,bacon,ham\\'\\nout = (t.split(\\',\\'), rd(t)[0])', g), g['out'])[1])({})" ; chx:output "([''Hello', ' world!'', 'eggs', 'bacon', 'ham'], ['Hello, world!', 'eggs', 'bacon', 'ham'])" .
chx:X_QuotedCommaField rd:hasIOExample chx:IO_QuotedCommaField .
chx:X_DoubledQuoteEscape a owl:NamedIndividual, chx:DoubledQuoteEscape ; rdfs:label "'say ''hi''',x"@en ; skos:definition "A double quote inside a quoted field is written twice: the text 'say ''hi''',x was read as the field say 'hi' followed by x, and writing the row back produced the same text with a CRLF ending."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DoubledQuoteEscape a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (rd(\\'\\x22say \\x22\\x22hi\\x22\\x22\\x22,x\\'), wr([[\\'say \\x22hi\\x22\\', \\'x\\']]))', g), g['out'])[1])({}) evaluates to ([['say 'hi'', 'x']], ''say ''hi''',x\\r\\n')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (rd(\\'\\x22say \\x22\\x22hi\\x22\\x22\\x22,x\\'), wr([[\\'say \\x22hi\\x22\\', \\'x\\']]))', g), g['out'])[1])({})" ; chx:output "([['say 'hi'', 'x']], ''say ''hi''',x\\r\\n')" .
chx:X_DoubledQuoteEscape rd:hasIOExample chx:IO_DoubledQuoteEscape .
chx:X_EmbeddedLineBreak a owl:NamedIndividual, chx:EmbeddedLineBreak ; rdfs:label "'two\\nlines',x"@en ; skos:definition "A quoted field may contain a line break, so a record can span lines: a text of 3 lines was read as 2 records, the first with the field two<LF>lines, and the writer wrote that field in quotes."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_EmbeddedLineBreak a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'\\x22two\\\\nlines\\x22,x\\\\r\\\\nnext,row\\\\r\\\\n\\'\\nout = (len(t.splitlines()), rd(t), wr([[\\'two\\\\nlines\\', \\'x\\']]))', g), g['out'])[1])({}) evaluates to (3, [['two\\nlines', 'x'], ['next', 'row']], ''two\\nlines',x\\r\\n')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'\\x22two\\\\nlines\\x22,x\\\\r\\\\nnext,row\\\\r\\\\n\\'\\nout = (len(t.splitlines()), rd(t), wr([[\\'two\\\\nlines\\', \\'x\\']]))', g), g['out'])[1])({})" ; chx:output "(3, [['two\\nlines', 'x'], ['next', 'row']], ''two\\nlines',x\\r\\n')" .
chx:X_EmbeddedLineBreak rd:hasIOExample chx:IO_EmbeddedLineBreak .
chx:X_LastRecordNoBreak a owl:NamedIndividual, chx:LastRecordNoBreak ; rdfs:label "a,b\\r\\nc,d"@en ; skos:definition "RFC 4180 says the last record may or may not have an ending line break, and csv.reader read a,b CRLF c,d with and without the final CRLF as the same two records, while an empty line between records was read as an empty record []."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_LastRecordNoBreak a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (rd(\\'a,b\\\\r\\\\nc,d\\'), rd(\\'a,b\\\\r\\\\nc,d\\\\r\\\\n\\'), rd(\\'a,b\\\\r\\\\n\\\\r\\\\nc,d\\'))', g), g['out'])[1])({}) evaluates to ([['a', 'b'], ['c', 'd']], [['a', 'b'], ['c', 'd']], [['a', 'b'], [], ['c', 'd']])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (rd(\\'a,b\\\\r\\\\nc,d\\'), rd(\\'a,b\\\\r\\\\nc,d\\\\r\\\\n\\'), rd(\\'a,b\\\\r\\\\n\\\\r\\\\nc,d\\'))', g), g['out'])[1])({})" ; chx:output "([['a', 'b'], ['c', 'd']], [['a', 'b'], ['c', 'd']], [['a', 'b'], [], ['c', 'd']])" .
chx:X_LastRecordNoBreak rd:hasIOExample chx:IO_LastRecordNoBreak .
chx:X_ExcelDialect a owl:NamedIndividual, chx:ExcelDialect ; rdfs:label "csv.excel"@en ; skos:definition "A dialect is a set of formatting parameters; the default, csv.excel, has delimiter ',', quotechar ''', doublequote True, skipinitialspace False, lineterminator CRLF and quoting QUOTE_MINIMAL (0), and the registered dialects are excel, excel-tab and unix."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ExcelDialect a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nd = csv.excel\\nout = (d.delimiter, d.quotechar, d.doublequote, d.skipinitialspace, d.lineterminator, d.quoting, sorted(csv.list_dialects()))', g), g['out'])[1])({}) evaluates to (',', ''', True, False, '\\r\\n', 0, ['excel', 'excel-tab', 'unix'])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nd = csv.excel\\nout = (d.delimiter, d.quotechar, d.doublequote, d.skipinitialspace, d.lineterminator, d.quoting, sorted(csv.list_dialects()))', g), g['out'])[1])({})" ; chx:output "(',', ''', True, False, '\\r\\n', 0, ['excel', 'excel-tab', 'unix'])" .
chx:X_ExcelDialect rd:hasIOExample chx:IO_ExcelDialect .
chx:X_TabDelimited a owl:NamedIndividual, chx:TabDelimited ; rdfs:label "writer(f, delimiter='\\t')"@en ; skos:definition "Passing delimiter='\\t' to csv.writer gave a tab-separated file; read back with the default delimiter the first line stayed one field and 'Hello, world!' broke at its comma, and read with delimiter='\\t' it gave the right fields, while the dialect excel-tab wrote the field with a tab inside in quotes."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_TabDelimited a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = wr([[\\'spam\\', \\'eggs\\'], [\\'Hello, world!\\', \\'ham\\']], delimiter=\\'\\\\t\\')\\nout = (t, rd(t), rd(t, delimiter=\\'\\\\t\\'), wr([[\\'a\\', \\'b c\\', \\'d\\\\te\\']], dialect=\\'excel-tab\\'))', g), g['out'])[1])({}) evaluates to ('spam\\teggs\\r\\nHello, world!\\tham\\r\\n', [['spam\\teggs'], ['Hello', ' world!\\tham']], [['spam', 'eggs'], ['Hello, world!', 'ham']], 'a\\tb c\\t'd\\te'\\r\\n')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = wr([[\\'spam\\', \\'eggs\\'], [\\'Hello, world!\\', \\'ham\\']], delimiter=\\'\\\\t\\')\\nout = (t, rd(t), rd(t, delimiter=\\'\\\\t\\'), wr([[\\'a\\', \\'b c\\', \\'d\\\\te\\']], dialect=\\'excel-tab\\'))', g), g['out'])[1])({})" ; chx:output "('spam\\teggs\\r\\nHello, world!\\tham\\r\\n', [['spam\\teggs'], ['Hello', ' world!\\tham']], [['spam', 'eggs'], ['Hello, world!', 'ham']], 'a\\tb c\\t'd\\te'\\r\\n')" .
chx:X_TabDelimited rd:hasIOExample chx:IO_TabDelimited .
chx:X_QuotingConstants a owl:NamedIndividual, chx:QuotingConstants ; rdfs:label "csv.QUOTE_MINIMAL"@en ; skos:definition "The quoting constants are QUOTE_MINIMAL 0, QUOTE_ALL 1, QUOTE_NONNUMERIC 2, QUOTE_NONE 3, QUOTE_STRINGS 4 and QUOTE_NOTNULL 5; the row ['a', 1, 2.5, None, '', 'b,c'] was written as a,1,2.5,,,'b,c' with the default, with every field quoted by QUOTE_ALL and with only the non-numbers quoted by QUOTE_NONNUMERIC."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_QuotingConstants a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nrow = [\\'a\\', 1, 2.5, None, \\'\\', \\'b,c\\']\\nout = ({n: getattr(csv, n) for n in sorted(dir(csv)) if n.startswith(\\'QUOTE_\\')}, [wr([row], quoting=q) for q in (csv.QUOTE_MINIMAL, csv.QUOTE_ALL, csv.QUOTE_NONNUMERIC)])', g), g['out'])[1])({}) evaluates to ({'QUOTE_ALL': 1, 'QUOTE_MINIMAL': 0, 'QUOTE_NONE': 3, 'QUOTE_NONNUMERIC': 2, 'QUOTE_NOTNULL': 5, 'QUOTE_STRINGS': 4}, ['a,1,2.5,,,'b,c'\\r\\n', ''a','1','2.5','','','b,c'\\r\\n', ''a',1,2.5,'','','b,c'\\r\\n'])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nrow = [\\'a\\', 1, 2.5, None, \\'\\', \\'b,c\\']\\nout = ({n: getattr(csv, n) for n in sorted(dir(csv)) if n.startswith(\\'QUOTE_\\')}, [wr([row], quoting=q) for q in (csv.QUOTE_MINIMAL, csv.QUOTE_ALL, csv.QUOTE_NONNUMERIC)])', g), g['out'])[1])({})" ; chx:output "({'QUOTE_ALL': 1, 'QUOTE_MINIMAL': 0, 'QUOTE_NONE': 3, 'QUOTE_NONNUMERIC': 2, 'QUOTE_NOTNULL': 5, 'QUOTE_STRINGS': 4}, ['a,1,2.5,,,'b,c'\\r\\n', ''a','1','2.5','','','b,c'\\r\\n', ''a',1,2.5,'','','b,c'\\r\\n'])" .
chx:X_QuotingConstants rd:hasIOExample chx:IO_QuotingConstants .
chx:X_DefaultEncodingIsLocale a owl:NamedIndividual, chx:DefaultEncodingIsLocale ; rdfs:label "open('x.csv')  # no encoding"@en ; skos:definition "open() without an encoding uses the locale encoding: in a child interpreter with LC_ALL=C and UTF-8 mode off, open().encoding was ANSI_X3.4-1968 and sys.flags.utf8_mode 0; with -X utf8=1 it was utf-8 while locale.getencoding() still reported ANSI_X3.4-1968."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DefaultEncodingIsLocale a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nenv = dict(os.environ, LC_ALL=\\'C\\', PYTHONCOERCECLOCALE=\\'0\\'); env.pop(\\'PYTHONUTF8\\', None)\\ncode = \\'import locale, sys, os; print(open(os.devnull).encoding, locale.getencoding(), sys.flags.utf8_mode)\\'\\na = subprocess.run([sys.executable, \\'-X\\', \\'utf8=0\\', \\'-c\\', code], capture_output=True, text=True, env=env).stdout.split()\\nb = subprocess.run([sys.executable, \\'-X\\', \\'utf8=1\\', \\'-c\\', code], capture_output=True, text=True, env=env).stdout.split()\\nout = (a, b)', g), g['out'])[1])({}) evaluates to (['ANSI_X3.4-1968', 'ANSI_X3.4-1968', '0'], ['utf-8', 'ANSI_X3.4-1968', '1'])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nenv = dict(os.environ, LC_ALL=\\'C\\', PYTHONCOERCECLOCALE=\\'0\\'); env.pop(\\'PYTHONUTF8\\', None)\\ncode = \\'import locale, sys, os; print(open(os.devnull).encoding, locale.getencoding(), sys.flags.utf8_mode)\\'\\na = subprocess.run([sys.executable, \\'-X\\', \\'utf8=0\\', \\'-c\\', code], capture_output=True, text=True, env=env).stdout.split()\\nb = subprocess.run([sys.executable, \\'-X\\', \\'utf8=1\\', \\'-c\\', code], capture_output=True, text=True, env=env).stdout.split()\\nout = (a, b)', g), g['out'])[1])({})" ; chx:output "(['ANSI_X3.4-1968', 'ANSI_X3.4-1968', '0'], ['utf-8', 'ANSI_X3.4-1968', '1'])" .
chx:X_DefaultEncodingIsLocale rd:hasIOExample chx:IO_DefaultEncodingIsLocale .
chx:X_BomUtf8Sig a owl:NamedIndividual, chx:BomUtf8Sig ; rdfs:label "open(f, encoding='utf-8-sig')"@en ; skos:definition "A file that Excel saves as CSV UTF-8 starts with the byte order mark EF BB BF; decoded as utf-8 the first field was \\ufeffName and a DictReader key was '\\ufeffName', decoded as utf-8-sig it was Name."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_BomUtf8Sig a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nraw = b\\'\\\\xef\\\\xbb\\\\xbfName,Age\\\\r\\\\nA,1\\\\r\\\\n\\'\\nout = (rd(raw.decode(\\'utf-8\\'))[0], rd(raw.decode(\\'utf-8-sig\\'))[0], [k for k in csv.DictReader(io.StringIO(raw.decode(\\'utf-8\\')))][0].keys().__repr__())', g), g['out'])[1])({}) evaluates to (['\\ufeffName', 'Age'], ['Name', 'Age'], 'dict_keys(['\\\\ufeffName', 'Age'])')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nraw = b\\'\\\\xef\\\\xbb\\\\xbfName,Age\\\\r\\\\nA,1\\\\r\\\\n\\'\\nout = (rd(raw.decode(\\'utf-8\\'))[0], rd(raw.decode(\\'utf-8-sig\\'))[0], [k for k in csv.DictReader(io.StringIO(raw.decode(\\'utf-8\\')))][0].keys().__repr__())', g), g['out'])[1])({})" ; chx:output "(['\\ufeffName', 'Age'], ['Name', 'Age'], 'dict_keys(['\\\\ufeffName', 'Age'])')" .
chx:X_BomUtf8Sig rd:hasIOExample chx:IO_BomUtf8Sig .
chx:X_Cp1252Mojibake a owl:NamedIndividual, chx:Cp1252Mojibake ; rdfs:label "open(f, encoding='cp1252')"@en ; skos:definition "Text decoded with the wrong encoding is garbled or refused: the UTF-8 bytes of Ad,Şehir / Çilek,İstanbul read as cp1252 gave Åžehir, Ã‡ilek and Ä°stanbul with no error, and read as cp1254 raised UnicodeDecodeError, a 'charmap' codec error for the byte 0x9e."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_Cp1252Mojibake a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nraw = \\'Ad,Şehir\\\\r\\\\nÇilek,İstanbul\\\\r\\\\n\\'.encode(\\'utf-8\\')\\ndef dec(e):\\n    try: return rd(raw.decode(e))\\n    except UnicodeDecodeError as x: return \\'UnicodeDecodeError: \\' + str(x)[:40]\\nout = (dec(\\'utf-8\\'), dec(\\'cp1252\\'), dec(\\'cp1254\\'))', g), g['out'])[1])({}) evaluates to ([['Ad', 'Şehir'], ['Çilek', 'İstanbul']], [['Ad', 'Åžehir'], ['Ã‡ilek', 'Ä°stanbul']], 'UnicodeDecodeError: 'charmap' codec can't decode byte 0x9e i')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nraw = \\'Ad,Şehir\\\\r\\\\nÇilek,İstanbul\\\\r\\\\n\\'.encode(\\'utf-8\\')\\ndef dec(e):\\n    try: return rd(raw.decode(e))\\n    except UnicodeDecodeError as x: return \\'UnicodeDecodeError: \\' + str(x)[:40]\\nout = (dec(\\'utf-8\\'), dec(\\'cp1252\\'), dec(\\'cp1254\\'))', g), g['out'])[1])({})" ; chx:output "([['Ad', 'Şehir'], ['Çilek', 'İstanbul']], [['Ad', 'Åžehir'], ['Ã‡ilek', 'Ä°stanbul']], 'UnicodeDecodeError: 'charmap' codec can't decode byte 0x9e i')" .
chx:X_Cp1252Mojibake rd:hasIOExample chx:IO_Cp1252Mojibake .
chx:X_ReaderEveryValueString a owl:NamedIndividual, chx:ReaderEveryValueString ; rdfs:label "list(csv.reader(f))"@en ; skos:definition "csv.reader returns every field as a str: the line 4/5/2035 13:34,Apples,73 gave ['4/5/2035 13:34', 'Apples', '73'], the types of the three fields were str, str, str and the number 73 had to be converted with int() to give 74."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ReaderEveryValueString a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nr = rd(\\'4/5/2035 13:34,Apples,73\\\\r\\\\n\\')\\nout = (r, [type(c).__name__ for c in r[0]], int(r[0][2]) + 1)', g), g['out'])[1])({}) evaluates to ([['4/5/2035 13:34', 'Apples', '73']], ['str', 'str', 'str'], 74)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nr = rd(\\'4/5/2035 13:34,Apples,73\\\\r\\\\n\\')\\nout = (r, [type(c).__name__ for c in r[0]], int(r[0][2]) + 1)', g), g['out'])[1])({})" ; chx:output "([['4/5/2035 13:34', 'Apples', '73']], ['str', 'str', 'str'], 74)" .
chx:X_ReaderEveryValueString rd:hasIOExample chx:IO_ReaderEveryValueString .
chx:X_ReaderUsedOnce a owl:NamedIndividual, chx:ReaderUsedOnce ; rdfs:label "list(reader) twice"@en ; skos:definition "A reader object is an iterator over rows, with no len() and no index: list() on a reader of two rows gave 2 rows and a second list() gave 0, hasattr(reader, '__len__') and hasattr(reader, '__getitem__') were both False and the type is named reader."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ReaderUsedOnce a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nreader = csv.reader(io.StringIO(\\'a,b\\\\r\\\\nc,d\\\\r\\\\n\\', newline=\\'\\'))\\nout = (len(list(reader)), len(list(reader)), hasattr(reader, \\'__len__\\'), hasattr(reader, \\'__getitem__\\'), type(reader).__name__)', g), g['out'])[1])({}) evaluates to (2, 0, False, False, 'reader')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nreader = csv.reader(io.StringIO(\\'a,b\\\\r\\\\nc,d\\\\r\\\\n\\', newline=\\'\\'))\\nout = (len(list(reader)), len(list(reader)), hasattr(reader, \\'__len__\\'), hasattr(reader, \\'__getitem__\\'), type(reader).__name__)', g), g['out'])[1])({})" ; chx:output "(2, 0, False, False, 'reader')" .
chx:X_ReaderUsedOnce rd:hasIOExample chx:IO_ReaderUsedOnce .
chx:X_LineNumVsRecords a owl:NamedIndividual, chx:LineNumVsRecords ; rdfs:label "reader.line_num"@en ; skos:definition "reader.line_num counts the lines read from the source and not the records: for a header cell Name<LF>(first) the records ended at line_num 2, 3 and 4, and the book's test line_num != 1 kept 3 of 3 records, the header record included."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_LineNumVsRecords a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nreader = csv.reader(io.StringIO(\\'\\x22Name\\\\n(first)\\x22,Age\\\\r\\\\nAlice,30\\\\r\\\\nBob,25\\\\r\\\\n\\', newline=\\'\\'))\\nseen = [(row, reader.line_num) for row in reader]\\nr2 = csv.reader(io.StringIO(\\'\\x22Name\\\\n(first)\\x22,Age\\\\r\\\\nAlice,30\\\\r\\\\nBob,25\\\\r\\\\n\\', newline=\\'\\'))\\nbook = [row for row in r2 if r2.line_num != 1]\\nout = (seen, len(book), book[0])', g), g['out'])[1])({}) evaluates to ([(['Name\\n(first)', 'Age'], 2), (['Alice', '30'], 3), (['Bob', '25'], 4)], 3, ['Name\\n(first)', 'Age'])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nreader = csv.reader(io.StringIO(\\'\\x22Name\\\\n(first)\\x22,Age\\\\r\\\\nAlice,30\\\\r\\\\nBob,25\\\\r\\\\n\\', newline=\\'\\'))\\nseen = [(row, reader.line_num) for row in reader]\\nr2 = csv.reader(io.StringIO(\\'\\x22Name\\\\n(first)\\x22,Age\\\\r\\\\nAlice,30\\\\r\\\\nBob,25\\\\r\\\\n\\', newline=\\'\\'))\\nbook = [row for row in r2 if r2.line_num != 1]\\nout = (seen, len(book), book[0])', g), g['out'])[1])({})" ; chx:output "([(['Name\\n(first)', 'Age'], 2), (['Alice', '30'], 3), (['Bob', '25'], 4)], 3, ['Name\\n(first)', 'Age'])" .
chx:X_LineNumVsRecords rd:hasIOExample chx:IO_LineNumVsRecords .
chx:X_LoopSavesMemory a owl:NamedIndividual, chx:LoopSavesMemory ; rdfs:label "for row in reader"@en ; skos:definition "A for loop over the reader needs far less memory than list(reader): for 60,000 rows the peak traced by tracemalloc was more than 10 times higher for list(); both counted 60,000 rows."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_LoopSavesMemory a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nbig = \\'\\'.join(\\'%d,Apples,%d\\\\r\\\\n\\' % (i, i * 2) for i in range(60000))\\ndef peak(f):\\n    s = io.StringIO(big, newline=\\'\\'); tracemalloc.start(); n = f(s); p = tracemalloc.get_traced_memory()[1]; tracemalloc.stop(); return n, p\\ndef as_list(s): return len(list(csv.reader(s)))\\ndef as_loop(s):\\n    n = 0\\n    for row in csv.reader(s): n += 1\\n    return n\\n(n1, pl), (n2, pf) = peak(as_list), peak(as_loop)\\nout = (n1, n2, pl > 10 * pf)', g), g['out'])[1])({}) evaluates to (60000, 60000, True)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nbig = \\'\\'.join(\\'%d,Apples,%d\\\\r\\\\n\\' % (i, i * 2) for i in range(60000))\\ndef peak(f):\\n    s = io.StringIO(big, newline=\\'\\'); tracemalloc.start(); n = f(s); p = tracemalloc.get_traced_memory()[1]; tracemalloc.stop(); return n, p\\ndef as_list(s): return len(list(csv.reader(s)))\\ndef as_loop(s):\\n    n = 0\\n    for row in csv.reader(s): n += 1\\n    return n\\n(n1, pl), (n2, pf) = peak(as_list), peak(as_loop)\\nout = (n1, n2, pl > 10 * pf)', g), g['out'])[1])({})" ; chx:output "(60000, 60000, True)" .
chx:X_LoopSavesMemory rd:hasIOExample chx:IO_LoopSavesMemory .
chx:X_WriterReturnsLength a owl:NamedIndividual, chx:WriterReturnsLength ; rdfs:label "writer.writerow(row)"@en ; skos:definition "writerow() returns the number of characters written, and the three rows of the chapter returned 21, 32 and 16, for a text of 69 characters with 3 CRLF endings."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_WriterReturnsLength a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ns = io.StringIO(newline=\\'\\'); w = csv.writer(s)\\nn = [w.writerow(r) for r in ([\\'spam\\', \\'eggs\\', \\'bacon\\', \\'ham\\'], [\\'Hello, world!\\', \\'eggs\\', \\'bacon\\', \\'ham\\'], [1, 2, 3.141592, 4])]\\nout = (n, len(s.getvalue()), s.getvalue().count(\\'\\\\r\\\\n\\'))', g), g['out'])[1])({}) evaluates to ([21, 32, 16], 69, 3)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ns = io.StringIO(newline=\\'\\'); w = csv.writer(s)\\nn = [w.writerow(r) for r in ([\\'spam\\', \\'eggs\\', \\'bacon\\', \\'ham\\'], [\\'Hello, world!\\', \\'eggs\\', \\'bacon\\', \\'ham\\'], [1, 2, 3.141592, 4])]\\nout = (n, len(s.getvalue()), s.getvalue().count(\\'\\\\r\\\\n\\'))', g), g['out'])[1])({})" ; chx:output "([21, 32, 16], 69, 3)" .
chx:X_WriterReturnsLength rd:hasIOExample chx:IO_WriterReturnsLength .
chx:X_WriterTypes a owl:NamedIndividual, chx:WriterTypes ; rdfs:label "writerow([None, True, 1.0])"@en ; skos:definition "The writer converts every value with str(): None became an empty field, True became True, 1.0 stayed 1.0, 10**20 and 1e-07 were written in full as 100000000000000000000 and 1e-07, a list became its repr in quotes, and the reader returned them all as strings; writerow(5) raised Error: iterable expected, not int."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_WriterTypes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (wr([[None, True, 1.0, 10**20, 1e-07, \\'É\\', [\\'x\\', 1]]]), rd(wr([[None, True, 1.0]])), err(lambda: csv.writer(io.StringIO()).writerow(5)))', g), g['out'])[1])({}) evaluates to (',True,1.0,100000000000000000000,1e-07,É,'[\\'x\\', 1]'\\r\\n', [['', 'True', '1.0']], ('Error', 'iterable expected, not int'))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (wr([[None, True, 1.0, 10**20, 1e-07, \\'É\\', [\\'x\\', 1]]]), rd(wr([[None, True, 1.0]])), err(lambda: csv.writer(io.StringIO()).writerow(5)))', g), g['out'])[1])({})" ; chx:output "(',True,1.0,100000000000000000000,1e-07,É,'[\\'x\\', 1]'\\r\\n', [['', 'True', '1.0']], ('Error', 'iterable expected, not int'))" .
chx:X_WriterTypes rd:hasIOExample chx:IO_WriterTypes .
chx:X_WriterDoubleSpacing a owl:NamedIndividual, chx:WriterDoubleSpacing ; rdfs:label "open(f, 'w')  # without newline=''"@en ; skos:definition "On Windows a text file opened without newline='' translates LF to CRLF and the writer's CRLF becomes CR CR LF; reproduced with an io.TextIOWrapper asked for newline CRLF, the bytes were a,b CR CR LF against a,b CR LF with newline='', and csv.reader returned a second, empty, record after the row."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_WriterDoubleSpacing a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef write_through(newline):\\n    b = io.BytesIO(); f = io.TextIOWrapper(b, encoding=\\'utf-8\\', newline=newline); csv.writer(f).writerow([\\'a\\', \\'b\\']); f.flush(); return b.getvalue()\\nwin = write_through(\\'\\\\r\\\\n\\')\\nout = (write_through(\\'\\'), win, rd(win.decode()), [len(r) for r in rd(win.decode())])', g), g['out'])[1])({}) evaluates to (b'a,b\\r\\n', b'a,b\\r\\r\\n', [['a', 'b'], []], [2, 0])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef write_through(newline):\\n    b = io.BytesIO(); f = io.TextIOWrapper(b, encoding=\\'utf-8\\', newline=newline); csv.writer(f).writerow([\\'a\\', \\'b\\']); f.flush(); return b.getvalue()\\nwin = write_through(\\'\\\\r\\\\n\\')\\nout = (write_through(\\'\\'), win, rd(win.decode()), [len(r) for r in rd(win.decode())])', g), g['out'])[1])({})" ; chx:output "(b'a,b\\r\\n', b'a,b\\r\\r\\n', [['a', 'b'], []], [2, 0])" .
chx:X_WriterDoubleSpacing rd:hasIOExample chx:IO_WriterDoubleSpacing .
chx:X_DictReaderFirstRowKeys a owl:NamedIndividual, chx:DictReaderFirstRowKeys ; rdfs:label "csv.DictReader(f)"@en ; skos:definition "DictReader uses the first row as the keys and returns a dict per row, here {'Timestamp': '4/5/2025 13:34', 'Fruit': 'Apples', 'Quantity': '73'}; given fieldnames of its own, the header row became data and the first dict was {'time': 'Timestamp', 'name': 'Fruit', 'amount': 'Quantity'}."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DictReaderFirstRowKeys a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'Timestamp,Fruit,Quantity\\\\r\\\\n4/5/2025 13:34,Apples,73\\\\r\\\\n\\'\\nd = list(csv.DictReader(io.StringIO(t, newline=\\'\\')))\\nout = (d, type(d[0]).__name__, list(csv.DictReader(io.StringIO(t, newline=\\'\\'), [\\'time\\', \\'name\\', \\'amount\\']))[0])', g), g['out'])[1])({}) evaluates to ([{'Timestamp': '4/5/2025 13:34', 'Fruit': 'Apples', 'Quantity': '73'}], 'dict', {'time': 'Timestamp', 'name': 'Fruit', 'amount': 'Quantity'})"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'Timestamp,Fruit,Quantity\\\\r\\\\n4/5/2025 13:34,Apples,73\\\\r\\\\n\\'\\nd = list(csv.DictReader(io.StringIO(t, newline=\\'\\')))\\nout = (d, type(d[0]).__name__, list(csv.DictReader(io.StringIO(t, newline=\\'\\'), [\\'time\\', \\'name\\', \\'amount\\']))[0])', g), g['out'])[1])({})" ; chx:output "([{'Timestamp': '4/5/2025 13:34', 'Fruit': 'Apples', 'Quantity': '73'}], 'dict', {'time': 'Timestamp', 'name': 'Fruit', 'amount': 'Quantity'})" .
chx:X_DictReaderFirstRowKeys rd:hasIOExample chx:IO_DictReaderFirstRowKeys .
chx:X_RestkeyRestval a owl:NamedIndividual, chx:RestkeyRestval ; rdfs:label "DictReader(f, restkey='extra')"@en ; skos:definition "A row longer than the header put the extra values in a list under the key None, or under restkey='extra', and a row shorter than the header gave None for the missing keys, or the value of restval='?'."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_RestkeyRestval a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nlonger = list(csv.DictReader(io.StringIO(\\'a,b\\\\r\\\\n1,2,3,4\\\\r\\\\n\\', newline=\\'\\')))\\nlonger_k = list(csv.DictReader(io.StringIO(\\'a,b\\\\r\\\\n1,2,3,4\\\\r\\\\n\\', newline=\\'\\'), restkey=\\'extra\\'))\\nshorter = list(csv.DictReader(io.StringIO(\\'a,b,c\\\\r\\\\n1\\\\r\\\\n\\', newline=\\'\\')))\\nshorter_v = list(csv.DictReader(io.StringIO(\\'a,b,c\\\\r\\\\n1\\\\r\\\\n\\', newline=\\'\\'), restval=\\'?\\'))\\nout = (longer, longer_k, shorter, shorter_v)', g), g['out'])[1])({}) evaluates to ([{'a': '1', 'b': '2', None: ['3', '4']}], [{'a': '1', 'b': '2', 'extra': ['3', '4']}], [{'a': '1', 'b': None, 'c': None}], [{'a': '1', 'b': '?', 'c': '?'}])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nlonger = list(csv.DictReader(io.StringIO(\\'a,b\\\\r\\\\n1,2,3,4\\\\r\\\\n\\', newline=\\'\\')))\\nlonger_k = list(csv.DictReader(io.StringIO(\\'a,b\\\\r\\\\n1,2,3,4\\\\r\\\\n\\', newline=\\'\\'), restkey=\\'extra\\'))\\nshorter = list(csv.DictReader(io.StringIO(\\'a,b,c\\\\r\\\\n1\\\\r\\\\n\\', newline=\\'\\')))\\nshorter_v = list(csv.DictReader(io.StringIO(\\'a,b,c\\\\r\\\\n1\\\\r\\\\n\\', newline=\\'\\'), restval=\\'?\\'))\\nout = (longer, longer_k, shorter, shorter_v)', g), g['out'])[1])({})" ; chx:output "([{'a': '1', 'b': '2', None: ['3', '4']}], [{'a': '1', 'b': '2', 'extra': ['3', '4']}], [{'a': '1', 'b': None, 'c': None}], [{'a': '1', 'b': '?', 'c': '?'}])" .
chx:X_RestkeyRestval rd:hasIOExample chx:IO_RestkeyRestval .
chx:X_DictWriterExtraKey a owl:NamedIndividual, chx:DictWriterExtraKey ; rdfs:label "DictWriter(f, fieldnames)"@en ; skos:definition "DictWriter.writeheader() returned 10 and writerow() 6; a dict with a key that is not in fieldnames raised ValueError: dict contains fields not in fieldnames: 'Age', and extrasaction='ignore' dropped the key."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DictWriterExtraKey a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ns = io.StringIO(newline=\\'\\'); w = csv.DictWriter(s, [\\'Name\\', \\'Pet\\'])\\nh = w.writeheader(); n = w.writerow({\\'Name\\': \\'Bob\\'})\\ne = err(lambda: w.writerow({\\'Name\\': \\'x\\', \\'Age\\': 3}))\\ni = io.StringIO(newline=\\'\\'); w2 = csv.DictWriter(i, [\\'x\\'], extrasaction=\\'ignore\\'); w2.writerow({\\'x\\': 1, \\'y\\': 2})\\nout = (h, n, s.getvalue(), e, i.getvalue())', g), g['out'])[1])({}) evaluates to (10, 6, 'Name,Pet\\r\\nBob,\\r\\n', ('ValueError', 'dict contains fields not in fieldnames: 'Age''), '1\\r\\n')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ns = io.StringIO(newline=\\'\\'); w = csv.DictWriter(s, [\\'Name\\', \\'Pet\\'])\\nh = w.writeheader(); n = w.writerow({\\'Name\\': \\'Bob\\'})\\ne = err(lambda: w.writerow({\\'Name\\': \\'x\\', \\'Age\\': 3}))\\ni = io.StringIO(newline=\\'\\'); w2 = csv.DictWriter(i, [\\'x\\'], extrasaction=\\'ignore\\'); w2.writerow({\\'x\\': 1, \\'y\\': 2})\\nout = (h, n, s.getvalue(), e, i.getvalue())', g), g['out'])[1])({})" ; chx:output "(10, 6, 'Name,Pet\\r\\nBob,\\r\\n', ('ValueError', 'dict contains fields not in fieldnames: 'Age''), '1\\r\\n')" .
chx:X_DictWriterExtraKey rd:hasIOExample chx:IO_DictWriterExtraKey .
chx:X_FieldSizeLimit a owl:NamedIndividual, chx:FieldSizeLimit ; rdfs:label "csv.field_size_limit()"@en ; skos:definition "csv.field_size_limit() is 131072 characters; a field of 131073 characters raised Error: field larger than field limit (131072) and a field of exactly 131072 characters was read."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_FieldSizeLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nlim = csv.field_size_limit()\\nbig = \\'a\\' * (lim + 1)\\nout = (lim, err(lambda: rd(big)), len(rd(\\'a\\' * lim)[0][0]))', g), g['out'])[1])({}) evaluates to (131072, ('Error', 'field larger than field limit (131072)'), 131072)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nlim = csv.field_size_limit()\\nbig = \\'a\\' * (lim + 1)\\nout = (lim, err(lambda: rd(big)), len(rd(\\'a\\' * lim)[0][0]))', g), g['out'])[1])({})" ; chx:output "(131072, ('Error', 'field larger than field limit (131072)'), 131072)" .
chx:X_FieldSizeLimit rd:hasIOExample chx:IO_FieldSizeLimit .
chx:X_QuoteStringsNotNull a owl:NamedIndividual, chx:QuoteStringsNotNull ; rdfs:label "quoting=csv.QUOTE_NOTNULL"@en ; skos:definition "QUOTE_NOTNULL and QUOTE_STRINGS (new in Python 3.12) separate None from the empty string: reading 'a',,'',3 gave '' for the unquoted empty field by default, None with QUOTE_NOTNULL, and with QUOTE_STRINGS None and the unquoted 3 as the float 3.0; writing ['a', None, '', 3] with QUOTE_STRINGS gave 'a',,'',3."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_QuoteStringsNotNull a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'\\x22a\\x22,,\\x22\\x22,3\\\\r\\\\n\\'\\nout = (rd(t), rd(t, quoting=csv.QUOTE_NOTNULL), rd(t, quoting=csv.QUOTE_STRINGS), wr([[\\'a\\', None, \\'\\', 3]], quoting=csv.QUOTE_STRINGS), wr([[\\'a\\', None, \\'\\', 3]], quoting=csv.QUOTE_NOTNULL))', g), g['out'])[1])({}) evaluates to ([['a', '', '', '3']], [['a', None, '', '3']], [['a', None, '', 3.0]], ''a',,'',3\\r\\n', ''a',,'','3'\\r\\n')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'\\x22a\\x22,,\\x22\\x22,3\\\\r\\\\n\\'\\nout = (rd(t), rd(t, quoting=csv.QUOTE_NOTNULL), rd(t, quoting=csv.QUOTE_STRINGS), wr([[\\'a\\', None, \\'\\', 3]], quoting=csv.QUOTE_STRINGS), wr([[\\'a\\', None, \\'\\', 3]], quoting=csv.QUOTE_NOTNULL))', g), g['out'])[1])({})" ; chx:output "([['a', '', '', '3']], [['a', None, '', '3']], [['a', None, '', 3.0]], ''a',,'',3\\r\\n', ''a',,'','3'\\r\\n')" .
chx:X_QuoteStringsNotNull rd:hasIOExample chx:IO_QuoteStringsNotNull .
chx:X_SixValueTypes a owl:NamedIndividual, chx:SixValueTypes ; rdfs:label "json.loads(text)"@en ; skos:definition "JSON has six value types (string, number, object, array, true and false, null); json.loads of the chapter's Alice text gave a dict with str, int, NoneType, bool, dict and list values, equal to the original Python data, and the compact text is 248 characters."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_SixValueTypes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nd = json.loads(json.dumps(A))\\nout = ([(k, type(v).__name__) for k, v in d.items()], d == A, json.dumps(A) == json.dumps(json.loads(json.dumps(A))), len(json.dumps(A)))', g), g['out'])[1])({}) evaluates to ([('name', 'str'), ('age', 'int'), ('car', 'NoneType'), ('programmer', 'bool'), ('address', 'dict'), ('phone', 'list')], True, True, 248)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nd = json.loads(json.dumps(A))\\nout = ([(k, type(v).__name__) for k, v in d.items()], d == A, json.dumps(A) == json.dumps(json.loads(json.dumps(A))), len(json.dumps(A)))', g), g['out'])[1])({})" ; chx:output "([('name', 'str'), ('age', 'int'), ('car', 'NoneType'), ('programmer', 'bool'), ('address', 'dict'), ('phone', 'list')], True, True, 248)" .
chx:X_SixValueTypes rd:hasIOExample chx:IO_SixValueTypes .
chx:X_TrailingCommaRefused a owl:NamedIndividual, chx:TrailingCommaRefused ; rdfs:label "['spam', 'eggs',]"@en ; skos:definition "JSON does not allow a trailing comma, single quotes or comments: json.loads of ['spam', 'eggs',] raised JSONDecodeError 'Illegal trailing comma before end of array' at line 1 column 16 (pos 15), the same for an object, '{'a': 1}' gave 'Expecting property name enclosed in double quotes' and a // comment gave 'Extra data'."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_TrailingCommaRefused a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef msg(t):\\n    try: json.loads(t); return \\'accepted\\'\\n    except json.JSONDecodeError as e: return (e.msg, e.lineno, e.colno, e.pos)\\nout = (msg(\\'[\\x22spam\\x22, \\x22eggs\\x22]\\'), msg(\\'[\\x22spam\\x22, \\x22eggs\\x22,]\\'), msg(\\'{\\x22a\\x22: 1,}\\'), msg(\\x22{\\'a\\': 1}\\x22), msg(\\'{\\x22a\\x22: 1} // note\\'))', g), g['out'])[1])({}) evaluates to ('accepted', ('Illegal trailing comma before end of array', 1, 16, 15), ('Illegal trailing comma before end of object', 1, 8, 7), ('Expecting property name enclosed in double quotes', 1, 2, 1), ('Extra data', 1, 10, 9))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef msg(t):\\n    try: json.loads(t); return \\'accepted\\'\\n    except json.JSONDecodeError as e: return (e.msg, e.lineno, e.colno, e.pos)\\nout = (msg(\\'[\\x22spam\\x22, \\x22eggs\\x22]\\'), msg(\\'[\\x22spam\\x22, \\x22eggs\\x22,]\\'), msg(\\'{\\x22a\\x22: 1,}\\'), msg(\\x22{\\'a\\': 1}\\x22), msg(\\'{\\x22a\\x22: 1} // note\\'))', g), g['out'])[1])({})" ; chx:output "('accepted', ('Illegal trailing comma before end of array', 1, 16, 15), ('Illegal trailing comma before end of object', 1, 8, 7), ('Expecting property name enclosed in double quotes', 1, 2, 1), ('Extra data', 1, 10, 9))" .
chx:X_TrailingCommaRefused rd:hasIOExample chx:IO_TrailingCommaRefused .
chx:X_RawNewlineInString a owl:NamedIndividual, chx:RawNewlineInString ; rdfs:label "'a<LF>b'"@en ; skos:definition "A raw line feed inside a JSON string is refused with 'Invalid control character at', and so is a raw tab; the escape \\n is accepted, and json.loads(..., strict=False) accepts the tab."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_RawNewlineInString a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef msg(t, **k):\\n    try: return json.loads(t, **k)\\n    except json.JSONDecodeError as e: return e.msg\\nout = (msg(\\'\\x22a\\\\nb\\x22\\'), msg(\\'\\x22a\\\\\\\\nb\\x22\\'), msg(\\'\\x22a\\\\tb\\x22\\'), msg(\\'\\x22a\\\\tb\\x22\\', strict=False))', g), g['out'])[1])({}) evaluates to ('Invalid control character at', 'a\\nb', 'Invalid control character at', 'a\\tb')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef msg(t, **k):\\n    try: return json.loads(t, **k)\\n    except json.JSONDecodeError as e: return e.msg\\nout = (msg(\\'\\x22a\\\\nb\\x22\\'), msg(\\'\\x22a\\\\\\\\nb\\x22\\'), msg(\\'\\x22a\\\\tb\\x22\\'), msg(\\'\\x22a\\\\tb\\x22\\', strict=False))', g), g['out'])[1])({})" ; chx:output "('Invalid control character at', 'a\\nb', 'Invalid control character at', 'a\\tb')" .
chx:X_RawNewlineInString rd:hasIOExample chx:IO_RawNewlineInString .
chx:X_NaNAcceptedByPython a owl:NamedIndividual, chx:NaNAcceptedByPython ; rdfs:label "json.loads('[NaN]')"@en ; skos:definition "Python's json accepts what RFC 8259 does not allow: json.loads('[NaN, Infinity, -Infinity]') returned [nan, inf, -inf], dumps wrote [NaN, Infinity] and allow_nan=False raised ValueError: Out of range float values are not JSON compliant."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_NaNAcceptedByPython a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (json.loads(\\'[NaN, Infinity, -Infinity]\\'), json.dumps([float(\\'nan\\'), float(\\'inf\\')]), err(lambda: json.dumps(float(\\'nan\\'), allow_nan=False)))', g), g['out'])[1])({}) evaluates to ([nan, inf, -inf], '[NaN, Infinity]', ('ValueError', 'Out of range float values are not JSON compliant: nan'))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (json.loads(\\'[NaN, Infinity, -Infinity]\\'), json.dumps([float(\\'nan\\'), float(\\'inf\\')]), err(lambda: json.dumps(float(\\'nan\\'), allow_nan=False)))', g), g['out'])[1])({})" ; chx:output "([nan, inf, -inf], '[NaN, Infinity]', ('ValueError', 'Out of range float values are not JSON compliant: nan'))" .
chx:X_NaNAcceptedByPython rd:hasIOExample chx:IO_NaNAcceptedByPython .
chx:X_TupleBecomesList a owl:NamedIndividual, chx:TupleBecomesList ; rdfs:label "json.dumps((1, 2))"@en ; skos:definition "JSON has no tuple: json.dumps((1, 2)) is [1, 2] and loads gives a list, so the round trip of {'t': (1, 2)} is not equal to the original, and a set raised TypeError: Object of type set is not JSON serializable."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_TupleBecomesList a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (json.dumps((1, 2)), json.loads(json.dumps({\\'t\\': (1, 2)})), json.loads(json.dumps({\\'t\\': (1, 2)})) == {\\'t\\': (1, 2)}, err(lambda: json.dumps({1, 2})))', g), g['out'])[1])({}) evaluates to ('[1, 2]', {'t': [1, 2]}, False, ('TypeError', 'Object of type set is not JSON serializable'))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (json.dumps((1, 2)), json.loads(json.dumps({\\'t\\': (1, 2)})), json.loads(json.dumps({\\'t\\': (1, 2)})) == {\\'t\\': (1, 2)}, err(lambda: json.dumps({1, 2})))', g), g['out'])[1])({})" ; chx:output "('[1, 2]', {'t': [1, 2]}, False, ('TypeError', 'Object of type set is not JSON serializable'))" .
chx:X_TupleBecomesList rd:hasIOExample chx:IO_TupleBecomesList .
chx:X_KeysBecomeStrings a owl:NamedIndividual, chx:KeysBecomeStrings ; rdfs:label "json.dumps({1: 'a'})"@en ; skos:definition "JSON object keys are strings: {1: 'a', 2.5: 'b', None: 'c', True: 'd'} was written with the keys '1' (True replaced the value of 1), '2.5' and 'null', and a tuple key raised TypeError: keys must be str, int, float, bool or None, not tuple."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_KeysBecomeStrings a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ns = json.dumps({1: \\'a\\', 2.5: \\'b\\', None: \\'c\\', True: \\'d\\'})\\nout = (s, list(json.loads(s)), err(lambda: json.dumps({(1, 2): \\'x\\'})))', g), g['out'])[1])({}) evaluates to ('{'1': 'd', '2.5': 'b', 'null': 'c'}', ['1', '2.5', 'null'], ('TypeError', 'keys must be str, int, float, bool or None, not tuple'))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ns = json.dumps({1: \\'a\\', 2.5: \\'b\\', None: \\'c\\', True: \\'d\\'})\\nout = (s, list(json.loads(s)), err(lambda: json.dumps({(1, 2): \\'x\\'})))', g), g['out'])[1])({})" ; chx:output "('{'1': 'd', '2.5': 'b', 'null': 'c'}', ['1', '2.5', 'null'], ('TypeError', 'keys must be str, int, float, bool or None, not tuple'))" .
chx:X_KeysBecomeStrings rd:hasIOExample chx:IO_KeysBecomeStrings .
chx:X_UnsupportedTypesRaise a owl:NamedIndividual, chx:UnsupportedTypesRaise ; rdfs:label "json.dumps(datetime)"@en ; skos:definition "datetime, Decimal, bytes and complex values raise TypeError: Object of type ... is not JSON serializable, and default=str turned the datetime into '2035-04-05 13:34:00' and the Decimal into '1.5'."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_UnsupportedTypesRaise a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport datetime, decimal\\nout = [err(lambda v=v: json.dumps(v))[1] for v in (datetime.datetime(2035, 4, 5, 13, 34), decimal.Decimal(\\'1.5\\'), b\\'x\\', 1j)] + [json.dumps({\\'when\\': datetime.datetime(2035, 4, 5, 13, 34), \\'x\\': decimal.Decimal(\\'1.5\\')}, default=str)]', g), g['out'])[1])({}) evaluates to ['Object of type datetime is not JSON serializable', 'Object of type Decimal is not JSON serializable', 'Object of type bytes is not JSON serializable', 'Object of type complex is not JSON serializable', '{'when': '2035-04-05 13:34:00', 'x': '1.5'}']"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport datetime, decimal\\nout = [err(lambda v=v: json.dumps(v))[1] for v in (datetime.datetime(2035, 4, 5, 13, 34), decimal.Decimal(\\'1.5\\'), b\\'x\\', 1j)] + [json.dumps({\\'when\\': datetime.datetime(2035, 4, 5, 13, 34), \\'x\\': decimal.Decimal(\\'1.5\\')}, default=str)]', g), g['out'])[1])({})" ; chx:output "['Object of type datetime is not JSON serializable', 'Object of type Decimal is not JSON serializable', 'Object of type bytes is not JSON serializable', 'Object of type complex is not JSON serializable', '{'when': '2035-04-05 13:34:00', 'x': '1.5'}']" .
chx:X_UnsupportedTypesRaise rd:hasIOExample chx:IO_UnsupportedTypesRaise .
chx:X_IndentAndSeparators a owl:NamedIndividual, chx:IndentAndSeparators ; rdfs:label "json.dumps(data, indent=2)"@en ; skos:definition "indent=2 pretty-prints the Alice data in 21 lines and 326 characters, and loads reads it back equal; separators=(',', ':') gives 225 characters, indent='\\t' tabs, indent=0 only line breaks, and sort_keys=True starts with address, age, car."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_IndentAndSeparators a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\np = json.dumps(A, indent=2)\\nout = (len(p.split(\\'\\\\n\\')), len(p), json.loads(p) == A, len(json.dumps(A, separators=(\\',\\', \\':\\'))), json.dumps({\\'a\\': [1]}, indent=\\'\\\\t\\'), json.dumps({\\'a\\': [1]}, indent=0), list(json.loads(json.dumps(A, sort_keys=True)))[:3])', g), g['out'])[1])({}) evaluates to (21, 326, True, 225, '{\\n\\t'a': [\\n\\t\\t1\\n\\t]\\n}', '{\\n'a': [\\n1\\n]\\n}', ['address', 'age', 'car'])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\np = json.dumps(A, indent=2)\\nout = (len(p.split(\\'\\\\n\\')), len(p), json.loads(p) == A, len(json.dumps(A, separators=(\\',\\', \\':\\'))), json.dumps({\\'a\\': [1]}, indent=\\'\\\\t\\'), json.dumps({\\'a\\': [1]}, indent=0), list(json.loads(json.dumps(A, sort_keys=True)))[:3])', g), g['out'])[1])({})" ; chx:output "(21, 326, True, 225, '{\\n\\t'a': [\\n\\t\\t1\\n\\t]\\n}', '{\\n'a': [\\n1\\n]\\n}', ['address', 'age', 'car'])" .
chx:X_IndentAndSeparators rd:hasIOExample chx:IO_IndentAndSeparators .
chx:X_EnsureAscii a owl:NamedIndividual, chx:EnsureAscii ; rdfs:label "json.dumps(s, ensure_ascii=False)"@en ; skos:definition "By default json.dumps writes non-ASCII text as \\u escapes (M\\u00fcller, \\u0130stanbul, a surrogate pair for U+1F600), ensure_ascii=False writes the characters, and loads turns the surrogate pair back into one character."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_EnsureAscii a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nd = {\\'name\\': \\'Müller\\', \\'city\\': \\'İstanbul\\'}\\nout = (json.dumps(d), json.dumps(d, ensure_ascii=False), json.dumps(\\'\\\\U0001f600\\'), json.loads(\\'\\x22\\\\\\\\ud83d\\\\\\\\ude00\\x22\\') == \\'\\\\U0001f600\\')', g), g['out'])[1])({}) evaluates to ('{'name': 'M\\\\u00fcller', 'city': '\\\\u0130stanbul'}', '{'name': 'Müller', 'city': 'İstanbul'}', ''\\\\ud83d\\\\ude00'', True)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nd = {\\'name\\': \\'Müller\\', \\'city\\': \\'İstanbul\\'}\\nout = (json.dumps(d), json.dumps(d, ensure_ascii=False), json.dumps(\\'\\\\U0001f600\\'), json.loads(\\'\\x22\\\\\\\\ud83d\\\\\\\\ude00\\x22\\') == \\'\\\\U0001f600\\')', g), g['out'])[1])({})" ; chx:output "('{'name': 'M\\\\u00fcller', 'city': '\\\\u0130stanbul'}', '{'name': 'Müller', 'city': 'İstanbul'}', ''\\\\ud83d\\\\ude00'', True)" .
chx:X_EnsureAscii rd:hasIOExample chx:IO_EnsureAscii .
chx:X_FileRoundTrip a owl:NamedIndividual, chx:FileRoundTrip ; rdfs:label "json.dump(data, f)"@en ; skos:definition "json.dump(data, f) writes a file and returns None and json.load(f) reads it back, from a text file or from one opened in 'rb'; json.loads given a file object raised TypeError: the JSON object must be str, bytes or bytearray, not TextIOWrapper, and json.dump to a file opened 'wb' raised TypeError: a bytes-like object is required, not 'str'."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_FileRoundTrip a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nd = tempfile.mkdtemp(); p = os.path.join(d, \\'person.json\\')\\nwith open(p, \\'w\\', encoding=\\'utf-8\\') as f: r = json.dump(A, f, indent=2, ensure_ascii=False)\\nwith open(p, encoding=\\'utf-8\\') as f: back = json.load(f)\\nwith open(p, \\'rb\\') as f: back2 = json.load(f)\\nout = (r, back == A, back2 == A, err(lambda: json.loads(open(p))), err(lambda: json.dump(A, open(os.path.join(d, \\'x\\'), \\'wb\\'))))', g), g['out'])[1])({}) evaluates to (None, True, True, ('TypeError', 'the JSON object must be str, bytes or bytearray, not TextIOWrapper'), ('TypeError', 'a bytes-like object is required, not 'str''))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nd = tempfile.mkdtemp(); p = os.path.join(d, \\'person.json\\')\\nwith open(p, \\'w\\', encoding=\\'utf-8\\') as f: r = json.dump(A, f, indent=2, ensure_ascii=False)\\nwith open(p, encoding=\\'utf-8\\') as f: back = json.load(f)\\nwith open(p, \\'rb\\') as f: back2 = json.load(f)\\nout = (r, back == A, back2 == A, err(lambda: json.loads(open(p))), err(lambda: json.dump(A, open(os.path.join(d, \\'x\\'), \\'wb\\'))))', g), g['out'])[1])({})" ; chx:output "(None, True, True, ('TypeError', 'the JSON object must be str, bytes or bytearray, not TextIOWrapper'), ('TypeError', 'a bytes-like object is required, not 'str''))" .
chx:X_FileRoundTrip rd:hasIOExample chx:IO_FileRoundTrip .
chx:X_BomHandling a owl:NamedIndividual, chx:BomHandling ; rdfs:label "json.loads(b'\\xef\\xbb\\xbf[1]')"@en ; skos:definition "json.loads of bytes that start with a byte order mark returned [1] because the encoding is detected as utf-8-sig, but a str that starts with U+FEFF raised JSONDecodeError: Unexpected UTF-8 BOM (decode using utf-8-sig), and UTF-16 bytes were detected too."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_BomHandling a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (json.loads(b\\'\\\\xef\\\\xbb\\\\xbf[1]\\'), json.detect_encoding(b\\'\\\\xef\\\\xbb\\\\xbf[1]\\'), err(lambda: json.loads(\\'﻿[1]\\')), json.loads(\\'[\\x22é\\x22]\\'.encode(\\'utf-16\\')))', g), g['out'])[1])({}) evaluates to ([1], 'utf-8-sig', ('JSONDecodeError', 'Unexpected UTF-8 BOM (decode using utf-8-sig): line 1 column 1 (char 0)'), ['é'])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nout = (json.loads(b\\'\\\\xef\\\\xbb\\\\xbf[1]\\'), json.detect_encoding(b\\'\\\\xef\\\\xbb\\\\xbf[1]\\'), err(lambda: json.loads(\\'﻿[1]\\')), json.loads(\\'[\\x22é\\x22]\\'.encode(\\'utf-16\\')))', g), g['out'])[1])({})" ; chx:output "([1], 'utf-8-sig', ('JSONDecodeError', 'Unexpected UTF-8 BOM (decode using utf-8-sig): line 1 column 1 (char 0)'), ['é'])" .
chx:X_BomHandling rd:hasIOExample chx:IO_BomHandling .
chx:X_SerializationErrorNotes a owl:NamedIndividual, chx:SerializationErrorNotes ; rdfs:label "TypeError.__notes__"@en ; skos:definition "Python 3.14 adds notes to the TypeError of a serialization error: for {'a': [1, {2, 3}]} the notes were 'when serializing list item 1' and 'when serializing dict item 'a'', and the error for a tuple key has no notes."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_SerializationErrorNotes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef notes(v):\\n    try: json.dumps(v)\\n    except TypeError as e: return (str(e), getattr(e, \\'__notes__\\', None))\\nout = (notes({\\'a\\': [1, {2, 3}]}), notes({\\'a\\': 1, (1, 2): 3}))', g), g['out'])[1])({}) evaluates to (('Object of type set is not JSON serializable', ['when serializing list item 1', 'when serializing dict item 'a'']), ('keys must be str, int, float, bool or None, not tuple', None))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef notes(v):\\n    try: json.dumps(v)\\n    except TypeError as e: return (str(e), getattr(e, \\'__notes__\\', None))\\nout = (notes({\\'a\\': [1, {2, 3}]}), notes({\\'a\\': 1, (1, 2): 3}))', g), g['out'])[1])({})" ; chx:output "(('Object of type set is not JSON serializable', ['when serializing list item 1', 'when serializing dict item 'a'']), ('keys must be str, int, float, bool or None, not tuple', None))" .
chx:X_SerializationErrorNotes rd:hasIOExample chx:IO_SerializationErrorNotes .
chx:X_CaseSensitiveTags a owl:NamedIndividual, chx:CaseSensitiveTags ; rdfs:label "<A></a>"@en ; skos:definition "XML tag names are case-sensitive and every tag must be closed in order: <A></a> raised ParseError: mismatched tag at line 1 column 5, <a><b></a> raised the same error, and <Person><NAME>x</NAME></Person> parsed because the cases matched."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_CaseSensitiveTags a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef p(t):\\n    try: return ET.tostring(ET.fromstring(t), encoding=\\'unicode\\')\\n    except ET.ParseError as e: return \\'ParseError: \\' + str(e)\\nout = (p(\\'<A></a>\\'), p(\\'<Person><NAME>x</NAME></Person>\\'), p(\\'<a><b></a>\\'), p(\\'<a><b></a></b>\\'))', g), g['out'])[1])({}) evaluates to ('ParseError: mismatched tag: line 1, column 5', '<Person><NAME>x</NAME></Person>', 'ParseError: mismatched tag: line 1, column 8', 'ParseError: mismatched tag: line 1, column 8')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef p(t):\\n    try: return ET.tostring(ET.fromstring(t), encoding=\\'unicode\\')\\n    except ET.ParseError as e: return \\'ParseError: \\' + str(e)\\nout = (p(\\'<A></a>\\'), p(\\'<Person><NAME>x</NAME></Person>\\'), p(\\'<a><b></a>\\'), p(\\'<a><b></a></b>\\'))', g), g['out'])[1])({})" ; chx:output "('ParseError: mismatched tag: line 1, column 5', '<Person><NAME>x</NAME></Person>', 'ParseError: mismatched tag: line 1, column 8', 'ParseError: mismatched tag: line 1, column 8')" .
chx:X_CaseSensitiveTags rd:hasIOExample chx:IO_CaseSensitiveTags .
chx:X_AttributeQuotesRequired a owl:NamedIndividual, chx:AttributeQuotesRequired ; rdfs:label "<a b='1'>"@en ; skos:definition "An XML attribute needs a value in quotes, single or double: <a b='1'/> parsed and was written back as <a b='1' />, while <a b=1/> and <a b/> (allowed in HTML) raised ParseError: not well-formed (invalid token), and a repeated attribute raised duplicate attribute."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_AttributeQuotesRequired a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef p(t):\\n    try: return ET.tostring(ET.fromstring(t), encoding=\\'unicode\\')\\n    except ET.ParseError as e: return \\'ParseError: \\' + str(e)\\nout = (p(\\x22<a b=\\'1\\'/>\\x22), p(\\'<a b=1/>\\'), p(\\'<a b/>\\'), p(\\'<a b=\\x221\\x22 b=\\x222\\x22/>\\'))', g), g['out'])[1])({}) evaluates to ('<a b='1' />', 'ParseError: not well-formed (invalid token): line 1, column 5', 'ParseError: not well-formed (invalid token): line 1, column 4', 'ParseError: duplicate attribute: line 1, column 9')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef p(t):\\n    try: return ET.tostring(ET.fromstring(t), encoding=\\'unicode\\')\\n    except ET.ParseError as e: return \\'ParseError: \\' + str(e)\\nout = (p(\\x22<a b=\\'1\\'/>\\x22), p(\\'<a b=1/>\\'), p(\\'<a b/>\\'), p(\\'<a b=\\x221\\x22 b=\\x222\\x22/>\\'))', g), g['out'])[1])({})" ; chx:output "('<a b='1' />', 'ParseError: not well-formed (invalid token): line 1, column 5', 'ParseError: not well-formed (invalid token): line 1, column 4', 'ParseError: duplicate attribute: line 1, column 9')" .
chx:X_AttributeQuotesRequired rd:hasIOExample chx:IO_AttributeQuotesRequired .
chx:X_SingleRootRequired a owl:NamedIndividual, chx:SingleRootRequired ; rdfs:label "<a/><b/>"@en ; skos:definition "An XML document has exactly one root element: <a/><b/> raised ParseError: junk after document element, so did text after the root, a comment before or after the root was allowed, and empty input raised no element found."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_SingleRootRequired a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef p(t):\\n    try: return ET.tostring(ET.fromstring(t), encoding=\\'unicode\\')\\n    except ET.ParseError as e: return \\'ParseError: \\' + str(e)\\nout = (p(\\'<a/><b/>\\'), p(\\'<!-- c --><a/>\\'), p(\\'<a/><!-- c -->\\'), p(\\'\\'), p(\\'<a/>junk\\'))', g), g['out'])[1])({}) evaluates to ('ParseError: junk after document element: line 1, column 4', '<a />', '<a />', 'ParseError: no element found: line 1, column 0', 'ParseError: junk after document element: line 1, column 4')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef p(t):\\n    try: return ET.tostring(ET.fromstring(t), encoding=\\'unicode\\')\\n    except ET.ParseError as e: return \\'ParseError: \\' + str(e)\\nout = (p(\\'<a/><b/>\\'), p(\\'<!-- c --><a/>\\'), p(\\'<a/><!-- c -->\\'), p(\\'\\'), p(\\'<a/>junk\\'))', g), g['out'])[1])({})" ; chx:output "('ParseError: junk after document element: line 1, column 4', '<a />', '<a />', 'ParseError: no element found: line 1, column 0', 'ParseError: junk after document element: line 1, column 4')" .
chx:X_SingleRootRequired rd:hasIOExample chx:IO_SingleRootRequired .
chx:X_EscapesRequired a owl:NamedIndividual, chx:EscapesRequired ; rdfs:label "&amp; &lt;"@en ; skos:definition "A lone & or < in XML text is an error (not well-formed, invalid token) and must be written &amp; or &lt;, which parse back to & and <; an HTML entity such as &nbsp; is undefined in XML, and a CDATA section holds 1 < 2 & 3 as text."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_EscapesRequired a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef p(t):\\n    try: return ET.fromstring(t).text\\n    except ET.ParseError as e: return \\'ParseError: \\' + str(e)\\nout = (p(\\'<a>fish & chips</a>\\'), p(\\'<a>1 < 2</a>\\'), p(\\'<a>fish &amp; chips &lt; 5</a>\\'), p(\\'<a>&nbsp;</a>\\'), p(\\'<a><![CDATA[1 < 2 & 3]]></a>\\'))', g), g['out'])[1])({}) evaluates to ('ParseError: not well-formed (invalid token): line 1, column 9', 'ParseError: not well-formed (invalid token): line 1, column 6', 'fish & chips < 5', 'ParseError: undefined entity: line 1, column 3', '1 < 2 & 3')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef p(t):\\n    try: return ET.fromstring(t).text\\n    except ET.ParseError as e: return \\'ParseError: \\' + str(e)\\nout = (p(\\'<a>fish & chips</a>\\'), p(\\'<a>1 < 2</a>\\'), p(\\'<a>fish &amp; chips &lt; 5</a>\\'), p(\\'<a>&nbsp;</a>\\'), p(\\'<a><![CDATA[1 < 2 & 3]]></a>\\'))', g), g['out'])[1])({})" ; chx:output "('ParseError: not well-formed (invalid token): line 1, column 9', 'ParseError: not well-formed (invalid token): line 1, column 6', 'fish & chips < 5', 'ParseError: undefined entity: line 1, column 3', '1 < 2 & 3')" .
chx:X_EscapesRequired rd:hasIOExample chx:IO_EscapesRequired .
chx:X_WellFormedNotValid a owl:NamedIndividual, chx:WellFormedNotValid ; rdfs:label "<person><banana/></person>"@en ; skos:definition "ElementTree checks well-formedness and not validity: a person with a banana child and a name child parsed with both children, while lxml with a DTD that allows only a name child answered False for that document and True for a document with a name only; xml.etree.ElementTree has no validate()."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_WellFormedNotValid a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nr = ET.fromstring(\\'<person><banana>1</banana><name/></person>\\')\\nimport lxml.etree as L\\ndtd = L.DTD(io.StringIO(\\'<!ELEMENT person (name)><!ELEMENT name (#PCDATA)>\\'))\\nout = ([c.tag for c in r], dtd.validate(L.fromstring(\\'<person><banana>1</banana><name/></person>\\')), dtd.validate(L.fromstring(\\'<person><name>x</name></person>\\')), hasattr(ET, \\'validate\\'))', g), g['out'])[1])({}) evaluates to (['banana', 'name'], False, True, False)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nr = ET.fromstring(\\'<person><banana>1</banana><name/></person>\\')\\nimport lxml.etree as L\\ndtd = L.DTD(io.StringIO(\\'<!ELEMENT person (name)><!ELEMENT name (#PCDATA)>\\'))\\nout = ([c.tag for c in r], dtd.validate(L.fromstring(\\'<person><banana>1</banana><name/></person>\\')), dtd.validate(L.fromstring(\\'<person><name>x</name></person>\\')), hasattr(ET, \\'validate\\'))', g), g['out'])[1])({})" ; chx:output "(['banana', 'name'], False, True, False)" .
chx:X_WellFormedNotValid rd:hasIOExample chx:IO_WellFormedNotValid .
chx:X_NamespaceClarkName a owl:NamedIndividual, chx:NamespaceClarkName ; rdfs:label "{uri}local"@en ; skos:definition "ElementTree names a namespaced element or attribute {uri}local: the b of <x:b x:c='1'/> with x bound to urn:x had the tag {urn:x}b and the attribute {urn:x}c, equal to ET.QName('urn:x', 'b').text, and was written back with the prefix ns0."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_NamespaceClarkName a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nr = ET.fromstring(\\'<p xmlns:x=\\x22urn:x\\x22><x:b x:c=\\x221\\x22/></p>\\')\\nout = (r[0].tag, r[0].attrib, ET.tostring(r, encoding=\\'unicode\\'), ET.QName(\\'urn:x\\', \\'b\\').text)', g), g['out'])[1])({}) evaluates to ('{urn:x}b', {'{urn:x}c': '1'}, '<p xmlns:ns0='urn:x'><ns0:b ns0:c='1' /></p>', '{urn:x}b')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nr = ET.fromstring(\\'<p xmlns:x=\\x22urn:x\\x22><x:b x:c=\\x221\\x22/></p>\\')\\nout = (r[0].tag, r[0].attrib, ET.tostring(r, encoding=\\'unicode\\'), ET.QName(\\'urn:x\\', \\'b\\').text)', g), g['out'])[1])({})" ; chx:output "('{urn:x}b', {'{urn:x}c': '1'}, '<p xmlns:ns0='urn:x'><ns0:b ns0:c='1' /></p>', '{urn:x}b')" .
chx:X_NamespaceClarkName rd:hasIOExample chx:IO_NamespaceClarkName .
chx:X_XsiNilNotUnderstood a owl:NamedIndividual, chx:XsiNilNotUnderstood ; rdfs:label "xsi:nil='true'"@en ; skos:definition "xsi:nil is an attribute of the XML Schema instance namespace and ElementTree does not interpret it: elements with xsi:nil true, false and true gave the attribute values under the full name {http://www.w3.org/2001/XMLSchema-instance}nil, the text of an element with nil true and content stayed 'not empty', and a document that uses the prefix without declaring it raised ParseError: unbound prefix."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_XsiNilNotUnderstood a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nr = ET.fromstring(\\'<p \\' + NS + \\'><a xsi:nil=\\x22true\\x22/><b xsi:nil=\\x22false\\x22>text</b><c xsi:nil=\\x22true\\x22>not empty</c></p>\\')\\nnil = \\'{http://www.w3.org/2001/XMLSchema-instance}nil\\'\\nout = ([(e.tag, e.attrib.get(nil), e.text) for e in r], ET.tostring(r, encoding=\\'unicode\\'), err(lambda: ET.fromstring(\\'<a xsi:nil=\\x22true\\x22/>\\')))', g), g['out'])[1])({}) evaluates to ([('a', 'true', None), ('b', 'false', 'text'), ('c', 'true', 'not empty')], '<p xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'><a xsi:nil='true' /><b xsi:nil='false'>text</b><c xsi:nil='true'>not empty</c></p>', ('ParseError', 'unbound prefix: line 1, column 0'))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nr = ET.fromstring(\\'<p \\' + NS + \\'><a xsi:nil=\\x22true\\x22/><b xsi:nil=\\x22false\\x22>text</b><c xsi:nil=\\x22true\\x22>not empty</c></p>\\')\\nnil = \\'{http://www.w3.org/2001/XMLSchema-instance}nil\\'\\nout = ([(e.tag, e.attrib.get(nil), e.text) for e in r], ET.tostring(r, encoding=\\'unicode\\'), err(lambda: ET.fromstring(\\'<a xsi:nil=\\x22true\\x22/>\\')))', g), g['out'])[1])({})" ; chx:output "([('a', 'true', None), ('b', 'false', 'text'), ('c', 'true', 'not empty')], '<p xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'><a xsi:nil='true' /><b xsi:nil='false'>text</b><c xsi:nil='true'>not empty</c></p>', ('ParseError', 'unbound prefix: line 1, column 0'))" .
chx:X_XsiNilNotUnderstood rd:hasIOExample chx:IO_XsiNilNotUnderstood .
chx:X_BillionLaughsLimit a owl:NamedIndividual, chx:BillionLaughsLimit ; rdfs:label "<!ENTITY lol9 '&lol8;&lol8;...'>"@en ; skos:definition "A 760-byte document of 10 levels of entities that would expand to 3,000,000,000 characters was refused by ElementTree with ParseError: limit on input amplification factor (from DTD and entities) breached, while a small entity document parsed to 'hellohello'."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_BillionLaughsLimit a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nents = \\'\\'.join(\\'<!ENTITY lol%d \\x22%s\\x22>\\' % (i, (\\'&lol;\\' if i == 1 else \\'&lol%d;\\' % (i - 1)) * 10) for i in range(1, 10))\\ndoc = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE lolz [<!ENTITY lol \\x22lol\\x22>\\' + ents + \\']><lolz>&lol9;</lolz>\\'\\nsmall = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE a [<!ENTITY e \\x22hello\\x22>]><a>&e;&e;</a>\\'\\nout = (len(doc), 3 * 10 ** 9, err(lambda: ET.fromstring(doc)), ET.fromstring(small).text)', g), g['out'])[1])({}) evaluates to (760, 3000000000, ('ParseError', 'limit on input amplification factor (from DTD and entities) breached: line 1, column 747'), 'hellohello')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nents = \\'\\'.join(\\'<!ENTITY lol%d \\x22%s\\x22>\\' % (i, (\\'&lol;\\' if i == 1 else \\'&lol%d;\\' % (i - 1)) * 10) for i in range(1, 10))\\ndoc = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE lolz [<!ENTITY lol \\x22lol\\x22>\\' + ents + \\']><lolz>&lol9;</lolz>\\'\\nsmall = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE a [<!ENTITY e \\x22hello\\x22>]><a>&e;&e;</a>\\'\\nout = (len(doc), 3 * 10 ** 9, err(lambda: ET.fromstring(doc)), ET.fromstring(small).text)', g), g['out'])[1])({})" ; chx:output "(760, 3000000000, ('ParseError', 'limit on input amplification factor (from DTD and entities) breached: line 1, column 747'), 'hellohello')" .
chx:X_BillionLaughsLimit rd:hasIOExample chx:IO_BillionLaughsLimit .
chx:X_ExternalEntityNotFetched a owl:NamedIndividual, chx:ExternalEntityNotFetched ; rdfs:label "<!ENTITY x SYSTEM 'file:///etc/hostname'>"@en ; skos:definition "ElementTree did not read a local file named by an external entity: a document with <!ENTITY x SYSTEM 'file://...secret.txt'> raised ParseError: undefined entity &x;, and the text of the file did not appear in the error."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ExternalEntityNotFetched a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\np = os.path.join(tempfile.mkdtemp(), \\'secret.txt\\'); open(p, \\'w\\').write(\\'TOPSECRET\\')\\ndoc = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE a [<!ENTITY x SYSTEM \\x22file://\\' + p + \\'\\x22>]><a>&x;</a>\\'\\nout = (err(lambda: ET.fromstring(doc)), \\'TOPSECRET\\' in str(err(lambda: ET.fromstring(doc))))', g), g['out'])[1])({}) evaluates to (('ParseError', 'undefined entity &x;: line 1, column 94'), False)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\np = os.path.join(tempfile.mkdtemp(), \\'secret.txt\\'); open(p, \\'w\\').write(\\'TOPSECRET\\')\\ndoc = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE a [<!ENTITY x SYSTEM \\x22file://\\' + p + \\'\\x22>]><a>&x;</a>\\'\\nout = (err(lambda: ET.fromstring(doc)), \\'TOPSECRET\\' in str(err(lambda: ET.fromstring(doc))))', g), g['out'])[1])({})" ; chx:output "(('ParseError', 'undefined entity &x;: line 1, column 94'), False)" .
chx:X_ExternalEntityNotFetched rd:hasIOExample chx:IO_ExternalEntityNotFetched .
chx:X_DefusedxmlForbids a owl:NamedIndividual, chx:DefusedxmlForbids ; rdfs:label "defusedxml.ElementTree.fromstring"@en ; skos:definition "defusedxml.ElementTree.fromstring raised EntitiesForbidden for a document with an entity, parsed an ordinary document, raised DTDForbidden with forbid_dtd=True, and both exceptions are subclasses of ValueError."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_DefusedxmlForbids a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport defusedxml.ElementTree as D\\nfrom defusedxml import EntitiesForbidden, DTDForbidden\\nsmall = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE a [<!ENTITY e \\x22hello\\x22>]><a>&e;</a>\\'\\nr1 = err(lambda: D.fromstring(small)); r2 = err(lambda: D.fromstring(\\'<a>1</a>\\').text); r3 = err(lambda: D.fromstring(small, forbid_dtd=True))\\nout = (r1[0], r2, r3[0], issubclass(EntitiesForbidden, ValueError), issubclass(DTDForbidden, ValueError))', g), g['out'])[1])({}) evaluates to ('EntitiesForbidden', ('ok', '1'), 'DTDForbidden', True, True)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport defusedxml.ElementTree as D\\nfrom defusedxml import EntitiesForbidden, DTDForbidden\\nsmall = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE a [<!ENTITY e \\x22hello\\x22>]><a>&e;</a>\\'\\nr1 = err(lambda: D.fromstring(small)); r2 = err(lambda: D.fromstring(\\'<a>1</a>\\').text); r3 = err(lambda: D.fromstring(small, forbid_dtd=True))\\nout = (r1[0], r2, r3[0], issubclass(EntitiesForbidden, ValueError), issubclass(DTDForbidden, ValueError))', g), g['out'])[1])({})" ; chx:output "('EntitiesForbidden', ('ok', '1'), 'DTDForbidden', True, True)" .
chx:X_DefusedxmlForbids rd:hasIOExample chx:IO_DefusedxmlForbids .
chx:X_XmltodictEntitiesDisabled a owl:NamedIndividual, chx:XmltodictEntitiesDisabled ; rdfs:label "xmltodict.parse(entity document)"@en ; skos:definition "xmltodict 1.0.4 refuses every entity: parse of a document with an internal entity raised ValueError: entities are disabled, while a plain document parsed to {'a': '1'}; the version Appendix A pins, 0.13.0, parsed the entity."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_XmltodictEntitiesDisabled a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict, importlib.metadata as m\\nsmall = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE a [<!ENTITY e \\x22hello\\x22>]><a>&e;</a>\\'\\nout = (m.version(\\'xmltodict\\'), err(lambda: xmltodict.parse(small)), xmltodict.parse(\\'<a>1</a>\\'))', g), g['out'])[1])({}) evaluates to ('1.0.4', ('ValueError', 'entities are disabled'), {'a': '1'})"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict, importlib.metadata as m\\nsmall = \\'<?xml version=\\x221.0\\x22?><!DOCTYPE a [<!ENTITY e \\x22hello\\x22>]><a>&e;</a>\\'\\nout = (m.version(\\'xmltodict\\'), err(lambda: xmltodict.parse(small)), xmltodict.parse(\\'<a>1</a>\\'))', g), g['out'])[1])({})" ; chx:output "('1.0.4', ('ValueError', 'entities are disabled'), {'a': '1'})" .
chx:X_XmltodictEntitiesDisabled rd:hasIOExample chx:IO_XmltodictEntitiesDisabled .
chx:X_RootTagAndChildren a owl:NamedIndividual, chx:RootTagAndChildren ; rdfs:label "root = ET.fromstring(xml_string)"@en ; skos:definition "ET.fromstring() returns the root Element: its tag was person, list(root) gave the 6 children name, age, programmer, car, address and phone, root[0].text was 'Alice Doe', root[4][0] was the street element with the text '100 Larkin St.', a slice gave [age, programmer] and root[9] raised IndexError: child index out of range."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_RootTagAndChildren a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(XS)\\nout = (root.tag, [c.tag for c in root], len(root), root[0].text, root[4][0].tag, root[4][0].text, type(root).__name__, [c.tag for c in root[1:3]], err(lambda: root[9]))', g), g['out'])[1])({}) evaluates to ('person', ['name', 'age', 'programmer', 'car', 'address', 'phone'], 6, 'Alice Doe', 'street', '100 Larkin St.', 'Element', ['age', 'programmer'], ('IndexError', 'child index out of range'))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(XS)\\nout = (root.tag, [c.tag for c in root], len(root), root[0].text, root[4][0].tag, root[4][0].text, type(root).__name__, [c.tag for c in root[1:3]], err(lambda: root[9]))', g), g['out'])[1])({})" ; chx:output "('person', ['name', 'age', 'programmer', 'car', 'address', 'phone'], 6, 'Alice Doe', 'street', '100 Larkin St.', 'Element', ['age', 'programmer'], ('IndexError', 'child index out of range'))" .
chx:X_RootTagAndChildren rd:hasIOExample chx:IO_RootTagAndChildren .
chx:X_TextNoneOrString a owl:NamedIndividual, chx:TextNoneOrString ; rdfs:label "elem.text"@en ; skos:definition "The text of an element is a str or None: age had the str '30', the self-closing car and the empty pair had None, and an element holding one space had ' ', so '<car/>' and '<car></car>' are the same to the parser."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_TextNoneOrString a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(XS)\\nout = (root[1].text, type(root[1].text).__name__, root[3].text, root[3].text is None, root[4].text, ET.fromstring(\\'<a></a>\\').text, ET.fromstring(\\'<a> </a>\\').text)', g), g['out'])[1])({}) evaluates to ('30', 'str', None, True, None, None, ' ')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(XS)\\nout = (root[1].text, type(root[1].text).__name__, root[3].text, root[3].text is None, root[4].text, ET.fromstring(\\'<a></a>\\').text, ET.fromstring(\\'<a> </a>\\').text)', g), g['out'])[1])({})" ; chx:output "('30', 'str', None, True, None, None, ' ')" .
chx:X_TextNoneOrString rd:hasIOExample chx:IO_TextNoneOrString .
chx:X_ParentTextIsWhitespace a owl:NamedIndividual, chx:ParentTextIsWhitespace ; rdfs:label "ET.parse('my_data.xml')"@en ; skos:definition "In a pretty-printed file the text of an element that holds only other elements is the whitespace between the tags: address had '\\n        ', root.text was '\\n    ', name had the tail '\\n    ', and only car, with no content, had None; text.strip() or None gives the None the chapter prints."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ParentTextIsWhitespace a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\npretty = \\'<person>\\\\n    <name>Alice Doe</name>\\\\n    <address>\\\\n        <street>100 Larkin St.</street>\\\\n    </address>\\\\n    <car/>\\\\n</person>\\\\n\\'\\nroot = ET.parse(io.StringIO(pretty)).getroot()\\nout = ([(c.tag, c.text) for c in root], root.text, root[0].tail, [(c.tag, (c.text or \\'\\').strip() or None) for c in root])', g), g['out'])[1])({}) evaluates to ([('name', 'Alice Doe'), ('address', '\\n        '), ('car', None)], '\\n    ', '\\n    ', [('name', 'Alice Doe'), ('address', None), ('car', None)])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\npretty = \\'<person>\\\\n    <name>Alice Doe</name>\\\\n    <address>\\\\n        <street>100 Larkin St.</street>\\\\n    </address>\\\\n    <car/>\\\\n</person>\\\\n\\'\\nroot = ET.parse(io.StringIO(pretty)).getroot()\\nout = ([(c.tag, c.text) for c in root], root.text, root[0].tail, [(c.tag, (c.text or \\'\\').strip() or None) for c in root])', g), g['out'])[1])({})" ; chx:output "([('name', 'Alice Doe'), ('address', '\\n        '), ('car', None)], '\\n    ', '\\n    ', [('name', 'Alice Doe'), ('address', None), ('car', None)])" .
chx:X_ParentTextIsWhitespace rd:hasIOExample chx:IO_ParentTextIsWhitespace .
chx:X_IterDocumentOrder a owl:NamedIndividual, chx:IterDocumentOrder ; rdfs:label "root.iter('number')"@en ; skos:definition "iter() walks the element and its descendants in document order, root first: 16 elements for the Alice document against 6 children, the numbers were ['415-555-7890', '415-555-1234'], and the first element returned was the root itself."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_IterDocumentOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(XS)\\nout = ([e.tag for e in root.iter()], [e.text for e in root.iter(\\'number\\')], len(list(root)), len(list(root.iter())), root.iter().__next__() is root)', g), g['out'])[1])({}) evaluates to (['person', 'name', 'age', 'programmer', 'car', 'address', 'street', 'city', 'zip', 'phone', 'phoneEntry', 'type', 'number', 'phoneEntry', 'type', 'number'], ['415-555-7890', '415-555-1234'], 6, 16, True)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(XS)\\nout = ([e.tag for e in root.iter()], [e.text for e in root.iter(\\'number\\')], len(list(root)), len(list(root.iter())), root.iter().__next__() is root)', g), g['out'])[1])({})" ; chx:output "(['person', 'name', 'age', 'programmer', 'car', 'address', 'street', 'city', 'zip', 'phone', 'phoneEntry', 'type', 'number', 'phoneEntry', 'type', 'number'], ['415-555-7890', '415-555-1234'], 6, 16, True)" .
chx:X_IterDocumentOrder rd:hasIOExample chx:IO_IterDocumentOrder .
chx:X_FindAndXPathSubset a owl:NamedIndividual, chx:FindAndXPathSubset ; rdfs:label "root.findall('.//number')"@en ; skos:definition "find(), findall() and findtext() take a limited XPath: find('name').text was 'Alice Doe', findall('.//number') gave the two numbers, findtext('address/zip') gave '94102', find('nothing') returned None and .text on it raised AttributeError, and an Element has no xpath() method."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_FindAndXPathSubset a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(XS)\\nout = (root.find(\\'name\\').text, [e.text for e in root.findall(\\'.//number\\')], root.find(\\'nothing\\'), err(lambda: root.find(\\'nothing\\').text), root.findtext(\\'address/zip\\'), hasattr(root, \\'xpath\\'))', g), g['out'])[1])({}) evaluates to ('Alice Doe', ['415-555-7890', '415-555-1234'], None, ('AttributeError', ''NoneType' object has no attribute 'text''), '94102', False)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(XS)\\nout = (root.find(\\'name\\').text, [e.text for e in root.findall(\\'.//number\\')], root.find(\\'nothing\\'), err(lambda: root.find(\\'nothing\\').text), root.findtext(\\'address/zip\\'), hasattr(root, \\'xpath\\'))', g), g['out'])[1])({})" ; chx:output "('Alice Doe', ['415-555-7890', '415-555-1234'], None, ('AttributeError', ''NoneType' object has no attribute 'text''), '94102', False)" .
chx:X_FindAndXPathSubset rd:hasIOExample chx:IO_FindAndXPathSubset .
chx:X_ElementTruthDeprecated a owl:NamedIndividual, chx:ElementTruthDeprecated ; rdfs:label "if elem:"@en ; skos:definition "The truth value of an Element is its number of children and testing it raises a DeprecationWarning (since Python 3.12): bool of an empty element was False and of an element with a child True, so a found element must be tested with is not None."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ElementTruthDeprecated a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nempty = ET.Element(\\'x\\'); full = ET.fromstring(\\'<a><b/></a>\\')\\nwith warnings.catch_warnings(record=True) as w:\\n    warnings.simplefilter(\\'always\\'); v = (bool(empty), bool(full))\\nout = (v, sorted({x.category.__name__ for x in w}), empty is not None)', g), g['out'])[1])({}) evaluates to ((False, True), ['DeprecationWarning'], True)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nempty = ET.Element(\\'x\\'); full = ET.fromstring(\\'<a><b/></a>\\')\\nwith warnings.catch_warnings(record=True) as w:\\n    warnings.simplefilter(\\'always\\'); v = (bool(empty), bool(full))\\nout = (v, sorted({x.category.__name__ for x in w}), empty is not None)', g), g['out'])[1])({})" ; chx:output "((False, True), ['DeprecationWarning'], True)" .
chx:X_ElementTruthDeprecated rd:hasIOExample chx:IO_ElementTruthDeprecated .
chx:X_SubElementAndSet a owl:NamedIndividual, chx:SubElementAndSet ; rdfs:label "ET.SubElement(root, 'name')"@en ; skos:definition "Element, SubElement and set build a tree: ET.tostring(root) returned bytes, encoding='unicode' returned the str <person><name>Alice Doe</name><car xsi:nil='true' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' /></person>, and the namespace attribute was written as a plain attribute."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_SubElementAndSet a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.Element(\\'person\\'); n = ET.SubElement(root, \\'name\\'); n.text = \\'Alice Doe\\'\\ncar = ET.SubElement(root, \\'car\\'); car.set(\\'xsi:nil\\', \\'true\\'); car.set(\\'xmlns:xsi\\', \\'http://www.w3.org/2001/XMLSchema-instance\\')\\nout = (ET.tostring(root), ET.tostring(root, encoding=\\'unicode\\'), err(lambda: ET.tostring(ET.fromstring(\\'<a>1</a>\\'), encoding=\\'unicode\\')))', g), g['out'])[1])({}) evaluates to (b'<person><name>Alice Doe</name><car xsi:nil='true' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' /></person>', '<person><name>Alice Doe</name><car xsi:nil='true' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' /></person>', ('ok', '<a>1</a>'))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.Element(\\'person\\'); n = ET.SubElement(root, \\'name\\'); n.text = \\'Alice Doe\\'\\ncar = ET.SubElement(root, \\'car\\'); car.set(\\'xsi:nil\\', \\'true\\'); car.set(\\'xmlns:xsi\\', \\'http://www.w3.org/2001/XMLSchema-instance\\')\\nout = (ET.tostring(root), ET.tostring(root, encoding=\\'unicode\\'), err(lambda: ET.tostring(ET.fromstring(\\'<a>1</a>\\'), encoding=\\'unicode\\')))', g), g['out'])[1])({})" ; chx:output "(b'<person><name>Alice Doe</name><car xsi:nil='true' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' /></person>', '<person><name>Alice Doe</name><car xsi:nil='true' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' /></person>', ('ok', '<a>1</a>'))" .
chx:X_SubElementAndSet rd:hasIOExample chx:IO_SubElementAndSet .
chx:X_TostringSpaceBeforeSlash a owl:NamedIndividual, chx:TostringSpaceBeforeSlash ; rdfs:label "ET.tostring(elem)"@en ; skos:definition "ET.tostring writes an empty element as <b /> with a space, <b></b> with short_empty_elements=False, writes an XML declaration only with xml_declaration=True, and with the default encoding turns M\\u00fcller into M&#252;ller while encoding='utf-8' keeps the bytes."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_TostringSpaceBeforeSlash a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ne = ET.fromstring(\\'<a><b/></a>\\')\\nout = (ET.tostring(e), ET.tostring(e, short_empty_elements=False), ET.tostring(e, encoding=\\'utf-8\\'), ET.tostring(e, encoding=\\'utf-8\\', xml_declaration=True), ET.tostring(ET.fromstring(\\'<u>Müller</u>\\')), ET.tostring(ET.fromstring(\\'<u>Müller</u>\\'), encoding=\\'utf-8\\'))', g), g['out'])[1])({}) evaluates to (b'<a><b /></a>', b'<a><b></b></a>', b'<a><b /></a>', b'<?xml version='1.0' encoding='utf-8'?>\\n<a><b /></a>', b'<u>M&#252;ller</u>', b'<u>M\\xc3\\xbcller</u>')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ne = ET.fromstring(\\'<a><b/></a>\\')\\nout = (ET.tostring(e), ET.tostring(e, short_empty_elements=False), ET.tostring(e, encoding=\\'utf-8\\'), ET.tostring(e, encoding=\\'utf-8\\', xml_declaration=True), ET.tostring(ET.fromstring(\\'<u>Müller</u>\\')), ET.tostring(ET.fromstring(\\'<u>Müller</u>\\'), encoding=\\'utf-8\\'))', g), g['out'])[1])({})" ; chx:output "(b'<a><b /></a>', b'<a><b></b></a>', b'<a><b /></a>', b'<?xml version='1.0' encoding='utf-8'?>\\n<a><b /></a>', b'<u>M&#252;ller</u>', b'<u>M\\xc3\\xbcller</u>')" .
chx:X_TostringSpaceBeforeSlash rd:hasIOExample chx:IO_TostringSpaceBeforeSlash .
chx:X_IndentPrettyPrint a owl:NamedIndividual, chx:IndentPrettyPrint ; rdfs:label "ET.indent(tree)"@en ; skos:definition "ET.indent(tree) (Python 3.9) adds whitespace in place: <a><b>x</b><c><d>y</d></c></a> became a text of 5 lines indented by 2 spaces, and the whitespace was stored as the text of a ('\\n  ') and the tail of b."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_IndentPrettyPrint a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(\\'<a><b>x</b><c><d>y</d></c></a>\\')\\nET.indent(root)\\nout = (ET.tostring(root, encoding=\\'unicode\\'), root.text, root[0].tail)', g), g['out'])[1])({}) evaluates to ('<a>\\n  <b>x</b>\\n  <c>\\n    <d>y</d>\\n  </c>\\n</a>', '\\n  ', '\\n  ')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nroot = ET.fromstring(\\'<a><b>x</b><c><d>y</d></c></a>\\')\\nET.indent(root)\\nout = (ET.tostring(root, encoding=\\'unicode\\'), root.text, root[0].tail)', g), g['out'])[1])({})" ; chx:output "('<a>\\n  <b>x</b>\\n  <c>\\n    <d>y</d>\\n  </c>\\n</a>', '\\n  ', '\\n  ')" .
chx:X_IndentPrettyPrint rd:hasIOExample chx:IO_IndentPrettyPrint .
chx:X_ParseGivesStrings a owl:NamedIndividual, chx:ParseGivesStrings ; rdfs:label "xmltodict.parse(xml_string)"@en ; skos:definition "xmltodict.parse() returns a dict of dicts and every value is a str: age was '30', programmer was 'true', car was {'@xsi:nil': 'true', '@xmlns:xsi': ...} and not None, and address was a dict of three strings."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_ParseGivesStrings a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict\\nd = xmltodict.parse(XS)\\nout = (type(d).__name__, d[\\'person\\'][\\'age\\'], type(d[\\'person\\'][\\'age\\']).__name__, d[\\'person\\'][\\'programmer\\'], d[\\'person\\'][\\'car\\'], d[\\'person\\'][\\'address\\'])', g), g['out'])[1])({}) evaluates to ('dict', '30', 'str', 'true', {'@xsi:nil': 'true', '@xmlns:xsi': 'http://www.w3.org/2001/XMLSchema-instance'}, {'street': '100 Larkin St.', 'city': 'San Francisco', 'zip': '94102'})"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict\\nd = xmltodict.parse(XS)\\nout = (type(d).__name__, d[\\'person\\'][\\'age\\'], type(d[\\'person\\'][\\'age\\']).__name__, d[\\'person\\'][\\'programmer\\'], d[\\'person\\'][\\'car\\'], d[\\'person\\'][\\'address\\'])', g), g['out'])[1])({})" ; chx:output "('dict', '30', 'str', 'true', {'@xsi:nil': 'true', '@xmlns:xsi': 'http://www.w3.org/2001/XMLSchema-instance'}, {'street': '100 Larkin St.', 'city': 'San Francisco', 'zip': '94102'})" .
chx:X_ParseGivesStrings rd:hasIOExample chx:IO_ParseGivesStrings .
chx:X_OneEntryDictTwoList a owl:NamedIndividual, chx:OneEntryDictTwoList ; rdfs:label "phone': {'phoneEntry': [...]}"@en ; skos:definition "xmltodict gives a dict for one child element and a list for two: phoneEntry was a dict with one entry and a list with two, force_list=('e',) made the single one a list, and an element with an attribute and text gave {'@href': 'x', '#text': 'link'}."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_OneEntryDictTwoList a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict\\none = xmltodict.parse(\\'<p><e><t>m</t></e></p>\\'); two = xmltodict.parse(\\'<p><e><t>m</t></e><e><t>w</t></e></p>\\')\\nout = (type(one[\\'p\\'][\\'e\\']).__name__, type(two[\\'p\\'][\\'e\\']).__name__, xmltodict.parse(\\'<p><e><t>m</t></e></p>\\', force_list=(\\'e\\',))[\\'p\\'][\\'e\\'], xmltodict.parse(\\'<a href=\\x22x\\x22>link</a>\\'), xmltodict.parse(\\'<a href=\\x22x\\x22/>\\'))', g), g['out'])[1])({}) evaluates to ('dict', 'list', [{'t': 'm'}], {'a': {'@href': 'x', '#text': 'link'}}, {'a': {'@href': 'x'}})"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict\\none = xmltodict.parse(\\'<p><e><t>m</t></e></p>\\'); two = xmltodict.parse(\\'<p><e><t>m</t></e><e><t>w</t></e></p>\\')\\nout = (type(one[\\'p\\'][\\'e\\']).__name__, type(two[\\'p\\'][\\'e\\']).__name__, xmltodict.parse(\\'<p><e><t>m</t></e></p>\\', force_list=(\\'e\\',))[\\'p\\'][\\'e\\'], xmltodict.parse(\\'<a href=\\x22x\\x22>link</a>\\'), xmltodict.parse(\\'<a href=\\x22x\\x22/>\\'))', g), g['out'])[1])({})" ; chx:output "('dict', 'list', [{'t': 'm'}], {'a': {'@href': 'x', '#text': 'link'}}, {'a': {'@href': 'x'}})" .
chx:X_OneEntryDictTwoList rd:hasIOExample chx:IO_OneEntryDictTwoList .
chx:X_UnparseRoundTrip a owl:NamedIndividual, chx:UnparseRoundTrip ; rdfs:label "xmltodict.unparse(data)"@en ; skos:definition "xmltodict.unparse() writes a dict back to XML with an XML declaration: parse(unparse(d)) equalled d for the Alice data, pretty=True indented with tabs, and a dict with two roots raised ValueError: Document must have exactly one root."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_UnparseRoundTrip a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict\\nd = xmltodict.parse(XS)\\nu = xmltodict.unparse(d)\\nout = (u[:40], xmltodict.parse(u) == d, xmltodict.unparse({\\'a\\': {\\'@id\\': \\'1\\', \\'b\\': [\\'x\\', \\'y\\']}}, pretty=True), err(lambda: xmltodict.unparse({\\'a\\': 1, \\'b\\': 2})))', g), g['out'])[1])({}) evaluates to ('<?xml version='1.0' encoding='utf-8'?>\\n<', True, '<?xml version='1.0' encoding='utf-8'?>\\n<a id='1'>\\n\\t<b>x</b>\\n\\t<b>y</b>\\n</a>', ('ValueError', 'Document must have exactly one root.'))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict\\nd = xmltodict.parse(XS)\\nu = xmltodict.unparse(d)\\nout = (u[:40], xmltodict.parse(u) == d, xmltodict.unparse({\\'a\\': {\\'@id\\': \\'1\\', \\'b\\': [\\'x\\', \\'y\\']}}, pretty=True), err(lambda: xmltodict.unparse({\\'a\\': 1, \\'b\\': 2})))', g), g['out'])[1])({})" ; chx:output "('<?xml version='1.0' encoding='utf-8'?>\\n<', True, '<?xml version='1.0' encoding='utf-8'?>\\n<a id='1'>\\n\\t<b>x</b>\\n\\t<b>y</b>\\n</a>', ('ValueError', 'Document must have exactly one root.'))" .
chx:X_UnparseRoundTrip rd:hasIOExample chx:IO_UnparseRoundTrip .
chx:X_MinidomSameAnswer a owl:NamedIndividual, chx:MinidomSameAnswer ; rdfs:label "xml.dom.minidom.parseString"@en ; skos:definition "The DOM of xml.dom.minidom gave the same two numbers as ElementTree, with firstChild.data instead of .text, a documentElement named person and node types such as ELEMENT_NODE (1)."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_MinidomSameAnswer a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nfrom xml.dom import minidom\\ndom = minidom.parseString(XS)\\na = [n.firstChild.data for n in dom.getElementsByTagName(\\'number\\')]\\nb = [e.text for e in ET.fromstring(XS).iter(\\'number\\')]\\nout = (a, a == b, dom.documentElement.tagName, dom.firstChild.nodeType, dom.firstChild.nodeType == dom.ELEMENT_NODE)', g), g['out'])[1])({}) evaluates to (['415-555-7890', '415-555-1234'], True, 'person', 1, True)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nfrom xml.dom import minidom\\ndom = minidom.parseString(XS)\\na = [n.firstChild.data for n in dom.getElementsByTagName(\\'number\\')]\\nb = [e.text for e in ET.fromstring(XS).iter(\\'number\\')]\\nout = (a, a == b, dom.documentElement.tagName, dom.firstChild.nodeType, dom.firstChild.nodeType == dom.ELEMENT_NODE)', g), g['out'])[1])({})" ; chx:output "(['415-555-7890', '415-555-1234'], True, 'person', 1, True)" .
chx:X_MinidomSameAnswer rd:hasIOExample chx:IO_MinidomSameAnswer .
chx:X_IterparseClear a owl:NamedIndividual, chx:IterparseClear ; rdfs:label "ET.iterparse(f, events=('end',))"@en ; skos:definition "iterparse reads a document as a stream of events: summing 20,000 items gave 199,990,000 with and without clear(), and without clear() the peak memory traced was more than 1.5 times higher (5.7 MB against 2.3 MB in one run)."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_IterparseClear a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndoc = \\'<r>\\' + \\'\\'.join(\\'<i><q>%d</q></i>\\' % i for i in range(20000)) + \\'</r>\\'\\ndef total(clear):\\n    tracemalloc.start(); s = 0\\n    for ev, e in ET.iterparse(io.BytesIO(doc.encode()), events=(\\'end\\',)):\\n        if e.tag == \\'i\\':\\n            s += int(e.find(\\'q\\').text)\\n            if clear: e.clear()\\n    p = tracemalloc.get_traced_memory()[1]; tracemalloc.stop(); return s, p\\na = total(True); b = total(False)\\nout = (a[0], a[0] == b[0], b[1] > 1.5 * a[1])', g), g['out'])[1])({}) evaluates to (199990000, True, True)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndoc = \\'<r>\\' + \\'\\'.join(\\'<i><q>%d</q></i>\\' % i for i in range(20000)) + \\'</r>\\'\\ndef total(clear):\\n    tracemalloc.start(); s = 0\\n    for ev, e in ET.iterparse(io.BytesIO(doc.encode()), events=(\\'end\\',)):\\n        if e.tag == \\'i\\':\\n            s += int(e.find(\\'q\\').text)\\n            if clear: e.clear()\\n    p = tracemalloc.get_traced_memory()[1]; tracemalloc.stop(); return s, p\\na = total(True); b = total(False)\\nout = (a[0], a[0] == b[0], b[1] > 1.5 * a[1])', g), g['out'])[1])({})" ; chx:output "(199990000, True, True)" .
chx:X_IterparseClear rd:hasIOExample chx:IO_IterparseClear .
chx:X_CurlyQuoteBreaksLiteral a owl:NamedIndividual, chx:CurlyQuoteBreaksLiteral ; rdfs:label "xmlns:xsi='...'”/>"@en ; skos:definition "The chapter's two xml_string listings end the xsi namespace with a curly quotation mark: the text raised ParseError: unclosed token, the straight-quoted text parsed, and json_string wrapped over two lines inside its quotes raised JSONDecodeError: Invalid control character and parsed once the line break was removed."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_CurlyQuoteBreaksLiteral a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ngood = \\'<a xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22/>\\'\\nbad = good.replace(\\'instance\\x22\\', \\'instance”\\')\\nwrapped = \\'{\\x22a\\x22: \\x22b\\' + \\'\\\\n\\' + \\'c\\x22}\\'\\nout = (err(lambda: ET.fromstring(bad)), err(lambda: ET.fromstring(good))[0], err(lambda: json.loads(wrapped)), json.loads(wrapped.replace(\\'\\\\n\\', \\'\\')))', g), g['out'])[1])({}) evaluates to (('ParseError', 'unclosed token: line 1, column 0'), 'ok', ('JSONDecodeError', 'Invalid control character at: line 1 column 9 (char 8)'), {'a': 'bc'})"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ngood = \\'<a xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22/>\\'\\nbad = good.replace(\\'instance\\x22\\', \\'instance”\\')\\nwrapped = \\'{\\x22a\\x22: \\x22b\\' + \\'\\\\n\\' + \\'c\\x22}\\'\\nout = (err(lambda: ET.fromstring(bad)), err(lambda: ET.fromstring(good))[0], err(lambda: json.loads(wrapped)), json.loads(wrapped.replace(\\'\\\\n\\', \\'\\')))', g), g['out'])[1])({})" ; chx:output "(('ParseError', 'unclosed token: line 1, column 0'), 'ok', ('JSONDecodeError', 'Invalid control character at: line 1 column 9 (char 8)'), {'a': 'bc'})" .
chx:X_CurlyQuoteBreaksLiteral rd:hasIOExample chx:IO_CurlyQuoteBreaksLiteral .
chx:X_PrintedNoneVsWhitespace a owl:NamedIndividual, chx:PrintedNoneVsWhitespace ; rdfs:label "address -- None"@en ; skos:definition "The chapter prints None for the text of address and phone, which holds for a compact document and not for a pretty-printed one: for the pretty text the loop gave ('address', '\\n    ') and for the compact text ('address', None)."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_PrintedNoneVsWhitespace a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\npretty = \\'<person>\\\\n  <car/>\\\\n  <address>\\\\n    <street>x</street>\\\\n  </address>\\\\n</person>\\'\\ncompact = pretty.replace(\\'\\\\n\\', \\'\\').replace(\\'  \\', \\'\\')\\nt = lambda s: [(c.tag, c.text) for c in ET.fromstring(s)]\\nout = (t(pretty), t(compact))', g), g['out'])[1])({}) evaluates to ([('car', None), ('address', '\\n    ')], [('car', None), ('address', None)])"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\npretty = \\'<person>\\\\n  <car/>\\\\n  <address>\\\\n    <street>x</street>\\\\n  </address>\\\\n</person>\\'\\ncompact = pretty.replace(\\'\\\\n\\', \\'\\').replace(\\'  \\', \\'\\')\\nt = lambda s: [(c.tag, c.text) for c in ET.fromstring(s)]\\nout = (t(pretty), t(compact))', g), g['out'])[1])({})" ; chx:output "([('car', None), ('address', '\\n    ')], [('car', None), ('address', None)])" .
chx:X_PrintedNoneVsWhitespace rd:hasIOExample chx:IO_PrintedNoneVsWhitespace .
chx:X_SkipHeaderWithNext a owl:NamedIndividual, chx:SkipHeaderWithNext ; rdfs:label "next(reader)"@en ; skos:definition "next(reader) reads and drops the header record, and next(reader, None) does it safely: for h1,h2 / A,1 / B,2 the first was ['h1', 'h2'] and the rest [['A', '1'], ['B', '2']], and for empty input next(reader, 'empty') gave 'empty' while next(reader) raised StopIteration."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_SkipHeaderWithNext a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'h1,h2\\\\r\\\\nA,1\\\\r\\\\nB,2\\\\r\\\\n\\'\\nr = csv.reader(io.StringIO(t, newline=\\'\\')); first = next(r); rest = list(r)\\ne = csv.reader(io.StringIO(\\'\\', newline=\\'\\'))\\nout = (first, rest, next(e, \\'empty\\'), err(lambda: next(csv.reader(io.StringIO(\\'\\', newline=\\'\\')))))', g), g['out'])[1])({}) evaluates to (['h1', 'h2'], [['A', '1'], ['B', '2']], 'empty', ('StopIteration', ''))"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nt = \\'h1,h2\\\\r\\\\nA,1\\\\r\\\\nB,2\\\\r\\\\n\\'\\nr = csv.reader(io.StringIO(t, newline=\\'\\')); first = next(r); rest = list(r)\\ne = csv.reader(io.StringIO(\\'\\', newline=\\'\\'))\\nout = (first, rest, next(e, \\'empty\\'), err(lambda: next(csv.reader(io.StringIO(\\'\\', newline=\\'\\')))))', g), g['out'])[1])({})" ; chx:output "(['h1', 'h2'], [['A', '1'], ['B', '2']], 'empty', ('StopIteration', ''))" .
chx:X_SkipHeaderWithNext rd:hasIOExample chx:IO_SkipHeaderWithNext .
chx:X_EmptyAndHeaderOnly a owl:NamedIndividual, chx:EmptyAndHeaderOnly ; rdfs:label "removeCsvHeader.py edge cases"@en ; skos:definition "A line_num test that skips line 1 gave nothing for empty input and for a header only, kept a final record without a line break and wrote CRLF endings, but for a header that spans two lines it kept the whole header record in the output, as line_num was already 2 at its end."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_EmptyAndHeaderOnly a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef strip_header(t):\\n    out = io.StringIO(newline=\\'\\'); w = csv.writer(out)\\n    r = csv.reader(io.StringIO(t, newline=\\'\\'))\\n    for row in r:\\n        if r.line_num == 1: continue\\n        w.writerow(row)\\n    return out.getvalue()\\nout = (strip_header(\\'\\'), strip_header(\\'h\\\\r\\\\n\\'), strip_header(\\'h\\\\r\\\\n1,2\\'), strip_header(\\'\\x22a\\\\nb\\x22,c\\\\r\\\\n1,2\\\\r\\\\n\\'), strip_header(\\'h\\\\n1,2\\\\n\\'))', g), g['out'])[1])({}) evaluates to ('', '', '1,2\\r\\n', ''a\\nb',c\\r\\n1,2\\r\\n', '1,2\\r\\n')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\ndef strip_header(t):\\n    out = io.StringIO(newline=\\'\\'); w = csv.writer(out)\\n    r = csv.reader(io.StringIO(t, newline=\\'\\'))\\n    for row in r:\\n        if r.line_num == 1: continue\\n        w.writerow(row)\\n    return out.getvalue()\\nout = (strip_header(\\'\\'), strip_header(\\'h\\\\r\\\\n\\'), strip_header(\\'h\\\\r\\\\n1,2\\'), strip_header(\\'\\x22a\\\\nb\\x22,c\\\\r\\\\n1,2\\\\r\\\\n\\'), strip_header(\\'h\\\\n1,2\\\\n\\'))', g), g['out'])[1])({})" ; chx:output "('', '', '1,2\\r\\n', ''a\\nb',c\\r\\n1,2\\r\\n', '1,2\\r\\n')" .
chx:X_EmptyAndHeaderOnly rd:hasIOExample chx:IO_EmptyAndHeaderOnly .
chx:X_WorkbookCells a owl:NamedIndividual, chx:WorkbookCells ; rdfs:label "openpyxl.load_workbook"@en ; skos:definition "openpyxl returns datetime objects for date cells and the number format yyyy-mm-dd h:mm:ss here; a two-row workbook read back had max_row 2 and max_column 3, and csv.writer wrote 2035-04-05 13:34:02,Apples,73 with the str() of the datetime."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_WorkbookCells a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport openpyxl, datetime\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nws.append([datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73]); ws.append([datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85])\\nb = io.BytesIO(); wb.save(b)\\nw2 = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = w2[\\'Sheet1\\']\\ns2 = io.StringIO(newline=\\'\\'); wr_ = csv.writer(s2)\\nfor row in s.iter_rows(values_only=True): wr_.writerow(row)\\nout = (w2.sheetnames, s.max_row, s.max_column, type(s[\\'A1\\'].value).__name__, s[\\'A1\\'].number_format, s2.getvalue())', g), g['out'])[1])({}) evaluates to (['Sheet1'], 2, 3, 'datetime', 'yyyy-mm-dd h:mm:ss', '2035-04-05 13:34:02,Apples,73\\r\\n2035-04-05 03:41:23,Cherries,85\\r\\n')"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport openpyxl, datetime\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nws.append([datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73]); ws.append([datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85])\\nb = io.BytesIO(); wb.save(b)\\nw2 = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = w2[\\'Sheet1\\']\\ns2 = io.StringIO(newline=\\'\\'); wr_ = csv.writer(s2)\\nfor row in s.iter_rows(values_only=True): wr_.writerow(row)\\nout = (w2.sheetnames, s.max_row, s.max_column, type(s[\\'A1\\'].value).__name__, s[\\'A1\\'].number_format, s2.getvalue())', g), g['out'])[1])({})" ; chx:output "(['Sheet1'], 2, 3, 'datetime', 'yyyy-mm-dd h:mm:ss', '2035-04-05 13:34:02,Apples,73\\r\\n2035-04-05 03:41:23,Cherries,85\\r\\n')" .
chx:X_WorkbookCells rd:hasIOExample chx:IO_WorkbookCells .
chx:X_MaxColumnQuadratic a owl:NamedIndividual, chx:MaxColumnQuadratic ; rdfs:label "range(1, sheet.max_column + 1)"@en ; skos:definition "The skeleton evaluates sheet.max_column in the row loop and each evaluation visits every cell: for a sheet of 3,000 rows of 4 columns the loop over 150 rows with max_column inside took more than 20 times as long as the loop with the value hoisted."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_MaxColumnQuadratic a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport openpyxl, time\\nwb = openpyxl.Workbook(); ws = wb.active\\nfor i in range(3000): ws.append([i, \\'x\\', 1.5, None])\\ndef inside(n):\\n    t = time.perf_counter()\\n    for r in range(1, n + 1):\\n        for c in range(1, ws.max_column + 1): pass\\n    return time.perf_counter() - t\\ndef hoisted(n):\\n    t = time.perf_counter(); mc = ws.max_column\\n    for r in range(1, n + 1):\\n        for c in range(1, mc + 1): pass\\n    return time.perf_counter() - t\\na = inside(150); b = hoisted(150)\\nout = (ws.max_row, ws.max_column, a > 20 * b)', g), g['out'])[1])({}) evaluates to (3000, 4, True)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport openpyxl, time\\nwb = openpyxl.Workbook(); ws = wb.active\\nfor i in range(3000): ws.append([i, \\'x\\', 1.5, None])\\ndef inside(n):\\n    t = time.perf_counter()\\n    for r in range(1, n + 1):\\n        for c in range(1, ws.max_column + 1): pass\\n    return time.perf_counter() - t\\ndef hoisted(n):\\n    t = time.perf_counter(); mc = ws.max_column\\n    for r in range(1, n + 1):\\n        for c in range(1, mc + 1): pass\\n    return time.perf_counter() - t\\na = inside(150); b = hoisted(150)\\nout = (ws.max_row, ws.max_column, a > 20 * b)', g), g['out'])[1])({})" ; chx:output "(3000, 4, True)" .
chx:X_MaxColumnQuadratic rd:hasIOExample chx:IO_MaxColumnQuadratic .
chx:X_SizeComparison a owl:NamedIndividual, chx:SizeComparison ; rdfs:label "len(json.dumps(data))"@en ; skos:definition "The Alice data is 248 characters as compact JSON, 326 with indent=2 and 407 as XML without whitespace, 1.64 times the JSON, and the repr of the Python dict is also 248."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_SizeComparison a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict\\nj = json.dumps(A); jp = json.dumps(A, indent=2)\\nx = XS\\nout = (len(j), len(jp), len(x), round(len(x) / len(j), 2), len(repr(A)))', g), g['out'])[1])({}) evaluates to (248, 326, 407, 1.64, 248)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict\\nj = json.dumps(A); jp = json.dumps(A, indent=2)\\nx = XS\\nout = (len(j), len(jp), len(x), round(len(x) / len(j), 2), len(repr(A)))', g), g['out'])[1])({})" ; chx:output "(248, 326, 407, 1.64, 248)" .
chx:X_SizeComparison rd:hasIOExample chx:IO_SizeComparison .
chx:X_TypesKept a owl:NamedIndividual, chx:TypesKept ; rdfs:label "round trip through each format"@en ; skos:definition "JSON keeps types across a round trip (age int, car NoneType, programmer bool), xmltodict gives str for age and programmer and a dict for car, a CSV round trip gave ['Alice Doe', '30', '', 'True'] all str, and TOML read with tomllib kept int, bool and datetime and has no dumps()."@en ; dcterms:source <http://example.org/sen0414/ch18/research> .
chx:IO_TypesKept a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict, tomllib\\nj = json.loads(json.dumps(A)); x = xmltodict.parse(XS)[\\'person\\']\\nc = rd(wr([[A[\\'name\\'], A[\\'age\\'], A[\\'car\\'], A[\\'programmer\\']]]))[0]\\nt = tomllib.loads(\\'age = 30\\\\nok = true\\\\nd = 2035-04-05T13:34:00\\')\\nout = ({k: type(v).__name__ for k, v in j.items() if k in (\\'age\\', \\'car\\', \\'programmer\\')}, {k: type(x[k]).__name__ for k in (\\'age\\', \\'programmer\\', \\'car\\')}, c, [type(v).__name__ for v in c], {k: type(v).__name__ for k, v in t.items()}, hasattr(tomllib, \\'dumps\\'))', g), g['out'])[1])({}) evaluates to ({'age': 'int', 'car': 'NoneType', 'programmer': 'bool'}, {'age': 'str', 'programmer': 'str', 'car': 'dict'}, ['Alice Doe', '30', '', 'True'], ['str', 'str', 'str', 'str'], {'age': 'int', 'ok': 'bool', 'd': 'datetime'}, False)"@en ; chx:input "(lambda g: (exec('import io, csv, json, os, re, sys, tempfile, warnings, subprocess, tracemalloc\\nimport xml.etree.ElementTree as ET\\nA = {\\'name\\': \\'Alice Doe\\', \\'age\\': 30, \\'car\\': None, \\'programmer\\': True, \\'address\\': {\\'street\\': \\'100 Larkin St.\\', \\'city\\': \\'San Francisco\\', \\'zip\\': \\'94102\\'}, \\'phone\\': [{\\'type\\': \\'mobile\\', \\'number\\': \\'415-555-7890\\'}, {\\'type\\': \\'work\\', \\'number\\': \\'415-555-1234\\'}]}\\nNS = \\'xmlns:xsi=\\x22http://www.w3.org/2001/XMLSchema-instance\\x22\\'\\nXS = \\'<person><name>Alice Doe</name><age>30</age><programmer>true</programmer><car xsi:nil=\\x22true\\x22 \\' + NS + \\'/><address><street>100 Larkin St.</street><city>San Francisco</city><zip>94102</zip></address><phone><phoneEntry><type>mobile</type><number>415-555-7890</number></phoneEntry><phoneEntry><type>work</type><number>415-555-1234</number></phoneEntry></phone></person>\\'\\ndef rd(t, **k): return list(csv.reader(io.StringIO(t, newline=\\'\\'), **k))\\ndef wr(rows, **k):\\n    s = io.StringIO(newline=\\'\\'); csv.writer(s, **k).writerows(rows); return s.getvalue()\\ndef err(f):\\n    try: return (\\'ok\\', f())\\n    except Exception as e: return (type(e).__name__, str(e))\\nimport xmltodict, tomllib\\nj = json.loads(json.dumps(A)); x = xmltodict.parse(XS)[\\'person\\']\\nc = rd(wr([[A[\\'name\\'], A[\\'age\\'], A[\\'car\\'], A[\\'programmer\\']]]))[0]\\nt = tomllib.loads(\\'age = 30\\\\nok = true\\\\nd = 2035-04-05T13:34:00\\')\\nout = ({k: type(v).__name__ for k, v in j.items() if k in (\\'age\\', \\'car\\', \\'programmer\\')}, {k: type(x[k]).__name__ for k in (\\'age\\', \\'programmer\\', \\'car\\')}, c, [type(v).__name__ for v in c], {k: type(v).__name__ for k, v in t.items()}, hasattr(tomllib, \\'dumps\\'))', g), g['out'])[1])({})" ; chx:output "({'age': 'int', 'car': 'NoneType', 'programmer': 'bool'}, {'age': 'str', 'programmer': 'str', 'car': 'dict'}, ['Alice Doe', '30', '', 'True'], ['str', 'str', 'str', 'str'], {'age': 'int', 'ok': 'bool', 'd': 'datetime'}, False)" .
chx:X_TypesKept rd:hasIOExample chx:IO_TypesKept .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 18 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch18/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 18 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which rules does each of the three formats impose, which operations read and write them, and which values or structures does each format lose or refuse, given that all three are plain text that a program must still parse and not split?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, programs, numbers and statements of the chapter differ in current releases of Python and the packages, in the files the book ships or in the pages it points to, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 18 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 18 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch18/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.6, installed with uv on 2026-10-12."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py" .

