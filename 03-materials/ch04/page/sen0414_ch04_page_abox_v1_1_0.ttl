pg:Page a ipo:Page, ipo:InteractiveLearningSurface ; rdfs:label "Chapter 4 interactive page"@en ;
    dcterms:source <http://example.org/sen0414/ch04/document> ; ipo:hasSourceDocument pg:SourceDocument ;
    ipo:satisfiesHeuristic ipo:RecognitionRatherThanRecall, ipo:ConsistencyAndStandards, ipo:AestheticAndMinimalistDesign,
        ipo:ShneidermanRule_OfferInformativeFeedback, ipo:ShneidermanRule_PermitEasyReversalOfActions, ipo:HelpAndDocumentation ;
    ipo:hasLayoutPattern pg:Layout ; ipo:hasSemanticRegion pg:Header, pg:Sidebar, pg:Main ;
    ipo:includesNavigationPattern pg:GroupedTopBar, pg:SectionTree ;
    ipo:coversLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4, pg:CO5 ;
    sen0414:navigationRule "BP-D34: 41 sections falls in 26-50, so a grouped permanent top bar with a sub-section sidebar; the named single flowing anchor-page variation of procedure v1.6.0 section 5.3." ;
    sen0414:pythonUsed "Python 3.14.4" .
pg:Layout a ipo:SplitLayout ; rdfs:label "Sidebar and main content"@en .
pg:Header a ipo:Header ; rdfs:label "Sticky header with grouped section bar"@en .
pg:Sidebar a ipo:Sidebar ; rdfs:label "Section tree"@en .
pg:Main a ipo:MainContent ; rdfs:label "Chapter content with inline widgets"@en .
pg:GroupedTopBar a ipo:PrimaryNavigation ; rdfs:label "Grouped permanent top bar"@en .
pg:SectionTree a ipo:TreeNavigation ; rdfs:label "Sub-section sidebar tree"@en .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 4 Stage 3 document"@en ; dcterms:source <http://example.org/sen0414/ch04/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4, pg:CO5 .

pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Write and call a function with def, and trace what the call and the return do"@en ; ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Choose between positional, keyword, default, keyword-only and positional-only parameters for a given call"@en ; ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Predict what a function returns, including None, and explain how the call stack and the recursion limit bound nested calls"@en ; ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Decide whether a name is local or global, and repair an UnboundLocalError with global or nonlocal"@en ; ld:bloomLevel ld:Apply  .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Handle an error raised inside a call with try/except, for one or several exception types"@en ; ld:bloomLevel ld:Apply  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does this print?  def f(a, b=2): return a * b   then   print(f(3))"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "" ; ld:distractorRationale "b takes its default 2 when the call gives no value, so the result is 3 * 2." ; ld:distractorRationale "A parameter with a default may be left out of the call." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "6" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "3" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "TypeError, because b is missing" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Given def g(a, *, b=2): return a + b, which call is valid?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "A parameter after * is keyword-only, so 5 cannot be passed by position." ; ld:distractorRationale "" ; ld:distractorRationale "A positional argument may not follow a keyword argument." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "g(1, 5)" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "g(1, b=5)" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "g(a=1, 5)" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What is the value of x after  def h(): print('hi')   x = h()?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "'hi' is printed, not returned; the call itself has no return statement." ; ld:distractorRationale "" ; ld:distractorRationale "The assignment happens; the function simply returns None." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "'hi'" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "None" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "The name x is not created" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does sys.getrecursionlimit() report in a default Python 3.14 session?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Remember ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "" ; ld:distractorRationale "The interpreter caps nested calls and raises RecursionError beyond it." ; ld:distractorRationale "The default is 1000, not 256." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "1000" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "It has no limit" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "256" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A function assigns spam = 'local' anywhere in its body but prints spam before that line. What happens on the call?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "Any assignment in the body makes the name local for the whole body, so the global one is never read." ; ld:distractorRationale "" ; ld:distractorRationale "Python does not create a name with the value None." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "It prints the global spam" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "UnboundLocalError" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "It prints None" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which change lets a function rebind a module-level counter?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "" ; ld:distractorRationale "nonlocal refers to an enclosing function's variable, not a module-level one." ; ld:distractorRationale "Without global, an assignment creates a local name." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "Write  global counter  at the top of the function" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "Write  nonlocal counter  at the top of a module-level function" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "Nothing; functions can always rebind globals" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does this print?  try: print(42 / 0)   except ZeroDivisionError: print('no')   print('done')"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "" ; ld:distractorRationale "The program continues after the try statement, so done is printed too." ; ld:distractorRationale "The except clause runs when the error is raised." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "no, then done" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "no only" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "done only" .
pg:Q8 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "In Python 3.14, which is correct?"@en ; ld:hasOption pg:Q8_O0, pg:Q8_O1, pg:Q8_O2 ; ld:hasCorrectOption pg:Q8_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "PEP 758 allows the unbracketed form from 3.14." ; ld:distractorRationale "" ; ld:distractorRationale "That was a Python 2 reading; it is not what 3.14 does." .
pg:Q8_O0 a ld:AnswerOption ; rdfs:label "except ValueError, TypeError:  is a syntax error" .
pg:Q8_O1 a ld:AnswerOption ; rdfs:label "except ValueError, TypeError:  catches either type, without brackets when no as is used" .
pg:Q8_O2 a ld:AnswerOption ; rdfs:label "except ValueError, TypeError:  catches ValueError and names it TypeError" .
pg:Q9 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which keyword makes a function stop and hand a value back to its caller?"@en ; ld:hasOption pg:Q9_O0, pg:Q9_O1, pg:Q9_O2 ; ld:hasCorrectOption pg:Q9_O0 ; ld:cognitiveLevel ld:Remember ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "" ; ld:distractorRationale "def only starts the definition." ; ld:distractorRationale "pass does nothing." .
pg:Q9_O0 a ld:AnswerOption ; rdfs:label "return" .
pg:Q9_O1 a ld:AnswerOption ; rdfs:label "def" .
pg:Q9_O2 a ld:AnswerOption ; rdfs:label "pass" .
pg:Q10 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "You have written def hello(): ... and call hello() three times. Where does execution go at each call?"@en ; ld:hasOption pg:Q10_O0, pg:Q10_O1, pg:Q10_O2 ; ld:hasCorrectOption pg:Q10_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "" ; ld:distractorRationale "A call returns to its caller when the body finishes." ; ld:distractorRationale "The body runs again on every call." .
pg:Q10_O0 a ld:AnswerOption ; rdfs:label "Into the function body, then back to the line after the call" .
pg:Q10_O1 a ld:AnswerOption ; rdfs:label "To the end of the program" .
pg:Q10_O2 a ld:AnswerOption ; rdfs:label "Into the body once; later calls are skipped" .
