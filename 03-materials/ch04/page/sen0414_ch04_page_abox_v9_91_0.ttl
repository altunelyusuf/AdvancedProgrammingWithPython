pg:CO1 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Write and call a function with def, and trace what the call and the return do"@en ;
    skos:definition "The objective is met when the reader can write and call a function with def, and trace what the call and the return do, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter4.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO2 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Choose between positional, keyword, default, keyword-only and positional-only parameters for a given call"@en ;
    skos:definition "The objective is met when the reader can choose between positional, keyword, default, keyword-only and positional-only parameters for a given call, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter4.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO3 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Predict what a function returns, including None, and explain how the call stack and the recursion limit bound nested calls"@en ;
    skos:definition "The objective is met when the reader can predict what a function returns, including None, and explain how the call stack and the recursion limit bound nested calls, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter4.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO4 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Decide whether a name is local or global, and repair an UnboundLocalError with global or nonlocal"@en ;
    skos:definition "The objective is met when the reader can decide whether a name is local or global, and repair an UnboundLocalError with global or nonlocal, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter4.html> ;
    ld:bloomLevel ld:Apply  .
pg:CO5 a ipo:LearningObjective, owl:NamedIndividual ; rdfs:label "Handle an error raised inside a call with try/except, for one or several exception types"@en ;
    skos:definition "The objective is met when the reader can handle an error raised inside a call with try/except, for one or several exception types, at the apply level."@en ; dcterms:source <https://automatetheboringstuff.com/3e/chapter4.html> ;
    ld:bloomLevel ld:Apply  .
pg:Q1 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does this print?  def f(a, b=2): return a * b   then   print(f(3))"@en ; ld:hasOption pg:Q1_O0, pg:Q1_O1, pg:Q1_O2 ; ld:hasCorrectOption pg:Q1_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "b takes its default 2 when the call gives no value, so the result is 3 * 2." ;
    ld:distractorRationale "A parameter with a default may be left out of the call." .
pg:Q1_O0 a ld:AnswerOption ; rdfs:label "6" .
pg:Q1_O1 a ld:AnswerOption ; rdfs:label "3" .
pg:Q1_O2 a ld:AnswerOption ; rdfs:label "TypeError, because b is missing" .
pg:Q2 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Given def g(a, *, b=2): return a + b, which call is valid?"@en ; ld:hasOption pg:Q2_O0, pg:Q2_O1, pg:Q2_O2 ; ld:hasCorrectOption pg:Q2_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO2 ;
    ld:distractorRationale "A parameter after * is keyword-only, so 5 cannot be passed by position." ;
    ld:distractorRationale "A positional argument may not follow a keyword argument." .
pg:Q2_O0 a ld:AnswerOption ; rdfs:label "g(1, 5)" .
pg:Q2_O1 a ld:AnswerOption ; rdfs:label "g(1, b=5)" .
pg:Q2_O2 a ld:AnswerOption ; rdfs:label "g(a=1, 5)" .
pg:Q3 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What is the value of x after  def h(): print('hi')   x = h()?"@en ; ld:hasOption pg:Q3_O0, pg:Q3_O1, pg:Q3_O2 ; ld:hasCorrectOption pg:Q3_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "'hi' is printed, not returned; the call itself has no return statement." ;
    ld:distractorRationale "The assignment happens; the function simply returns None." .
pg:Q3_O0 a ld:AnswerOption ; rdfs:label "'hi'" .
pg:Q3_O1 a ld:AnswerOption ; rdfs:label "None" .
pg:Q3_O2 a ld:AnswerOption ; rdfs:label "The name x is not created" .
pg:Q4 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does sys.getrecursionlimit() report in a default Python 3.14 session?"@en ; ld:hasOption pg:Q4_O0, pg:Q4_O1, pg:Q4_O2 ; ld:hasCorrectOption pg:Q4_O0 ; ld:cognitiveLevel ld:Remember ; ld:assessesObjective pg:CO3 ;
    ld:distractorRationale "The interpreter caps nested calls and raises RecursionError beyond it." ;
    ld:distractorRationale "The default is 1000, not 256." .
pg:Q4_O0 a ld:AnswerOption ; rdfs:label "1000" .
pg:Q4_O1 a ld:AnswerOption ; rdfs:label "It has no limit" .
pg:Q4_O2 a ld:AnswerOption ; rdfs:label "256" .
pg:Q5 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "A function assigns spam = 'local' anywhere in its body but prints spam before that line. What happens on the call?"@en ; ld:hasOption pg:Q5_O0, pg:Q5_O1, pg:Q5_O2 ; ld:hasCorrectOption pg:Q5_O1 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "Any assignment in the body makes the name local for the whole body, so the global one is never read." ;
    ld:distractorRationale "Python does not create a name with the value None." .
pg:Q5_O0 a ld:AnswerOption ; rdfs:label "It prints the global spam" .
pg:Q5_O1 a ld:AnswerOption ; rdfs:label "UnboundLocalError" .
pg:Q5_O2 a ld:AnswerOption ; rdfs:label "It prints None" .
pg:Q6 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which change lets a function rebind a module-level counter?"@en ; ld:hasOption pg:Q6_O0, pg:Q6_O1, pg:Q6_O2 ; ld:hasCorrectOption pg:Q6_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO4 ;
    ld:distractorRationale "nonlocal refers to an enclosing function's variable, not a module-level one." ;
    ld:distractorRationale "Without global, an assignment creates a local name." .
pg:Q6_O0 a ld:AnswerOption ; rdfs:label "Write  global counter  at the top of the function" .
pg:Q6_O1 a ld:AnswerOption ; rdfs:label "Write  nonlocal counter  at the top of a module-level function" .
pg:Q6_O2 a ld:AnswerOption ; rdfs:label "Nothing; functions can always rebind globals" .
pg:Q7 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "What does this print?  try: print(42 / 0)   except ZeroDivisionError: print('no')   print('done')"@en ; ld:hasOption pg:Q7_O0, pg:Q7_O1, pg:Q7_O2 ; ld:hasCorrectOption pg:Q7_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "The program continues after the try statement, so done is printed too." ;
    ld:distractorRationale "The except clause runs when the error is raised." .
pg:Q7_O0 a ld:AnswerOption ; rdfs:label "no, then done" .
pg:Q7_O1 a ld:AnswerOption ; rdfs:label "no only" .
pg:Q7_O2 a ld:AnswerOption ; rdfs:label "done only" .
pg:Q8 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "In Python 3.14, which is correct?"@en ; ld:hasOption pg:Q8_O0, pg:Q8_O1, pg:Q8_O2 ; ld:hasCorrectOption pg:Q8_O1 ; ld:cognitiveLevel ld:Understand ; ld:assessesObjective pg:CO5 ;
    ld:distractorRationale "PEP 758 allows the unbracketed form from 3.14." ;
    ld:distractorRationale "That was a Python 2 reading; it is not what 3.14 does." .
pg:Q8_O0 a ld:AnswerOption ; rdfs:label "except ValueError, TypeError:  is a syntax error" .
pg:Q8_O1 a ld:AnswerOption ; rdfs:label "except ValueError, TypeError:  catches either type, without brackets when no as is used" .
pg:Q8_O2 a ld:AnswerOption ; rdfs:label "except ValueError, TypeError:  catches ValueError and names it TypeError" .
pg:Q9 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "Which keyword makes a function stop and hand a value back to its caller?"@en ; ld:hasOption pg:Q9_O0, pg:Q9_O1, pg:Q9_O2 ; ld:hasCorrectOption pg:Q9_O0 ; ld:cognitiveLevel ld:Remember ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "def only starts the definition." ;
    ld:distractorRationale "pass does nothing." .
pg:Q9_O0 a ld:AnswerOption ; rdfs:label "return" .
pg:Q9_O1 a ld:AnswerOption ; rdfs:label "def" .
pg:Q9_O2 a ld:AnswerOption ; rdfs:label "pass" .
pg:Q10 a ld:AssessmentItem, owl:NamedIndividual ; rdfs:label "You have written def hello(): ... and call hello() three times. Where does execution go at each call?"@en ; ld:hasOption pg:Q10_O0, pg:Q10_O1, pg:Q10_O2 ; ld:hasCorrectOption pg:Q10_O0 ; ld:cognitiveLevel ld:Apply ; ld:assessesObjective pg:CO1 ;
    ld:distractorRationale "A call returns to its caller when the body finishes." ;
    ld:distractorRationale "The body runs again on every call." .
pg:Q10_O0 a ld:AnswerOption ; rdfs:label "Into the function body, then back to the line after the call" .
pg:Q10_O1 a ld:AnswerOption ; rdfs:label "To the end of the program" .
pg:Q10_O2 a ld:AnswerOption ; rdfs:label "Into the body once; later calls are skipped" .
pg:Function a ipo:ChapterSection ; rdfs:label "Function"@en ;
    skos:definition "A function is a named piece of code that a program can run whenever it needs that work done, from as many places as it likes. The textbook describes it as a mini program within a program (Sweigart, 2025), and the Python glossary states the same idea more formally: a series of statements which returns some value to a caller, and which can also be passed zero or more arguments that are used while its body runs (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Function> ;
    sen0414:anchor "#s-Function" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Function .
pg:Definition a ipo:ChapterSection ; rdfs:label "Definition"@en ;
    skos:definition "The definition branch covers how a function is created and how it is run. A function is created by a def statement, which names the function and gives it a body; it is run by a function call, which names the function again and supplies any arguments (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Definition> ;
    sen0414:anchor "#s-Definition" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Function .
pg:Page ipo:coversChapterSection pg:Definition .
pg:DefStatement a ipo:ChapterSection ; rdfs:label "Def statement"@en ;
    skos:definition "A def statement is the construct with which a Python program creates a function of its own. It is written with the keyword def, the name chosen for the function, a pair of parentheses and a colon, and it is followed by an indented block of statements that forms the body."@en ; dcterms:source <http://example.org/sen0414/ch04#S_DefStatement> ;
    sen0414:anchor "#s-DefStatement" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Definition .
pg:Page ipo:coversChapterSection pg:DefStatement .
pg:FunctionBody a ipo:ChapterSection ; rdfs:label "Function body"@en ;
    skos:definition "The body of a function is the block of indented statements that follows the colon of the def line. The textbook puts it directly: the code in the block that follows the def statement is the body of the function (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_FunctionBody> ;
    sen0414:anchor "#s-FunctionBody" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Definition .
pg:Page ipo:coversChapterSection pg:FunctionBody .
pg:FunctionObject a ipo:ChapterSection ; rdfs:label "Function object"@en ;
    skos:definition "A function object is the value that Python builds when it executes a def statement. The language reference describes the execution of the statement as binding the function name in the current local namespace to a function object, a wrapper around the executable code for the function (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_FunctionObject> ;
    sen0414:anchor "#s-FunctionObject" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Definition .
pg:Page ipo:coversChapterSection pg:FunctionObject .
pg:ReservedKeyword a ipo:ChapterSection ; rdfs:label "Reserved keyword"@en ;
    skos:definition "A keyword is a word that has a fixed meaning in the Python language, which is why it cannot be chosen as the name of a variable or function. The words def, return, global, nonlocal, try and except that this chapter introduces are all keywords."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ReservedKeyword> ;
    sen0414:anchor "#s-ReservedKeyword" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Definition .
pg:Page ipo:coversChapterSection pg:ReservedKeyword .
pg:LambdaExpression a ipo:ChapterSection ; rdfs:label "Lambda expression"@en ;
    skos:definition "A lambda expression creates a small function in the middle of another expression. The glossary calls it an anonymous inline function consisting of a single expression which is evaluated when the function is called, written as lambda parameters: expression (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_LambdaExpression> ;
    sen0414:anchor "#s-LambdaExpression" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Definition .
pg:Page ipo:coversChapterSection pg:LambdaExpression .
pg:NestedFunction a ipo:ChapterSection ; rdfs:label "Nested function"@en ;
    skos:definition "A nested function is a function that is defined inside the body of another function. The reference notes that a def statement executed inside a function definition defines a local function that can be returned or passed around, and that such a function can use the local variables of the function containing the def (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_NestedFunction> ;
    sen0414:anchor "#s-NestedFunction" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Definition .
pg:Page ipo:coversChapterSection pg:NestedFunction .
pg:FunctionCall a ipo:ChapterSection ; rdfs:label "Function call"@en ;
    skos:definition "A function call is the function's name followed by parentheses, with the arguments, if there are any, written between them. The textbook states that when the program execution reaches such a call it will jump to the first line in the function and begin executing the code there (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_FunctionCall> ;
    sen0414:anchor "#s-FunctionCall" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Definition .
pg:Page ipo:coversChapterSection pg:FunctionCall .
pg:ModuleFunction a ipo:ChapterSection ; rdfs:label "Module function"@en ;
    skos:definition "A module function is a function that is defined in a module and used after importing that module. The chapter's fortune-telling program imports the module random and then calls random.randint(1, 9), whose two arguments are the smallest and the largest number that may come back (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ModuleFunction> ;
    sen0414:anchor "#s-ModuleFunction" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Definition .
pg:Page ipo:coversChapterSection pg:ModuleFunction .
pg:Deduplication a ipo:ChapterSection ; rdfs:label "Deduplication"@en ;
    skos:definition "Deduplication means getting rid of copied-and-pasted code, and the chapter names it as a major purpose of functions. The textbook explains that without a function you would have to copy and paste the code each time you wanted to run it, and that deduplication makes programs shorter, easier to read and easier to update (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Deduplication> ;
    sen0414:anchor "#s-Deduplication" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Definition .
pg:Page ipo:coversChapterSection pg:Deduplication .
pg:Parameters a ipo:ChapterSection ; rdfs:label "Parameters"@en ;
    skos:definition "Parameters are the way values get into a function. A function definition lists the names that will receive the values, and each call supplies the values themselves."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Parameters> ;
    sen0414:anchor "#s-Parameters" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Function .
pg:Page ipo:coversChapterSection pg:Parameters .
pg:ParameterAndArgument a ipo:ChapterSection ; rdfs:label "Parameter and argument"@en ;
    skos:definition "An argument is a value that is passed to a function in a call, and a parameter is the variable in the function definition that receives it. The textbook defines the pair with one example: in def say_hello_to(name) the name is a parameter, and in the call say_hello_to('Al') the string 'Al' is an argument that is assigned to the parameter (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ParameterAndArgument> ;
    sen0414:anchor "#s-ParameterAndArgument" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Parameters .
pg:Page ipo:coversChapterSection pg:ParameterAndArgument .
pg:PositionalArgument a ipo:ChapterSection ; rdfs:label "Positional argument"@en ;
    skos:definition "A positional argument is an argument that Python matches to a parameter by its place in the call: the first argument goes to the first parameter, the second to the second, and so on. The glossary defines it negatively but precisely, as an argument that is not a keyword argument, one that appears at the beginning of an argument list (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_PositionalArgument> ;
    sen0414:anchor "#s-PositionalArgument" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Parameters .
pg:Page ipo:coversChapterSection pg:PositionalArgument .
pg:NamedParameter a ipo:ChapterSection ; rdfs:label "Named parameter"@en ;
    skos:definition "A named parameter is a parameter whose argument is identified by the name written before it in the call, as in sep=',', and not by its position. The textbook adds that you will also hear named parameters called keyword parameters or keyword arguments, though they have nothing to do with Python keywords (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_NamedParameter> ;
    sen0414:anchor "#s-NamedParameter" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Parameters .
pg:Page ipo:coversChapterSection pg:NamedParameter .
pg:PositionalOnlyParameter a ipo:ChapterSection ; rdfs:label "Positional-only parameter"@en ;
    skos:definition "A positional-only parameter is a parameter that can receive its argument only by position and never by name. It is marked by placing a slash in the parameter list: every parameter before the slash is positional-only."@en ; dcterms:source <http://example.org/sen0414/ch04#S_PositionalOnlyParameter> ;
    sen0414:anchor "#s-PositionalOnlyParameter" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Parameters .
pg:Page ipo:coversChapterSection pg:PositionalOnlyParameter .
pg:KeywordOnlyParameter a ipo:ChapterSection ; rdfs:label "Keyword-only parameter"@en ;
    skos:definition "A keyword-only parameter is a parameter that can receive its argument only by name. It is marked by a star in the parameter list: every parameter after the bare star is keyword-only."@en ; dcterms:source <http://example.org/sen0414/ch04#S_KeywordOnlyParameter> ;
    sen0414:anchor "#s-KeywordOnlyParameter" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Parameters .
pg:Page ipo:coversChapterSection pg:KeywordOnlyParameter .
pg:DefaultArgument a ipo:ChapterSection ; rdfs:label "Default argument"@en ;
    skos:definition "A default argument value is a value written in the definition, as in def greet(name, greeting='Hello'), which Python uses when a call leaves that argument out. The reference says that a parameter written as parameter = expression gives the function default parameter values and that the corresponding argument may then be omitted from a call (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_DefaultArgument> ;
    sen0414:anchor "#s-DefaultArgument" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Parameters .
pg:Page ipo:coversChapterSection pg:DefaultArgument .
pg:Result a ipo:ChapterSection ; rdfs:label "Result"@en ;
    skos:definition "The result of a function is what a call evaluates to once the body has finished. In everyday speech a function gives something back; in Python terms the call is replaced, inside the expression that contains it, by the function's return value."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Result> ;
    sen0414:anchor "#s-Result" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Result .
pg:ReturnValue a ipo:ChapterSection ; rdfs:label "Return value"@en ;
    skos:definition "The return value is the value that a function call evaluates to. It is produced by the function's return statement or, when there is none, by the value None that Python supplies."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ReturnValue> ;
    sen0414:anchor "#s-ReturnValue" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Result .
pg:Page ipo:coversChapterSection pg:ReturnValue .
pg:ReturnStatement a ipo:ChapterSection ; rdfs:label "Return statement"@en ;
    skos:definition "A return statement ends a function call and chooses the value that the call evaluates to. The textbook says that it consists of the return keyword and the value or expression that the function should return (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ReturnStatement> ;
    sen0414:anchor "#s-ReturnStatement" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReturnValue .
pg:Page ipo:coversChapterSection pg:ReturnStatement .
pg:ImplicitNone a ipo:ChapterSection ; rdfs:label "Implicit None"@en ;
    skos:definition "A function that never executes a return statement with a value still returns something: it returns None. The tutorial answers an objection that people from other languages raise, that such a function is a procedure and not a function, by stating that even functions without a return statement do return a value, albeit a rather boring one, and that this value is called None (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ImplicitNone> ;
    sen0414:anchor "#s-ImplicitNone" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReturnValue .
pg:Page ipo:coversChapterSection pg:ImplicitNone .
pg:CallAsExpression a ipo:ChapterSection ; rdfs:label "Call as expression"@en ;
    skos:definition "Using a call as an expression means putting a function call wherever a value is expected, for instance inside the parentheses of another call. The textbook notes that because you can pass return values as arguments to other function calls, the three lines r = random.randint(1, 9), fortune = get_answer(r) and print(fortune) can be shortened to the single equivalent line print(get_answer(random.randint(1, 9))) (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_CallAsExpression> ;
    sen0414:anchor "#s-CallAsExpression" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:ReturnValue .
pg:Page ipo:coversChapterSection pg:CallAsExpression .
pg:NoneType a ipo:ChapterSection ; rdfs:label "NoneType"@en ;
    skos:definition "NoneType is the data type of the single value None. The branch explains the value and the right way to test for it."@en ; dcterms:source <http://example.org/sen0414/ch04#S_NoneType> ;
    sen0414:anchor "#s-NoneType" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Result .
pg:Page ipo:coversChapterSection pg:NoneType .
pg:NoneValue a ipo:ChapterSection ; rdfs:label "None value"@en ;
    skos:definition "None is a value that represents the absence of a value. The textbook states that it is the only value of the NoneType data type, that other programming languages might call it null, nil or undefined, and that it must always be written with a capital N, just like the Booleans True and False (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_NoneValue> ;
    sen0414:anchor "#s-NoneValue" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NoneType .
pg:Page ipo:coversChapterSection pg:NoneValue .
pg:IdentityTest a ipo:ChapterSection ; rdfs:label "Identity test"@en ;
    skos:definition "An identity test asks whether two names refer to the very same object. The operators is and is not perform it: the language reference says that x is y is true if and only if x and y are the same object (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_IdentityTest> ;
    sen0414:anchor "#s-IdentityTest" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:NoneType .
pg:Page ipo:coversChapterSection pg:IdentityTest .
pg:Frames a ipo:ChapterSection ; rdfs:label "Frames and the call stack"@en ;
    skos:definition "A frame is the record that Python keeps for one running function call, and the call stack is the pile of such records that exist at a given moment. The language reference explains that a code block is executed in an execution frame, which contains some administrative information and determines where and how execution continues after the block's execution has completed (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Frames> ;
    sen0414:anchor "#s-Frames" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Frames .
pg:CallStack a ipo:ChapterSection ; rdfs:label "Call stack"@en ;
    skos:definition "The call stack is the stack of frames, one for each function call that has started and not yet returned. It is not a variable in the program; the textbook describes it as a section of your computer's memory that Python handles automatically behind the scenes (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_CallStack> ;
    sen0414:anchor "#s-CallStack" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Frames .
pg:Page ipo:coversChapterSection pg:CallStack .
pg:CallStackOrder a ipo:ChapterSection ; rdfs:label "Call stack order"@en ;
    skos:definition "The call stack order is the order in which function calls start and finish when some of them call others. The textbook states the rule: calling a function doesn't send the execution on a one-way trip to the top of a function, because Python will remember which line of code called the function so that the execution can return there when it encounters a return statement (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_CallStackOrder> ;
    sen0414:anchor "#s-CallStackOrder" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CallStack .
pg:Page ipo:coversChapterSection pg:CallStackOrder .
pg:FrameObject a ipo:ChapterSection ; rdfs:label "Frame object"@en ;
    skos:definition "A frame object is the record that Python creates for a function call and places on the call stack. The textbook says that frame objects store the line number of the original function call so that Python can remember where to return (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_FrameObject> ;
    sen0414:anchor "#s-FrameObject" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CallStack .
pg:Page ipo:coversChapterSection pg:FrameObject .
pg:StackInspection a ipo:ChapterSection ; rdfs:label "Stack inspection"@en ;
    skos:definition "Stack inspection means reading the call stack from within the program. The traceback module offers traceback.extract_stack(), which the documentation describes as extracting the raw traceback from the current stack frame (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_StackInspection> ;
    sen0414:anchor "#s-StackInspection" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CallStack .
pg:Page ipo:coversChapterSection pg:StackInspection .
pg:Recursion a ipo:ChapterSection ; rdfs:label "Recursion"@en ;
    skos:definition "Recursion is the situation in which a function calls itself. The tutorial mentions it in passing: when a function calls another function, or calls itself recursively, a new local symbol table is created for that call (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Recursion> ;
    sen0414:anchor "#s-Recursion" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:CallStack .
pg:Page ipo:coversChapterSection pg:Recursion .
pg:Scope a ipo:ChapterSection ; rdfs:label "Scope"@en ;
    skos:definition "A scope is the part of a program in which a name can be used, and the scope of a variable decides which variable a name refers to. The textbook asks the reader to think of a scope as a container for variables (Sweigart, 2025), and the language reference defines it as what determines the visibility of a name within a block (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Scope> ;
    sen0414:anchor "#s-Scope" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Scope .
pg:Namespaces a ipo:ChapterSection ; rdfs:label "Namespaces"@en ;
    skos:definition "A namespace is the place where a variable is stored. The glossary adds that namespaces are implemented as dictionaries, which are tables that pair a name with a value, and that there are the local, global and built-in namespaces as well as nested namespaces in objects (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Namespaces> ;
    sen0414:anchor "#s-Namespaces" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Scope .
pg:Page ipo:coversChapterSection pg:Namespaces .
pg:LocalScope a ipo:ChapterSection ; rdfs:label "Local scope"@en ;
    skos:definition "The local scope of a function call is the container for the parameters and for the variables assigned in the function while it runs. The textbook says that only code within a called function can access the parameters and variables assigned in that function, and that such a variable is called a local variable (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_LocalScope> ;
    sen0414:anchor "#s-LocalScope" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Namespaces .
pg:Page ipo:coversChapterSection pg:LocalScope .
pg:GlobalScope a ipo:ChapterSection ; rdfs:label "Global scope"@en ;
    skos:definition "The global scope is the container for the variables assigned outside all functions. The textbook says that code anywhere in a program can access such variables, which are called global variables, and that a variable must be local or global; it cannot be both (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_GlobalScope> ;
    sen0414:anchor "#s-GlobalScope" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Namespaces .
pg:Page ipo:coversChapterSection pg:GlobalScope .
pg:SameNameVariables a ipo:ChapterSection ; rdfs:label "Same-name variables"@en ;
    skos:definition "Variables with the same name can exist in different scopes at the same time, and they are different variables. The textbook states the fourth scope rule in these words: you can use the same name for different variables if they are in different scopes (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_SameNameVariables> ;
    sen0414:anchor "#s-SameNameVariables" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Namespaces .
pg:Page ipo:coversChapterSection pg:SameNameVariables .
pg:EnclosingScope a ipo:ChapterSection ; rdfs:label "Enclosing scope"@en ;
    skos:definition "An enclosing scope is the local scope of the function inside which another function is defined. The glossary calls the ability to refer to a variable in an enclosing definition a nested scope, and gives the example of a function defined inside another function referring to variables in the outer function (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_EnclosingScope> ;
    sen0414:anchor "#s-EnclosingScope" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Namespaces .
pg:Page ipo:coversChapterSection pg:EnclosingScope .
pg:BuiltinScope a ipo:ChapterSection ; rdfs:label "Built-in scope"@en ;
    skos:definition "The built-in scope is the namespace that holds the names Python provides in every program, such as print, input, len and int. The language reference calls it the builtins namespace, the namespace of the module builtins, and says that names are resolved by searching the global namespace first and the builtins namespace next (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_BuiltinScope> ;
    sen0414:anchor "#s-BuiltinScope" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Namespaces .
pg:Page ipo:coversChapterSection pg:BuiltinScope .
pg:Rules a ipo:ChapterSection ; rdfs:label "Scope rules"@en ;
    skos:definition "The scope rules are the statements that decide whether a name in a function is local or global, and what happens when a program breaks them. The textbook states two sets of rules: four rules that say what code can use which variables, and four rules for identifying whether a variable belongs to a local or the global scope (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Rules> ;
    sen0414:anchor "#s-Rules" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Scope .
pg:Page ipo:coversChapterSection pg:Rules .
pg:LocalIsolation a ipo:ChapterSection ; rdfs:label "Local isolation"@en ;
    skos:definition "Local isolation is the pair of rules that keeps the local variables of a function private. The textbook states them as: code that is in the global scope, outside all functions, can't use local variables; and code that is in one function's local scope can't use variables in any other local scope (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_LocalIsolation> ;
    sen0414:anchor "#s-LocalIsolation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Rules .
pg:Page ipo:coversChapterSection pg:LocalIsolation .
pg:GlobalAccess a ipo:ChapterSection ; rdfs:label "Global access"@en ;
    skos:definition "Global access is the rule that code in a local scope can read global variables. The textbook gives the condition: because the function has no parameter with that name, nor any code that assigns the name a value, Python considers the function's use of the name to be a reference to the global variable (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_GlobalAccess> ;
    sen0414:anchor "#s-GlobalAccess" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Rules .
pg:Page ipo:coversChapterSection pg:GlobalAccess .
pg:NameResolution a ipo:ChapterSection ; rdfs:label "Name resolution"@en ;
    skos:definition "Name resolution is the process by which Python decides which variable a name refers to. The language reference states it in one sentence: when a name is used in a code block, it is resolved using the nearest enclosing scope (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_NameResolution> ;
    sen0414:anchor "#s-NameResolution" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Rules .
pg:Page ipo:coversChapterSection pg:NameResolution .
pg:NameError a ipo:ChapterSection ; rdfs:label "NameError"@en ;
    skos:definition "NameError is the exception that Python raises when a name is used and no scope contains it. The library reference describes it as raised when a local or global name is not found, and states that the associated value is an error message that includes the name that could not be found (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_NameError> ;
    sen0414:anchor "#s-NameError" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Rules .
pg:Page ipo:coversChapterSection pg:NameError .
pg:GlobalStatement a ipo:ChapterSection ; rdfs:label "Global statement"@en ;
    skos:definition "The global statement tells Python that a name inside a function refers to the global variable. The textbook explains that a line such as global eggs at the top of a function tells Python: in this function, eggs refers to the global variable, so don't create a local variable with this name (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_GlobalStatement> ;
    sen0414:anchor "#s-GlobalStatement" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Rules .
pg:Page ipo:coversChapterSection pg:GlobalStatement .
pg:ScopeIdentification a ipo:ChapterSection ; rdfs:label "Scope identification"@en ;
    skos:definition "Scope identification is the set of four rules with which the textbook decides whether a variable belongs to a local scope or the global scope. A variable in the global scope, outside all functions, is always a global variable; a variable in a function with a global statement is a global variable in that function; otherwise, if a function uses a variable in an assignment statement, it is a local variable; however, if the function uses a variable but never in an assignment statement, it is a global variable (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ScopeIdentification> ;
    sen0414:anchor "#s-ScopeIdentification" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Rules .
pg:Page ipo:coversChapterSection pg:ScopeIdentification .
pg:SymbolTable a ipo:ChapterSection ; rdfs:label "Symbol table"@en ;
    skos:definition "A symbol table is the table in which the Python compiler records every name used in a block and what kind of name it is. The documentation of the symtable module says that symbol tables are generated by the compiler from the syntax tree, the structured form of the program text, just before bytecode is generated, and that the symbol table is responsible for calculating the scope of every identifier in the code (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_SymbolTable> ;
    sen0414:anchor "#s-SymbolTable" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Rules .
pg:Page ipo:coversChapterSection pg:SymbolTable .
pg:UnboundLocalError a ipo:ChapterSection ; rdfs:label "UnboundLocalError"@en ;
    skos:definition "UnboundLocalError is the exception raised when a function uses a local variable before any value has been assigned to it. The library reference describes it as raised when a reference is made to a local variable in a function or method, but no value has been bound to that variable, and states that it is a subclass of NameError (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_UnboundLocalError> ;
    sen0414:anchor "#s-UnboundLocalError" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Rules .
pg:Page ipo:coversChapterSection pg:UnboundLocalError .
pg:NonlocalStatement a ipo:ChapterSection ; rdfs:label "Nonlocal statement"@en ;
    skos:definition "The nonlocal statement lets a nested function assign to a variable of the function around it. The language reference says that it causes the listed identifiers to refer to names previously bound in nonlocal scopes, which are the local scopes of the enclosing functions, and that it allows encapsulated code to rebind such nonlocal identifiers (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_NonlocalStatement> ;
    sen0414:anchor "#s-NonlocalStatement" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Rules .
pg:Page ipo:coversChapterSection pg:NonlocalStatement .
pg:ErrorHandling a ipo:ChapterSection ; rdfs:label "Error handling"@en ;
    skos:definition "Error handling is the part of a program that decides what happens when something goes wrong. In Python an error that stops a statement is called an exception, and the language has two statements for dealing with it: try marks the code that might fail, and except says what to do when it does."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ErrorHandling> ;
    sen0414:anchor "#s-ErrorHandling" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:ErrorHandling .
pg:Exceptions a ipo:ChapterSection ; rdfs:label "Exceptions"@en ;
    skos:definition "An exception is Python's way of reporting that a statement could not be carried out. The tutorial separates two kinds of mistake: syntax errors, also known as parsing errors, and errors detected during execution, which are called exceptions and are not unconditionally fatal (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Exceptions> ;
    sen0414:anchor "#s-Exceptions" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ErrorHandling .
pg:Page ipo:coversChapterSection pg:Exceptions .
pg:TryExcept a ipo:ChapterSection ; rdfs:label "Try and except"@en ;
    skos:definition "A try statement has two parts. The code that could potentially have an error is put in a try clause, and the program execution moves to the start of a following except clause if an error happens (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_TryExcept> ;
    sen0414:anchor "#s-TryExcept" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Exceptions .
pg:Page ipo:coversChapterSection pg:TryExcept .
pg:ErrorInCall a ipo:ChapterSection ; rdfs:label "Error in a called function"@en ;
    skos:definition "A try clause also catches the errors of the functions it calls. The textbook says that any errors that occur in function calls in a try block will also be caught (Sweigart, 2025), so the try statement does not have to be in the same function as the statement that fails."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ErrorInCall> ;
    sen0414:anchor "#s-ErrorInCall" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Exceptions .
pg:Page ipo:coversChapterSection pg:ErrorInCall .
pg:MultipleExceptTypes a ipo:ChapterSection ; rdfs:label "Several exception types in one except"@en ;
    skos:definition "One except clause can name several exception types, so that the same block of code handles any of them. The tutorial's try statement says that an except clause may name multiple exceptions and shows the form except RuntimeError, TypeError, NameError: with no brackets around the names (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_MultipleExceptTypes> ;
    sen0414:anchor "#s-MultipleExceptTypes" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Exceptions .
pg:Page ipo:coversChapterSection pg:MultipleExceptTypes .
pg:ExceptionObject a ipo:ChapterSection ; rdfs:label "Exception object"@en ;
    skos:definition "An exception is an object. The tutorial explains that when an exception occurs it may have associated values, also known as the exception's arguments, and that an except clause may specify a variable after the exception name; the variable is bound to the exception instance, the object created for this occurrence of the error, which typically has an args attribute that stores the arguments (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ExceptionObject> ;
    sen0414:anchor "#s-ExceptionObject" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Exceptions .
pg:Page ipo:coversChapterSection pg:ExceptionObject .
pg:Traceback a ipo:ChapterSection ; rdfs:label "Traceback"@en ;
    skos:definition "A traceback is the report that Python prints when an exception is not handled. The tutorial describes its two parts: the last line indicates what happened, naming the exception type and giving detail, and the preceding part shows the context where the exception occurred, in the form of a stack traceback listing source lines (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Traceback> ;
    sen0414:anchor "#s-Traceback" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Exceptions .
pg:Page ipo:coversChapterSection pg:Traceback .
pg:ZeroDivisionError a ipo:ChapterSection ; rdfs:label "ZeroDivisionError"@en ;
    skos:definition "ZeroDivisionError is the exception that Python raises when you divide by zero. The library reference describes it as raised when the second argument of a division or modulo operation is zero, and says the associated value is a string indicating the type of the operands and the operation (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ZeroDivisionError> ;
    sen0414:anchor "#s-ZeroDivisionError" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Exceptions .
pg:Page ipo:coversChapterSection pg:ZeroDivisionError .
pg:ExceptionHierarchy a ipo:ChapterSection ; rdfs:label "Exception hierarchy"@en ;
    skos:definition "The built-in exceptions are classes, kinds of object like the int and str of chapter 1, arranged in a tree, and the library reference lists the whole tree. An exception object is an instance of its class, the way the number 5 is an instance of int."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ExceptionHierarchy> ;
    sen0414:anchor "#s-ExceptionHierarchy" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Exceptions .
pg:Page ipo:coversChapterSection pg:ExceptionHierarchy .
pg:Programs a ipo:ChapterSection ; rdfs:label "Short programs"@en ;
    skos:definition "This branch collects the programs that the chapter uses to put its ideas to work. Two of them are short animation programs, zigzag and spike, which print lines of characters until the user stops them."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Programs> ;
    sen0414:anchor "#s-Programs" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:Programs .
pg:Animation a ipo:ChapterSection ; rdfs:label "Animation programs"@en ;
    skos:definition "An animation program draws something new at regular intervals, so that the output seems to move. The textbook's two examples need no graphics: each prints a line of characters, waits one tenth of a second and prints the next, and the changing position or length of the lines makes a pattern that scrolls up the screen (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Animation> ;
    sen0414:anchor "#s-Animation" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Programs .
pg:Page ipo:coversChapterSection pg:Animation .
pg:ZigzagProgram a ipo:ChapterSection ; rdfs:label "Zigzag program"@en ;
    skos:definition "The zigzag program prints a band of eight asterisks over and over, moving it to the right until it is 20 spaces in, then back to the left, forever. The textbook says that the program creates a back-and-forth zigzag pattern until the user stops it (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ZigzagProgram> ;
    sen0414:anchor "#s-ZigzagProgram" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Animation .
pg:Page ipo:coversChapterSection pg:ZigzagProgram .
pg:SpikeProgram a ipo:ChapterSection ; rdfs:label "Spike program"@en ;
    skos:definition "The spike program draws a triangular spike of dashes that scrolls up the screen, forever. The textbook describes it as a program that uses string replication and nested loops to draw spikes (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_SpikeProgram> ;
    sen0414:anchor "#s-SpikeProgram" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Animation .
pg:Page ipo:coversChapterSection pg:SpikeProgram .
pg:TimeSleep a ipo:ChapterSection ; rdfs:label "The time.sleep function"@en ;
    skos:definition "The function time.sleep pauses a program. The library reference says that it suspends execution of the calling thread for the given number of seconds, and that the argument may be a floating-point number to indicate a more precise sleep time (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_TimeSleep> ;
    sen0414:anchor "#s-TimeSleep" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Animation .
pg:Page ipo:coversChapterSection pg:TimeSleep .
pg:KeyboardInterrupt a ipo:ChapterSection ; rdfs:label "KeyboardInterrupt"@en ;
    skos:definition "KeyboardInterrupt is the exception that Python raises when the user presses Ctrl-C while a program is running. The textbook says exactly this: when the user presses CTRL-C while a Python program is running, Python raises the KeyboardInterrupt exception (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_KeyboardInterrupt> ;
    sen0414:anchor "#s-KeyboardInterrupt" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Animation .
pg:Page ipo:coversChapterSection pg:KeyboardInterrupt .
pg:SysExit a ipo:ChapterSection ; rdfs:label "The sys.exit function"@en ;
    skos:definition "The function sys.exit ends a program. The library reference says that it raises a SystemExit exception, signaling an intention to exit the interpreter (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_SysExit> ;
    sen0414:anchor "#s-SysExit" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Animation .
pg:Page ipo:coversChapterSection pg:SysExit .
pg:PracticeProgram a ipo:ChapterSection ; rdfs:label "Practice programs"@en ;
    skos:definition "The textbook ends the chapter with practice programs: tasks for the reader to write without a model solution (Sweigart, 2025). The two tasks in this chapter build on one another."@en ; dcterms:source <http://example.org/sen0414/ch04#S_PracticeProgram> ;
    sen0414:anchor "#s-PracticeProgram" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:Programs .
pg:Page ipo:coversChapterSection pg:PracticeProgram .
pg:CollatzSequence a ipo:ChapterSection ; rdfs:label "Collatz sequence"@en ;
    skos:definition "The Collatz sequence is the first practice program. The textbook asks for a function named collatz that has one parameter named number: if number is even, the function should print number // 2 and return this value, and if number is odd, it should print and return 3 * number + 1 (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_CollatzSequence> ;
    sen0414:anchor "#s-CollatzSequence" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticeProgram .
pg:Page ipo:coversChapterSection pg:CollatzSequence .
pg:InputValidation a ipo:ChapterSection ; rdfs:label "Input validation"@en ;
    skos:definition "Input validation means checking what the user typed before using it. The second practice task asks the reader to add try and except statements to the previous project to detect whether the user entered a non-integer string (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_InputValidation> ;
    sen0414:anchor "#s-InputValidation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:PracticeProgram .
pg:Page ipo:coversChapterSection pg:InputValidation .
pg:ModernPractice a ipo:ChapterSection ; rdfs:label "Modern practice"@en ;
    skos:definition "Modern practice is the part of the chapter that goes beyond the textbook's list of topics to what a programmer needs around functions today. It has two groups."@en ; dcterms:source <http://example.org/sen0414/ch04#S_ModernPractice> ;
    sen0414:anchor "#s-ModernPractice" ; sen0414:sectionLevel 1 .
pg:Page ipo:coversChapterSection pg:ModernPractice .
pg:Annotations a ipo:ChapterSection ; rdfs:label "Annotations"@en ;
    skos:definition "An annotation is an expression written next to a parameter or after the arrow that follows the parameter list. PEP 3107 defines function annotations, both for parameters and return values, as completely optional and as nothing more than a way of associating arbitrary Python expressions with various parts of a function at compile-time (Winter and Lownds, 2006)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Annotations> ;
    sen0414:anchor "#s-Annotations" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ModernPractice .
pg:Page ipo:coversChapterSection pg:Annotations .
pg:TypeAnnotation a ipo:ChapterSection ; rdfs:label "Function annotation"@en ;
    skos:definition "A function annotation is a note attached to a parameter or to the return value. For a parameter it follows the name after a colon, and for the result it follows an arrow made of a hyphen and a greater-than sign, placed before the colon that ends the def line."@en ; dcterms:source <http://example.org/sen0414/ch04#S_TypeAnnotation> ;
    sen0414:anchor "#s-TypeAnnotation" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Annotations .
pg:Page ipo:coversChapterSection pg:TypeAnnotation .
pg:DeferredAnnotations a ipo:ChapterSection ; rdfs:label "Deferred annotations"@en ;
    skos:definition "Deferred evaluation means that Python 3.14 does not work out an annotation when the function is defined, but stores it and works it out only when somebody asks. What's New in Python 3.14 states it: the annotations on functions, classes and modules are no longer evaluated eagerly; instead they are stored in special-purpose annotate functions and evaluated only when necessary (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_DeferredAnnotations> ;
    sen0414:anchor "#s-DeferredAnnotations" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Annotations .
pg:Page ipo:coversChapterSection pg:DeferredAnnotations .
pg:Style a ipo:ChapterSection ; rdfs:label "Style"@en ;
    skos:definition "Style means the habits of writing and using a function that go beyond making it work. The textbook has one such idea, the black box, and PEP 8 is the style guide for the code in Python's standard library (Van Rossum et al., 2001)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Style> ;
    sen0414:anchor "#s-Style" ; sen0414:sectionLevel 2 ; dcterms:isPartOf pg:ModernPractice .
pg:Page ipo:coversChapterSection pg:Style .
pg:BlackBoxFunction a ipo:ChapterSection ; rdfs:label "Function as a black box"@en ;
    skos:definition "A black box is a function used through its inputs and its output alone. The textbook says that often all you need to know about a function are its inputs, the parameters, and its output value, and that thinking of a function in this high-level way is called treating it as a black box (Sweigart, 2025)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_BlackBoxFunction> ;
    sen0414:anchor "#s-BlackBoxFunction" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Style .
pg:Page ipo:coversChapterSection pg:BlackBoxFunction .
pg:FunctionNaming a ipo:ChapterSection ; rdfs:label "Function naming"@en ;
    skos:definition "A function name is an identifier chosen by the programmer, and PEP 8 has a rule for it. Function names should be lowercase, with words separated by underscores as necessary to improve readability, and variable names follow the same convention; mixedCase is allowed only in contexts where that is already the prevailing style (Van Rossum et al., 2001)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_FunctionNaming> ;
    sen0414:anchor "#s-FunctionNaming" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Style .
pg:Page ipo:coversChapterSection pg:FunctionNaming .
pg:Comment a ipo:ChapterSection ; rdfs:label "Comment"@en ;
    skos:definition "A comment is a note for the human reader that Python does not execute. The tutorial says that comments in Python start with the hash character, #, and extend to the end of the physical line, that a comment may appear at the start of a line or following whitespace or code, and that since comments are to clarify code and are not interpreted by Python, they may be omitted when typing in examples (Python Software Foundation, 2026)."@en ; dcterms:source <http://example.org/sen0414/ch04#S_Comment> ;
    sen0414:anchor "#s-Comment" ; sen0414:sectionLevel 3 ; dcterms:isPartOf pg:Style .
pg:Page ipo:coversChapterSection pg:Comment .
