pg:Style sen0414:hasPanel pg:BlackBoxFunction, pg:FunctionNaming, pg:Comment .
pg:CE_01 a ipo:CodeExample ; rdfs:label "def defines, a call runs"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 6 of the deck and runs 4 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 6 ; sen0414:orderInTab 1 ;
    sen0414:code "def hello(name):\n    print('Hello, ' + name)\nhello('Alice')\nhello('Bob')" ; sen0414:expectedOutput "Hello, Alice\nHello, Bob\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "Deduplication: one function instead of copies"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 7 of the deck and runs 5 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 7 ; sen0414:orderInTab 2 ;
    sen0414:code "pasted = ['Good morning!', 'Good afternoon!', ' Good evening!']\ndef greeting(part):\n    return 'Good ' + part + '!'\nmade = [greeting(p) for p in ('morning', 'afternoon', 'evening')]\nprint(pasted == made, [a == b for a, b in zip(pasted, made)])" ; sen0414:expectedOutput "False [True, True, False]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "Arguments fill parameters in order"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 10 of the deck and runs 4 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 10 ; sen0414:orderInTab 3 ;
    sen0414:code "def describe(animal, sound):\n    return animal + ' says ' + sound\nprint(describe('cat', 'meow'))\nprint(describe('meow', 'cat'))" ; sen0414:expectedOutput "cat says meow\nmeow says cat\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "return hands a value back"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 11 of the deck and runs 5 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 11 ; sen0414:orderInTab 4 ;
    sen0414:code "def double(n):\n    return n * 2\nx = double(21)\nprint(x, type(x).__name__)\nprint(double(double(2)))" ; sen0414:expectedOutput "42 int\n8\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "None: a function without return"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 12 of the deck and runs 5 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 12 ; sen0414:orderInTab 5 ;
    sen0414:code "def shout(word):\n    print(word.upper())\nresult = shout('hi')\nprint(result, result is None)\nprint(len('hello'), len([1, 2, 3]))" ; sen0414:expectedOutput "HI\nNone True\n5 3\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Named parameters sep and end"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 14 of the deck and runs 4 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 6 ;
    sen0414:code "print('cats', 'dogs', 'mice')\nprint('cats', 'dogs', 'mice', sep=', ')\nprint('Hello', end='')\nprint(' World')" ; sen0414:expectedOutput "cats dogs mice\ncats, dogs, mice\nHello World\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "Default and keyword-only parameters"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 15 of the deck and runs 3 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 15 ; sen0414:orderInTab 7 ;
    sen0414:code "def area(width, height=1, *, unit='m'):\n    return str(width * height) + ' ' + unit\nprint(area(3), area(3, 4), area(3, unit='cm'))" ; sen0414:expectedOutput "3 m 12 m 3 cm\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "A default value is made once"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 16 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 8 ;
    sen0414:code "def add_item(item, bag=[]):\n    bag.append(item)\n    return bag\ndef add_safe(item, bag=None):\n    bag = [] if bag is None else bag\n    bag.append(item)\n    return bag\nprint(add_item('a'), add_item('b'))\nprint(add_safe('a'), add_safe('b'))" ; sen0414:expectedOutput "['a', 'b'] ['a', 'b']\n['a'] ['b']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "The call stack counted with real frames"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 19 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 9 ;
    sen0414:code "import inspect\nbase = len(inspect.stack())\ndepth = lambda: len(inspect.stack()) - base - 1\ndef c():\n    return depth()\ndef b():\n    return [depth(), c()]\ndef a():\n    return [depth(), b()]\nprint(a(), depth())" ; sen0414:expectedOutput "[1, [2, 3]] 0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "A frame object knows its function and its caller"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 20 of the deck and runs 7 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 20 ; sen0414:orderInTab 10 ;
    sen0414:code "import sys\ndef inner():\n    me, caller = sys._getframe(), sys._getframe(1)\n    return me.f_code.co_name, caller.f_code.co_name\ndef outer():\n    return inner()\nprint(outer(), inner()[0])" ; sen0414:expectedOutput "('inner', 'outer') inner\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "A local variable disappears after the call"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 22 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 11 ;
    sen0414:code "def make():\n    eggs = 99\n    return eggs\nprint(make())\ntry:\n    print(eggs)\nexcept NameError as err:\n    print(type(err).__name__)" ; sen0414:expectedOutput "99\nNameError\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "Local scopes are walled off"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 23 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 12 ;
    sen0414:code "x = 'global x'\ndef f():\n    y = 'local y of f'\n    return x\ndef g():\n    return y\nprint(f())\ntry:\n    g()\nexcept NameError as err:\n    print('g cannot see y:', type(err).__name__)" ; sen0414:expectedOutput "global x\ng cannot see y: NameError\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "One name, three variables"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 24 of the deck and runs 8 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 13 ;
    sen0414:code "spam = 'global'\ndef one():\n    spam = 'one'\n    return spam\ndef two():\n    spam = 'two'\n    return spam\nprint(one(), two(), spam)" ; sen0414:expectedOutput "one two global\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "The global statement"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 25 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 14 ;
    sen0414:code "eggs = 'global'\ndef with_global():\n    global eggs\n    eggs = 'changed by with_global'\ndef without_global():\n    eggs = 'local to without_global'\nwithout_global()\nprint(eggs)\nwith_global()\nprint(eggs)" ; sen0414:expectedOutput "global\nchanged by with_global\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "nonlocal: between local and global"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 26 of the deck and runs 9 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 26 ; sen0414:orderInTab 15 ;
    sen0414:code "def counter():\n    count = 0\n    def step():\n        nonlocal count\n        count += 1\n        return count\n    return step\ntick = counter()\nprint(tick(), tick(), tick())" ; sen0414:expectedOutput "1 2 3\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "Scope identification: read or assign"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 27 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 27 ; sen0414:orderInTab 16 ;
    sen0414:code "eggs = 0\ndef reads():\n    return eggs\ndef assigns():\n    eggs = 1\ndef declares():\n    global eggs\n    eggs = 2\nfor f in (reads, assigns, declares):\n    c = f.__code__\n    print(f.__name__, c.co_varnames, c.co_names)" ; sen0414:expectedOutput "reads () ('eggs',)\nassigns ('eggs',) ()\ndeclares () ('eggs',)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "UnboundLocalError"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 28 of the deck and runs 10 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 28 ; sen0414:orderInTab 17 ;
    sen0414:code "eggs = 'global'\ndef broken():\n    print(eggs)\n    eggs = 'local'\nprint('global eggs is still', eggs)\ntry:\n    broken()\nexcept NameError as err:\n    kind = type(err)\n    print(kind.__name__, kind.__mro__[1].__name__)" ; sen0414:expectedOutput "global eggs is still global\nUnboundLocalError NameError\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "try and except"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 31 of the deck and runs 6 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 31 ; sen0414:orderInTab 18 ;
    sen0414:code "def spam(divide_by):\n    try:\n        return 42 / divide_by\n    except ZeroDivisionError:\n        return 'error: cannot divide by zero'\nprint(spam(2), spam(12), spam(0), spam(1))" ; sen0414:expectedOutput "21.0 3.5 error: cannot divide by zero 42.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "try inside the loop"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 32 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 32 ; sen0414:orderInTab 19 ;
    sen0414:code "def spam(n):\n    return 42 / n\nfor n in (2, 0, 1):\n    try:\n        print(spam(n))\n    except ZeroDivisionError:\n        print('Error: invalid argument.')" ; sen0414:expectedOutput "21.0\nError: invalid argument.\n42.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "try around all the calls"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 33 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 33 ; sen0414:orderInTab 20 ;
    sen0414:code "def spam(n):\n    return 42 / n\ntry:\n    print(spam(2))\n    print(spam(0))\n    print(spam(1))\nexcept ZeroDivisionError:\n    print('Error: invalid argument.')" ; sen0414:expectedOutput "21.0\nError: invalid argument.\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "One except for several errors"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 34 of the deck and runs 6 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 34 ; sen0414:orderInTab 21 ;
    sen0414:code "def parse(text):\n    try:\n        return int(text)\n    except (ValueError, TypeError) as err:\n        return type(err).__name__\nprint(parse('12'), parse('x'), parse(None))" ; sen0414:expectedOutput "12 ValueError TypeError\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
pg:CE_22 a ipo:CodeExample ; rdfs:label "A traceback lists the calls to the error"@en ;
    skos:definition "Example 22 of the chapter-code tab comes from slide 35 of the deck and runs 10 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 35 ; sen0414:orderInTab 22 ;
    sen0414:code "import traceback\ndef inner():\n    return 1 / 0\ndef outer():\n    return inner()\ntry:\n    outer()\nexcept ZeroDivisionError as err:\n    tb = traceback.extract_tb(err.__traceback__)\n    print([f.name for f in tb][-2:])" ; sen0414:expectedOutput "['outer', 'inner']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_22 .
pg:CE_23 a ipo:CodeExample ; rdfs:label "Short program: Zigzag"@en ;
    skos:definition "Example 23 of the chapter-code tab comes from slide 39 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 39 ; sen0414:orderInTab 23 ;
    sen0414:code "def zigzag(steps, width=20):\n    indent, move, path = 0, 1, []\n    for _ in range(steps):\n        path.append(indent)\n        indent += move\n        if indent in (0, width):\n            move = -move\n    return path\npath = zigzag(42)\nprint(path[:8], max(path), path[-2:])\nprint(' ' * path[5] + '*' * 8)" ; sen0414:expectedOutput "[0, 1, 2, 3, 4, 5, 6, 7] 20 [0, 1]\n     ********\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_23 .
pg:CE_24 a ipo:CodeExample ; rdfs:label "Short program: Spike"@en ;
    skos:definition "Example 24 of the chapter-code tab comes from slide 40 of the deck and runs 4 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 40 ; sen0414:orderInTab 24 ;
    sen0414:code "lengths = [i * i for i in range(1, 9)]\nlengths += [i * i for i in range(7, 1, -1)]\nprint(lengths, len(lengths))\nprint('-' * lengths[3])" ; sen0414:expectedOutput "[1, 4, 9, 16, 25, 36, 49, 64, 49, 36, 25, 16, 9, 4] 14\n----------------\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_24 .
pg:CE_25 a ipo:CodeExample ; rdfs:label "Practice program: Collatz"@en ;
    skos:definition "Example 25 of the chapter-code tab comes from slide 41 of the deck and runs 9 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch04/page/chapter_code_ch04_v1_1_0.json" ;
    sen0414:slideNumber 41 ; sen0414:orderInTab 25 ;
    sen0414:code "def collatz(n):\n    if n % 2 == 0:\n        return n // 2\n    return 3 * n + 1\nn, seq = 6, [6]\nwhile n != 1:\n    n = collatz(n)\n    seq.append(n)\nprint(seq, len(seq) - 1)" ; sen0414:expectedOutput "[6, 3, 10, 5, 16, 8, 4, 2, 1] 8\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_25 .
