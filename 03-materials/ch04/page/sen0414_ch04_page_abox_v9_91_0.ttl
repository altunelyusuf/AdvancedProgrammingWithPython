pg:ReturnValue sen0414:hasPanel pg:ReturnStatement, pg:ImplicitNone, pg:CallAsExpression .
pg:NoneType sen0414:hasPanel pg:NoneValue, pg:IdentityTest .
pg:CallStack sen0414:hasPanel pg:CallStackOrder, pg:FrameObject, pg:StackInspection, pg:Recursion .
pg:Namespaces sen0414:hasPanel pg:LocalScope, pg:GlobalScope, pg:SameNameVariables, pg:EnclosingScope, pg:BuiltinScope .
pg:Rules sen0414:hasPanel pg:LocalIsolation, pg:GlobalAccess, pg:NameResolution, pg:NameError, pg:GlobalStatement, pg:ScopeIdentification, pg:SymbolTable, pg:UnboundLocalError, pg:NonlocalStatement .
