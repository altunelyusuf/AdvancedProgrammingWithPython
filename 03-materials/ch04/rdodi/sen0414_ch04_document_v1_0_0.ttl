chx:Document a doc:ReportSection ; rdfs:label "Functions for an advanced course: chapter 4 of the 3rd edition and today's Python"@en ; skos:definition "This document renews chapter 4 of the 3rd edition for an advanced course (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04/research> ;
    doc:hasSection chx:S_Function, chx:S_Result, chx:S_Frames, chx:S_Scope, chx:S_ErrorHandling, chx:S_ModernPractice .
chx:S_Function a doc:TaxonomicSection ; rdfs:label "Function"@en ; doc:sectionTitle "Function" ; doc:hierarchyLevel 1 ; doc:sectionOrder 1 ;
    skos:definition "Chapter 4 is about giving a block of code a name so it can be run from many places, passing values in, getting a value out, and keeping its variables to itself (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Function> .
chx:S_Definition a doc:TaxonomicSection ; rdfs:label "Definition"@en ; doc:sectionTitle "Definition" ; doc:hierarchyLevel 2 ; doc:sectionOrder 2 ;
    doc:hasParentSection chx:S_Function ;
    skos:definition "Creating Functions introduces the def statement and the call that runs it, and the reason for both: not repeating code (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Definition> .
chx:S_DefStatement a doc:ConceptSection ; rdfs:label "Def statement"@en ; doc:sectionTitle "Def statement" ; doc:hierarchyLevel 3 ; doc:sectionOrder 3 ;
    doc:hasParentSection chx:S_Definition ;
    skos:definition "A def statement defines a function named hello() and the indented block after it is the body; that code executes when the function is called, not when it is first defined (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#DefStatement> .
chx:S_FunctionCall a doc:ConceptSection ; rdfs:label "Function call"@en ; doc:sectionTitle "Function call" ; doc:hierarchyLevel 3 ; doc:sectionOrder 4 ;
    doc:hasParentSection chx:S_Definition ;
    skos:definition "A function call is the function's name followed by parentheses, possibly with arguments between them; execution jumps to the first line of the body and returns to the line after the call when the body ends (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#FunctionCall> .
chx:S_Deduplication a doc:ConceptSection ; rdfs:label "Deduplication"@en ; doc:sectionTitle "Deduplication" ; doc:hierarchyLevel 3 ; doc:sectionOrder 5 ;
    doc:hasParentSection chx:S_Definition ;
    skos:definition "A major purpose of functions is to group code that gets executed multiple times, because with pasted copies a fix has to be made in every place; the chapter's own pasted listing ends with print(' Good evening!') with a stray leading space, so its output differs from the function version's last line (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Deduplication> .
chx:S_Parameters a doc:TaxonomicSection ; rdfs:label "Parameters"@en ; doc:sectionTitle "Parameters" ; doc:hierarchyLevel 2 ; doc:sectionOrder 6 ;
    doc:hasParentSection chx:S_Function ;
    skos:definition "Arguments and Parameters and Named Parameters describe how values get into a function (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Parameters> .
chx:S_ParameterAndArgument a doc:ConceptSection ; rdfs:label "Parameter and argument"@en ; doc:sectionTitle "Parameter and argument" ; doc:hierarchyLevel 3 ; doc:sectionOrder 7 ;
    doc:hasParentSection chx:S_Parameters ;
    skos:definition "Values passed in a call are arguments and the variables that receive them are parameters, as in def say_hello_to(name) called with say_hello_to('Alice'); the value in a parameter is forgotten when the function returns, so print(name) after the call raises an error (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#ParameterAndArgument> .
chx:S_NamedParameter a doc:ConceptSection ; rdfs:label "Named parameter"@en ; doc:sectionTitle "Named parameter" ; doc:hierarchyLevel 3 ; doc:sectionOrder 8 ;
    doc:hasParentSection chx:S_Parameters ;
    skos:definition "Python identifies most arguments by position but named parameters by the name placed before them, so print('Hello', end='') prints no newline and print('cats', 'dogs', 'mice', sep=',') prints cats,dogs,mice; print's documentation makes sep, end, file and flush keyword-only (Sweigart, 2025) (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch04#NamedParameter> .
chx:S_PositionalOnlyParameter a doc:ConceptSection ; rdfs:label "Positional only parameter"@en ; doc:sectionTitle "Positional only parameter" ; doc:hierarchyLevel 3 ; doc:sectionOrder 9 ;
    doc:hasParentSection chx:S_Parameters ;
    skos:definition "Parameters listed before a slash in a definition can only be passed by position, so calling such a function with the name raises a TypeError that says some positional-only arguments were passed as keyword arguments (Hastings et al., 2018)." ; dcterms:source <http://example.org/sen0414/ch04#PositionalOnlyParameter> .
chx:S_KeywordOnlyParameter a doc:ConceptSection ; rdfs:label "Keyword only parameter"@en ; doc:sectionTitle "Keyword only parameter" ; doc:hierarchyLevel 3 ; doc:sectionOrder 10 ;
    doc:hasParentSection chx:S_Parameters ;
    skos:definition "Parameters listed after a star in a definition can only be passed by keyword, so passing one by position raises a TypeError, which turns a call that could be misread into a call that cannot (Talin, 2006)." ; dcterms:source <http://example.org/sen0414/ch04#KeywordOnlyParameter> .
chx:S_DefaultArgument a doc:ConceptSection ; rdfs:label "Default argument"@en ; doc:sectionTitle "Default argument" ; doc:hierarchyLevel 3 ; doc:sectionOrder 11 ;
    doc:hasParentSection chx:S_Parameters ;
    skos:definition "A default value is evaluated only once, when the function is defined, so a default such as an empty list accumulates the arguments of successive calls, and the tutorial's remedy is a default of None that the function replaces with a new list (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch04#DefaultArgument> .
chx:S_Result a doc:TaxonomicSection ; rdfs:label "Result"@en ; doc:sectionTitle "Result" ; doc:hierarchyLevel 1 ; doc:sectionOrder 12 ;
    skos:definition "Return Values and return Statements and The None Value describe what a call evaluates to (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Result> .
chx:S_ReturnValue a doc:TaxonomicSection ; rdfs:label "Return value"@en ; doc:sectionTitle "Return value" ; doc:hierarchyLevel 2 ; doc:sectionOrder 13 ;
    doc:hasParentSection chx:S_Result ;
    skos:definition "The value a function call evaluates to is its return value, and because a call is an expression it can be an argument to another call, as in print(get_answer(random.randint(1, 9))) (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#ReturnValue> .
chx:S_ReturnStatement a doc:ConceptSection ; rdfs:label "Return statement"@en ; doc:sectionTitle "Return statement" ; doc:hierarchyLevel 3 ; doc:sectionOrder 14 ;
    doc:hasParentSection chx:S_ReturnValue ;
    skos:definition "A return statement consists of the return keyword and the value or expression to return; if an expression list is present it is evaluated, else None is substituted, and control leaves the function (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch04#ReturnStatement> .
chx:S_ImplicitNone a doc:ConceptSection ; rdfs:label "Implicit none"@en ; doc:sectionTitle "Implicit none" ; doc:hierarchyLevel 3 ; doc:sectionOrder 15 ;
    doc:hasParentSection chx:S_ReturnValue ;
    skos:definition "Behind the scenes Python adds return None to the end of any function with no return statement, and a bare return also returns None (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#ImplicitNone> .
chx:S_NoneType a doc:TaxonomicSection ; rdfs:label "None type"@en ; doc:sectionTitle "None type" ; doc:hierarchyLevel 2 ; doc:sectionOrder 16 ;
    doc:hasParentSection chx:S_Result ;
    skos:definition "The None value stands for the absence of a value and is the only value of the NoneType data type (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#NoneType> .
chx:S_NoneValue a doc:ConceptSection ; rdfs:label "None value"@en ; doc:sectionTitle "None value" ; doc:hierarchyLevel 3 ; doc:sectionOrder 17 ;
    doc:hasParentSection chx:S_NoneType ;
    skos:definition "None is the return value of print, so spam = print('Hello!') stores it, and PEP 8 says comparisons to singletons like None should always be done with is or is not, not with equality operators, where the chapter writes None == spam (Sweigart, 2025) (Van Rossum et al., 2001)." ; dcterms:source <http://example.org/sen0414/ch04#NoneValue> .
chx:S_Frames a doc:TaxonomicSection ; rdfs:label "Frames"@en ; doc:sectionTitle "Frames" ; doc:hierarchyLevel 1 ; doc:sectionOrder 18 ;
    skos:definition "The Call Stack explains where execution goes when a function returns (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Frames> .
chx:S_CallStack a doc:TaxonomicSection ; rdfs:label "Call stack"@en ; doc:sectionTitle "Call stack" ; doc:hierarchyLevel 2 ; doc:sectionOrder 19 ;
    doc:hasParentSection chx:S_Frames ;
    skos:definition "Calling a function does not send execution one way to the top of the body: Python remembers the line that made the call, so abcdCallStack.py prints a() starts, b() starts, c() starts, c() returns, b() returns, d() starts, d() returns, a() returns (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#CallStack> .
chx:S_CallStackOrder a doc:ConceptSection ; rdfs:label "Call stack order"@en ; doc:sectionTitle "Call stack order" ; doc:hierarchyLevel 3 ; doc:sectionOrder 20 ;
    doc:hasParentSection chx:S_CallStack ;
    skos:definition "Frame objects are added to and removed from the top of the call stack only, the top frame is the function currently executing, and an empty stack means execution is outside all functions (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#CallStackOrder> .
chx:S_StackInspection a doc:ConceptSection ; rdfs:label "Stack inspection"@en ; doc:sectionTitle "Stack inspection" ; doc:hierarchyLevel 3 ; doc:sectionOrder 21 ;
    doc:hasParentSection chx:S_CallStack ;
    skos:definition "The interpreter limits the depth of its stack, sys.getrecursionlimit() returns 1000 under Python 3.14.4, and a function that calls itself without end raises RecursionError, a subclass of RuntimeError, instead of overflowing the C stack (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch04#StackInspection> .
chx:S_Scope a doc:TaxonomicSection ; rdfs:label "Scope"@en ; doc:sectionTitle "Scope" ; doc:hierarchyLevel 1 ; doc:sectionOrder 22 ;
    skos:definition "Local and Global Scopes, Scope Rules, The global Statement and Scope Identification say which variable a name refers to (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Scope> .
chx:S_Namespaces a doc:TaxonomicSection ; rdfs:label "Namespaces"@en ; doc:sectionTitle "Namespaces" ; doc:hierarchyLevel 2 ; doc:sectionOrder 23 ;
    doc:hasParentSection chx:S_Scope ;
    skos:definition "Variables live in scopes, containers created when a program starts or a function is called (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Namespaces> .
chx:S_LocalScope a doc:ConceptSection ; rdfs:label "Local scope"@en ; doc:sectionTitle "Local scope" ; doc:hierarchyLevel 3 ; doc:sectionOrder 24 ;
    doc:hasParentSection chx:S_Namespaces ;
    skos:definition "Variables assigned inside a function exist in that call's local scope, which is created when the function is called and destroyed when it returns, so code outside cannot use them and print(eggs) after spam() raises NameError: name 'eggs' is not defined (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#LocalScope> .
chx:S_GlobalScope a doc:ConceptSection ; rdfs:label "Global scope"@en ; doc:sectionTitle "Global scope" ; doc:hierarchyLevel 3 ; doc:sectionOrder 25 ;
    doc:hasParentSection chx:S_Namespaces ;
    skos:definition "There is only one global scope, created when the program begins and destroyed when it terminates, and code in a local scope can read global variables when it has no local variable of that name (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#GlobalScope> .
chx:S_SameNameVariables a doc:ConceptSection ; rdfs:label "Same name variables"@en ; doc:sectionTitle "Same name variables" ; doc:hierarchyLevel 3 ; doc:sectionOrder 26 ;
    doc:hasParentSection chx:S_Namespaces ;
    skos:definition "A local variable and a global one may share a name, so three variables named eggs give the output bacon local, spam local, bacon local, global, and the chapter advises giving variables unique names (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#SameNameVariables> .
chx:S_Rules a doc:TaxonomicSection ; rdfs:label "Rules"@en ; doc:sectionTitle "Rules" ; doc:hierarchyLevel 2 ; doc:sectionOrder 27 ;
    doc:hasParentSection chx:S_Scope ;
    skos:definition "Four rules tell whether a name is local or global, and one further statement reaches the case between them (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Rules> .
chx:S_GlobalStatement a doc:ConceptSection ; rdfs:label "Global statement"@en ; doc:sectionTitle "Global statement" ; doc:hierarchyLevel 3 ; doc:sectionOrder 28 ;
    doc:hasParentSection chx:S_Rules ;
    skos:definition "Putting global eggs at the top of a function makes eggs in that function refer to the global variable, so assigning to it changes the global and no local variable is created (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#GlobalStatement> .
chx:S_ScopeIdentification a doc:ConceptSection ; rdfs:label "Scope identification"@en ; doc:sectionTitle "Scope identification" ; doc:hierarchyLevel 3 ; doc:sectionOrder 29 ;
    doc:hasParentSection chx:S_Rules ;
    skos:definition "A variable outside all functions is global, one in a function with a global statement is global, one the function assigns is local, and one the function only uses is global; the compiler decides this by scanning the whole function body for name-binding operations, which the symtable module reports as global, local and global for the chapter's spam, bacon and ham (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch04#ScopeIdentification> .
chx:S_UnboundLocalError a doc:ConceptSection ; rdfs:label "Unbound local error"@en ; doc:sectionTitle "Unbound local error" ; doc:hierarchyLevel 3 ; doc:sectionOrder 30 ;
    doc:hasParentSection chx:S_Rules ;
    skos:definition "Using a local variable before assigning it raises UnboundLocalError, a subclass of NameError; the chapter prints local variable 'eggs' referenced before assignment, while Python 3.14.4 and the Programming FAQ give cannot access local variable 'eggs' where it is not associated with a value (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch04#UnboundLocalError> .
chx:S_NonlocalStatement a doc:ConceptSection ; rdfs:label "Nonlocal statement"@en ; doc:sectionTitle "Nonlocal statement" ; doc:hierarchyLevel 3 ; doc:sectionOrder 31 ;
    doc:hasParentSection chx:S_Rules ;
    skos:definition "The nonlocal statement causes the listed names to refer to names previously bound in the nearest enclosing function scope, which lets an inner function rebind them; the chapter does not cover it (Yee, 2006)." ; dcterms:source <http://example.org/sen0414/ch04#NonlocalStatement> .
chx:S_ErrorHandling a doc:TaxonomicSection ; rdfs:label "Error handling"@en ; doc:sectionTitle "Error handling" ; doc:hierarchyLevel 1 ; doc:sectionOrder 32 ;
    skos:definition "Exception Handling turns an error from a crash into something a program can recover from (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#ErrorHandling> .
chx:S_Exceptions a doc:TaxonomicSection ; rdfs:label "Exceptions"@en ; doc:sectionTitle "Exceptions" ; doc:hierarchyLevel 2 ; doc:sectionOrder 33 ;
    doc:hasParentSection chx:S_ErrorHandling ;
    skos:definition "An error in a Python program raises an exception, and try and except statements decide what happens next (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Exceptions> .
chx:S_TryExcept a doc:ConceptSection ; rdfs:label "Try except"@en ; doc:sectionTitle "Try except" ; doc:hierarchyLevel 3 ; doc:sectionOrder 34 ;
    doc:hasParentSection chx:S_Exceptions ;
    skos:definition "The try clause runs first; if no exception occurs the except clause is skipped, and if one occurs the rest of the try clause is skipped and, when its type matches, the except clause runs and execution continues after the try statement (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch04#TryExcept> .
chx:S_ErrorInCall a doc:ConceptSection ; rdfs:label "Error in call"@en ; doc:sectionTitle "Error in call" ; doc:hierarchyLevel 3 ; doc:sectionOrder 35 ;
    doc:hasParentSection chx:S_Exceptions ;
    skos:definition "An error inside a function called from a try clause is caught by that clause, and once execution has jumped to the except clause it does not return to the try clause, so the chapter's second version never prints spam(1) (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#ErrorInCall> .
chx:S_MultipleExceptTypes a doc:ConceptSection ; rdfs:label "Multiple except types"@en ; doc:sectionTitle "Multiple except types" ; doc:hierarchyLevel 3 ; doc:sectionOrder 36 ;
    doc:hasParentSection chx:S_Exceptions ;
    skos:definition "Python 3.14 allows except to list several exception types without brackets when there is no as clause, as in except TimeoutError, ConnectionRefusedError:, and rejects the form with as unless the types are in brackets (Galindo Salgado and Cannon, 2024)." ; dcterms:source <http://example.org/sen0414/ch04#MultipleExceptTypes> .
chx:S_ModernPractice a doc:TaxonomicSection ; rdfs:label "Modern practice"@en ; doc:sectionTitle "Modern practice" ; doc:hierarchyLevel 1 ; doc:sectionOrder 37 ;
    skos:definition "An advanced course pairs the chapter's functions with what current Python adds around them (Python Software Foundation, 2026)." ; dcterms:source <http://example.org/sen0414/ch04#ModernPractice> .
chx:S_Annotations a doc:TaxonomicSection ; rdfs:label "Annotations"@en ; doc:sectionTitle "Annotations" ; doc:hierarchyLevel 2 ; doc:sectionOrder 38 ;
    doc:hasParentSection chx:S_ModernPractice ;
    skos:definition "Annotations on a function's parameters and result are the newest of those additions (Hastings, 2021)." ; dcterms:source <http://example.org/sen0414/ch04#Annotations> .
chx:S_DeferredAnnotations a doc:ConceptSection ; rdfs:label "Deferred annotations"@en ; doc:sectionTitle "Deferred annotations" ; doc:hierarchyLevel 3 ; doc:sectionOrder 39 ;
    doc:hasParentSection chx:S_Annotations ;
    skos:definition "Since Python 3.14 annotations are stored and evaluated only when necessary, so def f(x: Undefined) can be defined and called, reading f.__annotations__ raises NameError until the names exist, and a forward-reference format returns the unresolved names (Hastings, 2021)." ; dcterms:source <http://example.org/sen0414/ch04#DeferredAnnotations> .
chx:S_Style a doc:TaxonomicSection ; rdfs:label "Style"@en ; doc:sectionTitle "Style" ; doc:hierarchyLevel 2 ; doc:sectionOrder 40 ;
    doc:hasParentSection chx:S_ModernPractice ;
    skos:definition "How a function is meant to be used matters as much as how it is written (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#Style> .
chx:S_BlackBoxFunction a doc:ConceptSection ; rdfs:label "Black box function"@en ; doc:sectionTitle "Black box function" ; doc:hierarchyLevel 3 ; doc:sectionOrder 41 ;
    doc:hasParentSection chx:S_Style ;
    skos:definition "Often all you need to know about a function is its inputs and its return value, so it can be treated as a black box, and because its variables are local its code cannot affect other functions' variables (Sweigart, 2025)." ; dcterms:source <http://example.org/sen0414/ch04#BlackBoxFunction> .
