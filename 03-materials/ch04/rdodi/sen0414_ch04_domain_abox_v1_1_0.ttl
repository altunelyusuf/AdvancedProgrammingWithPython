@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

<http://example.org/sen0414/ch04/abox> a owl:Ontology ;
    rdfs:label "SEN0414 chapter 4 domain ontology - ABox"@en ; owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0414/ch04/abox/1.1.0> ; rdfs:comment "1.1.0 adds the concepts that the chapter's text uses but never explains (keywords, lambda expressions, nested functions, module functions, positional arguments, frames and stack inspection, recursion, namespaces, name resolution, symbol tables, the nonlocal statement, the exception object, the traceback, the exception hierarchy, the short programs and their tools, annotations, naming and comments) and rewrites the text of every concept in full paragraphs; the existing concept identifiers are kept, so MINOR."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:created "2026-09-29"^^xsd:date ; dcterms:modified "2026-10-01"^^xsd:date ;
    dcterms:identifier "sen0414_ch04_domain_abox_v1_1_0" ; prov:wasRevisionOf <http://example.org/sen0414/ch04/abox/1.0.0> ;
    prov:wasGeneratedBy <http://example.org/sen0414/activity/ch04-rdodi-run> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

ch04:X_DefStatement a owl:NamedIndividual, ch04:DefStatement ; rdfs:label "def hello():"@en ; skos:definition "A def statement creates a function and binds its name; the body runs when the function is called, not when it is defined."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_FunctionBody a owl:NamedIndividual, ch04:FunctionBody ; rdfs:label "the indented block under def"@en ; skos:definition "The block of indented statements after the colon of the def line; it runs on each call, from its first line to the end or to a return statement."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_FunctionObject a owl:NamedIndividual, ch04:FunctionObject ; rdfs:label "type(hello)"@en ; skos:definition "What a def statement actually creates: a value of type function, which the function's name refers to and which can be given other names."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_FunctionObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "callable(len) evaluates to True"@en ; ch04:input "callable(len)" ; ch04:output "True" .
ch04:X_FunctionObject rd:hasIOExample ch04:IO_FunctionObject .
ch04:X_ReservedKeyword a owl:NamedIndividual, ch04:ReservedKeyword ; rdfs:label "def, return, global, nonlocal, try, except"@en ; skos:definition "A word that has a fixed meaning in the Python language and cannot be used as a name; def, return, global, nonlocal, try and except are keywords."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_ReservedKeyword a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('keyword').iskeyword('def') evaluates to True"@en ; ch04:input "__import__('keyword').iskeyword('def')" ; ch04:output "True" .
ch04:X_ReservedKeyword rd:hasIOExample ch04:IO_ReservedKeyword .
ch04:X_LambdaExpression a owl:NamedIndividual, ch04:LambdaExpression ; rdfs:label "lambda a, b: a + b"@en ; skos:definition "A way to write a small function as a single expression; it has no name of its own and its body is one expression."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_LambdaExpression a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, b: a + b)(2, 3) evaluates to 5"@en ; ch04:input "(lambda a, b: a + b)(2, 3)" ; ch04:output "5" .
ch04:X_LambdaExpression rd:hasIOExample ch04:IO_LambdaExpression .
ch04:X_NestedFunction a owl:NamedIndividual, ch04:NestedFunction ; rdfs:label "a def inside a def"@en ; skos:definition "A function defined inside the body of another function; it exists only while the outer function runs and can read the outer function's variables."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_FunctionCall a owl:NamedIndividual, ch04:FunctionCall ; rdfs:label "hello()"@en ; skos:definition "A call is the function's name followed by parentheses, with any arguments inside, and execution jumps into the body and comes back."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_FunctionCall a owl:NamedIndividual, rd:IOExample ; rdfs:label "max(3, 7) evaluates to 7"@en ; ch04:input "max(3, 7)" ; ch04:output "7" .
ch04:X_FunctionCall rd:hasIOExample ch04:IO_FunctionCall .
ch04:X_ModuleFunction a owl:NamedIndividual, ch04:ModuleFunction ; rdfs:label "random.randint(1, 9)"@en ; skos:definition "A function that lives in a module is called with the module's name and a dot in front, after the module has been imported."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_ModuleFunction a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('math').floor(7.5) evaluates to 7"@en ; ch04:input "__import__('math').floor(7.5)" ; ch04:output "7" .
ch04:X_ModuleFunction rd:hasIOExample ch04:IO_ModuleFunction .
ch04:X_Deduplication a owl:NamedIndividual, ch04:Deduplication ; rdfs:label "one def, three calls"@en ; skos:definition "A function groups code that runs more than once, so a fix is made in one place instead of in every pasted copy."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_ParameterAndArgument a owl:NamedIndividual, ch04:ParameterAndArgument ; rdfs:label "say_hello_to('Alice')"@en ; skos:definition "An argument is the value passed in a call, a parameter is the variable that receives it, and the parameter is forgotten when the function returns."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_ParameterAndArgument a owl:NamedIndividual, rd:IOExample ; rdfs:label "round(3.14159, 2) evaluates to 3.14"@en ; ch04:input "round(3.14159, 2)" ; ch04:output "3.14" .
ch04:X_ParameterAndArgument rd:hasIOExample ch04:IO_ParameterAndArgument .
ch04:X_PositionalArgument a owl:NamedIndividual, ch04:PositionalArgument ; rdfs:label "divmod(17, 5)"@en ; skos:definition "An argument matched to a parameter by its position in the call, so swapping two arguments changes the result."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_PositionalArgument a owl:NamedIndividual, rd:IOExample ; rdfs:label "divmod(17, 5) evaluates to (3, 2)"@en ; ch04:input "divmod(17, 5)" ; ch04:output "(3, 2)" .
ch04:X_PositionalArgument rd:hasIOExample ch04:IO_PositionalArgument .
ch04:X_NamedParameter a owl:NamedIndividual, ch04:NamedParameter ; rdfs:label "print('a', 'b', sep=',')"@en ; skos:definition "A named parameter is identified by its name in the call rather than its position; print's sep and end are two."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_NamedParameter a owl:NamedIndividual, rd:IOExample ; rdfs:label "int('ff', base=16) evaluates to 255"@en ; ch04:input "int('ff', base=16)" ; ch04:output "255" .
ch04:X_NamedParameter rd:hasIOExample ch04:IO_NamedParameter .
ch04:X_PositionalOnlyParameter a owl:NamedIndividual, ch04:PositionalOnlyParameter ; rdfs:label "def f(a, /, b):"@en ; skos:definition "Parameters before a slash can only be passed by position; passing one by name raises a TypeError."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_PositionalOnlyParameter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, /, b: a * b)(3, b=4) evaluates to 12"@en ; ch04:input "(lambda a, /, b: a * b)(3, b=4)" ; ch04:output "12" .
ch04:X_PositionalOnlyParameter rd:hasIOExample ch04:IO_PositionalOnlyParameter .
ch04:X_KeywordOnlyParameter a owl:NamedIndividual, ch04:KeywordOnlyParameter ; rdfs:label "def f(a, *, b=2):"@en ; skos:definition "Parameters after a star can only be passed by name, so a call cannot get them wrong by position."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_KeywordOnlyParameter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, *, b=2: a + b)(1, b=5) evaluates to 6"@en ; ch04:input "(lambda a, *, b=2: a + b)(1, b=5)" ; ch04:output "6" .
ch04:X_KeywordOnlyParameter rd:hasIOExample ch04:IO_KeywordOnlyParameter .
ch04:X_DefaultArgument a owl:NamedIndividual, ch04:DefaultArgument ; rdfs:label "def f(a, L=None):"@en ; skos:definition "A default value is evaluated once, when the function is defined, so a mutable default is shared between calls; the tutorial's remedy is a default of None."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_DefaultArgument a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda x, y=10: x + y)(1) evaluates to 11"@en ; ch04:input "(lambda x, y=10: x + y)(1)" ; ch04:output "11" .
ch04:X_DefaultArgument rd:hasIOExample ch04:IO_DefaultArgument .
ch04:X_ReturnStatement a owl:NamedIndividual, ch04:ReturnStatement ; rdfs:label "return 42 / divide_by"@en ; skos:definition "A return statement leaves the function with the value of its expression, so a call can be used wherever a value can."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_ReturnStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: 42 / d)(2) evaluates to 21.0"@en ; ch04:input "(lambda d: 42 / d)(2)" ; ch04:output "21.0" .
ch04:X_ReturnStatement rd:hasIOExample ch04:IO_ReturnStatement .
ch04:X_ImplicitNone a owl:NamedIndividual, ch04:ImplicitNone ; rdfs:label "def f(): pass"@en ; skos:definition "A function without a return statement, or with a bare return, returns None."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_ImplicitNone a owl:NamedIndividual, rd:IOExample ; rdfs:label "[2, 1].sort() is None evaluates to True"@en ; ch04:input "[2, 1].sort() is None" ; ch04:output "True" .
ch04:X_ImplicitNone rd:hasIOExample ch04:IO_ImplicitNone .
ch04:X_CallAsExpression a owl:NamedIndividual, ch04:CallAsExpression ; rdfs:label "print(get_answer(random.randint(1, 9)))"@en ; skos:definition "Because a call evaluates to its return value, a call can be used as an argument of another call or as an operand in a larger expression."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_CallAsExpression a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(str(42 / 2)) evaluates to 4"@en ; ch04:input "len(str(42 / 2))" ; ch04:output "4" .
ch04:X_CallAsExpression rd:hasIOExample ch04:IO_CallAsExpression .
ch04:X_NoneValue a owl:NamedIndividual, ch04:NoneValue ; rdfs:label "spam = print('Hello!')"@en ; skos:definition "None is the only value of NoneType and stands for the absence of a value; print returns it, and PEP 8 says to compare with is."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_NoneValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "type(None).__name__ evaluates to 'NoneType'"@en ; ch04:input "type(None).__name__" ; ch04:output "'NoneType'" .
ch04:X_NoneValue rd:hasIOExample ch04:IO_NoneValue .
ch04:X_IdentityTest a owl:NamedIndividual, ch04:IdentityTest ; rdfs:label "x is None"@en ; skos:definition "The operators is and is not test whether two names refer to the very same object; PEP 8 says to compare with None this way."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_IdentityTest a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda x: x is None)(0) evaluates to False"@en ; ch04:input "(lambda x: x is None)(0)" ; ch04:output "False" .
ch04:X_IdentityTest rd:hasIOExample ch04:IO_IdentityTest .
ch04:X_CallStackOrder a owl:NamedIndividual, ch04:CallStackOrder ; rdfs:label "a() calls b() calls c()"@en ; skos:definition "Python remembers which line called a function so that execution returns there, keeping the waiting calls on a stack of frames."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_FrameObject a owl:NamedIndividual, ch04:FrameObject ; rdfs:label "inspect.currentframe()"@en ; skos:definition "The record Python creates for one call; it stores where the call came from, so execution can return there."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_StackInspection a owl:NamedIndividual, ch04:StackInspection ; rdfs:label "traceback.extract_stack()"@en ; skos:definition "A program can list the frames it is running inside, and the interpreter stops a runaway chain of calls with a RecursionError."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_StackInspection a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sys').getrecursionlimit() evaluates to 1000"@en ; ch04:input "__import__('sys').getrecursionlimit()" ; ch04:output "1000" .
ch04:X_StackInspection rd:hasIOExample ch04:IO_StackInspection .
ch04:X_Recursion a owl:NamedIndividual, ch04:Recursion ; rdfs:label "def factorial(n): ... n * factorial(n - 1)"@en ; skos:definition "A function that calls itself; each call has its own frame, and a base case must end the chain or RecursionError follows."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_LocalScope a owl:NamedIndividual, ch04:LocalScope ; rdfs:label "eggs = 'sss' inside spam()"@en ; skos:definition "A variable assigned inside a function exists only in that call's local scope and is destroyed when the call returns."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_GlobalScope a owl:NamedIndividual, ch04:GlobalScope ; rdfs:label "eggs = 'global' outside all functions"@en ; skos:definition "There is one global scope, created when the program begins and destroyed when it ends, and code in any function can read its variables."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_SameNameVariables a owl:NamedIndividual, ch04:SameNameVariables ; rdfs:label "three variables named eggs"@en ; skos:definition "The same name in different scopes gives different variables; the book advises unique names to keep track of them."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_EnclosingScope a owl:NamedIndividual, ch04:EnclosingScope ; rdfs:label "(lambda n: (lambda: n * 2)())(21)"@en ; skos:definition "The local scope of the function around a nested function; the inner function can read its variables."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_EnclosingScope a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda n: (lambda: n * 2)())(21) evaluates to 42"@en ; ch04:input "(lambda n: (lambda: n * 2)())(21)" ; ch04:output "42" .
ch04:X_EnclosingScope rd:hasIOExample ch04:IO_EnclosingScope .
ch04:X_BuiltinScope a owl:NamedIndividual, ch04:BuiltinScope ; rdfs:label "builtins"@en ; skos:definition "The scope searched last for a name; it holds print, len and the other built-in functions, which is why they work without being defined."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_BuiltinScope a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('builtins').len is len evaluates to True"@en ; ch04:input "__import__('builtins').len is len" ; ch04:output "True" .
ch04:X_BuiltinScope rd:hasIOExample ch04:IO_BuiltinScope .
ch04:X_LocalIsolation a owl:NamedIndividual, ch04:LocalIsolation ; rdfs:label "print(ham) in another function"@en ; skos:definition "Code in the global scope cannot use a local variable, and one function's local scope cannot use variables in another local scope."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_GlobalAccess a owl:NamedIndividual, ch04:GlobalAccess ; rdfs:label "print(eggs) inside spam() with no eggs of its own"@en ; skos:definition "Code in a local scope can read global variables when it has no local variable of that name."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_NameResolution a owl:NamedIndividual, ch04:NameResolution ; rdfs:label "looking up eggs"@en ; skos:definition "The lookup rule behind the scope rules: a name is resolved in the nearest enclosing scope, in the order local, enclosing, global, built-in."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_NameError a owl:NamedIndividual, ch04:NameError ; rdfs:label "eggs"@en ; skos:definition "The error raised when a name is not found in any scope; its message includes the name, as in name 'eggs' is not defined."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_GlobalStatement a owl:NamedIndividual, ch04:GlobalStatement ; rdfs:label "global eggs"@en ; skos:definition "A global statement makes a name in the function refer to the global variable, so assigning to it changes the global."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_ScopeIdentification a owl:NamedIndividual, ch04:ScopeIdentification ; rdfs:label "four rules for eggs"@en ; skos:definition "A name is global if used outside all functions or declared global, local if the function assigns it, and global if the function only reads it."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_SymbolTable a owl:NamedIndividual, ch04:SymbolTable ; rdfs:label "symtable.symtable(code, filename, 'exec')"@en ; skos:definition "The compiler's table recording whether each name in a block is local or global, built before the program runs; the symtable module can show it."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_UnboundLocalError a owl:NamedIndividual, ch04:UnboundLocalError ; rdfs:label "print(eggs) before eggs = 'spam local'"@en ; skos:definition "Using a local variable before it is assigned raises UnboundLocalError; since Python 3.11 the message reads cannot access local variable where it is not associated with a value."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_NonlocalStatement a owl:NamedIndividual, ch04:NonlocalStatement ; rdfs:label "nonlocal n"@en ; skos:definition "A nonlocal statement lets an inner function rebind a name of the enclosing function, between the local and the global case."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_TryExcept a owl:NamedIndividual, ch04:TryExcept ; rdfs:label "try: ... except ZeroDivisionError:"@en ; skos:definition "Code in a try clause that raises an error jumps to the matching except clause, and execution continues after the try statement."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_ErrorInCall a owl:NamedIndividual, ch04:ErrorInCall ; rdfs:label "the try block around spam(0)"@en ; skos:definition "An error raised inside a function called from a try clause is caught by that clause, and execution does not return into the try clause."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_MultipleExceptTypes a owl:NamedIndividual, ch04:MultipleExceptTypes ; rdfs:label "except A, B:"@en ; skos:definition "Since Python 3.14 an except clause can list several exception types without brackets when it has no as clause."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_ExceptionObject a owl:NamedIndividual, ch04:ExceptionObject ; rdfs:label "except ZeroDivisionError as e:"@en ; skos:definition "Python creates an object for every exception; as binds it to a name, and its args and its text describe what went wrong."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_Traceback a owl:NamedIndividual, ch04:Traceback ; rdfs:label "Traceback (most recent call last):"@en ; skos:definition "The report Python prints when an exception is not handled: the lines of the calls it passed through, and last the exception's type and message."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_ZeroDivisionError a owl:NamedIndividual, ch04:ZeroDivisionError ; rdfs:label "42 / 0"@en ; skos:definition "The exception raised when the second operand of a division or a modulo operation is zero."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_ZeroDivisionError a owl:NamedIndividual, rd:IOExample ; rdfs:label "issubclass(ZeroDivisionError, ArithmeticError) evaluates to True"@en ; ch04:input "issubclass(ZeroDivisionError, ArithmeticError)" ; ch04:output "True" .
ch04:X_ZeroDivisionError rd:hasIOExample ch04:IO_ZeroDivisionError .
ch04:X_ExceptionHierarchy a owl:NamedIndividual, ch04:ExceptionHierarchy ; rdfs:label "ZeroDivisionError < ArithmeticError < Exception"@en ; skos:definition "Exception classes form a family tree, and an except clause catches the named class and all classes derived from it."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_ExceptionHierarchy a owl:NamedIndividual, rd:IOExample ; rdfs:label "issubclass(KeyboardInterrupt, Exception) evaluates to False"@en ; ch04:input "issubclass(KeyboardInterrupt, Exception)" ; ch04:output "False" .
ch04:X_ExceptionHierarchy rd:hasIOExample ch04:IO_ExceptionHierarchy .
ch04:X_ZigzagProgram a owl:NamedIndividual, ch04:ZigzagProgram ; rdfs:label "indent and indent_increasing"@en ; skos:definition "A loop that prints eight asterisks, indented by a number that grows to 20 and then shrinks to 0, again and again."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_SpikeProgram a owl:NamedIndividual, ch04:SpikeProgram ; rdfs:label "'-' * (i * i)"@en ; skos:definition "Two for loops print lines of dashes whose lengths are the squares from 1 to 64 and back down to 4, again and again."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_TimeSleep a owl:NamedIndividual, ch04:TimeSleep ; rdfs:label "time.sleep(0.1)"@en ; skos:definition "A function from the time module that pauses the program for the given number of seconds."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_TimeSleep a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('time').sleep(0.0) is None evaluates to True"@en ; ch04:input "__import__('time').sleep(0.0) is None" ; ch04:output "True" .
ch04:X_TimeSleep rd:hasIOExample ch04:IO_TimeSleep .
ch04:X_KeyboardInterrupt a owl:NamedIndividual, ch04:KeyboardInterrupt ; rdfs:label "except KeyboardInterrupt:"@en ; skos:definition "The exception raised when the user presses Ctrl-C; the animation programs catch it to stop cleanly."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_SysExit a owl:NamedIndividual, ch04:SysExit ; rdfs:label "sys.exit()"@en ; skos:definition "A function from the sys module that ends the program by raising SystemExit; an argument sets the exit status."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_SysExit a owl:NamedIndividual, rd:IOExample ; rdfs:label "issubclass(SystemExit, BaseException) evaluates to True"@en ; ch04:input "issubclass(SystemExit, BaseException)" ; ch04:output "True" .
ch04:X_SysExit rd:hasIOExample ch04:IO_SysExit .
ch04:X_CollatzSequence a owl:NamedIndividual, ch04:CollatzSequence ; rdfs:label "collatz(number)"@en ; skos:definition "A function that prints and returns number // 2 for an even number and 3 * number + 1 for an odd one, called until the value is 1."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:IO_CollatzSequence a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda n: n // 2 if n % 2 == 0 else 3 * n + 1)(3) evaluates to 10"@en ; ch04:input "(lambda n: n // 2 if n % 2 == 0 else 3 * n + 1)(3)" ; ch04:output "10" .
ch04:X_CollatzSequence rd:hasIOExample ch04:IO_CollatzSequence .
ch04:X_InputValidation a owl:NamedIndividual, ch04:InputValidation ; rdfs:label "int('puppy')"@en ; skos:definition "Wrapping the conversion of the user's text in try and except, so that text that is not an integer produces a message instead of a crash."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_TypeAnnotation a owl:NamedIndividual, ch04:TypeAnnotation ; rdfs:label "def add(a: int, b: int = 0) -> int:"@en ; skos:definition "A note on a parameter or on the result, written after a colon or an arrow; Python stores it but does not enforce it."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_DeferredAnnotations a owl:NamedIndividual, ch04:DeferredAnnotations ; rdfs:label "def f(x: Undefined):"@en ; skos:definition "Since Python 3.14 a function's annotations are not evaluated at definition, so names that do not exist yet can be used and are looked up only on request."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_BlackBoxFunction a owl:NamedIndividual, ch04:BlackBoxFunction ; rdfs:label "use it without reading it"@en ; skos:definition "A function can be treated as a black box: its parameters go in, its return value comes out, and its local variables affect nothing else."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_FunctionNaming a owl:NamedIndividual, ch04:FunctionNaming ; rdfs:label "say_hello_to"@en ; skos:definition "PEP 8 asks for lowercase function names with words separated by underscores; Python tells names apart by case, so the call must match the definition."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_Comment a owl:NamedIndividual, ch04:Comment ; rdfs:label "# this is a comment"@en ; skos:definition "Text that starts with a hash character and runs to the end of the line; Python ignores it."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:X_NamedParameter ch04:hasOwner ch04:X_ParameterAndArgument .
ch04:X_PositionalOnlyParameter ch04:hasOwner ch04:X_ParameterAndArgument .
ch04:X_KeywordOnlyParameter ch04:hasOwner ch04:X_ParameterAndArgument .
ch04:X_DefaultArgument ch04:hasOwner ch04:X_ParameterAndArgument .
ch04:X_PositionalArgument ch04:hasOwner ch04:X_ParameterAndArgument .
ch04:X_ImplicitNone ch04:hasOwner ch04:X_ReturnStatement .
ch04:X_CallAsExpression ch04:hasOwner ch04:X_ReturnStatement .
ch04:X_IdentityTest ch04:hasOwner ch04:X_NoneValue .
ch04:X_ErrorInCall ch04:hasOwner ch04:X_TryExcept .
ch04:X_MultipleExceptTypes ch04:hasOwner ch04:X_TryExcept .
ch04:X_ExceptionObject ch04:hasOwner ch04:X_TryExcept .
ch04:X_ZeroDivisionError ch04:hasOwner ch04:X_ExceptionHierarchy .
ch04:X_UnboundLocalError ch04:hasOwner ch04:X_ScopeIdentification .
ch04:X_NonlocalStatement ch04:hasOwner ch04:X_GlobalStatement .
ch04:X_SymbolTable ch04:hasOwner ch04:X_ScopeIdentification .
ch04:X_InputValidation ch04:hasOwner ch04:X_CollatzSequence .
ch04:X_KeyboardInterrupt ch04:hasOwner ch04:X_SysExit .
ch04:X_DeferredAnnotations ch04:hasOwner ch04:X_TypeAnnotation .
ch04:Err_ZeroDivisionError a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "42 / 0 raises ZeroDivisionError: division by zero"@en .
ch04:X_ZeroDivisionError rd:hasErrorCondition ch04:Err_ZeroDivisionError .
ch04:Err_NameError a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "print(eggs) raises NameError: name 'eggs' is not defined"@en .
ch04:X_NameError rd:hasErrorCondition ch04:Err_NameError .
ch04:Err_ParameterAndArgument a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda name: name)() raises TypeError: <lambda>() missing 1 required positional argument: 'name'"@en .
ch04:X_ParameterAndArgument rd:hasErrorCondition ch04:Err_ParameterAndArgument .
ch04:Err_PositionalOnlyParameter a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda a, /, b: a * b)(a=3, b=4) raises TypeError: <lambda>() got some positional-only arguments passed as keyword arguments: 'a'"@en .
ch04:X_PositionalOnlyParameter rd:hasErrorCondition ch04:Err_PositionalOnlyParameter .
ch04:Err_KeywordOnlyParameter a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda a, *, b=2: a + b)(1, 5) raises TypeError: <lambda>() takes 1 positional argument but 2 were given"@en .
ch04:X_KeywordOnlyParameter rd:hasErrorCondition ch04:Err_KeywordOnlyParameter .
ch04:Err_FunctionCall a owl:NamedIndividual, rd:ErrorCondition ; rdfs:label "(lambda: 0)(1) raises TypeError: <lambda>() takes 0 positional arguments but 1 was given"@en .
ch04:X_FunctionCall rd:hasErrorCondition ch04:Err_FunctionCall .

ch04:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 4 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch04/research> ;
    rd:hasCompetencyQuestion ch04:CQs ; rd:hasSourceProvenance ch04:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment ch04:Env .
ch04:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 4 competency questions"@en ;
    rd:containsCompetencyQuestion ch04:CQ1, ch04:CQ2, ch04:CQ3 .
ch04:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which constructs define, call and leave a function, and what decides which variable a name refers to?"@en .
ch04:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs and concepts of the chapter differ in current Python, and on what source?"@en .
ch04:CQ3 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which terms and tools does the chapter use without explaining them, and where is each one explained?"@en .
ch04:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 4 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 4 through the Stage 1 research artefact (version 1.1.0); the concepts that the chapter's text uses without explaining them, and the modern-practice branch, are drawn from that artefact's secondary sources (the Python documentation and the PEPs), not from the book."@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> .
ch04:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.12.11 and CPython 3.14.4"@en ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (168 checks listed in sen0414_ch04_corpus_v1_0_0.py), executed under CPython 3.12.11 and CPython 3.14.4: identical output where more than one was used."@en ;
    dcterms:source "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch04_corpus_v1_0_0.py" .

