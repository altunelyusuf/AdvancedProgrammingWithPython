chx:X_DefStatement a owl:NamedIndividual, chx:DefStatement ; rdfs:label "def hello():"@en ; skos:definition "A def statement creates a function and binds its name; the body runs when the function is called, not when it is defined."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_FunctionCall a owl:NamedIndividual, chx:FunctionCall ; rdfs:label "hello()"@en ; skos:definition "A call is the function's name followed by parentheses, with any arguments inside, and execution jumps into the body and comes back."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_Deduplication a owl:NamedIndividual, chx:Deduplication ; rdfs:label "one def, three calls"@en ; skos:definition "A function groups code that runs more than once, so a fix is made in one place instead of in every pasted copy."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_ParameterAndArgument a owl:NamedIndividual, chx:ParameterAndArgument ; rdfs:label "say_hello_to('Alice')"@en ; skos:definition "An argument is the value passed in a call, a parameter is the variable that receives it, and the parameter is forgotten when the function returns."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_NamedParameter a owl:NamedIndividual, chx:NamedParameter ; rdfs:label "print('a', 'b', sep=',')"@en ; skos:definition "A named parameter is identified by its name in the call rather than its position; print's sep and end are two."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:IO_NamedParameter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b: (print('cats', 'dogs', 'mice', sep=',', file=b), b.getvalue())[1])(__import__('io').StringIO()) evaluates to 'cats,dogs,mice\\n'"@en ; chx:input "(lambda b: (print('cats', 'dogs', 'mice', sep=',', file=b), b.getvalue())[1])(__import__('io').StringIO())" ; chx:output "'cats,dogs,mice\\n'" .
chx:X_NamedParameter rd:hasIOExample chx:IO_NamedParameter .
chx:X_PositionalOnlyParameter a owl:NamedIndividual, chx:PositionalOnlyParameter ; rdfs:label "def f(a, /, b):"@en ; skos:definition "Parameters before a slash can only be passed by position; passing one by name raises a TypeError."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:IO_PositionalOnlyParameter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, /, b: a * b)(3, b=4) evaluates to 12"@en ; chx:input "(lambda a, /, b: a * b)(3, b=4)" ; chx:output "12" .
chx:X_PositionalOnlyParameter rd:hasIOExample chx:IO_PositionalOnlyParameter .
chx:X_KeywordOnlyParameter a owl:NamedIndividual, chx:KeywordOnlyParameter ; rdfs:label "def f(a, *, b=2):"@en ; skos:definition "Parameters after a star can only be passed by name, so a call cannot get them wrong by position."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:IO_KeywordOnlyParameter a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a, *, b=2: a + b)(1, b=5) evaluates to 6"@en ; chx:input "(lambda a, *, b=2: a + b)(1, b=5)" ; chx:output "6" .
chx:X_KeywordOnlyParameter rd:hasIOExample chx:IO_KeywordOnlyParameter .
chx:X_DefaultArgument a owl:NamedIndividual, chx:DefaultArgument ; rdfs:label "def f(a, L=None):"@en ; skos:definition "A default value is evaluated once, when the function is defined, so a mutable default is shared between calls; the tutorial's remedy is a default of None."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_ReturnStatement a owl:NamedIndividual, chx:ReturnStatement ; rdfs:label "return 42 / divide_by"@en ; skos:definition "A return statement leaves the function with the value of its expression, so a call can be used wherever a value can."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:IO_ReturnStatement a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: 42 / d)(2) evaluates to 21.0"@en ; chx:input "(lambda d: 42 / d)(2)" ; chx:output "21.0" .
chx:X_ReturnStatement rd:hasIOExample chx:IO_ReturnStatement .
chx:X_ImplicitNone a owl:NamedIndividual, chx:ImplicitNone ; rdfs:label "def f(): pass"@en ; skos:definition "A function without a return statement, or with a bare return, returns None."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:IO_ImplicitNone a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda: None)() is None evaluates to True"@en ; chx:input "(lambda: None)() is None" ; chx:output "True" .
chx:X_ImplicitNone rd:hasIOExample chx:IO_ImplicitNone .
chx:X_NoneValue a owl:NamedIndividual, chx:NoneValue ; rdfs:label "spam = print('Hello!')"@en ; skos:definition "None is the only value of NoneType and stands for the absence of a value; print returns it, and PEP 8 says to compare with is."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:IO_NoneValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "type(None).__name__ evaluates to 'NoneType'"@en ; chx:input "type(None).__name__" ; chx:output "'NoneType'" .
chx:X_NoneValue rd:hasIOExample chx:IO_NoneValue .
chx:X_CallStackOrder a owl:NamedIndividual, chx:CallStackOrder ; rdfs:label "a() calls b() calls c()"@en ; skos:definition "Python remembers which line called a function so that execution returns there, keeping the waiting calls on a stack of frames."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:IO_CallStackOrder a owl:NamedIndividual, rd:IOExample ; rdfs:label "len(str(42 / 2)) evaluates to 4"@en ; chx:input "len(str(42 / 2))" ; chx:output "4" .
chx:X_CallStackOrder rd:hasIOExample chx:IO_CallStackOrder .
chx:X_StackInspection a owl:NamedIndividual, chx:StackInspection ; rdfs:label "traceback.extract_stack()"@en ; skos:definition "A program can list the frames it is running inside, and the interpreter stops a runaway chain of calls with a RecursionError."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:IO_StackInspection a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sys').getrecursionlimit() evaluates to 1000"@en ; chx:input "__import__('sys').getrecursionlimit()" ; chx:output "1000" .
chx:X_StackInspection rd:hasIOExample chx:IO_StackInspection .
chx:X_LocalScope a owl:NamedIndividual, chx:LocalScope ; rdfs:label "eggs = 'sss' inside spam()"@en ; skos:definition "A variable assigned inside a function exists only in that call's local scope and is destroyed when the call returns."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_GlobalScope a owl:NamedIndividual, chx:GlobalScope ; rdfs:label "eggs = 'global' outside all functions"@en ; skos:definition "There is one global scope, created when the program begins and destroyed when it ends, and code in any function can read its variables."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_SameNameVariables a owl:NamedIndividual, chx:SameNameVariables ; rdfs:label "three variables named eggs"@en ; skos:definition "The same name in different scopes gives different variables; the book advises unique names to keep track of them."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_GlobalStatement a owl:NamedIndividual, chx:GlobalStatement ; rdfs:label "global eggs"@en ; skos:definition "A global statement makes a name in the function refer to the global variable, so assigning to it changes the global."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_ScopeIdentification a owl:NamedIndividual, chx:ScopeIdentification ; rdfs:label "four rules for eggs"@en ; skos:definition "A name is global if used outside all functions or declared global, local if the function assigns it, and global if the function only reads it."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_UnboundLocalError a owl:NamedIndividual, chx:UnboundLocalError ; rdfs:label "print(eggs) before eggs = 'spam local'"@en ; skos:definition "Using a local variable before it is assigned raises UnboundLocalError, whose message in 3.14 reads cannot access local variable where it is not associated with a value."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_NonlocalStatement a owl:NamedIndividual, chx:NonlocalStatement ; rdfs:label "nonlocal n"@en ; skos:definition "A nonlocal statement lets an inner function rebind a name of the enclosing function, between the local and the global case."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_TryExcept a owl:NamedIndividual, chx:TryExcept ; rdfs:label "try: ... except ZeroDivisionError:"@en ; skos:definition "Code in a try clause that raises an error jumps to the matching except clause, and execution continues after the try statement."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_ErrorInCall a owl:NamedIndividual, chx:ErrorInCall ; rdfs:label "the try block around spam(0)"@en ; skos:definition "An error raised inside a function called from a try clause is caught by that clause, and execution does not return into the try clause."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_MultipleExceptTypes a owl:NamedIndividual, chx:MultipleExceptTypes ; rdfs:label "except A, B:"@en ; skos:definition "Since Python 3.14 an except clause can list several exception types without brackets when it has no as clause."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_DeferredAnnotations a owl:NamedIndividual, chx:DeferredAnnotations ; rdfs:label "def f(x: Undefined):"@en ; skos:definition "Since Python 3.14 a function's annotations are not evaluated at definition, so names that do not exist yet can be used and are looked up only on request."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:X_BlackBoxFunction a owl:NamedIndividual, chx:BlackBoxFunction ; rdfs:label "use it without reading it"@en ; skos:definition "A function can be treated as a black box: its parameters go in, its return value comes out, and its local variables affect nothing else."@en ; dcterms:source <http://example.org/sen0414/ch04/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 4 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch04/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 4 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which constructs define, call and leave a function, and what decides which variable a name refers to?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs and concepts of the chapter differ in current Python, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 4 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 4 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-09-29."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

