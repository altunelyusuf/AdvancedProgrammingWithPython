@prefix chx: <http://example.org/sen0414/ch04#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rd: <http://example.org/rdodi/domain-ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chx:Artifact a rd:DomainOntologyArtifact,
        owl:NamedIndividual ;
    rdfs:label "SEN0414 chapter 4 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch04/research> ;
    rd:hasCompetencyQuestion chx:CQs ;
    rd:hasResolutionEnvironment chx:Env ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ;
    rd:hasSourceProvenance chx:Provenance .

chx:X_BlackBoxFunction a chx:BlackBoxFunction,
        owl:NamedIndividual ;
    rdfs:label "use it without reading it"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A function can be treated as a black box: its parameters go in, its return value comes out, and its local variables affect nothing else."@en .

chx:X_BuiltinScope a chx:BuiltinScope,
        owl:NamedIndividual ;
    rdfs:label "builtins"@en ;
    rd:hasIOExample chx:IO_BuiltinScope ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The scope searched last for a name; it holds print, len and the other built-in functions, which is why they work without being defined."@en .

chx:X_CallAsExpression a chx:CallAsExpression,
        owl:NamedIndividual ;
    rdfs:label "print(get_answer(random.randint(1, 9)))"@en ;
    rd:hasIOExample chx:IO_CallAsExpression ;
    chx:hasOwner chx:X_ReturnStatement ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Because a call evaluates to its return value, a call can be used as an argument of another call or as an operand in a larger expression."@en .

chx:X_CallStackOrder a chx:CallStackOrder,
        owl:NamedIndividual ;
    rdfs:label "a() calls b() calls c()"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Python remembers which line called a function so that execution returns there, keeping the waiting calls on a stack of frames."@en .

chx:X_Comment a chx:Comment,
        owl:NamedIndividual ;
    rdfs:label "# this is a comment"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Text that starts with a hash character and runs to the end of the line; Python ignores it."@en .

chx:X_Deduplication a chx:Deduplication,
        owl:NamedIndividual ;
    rdfs:label "one def, three calls"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A function groups code that runs more than once, so a fix is made in one place instead of in every pasted copy."@en .

chx:X_DefStatement a chx:DefStatement,
        owl:NamedIndividual ;
    rdfs:label "def hello():"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A def statement creates a function and binds its name; the body runs when the function is called, not when it is defined."@en .

chx:X_DefaultArgument a chx:DefaultArgument,
        owl:NamedIndividual ;
    rdfs:label "def f(a, L=None):"@en ;
    rd:hasIOExample chx:IO_DefaultArgument ;
    chx:hasOwner chx:X_ParameterAndArgument ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A default value is evaluated once, when the function is defined, so a mutable default is shared between calls; the tutorial's remedy is a default of None."@en .

chx:X_DeferredAnnotations a chx:DeferredAnnotations,
        owl:NamedIndividual ;
    rdfs:label "def f(x: Undefined):"@en ;
    chx:hasOwner chx:X_TypeAnnotation ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Since Python 3.14 a function's annotations are not evaluated at definition, so names that do not exist yet can be used and are looked up only on request."@en .

chx:X_EnclosingScope a chx:EnclosingScope,
        owl:NamedIndividual ;
    rdfs:label "(lambda n: (lambda: n * 2)())(21)"@en ;
    rd:hasIOExample chx:IO_EnclosingScope ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The local scope of the function around a nested function; the inner function can read its variables."@en .

chx:X_ErrorInCall a chx:ErrorInCall,
        owl:NamedIndividual ;
    rdfs:label "the try block around spam(0)"@en ;
    chx:hasOwner chx:X_TryExcept ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "An error raised inside a function called from a try clause is caught by that clause, and execution does not return into the try clause."@en .

chx:X_ExceptionObject a chx:ExceptionObject,
        owl:NamedIndividual ;
    rdfs:label "except ZeroDivisionError as e:"@en ;
    chx:hasOwner chx:X_TryExcept ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Python creates an object for every exception; as binds it to a name, and its args and its text describe what went wrong."@en .

chx:X_FrameObject a chx:FrameObject,
        owl:NamedIndividual ;
    rdfs:label "inspect.currentframe()"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The record Python creates for one call; it stores where the call came from, so execution can return there."@en .

chx:X_FunctionBody a chx:FunctionBody,
        owl:NamedIndividual ;
    rdfs:label "the indented block under def"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The block of indented statements after the colon of the def line; it runs on each call, from its first line to the end or to a return statement."@en .

chx:X_FunctionCall a chx:FunctionCall,
        owl:NamedIndividual ;
    rdfs:label "hello()"@en ;
    rd:hasErrorCondition chx:Err_FunctionCall ;
    rd:hasIOExample chx:IO_FunctionCall ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A call is the function's name followed by parentheses, with any arguments inside, and execution jumps into the body and comes back."@en .

chx:X_FunctionNaming a chx:FunctionNaming,
        owl:NamedIndividual ;
    rdfs:label "say_hello_to"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "PEP 8 asks for lowercase function names with words separated by underscores; Python tells names apart by case, so the call must match the definition."@en .

chx:X_FunctionObject a chx:FunctionObject,
        owl:NamedIndividual ;
    rdfs:label "type(hello)"@en ;
    rd:hasIOExample chx:IO_FunctionObject ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "What a def statement actually creates: a value of type function, which the function's name refers to and which can be given other names."@en .

chx:X_GlobalAccess a chx:GlobalAccess,
        owl:NamedIndividual ;
    rdfs:label "print(eggs) inside spam() with no eggs of its own"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Code in a local scope can read global variables when it has no local variable of that name."@en .

chx:X_GlobalScope a chx:GlobalScope,
        owl:NamedIndividual ;
    rdfs:label "eggs = 'global' outside all functions"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "There is one global scope, created when the program begins and destroyed when it ends, and code in any function can read its variables."@en .

chx:X_IdentityTest a chx:IdentityTest,
        owl:NamedIndividual ;
    rdfs:label "x is None"@en ;
    rd:hasIOExample chx:IO_IdentityTest ;
    chx:hasOwner chx:X_NoneValue ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The operators is and is not test whether two names refer to the very same object; PEP 8 says to compare with None this way."@en .

chx:X_ImplicitNone a chx:ImplicitNone,
        owl:NamedIndividual ;
    rdfs:label "def f(): pass"@en ;
    rd:hasIOExample chx:IO_ImplicitNone ;
    chx:hasOwner chx:X_ReturnStatement ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A function without a return statement, or with a bare return, returns None."@en .

chx:X_InputValidation a chx:InputValidation,
        owl:NamedIndividual ;
    rdfs:label "int('puppy')"@en ;
    chx:hasOwner chx:X_CollatzSequence ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Wrapping the conversion of the user's text in try and except, so that text that is not an integer produces a message instead of a crash."@en .

chx:X_KeyboardInterrupt a chx:KeyboardInterrupt,
        owl:NamedIndividual ;
    rdfs:label "except KeyboardInterrupt:"@en ;
    chx:hasOwner chx:X_SysExit ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The exception raised when the user presses Ctrl-C; the animation programs catch it to stop cleanly."@en .

chx:X_KeywordOnlyParameter a chx:KeywordOnlyParameter,
        owl:NamedIndividual ;
    rdfs:label "def f(a, *, b=2):"@en ;
    rd:hasErrorCondition chx:Err_KeywordOnlyParameter ;
    rd:hasIOExample chx:IO_KeywordOnlyParameter ;
    chx:hasOwner chx:X_ParameterAndArgument ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Parameters after a star can only be passed by name, so a call cannot get them wrong by position."@en .

chx:X_LambdaExpression a chx:LambdaExpression,
        owl:NamedIndividual ;
    rdfs:label "lambda a, b: a + b"@en ;
    rd:hasIOExample chx:IO_LambdaExpression ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A way to write a small function as a single expression; it has no name of its own and its body is one expression."@en .

chx:X_LocalIsolation a chx:LocalIsolation,
        owl:NamedIndividual ;
    rdfs:label "print(ham) in another function"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Code in the global scope cannot use a local variable, and one function's local scope cannot use variables in another local scope."@en .

chx:X_LocalScope a chx:LocalScope,
        owl:NamedIndividual ;
    rdfs:label "eggs = 'sss' inside spam()"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A variable assigned inside a function exists only in that call's local scope and is destroyed when the call returns."@en .

chx:X_ModuleFunction a chx:ModuleFunction,
        owl:NamedIndividual ;
    rdfs:label "random.randint(1, 9)"@en ;
    rd:hasIOExample chx:IO_ModuleFunction ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A function that lives in a module is called with the module's name and a dot in front, after the module has been imported."@en .

chx:X_MultipleExceptTypes a chx:MultipleExceptTypes,
        owl:NamedIndividual ;
    rdfs:label "except A, B:"@en ;
    chx:hasOwner chx:X_TryExcept ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Since Python 3.14 an except clause can list several exception types without brackets when it has no as clause."@en .

chx:X_NameError a chx:NameError,
        owl:NamedIndividual ;
    rdfs:label "eggs"@en ;
    rd:hasErrorCondition chx:Err_NameError ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The error raised when a name is not found in any scope; its message includes the name, as in name 'eggs' is not defined."@en .

chx:X_NameResolution a chx:NameResolution,
        owl:NamedIndividual ;
    rdfs:label "looking up eggs"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The lookup rule behind the scope rules: a name is resolved in the nearest enclosing scope, in the order local, enclosing, global, built-in."@en .

chx:X_NamedParameter a chx:NamedParameter,
        owl:NamedIndividual ;
    rdfs:label "print('a', 'b', sep=',')"@en ;
    rd:hasIOExample chx:IO_NamedParameter ;
    chx:hasOwner chx:X_ParameterAndArgument ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A named parameter is identified by its name in the call rather than its position; print's sep and end are two."@en .

chx:X_NestedFunction a chx:NestedFunction,
        owl:NamedIndividual ;
    rdfs:label "a def inside a def"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A function defined inside the body of another function; it exists only while the outer function runs and can read the outer function's variables."@en .

chx:X_NonlocalStatement a chx:NonlocalStatement,
        owl:NamedIndividual ;
    rdfs:label "nonlocal n"@en ;
    chx:hasOwner chx:X_GlobalStatement ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A nonlocal statement lets an inner function rebind a name of the enclosing function, between the local and the global case."@en .

chx:X_PositionalArgument a chx:PositionalArgument,
        owl:NamedIndividual ;
    rdfs:label "divmod(17, 5)"@en ;
    rd:hasIOExample chx:IO_PositionalArgument ;
    chx:hasOwner chx:X_ParameterAndArgument ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "An argument matched to a parameter by its position in the call, so swapping two arguments changes the result."@en .

chx:X_PositionalOnlyParameter a chx:PositionalOnlyParameter,
        owl:NamedIndividual ;
    rdfs:label "def f(a, /, b):"@en ;
    rd:hasErrorCondition chx:Err_PositionalOnlyParameter ;
    rd:hasIOExample chx:IO_PositionalOnlyParameter ;
    chx:hasOwner chx:X_ParameterAndArgument ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Parameters before a slash can only be passed by position; passing one by name raises a TypeError."@en .

chx:X_Recursion a chx:Recursion,
        owl:NamedIndividual ;
    rdfs:label "def factorial(n): ... n * factorial(n - 1)"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A function that calls itself; each call has its own frame, and a base case must end the chain or RecursionError follows."@en .

chx:X_ReservedKeyword a chx:ReservedKeyword,
        owl:NamedIndividual ;
    rdfs:label "def, return, global, nonlocal, try, except"@en ;
    rd:hasIOExample chx:IO_ReservedKeyword ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A word that has a fixed meaning in the Python language and cannot be used as a name; def, return, global, nonlocal, try and except are keywords."@en .

chx:X_SameNameVariables a chx:SameNameVariables,
        owl:NamedIndividual ;
    rdfs:label "three variables named eggs"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The same name in different scopes gives different variables; the book advises unique names to keep track of them."@en .

chx:X_SpikeProgram a chx:SpikeProgram,
        owl:NamedIndividual ;
    rdfs:label "'-' * (i * i)"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Two for loops print lines of dashes whose lengths are the squares from 1 to 64 and back down to 4, again and again."@en .

chx:X_StackInspection a chx:StackInspection,
        owl:NamedIndividual ;
    rdfs:label "traceback.extract_stack()"@en ;
    rd:hasIOExample chx:IO_StackInspection ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A program can list the frames it is running inside, and the interpreter stops a runaway chain of calls with a RecursionError."@en .

chx:X_SymbolTable a chx:SymbolTable,
        owl:NamedIndividual ;
    rdfs:label "symtable.symtable(code, filename, 'exec')"@en ;
    chx:hasOwner chx:X_ScopeIdentification ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The compiler's table recording whether each name in a block is local or global, built before the program runs; the symtable module can show it."@en .

chx:X_TimeSleep a chx:TimeSleep,
        owl:NamedIndividual ;
    rdfs:label "time.sleep(0.1)"@en ;
    rd:hasIOExample chx:IO_TimeSleep ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A function from the time module that pauses the program for the given number of seconds."@en .

chx:X_Traceback a chx:Traceback,
        owl:NamedIndividual ;
    rdfs:label "Traceback (most recent call last):"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The report Python prints when an exception is not handled: the lines of the calls it passed through, and last the exception's type and message."@en .

chx:X_UnboundLocalError a chx:UnboundLocalError,
        owl:NamedIndividual ;
    rdfs:label "print(eggs) before eggs = 'spam local'"@en ;
    chx:hasOwner chx:X_ScopeIdentification ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Using a local variable before it is assigned raises UnboundLocalError; since Python 3.11 the message reads cannot access local variable where it is not associated with a value."@en .

chx:X_ZeroDivisionError a chx:ZeroDivisionError,
        owl:NamedIndividual ;
    rdfs:label "42 / 0"@en ;
    rd:hasErrorCondition chx:Err_ZeroDivisionError ;
    rd:hasIOExample chx:IO_ZeroDivisionError ;
    chx:hasOwner chx:X_ExceptionHierarchy ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "The exception raised when the second operand of a division or a modulo operation is zero."@en .

chx:X_ZigzagProgram a chx:ZigzagProgram,
        owl:NamedIndividual ;
    rdfs:label "indent and indent_increasing"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A loop that prints eight asterisks, indented by a number that grows to 20 and then shrinks to 0, again and again."@en .

<http://example.org/sen0414/ch04/abox> a owl:Ontology ;
    rdfs:label "SEN0414 chapter 4 domain ontology - ABox"@en ;
    dcterms:created "2026-10-25"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:identifier "sen0414_ch04_abox_v1_3_0" ;
