    prov:wasGeneratedBy <http://example.org/sen0414/activity/ch04-rdodi-run> .

chx:CQ1 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which constructs define, call and leave a function, and what decides which variable a name refers to?"@en .

chx:CQ2 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which printed outputs and concepts of the chapter differ in current Python, and on what source?"@en .

chx:CQ3 a rd:CompetencyQuestion,
        owl:NamedIndividual ;
    rdfs:label "Which terms and tools does the chapter use without explaining them, and where is each one explained?"@en .

chx:CQs a rd:CompetencyQuestionSet,
        owl:NamedIndividual ;
    rdfs:label "Chapter 4 competency questions"@en ;
    rd:containsCompetencyQuestion chx:CQ1,
        chx:CQ2,
        chx:CQ3 .

chx:Env a rd:ResolutionEnvironment,
        owl:NamedIndividual ;
    rdfs:label "CPython 3.12.11 and CPython 3.14.4"@en,
        "CPython 3.14.4"@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_2_0.py",
        "The execution run recorded with this ontology's build, 08-tooling/sen0414_chapter_build_v1_0_0.py, and the claims check in 08-tooling/sen0414_ch04_corpus_v1_0_0.py" ;
    skos:definition "Every input-output example and error condition, and every quoted result in the chapter text (168 checks listed in sen0414_ch04_corpus_v1_0_0.py), executed under CPython 3.12.11 and CPython 3.14.4: identical output where more than one was used."@en,
        "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-25."@en .

chx:Err_FunctionCall a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "(lambda: 0)(1) raises TypeError: <lambda>() takes 0 positional arguments but 1 was given"@en .

chx:Err_KeywordOnlyParameter a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "(lambda a, *, b=2: a + b)(1, 5) raises TypeError: <lambda>() takes 1 positional argument but 2 were given"@en .

chx:Err_NameError a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "print(eggs) raises NameError: name 'eggs' is not defined"@en .

chx:Err_ParameterAndArgument a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "(lambda name: name)() raises TypeError: <lambda>() missing 1 required positional argument: 'name'"@en .

chx:Err_PositionalOnlyParameter a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "(lambda a, /, b: a * b)(a=3, b=4) raises TypeError: <lambda>() got some positional-only arguments passed as keyword arguments: 'a'"@en .

chx:Err_ZeroDivisionError a rd:ErrorCondition,
        owl:NamedIndividual ;
    rdfs:label "42 / 0 raises ZeroDivisionError: division by zero"@en .

chx:IO_BuiltinScope a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "__import__('builtins').len is len evaluates to True"@en ;
    chx:input "__import__('builtins').len is len" ;
    chx:output "True" .

chx:IO_CallAsExpression a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "len(str(42 / 2)) evaluates to 4"@en ;
    chx:input "len(str(42 / 2))" ;
    chx:output "4" .

chx:IO_CollatzSequence a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda n: n // 2 if n % 2 == 0 else 3 * n + 1)(3) evaluates to 10"@en ;
    chx:input "(lambda n: n // 2 if n % 2 == 0 else 3 * n + 1)(3)" ;
    chx:output "10" .

chx:IO_DefaultArgument a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda x, y=10: x + y)(1) evaluates to 11"@en ;
    chx:input "(lambda x, y=10: x + y)(1)" ;
    chx:output "11" .

chx:IO_EnclosingScope a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda n: (lambda: n * 2)())(21) evaluates to 42"@en ;
    chx:input "(lambda n: (lambda: n * 2)())(21)" ;
    chx:output "42" .

chx:IO_ExceptionHierarchy a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "issubclass(KeyboardInterrupt, Exception) evaluates to False"@en ;
    chx:input "issubclass(KeyboardInterrupt, Exception)" ;
    chx:output "False" .

chx:IO_FunctionCall a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "max(3, 7) evaluates to 7"@en ;
    chx:input "max(3, 7)" ;
    chx:output "7" .

chx:IO_FunctionObject a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "callable(len) evaluates to True"@en ;
    chx:input "callable(len)" ;
    chx:output "True" .

chx:IO_IdentityTest a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda x: x is None)(0) evaluates to False"@en ;
    chx:input "(lambda x: x is None)(0)" ;
    chx:output "False" .

chx:IO_ImplicitNone a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "[2, 1].sort() is None evaluates to True"@en ;
    chx:input "[2, 1].sort() is None" ;
    chx:output "True" .

chx:IO_KeywordOnlyParameter a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda a, *, b=2: a + b)(1, b=5) evaluates to 6"@en ;
    chx:input "(lambda a, *, b=2: a + b)(1, b=5)" ;
    chx:output "6" .

chx:IO_LambdaExpression a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda a, b: a + b)(2, 3) evaluates to 5"@en ;
    chx:input "(lambda a, b: a + b)(2, 3)" ;
    chx:output "5" .

chx:IO_ModuleFunction a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "__import__('math').floor(7.5) evaluates to 7"@en ;
    chx:input "__import__('math').floor(7.5)" ;
    chx:output "7" .

chx:IO_NamedParameter a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "int('ff', base=16) evaluates to 255"@en ;
    chx:input "int('ff', base=16)" ;
    chx:output "255" .

chx:IO_NoneValue a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "type(None).__name__ evaluates to 'NoneType'"@en ;
    chx:input "type(None).__name__" ;
    chx:output "'NoneType'" .

chx:IO_ParameterAndArgument a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "round(3.14159, 2) evaluates to 3.14"@en ;
    chx:input "round(3.14159, 2)" ;
    chx:output "3.14" .

chx:IO_PositionalArgument a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "divmod(17, 5) evaluates to (3, 2)"@en ;
    chx:input "divmod(17, 5)" ;
    chx:output "(3, 2)" .

chx:IO_PositionalOnlyParameter a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda a, /, b: a * b)(3, b=4) evaluates to 12"@en ;
    chx:input "(lambda a, /, b: a * b)(3, b=4)" ;
    chx:output "12" .

chx:IO_ReservedKeyword a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "__import__('keyword').iskeyword('def') evaluates to True"@en ;
    chx:input "__import__('keyword').iskeyword('def')" ;
    chx:output "True" .

chx:IO_ReturnStatement a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "(lambda d: 42 / d)(2) evaluates to 21.0"@en ;
    chx:input "(lambda d: 42 / d)(2)" ;
    chx:output "21.0" .

chx:IO_StackInspection a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "__import__('sys').getrecursionlimit() evaluates to 1000"@en ;
    chx:input "__import__('sys').getrecursionlimit()" ;
    chx:output "1000" .

chx:IO_SysExit a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "issubclass(SystemExit, BaseException) evaluates to True"@en ;
    chx:input "issubclass(SystemExit, BaseException)" ;
    chx:output "True" .

chx:IO_TimeSleep a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "__import__('time').sleep(0.0) is None evaluates to True"@en ;
    chx:input "__import__('time').sleep(0.0) is None" ;
    chx:output "True" .

chx:IO_ZeroDivisionError a rd:IOExample,
        owl:NamedIndividual ;
    rdfs:label "issubclass(ZeroDivisionError, ArithmeticError) evaluates to True"@en ;
    chx:input "issubclass(ZeroDivisionError, ArithmeticError)" ;
    chx:output "True" .

chx:Provenance a rd:ResearchSubjectInput,
        owl:NamedIndividual ;
    rdfs:label "Derived from the chapter 4 research artefact"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 4 through the Stage 1 research artefact (version 1.1.0); the concepts that the chapter's text uses without explaining them, and the modern-practice branch, are drawn from that artefact's secondary sources (the Python documentation and the PEPs), not from the book."@en,
        "Concepts are corpus-derived from the 3rd edition's chapter 4 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en .

chx:X_CollatzSequence a chx:CollatzSequence,
        owl:NamedIndividual ;
    rdfs:label "collatz(number)"@en ;
    rd:hasIOExample chx:IO_CollatzSequence ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A function that prints and returns number // 2 for an even number and 3 * number + 1 for an odd one, called until the value is 1."@en .

chx:X_ExceptionHierarchy a chx:ExceptionHierarchy,
        owl:NamedIndividual ;
    rdfs:label "ZeroDivisionError < ArithmeticError < Exception"@en ;
    rd:hasIOExample chx:IO_ExceptionHierarchy ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Exception classes form a family tree, and an except clause catches the named class and all classes derived from it."@en .

chx:X_GlobalStatement a chx:GlobalStatement,
        owl:NamedIndividual ;
    rdfs:label "global eggs"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A global statement makes a name in the function refer to the global variable, so assigning to it changes the global."@en .

chx:X_NoneValue a chx:NoneValue,
        owl:NamedIndividual ;
    rdfs:label "spam = print('Hello!')"@en ;
    rd:hasIOExample chx:IO_NoneValue ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "None is the only value of NoneType and stands for the absence of a value; print returns it, and PEP 8 says to compare with is."@en .

chx:X_SysExit a chx:SysExit,
        owl:NamedIndividual ;
    rdfs:label "sys.exit()"@en ;
    rd:hasIOExample chx:IO_SysExit ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A function from the sys module that ends the program by raising SystemExit; an argument sets the exit status."@en .

chx:X_TypeAnnotation a chx:TypeAnnotation,
        owl:NamedIndividual ;
    rdfs:label "def add(a: int, b: int = 0) -> int:"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A note on a parameter or on the result, written after a colon or an arrow; Python stores it but does not enforce it."@en .

chx:X_ReturnStatement a chx:ReturnStatement,
        owl:NamedIndividual ;
    rdfs:label "return 42 / divide_by"@en ;
    rd:hasIOExample chx:IO_ReturnStatement ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A return statement leaves the function with the value of its expression, so a call can be used wherever a value can."@en .

chx:X_ScopeIdentification a chx:ScopeIdentification,
        owl:NamedIndividual ;
    rdfs:label "four rules for eggs"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "A name is global if used outside all functions or declared global, local if the function assigns it, and global if the function only reads it."@en .

chx:X_TryExcept a chx:TryExcept,
        owl:NamedIndividual ;
    rdfs:label "try: ... except ZeroDivisionError:"@en ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "Code in a try clause that raises an error jumps to the matching except clause, and execution continues after the try statement."@en .

chx:X_ParameterAndArgument a chx:ParameterAndArgument,
        owl:NamedIndividual ;
    rdfs:label "say_hello_to('Alice')"@en ;
    rd:hasErrorCondition chx:Err_ParameterAndArgument ;
    rd:hasIOExample chx:IO_ParameterAndArgument ;
    dcterms:source <http://example.org/sen0414/ch04/research> ;
    skos:definition "An argument is the value passed in a call, a parameter is the variable that receives it, and the parameter is forgotten when the function returns."@en .

