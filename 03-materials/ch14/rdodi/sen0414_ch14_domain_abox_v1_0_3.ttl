chx:X_LoadWorkbook a owl:NamedIndividual, chx:LoadWorkbook ; rdfs:label "openpyxl.load_workbook('example3.xlsx')"@en ; skos:definition "openpyxl.load_workbook reads an .xlsx file and returns a Workbook object that stands for the whole file, a bit as a File object stands for an opened text file."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_LoadWorkbook a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (type(wb).__module__, type(wb).__name__)') evaluates to ('openpyxl.workbook.workbook', 'Workbook')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (type(wb).__module__, type(wb).__name__)')" ; chx:output "('openpyxl.workbook.workbook', 'Workbook')" .
chx:X_LoadWorkbook rd:hasIOExample chx:IO_LoadWorkbook .
chx:X_SheetNames a owl:NamedIndividual, chx:SheetNames ; rdfs:label "wb.sheetnames"@en ; skos:definition "The sheetnames attribute of a workbook is a list of its sheet names in the order of the tabs."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_SheetNames a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = wb.sheetnames') evaluates to ['Sheet1', 'Sheet2', 'Sheet3']"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = wb.sheetnames')" ; chx:output "['Sheet1', 'Sheet2', 'Sheet3']" .
chx:X_SheetNames rd:hasIOExample chx:IO_SheetNames .
chx:X_ActiveSheet a owl:NamedIndividual, chx:ActiveSheet ; rdfs:label "wb.active"@en ; skos:definition "wb.active is the sheet that was on top when the file was saved; a workbook made in memory has its first sheet active."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ActiveSheet a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (wb.active.title, openpyxl.Workbook().active.title)') evaluates to ('Sheet1', 'Sheet')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (wb.active.title, openpyxl.Workbook().active.title)')" ; chx:output "('Sheet1', 'Sheet')" .
chx:X_ActiveSheet rd:hasIOExample chx:IO_ActiveSheet .
chx:X_SheetByName a owl:NamedIndividual, chx:SheetByName ; rdfs:label "wb['Sheet3']"@en ; skos:definition "A Worksheet is got by its name in square brackets like a dictionary key, and a name that does not exist raises KeyError."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_SheetByName a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\ntry:\\n    wb[\\'Nope\\']\\nexcept KeyError as e:\\n    err = str(e)\\nout = (wb[\\'Sheet3\\'].title, type(wb[\\'Sheet3\\']).__name__, err)') evaluates to ('Sheet3', 'Worksheet', ''Worksheet Nope does not exist.'')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\ntry:\\n    wb[\\'Nope\\']\\nexcept KeyError as e:\\n    err = str(e)\\nout = (wb[\\'Sheet3\\'].title, type(wb[\\'Sheet3\\']).__name__, err)')" ; chx:output "('Sheet3', 'Worksheet', ''Worksheet Nope does not exist.'')" .
chx:X_SheetByName rd:hasIOExample chx:IO_SheetByName .
chx:X_CreateSheet a owl:NamedIndividual, chx:CreateSheet ; rdfs:label "wb.create_sheet(index=0, title='First Sheet')"@en ; skos:definition "create_sheet adds a sheet named SheetN at the end, or at an index with a title, and returns the new Worksheet."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CreateSheet a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nwb = openpyxl.Workbook(); wb.create_sheet(); wb.create_sheet(index=0, title=\\'First Sheet\\'); wb.create_sheet(index=2, title=\\'Middle Sheet\\')\\nout = wb.sheetnames') evaluates to ['First Sheet', 'Sheet', 'Middle Sheet', 'Sheet1']"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nwb = openpyxl.Workbook(); wb.create_sheet(); wb.create_sheet(index=0, title=\\'First Sheet\\'); wb.create_sheet(index=2, title=\\'Middle Sheet\\')\\nout = wb.sheetnames')" ; chx:output "['First Sheet', 'Sheet', 'Middle Sheet', 'Sheet1']" .
chx:X_CreateSheet rd:hasIOExample chx:IO_CreateSheet .
chx:X_DeleteSheet a owl:NamedIndividual, chx:DeleteSheet ; rdfs:label "del wb['Middle Sheet']"@en ; skos:definition "The del operator removes a sheet from a workbook by its name, like a key from a dictionary."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_DeleteSheet a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nwb = openpyxl.Workbook(); wb.create_sheet(); wb.create_sheet(index=0, title=\\'First Sheet\\'); wb.create_sheet(index=2, title=\\'Middle Sheet\\')\\ndel wb[\\'Middle Sheet\\']; del wb[\\'Sheet1\\']\\nout = wb.sheetnames') evaluates to ['First Sheet', 'Sheet']"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nwb = openpyxl.Workbook(); wb.create_sheet(); wb.create_sheet(index=0, title=\\'First Sheet\\'); wb.create_sheet(index=2, title=\\'Middle Sheet\\')\\ndel wb[\\'Middle Sheet\\']; del wb[\\'Sheet1\\']\\nout = wb.sheetnames')" ; chx:output "['First Sheet', 'Sheet']" .
chx:X_DeleteSheet rd:hasIOExample chx:IO_DeleteSheet .
chx:X_SheetTitleRules a owl:NamedIndividual, chx:SheetTitleRules ; rdfs:label "wb.create_sheet('Dup')"@en ; skos:definition "Sheet titles are kept unique without regard to case, a title with a slash, a bracket, a star or a question mark is refused with ValueError, and a title longer than 31 characters only draws a warning."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_SheetTitleRules a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nwb = openpyxl.Workbook(); a = wb.create_sheet(\\'Dup\\'); b = wb.create_sheet(\\'Dup\\'); c = wb.create_sheet(\\'dup\\')\\ntry:\\n    wb.create_sheet(\\'a/b\\')\\nexcept ValueError as e:\\n    err = str(e)\\nout = (a.title, b.title, c.title, err)') evaluates to ('Dup', 'Dup1', 'dup2', 'Invalid character / found in sheet title')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nwb = openpyxl.Workbook(); a = wb.create_sheet(\\'Dup\\'); b = wb.create_sheet(\\'Dup\\'); c = wb.create_sheet(\\'dup\\')\\ntry:\\n    wb.create_sheet(\\'a/b\\')\\nexcept ValueError as e:\\n    err = str(e)\\nout = (a.title, b.title, c.title, err)')" ; chx:output "('Dup', 'Dup1', 'dup2', 'Invalid character / found in sheet title')" .
chx:X_SheetTitleRules rd:hasIOExample chx:IO_SheetTitleRules .
chx:X_SaveWorkbook a owl:NamedIndividual, chx:SaveWorkbook ; rdfs:label "wb.save('example3_copy.xlsx')"@en ; skos:definition "save writes the workbook to the file name it is given, and when that name exists the old file is replaced without a question, which is why the chapter saves under a new name."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_SaveWorkbook a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, os, tempfile\\np = os.path.join(tempfile.mkdtemp(), \\'a.xlsx\\')\\nw = openpyxl.Workbook(); w.active[\\'A1\\'] = \\'first\\'; w.save(p)\\nw = openpyxl.Workbook(); w.active[\\'A1\\'] = \\'second\\'; w.save(p)\\nout = openpyxl.load_workbook(p).active[\\'A1\\'].value') evaluates to 'second'"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, os, tempfile\\np = os.path.join(tempfile.mkdtemp(), \\'a.xlsx\\')\\nw = openpyxl.Workbook(); w.active[\\'A1\\'] = \\'first\\'; w.save(p)\\nw = openpyxl.Workbook(); w.active[\\'A1\\'] = \\'second\\'; w.save(p)\\nout = openpyxl.load_workbook(p).active[\\'A1\\'].value')" ; chx:output "'second'" .
chx:X_SaveWorkbook rd:hasIOExample chx:IO_SaveWorkbook .
chx:X_FileFormats a owl:NamedIndividual, chx:FileFormats ; rdfs:label "openpyxl.load_workbook('old.xls')"@en ; skos:definition "load_workbook judges the file by its name before it reads it: a name ending .xls or .txt is refused with InvalidFileException, and one ending .xlsx or .xlsm is read whatever name the bytes had when they were written."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_FileFormats a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, os, shutil, tempfile\\nd = tempfile.mkdtemp(); openpyxl.Workbook().save(os.path.join(d, \\'a.xlsx\\'))\\nres = []\\nfor ext in (\\'xls\\', \\'txt\\', \\'xlsm\\'):\\n    shutil.copy(os.path.join(d, \\'a.xlsx\\'), os.path.join(d, \\'b.\\' + ext))\\n    try:\\n        res.append(openpyxl.load_workbook(os.path.join(d, \\'b.\\' + ext)).sheetnames)\\n    except Exception as e:\\n        res.append(type(e).__name__)\\nout = res') evaluates to ['InvalidFileException', 'InvalidFileException', ['Sheet']]"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, os, shutil, tempfile\\nd = tempfile.mkdtemp(); openpyxl.Workbook().save(os.path.join(d, \\'a.xlsx\\'))\\nres = []\\nfor ext in (\\'xls\\', \\'txt\\', \\'xlsm\\'):\\n    shutil.copy(os.path.join(d, \\'a.xlsx\\'), os.path.join(d, \\'b.\\' + ext))\\n    try:\\n        res.append(openpyxl.load_workbook(os.path.join(d, \\'b.\\' + ext)).sheetnames)\\n    except Exception as e:\\n        res.append(type(e).__name__)\\nout = res')" ; chx:output "['InvalidFileException', 'InvalidFileException', ['Sheet']]" .
chx:X_FileFormats rd:hasIOExample chx:IO_FileFormats .
chx:X_ReadOnlyMode a owl:NamedIndividual, chx:ReadOnlyMode ; rdfs:label "load_workbook('big.xlsx', read_only=True)"@en ; skos:definition "read_only=True opens a workbook in a streaming mode that keeps little in memory; its sheets have no columns attribute, its cells cannot be changed and the workbook cannot be saved."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ReadOnlyMode a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nb = io.BytesIO(); openpyxl.Workbook().save(b)\\nro = openpyxl.load_workbook(io.BytesIO(b.getvalue()), read_only=True); s = ro.active\\ntry:\\n    ro.save(io.BytesIO())\\nexcept TypeError as e:\\n    err = str(e)\\nout = (type(s).__name__, hasattr(s, \\'columns\\'), hasattr(openpyxl.Workbook().active, \\'columns\\'), err)') evaluates to ('ReadOnlyWorksheet', False, True, 'Workbook is read-only')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nb = io.BytesIO(); openpyxl.Workbook().save(b)\\nro = openpyxl.load_workbook(io.BytesIO(b.getvalue()), read_only=True); s = ro.active\\ntry:\\n    ro.save(io.BytesIO())\\nexcept TypeError as e:\\n    err = str(e)\\nout = (type(s).__name__, hasattr(s, \\'columns\\'), hasattr(openpyxl.Workbook().active, \\'columns\\'), err)')" ; chx:output "('ReadOnlyWorksheet', False, True, 'Workbook is read-only')" .
chx:X_ReadOnlyMode rd:hasIOExample chx:IO_ReadOnlyMode .
chx:X_OpenpyxlRelease a owl:NamedIndividual, chx:OpenpyxlRelease ; rdfs:label "pip install openpyxl"@en ; skos:definition "openpyxl is a third-party package, not a part of Python; its newest stable release, 3.1.5, was uploaded on 28 June 2024, and it installs on Python 3.14 with its one dependency, et-xmlfile."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_OpenpyxlRelease a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, importlib.metadata as m\\nout = (openpyxl.__version__, [r.split()[0] for r in m.requires(\\'openpyxl\\')])') evaluates to ('3.1.5', ['et-xmlfile'])"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, importlib.metadata as m\\nout = (openpyxl.__version__, [r.split()[0] for r in m.requires(\\'openpyxl\\')])')" ; chx:output "('3.1.5', ['et-xmlfile'])" .
chx:X_OpenpyxlRelease rd:hasIOExample chx:IO_OpenpyxlRelease .
chx:X_UntrustedFiles a owl:NamedIndividual, chx:UntrustedFiles ; rdfs:label "defusedxml"@en ; skos:definition "An .xlsx file is a zip of XML parts that openpyxl parses without guarding against entity attacks; its documentation says to install defusedxml, and the expat library of Python 3.14.6 refused an expansion of ten million characters from a file of under five kilobytes."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_OtherLibraries a owl:NamedIndividual, chx:OtherLibraries ; rdfs:label "xlsxwriter, xlrd"@en ; skos:definition "XlsxWriter writes .xlsx files but cannot read or modify one, and xlrd 2 reads only the old .xls format, so openpyxl is the module of the chapter that reads and writes .xlsx."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_CellByName a owl:NamedIndividual, chx:CellByName ; rdfs:label "sheet['A1']"@en ; skos:definition "A cell is got by its name in square brackets, its value is in the value attribute, columns start at A and rows at 1."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CellByName a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (repr(s[\\'A1\\'].value), s[\\'B1\\'].value, s[\\'C1\\'].value, repr(s[\\'A1\\']))') evaluates to ('datetime.datetime(2035, 4, 5, 13, 34, 2)', 'Apples', 73, '<Cell 'Sheet1'.A1>')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (repr(s[\\'A1\\'].value), s[\\'B1\\'].value, s[\\'C1\\'].value, repr(s[\\'A1\\']))')" ; chx:output "('datetime.datetime(2035, 4, 5, 13, 34, 2)', 'Apples', 73, '<Cell 'Sheet1'.A1>')" .
chx:X_CellByName rd:hasIOExample chx:IO_CellByName .
chx:X_CellByNumbers a owl:NamedIndividual, chx:CellByNumbers ; rdfs:label "sheet.cell(row=1, column=2)"@en ; skos:definition "cell(row=, column=) gets a cell by two integers that start at 1, which suits loops, and a Cell knows its row, column and coordinate."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CellByNumbers a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\ntry:\\n    s.cell(row=0, column=1)\\nexcept ValueError as e:\\n    err = str(e)\\nc = s[\\'B1\\']\\nout = (s.cell(row=1, column=2).value, c.row, c.column, c.coordinate, [s.cell(row=i, column=2).value for i in range(1, 8, 2)], err)') evaluates to ('Apples', 1, 2, 'B1', ['Apples', 'Pears', 'Apples', 'Strawberries'], 'Row or column values must be at least 1')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\ntry:\\n    s.cell(row=0, column=1)\\nexcept ValueError as e:\\n    err = str(e)\\nc = s[\\'B1\\']\\nout = (s.cell(row=1, column=2).value, c.row, c.column, c.coordinate, [s.cell(row=i, column=2).value for i in range(1, 8, 2)], err)')" ; chx:output "('Apples', 1, 2, 'B1', ['Apples', 'Pears', 'Apples', 'Strawberries'], 'Row or column values must be at least 1')" .
chx:X_CellByNumbers rd:hasIOExample chx:IO_CellByNumbers .
chx:X_CellCreation a owl:NamedIndividual, chx:CellCreation ; rdfs:label "ws.cell(row=100, column=100)"@en ; skos:definition "A worksheet starts with no cells and creates one the first time it is asked for, so a loop that only looks at cells makes them all and enlarges the sheet."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CellCreation a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nbefore = ws.dimensions\\nws[\\'B50\\']\\nout = (before, ws.dimensions, ws.max_row, ws.max_column)') evaluates to ('A1:A1', 'B50:B50', 50, 2)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nbefore = ws.dimensions\\nws[\\'B50\\']\\nout = (before, ws.dimensions, ws.max_row, ws.max_column)')" ; chx:output "('A1:A1', 'B50:B50', 50, 2)" .
chx:X_CellCreation rd:hasIOExample chx:IO_CellCreation .
chx:X_MaxRowColumn a owl:NamedIndividual, chx:MaxRowColumn ; rdfs:label "sheet.max_row, sheet.max_column"@en ; skos:definition "max_row and max_column are integers, the highest row number and the highest column number in use; the column is a number and not the letter that Excel shows."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_MaxRowColumn a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (s.max_row, s.max_column, type(s.max_column).__name__)') evaluates to (7, 3, 'int')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (s.max_row, s.max_column, type(s.max_column).__name__)')" ; chx:output "(7, 3, 'int')" .
chx:X_MaxRowColumn rd:hasIOExample chx:IO_MaxRowColumn .
chx:X_PhantomRows a owl:NamedIndividual, chx:PhantomRows ; rdfs:label "range(2, sheet.max_row + 1)"@en ; skos:definition "A cell that was only touched counts in max_row, so the row loop of Project 9 can run over rows that hold no data, where int(None) raises TypeError."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_PhantomRows a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'D1\\'] = 1; ws[\\'D2\\'] = 5; ws[\\'D40\\']\\ntotal = 0\\ntry:\\n    for r in range(1, ws.max_row + 1):\\n        total += int(ws[\\'D\\' + str(r)].value)\\nexcept TypeError as e:\\n    err = type(e).__name__\\nout = (ws.max_row, err, total)') evaluates to (40, 'TypeError', 6)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'D1\\'] = 1; ws[\\'D2\\'] = 5; ws[\\'D40\\']\\ntotal = 0\\ntry:\\n    for r in range(1, ws.max_row + 1):\\n        total += int(ws[\\'D\\' + str(r)].value)\\nexcept TypeError as e:\\n    err = type(e).__name__\\nout = (ws.max_row, err, total)')" ; chx:output "(40, 'TypeError', 6)" .
chx:X_PhantomRows rd:hasIOExample chx:IO_PhantomRows .
chx:X_ColumnToLetter a owl:NamedIndividual, chx:ColumnToLetter ; rdfs:label "get_column_letter(900)"@en ; skos:definition "get_column_letter turns a column number into the letters Excel shows: 1 is A, 27 is AA and 900 is AHP."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ColumnToLetter a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('from openpyxl.utils import get_column_letter\\nout = [get_column_letter(n) for n in (1, 2, 27, 900)]') evaluates to ['A', 'B', 'AA', 'AHP']"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('from openpyxl.utils import get_column_letter\\nout = [get_column_letter(n) for n in (1, 2, 27, 900)]')" ; chx:output "['A', 'B', 'AA', 'AHP']" .
chx:X_ColumnToLetter rd:hasIOExample chx:IO_ColumnToLetter .
chx:X_LetterToColumn a owl:NamedIndividual, chx:LetterToColumn ; rdfs:label "column_index_from_string('AA')"@en ; skos:definition "column_index_from_string does the reverse, needs no workbook, and reads lower case letters as well."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_LetterToColumn a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('from openpyxl.utils import column_index_from_string\\nout = (column_index_from_string(\\'A\\'), column_index_from_string(\\'AA\\'), column_index_from_string(\\'aa\\'))') evaluates to (1, 27, 27)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('from openpyxl.utils import column_index_from_string\\nout = (column_index_from_string(\\'A\\'), column_index_from_string(\\'AA\\'), column_index_from_string(\\'aa\\'))')" ; chx:output "(1, 27, 27)" .
chx:X_LetterToColumn rd:hasIOExample chx:IO_LetterToColumn .
chx:X_ColumnLimits a owl:NamedIndividual, chx:ColumnLimits ; rdfs:label "get_column_letter(18279)"@en ; skos:definition "The two functions accept columns up to ZZZ, number 18278, which is beyond the last column of Excel, XFD, number 16384, so they do not apply the limit of the application."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ColumnLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('from openpyxl.utils import get_column_letter, column_index_from_string\\ntry:\\n    get_column_letter(18279)\\nexcept ValueError as e:\\n    err = str(e)\\nout = (get_column_letter(16384), get_column_letter(16385), column_index_from_string(\\'XFE\\'), err)') evaluates to ('XFD', 'XFE', 16385, 'Invalid column index 18279')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('from openpyxl.utils import get_column_letter, column_index_from_string\\ntry:\\n    get_column_letter(18279)\\nexcept ValueError as e:\\n    err = str(e)\\nout = (get_column_letter(16384), get_column_letter(16385), column_index_from_string(\\'XFE\\'), err)')" ; chx:output "('XFD', 'XFE', 16385, 'Invalid column index 18279')" .
chx:X_ColumnLimits rd:hasIOExample chx:IO_ColumnLimits .
chx:X_SliceRange a owl:NamedIndividual, chx:SliceRange ; rdfs:label "sheet['A1':'C3']"@en ; skos:definition "A slice of two cell names gives a tuple of rows, each a tuple of the cells of that row, even when the range is a single row."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_SliceRange a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (len(s[\\'A1\\':\\'C3\\']), len(s[\\'A1\\':\\'C3\\'][0]), len(s[\\'A1\\':\\'F1\\']), len(s[\\'A1\\':\\'F1\\'][0]), s[\\'A1\\':\\'C3\\'][2][2].coordinate)') evaluates to (3, 3, 1, 6, 'C3')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = (len(s[\\'A1\\':\\'C3\\']), len(s[\\'A1\\':\\'C3\\'][0]), len(s[\\'A1\\':\\'F1\\']), len(s[\\'A1\\':\\'F1\\'][0]), s[\\'A1\\':\\'C3\\'][2][2].coordinate)')" ; chx:output "(3, 3, 1, 6, 'C3')" .
chx:X_SliceRange rd:hasIOExample chx:IO_SliceRange .
chx:X_RowsAndColumns a owl:NamedIndividual, chx:RowsAndColumns ; rdfs:label "list(sheet.columns)[1]"@en ; skos:definition "The rows and columns attributes are generators, so they are turned into lists before an index is used; the example sheet gives seven rows of three cells and three columns of seven cells."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_RowsAndColumns a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\ntry:\\n    s.columns[1]\\nexcept TypeError as e:\\n    err = str(e)\\nout = (type(s.rows).__name__, len(list(s.rows)), len(list(s.columns)), [c.value for c in list(s.columns)[1]], err)') evaluates to ('generator', 7, 3, ['Apples', 'Cherries', 'Pears', 'Oranges', 'Apples', 'Bananas', 'Strawberries'], ''generator' object is not subscriptable')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\ntry:\\n    s.columns[1]\\nexcept TypeError as e:\\n    err = str(e)\\nout = (type(s.rows).__name__, len(list(s.rows)), len(list(s.columns)), [c.value for c in list(s.columns)[1]], err)')" ; chx:output "('generator', 7, 3, ['Apples', 'Cherries', 'Pears', 'Oranges', 'Apples', 'Bananas', 'Strawberries'], ''generator' object is not subscriptable')" .
chx:X_RowsAndColumns rd:hasIOExample chx:IO_RowsAndColumns .
chx:X_IterRows a owl:NamedIndividual, chx:IterRows ; rdfs:label "sheet.iter_rows(min_row=2, values_only=True)"@en ; skos:definition "iter_rows goes through the rows without naming cells and values_only=True hands out the values themselves, which is the short way to write the chapter's loops."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_IterRows a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = list(s.iter_rows(min_row=2, max_row=3, values_only=True))') evaluates to [(datetime.datetime(2035, 4, 5, 3, 41, 23), 'Cherries', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), 'Pears', 14)]"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws.title = \\'Sheet1\\'\\nfor r in [(datetime.datetime(2035, 4, 5, 13, 34, 2), \\'Apples\\', 73), (datetime.datetime(2035, 4, 5, 3, 41, 23), \\'Cherries\\', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), \\'Pears\\', 14), (datetime.datetime(2035, 4, 8, 8, 59, 43), \\'Oranges\\', 52), (datetime.datetime(2035, 4, 10, 2, 7), \\'Apples\\', 152), (datetime.datetime(2035, 4, 10, 18, 10, 37), \\'Bananas\\', 23), (datetime.datetime(2035, 4, 10, 2, 40, 46), \\'Strawberries\\', 98)]: ws.append(r)\\nwb.create_sheet(\\'Sheet2\\'); wb.create_sheet(\\'Sheet3\\')\\nb = io.BytesIO(); wb.save(b); wb = openpyxl.load_workbook(io.BytesIO(b.getvalue())); s = wb[\\'Sheet1\\']\\nout = list(s.iter_rows(min_row=2, max_row=3, values_only=True))')" ; chx:output "[(datetime.datetime(2035, 4, 5, 3, 41, 23), 'Cherries', 85), (datetime.datetime(2035, 4, 6, 12, 46, 51), 'Pears', 14)]" .
chx:X_IterRows rd:hasIOExample chx:IO_IterRows .
chx:X_DataTypes a owl:NamedIndividual, chx:DataTypes ; rdfs:label "cell.data_type"@en ; skos:definition "A cell holds a number, a text, a Boolean, a date or a formula, openpyxl gives each a one-letter data type, n, s, b, d or f, and refuses a list, a dictionary or a complex number with ValueError."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_DataTypes a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime\\nws = openpyxl.Workbook().active\\nvals = [1, 1.5, \\'text\\', True, datetime.datetime(2035, 4, 5, 13, 34, 2), \\'=1+1\\', \\'123\\']\\nfor k, v in enumerate(vals, 1): ws.cell(row=k, column=1).value = v\\ntry:\\n    ws[\\'B1\\'] = [1, 2]\\nexcept ValueError as e:\\n    err = str(e)\\nout = ([ws.cell(row=k, column=1).data_type for k in range(1, 8)], err)') evaluates to (['n', 'n', 's', 'b', 'd', 'f', 's'], 'Cannot convert [1, 2] to Excel')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime\\nws = openpyxl.Workbook().active\\nvals = [1, 1.5, \\'text\\', True, datetime.datetime(2035, 4, 5, 13, 34, 2), \\'=1+1\\', \\'123\\']\\nfor k, v in enumerate(vals, 1): ws.cell(row=k, column=1).value = v\\ntry:\\n    ws[\\'B1\\'] = [1, 2]\\nexcept ValueError as e:\\n    err = str(e)\\nout = ([ws.cell(row=k, column=1).data_type for k in range(1, 8)], err)')" ; chx:output "(['n', 'n', 's', 'b', 'd', 'f', 's'], 'Cannot convert [1, 2] to Excel')" .
chx:X_DataTypes rd:hasIOExample chx:IO_DataTypes .
chx:X_DatesAsDatetime a owl:NamedIndividual, chx:DatesAsDatetime ; rdfs:label "datetime.datetime(2035, 4, 5, 13, 34, 2)"@en ; skos:definition "Dates are numbers with a date format; openpyxl gives datetime values back, so a date written as a date comes back as a datetime and a text that looks like a date stays text."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_DatesAsDatetime a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws[\\'A1\\'] = datetime.datetime(2035, 4, 5, 13, 34, 2); ws[\\'A2\\'] = datetime.date(2035, 4, 5); ws[\\'A3\\'] = \\'4/5/2035\\'\\nb = io.BytesIO(); wb.save(b); r = openpyxl.load_workbook(io.BytesIO(b.getvalue())).active\\nout = ([type(r[\\'A%d\\' % i].value).__name__ for i in (1, 2, 3)], r[\\'A1\\'].number_format, r[\\'A1\\'].is_date, r[\\'A3\\'].is_date)') evaluates to (['datetime', 'datetime', 'str'], 'yyyy-mm-dd h:mm:ss', True, False)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, datetime, io\\nwb = openpyxl.Workbook(); ws = wb.active; ws[\\'A1\\'] = datetime.datetime(2035, 4, 5, 13, 34, 2); ws[\\'A2\\'] = datetime.date(2035, 4, 5); ws[\\'A3\\'] = \\'4/5/2035\\'\\nb = io.BytesIO(); wb.save(b); r = openpyxl.load_workbook(io.BytesIO(b.getvalue())).active\\nout = ([type(r[\\'A%d\\' % i].value).__name__ for i in (1, 2, 3)], r[\\'A1\\'].number_format, r[\\'A1\\'].is_date, r[\\'A3\\'].is_date)')" ; chx:output "(['datetime', 'datetime', 'str'], 'yyyy-mm-dd h:mm:ss', True, False)" .
chx:X_DatesAsDatetime rd:hasIOExample chx:IO_DatesAsDatetime .
chx:X_NestedTally a owl:NamedIndividual, chx:NestedTally ; rdfs:label "county_data[state][county]['tracts'] += 1"@en ; skos:definition "Project 9 keeps a dictionary of dictionaries, state to county to a dictionary with the keys tracts and pop, and adds one tract and that tract's population for every row."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_NestedTally a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('rows = [(\\'AK\\', \\'Anchorage\\', 4115), (\\'AK\\', \\'Anchorage\\', 3040), (\\'AK\\', \\'Aleutians East\\', 3141), (\\'AL\\', \\'Autauga\\', 1912)]\\ncounty_data = {}\\nfor state, county, pop in rows:\\n    county_data.setdefault(state, {})\\n    county_data[state].setdefault(county, {\\'tracts\\': 0, \\'pop\\': 0})\\n    county_data[state][county][\\'tracts\\'] += 1\\n    county_data[state][county][\\'pop\\'] += int(pop)\\nout = county_data', g), g['out'])[1])({}) evaluates to {'AK': {'Anchorage': {'tracts': 2, 'pop': 7155}, 'Aleutians East': {'tracts': 1, 'pop': 3141}}, 'AL': {'Autauga': {'tracts': 1, 'pop': 1912}}}"@en ; chx:input "(lambda g: (exec('rows = [(\\'AK\\', \\'Anchorage\\', 4115), (\\'AK\\', \\'Anchorage\\', 3040), (\\'AK\\', \\'Aleutians East\\', 3141), (\\'AL\\', \\'Autauga\\', 1912)]\\ncounty_data = {}\\nfor state, county, pop in rows:\\n    county_data.setdefault(state, {})\\n    county_data[state].setdefault(county, {\\'tracts\\': 0, \\'pop\\': 0})\\n    county_data[state][county][\\'tracts\\'] += 1\\n    county_data[state][county][\\'pop\\'] += int(pop)\\nout = county_data', g), g['out'])[1])({})" ; chx:output "{'AK': {'Anchorage': {'tracts': 2, 'pop': 7155}, 'Aleutians East': {'tracts': 1, 'pop': 3141}}, 'AL': {'Autauga': {'tracts': 1, 'pop': 1912}}}" .
chx:X_NestedTally rd:hasIOExample chx:IO_NestedTally .
chx:X_SetdefaultCall a owl:NamedIndividual, chx:SetdefaultCall ; rdfs:label "county_data.setdefault(state, {})"@en ; skos:definition "setdefault inserts a key with a default only when the key is missing and always returns the value, so the loop can call it on every row, and without it the first row of a state raises KeyError."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_SetdefaultCall a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('d = {}\\ntry:\\n    d[\\'AK\\'][\\'Anchorage\\'][\\'tracts\\'] += 1\\nexcept KeyError as e:\\n    err = repr(e)\\nfirst = d.setdefault(\\'AK\\', {})\\nfirst[\\'x\\'] = 1\\nout = (err, d.setdefault(\\'AK\\', {}) is first, d)', g), g['out'])[1])({}) evaluates to ('KeyError('AK')', True, {'AK': {'x': 1}})"@en ; chx:input "(lambda g: (exec('d = {}\\ntry:\\n    d[\\'AK\\'][\\'Anchorage\\'][\\'tracts\\'] += 1\\nexcept KeyError as e:\\n    err = repr(e)\\nfirst = d.setdefault(\\'AK\\', {})\\nfirst[\\'x\\'] = 1\\nout = (err, d.setdefault(\\'AK\\', {}) is first, d)', g), g['out'])[1])({})" ; chx:output "('KeyError('AK')', True, {'AK': {'x': 1}})" .
chx:X_SetdefaultCall rd:hasIOExample chx:IO_SetdefaultCall .
chx:X_ResultFile a owl:NamedIndividual, chx:ResultFile ; rdfs:label "pprint.pformat(county_data)"@en ; skos:definition "pprint.pformat returns a dictionary as text that is valid Python and sorted by key, so a program can write it into a .py file; the real census data comes out with its states in alphabetical order."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ResultFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import pprint, ast\\nd = {\\'b\\': {\\'y\\': 2, \\'x\\': 1}, \\'a\\': {\\'pop\\': 5, \\'tracts\\': 1}}\\ntxt = pprint.pformat(d)\\nout = (txt, pprint.pformat(d, sort_dicts=False), ast.literal_eval(txt) == d)', g), g['out'])[1])({}) evaluates to ('{'a': {'pop': 5, 'tracts': 1}, 'b': {'x': 1, 'y': 2}}', '{'b': {'y': 2, 'x': 1}, 'a': {'pop': 5, 'tracts': 1}}', True)"@en ; chx:input "(lambda g: (exec('import pprint, ast\\nd = {\\'b\\': {\\'y\\': 2, \\'x\\': 1}, \\'a\\': {\\'pop\\': 5, \\'tracts\\': 1}}\\ntxt = pprint.pformat(d)\\nout = (txt, pprint.pformat(d, sort_dicts=False), ast.literal_eval(txt) == d)', g), g['out'])[1])({})" ; chx:output "('{'a': {'pop': 5, 'tracts': 1}, 'b': {'x': 1, 'y': 2}}', '{'b': {'y': 2, 'x': 1}, 'a': {'pop': 5, 'tracts': 1}}', True)" .
chx:X_ResultFile rd:hasIOExample chx:IO_ResultFile .
chx:X_ImportResult a owl:NamedIndividual, chx:ImportResult ; rdfs:label "import census2010"@en ; skos:definition "A .py file written by a program can be imported like any module when its folder is on sys.path, which for a script is the folder of the script and for the interactive shell the current folder; importing runs the file, whereas ast.literal_eval only reads a literal."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ImportResult a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import os, sys, tempfile\\nd = tempfile.mkdtemp()\\nopen(os.path.join(d, \\'census2010.py\\'), \\'w\\').write(\\'allData = \\' + repr({\\'AK\\': {\\'Anchorage\\': {\\'pop\\': 291826, \\'tracts\\': 55}}}))\\nsys.path.insert(0, d)\\nimport census2010\\nok = census2010.allData[chr(65)+chr(75)]\\nsys.path.remove(d); del sys.modules[\\'census2010\\']\\ntry:\\n    import census2010\\n    no = \\'imported\\'\\nexcept ModuleNotFoundError as e:\\n    no = \\'ModuleNotFoundError: \\' + str(e)\\nout = (ok, no)', g), g['out'])[1])({}) evaluates to ({'Anchorage': {'pop': 291826, 'tracts': 55}}, 'ModuleNotFoundError: No module named 'census2010'')"@en ; chx:input "(lambda g: (exec('import os, sys, tempfile\\nd = tempfile.mkdtemp()\\nopen(os.path.join(d, \\'census2010.py\\'), \\'w\\').write(\\'allData = \\' + repr({\\'AK\\': {\\'Anchorage\\': {\\'pop\\': 291826, \\'tracts\\': 55}}}))\\nsys.path.insert(0, d)\\nimport census2010\\nok = census2010.allData[chr(65)+chr(75)]\\nsys.path.remove(d); del sys.modules[\\'census2010\\']\\ntry:\\n    import census2010\\n    no = \\'imported\\'\\nexcept ModuleNotFoundError as e:\\n    no = \\'ModuleNotFoundError: \\' + str(e)\\nout = (ok, no)', g), g['out'])[1])({})" ; chx:output "({'Anchorage': {'pop': 291826, 'tracts': 55}}, 'ModuleNotFoundError: No module named 'census2010'')" .
chx:X_ImportResult rd:hasIOExample chx:IO_ImportResult .
chx:X_ShippedScript a owl:NamedIndividual, chx:ShippedScript ; rdfs:label "wb.get_sheet_by_name, sheet.get_highest_row()"@en ; skos:definition "The readCensusExcel.py in the book's online materials still uses the old names wb.get_sheet_by_name, which only warns, and sheet.get_highest_row(), which no longer exists, so it stops after printing Reading rows; the listing in the chapter uses wb[...] and max_row."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ShippedScript a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nout = (hasattr(ws, \\'get_highest_row\\'), hasattr(openpyxl.Workbook(), \\'get_sheet_by_name\\'), hasattr(ws, \\'max_row\\'))') evaluates to (False, True, True)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nout = (hasattr(ws, \\'get_highest_row\\'), hasattr(openpyxl.Workbook(), \\'get_sheet_by_name\\'), hasattr(ws, \\'max_row\\'))')" ; chx:output "(False, True, True)" .
chx:X_ShippedScript rd:hasIOExample chx:IO_ShippedScript .
chx:X_PriceDictionary a owl:NamedIndividual, chx:PriceDictionary ; rdfs:label "PRICE_UPDATES = {'Garlic': 3.07, 'Celery': 1.19, 'Lemon': 1.27}"@en ; skos:definition "Project 10 keeps the corrected prices in a dictionary at the top of the program, so the loop needs one if statement and a new correction changes data and not code."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_PriceDictionary a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('PRICE_UPDATES = {\\'Garlic\\': 3.07, \\'Celery\\': 1.19, \\'Lemon\\': 1.27}\\nrows = [[\\'Potatoes\\', 0.86], [\\'Garlic\\', 1.19], [\\'Celery\\', 3.07], [\\'Lemon\\', 1.29], [\\'Okra\\', 2.26]]\\nfor row in rows:\\n    if row[0] in PRICE_UPDATES:\\n        row[1] = PRICE_UPDATES[row[0]]\\nout = rows', g), g['out'])[1])({}) evaluates to [['Potatoes', 0.86], ['Garlic', 3.07], ['Celery', 1.19], ['Lemon', 1.27], ['Okra', 2.26]]"@en ; chx:input "(lambda g: (exec('PRICE_UPDATES = {\\'Garlic\\': 3.07, \\'Celery\\': 1.19, \\'Lemon\\': 1.27}\\nrows = [[\\'Potatoes\\', 0.86], [\\'Garlic\\', 1.19], [\\'Celery\\', 3.07], [\\'Lemon\\', 1.29], [\\'Okra\\', 2.26]]\\nfor row in rows:\\n    if row[0] in PRICE_UPDATES:\\n        row[1] = PRICE_UPDATES[row[0]]\\nout = rows', g), g['out'])[1])({})" ; chx:output "[['Potatoes', 0.86], ['Garlic', 3.07], ['Celery', 1.19], ['Lemon', 1.27], ['Okra', 2.26]]" .
chx:X_PriceDictionary rd:hasIOExample chx:IO_PriceDictionary .
chx:X_UpdateLoop a owl:NamedIndividual, chx:UpdateLoop ; rdfs:label "for row_num in range(2, sheet.max_row + 1)"@en ; skos:definition "The loop starts at row 2 to skip the header, reads column 1 with cell() and writes column 2 only for names in the dictionary; with range(2, max_row) the last row would be left out."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_UpdateLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nwb = openpyxl.Workbook(); sheet = wb.active\\nfor r in [(\\'PRODUCE\\', \\'COST\\'), (\\'Garlic\\', 1.19), (\\'Okra\\', 2.26), (\\'Garlic\\', 1.19)]: sheet.append(r)\\nPRICE_UPDATES = {\\'Garlic\\': 3.07}\\ndef run(stop):\\n    for row_num in range(2, stop):\\n        if sheet.cell(row=row_num, column=1).value in PRICE_UPDATES:\\n            sheet.cell(row=row_num, column=2).value = PRICE_UPDATES[sheet.cell(row=row_num, column=1).value]\\n    return [sheet.cell(row=r, column=2).value for r in range(2, sheet.max_row + 1)]\\nshort = run(sheet.max_row)\\nfull = run(sheet.max_row + 1)\\nout = (short, full)') evaluates to ([3.07, 2.26, 1.19], [3.07, 2.26, 3.07])"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nwb = openpyxl.Workbook(); sheet = wb.active\\nfor r in [(\\'PRODUCE\\', \\'COST\\'), (\\'Garlic\\', 1.19), (\\'Okra\\', 2.26), (\\'Garlic\\', 1.19)]: sheet.append(r)\\nPRICE_UPDATES = {\\'Garlic\\': 3.07}\\ndef run(stop):\\n    for row_num in range(2, stop):\\n        if sheet.cell(row=row_num, column=1).value in PRICE_UPDATES:\\n            sheet.cell(row=row_num, column=2).value = PRICE_UPDATES[sheet.cell(row=row_num, column=1).value]\\n    return [sheet.cell(row=r, column=2).value for r in range(2, sheet.max_row + 1)]\\nshort = run(sheet.max_row)\\nfull = run(sheet.max_row + 1)\\nout = (short, full)')" ; chx:output "([3.07, 2.26, 1.19], [3.07, 2.26, 3.07])" .
chx:X_UpdateLoop rd:hasIOExample chx:IO_UpdateLoop .
chx:X_CachedValueLoss a owl:NamedIndividual, chx:CachedValueLoss ; rdfs:label "load_workbook('updatedProduceSales3.xlsx', data_only=True)"@en ; skos:definition "A workbook that openpyxl saved keeps the formulas but not the results Excel had stored for them, so the TOTAL cells read as None after Project 10 saves its copy, until a spreadsheet program opens and saves the copy again."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CachedValueLoss a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile\\nsrc = openpyxl.Workbook(); src.active[\\'A1\\'] = 200; src.active[\\'A2\\'] = 300; src.active[\\'A3\\'] = \\'=SUM(A1:A2)\\'; b = io.BytesIO(); src.save(b)\\nzin = zipfile.ZipFile(io.BytesIO(b.getvalue())); o = io.BytesIO(); zo = zipfile.ZipFile(o, \\'w\\')\\nfor n in zin.namelist():\\n    t = zin.read(n)\\n    zo.writestr(n, t.replace(b\\'<f>SUM(A1:A2)</f><v />\\', b\\'<f>SUM(A1:A2)</f><v>500</v>\\') if n.startswith(\\'xl/worksheets/\\') else t)\\nzo.close()\\nwith_cache = openpyxl.load_workbook(io.BytesIO(o.getvalue()), data_only=True)\\nsaved = io.BytesIO(); openpyxl.load_workbook(io.BytesIO(o.getvalue())).save(saved)\\nout = (with_cache.active[\\'A3\\'].value, openpyxl.load_workbook(io.BytesIO(saved.getvalue()), data_only=True).active[\\'A3\\'].value)') evaluates to (500, None)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile\\nsrc = openpyxl.Workbook(); src.active[\\'A1\\'] = 200; src.active[\\'A2\\'] = 300; src.active[\\'A3\\'] = \\'=SUM(A1:A2)\\'; b = io.BytesIO(); src.save(b)\\nzin = zipfile.ZipFile(io.BytesIO(b.getvalue())); o = io.BytesIO(); zo = zipfile.ZipFile(o, \\'w\\')\\nfor n in zin.namelist():\\n    t = zin.read(n)\\n    zo.writestr(n, t.replace(b\\'<f>SUM(A1:A2)</f><v />\\', b\\'<f>SUM(A1:A2)</f><v>500</v>\\') if n.startswith(\\'xl/worksheets/\\') else t)\\nzo.close()\\nwith_cache = openpyxl.load_workbook(io.BytesIO(o.getvalue()), data_only=True)\\nsaved = io.BytesIO(); openpyxl.load_workbook(io.BytesIO(o.getvalue())).save(saved)\\nout = (with_cache.active[\\'A3\\'].value, openpyxl.load_workbook(io.BytesIO(saved.getvalue()), data_only=True).active[\\'A3\\'].value)')" ; chx:output "(500, None)" .
chx:X_CachedValueLoss rd:hasIOExample chx:IO_CachedValueLoss .
chx:X_MultiplicationTable a owl:NamedIndividual, chx:MultiplicationTable ; rdfs:label "sheet.cell(row=i + 1, column=j + 1, value=i * j)"@en ; skos:definition "The multiplication table of N puts the labels 1 to N in bold along row 1 from B1 and down column A from A2, with the products inside, so the table for 6 spans A1 to G7."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_MultiplicationTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.styles import Font\\nn = 6; wb = openpyxl.Workbook(); sheet = wb.active; bold = Font(bold=True)\\nfor i in range(1, n + 1):\\n    sheet.cell(row=1, column=i + 1, value=i).font = bold\\n    sheet.cell(row=i + 1, column=1, value=i).font = bold\\n    for j in range(1, n + 1):\\n        sheet.cell(row=i + 1, column=j + 1, value=i * j)\\nout = (sheet.dimensions, sheet[\\'D5\\'].value, sheet[\\'G7\\'].value, sheet[\\'A1\\'].value, sheet[\\'B1\\'].font.b, sheet[\\'B2\\'].font.b)') evaluates to ('A1:G7', 12, 36, None, True, False)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.styles import Font\\nn = 6; wb = openpyxl.Workbook(); sheet = wb.active; bold = Font(bold=True)\\nfor i in range(1, n + 1):\\n    sheet.cell(row=1, column=i + 1, value=i).font = bold\\n    sheet.cell(row=i + 1, column=1, value=i).font = bold\\n    for j in range(1, n + 1):\\n        sheet.cell(row=i + 1, column=j + 1, value=i * j)\\nout = (sheet.dimensions, sheet[\\'D5\\'].value, sheet[\\'G7\\'].value, sheet[\\'A1\\'].value, sheet[\\'B1\\'].font.b, sheet[\\'B2\\'].font.b)')" ; chx:output "('A1:G7', 12, 36, None, True, False)" .
chx:X_MultiplicationTable rd:hasIOExample chx:IO_MultiplicationTable .
chx:X_BlankRowInserter a owl:NamedIndividual, chx:BlankRowInserter ; rdfs:label "sheet.insert_rows(3, 2)"@en ; skos:definition "insert_rows(idx, amount) inserts blank rows before row idx and moves the cells below it down, with their values and styles; Blank Row Inserter reads N, M and a file name from the command line and makes that one call."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_BlankRowInserter a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nfor r, v in enumerate([\\'Potatoes\\', \\'Okra\\', \\'Fava beans\\', \\'Watermelon\\', \\'Garlic\\', \\'Parsnips\\'], 1): ws.cell(row=r, column=1, value=v)\\nws.insert_rows(3, 2)\\nout = [c.value for c in ws[\\'A\\']]') evaluates to ['Potatoes', 'Okra', None, None, 'Fava beans', 'Watermelon', 'Garlic', 'Parsnips']"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nfor r, v in enumerate([\\'Potatoes\\', \\'Okra\\', \\'Fava beans\\', \\'Watermelon\\', \\'Garlic\\', \\'Parsnips\\'], 1): ws.cell(row=r, column=1, value=v)\\nws.insert_rows(3, 2)\\nout = [c.value for c in ws[\\'A\\']]')" ; chx:output "['Potatoes', 'Okra', None, None, 'Fava beans', 'Watermelon', 'Garlic', 'Parsnips']" .
chx:X_BlankRowInserter rd:hasIOExample chx:IO_BlankRowInserter .
chx:X_InsertRowsLimits a owl:NamedIndividual, chx:InsertRowsLimits ; rdfs:label "'=SUM(B1:B5)' is still '=SUM(B1:B5)'"@en ; skos:definition "insert_rows moves cells but does not rewrite formula references, merged ranges or row heights, so a sheet with formulas, merged cells or custom heights needs more than the chapter's one call."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_InsertRowsLimits a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nfor r in range(1, 7): ws.cell(row=r, column=2, value=r * 10)\\nws[\\'C6\\'] = \\'=SUM(B1:B5)\\'; ws.merge_cells(\\'A5:B5\\'); ws.row_dimensions[4].height = 50\\nws.insert_rows(3, 2)\\nout = (ws[\\'C8\\'].value, ws[\\'C6\\'].value, sorted(map(str, ws.merged_cells.ranges)), ws.row_dimensions[4].height, ws.row_dimensions[6].height)') evaluates to ('=SUM(B1:B5)', None, ['A5:B5'], 50.0, None)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nfor r in range(1, 7): ws.cell(row=r, column=2, value=r * 10)\\nws[\\'C6\\'] = \\'=SUM(B1:B5)\\'; ws.merge_cells(\\'A5:B5\\'); ws.row_dimensions[4].height = 50\\nws.insert_rows(3, 2)\\nout = (ws[\\'C8\\'].value, ws[\\'C6\\'].value, sorted(map(str, ws.merged_cells.ranges)), ws.row_dimensions[4].height, ws.row_dimensions[6].height)')" ; chx:output "('=SUM(B1:B5)', None, ['A5:B5'], 50.0, None)" .
chx:X_InsertRowsLimits rd:hasIOExample chx:IO_InsertRowsLimits .
chx:X_CommandLineNumbers a owl:NamedIndividual, chx:CommandLineNumbers ; rdfs:label "int(sys.argv[1])"@en ; skos:definition "The practice programs take their numbers from sys.argv, a list of strings with the script name first, so int() converts them and a missing argument raises IndexError."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CommandLineNumbers a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('argv = [\\'blankRowInserter.py\\', \\'3\\', \\'2\\', \\'myProduce.xlsx\\']\\nn, m, filename = int(argv[1]), int(argv[2]), argv[3]\\ntry:\\n    int([\\'multiplicationTable.py\\'][1])\\nexcept IndexError as e:\\n    err = str(e)\\nout = (n, m, filename, err)', g), g['out'])[1])({}) evaluates to (3, 2, 'myProduce.xlsx', 'list index out of range')"@en ; chx:input "(lambda g: (exec('argv = [\\'blankRowInserter.py\\', \\'3\\', \\'2\\', \\'myProduce.xlsx\\']\\nn, m, filename = int(argv[1]), int(argv[2]), argv[3]\\ntry:\\n    int([\\'multiplicationTable.py\\'][1])\\nexcept IndexError as e:\\n    err = str(e)\\nout = (n, m, filename, err)', g), g['out'])[1])({})" ; chx:output "(3, 2, 'myProduce.xlsx', 'list index out of range')" .
chx:X_CommandLineNumbers rd:hasIOExample chx:IO_CommandLineNumbers .
chx:X_FormulaString a owl:NamedIndividual, chx:FormulaString ; rdfs:label "sheet['A3'] = '=SUM(A1:A2)'"@en ; skos:definition "A formula is stored by assigning text that begins with an equal sign; openpyxl marks the cell as type f, does not evaluate it and does not check that the function exists."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_FormulaString a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = 200; ws[\\'A2\\'] = 300; ws[\\'A3\\'] = \\'=SUM(A1:A2)\\'; ws[\\'A4\\'] = \\'=NOSUCHFUNCTION(1)\\'\\nout = (ws[\\'A3\\'].data_type, ws[\\'A3\\'].value, ws[\\'A4\\'].data_type, ws[\\'A1\\'].data_type)') evaluates to ('f', '=SUM(A1:A2)', 'f', 'n')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = 200; ws[\\'A2\\'] = 300; ws[\\'A3\\'] = \\'=SUM(A1:A2)\\'; ws[\\'A4\\'] = \\'=NOSUCHFUNCTION(1)\\'\\nout = (ws[\\'A3\\'].data_type, ws[\\'A3\\'].value, ws[\\'A4\\'].data_type, ws[\\'A1\\'].data_type)')" ; chx:output "('f', '=SUM(A1:A2)', 'f', 'n')" .
chx:X_FormulaString rd:hasIOExample chx:IO_FormulaString .
chx:X_ReadFormulaBack a owl:NamedIndividual, chx:ReadFormulaBack ; rdfs:label "load_workbook('writeFormula3.xlsx')"@en ; skos:definition "Loaded as usual, a formula cell gives back its formula text; loaded with data_only=True the same cell gives the value a spreadsheet program stored, or None when none did."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ReadFormulaBack a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = 200; ws[\\'A2\\'] = 300; ws[\\'A3\\'] = \\'=SUM(A1:A2)\\'\\nb = io.BytesIO(); ws.parent.save(b)\\nout = (openpyxl.load_workbook(io.BytesIO(b.getvalue())).active[\\'A3\\'].value, openpyxl.load_workbook(io.BytesIO(b.getvalue()), data_only=True).active[\\'A3\\'].value)') evaluates to ('=SUM(A1:A2)', None)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = 200; ws[\\'A2\\'] = 300; ws[\\'A3\\'] = \\'=SUM(A1:A2)\\'\\nb = io.BytesIO(); ws.parent.save(b)\\nout = (openpyxl.load_workbook(io.BytesIO(b.getvalue())).active[\\'A3\\'].value, openpyxl.load_workbook(io.BytesIO(b.getvalue()), data_only=True).active[\\'A3\\'].value)')" ; chx:output "('=SUM(A1:A2)', None)" .
chx:X_ReadFormulaBack rd:hasIOExample chx:IO_ReadFormulaBack .
chx:X_DataOnly a owl:NamedIndividual, chx:DataOnly ; rdfs:label "load_workbook(..., data_only=True)"@en ; skos:definition "data_only=True chooses between the formula and the value stored at the last save by a spreadsheet program; it never calculates, so a file whose formulas were never calculated gives None for every formula cell."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_DataOnly a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = 5; ws[\\'A2\\'] = \\'=A1*2\\'\\nb = io.BytesIO(); ws.parent.save(b)\\nw = openpyxl.load_workbook(io.BytesIO(b.getvalue()), data_only=True).active\\nout = (w[\\'A1\\'].value, w[\\'A2\\'].value)') evaluates to (5, None)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = 5; ws[\\'A2\\'] = \\'=A1*2\\'\\nb = io.BytesIO(); ws.parent.save(b)\\nw = openpyxl.load_workbook(io.BytesIO(b.getvalue()), data_only=True).active\\nout = (w[\\'A1\\'].value, w[\\'A2\\'].value)')" ; chx:output "(5, None)" .
chx:X_DataOnly rd:hasIOExample chx:IO_DataOnly .
chx:X_RecalcByOffice a owl:NamedIndividual, chx:RecalcByOffice ; rdfs:label "soffice --headless --convert-to xlsx"@en ; skos:definition "The calculation is done by a spreadsheet program: LibreOffice, run headless on the saved file, stored 500 for the chapter's =SUM(A1:A2), which is the step the chapter gives to Excel before data_only=True is used."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_WriterCachedValue a owl:NamedIndividual, chx:WriterCachedValue ; rdfs:label "xlsxwriter write_formula"@en ; skos:definition "XlsxWriter stores the value 0 as the result of a formula unless it is given another, and sets a flag that makes the application recalculate on opening, so data_only=True reads 0 from a file that never held a calculated total."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_RoundingDiffers a owl:NamedIndividual, chx:RoundingDiffers ; rdfs:label "=ROUND(B2*C2, 2) against round(b * c, 2)"@en ; skos:definition "A spreadsheet's ROUND and Python's round can disagree on an exact half: on the real produce file Excel's stored total differs from Python's in 629 of 23,757 rows, because Python rounds the binary value its float holds and 1.89 times 34.5 is held a hair under 65.205."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_RoundingDiffers a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda g: (exec('import decimal\\nx = 1.89 * 34.5\\nout = (repr(x), round(x, 2), decimal.Decimal(x) < decimal.Decimal(\\'65.205\\'), round(32.915, 2), round(19.305, 2))', g), g['out'])[1])({}) evaluates to ('65.205', 65.2, True, 32.91, 19.3)"@en ; chx:input "(lambda g: (exec('import decimal\\nx = 1.89 * 34.5\\nout = (repr(x), round(x, 2), decimal.Decimal(x) < decimal.Decimal(\\'65.205\\'), round(32.915, 2), round(19.305, 2))', g), g['out'])[1])({})" ; chx:output "('65.205', 65.2, True, 32.91, 19.3)" .
chx:X_RoundingDiffers rd:hasIOExample chx:IO_RoundingDiffers .
chx:X_FontObject a owl:NamedIndividual, chx:FontObject ; rdfs:label "Font(size=24, italic=True)"@en ; skos:definition "A Font object holds styling, is made with keyword arguments and is assigned to a cell's font attribute; a value assigned to the cell afterwards keeps the font."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_FontObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.styles import Font\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'].font = Font(size=24, italic=True)\\nws[\\'A1\\'] = \\'Hello, world!\\'\\nout = (ws[\\'A1\\'].font.size, ws[\\'A1\\'].font.i, ws[\\'A1\\'].font.b, ws[\\'A1\\'].value)') evaluates to (24.0, True, False, 'Hello, world!')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.styles import Font\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'].font = Font(size=24, italic=True)\\nws[\\'A1\\'] = \\'Hello, world!\\'\\nout = (ws[\\'A1\\'].font.size, ws[\\'A1\\'].font.i, ws[\\'A1\\'].font.b, ws[\\'A1\\'].value)')" ; chx:output "(24.0, True, False, 'Hello, world!')" .
chx:X_FontObject rd:hasIOExample chx:IO_FontObject .
chx:X_FontKeywords a owl:NamedIndividual, chx:FontKeywords ; rdfs:label "Font(name='Times New Roman', bold=True)"@en ; skos:definition "Table 14-2 lists name, size, bold and italic; Font also takes the short names sz, b and i, accepts bold='yes' as true without complaint, and refuses size='big' with TypeError."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_FontKeywords a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('from openpyxl.styles import Font\\nf = Font(name=\\'Times New Roman\\', bold=True)\\ntry:\\n    Font(size=\\'big\\')\\nexcept TypeError as e:\\n    err = str(e)\\nout = (f.name, f.b, f.sz, Font(sz=12, b=True, i=True).size, Font(bold=\\'yes\\').b, err)') evaluates to ('Times New Roman', True, None, 12.0, True, 'expected <class 'float'>')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('from openpyxl.styles import Font\\nf = Font(name=\\'Times New Roman\\', bold=True)\\ntry:\\n    Font(size=\\'big\\')\\nexcept TypeError as e:\\n    err = str(e)\\nout = (f.name, f.b, f.sz, Font(sz=12, b=True, i=True).size, Font(bold=\\'yes\\').b, err)')" ; chx:output "('Times New Roman', True, None, 12.0, True, 'expected <class 'float'>')" .
chx:X_FontKeywords rd:hasIOExample chx:IO_FontKeywords .
chx:X_FontDefaults a owl:NamedIndividual, chx:FontDefaults ; rdfs:label "Font(size=24, italic=True).name is None"@en ; skos:definition "A Font made without a name or size writes neither into the file, so the book's default of Calibri 11 holds for untouched cells while a cell with such a font is drawn in whatever the application chooses, which LibreOffice 24.2 drew in Caladea."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_FontDefaults a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.styles import Font\\nws = openpyxl.Workbook().active\\nf = Font(size=24, italic=True)\\nout = (f.name, f.sz, ws[\\'C5\\'].font.name, ws[\\'C5\\'].font.sz)') evaluates to (None, 24.0, 'Calibri', 11.0)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.styles import Font\\nws = openpyxl.Workbook().active\\nf = Font(size=24, italic=True)\\nout = (f.name, f.sz, ws[\\'C5\\'].font.name, ws[\\'C5\\'].font.sz)')" ; chx:output "(None, 24.0, 'Calibri', 11.0)" .
chx:X_FontDefaults rd:hasIOExample chx:IO_FontDefaults .
chx:X_StyleImmutable a owl:NamedIndividual, chx:StyleImmutable ; rdfs:label "cell.font.bold = False"@en ; skos:definition "Style objects are shared between cells and cannot be changed in place: assigning to one attribute raises AttributeError, and the style must be replaced by a new Font assigned to the cell."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_StyleImmutable a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.styles import Font\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'].font = Font(bold=True)\\ntry:\\n    ws[\\'A1\\'].font.bold = False\\nexcept AttributeError as e:\\n    err = str(e)\\nws[\\'A1\\'].font = Font(bold=False)\\nout = (err[:36], ws[\\'A1\\'].font.b)') evaluates to ('Style objects are immutable and cann', False)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.styles import Font\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'].font = Font(bold=True)\\ntry:\\n    ws[\\'A1\\'].font.bold = False\\nexcept AttributeError as e:\\n    err = str(e)\\nws[\\'A1\\'].font = Font(bold=False)\\nout = (err[:36], ws[\\'A1\\'].font.b)')" ; chx:output "('Style objects are immutable and cann', False)" .
chx:X_StyleImmutable rd:hasIOExample chx:IO_StyleImmutable .
chx:X_RowHeight a owl:NamedIndividual, chx:RowHeight ; rdfs:label "sheet.row_dimensions[1].height = 70"@en ; skos:definition "row_dimensions and column_dimensions are dictionary-like holders; a row is addressed by its number, a column by its letter."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_RowHeight a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = \\'Tall row\\'; ws.row_dimensions[1].height = 70\\nout = (type(ws.row_dimensions).__name__, type(ws.row_dimensions[1]).__name__, ws.row_dimensions[1].height, ws.row_dimensions[2].height)') evaluates to ('DimensionHolder', 'RowDimension', 70.0, None)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = \\'Tall row\\'; ws.row_dimensions[1].height = 70\\nout = (type(ws.row_dimensions).__name__, type(ws.row_dimensions[1]).__name__, ws.row_dimensions[1].height, ws.row_dimensions[2].height)')" ; chx:output "('DimensionHolder', 'RowDimension', 70.0, None)" .
chx:X_RowHeight rd:hasIOExample chx:IO_RowHeight .
chx:X_ColumnWidth a owl:NamedIndividual, chx:ColumnWidth ; rdfs:label "sheet.column_dimensions['B'].width = 20"@en ; skos:definition "A column width is set through the dimension of that letter; a column left alone reads as 13 in openpyxl although the file records no width for it."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ColumnWidth a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'B2\\'] = \\'Wide column\\'; ws.column_dimensions[\\'B\\'].width = 20\\nout = (type(ws.column_dimensions[\\'B\\']).__name__, ws.column_dimensions[\\'B\\'].width, ws.column_dimensions[\\'A\\'].width)') evaluates to ('ColumnDimension', 20.0, 13.0)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'B2\\'] = \\'Wide column\\'; ws.column_dimensions[\\'B\\'].width = 20\\nout = (type(ws.column_dimensions[\\'B\\']).__name__, ws.column_dimensions[\\'B\\'].width, ws.column_dimensions[\\'A\\'].width)')" ; chx:output "('ColumnDimension', 20.0, 13.0)" .
chx:X_ColumnWidth rd:hasIOExample chx:IO_ColumnWidth .
chx:X_DimensionReadCreates a owl:NamedIndividual, chx:DimensionReadCreates ; rdfs:label "len(sheet.row_dimensions)"@en ; skos:definition "Reading a dimension creates it: looking at row_dimensions[3].height adds a row that is saved as an empty row element, and looking at column_dimensions['A'].width adds a column entry that is saved with a custom width of 13."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_DimensionReadCreates a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile\\nws = openpyxl.Workbook().active; ws[\\'A1\\'] = \\'x\\'\\nbefore = (len(ws.row_dimensions), len(ws.column_dimensions))\\nws.row_dimensions[3].height; ws.column_dimensions[\\'A\\'].width\\nb = io.BytesIO(); ws.parent.save(b); xml = zipfile.ZipFile(b).read(\\'xl/worksheets/sheet1.xml\\').decode()\\nout = (before, (len(ws.row_dimensions), len(ws.column_dimensions)), (\\'<row r=\\' + chr(34) + \\'3\\' + chr(34) + \\'>\\') in xml, (\\'customWidth=\\' + chr(34) + \\'1\\' + chr(34)) in xml)') evaluates to ((0, 0), (1, 1), True, True)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile\\nws = openpyxl.Workbook().active; ws[\\'A1\\'] = \\'x\\'\\nbefore = (len(ws.row_dimensions), len(ws.column_dimensions))\\nws.row_dimensions[3].height; ws.column_dimensions[\\'A\\'].width\\nb = io.BytesIO(); ws.parent.save(b); xml = zipfile.ZipFile(b).read(\\'xl/worksheets/sheet1.xml\\').decode()\\nout = (before, (len(ws.row_dimensions), len(ws.column_dimensions)), (\\'<row r=\\' + chr(34) + \\'3\\' + chr(34) + \\'>\\') in xml, (\\'customWidth=\\' + chr(34) + \\'1\\' + chr(34)) in xml)')" ; chx:output "((0, 0), (1, 1), True, True)" .
chx:X_DimensionReadCreates rd:hasIOExample chx:IO_DimensionReadCreates .
chx:X_HidingRowsColumns a owl:NamedIndividual, chx:HidingRowsColumns ; rdfs:label "sheet.column_dimensions['C'].hidden = True"@en ; skos:definition "The chapter says rows and columns can be hidden and its Practice Question 16 asks how, but it never shows it; the hidden attribute of the dimension does it, and the file records hidden=1."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_HidingRowsColumns a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = \\'x\\'; ws.column_dimensions[\\'C\\'].hidden = True; ws.row_dimensions[5].hidden = True\\nb = io.BytesIO(); ws.parent.save(b); xml = zipfile.ZipFile(b).read(\\'xl/worksheets/sheet1.xml\\').decode()\\nimport re\\nout = (ws.column_dimensions[\\'C\\'].hidden, re.findall(\\'<col [^>]*hidden=.1.[^>]*>\\', xml), re.findall(\\'<row r=.5.[^>]*>\\', xml))') evaluates to (True, ['<col hidden='1' width='13' customWidth='1' min='3' max='3' />'], ['<row r='5' hidden='1'>'])"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = \\'x\\'; ws.column_dimensions[\\'C\\'].hidden = True; ws.row_dimensions[5].hidden = True\\nb = io.BytesIO(); ws.parent.save(b); xml = zipfile.ZipFile(b).read(\\'xl/worksheets/sheet1.xml\\').decode()\\nimport re\\nout = (ws.column_dimensions[\\'C\\'].hidden, re.findall(\\'<col [^>]*hidden=.1.[^>]*>\\', xml), re.findall(\\'<row r=.5.[^>]*>\\', xml))')" ; chx:output "(True, ['<col hidden='1' width='13' customWidth='1' min='3' max='3' />'], ['<row r='5' hidden='1'>'])" .
chx:X_HidingRowsColumns rd:hasIOExample chx:IO_HidingRowsColumns .
chx:X_MergeCells a owl:NamedIndividual, chx:MergeCells ; rdfs:label "sheet.merge_cells('A1:D3')"@en ; skos:definition "merge_cells takes one range string and joins its cells into one, whose value is that of the top-left cell; whatever the other cells held is discarded."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_MergeCells a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = \\'keep\\'; ws[\\'B1\\'] = \\'lost\\'; ws[\\'A2\\'] = \\'lost too\\'\\nws.merge_cells(\\'A1:D3\\'); ws.merge_cells(\\'C5:D5\\')\\nout = (sorted(map(str, ws.merged_cells.ranges)), ws[\\'A1\\'].value, ws[\\'B1\\'].value, ws[\\'A2\\'].value)') evaluates to (['A1:D3', 'C5:D5'], 'keep', None, None)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws[\\'A1\\'] = \\'keep\\'; ws[\\'B1\\'] = \\'lost\\'; ws[\\'A2\\'] = \\'lost too\\'\\nws.merge_cells(\\'A1:D3\\'); ws.merge_cells(\\'C5:D5\\')\\nout = (sorted(map(str, ws.merged_cells.ranges)), ws[\\'A1\\'].value, ws[\\'B1\\'].value, ws[\\'A2\\'].value)')" ; chx:output "(['A1:D3', 'C5:D5'], 'keep', None, None)" .
chx:X_MergeCells rd:hasIOExample chx:IO_MergeCells .
chx:X_MergedValue a owl:NamedIndividual, chx:MergedValue ; rdfs:label "MergedCell"@en ; skos:definition "Every cell of a merged range except the top-left one is a MergedCell whose value is read-only, so assigning to it raises AttributeError and the value is set on the top-left cell, as the chapter says."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_MergedValue a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws.merge_cells(\\'A1:D3\\')\\ntry:\\n    ws[\\'B2\\'] = \\'x\\'\\nexcept AttributeError as e:\\n    err = str(e)\\nout = (type(ws[\\'A1\\']).__name__, type(ws[\\'B2\\']).__name__, err)') evaluates to ('Cell', 'MergedCell', ''MergedCell' object attribute 'value' is read-only')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws.merge_cells(\\'A1:D3\\')\\ntry:\\n    ws[\\'B2\\'] = \\'x\\'\\nexcept AttributeError as e:\\n    err = str(e)\\nout = (type(ws[\\'A1\\']).__name__, type(ws[\\'B2\\']).__name__, err)')" ; chx:output "('Cell', 'MergedCell', ''MergedCell' object attribute 'value' is read-only')" .
chx:X_MergedValue rd:hasIOExample chx:IO_MergedValue .
chx:X_UnmergeCells a owl:NamedIndividual, chx:UnmergeCells ; rdfs:label "sheet.unmerge_cells('A1:D3')"@en ; skos:definition "unmerge_cells splits the range into separate cells again, the text stays in the top-left one and the others are empty."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_UnmergeCells a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nws = openpyxl.Workbook().active\\nws.merge_cells(\\'A1:D3\\'); ws[\\'A1\\'] = \\'Twelve cells merged together.\\'\\nws.unmerge_cells(\\'A1:D3\\')\\nout = (ws.merged_cells.ranges == set() or len(ws.merged_cells.ranges), ws[\\'A1\\'].value, ws[\\'B2\\'].value, type(ws[\\'B2\\']).__name__)') evaluates to (True, 'Twelve cells merged together.', None, 'Cell')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nws = openpyxl.Workbook().active\\nws.merge_cells(\\'A1:D3\\'); ws[\\'A1\\'] = \\'Twelve cells merged together.\\'\\nws.unmerge_cells(\\'A1:D3\\')\\nout = (ws.merged_cells.ranges == set() or len(ws.merged_cells.ranges), ws[\\'A1\\'].value, ws[\\'B2\\'].value, type(ws[\\'B2\\']).__name__)')" ; chx:output "(True, 'Twelve cells merged together.', None, 'Cell')" .
chx:X_UnmergeCells rd:hasIOExample chx:IO_UnmergeCells .
chx:X_FreezeSetting a owl:NamedIndividual, chx:FreezeSetting ; rdfs:label "sheet.freeze_panes = 'A2'"@en ; skos:definition "freeze_panes freezes the rows above and the columns left of the named cell and not that cell's own row and column: A2 freezes row 1, B1 column A, C1 columns A and B, and C2 row 1 with columns A and B."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_FreezeSetting a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nres = []\\nfor setting in (\\'A2\\', \\'B1\\', \\'C1\\', \\'C2\\'):\\n    ws = openpyxl.Workbook().active; ws.freeze_panes = setting; p = ws.sheet_view.pane\\n    res.append((setting, p.xSplit, p.ySplit))\\nout = res') evaluates to [('A2', None, 1.0), ('B1', 1.0, None), ('C1', 2.0, None), ('C2', 2.0, 1.0)]"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nres = []\\nfor setting in (\\'A2\\', \\'B1\\', \\'C1\\', \\'C2\\'):\\n    ws = openpyxl.Workbook().active; ws.freeze_panes = setting; p = ws.sheet_view.pane\\n    res.append((setting, p.xSplit, p.ySplit))\\nout = res')" ; chx:output "[('A2', None, 1.0), ('B1', 1.0, None), ('C1', 2.0, None), ('C2', 2.0, 1.0)]" .
chx:X_FreezeSetting rd:hasIOExample chx:IO_FreezeSetting .
chx:X_FreezeUnfreeze a owl:NamedIndividual, chx:FreezeUnfreeze ; rdfs:label "sheet.freeze_panes = None"@en ; skos:definition "Setting freeze_panes to None or to A1 removes the frozen panes, and a Cell object may be assigned in place of its name."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_FreezeUnfreeze a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws.freeze_panes = ws[\\'C2\\']; a = ws.freeze_panes; ws.freeze_panes = \\'A1\\'; b = (ws.freeze_panes, ws.sheet_view.pane)\\nws.freeze_panes = \\'C2\\'; ws.freeze_panes = None\\nout = (a, b, ws.freeze_panes, ws.sheet_view.pane)') evaluates to ('C2', (None, None), None, None)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nws = openpyxl.Workbook().active\\nws.freeze_panes = ws[\\'C2\\']; a = ws.freeze_panes; ws.freeze_panes = \\'A1\\'; b = (ws.freeze_panes, ws.sheet_view.pane)\\nws.freeze_panes = \\'C2\\'; ws.freeze_panes = None\\nout = (a, b, ws.freeze_panes, ws.sheet_view.pane)')" ; chx:output "('C2', (None, None), None, None)" .
chx:X_FreezeUnfreeze rd:hasIOExample chx:IO_FreezeUnfreeze .
chx:X_FreezeScroll a owl:NamedIndividual, chx:FreezeScroll ; rdfs:label "topLeftCell='A23736'"@en ; skos:definition "Freezing sets the pane and leaves the scroll position the file was saved with: the book's produceSales3.xlsx was saved scrolled to row 23736, so the frozen copy of Figure 14-8 opens at the bottom of the data unless the program also resets the view."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_ReferenceObject a owl:NamedIndividual, chx:ReferenceObject ; rdfs:label "Reference(sheet, 1, 1, 1, 10)"@en ; skos:definition "A Reference names a rectangle of cells; its arguments after the worksheet are min_col, min_row, max_col and max_row, column first, which the chapter's sentence about the row coming first has backwards; the chapter's call names A1 to A10."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ReferenceObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.chart import Reference\\nws = openpyxl.Workbook().active\\nout = (str(Reference(ws, 1, 1, 1, 10)), str(Reference(ws, 2, 1, 2, 10)), str(Reference(ws, min_col=1, min_row=3, max_col=1, max_row=5)), str(Reference(ws, 1, 1, 1)))') evaluates to (''Sheet'!$A$1:$A$10', ''Sheet'!$B$1:$B$10', ''Sheet'!$A$3:$A$5', ''Sheet'!$A$1')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.chart import Reference\\nws = openpyxl.Workbook().active\\nout = (str(Reference(ws, 1, 1, 1, 10)), str(Reference(ws, 2, 1, 2, 10)), str(Reference(ws, min_col=1, min_row=3, max_col=1, max_row=5)), str(Reference(ws, 1, 1, 1)))')" ; chx:output "(''Sheet'!$A$1:$A$10', ''Sheet'!$B$1:$B$10', ''Sheet'!$A$3:$A$5', ''Sheet'!$A$1')" .
chx:X_ReferenceObject rd:hasIOExample chx:IO_ReferenceObject .
chx:X_SeriesObject a owl:NamedIndividual, chx:SeriesObject ; rdfs:label "Series(ref_obj, title='First series')"@en ; skos:definition "Series is a function that builds a series from a reference, with a title given as text or taken from the first cell of the reference with title_from_data."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_SeriesObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.chart import Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 6): ws[\\'A%d\\' % i] = i * i\\ns1 = Series(Reference(ws, 1, 1, 1, 5), title=\\'First series\\'); s2 = Series(Reference(ws, 1, 1, 1, 5), title_from_data=True)\\nout = (type(s1).__name__, s1.tx.v, s2.tx.strRef.f, s2.val.numRef.f)') evaluates to ('Series', 'First series', ''Sheet'!A1', ''Sheet'!$A$2:$A$5')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.chart import Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 6): ws[\\'A%d\\' % i] = i * i\\ns1 = Series(Reference(ws, 1, 1, 1, 5), title=\\'First series\\'); s2 = Series(Reference(ws, 1, 1, 1, 5), title_from_data=True)\\nout = (type(s1).__name__, s1.tx.v, s2.tx.strRef.f, s2.val.numRef.f)')" ; chx:output "('Series', 'First series', ''Sheet'!A1', ''Sheet'!$A$2:$A$5')" .
chx:X_SeriesObject rd:hasIOExample chx:IO_SeriesObject .
chx:X_ChartObject a owl:NamedIndividual, chx:ChartObject ; rdfs:label "BarChart()"@en ; skos:definition "A chart object is made empty, given a title, and given its series with append; BarChart draws vertical bars grouped side by side, and add_chart anchors it to the cell named in its second argument."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ChartObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.chart import BarChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 11): ws[\\'A%d\\' % i] = i * i\\nc = BarChart(); c.title = \\'My Chart\\'; c.append(Series(Reference(ws, 1, 1, 1, 10), title=\\'First series\\')); ws.add_chart(c, \\'C5\\')\\nout = (c.type, c.grouping, len(c.series), c.anchor, len(ws._charts))') evaluates to ('col', 'clustered', 1, 'C5', 1)"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl\\nfrom openpyxl.chart import BarChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 11): ws[\\'A%d\\' % i] = i * i\\nc = BarChart(); c.title = \\'My Chart\\'; c.append(Series(Reference(ws, 1, 1, 1, 10), title=\\'First series\\')); ws.add_chart(c, \\'C5\\')\\nout = (c.type, c.grouping, len(c.series), c.anchor, len(ws._charts))')" ; chx:output "('col', 'clustered', 1, 'C5', 1)" .
chx:X_ChartObject rd:hasIOExample chx:IO_ChartObject .
chx:X_FourKinds a owl:NamedIndividual, chx:FourKinds ; rdfs:label "LineChart, ScatterChart, PieChart"@en ; skos:definition "The chapter names four chart classes, BarChart, LineChart, ScatterChart and PieChart, and each is written into the file as a chart element of its own kind."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_FourKinds a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile, re\\nfrom openpyxl.chart import BarChart, LineChart, ScatterChart, PieChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 6): ws[\\'A%d\\' % i] = i * i; ws[\\'B%d\\' % i] = i\\nfor k, cls in enumerate((BarChart, LineChart, ScatterChart, PieChart)):\\n    c = cls(); c.append(Series(Reference(ws, 1, 1, 1, 5), xvalues=Reference(ws, 2, 1, 2, 5)) if cls is ScatterChart else Series(Reference(ws, 1, 1, 1, 5))); ws.add_chart(c, \\'D%d\\' % (1 + 16 * k))\\nb = io.BytesIO(); ws.parent.save(b); z = zipfile.ZipFile(b)\\nout = [re.findall(\\'<(barChart|lineChart|scatterChart|pieChart)>\\', z.read(\\'xl/charts/chart%d.xml\\' % n).decode())[0] for n in (1, 2, 3, 4)]') evaluates to ['barChart', 'lineChart', 'scatterChart', 'pieChart']"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile, re\\nfrom openpyxl.chart import BarChart, LineChart, ScatterChart, PieChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 6): ws[\\'A%d\\' % i] = i * i; ws[\\'B%d\\' % i] = i\\nfor k, cls in enumerate((BarChart, LineChart, ScatterChart, PieChart)):\\n    c = cls(); c.append(Series(Reference(ws, 1, 1, 1, 5), xvalues=Reference(ws, 2, 1, 2, 5)) if cls is ScatterChart else Series(Reference(ws, 1, 1, 1, 5))); ws.add_chart(c, \\'D%d\\' % (1 + 16 * k))\\nb = io.BytesIO(); ws.parent.save(b); z = zipfile.ZipFile(b)\\nout = [re.findall(\\'<(barChart|lineChart|scatterChart|pieChart)>\\', z.read(\\'xl/charts/chart%d.xml\\' % n).decode())[0] for n in (1, 2, 3, 4)]')" ; chx:output "['barChart', 'lineChart', 'scatterChart', 'pieChart']" .
chx:X_FourKinds rd:hasIOExample chx:IO_FourKinds .
chx:X_ScatterValues a owl:NamedIndividual, chx:ScatterValues ; rdfs:label "Series(y, xvalues=x)"@en ; skos:definition "A scatter chart needs the x values too, passed as xvalues, and writes them as xVal and yVal, while a bar chart writes only val."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ScatterValues a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile, re\\nfrom openpyxl.chart import BarChart, ScatterChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 6): ws[\\'A%d\\' % i] = i * i; ws[\\'B%d\\' % i] = i\\nsc = ScatterChart(); sc.append(Series(Reference(ws, 1, 1, 1, 5), xvalues=Reference(ws, 2, 1, 2, 5))); bc = BarChart(); bc.append(Series(Reference(ws, 1, 1, 1, 5)))\\nws.add_chart(sc, \\'D1\\'); ws.add_chart(bc, \\'D20\\')\\nb = io.BytesIO(); ws.parent.save(b); z = zipfile.ZipFile(b)\\nout = (re.findall(\\'<(xVal|yVal)>\\', z.read(\\'xl/charts/chart1.xml\\').decode()), re.findall(\\'<(cat|val)>\\', z.read(\\'xl/charts/chart2.xml\\').decode()))') evaluates to (['xVal', 'yVal'], ['val'])"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile, re\\nfrom openpyxl.chart import BarChart, ScatterChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 6): ws[\\'A%d\\' % i] = i * i; ws[\\'B%d\\' % i] = i\\nsc = ScatterChart(); sc.append(Series(Reference(ws, 1, 1, 1, 5), xvalues=Reference(ws, 2, 1, 2, 5))); bc = BarChart(); bc.append(Series(Reference(ws, 1, 1, 1, 5)))\\nws.add_chart(sc, \\'D1\\'); ws.add_chart(bc, \\'D20\\')\\nb = io.BytesIO(); ws.parent.save(b); z = zipfile.ZipFile(b)\\nout = (re.findall(\\'<(xVal|yVal)>\\', z.read(\\'xl/charts/chart1.xml\\').decode()), re.findall(\\'<(cat|val)>\\', z.read(\\'xl/charts/chart2.xml\\').decode()))')" ; chx:output "(['xVal', 'yVal'], ['val'])" .
chx:X_ScatterValues rd:hasIOExample chx:IO_ScatterValues .
chx:X_ChartXml a owl:NamedIndividual, chx:ChartXml ; rdfs:label "xl/charts/chart1.xml"@en ; skos:definition "A chart is saved as a part of the zip file, xl/charts/chart1.xml, with a drawing part that anchors it, and the anchor for C5 is column index 2 and row index 4 because the file counts from zero."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ChartXml a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile, re\\nfrom openpyxl.chart import BarChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 11): ws[\\'A%d\\' % i] = i * i\\nc = BarChart(); c.append(Series(Reference(ws, 1, 1, 1, 10), title=\\'First series\\')); ws.add_chart(c, \\'C5\\')\\nb = io.BytesIO(); ws.parent.save(b); z = zipfile.ZipFile(b)\\nout = ([n for n in z.namelist() if \\'chart\\' in n or \\'drawing\\' in n], re.findall(\\'<from>.*?</from>\\', z.read(\\'xl/drawings/drawing1.xml\\').decode()))') evaluates to (['xl/drawings/drawing1.xml', 'xl/drawings/_rels/drawing1.xml.rels', 'xl/charts/chart1.xml'], ['<from><col>2</col><colOff>0</colOff><row>4</row><rowOff>0</rowOff></from>'])"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io, zipfile, re\\nfrom openpyxl.chart import BarChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 11): ws[\\'A%d\\' % i] = i * i\\nc = BarChart(); c.append(Series(Reference(ws, 1, 1, 1, 10), title=\\'First series\\')); ws.add_chart(c, \\'C5\\')\\nb = io.BytesIO(); ws.parent.save(b); z = zipfile.ZipFile(b)\\nout = ([n for n in z.namelist() if \\'chart\\' in n or \\'drawing\\' in n], re.findall(\\'<from>.*?</from>\\', z.read(\\'xl/drawings/drawing1.xml\\').decode()))')" ; chx:output "(['xl/drawings/drawing1.xml', 'xl/drawings/_rels/drawing1.xml.rels', 'xl/charts/chart1.xml'], ['<from><col>2</col><colOff>0</colOff><row>4</row><rowOff>0</rowOff></from>'])" .
chx:X_ChartXml rd:hasIOExample chx:IO_ChartXml .
chx:X_ChartRoundTrip a owl:NamedIndividual, chx:ChartRoundTrip ; rdfs:label "load_workbook(...).save(...)"@en ; skos:definition "A chart that openpyxl wrote survives a load and a save and a picture does too when Pillow is installed, while copy_worksheet copies cells and leaves charts behind, contrary to the warning in the documentation that shapes are lost."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ChartRoundTrip a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nfrom openpyxl.chart import BarChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 6): ws[\\'A%d\\' % i] = i\\nc = BarChart(); c.append(Series(Reference(ws, 1, 1, 1, 5))); ws.add_chart(c, \\'C2\\')\\nb = io.BytesIO(); ws.parent.save(b); again = openpyxl.load_workbook(io.BytesIO(b.getvalue()))\\nb2 = io.BytesIO(); again.save(b2); third = openpyxl.load_workbook(io.BytesIO(b2.getvalue()))\\ncp = again.copy_worksheet(again.active)\\nout = (len(again.active._charts), len(third.active._charts), len(cp._charts), cp.title)') evaluates to (1, 1, 0, 'Sheet Copy')"@en ; chx:input "__import__('sen0414_ch14_isolated_env_v1_0_0').out('import openpyxl, io\\nfrom openpyxl.chart import BarChart, Reference, Series\\nws = openpyxl.Workbook().active\\nfor i in range(1, 6): ws[\\'A%d\\' % i] = i\\nc = BarChart(); c.append(Series(Reference(ws, 1, 1, 1, 5))); ws.add_chart(c, \\'C2\\')\\nb = io.BytesIO(); ws.parent.save(b); again = openpyxl.load_workbook(io.BytesIO(b.getvalue()))\\nb2 = io.BytesIO(); again.save(b2); third = openpyxl.load_workbook(io.BytesIO(b2.getvalue()))\\ncp = again.copy_worksheet(again.active)\\nout = (len(again.active._charts), len(third.active._charts), len(cp._charts), cp.title)')" ; chx:output "(1, 1, 0, 'Sheet Copy')" .
chx:X_ChartRoundTrip rd:hasIOExample chx:IO_ChartRoundTrip .
chx:X_ChartRendered a owl:NamedIndividual, chx:ChartRendered ; rdfs:label "LibreOffice PDF of sampleChart3.xlsx"@en ; skos:definition "How a chart looks is decided by the application that draws it: LibreOffice 24.2 drew the chapter's chart with a value axis from 0 to 120, the labels 1 to 10 and the legend First series, and Excel was not available to compare."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 14 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch14/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 14 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which object of openpyxl stands for which part of a workbook - the file, a sheet, a row or column, a cell, a style, a formula, a chart - and what does each keep of what the spreadsheet application stored?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs, programs, files and statements of the chapter differ in current Python, in the current library or in the files the book ships, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 14 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 14 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch14/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.6"@en ;
