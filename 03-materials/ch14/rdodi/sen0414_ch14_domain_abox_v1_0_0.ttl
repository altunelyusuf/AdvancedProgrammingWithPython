chx:X_WorkbookFile a owl:NamedIndividual, chx:WorkbookFile ; rdfs:label "wb = openpyxl.load_workbook('example3.xlsx')"@en ; skos:definition "A workbook is an Excel document saved in a file with the .xlsx extension, and load_workbook returns a Workbook object for it; the file itself is a zip archive of XML parts."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_WorkbookFile a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda b: (__import__('zipfile').ZipFile(b, 'w').close(), b.getvalue()[:2])[1])(__import__('io').BytesIO()) evaluates to b'PK'"@en ; chx:input "(lambda b: (__import__('zipfile').ZipFile(b, 'w').close(), b.getvalue()[:2])[1])(__import__('io').BytesIO())" ; chx:output "b'PK'" .
chx:X_WorkbookFile rd:hasIOExample chx:IO_WorkbookFile .
chx:X_SheetNames a owl:NamedIndividual, chx:SheetNames ; rdfs:label "sheet = wb['Sheet3']"@en ; skos:definition "The sheetnames attribute lists the names of the workbook's sheets, and a sheet is fetched by its name with square brackets like a dictionary key, which gives a Worksheet whose title attribute is that name."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_ActiveSheet a owl:NamedIndividual, chx:ActiveSheet ; rdfs:label "another_sheet = wb.active"@en ; skos:definition "The active attribute is the sheet that is on top when the workbook is opened, which is the first sheet unless the workbook says otherwise."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_CellByName a owl:NamedIndividual, chx:CellByName ; rdfs:label "c = sheet['A1']"@en ; skos:definition "A sheet is indexed by a cell name such as 'A1' to get a Cell object, whose value attribute holds the number, text or date stored there."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_CellByNumbers a owl:NamedIndividual, chx:CellByNumbers ; rdfs:label "c = sheet.cell(row=1, column=2)"@en ; skos:definition "The cell method takes the row and the column as integers counted from 1, so a loop can step through rows and pick a column without converting letters; passing a value also writes it."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CellByNumbers a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(range(1, 8, 2)) evaluates to [1, 3, 5, 7]"@en ; chx:input "list(range(1, 8, 2))" ; chx:output "[1, 3, 5, 7]" .
chx:X_CellByNumbers rd:hasIOExample chx:IO_CellByNumbers .
chx:X_CellAttributes a owl:NamedIndividual, chx:CellAttributes ; rdfs:label "where = c.coordinate"@en ; skos:definition "A Cell knows its value, its row and column as integers and its coordinate as text, which together can be printed back as a sentence such as Row 1, Column 2 is Apples."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CellAttributes a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda row, col, v: f'Row {row}, Column {col} is {v}')(1, 2, 'Apples') evaluates to 'Row 1, Column 2 is Apples'"@en ; chx:input "(lambda row, col, v: f'Row {row}, Column {col} is {v}')(1, 2, 'Apples')" ; chx:output "'Row 1, Column 2 is Apples'" .
chx:X_CellAttributes rd:hasIOExample chx:IO_CellAttributes .
chx:X_SheetSize a owl:NamedIndividual, chx:SheetSize ; rdfs:label "last_row = sheet.max_row"@en ; skos:definition "The max_row and max_column attributes are integers giving the largest row and column that hold data, so the letter of the last column needs a conversion."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_SheetSize a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda rows: (len(rows), max(len(r) for r in rows)))([(1, 'Apples', 73)] * 7) evaluates to (7, 3)"@en ; chx:input "(lambda rows: (len(rows), max(len(r) for r in rows)))([(1, 'Apples', 73)] * 7)" ; chx:output "(7, 3)" .
chx:X_SheetSize rd:hasIOExample chx:IO_SheetSize .
chx:X_CellCreationOnRead a owl:NamedIndividual, chx:CellCreationOnRead ; rdfs:label "sheet['A100'].value"@en ; skos:definition "A cell that does not exist yet is created when it is first accessed, even only to read it, so touching a far cell makes max_row larger and walking over a region creates every cell in it."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_ColumnLetters a owl:NamedIndividual, chx:ColumnLetters ; rdfs:label "get_column_letter(27), column_index_from_string('AA')"@en ; skos:definition "Two functions of openpyxl.utils convert between column numbers and letters, 27 and 'AA' for instance, and need no workbook; the letters are a base-26 numbering without a zero."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ColumnLetters a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda f, g: (f(f, 1), f(f, 27), f(f, 900), g('AA'), g('M')))(lambda f, n: '' if n == 0 else f(f, (n - 1) // 26) + chr(65 + (n - 1) % 26), lambda s: __import__('functools').reduce(lambda a, c: a * 26 + ord(c) - 64, s, 0)) evaluates to ('A', 'AA', 'AHP', 27, 13)"@en ; chx:input "(lambda f, g: (f(f, 1), f(f, 27), f(f, 900), g('AA'), g('M')))(lambda f, n: '' if n == 0 else f(f, (n - 1) // 26) + chr(65 + (n - 1) % 26), lambda s: __import__('functools').reduce(lambda a, c: a * 26 + ord(c) - 64, s, 0))" ; chx:output "('A', 'AA', 'AHP', 27, 13)" .
chx:X_ColumnLetters rd:hasIOExample chx:IO_ColumnLetters .
chx:X_CellCoordinate a owl:NamedIndividual, chx:CellCoordinate ; rdfs:label "'AB12'"@en ; skos:definition "A cell's coordinate is its column letters followed by its row number, which can be split with a pattern into the two parts."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CellCoordinate a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('re').fullmatch(r'([A-Z]+)(\\d+)', 'AB12').groups() evaluates to ('AB', '12')"@en ; chx:input "__import__('re').fullmatch(r'([A-Z]+)(\\d+)', 'AB12').groups()" ; chx:output "('AB', '12')" .
chx:X_CellCoordinate rd:hasIOExample chx:IO_CellCoordinate .
chx:X_RangeSlice a owl:NamedIndividual, chx:RangeSlice ; rdfs:label "area = sheet['A1':'C3']"@en ; skos:definition "Slicing a sheet with two coordinates gives a tuple of rows, each a tuple of the Cell objects from the left to the right of the area, so two nested loops visit every cell."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_RangeSlice a owl:NamedIndividual, rd:IOExample ; rdfs:label "tuple(tuple(c + str(r) for c in 'ABC') for r in range(1, 4)) evaluates to (('A1', 'B1', 'C1'), ('A2', 'B2', 'C2'), ('A3', 'B3', 'C3'))"@en ; chx:input "tuple(tuple(c + str(r) for c in 'ABC') for r in range(1, 4))" ; chx:output "(('A1', 'B1', 'C1'), ('A2', 'B2', 'C2'), ('A3', 'B3', 'C3'))" .
chx:X_RangeSlice rd:hasIOExample chx:IO_RangeSlice .
chx:X_RowsAndColumns a owl:NamedIndividual, chx:RowsAndColumns ; rdfs:label "column_b = list(sheet.columns)[1]"@en ; skos:definition "The rows and columns attributes give the cells row by row and column by column, and once turned into lists they can be indexed; columns are rows turned on their side."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_RowsAndColumns a owl:NamedIndividual, rd:IOExample ; rdfs:label "list(zip(*[(1, 'a'), (2, 'b'), (3, 'c')])) evaluates to [(1, 2, 3), ('a', 'b', 'c')]"@en ; chx:input "list(zip(*[(1, 'a'), (2, 'b'), (3, 'c')]))" ; chx:output "[(1, 2, 3), ('a', 'b', 'c')]" .
chx:X_RowsAndColumns rd:hasIOExample chx:IO_RowsAndColumns .
chx:X_ValuesOnly a owl:NamedIndividual, chx:ValuesOnly ; rdfs:label "for row in sheet.iter_rows(values_only=True): print(row)"@en ; skos:definition "The iter_rows method and the values property give plain values instead of Cell objects, which is the shortest way to read a region into Python data; the chapter as read does not present them."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_DateValues a owl:NamedIndividual, chx:DateValues ; rdfs:label "sheet['A1'].value"@en ; skos:definition "A date or time cell comes back as a Python datetime, because the file stores it as a number of days with a date format."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_DateValues a owl:NamedIndividual, rd:IOExample ; rdfs:label "__import__('datetime').datetime(1899, 12, 30) + __import__('datetime').timedelta(days=45000) evaluates to datetime.datetime(2023, 3, 15, 0, 0)"@en ; chx:input "__import__('datetime').datetime(1899, 12, 30) + __import__('datetime').timedelta(days=45000)" ; chx:output "datetime.datetime(2023, 3, 15, 0, 0)" .
chx:X_DateValues rd:hasIOExample chx:IO_DateValues .
chx:X_CountyStructure a owl:NamedIndividual, chx:CountyStructure ; rdfs:label "county_data[state][county]['pop']"@en ; skos:definition "Project 9 keeps its totals in a dictionary of dictionaries keyed by state abbreviation and county name, each county holding a tract count and a population, and reads the population cell as text that int() converts."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_CountyStructure a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: sum(c['pop'] for c in d['AK'].values()))({'AK': {'Anchorage': {'pop': 291826, 'tracts': 55}, 'Juneau': {'pop': 31275, 'tracts': 7}}}) evaluates to 323101"@en ; chx:input "(lambda d: sum(c['pop'] for c in d['AK'].values()))({'AK': {'Anchorage': {'pop': 291826, 'tracts': 55}, 'Juneau': {'pop': 31275, 'tracts': 7}}})" ; chx:output "323101" .
chx:X_CountyStructure rd:hasIOExample chx:IO_CountyStructure .
chx:X_DefaultEntries a owl:NamedIndividual, chx:DefaultEntries ; rdfs:label "county_data.setdefault(state, {})"@en ; skos:definition "The setdefault method creates a missing key with a starting value and does nothing when the key exists, so it can be called on every row before the counters are incremented."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_DefaultEntries a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda d: (d.setdefault('AK', {}), d.setdefault('AK', {'x': 1}), d))({}) evaluates to ({}, {}, {'AK': {}})"@en ; chx:input "(lambda d: (d.setdefault('AK', {}), d.setdefault('AK', {'x': 1}), d))({})" ; chx:output "({}, {}, {'AK': {}})" .
chx:X_DefaultEntries rd:hasIOExample chx:IO_DefaultEntries .
chx:X_GeneratedModule a owl:NamedIndividual, chx:GeneratedModule ; rdfs:label "'allData = ' + pprint.pformat(county_data)"@en ; skos:definition "The project writes its dictionary as the text of a Python module with pformat, which sorts the keys, so that import census2010 gives the data back; importing runs the file as code."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_GeneratedModule a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda s: __import__('ast').literal_eval(s.split(' = ', 1)[1]))('allData = ' + __import__('pprint').pformat({'b': {'pop': 1, 'tracts': 2}, 'a': {'pop': 3, 'tracts': 1}})) evaluates to {'a': {'pop': 3, 'tracts': 1}, 'b': {'pop': 1, 'tracts': 2}}"@en ; chx:input "(lambda s: __import__('ast').literal_eval(s.split(' = ', 1)[1]))('allData = ' + __import__('pprint').pformat({'b': {'pop': 1, 'tracts': 2}, 'a': {'pop': 3, 'tracts': 1}}))" ; chx:output "{'a': {'pop': 3, 'tracts': 1}, 'b': {'pop': 1, 'tracts': 2}}" .
chx:X_GeneratedModule rd:hasIOExample chx:IO_GeneratedModule .
chx:X_NewWorkbook a owl:NamedIndividual, chx:NewWorkbook ; rdfs:label "wb = openpyxl.Workbook()"@en ; skos:definition "The Workbook function makes a blank workbook that starts with one sheet named Sheet, whose title attribute can be replaced."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_SheetCreation a owl:NamedIndividual, chx:SheetCreation ; rdfs:label "new_sheet = wb.create_sheet(index=0, title='First Sheet')"@en ; skos:definition "The create_sheet method adds a sheet at the end under the next free name, or at a given index and with a given title."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_SheetRemoval a owl:NamedIndividual, chx:SheetRemoval ; rdfs:label "del wb['Sheet1']"@en ; skos:definition "A sheet is removed from the workbook with the del operator and its name, as a key is removed from a dictionary, or with the remove method and the sheet object."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_SaveMethod a owl:NamedIndividual, chx:SaveMethod ; rdfs:label "wb.save('example3_copy.xlsx')"@en ; skos:definition "Nothing reaches the disk until the save method is called, and it overwrites an existing file without asking, so the chapter saves edited workbooks under a new name to keep the original."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_CellWriting a owl:NamedIndividual, chx:CellWriting ; rdfs:label "sheet['A1'] = 'Hello, world!'"@en ; skos:definition "Assigning to a cell name or to a cell's value writes it like a dictionary entry, and the Python type of the value decides how the cell is stored."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_UpdateLoop a owl:NamedIndividual, chx:UpdateLoop ; rdfs:label "if produce_name in PRICE_UPDATES:"@en ; skos:definition "Project 10 holds the corrected prices in a dictionary and loops over the rows from 2 on, changing the price cell of every row whose produce name is a key, then saves to a new file."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_UpdateLoop a owl:NamedIndividual, rd:IOExample ; rdfs:label "[n in {'Garlic': 3.07, 'Celery': 1.19, 'Lemon': 1.27} for n in ('Lemon', 'Lemons')] evaluates to [True, False]"@en ; chx:input "[n in {'Garlic': 3.07, 'Celery': 1.19, 'Lemon': 1.27} for n in ('Lemon', 'Lemons')]" ; chx:output "[True, False]" .
chx:X_UpdateLoop rd:hasIOExample chx:IO_UpdateLoop .
chx:X_FormulaSurvival a owl:NamedIndividual, chx:FormulaSurvival ; rdfs:label "=ROUND(B2*C2, 2)"@en ; skos:definition "The total column of the produce workbook holds formulas, which stay formulas when only the price cells are changed, because openpyxl writes them back as text and does not recalculate."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_FontObject a owl:NamedIndividual, chx:FontObject ; rdfs:label "Font(name='Times New Roman', size=24, bold=True, italic=True)"@en ; skos:definition "A Font object is made from the openpyxl.styles module with the keyword arguments name, size, bold and italic, and holds only the attributes it was given."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_FontAssignment a owl:NamedIndividual, chx:FontAssignment ; rdfs:label "sheet['A1'].font = italic_24_font"@en ; skos:definition "A cell is styled by assigning a Font object to its font attribute, and the Font cannot be changed afterwards, so a new look needs a new Font."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_FontDefaults a owl:NamedIndividual, chx:FontDefaults ; rdfs:label "Font(size=24, italic=True)"@en ; skos:definition "A new cell's font is Calibri 11, but a Font object made with some keyword arguments has no value for the others, so the chapter's claim that it falls back to Calibri and 11 is not what the saved file holds."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_RowAndColumnSize a owl:NamedIndividual, chx:RowAndColumnSize ; rdfs:label "sheet.row_dimensions[1].height = 70"@en ; skos:definition "The row_dimensions and column_dimensions attributes are dictionary-like, indexed by row number and by column letter, and set the height of a row and the width of a column."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_HiddenColumn a owl:NamedIndividual, chx:HiddenColumn ; rdfs:label "sheet.column_dimensions['C'].hidden = True"@en ; skos:definition "A column is hidden by setting hidden on its dimension object; the chapter promises hiding and its practice question 16 asks for it, but no example shows it."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_MergeCells a owl:NamedIndividual, chx:MergeCells ; rdfs:label "sheet.merge_cells('A1:D3')"@en ; skos:definition "The merge_cells method joins the rectangle named by its top-left and bottom-right cells into one cell whose value is set in the top-left cell, and unmerge_cells splits it again."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_MergeCells a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda a: (ord(a[3]) - ord(a[0]) + 1) * (int(a[4]) - int(a[1]) + 1))('A1:D3') evaluates to 12"@en ; chx:input "(lambda a: (ord(a[3]) - ord(a[0]) + 1) * (int(a[4]) - int(a[1]) + 1))('A1:D3')" ; chx:output "12" .
chx:X_MergeCells rd:hasIOExample chx:IO_MergeCells .
chx:X_FreezePanes a owl:NamedIndividual, chx:FreezePanes ; rdfs:label "sheet.freeze_panes = 'A2'"@en ; skos:definition "A freeze pane keeps rows and columns visible while the sheet scrolls: setting freeze_panes to a cell freezes every row above it and every column to its left, and setting it to A1 or None removes the freeze."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_FreezePanes a owl:NamedIndividual, rd:IOExample ; rdfs:label "[(lambda s: (int(s[1:]) - 1, ord(s[0]) - 65))(x) for x in ('A2', 'B1', 'C1', 'C2', 'A1')] evaluates to [(1, 0), (0, 1), (0, 2), (1, 2), (0, 0)]"@en ; chx:input "[(lambda s: (int(s[1:]) - 1, ord(s[0]) - 65))(x) for x in ('A2', 'B1', 'C1', 'C2', 'A1')]" ; chx:output "[(1, 0), (0, 1), (0, 2), (1, 2), (0, 0)]" .
chx:X_FreezePanes rd:hasIOExample chx:IO_FreezePanes .
chx:X_FormulaString a owl:NamedIndividual, chx:FormulaString ; rdfs:label "sheet['A3'] = '=SUM(A1:A2)'"@en ; skos:definition "A formula is written into a cell as text that starts with an equal sign, in the same way as any other value."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_NoCalculation a owl:NamedIndividual, chx:NoCalculation ; rdfs:label "a formula written by openpyxl"@en ; skos:definition "The module does not calculate formulas, and the result that a spreadsheet application would show has to be worked out separately, here by Python."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_NoCalculation a owl:NamedIndividual, rd:IOExample ; rdfs:label "sum([200, 300]) evaluates to 500"@en ; chx:input "sum([200, 300])" ; chx:output "500" .
chx:X_NoCalculation rd:hasIOExample chx:IO_NoCalculation .
chx:X_CachedResult a owl:NamedIndividual, chx:CachedResult ; rdfs:label "load_workbook('writeFormula3.xlsx', data_only=True)"@en ; skos:definition "Loading with data_only=True gives the value that a spreadsheet application stored the last time it saved the file, and gives None when no application has calculated the formula."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_FormulaTranslation a owl:NamedIndividual, chx:FormulaTranslation ; rdfs:label "Translator('=SUM(B1:B4)', origin='C5').translate_formula('C7')"@en ; skos:definition "The Translator class rewrites a formula for another position, moving its relative references, which the row-moving methods of a sheet do not do; the chapter as read does not present it."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_ChartRecipe a owl:NamedIndividual, chx:ChartRecipe ; rdfs:label "sheet.add_chart(chart_obj, 'C5')"@en ; skos:definition "A chart is built from a Reference to a block of cells, a Series made from it, a chart object such as BarChart to which the series is appended, and a call of add_chart with the cell where its top-left corner goes."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_ReferenceObject a owl:NamedIndividual, chx:ReferenceObject ; rdfs:label "openpyxl.chart.Reference(sheet, 1, 1, 1, 10)"@en ; skos:definition "A Reference names a block of cells by the sheet and then the first column, first row, last column and last row, in that order."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_ReferenceObject a owl:NamedIndividual, rd:IOExample ; rdfs:label "(lambda L, a, b, c, d: '$%s$%d:$%s$%d' % (L(a), b, L(c), d))(lambda n: chr(64 + n), 2, 3, 4, 5) evaluates to '$B$3:$D$5'"@en ; chx:input "(lambda L, a, b, c, d: '$%s$%d:$%s$%d' % (L(a), b, L(c), d))(lambda n: chr(64 + n), 2, 3, 4, 5)" ; chx:output "'$B$3:$D$5'" .
chx:X_ReferenceObject rd:hasIOExample chx:IO_ReferenceObject .
chx:X_ReadOnlyMode a owl:NamedIndividual, chx:ReadOnlyMode ; rdfs:label "load_workbook('big.xlsx', read_only=True)"@en ; skos:definition "Read-only mode loads rows lazily with little memory, returns cells of a lighter type, offers no iter_cols, cannot be saved and must be closed."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_WriteOnlyMode a owl:NamedIndividual, chx:WriteOnlyMode ; rdfs:label "Workbook(write_only=True)"@en ; skos:definition "Write-only mode starts with no sheets, accepts rows only through append, keeps memory use low and can be saved only once."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_OldFormatRefusal a owl:NamedIndividual, chx:OldFormatRefusal ; rdfs:label "load_workbook('old.xls')"@en ; skos:definition "The module reads the xlsx family of formats only: an old .xls file, a file that is not a zip archive and a missing file each stop with an error that says which."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_XmlSafety a owl:NamedIndividual, chx:XmlSafety ; rdfs:label "defusedxml"@en ; skos:definition "An xlsx file is XML inside a zip, and the documentation says openpyxl does not by default guard against quadratic blowup or billion laughs attacks and advises installing defusedxml before reading files from others."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_LibraryStatus a owl:NamedIndividual, chx:LibraryStatus ; rdfs:label "openpyxl 3.1.5"@en ; skos:definition "The newest openpyxl on the Python Package Index is 3.1.5 of 2024-06-28, which ran under Python 3.14.4 although its classifiers stop at Python 3.11."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:X_DateSerials a owl:NamedIndividual, chx:DateSerials ; rdfs:label "epoch = wb.epoch"@en ; skos:definition "Dates are stored as day numbers counted from an epoch, 1899-12-30 for the usual 1900 date system, and the system wrongly counts 1900 as a leap year, so the plain epoch sum is right only from 1 March 1900 on and no timezone can be stored."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_DateSerials a owl:NamedIndividual, rd:IOExample ; rdfs:label "(__import__('datetime').datetime(1900, 3, 1) - __import__('datetime').datetime(1899, 12, 30)).days evaluates to 61"@en ; chx:input "(__import__('datetime').datetime(1900, 3, 1) - __import__('datetime').datetime(1899, 12, 30)).days" ; chx:output "61" .
chx:X_DateSerials rd:hasIOExample chx:IO_DateSerials .
chx:X_MultiplicationTable a owl:NamedIndividual, chx:MultiplicationTable ; rdfs:label "multiplicationTable.py 6"@en ; skos:definition "Practice program 1 builds an N by N multiplication table with the labels in row 1 and column A set in bold."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_MultiplicationTable a owl:NamedIndividual, rd:IOExample ; rdfs:label "[[None] + list(range(1, 4))] + [[r] + [r * c for c in range(1, 4)] for r in range(1, 4)] evaluates to [[None, 1, 2, 3], [1, 1, 2, 3], [2, 2, 4, 6], [3, 3, 6, 9]]"@en ; chx:input "[[None] + list(range(1, 4))] + [[r] + [r * c for c in range(1, 4)] for r in range(1, 4)]" ; chx:output "[[None, 1, 2, 3], [1, 1, 2, 3], [2, 2, 4, 6], [3, 3, 6, 9]]" .
chx:X_MultiplicationTable rd:hasIOExample chx:IO_MultiplicationTable .
chx:X_BlankRowInserter a owl:NamedIndividual, chx:BlankRowInserter ; rdfs:label "blankRowInserter.py 3 2 myProduce.xlsx"@en ; skos:definition "Practice program 2 inserts M blank rows at row N by copying the first rows unchanged and writing every later row M rows lower."@en ; dcterms:source <http://example.org/sen0414/ch14/research> .
chx:IO_BlankRowInserter a owl:NamedIndividual, rd:IOExample ; rdfs:label "[r if r < 3 else r + 2 for r in range(1, 6)] evaluates to [1, 2, 5, 6, 7]"@en ; chx:input "[r if r < 3 else r + 2 for r in range(1, 6)]" ; chx:output "[1, 2, 5, 6, 7]" .
chx:X_BlankRowInserter rd:hasIOExample chx:IO_BlankRowInserter .
chx:Artifact a owl:NamedIndividual, rd:DomainOntologyArtifact ; rdfs:label "SEN0414 chapter 14 domain ontology"@en ;
    rd:derivedFromResearchSubject <http://example.org/sen0414/ch14/research> ; rd:hasCompetencyQuestion chx:CQs ; rd:hasSourceProvenance chx:Provenance ;
    rd:hasReusabilityScope rd:RS_SubjectSpecific ; rd:hasResolutionEnvironment chx:Env .
chx:CQs a owl:NamedIndividual, rd:CompetencyQuestionSet ; rdfs:label "Chapter 14 competency questions"@en ; rd:containsCompetencyQuestion chx:CQ1, chx:CQ2 .
chx:CQ1 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which calls read a workbook, which change it in memory and which write it to a file, and what decides whether a formula shows a value?"@en .
chx:CQ2 a owl:NamedIndividual, rd:CompetencyQuestion ; rdfs:label "Which printed outputs and claims of the chapter differ in openpyxl 3.1.5 under Python 3.14.4, and on what source?"@en .
chx:Provenance a owl:NamedIndividual, rd:ResearchSubjectInput ; rdfs:label "Derived from the chapter 14 research artefact"@en ;
    skos:definition "Concepts are corpus-derived from the 3rd edition's chapter 14 through the Stage 1 research artefact; the modern-practice branch comes from that artefact's secondary sources."@en ;
    dcterms:source <http://example.org/sen0414/ch14/research> .
chx:Env a owl:NamedIndividual, rd:ResolutionEnvironment ; rdfs:label "CPython 3.14.4"@en ;
    skos:definition "Every input-output example executed under CPython 3.14.4, installed with uv on 2026-10-01."@en ;
    dcterms:source "The execution run recorded with this build, 08-tooling/sen0414_rdodi_build_v1_1_0.py" .

