    skos:definition "The explorer tree lists the 6 subjects of the chapter with their groups and concepts, and it stays in step with the tab row."@en ; dcterms:source "03-materials/ch14/page/sen0414_ch14_page_v9_97_0.html" .
pg:SourceDocument a ipo:SourceDocument ; rdfs:label "Chapter 14 Stage 3 document"@en ;
    skos:definition "The source document is the Stage 3 document of chapter 14, which has one section for each of the 93 concepts of the chapter."@en ; dcterms:source <http://example.org/sen0414/ch14/document> ;
    ipo:hasLearningObjective pg:CO1, pg:CO2, pg:CO3, pg:CO4, pg:CO5 .
