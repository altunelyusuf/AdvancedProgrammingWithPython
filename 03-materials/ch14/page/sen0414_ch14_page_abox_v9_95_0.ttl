pg:CE_01 a ipo:CodeExample ; rdfs:label "An .xlsx file is a zip of XML parts"@en ;
    skos:definition "Example 1 of the chapter-code tab comes from slide 6 of the deck and runs 7 lines of Python that print 10 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 6 ; sen0414:orderInTab 1 ;
    sen0414:code "import io, zipfile, openpyxl\nwb = openpyxl.Workbook()\nbuf = io.BytesIO()\nwb.save(buf)\nnames = sorted(zipfile.ZipFile(buf).namelist())\nprint(len(names), 'parts in the zip')\nfor name in names: print(name)" ; sen0414:expectedOutput "9 parts in the zip\n[Content_Types].xml\n_rels/.rels\ndocProps/app.xml\ndocProps/core.xml\nxl/_rels/workbook.xml.rels\nxl/styles.xml\nxl/theme/theme1.xml\nxl/workbook.xml\nxl/worksheets/sheet1.xml\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_01 .
pg:CE_02 a ipo:CodeExample ; rdfs:label "Sheets of a workbook: names, order, active"@en ;
    skos:definition "Example 2 of the chapter-code tab comes from slide 8 of the deck and runs 8 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 8 ; sen0414:orderInTab 2 ;
    sen0414:code "import io, openpyxl\nwb = openpyxl.Workbook()\nwb.create_sheet('Sheet2')\nwb.create_sheet('Sheet3', 1)\nbuf = io.BytesIO(); wb.save(buf)\nwb = openpyxl.load_workbook(buf)\nprint(wb.sheetnames)\nprint(wb.active.title, wb['Sheet3'].title)" ; sen0414:expectedOutput "['Sheet', 'Sheet3', 'Sheet2']\nSheet Sheet3\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_02 .
pg:CE_03 a ipo:CodeExample ; rdfs:label "Cells by name and by number"@en ;
    skos:definition "Example 3 of the chapter-code tab comes from slide 11 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 11 ; sen0414:orderInTab 3 ;
    sen0414:code "import openpyxl\nws = openpyxl.Workbook().active\nfor row in [('Apples', 73), ('Cherries', 85), ('Pears', 14)]:\n    ws.append(row)\nprint(ws['A1'].value, ws.cell(row=2, column=2).value)\nprint(ws['B3'].coordinate, ws.max_row, ws.max_column)\nprint(ws['A1'])" ; sen0414:expectedOutput "Apples 85\nB3 3 2\n<Cell 'Sheet'.A1>\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_03 .
pg:CE_04 a ipo:CodeExample ; rdfs:label "Column letters and numbers"@en ;
    skos:definition "Example 4 of the chapter-code tab comes from slide 13 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 13 ; sen0414:orderInTab 4 ;
    sen0414:code "from openpyxl.utils import get_column_letter, column_index_from_string\nprint([get_column_letter(n) for n in (1, 2, 27, 900)])\nprint(column_index_from_string('AA'), column_index_from_string('XFD'))\ntry:\n    get_column_letter(0)\nexcept ValueError as e:\n    print('ValueError:', e)" ; sen0414:expectedOutput "['A', 'B', 'AA', 'AHP']\n27 16384\nValueError: Invalid column index 0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_04 .
pg:CE_05 a ipo:CodeExample ; rdfs:label "Slices, rows and columns of cells"@en ;
    skos:definition "Example 5 of the chapter-code tab comes from slide 14 of the deck and runs 9 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 14 ; sen0414:orderInTab 5 ;
    sen0414:code "import openpyxl\nws = openpyxl.Workbook().active\nfor r in [(1, 'Apples', 73), (2, 'Cherries', 85), (3, 'Pears', 14)]:\n    ws.append(r)\nblock = ws['A1':'C2']\nprint(len(block), 'rows of', len(block[0]), 'cells')\nfor row in block: print([c.value for c in row])\nprint([c.value for c in ws['B']])\nprint(type(ws.rows).__name__, type(ws.columns).__name__)" ; sen0414:expectedOutput "2 rows of 3 cells\n[1, 'Apples', 73]\n[2, 'Cherries', 85]\n['Apples', 'Cherries', 'Pears']\ngenerator generator\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_05 .
pg:CE_06 a ipo:CodeExample ; rdfs:label "Data types of cells: numbers, text, dates"@en ;
    skos:definition "Example 6 of the chapter-code tab comes from slide 16 of the deck and runs 8 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 16 ; sen0414:orderInTab 6 ;
    sen0414:code "import datetime, openpyxl\nws = openpyxl.Workbook().active\nws['A1'] = datetime.datetime(2035, 4, 5, 13, 34, 2)\nws['B1'] = 'SEPT2'\nws['C1'] = 73\nprint(ws['A1'].value)\nfor c in ws[1]:\n    print(c.coordinate, c.data_type, type(c.value).__name__)" ; sen0414:expectedOutput "2035-04-05 13:34:02\nA1 d datetime\nB1 s str\nC1 n int\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_06 .
pg:CE_07 a ipo:CodeExample ; rdfs:label "Looking at a cell creates it"@en ;
    skos:definition "Example 7 of the chapter-code tab comes from slide 18 of the deck and runs 7 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 18 ; sen0414:orderInTab 7 ;
    sen0414:code "import openpyxl\nws = openpyxl.Workbook().active\nws['A1'] = 'tall'\nprint(ws.max_row, ws.dimensions)\nws.cell(row=40, column=1)\nprint(ws.max_row, ws.dimensions)\nprint(ws['A40'].value is None)" ; sen0414:expectedOutput "1 A1:A1\n40 A1:A40\nTrue\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_07 .
pg:CE_08 a ipo:CodeExample ; rdfs:label "Read-only mode and iter_rows"@en ;
    skos:definition "Example 8 of the chapter-code tab comes from slide 19 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 19 ; sen0414:orderInTab 8 ;
    sen0414:code "import io, openpyxl\nws = openpyxl.Workbook().active\nfor i in range(1, 6): ws.append([i, i * 10])\nbuf = io.BytesIO(); ws.parent.save(buf)\nfast = openpyxl.load_workbook(buf, read_only=True)\nsheet = fast.active\nprint(type(sheet).__name__, sheet.max_row)\nrows = list(sheet.iter_rows(min_row=2, max_row=4, values_only=True))\nprint(rows)" ; sen0414:expectedOutput "ReadOnlyWorksheet 5\n[(2, 20), (3, 30), (4, 40)]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_08 .
pg:CE_09 a ipo:CodeExample ; rdfs:label "Project 9: read the rows of the census sheet"@en ;
    skos:definition "Example 9 of the chapter-code tab comes from slide 22 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 22 ; sen0414:orderInTab 9 ;
    sen0414:code "import openpyxl\nsheet = openpyxl.Workbook().active\nsheet.append(['CensusTract', 'State', 'County', 'POP2010'])\ntracts = [('02020000100', 'AK', 'Anchorage', 4115),\n          ('02020000200', 'AK', 'Anchorage', 3040),\n          ('01001020100', 'AL', 'Autauga', 1912)]\nfor tract in tracts: sheet.append(tract)\nfor row in range(2, sheet.max_row + 1):\n    print(row, [sheet[c + str(row)].value for c in 'BCD'])" ; sen0414:expectedOutput "2 ['AK', 'Anchorage', 4115]\n3 ['AK', 'Anchorage', 3040]\n4 ['AL', 'Autauga', 1912]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_09 .
pg:CE_10 a ipo:CodeExample ; rdfs:label "Project 9: tally tracts and population by county"@en ;
    skos:definition "Example 10 of the chapter-code tab comes from slide 23 of the deck and runs 9 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 23 ; sen0414:orderInTab 10 ;
    sen0414:code "rows = [('AK', 'Anchorage', 4115), ('AK', 'Anchorage', 3040),\n        ('AL', 'Autauga', 1912), ('AL', 'Autauga', 2170)]\ncounty_data = {}\nfor state, county, pop in rows:\n    county_data.setdefault(state, {})\n    county_data[state].setdefault(county, {'tracts': 0, 'pop': 0})\n    county_data[state][county]['tracts'] += 1\n    county_data[state][county]['pop'] += pop\nprint(county_data)" ; sen0414:expectedOutput "{'AK': {'Anchorage': {'tracts': 2, 'pop': 7155}}, 'AL': {'Autauga': {'tracts': 2, 'pop': 4082}}}\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_10 .
pg:CE_11 a ipo:CodeExample ; rdfs:label "pprint.pformat writes the result as Python"@en ;
    skos:definition "Example 11 of the chapter-code tab comes from slide 24 of the deck and runs 8 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 24 ; sen0414:orderInTab 11 ;
    sen0414:code "import pprint\ncounty_data = {'AK': {'Anchorage': {'tracts': 2, 'pop': 7155}},\n               'AL': {'Autauga': {'tracts': 2, 'pop': 4082}}}\ntext = 'allData = ' + pprint.pformat(county_data)\nprint(text)\nns = {}\nexec(text, ns)\nprint(ns['allData']['AK']['Anchorage']['pop'])" ; sen0414:expectedOutput "allData = {'AK': {'Anchorage': {'pop': 7155, 'tracts': 2}},\n 'AL': {'Autauga': {'pop': 4082, 'tracts': 2}}}\n7155\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_11 .
pg:CE_12 a ipo:CodeExample ; rdfs:label "Project 10: correct the prices"@en ;
    skos:definition "Example 12 of the chapter-code tab comes from slide 25 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 25 ; sen0414:orderInTab 12 ;
    sen0414:code "import openpyxl\nws = openpyxl.Workbook().active\nws.append(['PRODUCE', 'COST PER POUND', 'POUNDS SOLD', 'TOTAL'])\nws.append(['Garlic', 1.19, 10.0, '=ROUND(B2*C2,2)'])\nws.append(['Celery', 3.07, 4.5, '=ROUND(B3*C3,2)'])\nupdates = {'Garlic': 3.07, 'Celery': 1.19}\nfor row in range(2, ws.max_row + 1):\n    name = ws.cell(row=row, column=1).value\n    if name in updates:\n        ws.cell(row=row, column=2).value = updates[name]\nprint([ws.cell(row=r, column=2).value for r in range(2, 4)])" ; sen0414:expectedOutput "[3.07, 1.19]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_12 .
pg:CE_13 a ipo:CodeExample ; rdfs:label "Writing a workbook: sheets and save"@en ;
    skos:definition "Example 13 of the chapter-code tab comes from slide 28 of the deck and runs 11 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 28 ; sen0414:orderInTab 13 ;
    sen0414:code "import io, openpyxl\nwb = openpyxl.Workbook()\nwb.active.title = 'Spam Bacon Eggs Sheet'\nwb['Spam Bacon Eggs Sheet']['A1'] = 'Hello, world!'\nwb.create_sheet(index=0, title='First Sheet')\nwb.create_sheet(index=2, title='Middle Sheet')\nwb.remove(wb['Middle Sheet'])\nprint(wb.sheetnames)\nbuf = io.BytesIO(); wb.save(buf)\ncopy = openpyxl.load_workbook(buf)\nprint(copy.sheetnames, copy['Spam Bacon Eggs Sheet']['A1'].value)" ; sen0414:expectedOutput "['First Sheet', 'Spam Bacon Eggs Sheet']\n['First Sheet', 'Spam Bacon Eggs Sheet'] Hello, world!\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_13 .
pg:CE_14 a ipo:CodeExample ; rdfs:label "A formula is text; the result is cached"@en ;
    skos:definition "Example 14 of the chapter-code tab comes from slide 29 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 29 ; sen0414:orderInTab 14 ;
    sen0414:code "import io, openpyxl\nws = openpyxl.Workbook().active\nws['A1'], ws['A2'] = 200, 300\nws['A3'] = '=SUM(A1:A2)'\nprint(ws['A3'].value, ws['A3'].data_type)\nbuf = io.BytesIO(); ws.parent.save(buf)\nkept = openpyxl.load_workbook(buf)['Sheet']\ncached = openpyxl.load_workbook(buf, data_only=True)['Sheet']\nprint(kept['A3'].value, '|', cached['A3'].value)" ; sen0414:expectedOutput "=SUM(A1:A2) f\n=SUM(A1:A2) | None\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_14 .
pg:CE_15 a ipo:CodeExample ; rdfs:label "ROUND in a spreadsheet and round in Python"@en ;
    skos:definition "Example 15 of the chapter-code tab comes from slide 31 of the deck and runs 5 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 31 ; sen0414:orderInTab 15 ;
    sen0414:code "from decimal import Decimal, ROUND_HALF_UP\nfor text in ('0.125', '1.005', '2.675', '65.205'):\n    x = float(text)\n    up = Decimal(text).quantize(Decimal('0.01'), ROUND_HALF_UP)\n    print(text, round(x, 2), up)" ; sen0414:expectedOutput "0.125 0.12 0.13\n1.005 1.0 1.01\n2.675 2.67 2.68\n65.205 65.2 65.21\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_15 .
pg:CE_16 a ipo:CodeExample ; rdfs:label "Blank Row Inserter and insert_rows"@en ;
    skos:definition "Example 16 of the chapter-code tab comes from slide 33 of the deck and runs 9 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 33 ; sen0414:orderInTab 16 ;
    sen0414:code "import sys, openpyxl\nsys.argv = ['blankRowInserter.py', '3', '2']\nws = openpyxl.Workbook().active\nfor i in range(1, 6): ws.append(['row %d' % i, i])\nws['B6'] = '=SUM(B1:B5)'\nstart, count = int(sys.argv[1]), int(sys.argv[2])\nws.insert_rows(start, count)\nprint([ws.cell(row=r, column=1).value for r in range(1, 8)])\nprint(ws['B8'].value)" ; sen0414:expectedOutput "['row 1', 'row 2', None, None, 'row 3', 'row 4', 'row 5']\n=SUM(B1:B5)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_16 .
pg:CE_17 a ipo:CodeExample ; rdfs:label "Practice Program: a multiplication table"@en ;
    skos:definition "Example 17 of the chapter-code tab comes from slide 37 of the deck and runs 10 lines of Python that print 5 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 37 ; sen0414:orderInTab 17 ;
    sen0414:code "import openpyxl\nfrom openpyxl.styles import Font\nN = 4\nws = openpyxl.Workbook().active\nfor i in range(1, N + 1):\n    ws.cell(row=1, column=i + 1, value=i).font = Font(bold=True)\n    ws.cell(row=i + 1, column=1, value=i).font = Font(bold=True)\n    for j in range(1, N + 1):\n        ws.cell(row=i + 1, column=j + 1, value=i * j)\nfor row in ws.iter_rows(values_only=True): print(row)" ; sen0414:expectedOutput "(None, 1, 2, 3, 4)\n(1, 1, 2, 3, 4)\n(2, 2, 4, 6, 8)\n(3, 3, 6, 9, 12)\n(4, 4, 8, 12, 16)\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_17 .
pg:CE_18 a ipo:CodeExample ; rdfs:label "Fonts: Font() keeps only what it is given"@en ;
    skos:definition "Example 18 of the chapter-code tab comes from slide 38 of the deck and runs 9 lines of Python that print 4 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 38 ; sen0414:orderInTab 18 ;
    sen0414:code "import openpyxl\nfrom openpyxl.styles import Font\nws = openpyxl.Workbook().active\nws['A1'].font = Font(size=24, italic=True)\nws['B3'].font = Font(name='Times New Roman', bold=True)\nfor c in (ws['A1'], ws['B3'], ws['C5']):\n    print(c.coordinate, c.font.name, c.font.sz, c.font.b)\ntry: ws['A1'].font.bold = True\nexcept AttributeError as e: print('AttributeError:', e)" ; sen0414:expectedOutput "A1 None 24.0 False\nB3 Times New Roman None True\nC5 Calibri 11.0 False\nAttributeError: Style objects are immutable and cannot be changed.Reassign the style with a copy\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_18 .
pg:CE_19 a ipo:CodeExample ; rdfs:label "Row height, column width and hidden columns"@en ;
    skos:definition "Example 19 of the chapter-code tab comes from slide 39 of the deck and runs 9 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 39 ; sen0414:orderInTab 19 ;
    sen0414:code "import openpyxl\nws = openpyxl.Workbook().active\nws['A5'], ws['B5'] = 'Tall row', 'Wide column'\nws.row_dimensions[5].height = 70\nws.column_dimensions['B'].width = 20\nws.column_dimensions['D'].hidden = True\nprint(ws.row_dimensions[5].height, ws.column_dimensions['B'].width)\nprint(ws.column_dimensions['D'].hidden)\nprint(sorted(ws.column_dimensions), sorted(ws.row_dimensions))" ; sen0414:expectedOutput "70.0 20.0\nTrue\n['B', 'D'] [5]\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_19 .
pg:CE_20 a ipo:CodeExample ; rdfs:label "Merged cells keep one real cell"@en ;
    skos:definition "Example 20 of the chapter-code tab comes from slide 40 of the deck and runs 11 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 40 ; sen0414:orderInTab 20 ;
    sen0414:code "import openpyxl\nws = openpyxl.Workbook().active\nws.merge_cells('F1:I3')\nws['F1'] = 'Twelve cells merged together.'\nprint(*ws.merged_cells.ranges, type(ws['G2']).__name__)\ntry:\n    ws['G2'] = 'x'\nexcept AttributeError as e:\n    print('AttributeError:', e)\nws.unmerge_cells('F1:I3')\nprint(len(ws.merged_cells.ranges), type(ws['G2']).__name__)" ; sen0414:expectedOutput "F1:I3 MergedCell\nAttributeError: 'MergedCell' object attribute 'value' is read-only\n0 Cell\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_20 .
pg:CE_21 a ipo:CodeExample ; rdfs:label "Freeze panes"@en ;
    skos:definition "Example 21 of the chapter-code tab comes from slide 41 of the deck and runs 6 lines of Python that print 3 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 41 ; sen0414:orderInTab 21 ;
    sen0414:code "import openpyxl\nfor setting in ('A2', 'B1', 'C2'):\n    ws = openpyxl.Workbook().active\n    ws.freeze_panes = setting\n    pane = ws.sheet_view.pane\n    print(setting, pane.xSplit, pane.ySplit)" ; sen0414:expectedOutput "A2 None 1.0\nB1 1.0 None\nC2 2.0 1.0\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_21 .
pg:CE_22 a ipo:CodeExample ; rdfs:label "A bar chart: Reference, Series, BarChart"@en ;
    skos:definition "Example 22 of the chapter-code tab comes from slide 44 of the deck and runs 11 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 44 ; sen0414:orderInTab 22 ;
    sen0414:code "import openpyxl\nfrom openpyxl.chart import BarChart, Reference, Series\nws = openpyxl.Workbook().active\nfor i in range(1, 11): ws['A%d' % i] = i * i\nref = Reference(ws, 1, 1, 1, 10)\nseries = Series(ref, title='First series')\nchart = BarChart()\nchart.title = 'My Chart'\nchart.append(series)\nws.add_chart(chart, 'C2')\nprint(ref, len(ws._charts))" ; sen0414:expectedOutput "'Sheet'!$A$1:$A$10 1\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_22 .
pg:CE_23 a ipo:CodeExample ; rdfs:label "Reference takes the column first"@en ;
    skos:definition "Example 23 of the chapter-code tab comes from slide 45 of the deck and runs 7 lines of Python that print 2 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 45 ; sen0414:orderInTab 23 ;
    sen0414:code "import openpyxl\nfrom openpyxl.chart import Reference\nws = openpyxl.Workbook().active\ncolumn_b = Reference(ws, 2, 1, 2, 10)\nrow_2 = Reference(ws, 1, 2, 10, 2)\nprint(column_b)\nprint(row_2)" ; sen0414:expectedOutput "'Sheet'!$B$1:$B$10\n'Sheet'!$A$2:$J$2\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_23 .
pg:CE_24 a ipo:CodeExample ; rdfs:label "A chart is stored as XML in the zip"@en ;
    skos:definition "Example 24 of the chapter-code tab comes from slide 46 of the deck and runs 9 lines of Python that print 1 lines of output."@en ; dcterms:source "03-materials/ch14/page/chapter_code_ch14_v1_0_0.json" ;
    sen0414:slideNumber 46 ; sen0414:orderInTab 24 ;
    sen0414:code "import io, zipfile, openpyxl\nfrom openpyxl.chart import BarChart, Reference\nws = openpyxl.Workbook().active\nfor v in (1, 4, 9): ws.append([v])\nchart = BarChart(); chart.add_data(Reference(ws, 1, 1, 1, 3))\nws.add_chart(chart, 'C2')\nbuf = io.BytesIO(); ws.parent.save(buf)\nnames = sorted(zipfile.ZipFile(buf).namelist())\nprint([n for n in names if 'chart' in n or 'drawing' in n])" ; sen0414:expectedOutput "['xl/charts/chart1.xml', 'xl/drawings/_rels/drawing1.xml.rels', 'xl/drawings/drawing1.xml']\n" .
pg:Tabs_learn sen0414:hasExample pg:CE_24 .
