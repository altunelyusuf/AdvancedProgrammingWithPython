 "python": "Python 3.14.4",
 "quiz": [
  {
   "q": "What does 2 + 3 * 6 evaluate to?",
   "options": [
    "20",
    "30",
    "36"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO1",
   "rationales": [
    "30 is what you get if + ran first; * binds tighter than +.",
    "36 would need (2 + 4) * 6; nothing in the expression groups that way."
   ]
  },
  {
   "q": "Why does 0.1 + 0.2 not print 0.3?",
   "options": [
    "Floats are stored in binary, and 0.1 has no exact binary form",
    "Python rounds floats badly",
    "It is a bug fixed in Python 3.14"
   ],
   "answer": 0,
   "level": "Understand",
   "objective": "CO2",
   "rationales": [
    "Python does not round the sum at all - it shows the nearest binary value exactly.",
    "It is not a bug: Python 3.14.4 prints the same result, because the cause is binary representation."
   ]
  },
  {
   "q": "What type of value does input() return when the user types 42?",
   "options": [
    "A string",
    "An integer",
    "Whatever type the user intended"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO3",
   "rationales": [
    "input() never converts: digits arrive as text until int() converts them.",
    "Python cannot know intent; input() always returns a string."
   ]
  },
  {
   "q": "What happens when you run 'Alice' + 42?",
   "options": [
    "It raises a TypeError",
    "It gives 'Alice42'",
    "It gives 42"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO3",
   "rationales": [
    "Python does not convert 42 to text silently; you must write str(42).",
    "+ never discards its left operand; the operation fails instead."
   ]
  },
  {
   "q": "Which is the modern way to build 'Hello, Alice!' from name = 'Alice'?",
   "options": [
    "f'Hello, {name}!'",
    "'Hello, ' + name + '!'",
    "'Hello, ' * name"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO4",
   "rationales": [
    "Concatenation works, but every value must already be a string and it is harder to read; f-strings are the current idiom (PEP 701).",
    "* repeats a string by an integer; a string name cannot be a repeat count."
   ]
  }
 ],
