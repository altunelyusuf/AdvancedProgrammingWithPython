 "quiz": [
  {
   "q": "What does 42 == '42' evaluate to?",
   "options": [
    "False",
    "True",
    "It raises a TypeError"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO1",
   "rationales": [
    "An integer never equals a string, even one with the same digits.",
    "== between different types is allowed; it simply answers False."
   ]
  },
  {
   "q": "What does bool('0') evaluate to?",
   "options": [
    "True",
    "False",
    "0"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO1",
   "rationales": [
    "Only the empty string is false; '0' is a non-empty string.",
    "bool always returns True or False, never the original value."
   ]
  },
  {
   "q": "What does '' or 'default' return?",
   "options": [
    "'default'",
    "True",
    "''"
   ],
   "answer": 0,
   "level": "Understand",
   "objective": "CO2",
   "rationales": [
    "or returns one of its operands, not a Boolean.",
    "The empty string is false, so or moves on to the second operand."
   ]
  },
  {
   "q": "In an if-elif-else chain, how many branches can run?",
   "options": [
    "At most one",
    "All whose conditions are true",
    "Exactly two"
   ],
   "answer": 0,
   "level": "Apply",
   "objective": "CO3",
   "rationales": [
    "Separate if statements would test every condition; elif stops at the first true one.",
    "Nothing forces two; with no true condition and no else, none runs."
   ]
  },
  {
   "q": "When is a match statement the better choice over an elif chain?",
   "options": [
    "When one value is compared against many possible shapes or values",
    "When there is a single yes-or-no condition",
    "Never; match is only for Python 3.14"
   ],
   "answer": 0,
   "level": "Analyze",
   "objective": "CO4",
   "rationales": [
    "A single condition is clearest as a plain if.",
    "match has existed since Python 3.10."
   ]
  }
 ]
