    backlog:hasGapReason "The urgent lineage changes the deck at its creation only (the rulings of 2026-11-27 are changes of form); this stage is not part of the urgent scope and is recorded here, not left silent." .
ex:Gap15_Deck_Termination a backlog:BlueprintGap ; rdfs:label "Gap: Deck at Termination"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:gapForEntity ex:DE15_Deck ; backlog:gapForStage backlog:Stage_Termination ;
    backlog:hasGapReason "The urgent lineage changes the deck at its creation only (the rulings of 2026-11-27 are changes of form); this stage is not part of the urgent scope and is recorded here, not left silent." .
ex:ST15_Sources_Clean backlog:coversEntity ex:DE15_Source ; backlog:coversStage backlog:Stage_Creation .
ex:Gap15_Source_ActiveUse a backlog:BlueprintGap ; rdfs:label "Gap: Source at ActiveUse"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:gapForEntity ex:DE15_Source ; backlog:gapForStage backlog:Stage_ActiveUse ;
    backlog:hasGapReason "The urgent lineage changes the source at its creation only (the rulings of 2026-11-27 are changes of form); this stage is not part of the urgent scope and is recorded here, not left silent." .
