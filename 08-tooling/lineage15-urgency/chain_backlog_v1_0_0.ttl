@prefix backlog: <http://example.org/backlog#> .
@prefix ex: <http://example.org/sen0414-ch2125corr-lineage#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:Backlog15 a backlog:Backlog ; rdfs:label "Urgent backlog: slide source code tab and code-slide standard for all chapters"@en ; backlog:appliesDefinitionOfDone ex:DoD14 ; backlog:backlogForMission ex:Mission15 ;
    backlog:belongsToLineage ex:Lineage15 ; backlog:hasIdentifier "Backlog_SEN0414_Urgent15" ; backlog:memberOfContainer ex:Register_Ch2125corr ;
    backlog:hasBacklogMember ex:ST15_Pages_Ch1_9 , ex:ST15_Exam_Open , ex:ST15_Sources_Clean , ex:ST15_Decks_CodeSlides , ex:ST15_Rollout_Reverify ; backlog:hasCommitment ex:Commit15 .
ex:Commit15 a backlog:Commitment ; rdfs:label "This backlog commits to chapters that meet the rulings of 2026-11-27"@en ; backlog:commitsToDefinitionOfDone ex:DoD14 ; backlog:commitsToGoal ex:G15_Mission ; backlog:commitsToObjective ex:Obj15_ChaptersMeeting .
ex:ST15_Pages_Ch1_9 backlog:memberOfContainer ex:Backlog15 ; backlog:pursuesObjective ex:Obj15_PagesLambda , ex:Obj15_PagesTab , ex:Obj15_PagesOpen ; backlog:satisfiesDeliverable ex:Del15_Pages_Tab , ex:Del15_Pages_NoLambda , ex:Del15_Pages_NoMeta .
ex:ST15_Exam_Open backlog:memberOfContainer ex:Backlog15 ; backlog:pursuesObjective ex:Obj15_PagesOpen ; backlog:satisfiesDeliverable ex:Del15_Pages_Tab .
ex:ST15_Sources_Clean backlog:memberOfContainer ex:Backlog15 ; backlog:pursuesObjective ex:Obj15_SourcesMeta ; backlog:satisfiesDeliverable ex:Del15_Sources_Clean .
ex:ST15_Decks_CodeSlides backlog:memberOfContainer ex:Backlog15 ; backlog:pursuesObjective ex:Obj15_CodeSlides , ex:Obj15_PresenterNotes ; backlog:satisfiesDeliverable ex:Del15_Decks_Code , ex:Del15_Decks_Notes .
ex:ST15_Rollout_Reverify backlog:memberOfContainer ex:Backlog15 ; backlog:pursuesObjective ex:Obj15_Reverified ; backlog:satisfiesDeliverable ex:Del15_Route_Record .
ex:Obj15_PagesTab backlog:metricMovableBy ex:ST15_Pages_Ch1_9 .
ex:Obj15_PagesOpen backlog:metricMovableBy ex:ST15_Pages_Ch1_9 , ex:ST15_Exam_Open .
ex:Obj15_PagesLambda backlog:metricMovableBy ex:ST15_Pages_Ch1_9 .
ex:Obj15_CodeSlides backlog:metricMovableBy ex:ST15_Decks_CodeSlides .
ex:Obj15_PresenterNotes backlog:metricMovableBy ex:ST15_Decks_CodeSlides .
ex:Obj15_SourcesMeta backlog:metricMovableBy ex:ST15_Sources_Clean .
ex:Obj15_Reverified backlog:metricMovableBy ex:ST15_Rollout_Reverify .
ex:Obj15_ChaptersMeeting backlog:metricMovableBy ex:ST15_Pages_Ch1_9 , ex:ST15_Decks_CodeSlides .
ex:DE15_Page a backlog:DomainEntity ; rdfs:label "Page - a chapter's interactive page that runs the slide code"@en ; backlog:belongsToLineage ex:Lineage15 .
ex:DE15_Deck a backlog:DomainEntity ; rdfs:label "Deck - a chapter's slides with code slides and reader notes"@en ; backlog:belongsToLineage ex:Lineage15 .
ex:DE15_Source a backlog:DomainEntity ; rdfs:label "Source - a corpus, generator or A-box a page is built from"@en ; backlog:belongsToLineage ex:Lineage15 .
ex:Blueprint15 a backlog:Blueprint ; rdfs:label "What the urgent rulings of 2026-11-27 are about"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:blueprintFor ex:Backlog15 ; backlog:hasDomainEntity ex:DE15_Page , ex:DE15_Deck , ex:DE15_Source .
ex:Session15_Backlog a backlog:RegisterSession ; rdfs:label "The session that wrote the backlog stage of Lineage15"@en ; backlog:sessionConductedBy "claude-session" ;
    backlog:sessionFor ex:Backlog15 ; backlog:sessionStartedAt "2026-11-27T17:00:00"^^xsd:dateTime ; backlog:sessionEndedAt "2026-11-27T17:30:00"^^xsd:dateTime ; backlog:stateVerifiedAtStart true ;
    backlog:hasSessionScopeNote "Set out to write the Backlog stage only: Backlog15, the commitment, the links of the stories to their objectives and deliverables, which story can move which metric, a blueprint, and the cancellation of ST15_Page_Ch25. Left alone: planning events, iterations and every work file. Verified first: the objective stage 1.29.0 was committed and the working tree held only the stage files." .
ex:ST15_Pages_Ch1_9 backlog:coversEntity ex:DE15_Page ; backlog:coversStage backlog:Stage_Creation .
ex:Gap15_Page_ActiveUse a backlog:BlueprintGap ; rdfs:label "Gap: Page at ActiveUse"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:gapForEntity ex:DE15_Page ; backlog:gapForStage backlog:Stage_ActiveUse ;
    backlog:hasGapReason "The urgent lineage changes the page at its creation only (the rulings of 2026-11-27 are changes of form); this stage is not part of the urgent scope and is recorded here, not left silent." .
ex:Gap15_Page_SuspensionException a backlog:BlueprintGap ; rdfs:label "Gap: Page at SuspensionException"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:gapForEntity ex:DE15_Page ; backlog:gapForStage backlog:Stage_SuspensionException ;
    backlog:hasGapReason "The urgent lineage changes the page at its creation only (the rulings of 2026-11-27 are changes of form); this stage is not part of the urgent scope and is recorded here, not left silent." .
ex:Gap15_Page_Termination a backlog:BlueprintGap ; rdfs:label "Gap: Page at Termination"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:gapForEntity ex:DE15_Page ; backlog:gapForStage backlog:Stage_Termination ;
    backlog:hasGapReason "The urgent lineage changes the page at its creation only (the rulings of 2026-11-27 are changes of form); this stage is not part of the urgent scope and is recorded here, not left silent." .
ex:ST15_Decks_CodeSlides backlog:coversEntity ex:DE15_Deck ; backlog:coversStage backlog:Stage_Creation .
ex:Gap15_Deck_ActiveUse a backlog:BlueprintGap ; rdfs:label "Gap: Deck at ActiveUse"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:gapForEntity ex:DE15_Deck ; backlog:gapForStage backlog:Stage_ActiveUse ;
    backlog:hasGapReason "The urgent lineage changes the deck at its creation only (the rulings of 2026-11-27 are changes of form); this stage is not part of the urgent scope and is recorded here, not left silent." .
