    backlog:hasGoalStatement "Every chapter page has the Slide source code tab, shows the exam result and answers after finishing, asks questions about the subject and its code only, and has no lambda unless the chapter teaches it." ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCoversArea ex:Area15_Pages .
ex:G15_DecksTeach a backlog:Goal ; rdfs:label "The decks explain each code slide and speak to the reader"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:contributesToMission ex:Mission15 ; backlog:decidedBy backlog:Owner ;
