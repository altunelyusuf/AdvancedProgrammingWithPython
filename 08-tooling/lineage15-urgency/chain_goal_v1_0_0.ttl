ex:G15_Mission a backlog:Goal ; rdfs:label "Every chapter can be lectured from and learned from under the rulings of 2026-11-27"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:contributesToMission ex:Mission15 ; backlog:decidedBy backlog:Owner ;
    backlog:derivesFromScope ex:Scope15 ; backlog:goalCompletionState backlog:Proposed ; backlog:goalForMission ex:Mission15 ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:hasGoalStatement "A lecturer and a student find in every chapter of SEN0414 a page that runs the slide code and a deck that explains meaning, reason and idea, as the rulings state." ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted .
ex:G15_PagesTeach a backlog:Goal ; rdfs:label "The pages run the slide code, open the exam answers, ask about the subject and teach no lambda"@en ; backlog:belongsToLineage ex:Lineage15 ; backlog:contributesToMission ex:Mission15 ; backlog:decidedBy backlog:Owner ;
