@prefix ex: <http://example.org/sen0414-ch2125corr-lineage#> .
@prefix backlog: <http://example.org/backlog#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Ev15_Rollout_Reverify a backlog:TestEvidence ;
    rdfs:label "Page tests of the 23 pages of the rollout re-run from the files, no failed check"@en ;
    backlog:belongsToLineage ex:Lineage15 ;
    backlog:attestsCriterion ex:AC15_Rollout_Reverify ;
    backlog:hasTestId "page_logs/ch01..ch24 without ch11" ;
    backlog:hasTestSpec "08-tooling/sen0414_page_test_v9_44_0.py" ;
    backlog:verifiedByTool "08-tooling/lineage15-urgency/page_logs: one log per page written by sen0414_page_test_v9_43_0.py (chapters 10, 12 to 14) or by 9.44.0, which differs only in running the diagram audit in a browser of its own (chapters 7 and 15 to 24), on the newest page of the chapter; the command given to the evidence bridge passes only when all 23 logs exist, each reaches the end of the test (the WCAG line) and none holds a failed check" .

ex:Harness15_Rollout_Reverify a backlog:TestHarness ;
    rdfs:label "Page test harness for the story of the 23 pages"@en ;
    backlog:harnessFor ex:ST15_Rollout_Reverify ;
    backlog:harnessComplete true ;
    backlog:hasHarnessEvidence ex:Ev15_Rollout_Reverify .
ex:Harness15_Rollout_Reverify_1 a backlog:TestHarness ;
    rdfs:label "Page test harness for the build task of the 23 pages"@en ;
    backlog:harnessFor ex:TK15_Rollout_Reverify_1 ;
    backlog:harnessComplete true ;
    backlog:hasHarnessEvidence ex:Ev15_Rollout_Reverify .
ex:Harness15_Rollout_Reverify_2 a backlog:TestHarness ;
    rdfs:label "Page test harness for the verify task of the 23 pages"@en ;
    backlog:harnessFor ex:TK15_Rollout_Reverify_2 ;
    backlog:harnessComplete true ;
    backlog:hasHarnessEvidence ex:Ev15_Rollout_Reverify .

ex:Obs15_Reverified_1 a backlog:MetricObservation ;
    rdfs:label "Pages of the rollout re-verified under the route"@en ;
    backlog:observesMetric ex:Metric_Obj15_Reverified ;
    backlog:observationFor ex:Obj15_Reverified ;
    backlog:hasObservedValue "23"^^xsd:decimal ;
    backlog:observedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted the re-verification logs kept in 08-tooling/lineage15-urgency/page_logs for chapters 1 to 10 and 12 to 24: 23 logs, each ends with the WCAG line and holds no failed check." .
ex:Obs15_PagesLambda_2 a backlog:MetricObservation ;
    rdfs:label "Lambda words in the newest pages of chapters 1 to 24 after the rollout was re-verified"@en ;
    backlog:observesMetric ex:Metric_Obj15_PagesLambda ;
    backlog:observationFor ex:Obj15_PagesLambda ;
    backlog:hasObservedValue "1"^^xsd:decimal ;
    backlog:observedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted pages of chapters 1 to 24 whose newest file contains lambda (case-insensitive): only chapter 22, whose sample alphabet for text recognition holds the Greek letter name; it is not code and the chapter is Lineage14's." .
ex:Obs15_PagesTab_2 a backlog:MetricObservation ;
    rdfs:label "Pages with the Slide source code tab after the rollout was re-verified"@en ;
    backlog:observesMetric ex:Metric_Obj15_PagesTab ;
    backlog:observationFor ex:Obj15_PagesTab ;
    backlog:hasObservedValue "24"^^xsd:decimal ;
    backlog:observedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted the newest pages of chapters 1 to 24 that contain the text Slide source code: 24 of 24." .
ex:Obs15_PagesOpen_2 a backlog:MetricObservation ;
    rdfs:label "Pages with the Open result and answers button after the rollout was re-verified"@en ;
    backlog:observesMetric ex:Metric_Obj15_PagesOpen ;
    backlog:observationFor ex:Obj15_PagesOpen ;
    backlog:hasObservedValue "24"^^xsd:decimal ;
    backlog:observedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted the newest pages of chapters 1 to 24 that contain the text Open result and answers: 24 of 24." .

ex:Complete15_Rollout_Reverify a backlog:TransitionEvent ;
    backlog:transitionedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:transitionedBy backlog:Owner ;
    backlog:transitionedByExecutor ex:Executor_ClaudeCodeSession ;
    backlog:transitionedItem ex:ST15_Rollout_Reverify ;
    backlog:viaTransition backlog:T_Complete .

ex:ST15_Rollout_Reverify backlog:startedAt "2026-11-28T00:25:00+00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:lastAuditedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:hasEvidence ex:Ev15_Rollout_Reverify ;
    backlog:hasExecutionModality backlog:Mode_Hybrid .
ex:TK15_Rollout_Reverify_1 backlog:startedAt "2026-11-28T00:25:00+00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-11-28T03:00:00+00:00"^^xsd:dateTime ;
    backlog:lastAuditedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:hasEvidence ex:Ev15_Rollout_Reverify .
ex:TK15_Rollout_Reverify_2 backlog:startedAt "2026-11-28T01:00:00+00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:lastAuditedAt "2026-11-28T03:15:00+00:00"^^xsd:dateTime ;
    backlog:hasEvidence ex:Ev15_Rollout_Reverify .

ex:Find15_PagesLambdaQuery a backlog:RetrospectiveFinding ;
    rdfs:label "The lambda objective measures a word, so a Greek letter name holds it above its target"@en ;
    backlog:relatesToWorkItem ex:ST15_Rollout_Reverify ;
    backlog:hasFindingScope backlog:Scope_LineageLocal ;
    backlog:hasRootCause "The measurement query of the lambda objective counts the case-insensitive word lambda in the newest page of each chapter. Chapter 22 holds the name of the Greek letter in a sample alphabet for text recognition, which is not code, so after both stories the count stays at 1 although no page has a lambda in code; the story could not move a measure that counts something it does not mean." ;
    backlog:hasRemedy "Correct the measurement query to count lambda expressions in the code of the page (the code boxes, examples, bank and Playground samples that the page test checks) and keep the Greek-letter sample out of it; the correction belongs to the story that mends the chapter 22 query." .
