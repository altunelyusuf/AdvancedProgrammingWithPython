ex:Lineage15 a backlog:Lineage ;
    rdfs:label "Urgent lineage: slide source code tab and code-slide standard for all SEN0414 chapters"@en ;
    backlog:hasProfile backlog:Profile_AAL ;
    backlog:lineageArchived false ;
    backlog:lineageOrdinal 15 ;
    backlog:hasLineageStatus backlog:LS_Opened ;
    backlog:hasAuditNote "Seed of 2026-11-27: opened by the urgency declaration (G195 b) on the owner's rulings of 2026-11-27 for all chapters (a Slide source code tab on every page, open exam answers, no metadata questions, the chapter 11 code-slide standard). Work was built before this route was set (23 pages and the chapter 11 deck and page, commit e7ce395): it is named in story Rollout_Reverify and recorded as a bypass, not backfilled."@en .
ex:ST15_Pages_Ch1_9 a backlog:Story ; rdfs:label "Rebuild the pages of chapters 1 to 9 on template 9.56.0 so that no lambda remains and the Slide source code tab, open exam answers and metadata-free questions are present"@en ; backlog:hasIdentifier "ST15_Pages_Ch1_9" ; backlog:belongsToLineage ex:Lineage15 ;
    backlog:hasState backlog:Proposed ; backlog:responsible ex:Executor_ClaudeCodeSession ; backlog:hasInvestmentCategory backlog:Cat_Maintenance ;
    backlog:appliesDefinitionOfDone ex:DoD14 ; backlog:hasApplicableConcern backlog:Concern_Interaction ; backlog:hasAcceptanceCriterion ex:AC15_Pages_Ch1_9 ;
    backlog:decomposesInto ex:TK15_Pages_Ch1_9_1, ex:TK15_Pages_Ch1_9_2 ; backlog:standsAlone true ; backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Scored at planning, when the urgent lineage's packages and sprints are cut." .
ex:AC15_Pages_Ch1_9 a backlog:AcceptanceCriterion ; rdfs:label "Rebuild the pages of chapters 1 to 9 on template 9.56.0 so that no lambda remains and the Slide source code tab, open exam answers and metadata-free questions are present: acceptance"@en ; backlog:belongsToLineage ex:Lineage15 ;
    backlog:hasGherkinText "Given the pages of chapters 1 to 9 that still carry lambda strings When they are rebuilt from their page builders on template 9.56.0 Then no lambda string remains in any page, the Slide source code tab runs every slide example, the exam result and answers open after finishing and no question or node is about book metadata" ; backlog:satisfiedByArtifact "the nine page files, their build logs and the page-test logs" .
