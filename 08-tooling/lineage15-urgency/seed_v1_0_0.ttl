    backlog:hasState backlog:Proposed ; backlog:appliesDefinitionOfDone ex:DoD14 ; backlog:hasTaskType backlog:Task_Implementation ;
    backlog:responsible ex:Executor_ClaudeCodeSession ; backlog:hasInvestmentCategory backlog:Cat_Maintenance .
