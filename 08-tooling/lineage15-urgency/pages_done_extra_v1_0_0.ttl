@prefix ex: <http://example.org/sen0414-ch2125corr-lineage#> .
@prefix backlog: <http://example.org/backlog#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Ev15_Pages_Ch1_9 a backlog:TestEvidence ;
    rdfs:label "Page tests of chapters 1 to 9 re-run from the files, no failed check"@en ;
    backlog:belongsToLineage ex:Lineage15 ;
    backlog:attestsCriterion ex:AC15_Pages_Ch1_9 ;
    backlog:hasTestId "page_logs/ch01..ch09" ;
    backlog:hasTestSpec "08-tooling/sen0414_page_test_v9_43_0.py" ;
    backlog:verifiedByTool "08-tooling/lineage15-urgency/page_logs: one log per chapter written by sen0414_page_test_v9_43_0.py run on the newest page of the chapter (ch01 v9_96_0, ch02 v9_95_0, ch03 v9_95_0, ch04 v9_95_0, ch05 v9_94_0, ch06 v9_94_0, ch07 v9_94_0, ch08 v9_95_0, ch09 v9_93_0); the command given to the evidence bridge passes only when all nine logs exist and none holds a failed check" .

ex:Harness15_Pages_Ch1_9 a backlog:TestHarness ;
    rdfs:label "Page test harness for the story of chapters 1 to 9"@en ;
    backlog:harnessFor ex:ST15_Pages_Ch1_9 ;
    backlog:harnessComplete true ;
    backlog:hasHarnessEvidence ex:Ev15_Pages_Ch1_9 .
ex:Harness15_Pages_Ch1_9_1 a backlog:TestHarness ;
    rdfs:label "Page test harness for the build task of chapters 1 to 9"@en ;
    backlog:harnessFor ex:TK15_Pages_Ch1_9_1 ;
    backlog:harnessComplete true ;
    backlog:hasHarnessEvidence ex:Ev15_Pages_Ch1_9 .
ex:Harness15_Pages_Ch1_9_2 a backlog:TestHarness ;
    rdfs:label "Page test harness for the verify task of chapters 1 to 9"@en ;
    backlog:harnessFor ex:TK15_Pages_Ch1_9_2 ;
    backlog:harnessComplete true ;
    backlog:hasHarnessEvidence ex:Ev15_Pages_Ch1_9 .

ex:Obs15_PagesLambda_1 a backlog:MetricObservation ;
    rdfs:label "Lambda words in the newest pages of chapters 1 to 24 after chapters 1 to 9 were rebuilt"@en ;
    backlog:observesMetric ex:Metric_Obj15_PagesLambda ;
    backlog:observationFor ex:Obj15_PagesLambda ;
    backlog:hasObservedValue "1"^^xsd:decimal ;
    backlog:observedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted case-insensitive occurrences of lambda in the newest page of each chapter 1 to 24: chapters 1 to 9 and 10 to 21 and 23 to 24 hold none; chapter 22 holds one, the Greek letter name in a sample alphabet for text recognition, which is not code and lies in a chapter that the scope excludes (Lineage14's). The measurement query counts the word, so the count stays 1 until the objective's query is corrected or that sample is changed in Lineage14." .

ex:Complete15_Pages_Ch1_9 a backlog:TransitionEvent ;
    backlog:transitionedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:transitionedBy backlog:Owner ;
    backlog:transitionedByExecutor ex:Executor_ClaudeCodeSession ;
    backlog:transitionedItem ex:ST15_Pages_Ch1_9 ;
    backlog:viaTransition backlog:T_Complete .

ex:ST15_Pages_Ch1_9 backlog:startedAt "2026-11-27T16:00:00+00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:lastAuditedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:hasEvidence ex:Ev15_Pages_Ch1_9 ;
    backlog:hasExecutionModality backlog:Mode_Hybrid .
ex:TK15_Pages_Ch1_9_1 backlog:startedAt "2026-11-27T16:00:00+00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-11-28T00:15:00+00:00"^^xsd:dateTime ;
    backlog:lastAuditedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:hasEvidence ex:Ev15_Pages_Ch1_9 .
ex:TK15_Pages_Ch1_9_2 backlog:startedAt "2026-11-28T00:00:00+00:00"^^xsd:dateTime ;
    backlog:finishedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:lastAuditedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:hasEvidence ex:Ev15_Pages_Ch1_9 .
ex:Obj15_PagesLambda backlog:metricMovableBy ex:ST15_Rollout_Reverify .

ex:Obs15_PagesTab_1 a backlog:MetricObservation ;
    rdfs:label "Pages with the Slide source code tab after chapters 1 to 9 were rebuilt"@en ;
    backlog:observesMetric ex:Metric_Obj15_PagesTab ;
    backlog:observationFor ex:Obj15_PagesTab ;
    backlog:hasObservedValue "24"^^xsd:decimal ;
    backlog:observedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted the newest pages of chapters 1 to 24 that contain the text Slide source code: 24 of 24." .
ex:Obs15_PagesOpen_1 a backlog:MetricObservation ;
    rdfs:label "Pages with the Open result and answers button after chapters 1 to 9 were rebuilt"@en ;
    backlog:observesMetric ex:Metric_Obj15_PagesOpen ;
    backlog:observationFor ex:Obj15_PagesOpen ;
    backlog:hasObservedValue "24"^^xsd:decimal ;
    backlog:observedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "Counted the newest pages of chapters 1 to 24 that contain the text Open result and answers: 24 of 24." .
ex:Obs15_ChaptersMeeting_1 a backlog:MetricObservation ;
    rdfs:label "Chapters whose page and deck meet all rulings after chapters 1 to 9 were rebuilt"@en ;
    backlog:observesMetric ex:Metric_Obj15_ChaptersMeeting ;
    backlog:observationFor ex:Obj15_ChaptersMeeting ;
    backlog:hasObservedValue "1"^^xsd:decimal ;
    backlog:observedAt "2026-11-28T00:20:00+00:00"^^xsd:dateTime ;
    backlog:hasObservationMethod "The page objectives (tab, open answers, lambda) are at target for chapters 1 to 9 and the other chapters except chapter 22's one Greek-letter word; the deck objectives (code slides, reader notes) are not yet at target for any chapter but 11, so the count stays at chapter 11 only." .
