@prefix backlog: <http://example.org/backlog#> .
@prefix ex: <http://example.org/sen0414-ch2125corr-lineage#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:ProfileDecl15 a backlog:ProfileDeclaration ;
    rdfs:label "Profile: AAL (agentic adaptive), default"@en ;
    backlog:declaredAt "2026-11-27T17:45:00+00:00"^^xsd:dateTime ;
    backlog:declaresLevel backlog:Level_L2 ;
    backlog:declaresProfile backlog:Profile_AAL ;
    backlog:hasDeclarationRationale "Same declaration as Lineage14: work is executed by an LLM agent, no human team; AAL is the default profile for agent-executed work. The lineage was opened by the urgency declaration of 1.25.0, not by backlog_open_lineage, because the guard is not armed in this repository (backlog_next_act armed reports NOT ARMED); the same gap holds for Lineage14, whose execution-ready check also reads the five stage outputs as missing. Disclosed here and handed to BRSF with the handover." ;
    backlog:hasIntentOrigin backlog:IOrigin_Default ;
    backlog:reviewDate "2026-12-03"^^xsd:date .
ex:Lineage15 backlog:followsProfileDeclaration ex:ProfileDecl15 .
