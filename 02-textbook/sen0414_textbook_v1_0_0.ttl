@prefix schema:  <https://schema.org/> .
@prefix cme:     <http://example.org/cme#> .
@prefix sen0414: <http://example.org/sen0414#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Textbook part - governed by IEEE LOM 1484.12.1-2020 (CME adoption: aligned). Written in Dublin Core
# and Schema.org terms under LOM's categories - general, lifecycle, rights, educational - because an
# RDF binding of LOM has not yet been verified at its steward's page; that is recorded, not hidden.
#
# A PINNED REFERENCE, not the ontology itself. By the owner's ruling of 2026-09-24 the textbook
# ontology moves into this repository after its history is resolved; until then this part points
# at it exactly, by tag and commit, and says why it is not here.

<http://example.org/sen0414/textbook> a owl:Ontology ;
    rdfs:label "SEN0414: the course textbook"@en ;
    owl:versionInfo "1.0.0" ; dcterms:identifier "sen0414_textbook_v1_0_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

sen0414:Textbook a schema:Book ;
    dcterms:title "Automate the Boring Stuff with Python, 3rd Edition" ;
    dcterms:creator "Al Sweigart" ; dcterms:publisher "No Starch Press" ;
    dcterms:issued "2025-04" ; schema:isbn "9781718503403" ; schema:numberOfPages 672 ;
    schema:url "https://automatetheboringstuff.com/3e/" ;
    dcterms:rights "The text is free to read online under a Creative Commons licence, as the book's site states. The terms of the publisher's downloadable data files are stated nowhere found, so none is redistributed here." ;
    cme:modelledBy sen0414:TextbookOntology ;
    cme:editionNote "The 3rd edition does not teach multithreading - none of its 24 chapters does. LO-4 therefore rests on the 2nd edition, chapter 17 (automatetheboringstuff.com/2e/chapter17/), and on the 1st-edition ontology's chapter 15." .

sen0414:TextbookOntology a cme:PinnedReference ;
    rdfs:label "Ontology of the 3rd edition, chapter by chapter"@en ;
    cme:pinnedRepository "altunelyusuf/Ontologies" ; cme:inFolder "automate-python-book-3e" ;
    cme:pinnedTag "automate-python-book-3e-v0.20.0" ; cme:pinnedCommit "89f68596c1fb713a14ba77e8df3858b6bae2d762" ;
    cme:whyNotHere "Its lineage holds invented timestamps and 106 items still Proposed for work that was done; the package fails today's lineage rules and cannot be published until that history is resolved by BRSF's conventions - appended corrections, retroactive closures with their basis stated, and the pre-plan extraction handled as a bypass. The owner ruled on 2026-09-24 to register SEN0414 with this pinned reference and move the ontology after." .
