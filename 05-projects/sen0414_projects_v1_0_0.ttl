# Projects part - Open Badges cited, not held (no credential is issued to an individual here).

<http://example.org/sen0414/projects> a owl:Ontology ; rdfs:label "SEN0414: projects"@en ;
    owl:versionInfo "1.0.0" ; dcterms:identifier "sen0414_projects_v1_0_0" .

sen0414:ProjectBrief a cme:ProjectBrief ; rdfs:label "Term project, 2026-2027 Fall"@en ;
    cme:termTheme "Semantic technologies" ;
    cme:briefText "Develop applications for industrial or educational use cases that benefit a real business requirement, for real users and not hypothetical ones: communicate with the users, run domain engineering and collect business requirements before the proposal. Team projects with well-defined responsibilities are favoured over individual ones." ;
    dcterms:source "The notice in the course outline, 00-course-profile." .
