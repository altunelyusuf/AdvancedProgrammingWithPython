@prefix case:    <https://purl.imsglobal.org/spec/case/v1p0/vocab#> .
@prefix ld:      <http://example.org/rdodi/learning-design#> .
@prefix cme:     <http://example.org/cme#> .
@prefix sen0414: <http://example.org/sen0414#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
#  SEN0414 Advanced Programming - learning outcomes.
#
#  Aligned to 1EdTech CASE v1.0, using CASE's own terms from its
#  published JSON-LD context
#  (purl.imsglobal.org/spec/case/v1p0/context/imscasev1p0_context_v1p0.jsonld,
#  fetched 2026-09-24, sha256 ed4e4ce9...), not re-minted: the set is a
#  CASE document, each outcome a CASE item. Cognitive levels are the
#  Bloom levels RDODI's learning-design vocabulary already defines.
#
#  Provenance. Istanbul Kultur University's ECTS catalogue page for
#  SEN0414 carries no outcomes. These were drafted by the CME session
#  from the course outline and the textbook ontologies, revised on the
#  owner's direction - an ADVANCED course, Python chosen for its
#  libraries and reach, not a language primer; no command-line
#  programs; multithreading, spreadsheets and regular expressions
#  covered - and approved by the owner on 2026-09-24T17:19:59Z with web
#  scraping added.
#################################################################

<http://example.org/sen0414/outcomes> a owl:Ontology ;
    rdfs:label "SEN0414 Advanced Programming: learning outcomes"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:identifier "sen0414_outcomes_v1_0_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

sen0414:Outcomes a case:dtCFDocument ;
    case:title "SEN0414 Advanced Programming - learning outcomes" ;
    dcterms:creator "Yusuf Altunel, drafted with the CME session" ;
    cme:approvedBy "owner" ;
    cme:approvedAt "2026-09-24T17:19:59"^^xsd:dateTime ;
    cme:forCourse cme:CR_SEN0414 ;
    dcterms:source "https://akademikpaket.iku.edu.tr/EN/ects_bolum.php?m=1&p=11&f=4&r=0&ders_id=14367&ects=ders_detay - the official catalogue page, found empty of outcomes on 2026-09-24; these fill that gap and do not claim to be the catalogue's own." .

sen0414:LearningOutcome a case:dtCFItemType ; case:title "Learning Outcome" .

sen0414:LO1 a case:dtCFItem ; case:humanCodingScheme "LO-1" ; case:CFItemType sen0414:LearningOutcome ;
    case:fullStatement "Select and apply Python's standard library and third-party packages to automate real tasks, judging which library fits a problem." ;
    cme:bloomLevel ld:Evaluate ; cme:inDocument sen0414:Outcomes ;
    dcterms:source "Automate the Boring Stuff with Python, 3rd edition, throughout: every chapter is built on a library - spreadsheets, web, PDFs, images, speech engines." .

sen0414:LO2 a case:dtCFItem ; case:humanCodingScheme "LO-2" ; case:CFItemType sen0414:LearningOutcome ;
    case:fullStatement "Build text-processing pipelines with regular expressions - groups, finding every match, substitution - to extract and transform information." ;
    cme:bloomLevel ld:Apply ; cme:inDocument sen0414:Outcomes ;
    dcterms:source "3rd edition, chapters 8-9: string methods; regular expressions, match objects, groups, finding every match, substitution." .

sen0414:LO3 a case:dtCFItem ; case:humanCodingScheme "LO-3" ; case:CFItemType sen0414:LearningOutcome ;
    case:fullStatement "Read, write and transform spreadsheet data programmatically, including cell access, presentation and saving changes." ;
    cme:bloomLevel ld:Apply ; cme:inDocument sen0414:Outcomes ;
    dcterms:source "3rd edition, chapter 14: workbooks and sheets, cell access, presentation, saving changes." .

sen0414:LO4 a case:dtCFItem ; case:humanCodingScheme "LO-4" ; case:CFItemType sen0414:LearningOutcome ;
    case:fullStatement "Design concurrent programs using threads, and reason about when concurrency helps and what it risks." ;
    cme:bloomLevel ld:Analyze ; cme:inDocument sen0414:Outcomes ;
    dcterms:source "The 3rd edition dropped multithreading - none of its 24 chapters teaches it. Grounded in the 2nd edition, chapter 17 (free at automatetheboringstuff.com/2e/chapter17/), the newest edition that teaches it, and in the 1st-edition ontology's chapter 15, which models thread lifetime, passing arguments to a thread's target, avoiding concurrency problems and waiting for threads to end. Its code predates current Python and is to be re-run before it is taught." .

sen0414:LO5 a case:dtCFItem ; case:humanCodingScheme "LO-5" ; case:CFItemType sen0414:LearningOutcome ;
    case:fullStatement "Automate work on the file system - path objects, copying, archiving, and walking folder trees safely." ;
    cme:bloomLevel ld:Apply ; cme:inDocument sen0414:Outcomes ;
    dcterms:source "3rd edition, chapters 10-11: path objects, opening and closing, copying and moving, safe deletion, archives, walking a folder tree." .

sen0414:LO6 a case:dtCFItem ; case:humanCodingScheme "LO-6" ; case:CFItemType sen0414:LearningOutcome ;
    case:fullStatement "Diagnose and harden programs with logging, tracebacks and deliberately raised exceptions." ;
    cme:bloomLevel ld:Analyze ; cme:inDocument sen0414:Outcomes ;
    dcterms:source "3rd edition, chapter 5: tracebacks, raising deliberately, logging and log levels." .

sen0414:LO7 a case:dtCFItem ; case:humanCodingScheme "LO-7" ; case:CFItemType sen0414:LearningOutcome ;
    case:fullStatement "Collect information from the web by fetching and parsing pages and by automating a browser to interact with them." ;
    cme:bloomLevel ld:Apply ; cme:inDocument sen0414:Outcomes ;
    dcterms:source "3rd edition, chapter 13: fetching a page, parsing HTML, browser automation, interacting with a page. Added by the owner at approval." .

sen0414:LO8 a case:dtCFItem ; case:humanCodingScheme "LO-8" ; case:CFItemType sen0414:LearningOutcome ;
    case:fullStatement "Develop, in a team, an automation application meeting a real user's need in the term theme, from domain engineering and requirements collection through delivery." ;
    cme:bloomLevel ld:Create ; cme:inDocument sen0414:Outcomes ;
    dcterms:source "The course outline's term theme (semantic technologies) and its project, weighted 30 per cent. The one outcome not drawn from the textbook; the project grade is what assesses it." .
