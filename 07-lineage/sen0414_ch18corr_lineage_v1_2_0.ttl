@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch18corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch18corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapter 18 corrections"@en ;
    owl:versionInfo "1.2.0" ; owl:versionIRI <http://example.org/sen0414-ch18corr-lineage/1.2.0> ; dcterms:identifier "sen0414_ch18corr_lineage" ;
    rdfs:comment "1.2.0 (2026-11-18): Goal stage only. One goal per scope area."@en .

ex:G9_SpecBuilt a backlog:Goal ; rdfs:label "Chapter 18 is described once, in a spec the generic builder runs"@en ;
    backlog:goalForMission ex:Mission9 ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasGoalStatement "The chapter 18 examples, result visuals, words and plan are held in one spec that the generic chapter deck builder runs, so that the deck is built, not patched, and the same conversion serves other chapters." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G9_DeckOnRulings a backlog:Goal ; rdfs:label "Chapter 18 deck meets the rulings"@en ;
    backlog:goalForMission ex:Mission9 ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasGoalStatement "The chapter 18 deck teaches one thing per slide, with notes that carry the lecture, plain parsing code without prompts and no lambda, and its chapter-code manifest equals its code in order." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G9_PageOnRulings a backlog:Goal ; rdfs:label "Chapter 18 page meets the rulings"@en ;
    backlog:goalForMission ex:Mission9 ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasGoalStatement "The chapter 18 page has a Slide code tab that runs the deck's code unchanged and in order, code without lambda, and passes the full page test." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G9_ReleaseChecked a backlog:Goal ; rdfs:label "Chapter 18 is released only on passed checks and recorded reviews"@en ;
    backlog:goalForMission ex:Mission9 ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasGoalStatement "Every automatic condition passes on the new deck and page and each reviewed condition has a recorded verdict from each of the three roles, before the new versions are called released." ;
    backlog:goalCompletionState backlog:Proposed .
