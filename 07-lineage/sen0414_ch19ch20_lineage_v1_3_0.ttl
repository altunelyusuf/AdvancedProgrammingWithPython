@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch19ch20-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch19ch20-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 19 and 20"@en ;
    owl:versionInfo "1.3.0" ; owl:versionIRI <http://example.org/sen0414-ch19ch20-lineage/1.3.0> ; dcterms:identifier "sen0414_ch19ch20_lineage" ;
    rdfs:comment "1.3.0 (2026-11-12): Objective stage only. Baseline observations only; the measured observations are recorded with the Backlog stage and after the work."@en .

ex:Obj8_DraftsApproved a backlog:Objective ;
    rdfs:label "Owner-approved drafts: 0 -> 2"@en ;
    backlog:objectiveForGoal ex:G8_DraftApproved ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasMetric ex:Metric_Obj8_DraftsApproved ; backlog:hasForecastDate "2026-11-14"^^xsd:date .
ex:Metric_Obj8_DraftsApproved a backlog:Metric ; rdfs:label "Count of owner-approved chapter drafts (ch19, ch20)"@en ;
    backlog:metricUnit "draft" ; backlog:metricBaseline 0 ; backlog:metricTarget 2 .
ex:Obs0_Obj8_DraftsApproved a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj8_DraftsApproved ;
    backlog:observedValue 0 ; backlog:observedAt "2026-11-12T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: no draft written yet."@en .

ex:Obj8_StateChecksRecorded a backlog:Objective ;
    rdfs:label "Real state-checks recorded: 0 -> 2"@en ;
    backlog:objectiveForGoal ex:G8_StateChecked ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasMetric ex:Metric_Obj8_StateChecksRecorded ; backlog:hasForecastDate "2026-11-12"^^xsd:date .
ex:Metric_Obj8_StateChecksRecorded a backlog:Metric ; rdfs:label "Count of chapters with a recorded real state-check (ch19, ch20)"@en ;
    backlog:metricUnit "state-check" ; backlog:metricBaseline 0 ; backlog:metricTarget 2 .
ex:Obs0_Obj8_StateChecksRecorded a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj8_StateChecksRecorded ;
    backlog:observedValue 0 ; backlog:observedAt "2026-11-12T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: the Mission-stage comment holds the measured facts; the Backlog-stage task is the recorded one."@en .

ex:Obj8_StoriesChecked a backlog:Objective ;
    rdfs:label "Stories not yet checked against the presented chapters: 12 -> 0"@en ;
    backlog:objectiveForGoal ex:G8_StoriesNotRepeated ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasMetric ex:Metric_Obj8_StoriesChecked ; backlog:hasForecastDate "2026-11-13"^^xsd:date .
ex:Metric_Obj8_StoriesChecked a backlog:Metric ; rdfs:label "Count of chapter 19-20 stories not yet checked against the stories of chapters 1-18 and, where found repeated, replaced or confirmed by the owner"@en ;
    backlog:metricUnit "story" ; backlog:metricBaseline 12 ; backlog:metricTarget 0 .
ex:Obs0_Obj8_StoriesChecked a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj8_StoriesChecked ;
    backlog:observedValue 12 ; backlog:observedAt "2026-11-12T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: 12 stories (6 per chapter); the link comparison done for the Mission stage found no shared link and one shared name (Bell Labs) still to be examined."@en .

ex:Obj8_DecksMeetStandard a backlog:Objective ;
    rdfs:label "Chapters whose deck passes the deck standard check: 0 -> 2"@en ;
    backlog:objectiveForGoal ex:G8_MaterialsMeetStandards ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasMetric ex:Metric_Obj8_DecksMeetStandard ; backlog:hasForecastDate "2026-11-16"^^xsd:date .
ex:Metric_Obj8_DecksMeetStandard a backlog:Metric ; rdfs:label "Count of chapters (19, 20) whose built deck passes the deck standard check v1.0.0 (13 of 13), the overlap check, the link check and the manifest self-check"@en ;
    backlog:metricUnit "chapter" ; backlog:metricBaseline 0 ; backlog:metricTarget 2 .
ex:Obs0_Obj8_DecksMeetStandard a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj8_DecksMeetStandard ;
    backlog:observedValue 0 ; backlog:observedAt "2026-11-12T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline 2026-11-12: 0 of 2; both live decks fail 7 of 13 and have no manifest."@en .

ex:Obj8_PagesBuilt a backlog:Objective ;
    rdfs:label "Chapters whose page is built with no failed page-test feature: 0 -> 2"@en ;
    backlog:objectiveForGoal ex:G8_MaterialsMeetStandards ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasMetric ex:Metric_Obj8_PagesBuilt ; backlog:hasForecastDate "2026-11-16"^^xsd:date .
ex:Metric_Obj8_PagesBuilt a backlog:Metric ; rdfs:label "Count of chapters (19, 20) whose built page, with the stories and chapter-code list of the approved draft, shows 0 failed features in the page test (features that run; a browser crash that the accepted pages share is reported, not hidden)"@en ;
    backlog:metricUnit "chapter" ; backlog:metricBaseline 0 ; backlog:metricTarget 2 .
ex:Obs0_Obj8_PagesBuilt a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj8_PagesBuilt ;
    backlog:observedValue 0 ; backlog:observedAt "2026-11-12T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline 2026-11-12: 0 of 2; the live pages are v9_34_0 and v9_35_0, before the v9_96 template."@en .

