ex:TK_Std_DeckCheck a backlog:ExecutionTask ; rdfs:label "Port the deck standard check and the deck overlap check to this course and measure the three existing decks with them"@en ; backlog:hasIdentifier "TK_Std_DeckCheck" ; backlog:hasTitle "Port the deck standard check and the deck overlap check to this course and measure the three existing decks with them" ;
