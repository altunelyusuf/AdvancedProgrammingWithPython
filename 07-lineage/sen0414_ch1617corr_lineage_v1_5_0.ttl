@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1617corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.5.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.5.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment "1.5.0 (2026-11-18): Backlog stage. Twelve stories (spec, deck, page, release for each of chapters 11, 17, 16), each with a Build and a Verify task; chapter 11 first, each later chapter depends on the release of the one before. Definition of Done written for this lineage."@en .

ex:Backlog10 a backlog:Backlog ; rdfs:label "Chapters 11, 17 and 16 corrections backlog"@en ;
    backlog:backlogForMission ex:Mission10 ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasBacklogMember ex:ST10_Spec_11, ex:ST10_Deck_11, ex:ST10_Page_11, ex:ST10_Release_11, ex:ST10_Spec_17, ex:ST10_Deck_17, ex:ST10_Page_17, ex:ST10_Release_17, ex:ST10_Spec_16, ex:ST10_Deck_16, ex:ST10_Page_16, ex:ST10_Release_16 .
ex:DoD10 a backlog:DefinitionOfDone ; rdfs:label "Definition of Done of the chapters 11, 17 and 16 corrections lineage"@en ; backlog:belongsToLineage ex:Lineage10 ;
    rdfs:comment "Written for this lineage. A story is Done only when (1) each acceptance criterion has a check that was run in the current turn and its output saved in the repository; (2) a verify task re-runs the check from the files, not from the builder's report; (3) a check that cannot be run, or a result that is not shown, is named in the audit note and never dropped; (4) no change goes beyond a ruling of 2026-11-14: content, stories and the meaning of examples stay as approved; (5) every changed file has its own new version; (6) the latest CME and SEN0414 checks are read from the repository files in the turn, not recalled; (7) a defect found by a check or a reviewer becomes a backlog item of this lineage and is repaired before closing."@en .
ex:AC10_Spec_11 a backlog:AcceptanceCriterion ; rdfs:label "A spec folder holds the chapter 11 examples, visuals, words, plan and output paths; the generic builder runs it and each example result equals what the old build printed"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Deck_11 a backlog:AcceptanceCriterion ; rdfs:label "On the new deck the material check passes on every deck condition and deck standard 1.1.0 passes 13 of 13; no note is outside 60 to 140 words (30 on title, part and resources slides)"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Page_11 a backlog:AcceptanceCriterion ; rdfs:label "The page has a Slide code tab equal to the deck code, no lambda unless taught, and the full page test shows every feature passing"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Release_11 a backlog:AcceptanceCriterion ; rdfs:label "The check logs are saved and a review record gives a verdict for each reviewed condition and each of the three roles"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Spec_17 a backlog:AcceptanceCriterion ; rdfs:label "A spec folder holds the chapter 17 examples, visuals, words, plan and output paths; the generic builder runs it and each example result equals what the old build printed"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Deck_17 a backlog:AcceptanceCriterion ; rdfs:label "On the new deck the material check passes on every deck condition and deck standard 1.1.0 passes 13 of 13; no note is outside 60 to 140 words (30 on title, part and resources slides)"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Page_17 a backlog:AcceptanceCriterion ; rdfs:label "The page has a Slide code tab equal to the deck code, no lambda unless taught, and the full page test shows every feature passing"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Release_17 a backlog:AcceptanceCriterion ; rdfs:label "The check logs are saved and a review record gives a verdict for each reviewed condition and each of the three roles"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Spec_16 a backlog:AcceptanceCriterion ; rdfs:label "A spec folder holds the chapter 16 examples, visuals, words, plan and output paths; the generic builder runs it and each example result equals what the old build printed"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Deck_16 a backlog:AcceptanceCriterion ; rdfs:label "On the new deck the material check passes on every deck condition and deck standard 1.1.0 passes 13 of 13; no note is outside 60 to 140 words (30 on title, part and resources slides)"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Page_16 a backlog:AcceptanceCriterion ; rdfs:label "The page has a Slide code tab equal to the deck code, no lambda unless taught, and the full page test shows every feature passing"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:AC10_Release_16 a backlog:AcceptanceCriterion ; rdfs:label "The check logs are saved and a review record gives a verdict for each reviewed condition and each of the three roles"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:ST10_Spec_11 a backlog:Story ; rdfs:label "Move the chapter 11 deck into a spec for the generic builder"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC10_Spec_11 ;
    backlog:decomposesInto ex:TK10_Spec_11_Build, ex:TK10_Spec_11_Verify .
ex:TK10_Spec_11_Build a backlog:ExecutionTask ; rdfs:label "Write the spec: examples, visuals, content, plan, parts and page requirements taken from the old builder (chapter 11)"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Ready ;
    backlog:belongsToLineage ex:Lineage10 .
ex:TK10_Spec_11_Verify a backlog:ExecutionTask ; rdfs:label "Run the generic builder on the spec and compare every example result with the old build, from the files (chapter 11)"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK10_Spec_11_Build .
ex:ST10_Deck_11 a backlog:Story ; rdfs:label "Write the notes, titles and frames of the chapter 11 deck and build the new deck"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC10_Deck_11 ;
    backlog:decomposesInto ex:TK10_Deck_11_Build, ex:TK10_Deck_11_Verify .
ex:TK10_Deck_11_Build a backlog:ExecutionTask ; rdfs:label "Write the notes (point at, result, lead into next), lengthen short titles, give one thing to look at, remove prompts and lambdas, build the deck and manifest (chapter 11)"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK10_Spec_11_Verify .
ex:TK10_Deck_11_Verify a backlog:ExecutionTask ; rdfs:label "Run the material check, deck standard 1.1.0, overlap, story prose, story repeat, manifest self-check and a note-by-note read from the files (chapter 11)"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK10_Deck_11_Build .
ex:ST10_Page_11 a backlog:Story ; rdfs:label "Build chapter 11 page with the Slide code tab and test it"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC10_Page_11 ;
    backlog:decomposesInto ex:TK10_Page_11_Build, ex:TK10_Page_11_Verify .
ex:TK10_Page_11_Build a backlog:ExecutionTask ; rdfs:label "Rebuild page data and page on template 9.53.5 with the lambda-free A-box maker and the Slide code tab (chapter 11)"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK10_Deck_11_Verify .
ex:TK10_Page_11_Verify a backlog:ExecutionTask ; rdfs:label "Run the full page test and the story layout probe; read the log (chapter 11)"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK10_Page_11_Build .
ex:ST10_Release_11 a backlog:Story ; rdfs:label "Record the checks and the three-role review of chapter 11"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC10_Release_11 ;
    backlog:decomposesInto ex:TK10_Release_11_Build, ex:TK10_Release_11_Verify .
ex:TK10_Release_11_Build a backlog:ExecutionTask ; rdfs:label "Write the review record: four reviewed conditions times three roles, labelled agent-made and not independent (chapter 11)"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK10_Page_11_Verify .
ex:TK10_Release_11_Verify a backlog:ExecutionTask ; rdfs:label "Re-run every automatic check from the files and compare with the record (chapter 11)"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK10_Release_11_Build .
