ex:Excl14_Content a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage14 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Changes to what chapters 21 to 25 teach, their stories and their examples' meaning"@en ;
    backlog:excludesConcern "Any change to what chapters 21 to 25 teach, to their stories, or to the meaning of an example, except a change a ruling forces (a prompt, a lambda, a frame that does not parse, an analogy)." ;
    backlog:hasExclusionRationale "The content was approved by the owner earlier; only its form is corrected. A story repeated across chapters is reported, not changed, without the owner." ;
    backlog:hasScopeLayer backlog:Layer_Work .
ex:Excl14_ExamWork a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage14 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Exam and mock-exam work"@en ;
    backlog:excludesConcern "Any exam, mock-exam or exam-page work." ;
    backlog:hasExclusionRationale "Held outside this repository." ;
    backlog:hasScopeLayer backlog:Layer_Work .
ex:Excl14_OtherChapters a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage14 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Chapters 1-20"@en ;
    backlog:excludesConcern "Any work on chapters 1 to 20: their decks, pages, specs and records." ;
    backlog:hasExclusionRationale "One narrow lineage per slice; chapters 10 to 20 are corrected and closed; chapters 1 to 9 are the initial chapters the owner returns to after this lineage, as a further queued lineage." ;
    backlog:hasScopeLayer backlog:Layer_Work .
ex:Excl14_LabMaterials a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage14 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Lab libraries, lab sessions and the lab-materials package"@en ;
    backlog:excludesConcern "Any lab library, lab session, lab handout or lab-materials package, including its code matching." ;
    backlog:hasExclusionRationale "The lab-materials package is queued as its own lineage and is discussed with the owner before any work (owner note of 2026-11-20)." ;
    backlog:hasScopeLayer backlog:Layer_Work .
ex:Excl14_Rdodi a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage14 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Modification or deletion of existing research-artifact files of these chapters"@en ;
    backlog:excludesConcern "Any modification or deletion of an existing file under 03-materials/ch21 to ch25/rdodi/ (the research-artifact sets). A new own-version file there is allowed only where a ruling forces it and is then named in the register." ;
    backlog:hasExclusionRationale "Read by the concept-coverage check, not changed, as in Lineage6 to Lineage13." ;
    backlog:hasScopeLayer backlog:Layer_Work .

ex:Scope14 a backlog:ScopeStatement ; backlog:belongsToLineage ex:Lineage14 ;
