@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch2125corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 21 to 25 corrections"@en ;
    owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0414-ch2125corr-lineage/1.1.0> ;
    owl:priorVersion <http://example.org/sen0414-ch2125corr-lineage/1.0.0> ; dcterms:identifier "sen0414_ch2125corr_lineage" ;
    rdfs:comment """1.1.0 (2026-11-26): Scope stage only (one stage per version): the scope statement with its areas, deliverables and exclusions, derived from the Mission stage's verified gaps (Lineage Operating Discipline v163.0.7, 3d). The shape rules that earlier scope stages found only on a second pass are answered at once (each area has a location, a counted measure and a layer; each deliverable a layer and a quoted mission clause; each exclusion a concern, a layer and a decision-maker). Measured here: the material check on the five old decks and pages (6 of 8 conditions fail on each, logs material_ch*.log) and a first read of the story-repeat log (no story repeat found for chapters 21 to 25; shared names only: Fredrik Lundh in chapters 21 and 18, Bell Labs in chapter 24 and chapters 5, 8 and 19; to be re-read after the rebuild). The page test, matching code and links stay scope items measured before any goal rests on them. Lesson of Lineage13 taken: an exclusion names the act it forbids exactly (modifying or deleting an existing file), and the folders allowed to change are listed in the scope text."""@en .

ex:Area14_Conversion a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage14 ;
    rdfs:label "Specs for the generic deck builder (chapters 21 to 25)"@en ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "08-tooling/ch21-deck/ to ch25-deck/ (first-version per-chapter builders deck_build_v1_0_0.py and examples_v1_0_0.py exist); a new spec folder per chapter beside them" ;
    backlog:areaMeasure "5 chapters; 0 spec folders exist; 5 first-version per-chapter builders exist" .
ex:Area14_Deck a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage14 ;
    rdfs:label "Decks on the rulings (chapters 21 to 25)"@en ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:areaLocation "08-tooling/ch21-deck/sen0414_ch21_deck_v1_0_0.pptx to ch25-deck/sen0414_ch25_deck_v1_0_0.pptx; new versions go to 03-materials/ch21 to ch25" ;
    backlog:areaMeasure "5 decks of 26 slides (130 slides), none in 03-materials; title-words fails on 4, 2, 6, 7 and 7 of 24 slides; '>>>' prompts in slide text 67, 39, 39, 38 and 45; lambda words 11, 9, 3, 9 and 1; no chapter-code manifest exists, so deck standard 1.3.0 cannot be run; fit, overlap and layout problems 0" .
ex:Area14_Reader a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage14 ;
    rdfs:label "Reader notes and speech balloons on the decks (chapters 21 to 25)"@en ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:areaLocation "Speaker notes and balloons of the 5 decks listed under the deck area" ;
    backlog:areaMeasure "79 reader-note findings (12, 15, 21, 14, 17); notes outside 60 to 140 words on 26, 26, 23, 26 and 25 of 26 slides; 0 code slides with one story balloon and two result balloons in each deck" .
ex:Area14_NoAnalogies a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage14 ;
    rdfs:label "No everyday analogies in decks and pages (chapters 21 to 25)"@en ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:areaLocation "The 5 decks and the 5 pages (03-materials/ch21/page/ to ch25/page/, newest sen0414_chNN_page_v9_35_0.html)" ;
    backlog:areaMeasure "0 analogy-marked slides in the decks; 3 think-of or like-a phrases in slide text and notes (chapter 21: 1, chapter 23: 2); 0 analogy words in the 5 pages; the notes and balloons that replace the plain meanings are not yet written, so analogies could enter there" .
ex:Area14_Page a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage14 ;
    rdfs:label "Pages on the rulings (chapters 21 to 25)"@en ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:areaLocation "03-materials/ch21/page/sen0414_ch21_page_v9_35_0.html to ch25 (all v9_35_0)" ;
    backlog:areaMeasure "5 pages at an older template; 33 '>>>' prompts in each page file; the word lambda 231, 194, 1167, 179 and 166 times in the page files; code frames 47, 44, 46, 51 and 47 of which code-parses fails on 47, 44, 46, 45 and 47 and code-in-page on 38, 40, 27, 40 and 33; the full page test on the current pipeline not yet run" .
ex:Area14_PageCode a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage14 ;
    rdfs:label "A menu item that runs the slide examples in order, and matching code (chapters 21 to 25)"@en ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:areaLocation "The top menu and the Slide code tab of the 5 pages, and chapter-code manifests 03-materials/ch21/page/chapter_code_ch21_v1_*.json to ch25 (new)" ;
    backlog:areaMeasure "5 pages; 0 of 5 with the run-in-order menu item; 0 page A-box files and 0 chapter-code manifests exist" .
ex:Area14_Release a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage14 ;
    rdfs:label "Automatic checks and recorded reviews before release (chapters 21 to 25)"@en ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "08-tooling/lineage14-opening/ and the chapter logs folders; review records REVIEW_RECORD_chNN_Lineage14_v1_0_0.md in 07-lineage/reports" ;
    backlog:areaMeasure "5 chapters; 0 review records of the three roles for this lineage; 0 of 5 chapters with every automatic condition passing (6 of 8 material-check conditions fail on each)" .
ex:Area14_OwnVersion a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage14 ;
    rdfs:label "Each changed file of chapters 21 to 25 versioned on its own"@en ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "All files of 03-materials/ch21 to ch25 and 08-tooling/ch21-* to ch25-* changed by this lineage" ;
