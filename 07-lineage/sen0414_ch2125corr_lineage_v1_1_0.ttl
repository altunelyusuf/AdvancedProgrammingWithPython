ex:Area14_Unmeasured a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage14 ;
    rdfs:label "Measures still open from the mission stage (chapters 21 to 25)"@en ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    backlog:areaLocation "08-tooling/lineage14-opening/ (new logs)" ;
    backlog:areaMeasure "4 measures named NOT MEASURED in 1.0.0: deck standard 1.3.0 (needs the manifest), full page test on 5 pages, matching code on slide, page and lab libraries, links and pictures of chapters 21 to 25, story repeat over chapters 21 to 25; the material check and a first read of the story-repeat log are done (gap logs); 0 of the others measured today" .

