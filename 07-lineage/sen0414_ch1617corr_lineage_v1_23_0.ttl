@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1617corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.23.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.23.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment "1.23.0 (2026-11-20): Chapter 17 spec Done: the generic builder 2.6.0 runs it. The lineage stays open."@en .

ex:TK10_Spec_17_Build backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Unblocked now that chapters 10 and 11 are done. Spec folder 08-tooling/ch17-deck/spec_v3_0_0: examples (the sample PDF cut into lines of 62 characters; PIL.Image used by name so a box is one line shorter; four balloons shortened), visuals (kit import moved to deck kit 2.2.0), content (parts, plan, route, questions, six stories as prose of at most 30 words a paragraph), spec.py; output paths deck 3.0.0 and manifest 1.1.0. The old build file stays untouched." .
ex:TK10_Spec_17_Verify backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Builder 2.6.0 ran the spec: 59 slides, 28 code examples, manifest self-check pass. The printed result of every one of the 28 examples equals what the old examples file prints (08-tooling/ch17-deck/examples_compare_v1_0_0.py, log logs_v3_0_0/old_new_results.log: 0 different). Builder WARN lines remain on eleven examples (result area slightly under the wanted height); the overlap check is clean." .
ex:ST10_Spec_17 backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Spec written and run by the generic builder; see its tasks." .
ex:TK10_Deck_17_Build backlog:hasState backlog:Ready .
ex:Obs3_Obj10_SpecRuns a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_SpecRuns ; backlog:observedValue 3 ; backlog:observedAt "2026-11-20T11:00:00Z"^^xsd:dateTime ; rdfs:comment "Chapter 11, chapter 10 and chapter 17 specs run by the generic builder 2.6.0." .
