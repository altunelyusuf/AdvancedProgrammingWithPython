@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch17ch18-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch17ch18-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 17 and 18"@en ;
    owl:versionInfo "1.3.0" ; owl:versionIRI <http://example.org/sen0414-ch17ch18-lineage/1.3.0> ; dcterms:identifier "sen0414_ch17ch18_lineage" ;
    rdfs:comment "1.3.0 (2026-11-11): Objective stage only. Baseline observations only; the measured observation is recorded with the Backlog stage."@en .

ex:Obj7_DraftsApproved a backlog:Objective ;
    rdfs:label "Owner-approved drafts: 0 -> 2"@en ;
    backlog:objectiveForGoal ex:G7_DraftApproved ; backlog:belongsToLineage ex:Lineage7 ;
    backlog:hasMetric ex:Metric_Obj7_DraftsApproved ; backlog:hasForecastDate "2026-11-13"^^xsd:date .
ex:Metric_Obj7_DraftsApproved a backlog:Metric ; rdfs:label "Count of owner-approved chapter drafts (ch17, ch18)"@en ;
    backlog:metricUnit "draft" ; backlog:metricBaseline 0 ; backlog:metricTarget 2 .
ex:Obs0_Obj7_DraftsApproved a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj7_DraftsApproved ;
    backlog:observedValue 0 ; backlog:observedAt "2026-11-11T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: no draft written yet."@en .

ex:Obj7_StateChecksRecorded a backlog:Objective ;
    rdfs:label "Real state-checks recorded: 0 -> 2"@en ;
    backlog:objectiveForGoal ex:G7_StateChecked ; backlog:belongsToLineage ex:Lineage7 ;
    backlog:hasMetric ex:Metric_Obj7_StateChecksRecorded ; backlog:hasForecastDate "2026-11-11"^^xsd:date .
ex:Metric_Obj7_StateChecksRecorded a backlog:Metric ; rdfs:label "Count of chapters with a recorded real state-check (ch17, ch18)"@en ;
    backlog:metricUnit "state-check" ; backlog:metricBaseline 0 ; backlog:metricTarget 2 .
ex:Obs0_Obj7_StateChecksRecorded a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj7_StateChecksRecorded ;
    backlog:observedValue 0 ; backlog:observedAt "2026-11-11T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: no recorded state-check task yet; the Backlog-stage task is the recorded one."@en .
