<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.18.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.18.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment "1.18.0 (2026-11-19): Chapter 10 release stage Done: checks logged and the three-role review recorded (agent-made). The lineage stays open."@en .

ex:TK_ST10_Release_10_Build backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Review record 08-tooling/ch10-deck/logs_v3_0_0/REVIEW_RECORD_ch10_v1_0_0.md: four reviewed conditions times three roles, 12 verdicts, labelled agent-made and not independent." .
ex:TK_ST10_Release_10_Verify backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Every automatic check was re-run from the files after the page build and equals the record. Open and said plainly: links not re-opened today; story facts carried over and not re-checked against sources; re-cut story wording unread by the owner; two story repeat candidates (UTF-8 versus chapter 8, JSON versus chapter 7) await the owner; quizfiles now samples all four capitals." .
ex:ST10_Release_10 backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Checks logged and review recorded; see its tasks." .
ex:Obs3_Obj10_MaterialConditions a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_MaterialConditions ; backlog:observedValue 0 ; backlog:observedAt "2026-11-19T21:00:00Z"^^xsd:dateTime ; rdfs:comment "Material check 1.0.2: no failing condition on the chapter 10 and chapter 11 decks and pages; chapter 17 is not yet built." .
ex:Obs2_Obj10_ReviewVerdicts a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_ReviewVerdicts ; backlog:observedValue 24 ; backlog:observedAt "2026-11-19T21:00:00Z"^^xsd:dateTime ; rdfs:comment "12 verdicts for chapter 11 and 12 for chapter 10 recorded, agent-made; 36 are the target with chapter 17." .
