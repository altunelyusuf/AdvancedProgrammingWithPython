    rdfs:label "No everyday analogies in decks and pages (chapters 12 to 15)"@en .
ex:Area12_Page a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage12 ;
    rdfs:label "Pages on the rulings (chapters 12 to 15)"@en .
ex:Area12_PageCode a backlog:ScopeArea ; backlog:belongsToLineage ex:Lineage12 ;
