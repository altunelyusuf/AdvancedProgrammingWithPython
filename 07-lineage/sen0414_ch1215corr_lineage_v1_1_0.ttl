ex:Del12_OwnVersion a backlog:ScopeDeliverable ; backlog:belongsToLineage ex:Lineage12 ; backlog:deliverableForArea ex:Area12_OwnVersion ;
    rdfs:label "Version check of the repository passing after each release"@en .

ex:Excl12_Content a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage12 ;
    backlog:hasExclusionRationale "The content was approved by the owner earlier; only its form is corrected. An example is changed only where a ruling forces it (a prompt, a lambda, a frame that does not parse, an analogy). A story repeated across chapters is reported, not changed, without the owner; the name Ken Thompson shared by the chapter 12 story with chapters 8, 9 and 10 is read by a person and reported." ;
    rdfs:label "Changes to what chapters 12 to 15 teach, their stories and their examples' meaning"@en .
ex:Excl12_ExamWork a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage12 ;
    backlog:hasExclusionRationale "Held outside this repository." ;
    rdfs:label "Exam and mock-exam work"@en .
ex:Excl12_OtherChapters a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage12 ;
    backlog:hasExclusionRationale "One narrow lineage per slice; chapters 10, 11, 16 and 17 are corrected and closed; chapters 1 to 9 and 18 to 20 follow in later lineages reusing the conversion; chapters 21 to 25 have no deck and only with the owner." ;
    rdfs:label "Chapters 1-11, 16-25"@en .
ex:Excl12_LabMaterials a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage12 ;
    backlog:hasExclusionRationale "The lab-materials package is queued as its own lineage and is discussed with the owner before any work (owner note of 2026-11-20). Lab libraries and lab sessions are not touched here." ;
    rdfs:label "Lab libraries, lab sessions and the lab-materials package"@en .
ex:Excl12_Rdodi a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage12 ;
    backlog:hasExclusionRationale "Read by the concept-coverage check, not changed, as in Lineage6 to Lineage10." ;
    rdfs:label "The rdodi/ research-artifact sets of these chapters"@en .

ex:Scope12 a backlog:ScopeStatement ; backlog:belongsToLineage ex:Lineage12 ;
    backlog:scopeForMission ex:Mission12 ;
    backlog:coversArea ex:Area12_Conversion , ex:Area12_Deck , ex:Area12_Reader , ex:Area12_NoAnalogies , ex:Area12_Page , ex:Area12_PageCode , ex:Area12_Release , ex:Area12_OwnVersion ;
    backlog:hasScopeDeliverable ex:Del12_Spec_12 , ex:Del12_Spec_13 , ex:Del12_Spec_14 , ex:Del12_Spec_15 ,
        ex:Del12_Deck_12 , ex:Del12_Deck_13 , ex:Del12_Deck_14 , ex:Del12_Deck_15 ,
        ex:Del12_Reader_12 , ex:Del12_Reader_13 , ex:Del12_Reader_14 , ex:Del12_Reader_15 ,
        ex:Del12_NoAnalogies_12 , ex:Del12_NoAnalogies_13 , ex:Del12_NoAnalogies_14 , ex:Del12_NoAnalogies_15 ,
        ex:Del12_Page_12 , ex:Del12_Page_13 , ex:Del12_Page_14 , ex:Del12_Page_15 ,
        ex:Del12_PageCode_12 , ex:Del12_PageCode_13 , ex:Del12_PageCode_14 , ex:Del12_PageCode_15 ,
        ex:Del12_ReleaseRecord_12 , ex:Del12_ReleaseRecord_13 , ex:Del12_ReleaseRecord_14 , ex:Del12_ReleaseRecord_15 ,
        ex:Del12_OwnVersion ;
    backlog:hasScopeExclusion ex:Excl12_Content , ex:Excl12_ExamWork , ex:Excl12_OtherChapters , ex:Excl12_LabMaterials , ex:Excl12_Rdodi ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:scopeCompletionState backlog:Proposed ;
    backlog:hasScopeStatementText "IN: chapters 12 (Command-Line Programs), 13 (Web Scraping), 14 (Excel Spreadsheets) and 15 (Google Sheets) of the 3rd edition, in that order. (a) Conversion: each chapter's examples, result visuals, words and plan move into a spec for the generic chapter deck builder, so each deck is rebuilt once. (b) Deck: titles of at least four words, one thing to look at per slide, plain parsing code without prompts, no lambda unless taught, no text frames overlapping, chapter-code manifest equal to the deck's code in order, no slides added (fuller plain sentences go in speech balloons). (c) Reader: notes of 60 to 140 words (at least 30 on title, part and resources slides) written to the reader of the distributed slides, with no directions to a presenter and no think-of statements. (d) No everyday analogies in decks and pages. (e) Page: a Slide code tab equal to the deck code in the same order, code without prompts and without lambda, the full page test passing, a top menu item that runs the slide examples in order. (f) Release: every automatic condition passes and every reviewed condition has a recorded verdict from the academician, the faculty reviewer and the undergraduate reader; each changed file has its own new version. The latest CME and SEN0414 enhancements and the corrections recorded in the chapter 10, 11, 16 and 17 work are applied from the physical files." ;
    rdfs:label "Rebuild chapter 12 to 15 decks and pages to the owner's rulings"@en .
