ex:Scope10 a backlog:ScopeStatement ;
    backlog:belongsToLineage ex:Lineage10 ;
    backlog:coversArea ex:Area10_Conversion ;
    backlog:coversArea ex:Area10_Deck ;
    backlog:coversArea ex:Area10_NoAnalogies ;
    backlog:coversArea ex:Area10_Page ;
    backlog:coversArea ex:Area10_Release ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:hasScopeDeliverable ex:Del10_Deck_11 ;
    backlog:hasScopeDeliverable ex:Del10_Deck_16 ;
    backlog:hasScopeDeliverable ex:Del10_Deck_17 ;
    backlog:hasScopeDeliverable ex:Del10_NoAnalogies_16 ;
    backlog:hasScopeDeliverable ex:Del10_NoAnalogies_17 ;
    backlog:hasScopeDeliverable ex:Del10_Page_11 ;
    backlog:hasScopeDeliverable ex:Del10_Page_16 ;
    backlog:hasScopeDeliverable ex:Del10_Page_17 ;
    backlog:hasScopeDeliverable ex:Del10_ReleaseRecord_11 ;
    backlog:hasScopeDeliverable ex:Del10_ReleaseRecord_16 ;
    backlog:hasScopeDeliverable ex:Del10_ReleaseRecord_17 ;
    backlog:hasScopeDeliverable ex:Del10_Spec_11 ;
    backlog:hasScopeDeliverable ex:Del10_Spec_16 ;
    backlog:hasScopeDeliverable ex:Del10_Spec_17 ;
    backlog:hasScopeExclusion ex:Excl10_Content ;
    backlog:hasScopeExclusion ex:Excl10_ExamWork ;
    backlog:hasScopeExclusion ex:Excl10_OtherChapters ;
    backlog:hasScopeExclusion ex:Excl10_Rdodi ;
    backlog:hasScopeStatementText "IN: chapters 11 (Organizing Files), 17 (PDF and Word Documents) and 16 (SQLite Databases) of the 3rd edition, in that order, chapter 11 first as urgent. (a) Conversion: each chapter's examples, result visuals, words and plan move into a spec for the generic chapter deck builder 2.4.0, so each deck is rebuilt once. (b) Deck: titles of at least four words, one thing to look at per slide, notes of 60 to 140 words (at least 30 on title, part and resources slides) that say what to point at and lead to the next slide, plain parsing code without prompts, no lambda unless taught, chapter-code manifest equal to the deck's code in order. (c) Page: a Slide code tab equal to the deck code in the same order, code without lambda, the full page test passing. (d) Release: every automatic condition passes and every reviewed condition has a recorded verdict from the academician, the faculty reviewer and the undergraduate reader. Latest CME and SEN0414 enhancements and the corrections recorded in the chapter 18 and 19-20 lineages are applied from the physical files." ;
    backlog:scopeCompletionState backlog:Proposed ;
    backlog:scopeForMission ex:Mission10 ;
    rdfs:label "Rebuild chapter 11, 17 and 16 decks and pages to the six rulings of 2026-11-14"@en .
ex:Scope10_2 a backlog:ScopeStatement ;
    backlog:belongsToLineage ex:Lineage10 ;
    backlog:coversArea ex:Area10_Chapter10 ;
    backlog:coversArea ex:Area10_OwnVersion ;
    backlog:coversArea ex:Area10_Reader ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:hasScopeDeliverable ex:Del10_Balloons ;
    backlog:hasScopeDeliverable ex:Del10_Deck_10 ;
    backlog:hasScopeDeliverable ex:Del10_Page_10 ;
    backlog:hasScopeDeliverable ex:Del10_ReaderNotesCheck ;
    backlog:hasScopeDeliverable ex:Del10_ReleaseRecord_10 ;
    backlog:hasScopeDeliverable ex:Del10_Rework_11 ;
    backlog:hasScopeDeliverable ex:Del10_Spec_10 ;
    backlog:hasScopeStatementText "IN: (a) Reader material: speech balloons on the existing slides of chapters 10 and 11 (one sentence per balloon, key words in bold, Trebuchet MS; concept cards grouped as one card; code slides with a story balloon beside each code box and two short result balloons under the code), with the slide count unchanged; and notes written for the reader of the handed-out slides (they explain the slide's short wording in fuller sentences, add detail the balloons do not carry, connect to related slides and chapters, give no directions to a presenter, contain no think-of statements, no prompt markers, no lambda). (b) Own versions: every changed file of chapters 10 and 11 takes one step above its own last released version (the last release is 2.44.0 of 2026-10-08, whose pages are 9.19.0); no counter is shared between files; an unreleased page is rewritten in place and no second draft of it is kept; the generator takes the released version from the published branch. (c) Chapter 10 (Reading and Writing Files): the same conversion, deck, page and release as chapter 11 (spec for the generic builder, notes, plain code, lambda-free example data, Slide code tab, full page test, three-role review). (d) Chapter 11: rework of the deck 3.0.0 and page to the practices above. EXCLUDED as in the first statement: what the chapters teach, their stories and the meaning of their examples; other chapters; the rdodi sets; exams." ;
    backlog:scopeCompletionState backlog:Proposed ;
    backlog:scopeForMission ex:Mission10 ;
    rdfs:label "Chapter 10 on the rulings, and chapters 10 and 11 on the handover's practices"@en .
ex:TK10_Deck_11_Build a backlog:ExecutionTask ;
