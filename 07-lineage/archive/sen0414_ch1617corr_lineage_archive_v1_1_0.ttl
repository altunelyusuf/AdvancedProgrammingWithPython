    backlog:hasState backlog:Done ;
    backlog:hasTaskType backlog:TaskType_Build ;
    rdfs:label "Write the notes (point at, result, lead into next), lengthen short titles, give one thing to look at, remove prompts and lambdas, build the deck and manifest (chapter 11)"@en .
