@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch17ch18-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch17ch18-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 17 and 18"@en ;
    owl:versionInfo "1.2.0" ; owl:versionIRI <http://example.org/sen0414-ch17ch18-lineage/1.2.0> ; dcterms:identifier "sen0414_ch17ch18_lineage" ;
    rdfs:comment "1.2.0 (2026-11-11): Goal stage only."@en .

ex:G7_DraftApproved a backlog:Goal ;
    rdfs:label "Owner approves one draft per chapter"@en ;
    backlog:goalForMission ex:Mission7 ; backlog:belongsToLineage ex:Lineage7 ;
    backlog:hasGoalStatement "The owner reads and approves one plain-text draft for chapter 17 and one for chapter 18 before any render step runs." ;
    backlog:goalCompletionState backlog:Proposed .

ex:G7_StateChecked a backlog:Goal ;
    rdfs:label "Chapters 17-18 materials checked against current standard"@en ;
    backlog:goalForMission ex:Mission7 ; backlog:belongsToLineage ex:Lineage7 ;
    backlog:hasGoalStatement "What exists for chapters 17 and 18 (deck, page, stories, code, resources) is re-checked against the 2026-11-09 story principle and the current resources-slide standard, with any stale, missing or duplicated item named before drafting." ;
    backlog:goalCompletionState backlog:Proposed .
