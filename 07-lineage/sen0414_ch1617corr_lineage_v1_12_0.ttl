@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1617corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.12.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.12.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment """1.12.0 (2026-11-19): Backlog stage. Six stories added for the amendment (builder balloons and reader-notes check; chapter 11 rework; chapter 10 spec, deck, page, release), each with a Build and a Verify task. Chapter 17 and 16 are re-ranked behind chapter 10. Definition of Done DoD10 applies; its item (5) every changed file has its own new version is read as the handover's rule 1."""@en .

ex:Backlog10 backlog:hasBacklogMember ex:ST10_Builder_Balloons, ex:ST10_Rework_11, ex:ST10_Spec_10, ex:ST10_Deck_10, ex:ST10_Page_10, ex:ST10_Release_10 .
ex:ST10_Builder_Balloons a backlog:Story ; rdfs:label "Add speech balloons and grouped concept cards to the generic deck builder, and write the reader-notes check"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC_ST10_Builder_Balloons ;
    backlog:decomposesInto ex:TK_ST10_Builder_Balloons_Build, ex:TK_ST10_Builder_Balloons_Verify .
ex:AC_ST10_Builder_Balloons a backlog:AcceptanceCriterion ; rdfs:label "The builder (new version) draws balloons on existing slides without changing the slide count; the reader-notes check (new tool) finds presenter directions, think-of statements, prompt markers, lambda and a missing connection in a note; both run on a toy spec and on chapter 11"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:TK_ST10_Builder_Balloons_Build a backlog:ExecutionTask ; rdfs:label "Write builder 2.6.0 (balloons, grouped concept cards) and the reader-notes check"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Ready .
ex:TK_ST10_Builder_Balloons_Verify a backlog:ExecutionTask ; rdfs:label "Run both from the files on the chapter 11 spec; look at rendered slides"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK_ST10_Builder_Balloons_Build .
ex:ST10_Rework_11 a backlog:Story ; rdfs:label "Bring the chapter 11 deck and page to the balloons, reader notes and own versions"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC_ST10_Rework_11 ;
    backlog:decomposesInto ex:TK_ST10_Rework_11_Build, ex:TK_ST10_Rework_11_Verify .
ex:AC_ST10_Rework_11 a backlog:AcceptanceCriterion ; rdfs:label "Deck 3.0.0 is rebuilt in place with balloons and reader notes (no new slide); the page is the one file 9.20.0 and the drafts above 9.19.0 are removed; the page test and every automatic check pass; the review record is updated"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:TK_ST10_Rework_11_Build a backlog:ExecutionTask ; rdfs:label "Rewrite the 41 notes for the reader, write balloons and result sentences, rebuild deck and page"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked .
ex:TK_ST10_Rework_11_Verify a backlog:ExecutionTask ; rdfs:label "Re-run every automatic check and the page test from the files"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK_ST10_Rework_11_Build .
ex:ST10_Spec_10 a backlog:Story ; rdfs:label "Move the chapter 10 deck into a spec for the generic builder"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC_ST10_Spec_10 ;
    backlog:decomposesInto ex:TK_ST10_Spec_10_Build, ex:TK_ST10_Spec_10_Verify .
ex:AC_ST10_Spec_10 a backlog:AcceptanceCriterion ; rdfs:label "A spec folder holds the chapter 10 examples, visuals, words, plan and output paths; the builder runs it and each example result equals what the old build printed"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:TK_ST10_Spec_10_Build a backlog:ExecutionTask ; rdfs:label "Write the spec from the old chapter 10 builder files"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked .
ex:TK_ST10_Spec_10_Verify a backlog:ExecutionTask ; rdfs:label "Run the builder and compare every example result with the old build"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK_ST10_Spec_10_Build .
ex:ST10_Deck_10 a backlog:Story ; rdfs:label "Write balloons, reader notes, titles and frames of the chapter 10 deck and build it"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC_ST10_Deck_10 ;
    backlog:decomposesInto ex:TK_ST10_Deck_10_Build, ex:TK_ST10_Deck_10_Verify .
ex:AC_ST10_Deck_10 a backlog:AcceptanceCriterion ; rdfs:label "The material check passes every deck condition, deck standard 1.1.0 passes 13 of 13, the reader-notes check passes, and the slide count is unchanged"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:TK_ST10_Deck_10_Build a backlog:ExecutionTask ; rdfs:label "Write notes, balloons, titles; build deck and manifest"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked .
ex:TK_ST10_Deck_10_Verify a backlog:ExecutionTask ; rdfs:label "Run the checks and look at the rendered slides"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK_ST10_Deck_10_Build .
ex:ST10_Page_10 a backlog:Story ; rdfs:label "Build and test the chapter 10 page 9.20.0"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC_ST10_Page_10 ;
    backlog:decomposesInto ex:TK_ST10_Page_10_Build, ex:TK_ST10_Page_10_Verify .
ex:AC_ST10_Page_10 a backlog:AcceptanceCriterion ; rdfs:label "The page has a Slide code tab equal to the deck code, no lambda, and the full page test shows every feature passing"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:TK_ST10_Page_10_Build a backlog:ExecutionTask ; rdfs:label "Lambda-free A-box, page data, page build"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked .
ex:TK_ST10_Page_10_Verify a backlog:ExecutionTask ; rdfs:label "Page test, story layout probe, material check with the page"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK_ST10_Page_10_Build .
ex:ST10_Release_10 a backlog:Story ; rdfs:label "Record the checks and the three-role review of chapter 10"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD10 ; backlog:hasAcceptanceCriterion ex:AC_ST10_Release_10 ;
    backlog:decomposesInto ex:TK_ST10_Release_10_Build, ex:TK_ST10_Release_10_Verify .
ex:AC_ST10_Release_10 a backlog:AcceptanceCriterion ; rdfs:label "Logs are saved and a review record gives a verdict for each reviewed condition and each of the three roles"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:TK_ST10_Release_10_Build a backlog:ExecutionTask ; rdfs:label "Write the review record"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked .
ex:TK_ST10_Release_10_Verify a backlog:ExecutionTask ; rdfs:label "Re-run every automatic check from the files"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK_ST10_Release_10_Build .
ex:TK_ST10_Rework_11_Build backlog:dependsOn ex:TK_ST10_Builder_Balloons_Verify .
ex:TK_ST10_Spec_10_Build backlog:dependsOn ex:TK_ST10_Rework_11_Verify .
ex:TK_ST10_Deck_10_Build backlog:dependsOn ex:TK_ST10_Spec_10_Verify .
ex:TK_ST10_Page_10_Build backlog:dependsOn ex:TK_ST10_Deck_10_Verify .
ex:TK_ST10_Release_10_Build backlog:dependsOn ex:TK_ST10_Page_10_Verify .
ex:TK10_Spec_17_Build backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK_ST10_Release_10_Verify ;
    backlog:hasAuditNote "Re-ranked behind chapter 10 (owner, 2026-11-19: chapters 10 and 11 this week); it was Ready in register 1.7.0 and is not started." .
