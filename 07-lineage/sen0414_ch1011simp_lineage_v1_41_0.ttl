@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1011simp-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1011simp-lineage> a owl:Ontology ;
    rdfs:label "Urgent narrow lineage: SEN0414 chapters 10 and 11, one code, one environment"@en ;
    owl:versionInfo "1.41.0" ; owl:versionIRI <http://example.org/sen0414-ch1011simp-lineage/1.41.0> ; dcterms:identifier "sen0414_ch1011simp_lineage" ;
    rdfs:comment """1.41.0 (2026-11-25): Scope change only (one stage per version). The Owner chose, after one question with three options, that the other chapter pages take the new exam results tab now."""@en .

ex:CR11_ExamResultsAll a backlog:ChangeRequest ;
    rdfs:label "Mock exam results tab on every other chapter page that is at the page standard"@en ;
    backlog:requestsChangeTo ex:Scope11 ; backlog:hasChangeDirection backlog:Direction_Grow ;
    backlog:hasChangeRequestRationale "Owner's answer of 2026-11-24 to one question (content, not a verbatim quotation): the other chapters get the new Exam results tab now, all of them. This overrides, for this feature only, the standing rule of 2026-11-11 that presented chapters stay unchanged until the book is finished." ;
    backlog:hasDisposition backlog:Disp_Accepted .
ex:IA11_ExamResultsAll a backlog:ImpactAssessment ;
    rdfs:label "Which pages can take the change as they are, measured before planning"@en ;
    backlog:analyzesRequest ex:CR11_ExamResultsAll ; backlog:identifiesAffectedLineage ex:Lineage11 ;
    backlog:hasImpactStatement "MEASURED FACTS (2026-11-25, read-only, the template patch tried on a copy of each latest page): chapters 1 to 9 and 12 to 20 (18 pages, templates 9.52.2 to 9.53.5) accept the patch unchanged. Chapters 21 to 25 (5 pages, page 9.35.0, templates 9.49.0 and 9.50.0) do not: their file header differs, they are not at the page standard of the others and are unfinished chapters. Rebuilding the 18 from data would also pull in every other template change since their last build, so the change is applied to the existing page instead: one retrofit step per page keeps all other content and only replaces the exam parts, the version marks and the versioned data copies. Each of the 18 pages needs a new version (a relaxation, so a minor step), a test run and a log." ;
    backlog:hasAuditNote "Excluded and stated: chapters 21 to 25 take the template when they are built to the standard. Open: the instructor's result desk still issues release codes that no page asks for." .
ex:Del11_ExamResultsAll a backlog:ScopeDeliverable ; rdfs:label "Chapters 1 to 9 and 12 to 20 pages with the Exam results tab, tested"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:deliverableForArea ex:Area11_ExamResults .
ex:SC11_ExamResultsAll a backlog:ScopeChange ;
    rdfs:label "Scope grown to the other chapter pages that accept the change"@en ;
    backlog:fulfillsRequest ex:CR11_ExamResultsAll ; backlog:changesScope ex:Scope11 ; backlog:decidedBy backlog:Owner ;
    backlog:admitsItem ex:Del11_ExamResultsAll ;
    backlog:hasScopeChangeRationale "Owner's answer of 2026-11-24. One deliverable added to the existing exam results area; chapters 21 to 25 stay excluded." .
ex:Scope11 backlog:hasScopeDeliverable ex:Del11_ExamResultsAll .
