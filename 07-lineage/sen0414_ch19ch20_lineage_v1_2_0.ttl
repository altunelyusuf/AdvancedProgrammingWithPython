@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch19ch20-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch19ch20-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 19 and 20"@en ;
    owl:versionInfo "1.2.0" ; owl:versionIRI <http://example.org/sen0414-ch19ch20-lineage/1.2.0> ; dcterms:identifier "sen0414_ch19ch20_lineage" ;
    rdfs:comment "1.2.0 (2026-11-12): Goal stage only. One goal per scope area; the fourth is new against Lineage7 because the structural rebuild is inside this scope."@en .

ex:G8_DraftApproved a backlog:Goal ;
    rdfs:label "Owner approves one draft per chapter"@en ;
    backlog:goalForMission ex:Mission8 ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasGoalStatement "The owner reads and approves one plain-text draft for chapter 19 and one for chapter 20 before any build step runs." ;
    backlog:goalCompletionState backlog:Proposed .

ex:G8_StateChecked a backlog:Goal ;
    rdfs:label "Chapters 19-20 materials checked against the current standards"@en ;
    backlog:goalForMission ex:Mission8 ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasGoalStatement "What exists for chapters 19 and 20 (deck, page, stories, code, resources, manifest) is re-checked against the deck and page standards and the story principles, with every stale, missing or duplicated item named before drafting." ;
    backlog:goalCompletionState backlog:Proposed .

ex:G8_StoriesNotRepeated a backlog:Goal ;
    rdfs:label "No chapter 19-20 story repeats one already told in a presented chapter"@en ;
    backlog:goalForMission ex:Mission8 ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasGoalStatement "Every story of chapters 19 and 20 is checked against the stories of the chapters already presented before it is drafted for approval; a story that repeats one is replaced, or kept only when the owner confirms the repeat." ;
    backlog:goalCompletionState backlog:Proposed .

ex:G8_MaterialsMeetStandards a backlog:Goal ;
    rdfs:label "Chapters 19-20 deck and page meet the standards chapters 9-18 meet"@en ;
    backlog:goalForMission ex:Mission8 ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasGoalStatement "The deck and the page of each of chapters 19 and 20 are built from the approved draft and pass the deck standard check, the overlap check, the link check, the chapter-code manifest self-check and the page test features that run." ;
    backlog:goalCompletionState backlog:Proposed .
