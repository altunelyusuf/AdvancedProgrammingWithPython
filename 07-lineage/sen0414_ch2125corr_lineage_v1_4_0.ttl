ex:ST14_Spec_21 backlog:satisfiesDeliverable ex:Del14_Spec_21 .
ex:AC14_Spec_21 a backlog:AcceptanceCriterion ;
    backlog:belongsToLineage ex:Lineage14 ;
    backlog:hasGherkinText "Given the first-version chapter 21 (Making Graphs and Manipulating Images) deck, stories and examples, and no spec When a spec for the generic chapter deck builder 2.10.0 is written and run Then it builds a deck with the same story and example entries as the first-version deck, every difference is named and forced by a ruling, and the build exits 0" ;
    backlog:satisfiedByArtifact "08-tooling/ch21-deck/ (new spec folder and the build log)" ;
    rdfs:label "Chapter 21 spec and chapter-code manifest for the generic deck builder 2.10.0: acceptance"@en .

