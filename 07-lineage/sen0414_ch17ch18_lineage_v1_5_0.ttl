<http://example.org/sen0414-ch17ch18-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 17 and 18"@en ;
    owl:versionInfo "1.5.0" ; owl:versionIRI <http://example.org/sen0414-ch17ch18-lineage/1.5.0> ; dcterms:identifier "sen0414_ch17ch18_lineage" ;
    rdfs:comment "1.5.0 (2026-11-11): Write chapter 17 and 18 drafts for owner approval."@en .

ex:ST7_DraftCh17 backlog:hasState backlog:Done ;
    backlog:hasAuditNote "03-materials/ch17/DRAFT_ch17_v1_0_0.md written from the live stories script (6 stories, verbatim), the 58-slide deck titles, the 28-example manifest (slide mapping) and the deck's own 14 hyperlink targets. Gap named in the draft: the deck has 5 story slides, the script and page have 6 (the pypdf history story has no deck slide); the render step would add it." .
ex:ST7_DraftCh18 backlog:hasState backlog:Done ;
    backlog:hasAuditNote "03-materials/ch18/DRAFT_ch18_v1_0_0.md written from the live stories script (6 stories, verbatim, each with a deck story slide), the 53-slide v2_0_1 deck titles, the 27-example manifest and the deck's own 14 hyperlink targets. No gap found." .
ex:ST7_ApprovalGate backlog:hasState backlog:Ready ;
    rdfs:comment "Not Blocked any more: both drafts written and sent to the owner."@en .
