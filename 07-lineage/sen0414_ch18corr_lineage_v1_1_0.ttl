@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch18corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch18corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapter 18 corrections"@en ;
    owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0414-ch18corr-lineage/1.1.0> ; dcterms:identifier "sen0414_ch18corr_lineage" ;
    rdfs:comment "1.1.0 (2026-11-18): Scope stage only. Areas follow the six rulings of 2026-11-14 (handover v1.1.0) as they touch chapter 18: how it is rebuilt, the deck, the page, and the checks and reviews that release it."@en .

ex:Scope9 a backlog:ScopeStatement ;
    rdfs:label "Rebuild chapter 18 deck and page to the six rulings of 2026-11-14"@en ;
    backlog:scopeForMission ex:Mission9 ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:scopeCompletionState backlog:Proposed ;
    backlog:coversArea ex:Area9_Conversion, ex:Area9_Deck, ex:Area9_Page, ex:Area9_Release ;
    backlog:hasScopeExclusion ex:Excl9_Content, ex:Excl9_OtherChapters, ex:Excl9_Rdodi, ex:Excl9_ExamWork ;
    backlog:hasScopeDeliverable ex:Del9_Spec, ex:Del9_Deck, ex:Del9_Page, ex:Del9_ReleaseRecord ;
    backlog:hasScopeStatementText "IN: chapter 18 (CSV, JSON and XML Files) of the 3rd edition only. (a) Conversion: the chapter's examples, result visuals, words and plan move into a spec for the generic chapter deck builder, so that the deck is rebuilt once and the conversion can be reused for chapters 17 and earlier. (b) Deck: titles of at least four words, one thing to look at per slide, notes of 60 to 140 words that say what to point at and lead into the next slide, plain code without prompt markers, frames that parse, no lambda unless taught. (c) Page: a Slide code tab equal to the deck code in the same order, code that runs, no lambda unless taught, a labelled story layout replaced by natural prose. (d) Release: every automatic condition passes and every reviewed condition has a recorded verdict for each of the three roles. OUT: new stories, new examples or any change to what the chapter teaches; the other chapters." .
ex:Area9_Conversion a backlog:ScopeArea ; rdfs:label "Chapter 18 spec for the generic deck builder"@en ; backlog:belongsToLineage ex:Lineage9 .
ex:Area9_Deck a backlog:ScopeArea ; rdfs:label "Chapter 18 deck on the rulings"@en ; backlog:belongsToLineage ex:Lineage9 .
ex:Area9_Page a backlog:ScopeArea ; rdfs:label "Chapter 18 page on the rulings"@en ; backlog:belongsToLineage ex:Lineage9 .
ex:Area9_Release a backlog:ScopeArea ; rdfs:label "Automatic checks and recorded reviews before release"@en ; backlog:belongsToLineage ex:Lineage9 .
ex:Del9_Spec a backlog:ScopeDeliverable ; rdfs:label "Spec folder of chapter 18 for the generic builder"@en ; backlog:belongsToLineage ex:Lineage9 ; backlog:deliverableForArea ex:Area9_Conversion .
ex:Del9_Deck a backlog:ScopeDeliverable ; rdfs:label "Chapter 18 deck and chapter-code manifest, new versions"@en ; backlog:belongsToLineage ex:Lineage9 ; backlog:deliverableForArea ex:Area9_Deck .
ex:Del9_Page a backlog:ScopeDeliverable ; rdfs:label "Chapter 18 page, new version, with its page test result"@en ; backlog:belongsToLineage ex:Lineage9 ; backlog:deliverableForArea ex:Area9_Page .
ex:Del9_ReleaseRecord a backlog:ScopeDeliverable ; rdfs:label "Check logs and the three-role review record of chapter 18"@en ; backlog:belongsToLineage ex:Lineage9 ; backlog:deliverableForArea ex:Area9_Release .
ex:Excl9_Content a backlog:ScopeExclusion ; rdfs:label "Changes to what chapter 18 teaches, its stories and its examples' meaning"@en ; backlog:belongsToLineage ex:Lineage9 ; backlog:hasExclusionRationale "The content was approved by the owner in Lineage7; only its form is corrected. An example is changed only where a ruling forces it (a prompt, a lambda, a frame that does not parse)." .
ex:Excl9_OtherChapters a backlog:ScopeExclusion ; rdfs:label "Chapters 1-17 and 19-25"@en ; backlog:belongsToLineage ex:Lineage9 ; backlog:hasExclusionRationale "One narrow lineage per chapter pair or slice; chapters 19-20 closed in Lineage8; the earlier chapters follow in their own lineages, reusing the conversion; chapters 21-22 only with the owner." .
ex:Excl9_Rdodi a backlog:ScopeExclusion ; rdfs:label "The rdodi/ research-artifact set of chapter 18"@en ; backlog:belongsToLineage ex:Lineage9 ; backlog:hasExclusionRationale "Read by the concept-coverage check, not changed, as in Lineage6 to Lineage8." .
ex:Excl9_ExamWork a backlog:ScopeExclusion ; rdfs:label "Exam and mock-exam work"@en ; backlog:belongsToLineage ex:Lineage9 ; backlog:hasExclusionRationale "Held outside this repository." .
