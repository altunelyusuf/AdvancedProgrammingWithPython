@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch17ch18-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch17ch18-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 17 and 18"@en ;
    owl:versionInfo "1.8.0" ; owl:versionIRI <http://example.org/sen0414-ch17ch18-lineage/1.8.0> ; dcterms:identifier "sen0414_ch17ch18_lineage" ;
    rdfs:comment "1.8.0 (2026-11-11): Change request, Goal stage only. One goal for the new scope area."@en .

ex:G7_StoriesNotRepeated a backlog:Goal ;
    rdfs:label "No chapter 17-18 story repeats a story of a presented chapter without the owner's confirmation"@en ;
    backlog:goalForMission ex:Mission7 ; backlog:belongsToLineage ex:Lineage7 ;
    backlog:hasGoalStatement "Every story in the approved drafts of chapters 17 and 18 is either different from every story already told in chapters 1-16, or is a repeat the owner has confirmed as needed." ;
    backlog:goalCompletionState backlog:Proposed .
