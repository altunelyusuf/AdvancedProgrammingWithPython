@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch19ch20-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch19ch20-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 19 and 20"@en ;
    owl:versionInfo "1.4.0" ; owl:versionIRI <http://example.org/sen0414-ch19ch20-lineage/1.4.0> ; dcterms:identifier "sen0414_ch19ch20_lineage" ;
    rdfs:comment "1.4.0 (2026-11-12): Backlog stage, with the real state-check. Stories are groomed at this stage: each carries acceptance criteria and typed tasks (build and verify; the register knows no other task types) and the lineage's own Definition of Done, written for this lineage and not copied. The state-check tasks are Done because the measurements are the facts of the Mission stage, taken from live files on 2026-11-12."@en .

ex:Backlog8 a backlog:Backlog ;
    rdfs:label "Chapters 19-20 backlog"@en ;
    backlog:backlogForMission ex:Mission8 ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasBacklogMember ex:ST8_StateCheck, ex:ST8_StoryUniqueness, ex:ST8_DraftCh19, ex:ST8_DraftCh20, ex:ST8_ApprovalGate, ex:ST8_BuildCh19, ex:ST8_BuildCh20 .

ex:DoD8 a backlog:DefinitionOfDone ; rdfs:label "Definition of Done of the chapters 19-20 lineage"@en ; backlog:belongsToLineage ex:Lineage8 ;
    rdfs:comment "Written for this lineage. A story is Done only when (1) each of its acceptance criteria has a check that was run in the current turn and its output saved in the repository; (2) the check was read independently of the builder: a verify task re-runs it from the files, not from the builder's report; (3) every fact that can be checked against a live source is, and a failed or unmeasurable check is named in the story's audit note, never dropped; (4) every story told in a chapter has who, what, when, where, why and how, a real picture or a stated reason for none, a live link and a lesson of at most 14 words; (5) every code example of a built deck is run, and its result is shown; (6) the work is in the register before it is in a file."@en .

ex:AC8_StateRecorded a backlog:AcceptanceCriterion ; rdfs:label "Each chapter has a recorded state-check whose figures come from the live files and are repeatable by the checks named in it"@en ; backlog:belongsToLineage ex:Lineage8 .
ex:AC8_UniqueRecorded a backlog:AcceptanceCriterion ; rdfs:label "Every story of chapters 19 and 20 is compared with the stories of chapters 1 to 18 by link and by subject; each repeat is replaced or confirmed by the owner before drafting"@en ; backlog:belongsToLineage ex:Lineage8 .
ex:AC8_DraftApproved a backlog:AcceptanceCriterion ; rdfs:label "The draft states the chapter in plain text, lists its stories with sources, its code examples and its resources, and the owner has approved it"@en ; backlog:belongsToLineage ex:Lineage8 .
ex:AC8_DraftVerified a backlog:AcceptanceCriterion ; rdfs:label "Every claim of the draft that a live source can show was re-read from that source by the verify task and a mismatch was corrected"@en ; backlog:belongsToLineage ex:Lineage8 .
ex:AC8_BuildFromDraft a backlog:AcceptanceCriterion ; rdfs:label "Deck, page and manifest of the chapter contain the content of the approved draft and nothing that departs from it"@en ; backlog:belongsToLineage ex:Lineage8 .
ex:AC8_BuildChecks a backlog:AcceptanceCriterion ; rdfs:label "The deck standard check v1.0.0 passes 13 of 13, the overlap check is clean, every link answers 200, the manifest self-check re-runs every example, the stories self-check has 0 failures and the page test shows 0 failed features"@en ; backlog:belongsToLineage ex:Lineage8 .

ex:ST8_StateCheck a backlog:Story ; rdfs:label "Real state-check of chapters 19-20 materials"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasState backlog:Done ;
    backlog:appliesDefinitionOfDone ex:DoD8 ;
    backlog:hasAcceptanceCriterion ex:AC8_StateRecorded ;
    backlog:decomposesInto ex:TK8_StateCheck_Ch19, ex:TK8_StateCheck_Ch20 .
ex:TK8_StateCheck_Ch19 a backlog:ExecutionTask ; rdfs:label "State-check chapter 19 materials"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Done ;
    backlog:hasAuditNote "From live files, 2026-11-12. Deck 08-tooling/ch19-deck/sen0414_ch19_deck_v1_0_0.pptx, 26 slides, the only deck, none under 03-materials/ch19. Page sen0414_ch19_page_v9_34_0.html, the latest. No chapter-code manifest. Deck standard check v1.0.0: PASS 4, FAIL 7 (D1 slide 1 unnumbered; D2 28 boxes over 30 words, longest 147; D3 0 of 4 code slides complete; D4 0 of 36 concepts with an analogy; D5 0 of 2 story slides complete; D7 notes over 60 words on 26 slides, longest 484; D11 research coverage 38.9 percent), 2 not measured (D10, M1). Overlap check clean. Research check fails at the execution step (rdodi_data v1_0_6). Stories script v1_0_0: 6 stories, self-check 0 failures; the six links (Unix time, Year 2038, Cron, Leap second, Tz database, Gregorian calendar) are shared with no chapter 1 to 18; the name Bell Labs occurs in chapters 5, 8 and 19. Register of the closed slides lineage: TK_Ret_Ch19_* tasks Ready." .
ex:TK8_StateCheck_Ch20 a backlog:ExecutionTask ; rdfs:label "State-check chapter 20 materials"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Done ;
    backlog:hasAuditNote "From live files, 2026-11-12. Decks 08-tooling/ch20-deck/sen0414_ch20_deck_v1_0_0.pptx and v1_0_1 (26 slides each); v1_0_1 is the latest and was checked. None under 03-materials/ch20. Page sen0414_ch20_page_v9_35_0.html, the latest. No chapter-code manifest. Deck standard check v1.0.0 on v1_0_1: PASS 4, FAIL 7 (D1 slide 1 unnumbered; D2 42 boxes over 30 words, longest 117; D3 0 of 4 code slides complete; D4 0 of 34 concepts with an analogy; D5 0 of 2 story slides complete; D7 notes over 60 words on 26 slides, longest 438; D11 research coverage 61.8 percent), 2 not measured (D10, M1). Overlap check clean. Research check fails at the execution step (rdodi_data v1_0_2). Stories script v1_0_0: 6 stories, self-check 0 failures; the six links (Ray Tomlinson, email spam, RFC 821, SMS, Gmail, AT&T notice) are shared with no chapter 1 to 18. Register of the closed slides lineage: TK_Ret_Ch20_* tasks Ready." .

ex:ST8_StoryUniqueness a backlog:Story ; rdfs:label "Check every chapter 19-20 story against chapters 1-18"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD8 ;
    backlog:hasAcceptanceCriterion ex:AC8_UniqueRecorded ;
    backlog:decomposesInto ex:TK8_Unique_Compare, ex:TK8_Unique_Verify .
ex:TK8_Unique_Compare a backlog:ExecutionTask ; rdfs:label "Compare the 12 stories of chapters 19-20 with the stories of chapters 1-18 by link, name and subject; name each repeat"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Ready .
ex:TK8_Unique_Verify a backlog:ExecutionTask ; rdfs:label "Re-run the comparison independently from the story scripts and re-read the Bell Labs overlap in chapters 5, 8 and 19"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK8_Unique_Compare .

ex:ST8_DraftCh19 a backlog:Story ; rdfs:label "Write chapter 19 draft for owner approval"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasState backlog:Blocked ;
    backlog:appliesDefinitionOfDone ex:DoD8 ;
    backlog:hasAcceptanceCriterion ex:AC8_DraftApproved, ex:AC8_DraftVerified ;
    backlog:decomposesInto ex:TK8_Draft_Ch19, ex:TK8_DraftVerify_Ch19 ;
    backlog:dependsOn ex:ST8_StateCheck, ex:ST8_StoryUniqueness .
ex:TK8_Draft_Ch19 a backlog:ExecutionTask ; rdfs:label "Write the plain-text draft of chapter 19: stories with sources, code examples, analogies, resources, what the build changes"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK8_Unique_Verify .
ex:TK8_DraftVerify_Ch19 a backlog:ExecutionTask ; rdfs:label "Re-read every sourced fact and link of the chapter 19 draft from its source"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK8_Draft_Ch19 .

ex:ST8_DraftCh20 a backlog:Story ; rdfs:label "Write chapter 20 draft for owner approval"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasState backlog:Blocked ;
    backlog:appliesDefinitionOfDone ex:DoD8 ;
    backlog:hasAcceptanceCriterion ex:AC8_DraftApproved, ex:AC8_DraftVerified ;
    backlog:decomposesInto ex:TK8_Draft_Ch20, ex:TK8_DraftVerify_Ch20 ;
    backlog:dependsOn ex:ST8_StateCheck, ex:ST8_StoryUniqueness .
ex:TK8_Draft_Ch20 a backlog:ExecutionTask ; rdfs:label "Write the plain-text draft of chapter 20: stories with sources, code examples, analogies, resources, what the build changes"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK8_Unique_Verify .
ex:TK8_DraftVerify_Ch20 a backlog:ExecutionTask ; rdfs:label "Re-read every sourced fact and link of the chapter 20 draft from its source"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK8_Draft_Ch20 .

ex:ST8_ApprovalGate a backlog:Story ; rdfs:label "Owner reads and approves both drafts"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasState backlog:Blocked ;
    backlog:appliesDefinitionOfDone ex:DoD8 ;
    backlog:hasAcceptanceCriterion ex:AC8_DraftApproved ;
    backlog:decomposesInto ex:TK8_Approval ;
    backlog:dependsOn ex:ST8_DraftCh19, ex:ST8_DraftCh20 ;
    rdfs:comment "Blocked on both drafts."@en .
ex:TK8_Approval a backlog:ExecutionTask ; rdfs:label "Owner approves or corrects both drafts"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked .

ex:ST8_BuildCh19 a backlog:Story ; rdfs:label "Build chapter 19 deck, page and manifest from the approved draft"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasState backlog:Blocked ;
    backlog:appliesDefinitionOfDone ex:DoD8 ;
    backlog:hasAcceptanceCriterion ex:AC8_BuildFromDraft, ex:AC8_BuildChecks ;
    backlog:decomposesInto ex:TK8_BuildDeck_Ch19, ex:TK8_BuildPage_Ch19, ex:TK8_BuildVerify_Ch19 ;
    backlog:dependsOn ex:ST8_ApprovalGate ;
    rdfs:comment "Blocked on the approval gate (Excl8_RenderBeforeApproval)."@en .
ex:TK8_BuildDeck_Ch19 a backlog:ExecutionTask ; rdfs:label "Build the chapter 19 deck and its chapter-code manifest from the approved draft"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked .
ex:TK8_BuildPage_Ch19 a backlog:ExecutionTask ; rdfs:label "Build the chapter 19 page with the stories and chapter-code list of the draft"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK8_BuildDeck_Ch19 .
ex:TK8_BuildVerify_Ch19 a backlog:ExecutionTask ; rdfs:label "Run the deck, link, manifest, stories and page checks on the chapter 19 materials and save the logs"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK8_BuildPage_Ch19 .

ex:ST8_BuildCh20 a backlog:Story ; rdfs:label "Build chapter 20 deck, page and manifest from the approved draft"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasState backlog:Blocked ;
    backlog:appliesDefinitionOfDone ex:DoD8 ;
    backlog:hasAcceptanceCriterion ex:AC8_BuildFromDraft, ex:AC8_BuildChecks ;
    backlog:decomposesInto ex:TK8_BuildDeck_Ch20, ex:TK8_BuildPage_Ch20, ex:TK8_BuildVerify_Ch20 ;
    backlog:dependsOn ex:ST8_ApprovalGate ;
    rdfs:comment "Blocked on the approval gate (Excl8_RenderBeforeApproval)."@en .
ex:TK8_BuildDeck_Ch20 a backlog:ExecutionTask ; rdfs:label "Build the chapter 20 deck and its chapter-code manifest from the approved draft"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked .
ex:TK8_BuildPage_Ch20 a backlog:ExecutionTask ; rdfs:label "Build the chapter 20 page with the stories and chapter-code list of the draft"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK8_BuildDeck_Ch20 .
ex:TK8_BuildVerify_Ch20 a backlog:ExecutionTask ; rdfs:label "Run the deck, link, manifest, stories and page checks on the chapter 20 materials and save the logs"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK8_BuildPage_Ch20 .

ex:Lineage8 backlog:hasLineageStatus backlog:LS_InProgress .

ex:Obs1_Obj8_StateChecksRecorded a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj8_StateChecksRecorded ;
    backlog:observedValue 2 ; backlog:observedAt "2026-11-12T00:00:00Z"^^xsd:dateTime ;
    rdfs:comment "Measured: TK8_StateCheck_Ch19 and TK8_StateCheck_Ch20 both Done with file-verified audit notes."@en .
