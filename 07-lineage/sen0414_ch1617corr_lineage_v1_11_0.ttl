    backlog:hasMetric ex:Metric_Obj10_ReaderNotes ; backlog:hasForecastDate "2026-11-23"^^xsd:date .
ex:Metric_Obj10_ReaderNotes a backlog:Metric ; rdfs:label "Notes on the chapter 10 and 11 decks with presenter directions or think-of statements: 43 -> 0"@en ; backlog:metricUnit "note" ; backlog:metricBaseline 43 ; backlog:metricTarget 0 .
ex:Obs0_Obj10_ReaderNotes a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_ReaderNotes ; backlog:observedValue 43 ; backlog:observedAt "2026-11-19T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: a word search of the notes of deck 3.0.0 of chapter 11 (41 of 41 slides hit, from my own earlier notes) and deck 2.0.0 of chapter 10 (2 of 41 hit) for point at, look at, watch, notice, tell, think of, imagine, let's, pause. A reader-notes check will replace the word search and measure the same."@en .
