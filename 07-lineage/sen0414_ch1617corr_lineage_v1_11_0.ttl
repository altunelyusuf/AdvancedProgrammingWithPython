<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.11.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.11.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment """1.11.0 (2026-11-19): Objective stage only. Baselines were measured from the live files on 2026-11-19, not from memory."""@en .

ex:Obj10_ReaderNotes a backlog:Objective ; rdfs:label "Notes on the chapter 10 and 11 decks with presenter directions or think-of statements: 43 -> 0"@en ;
