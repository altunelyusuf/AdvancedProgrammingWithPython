ex:DoD12_ContentUnchanged a backlog:DoDCriterion ;
    rdfs:label "Content, stories and examples stay as approved"@en ;
    backlog:hasCheckQuery "Compare, per chapter, the story ids and the number of examples in the new spec with DRAFT_chNN and the stories file; list every difference." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "Every difference is one a ruling forces and is named in the story's record." ;
    rdfs:comment "The comparison is not yet written; it is written in the Spec stories and its result then replaces this status." .

ex:DoD12_DeckChecks a backlog:DoDCriterion ;
    rdfs:label "Every new deck passes the automatic deck conditions"@en ;
    backlog:hasCheckQuery "Run 08-tooling/lineage12-opening/deckchecks_runner.sh NN DECK MANIFEST LOGDIR for each chapter." ;
    backlog:hasCriterionStatus backlog:Violated ;
    backlog:hasExpectedResult "Every check exits 0 on every chapter." ;
    rdfs:comment "On 2026-11-26 the old decks fail deck standard D7 and D10 on all four chapters and the fit check refuses chapter 12 slide 16 and chapter 15 slide 34; no new deck exists yet." .

