@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch15ch16-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch15ch16-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 15 and 16"@en ;
    owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0414-ch15ch16-lineage/1.1.0> ; dcterms:identifier "sen0414_ch15ch16_lineage" ;
    rdfs:comment "1.1.0 (2026-11-11): Goal stage. SELF-CORRECTING NOTE: v1.0.0 of this file inadvertently combined the Mission and Scope stages in one commit, repeating the same stage-mixing lapse v1.0.0 of the ch13ch14 lineage made (and self-corrected from its v1.1.0 onward). Left as committed per the append-only convention (never rewrite a committed version file); the lapse is named here rather than hidden, and one-stage-per-version resumes strictly from this version onward."@en .

## --- Goal (G201: a concrete, checkable condition that makes the mission true) ---

ex:G6_DraftApproved a backlog:Goal ;
    rdfs:label "Owner approves one draft per chapter"@en ;
    backlog:goalForMission ex:Mission6 ; backlog:belongsToLineage ex:Lineage6 ;
    backlog:hasGoalStatement "The owner reads and approves one plain-text draft for chapter 15 and one for chapter 16, each covering the real story/explanation/outline/resources content, before any render step runs." ;
    backlog:goalCompletionState backlog:Proposed .

ex:G6_StateChecked a backlog:Goal ;
    rdfs:label "Chapters 15-16 materials checked against current standard"@en ;
    backlog:goalForMission ex:Mission6 ; backlog:belongsToLineage ex:Lineage6 ;
    backlog:hasGoalStatement "What already exists for chapters 15 and 16 (deck, page, stories, code, resources) is re-checked against the owner's 2026-11-09 story principle and the current resources-slide standard, with any stale, missing or duplicated item named plainly before drafting." ;
    backlog:goalCompletionState backlog:Proposed .
