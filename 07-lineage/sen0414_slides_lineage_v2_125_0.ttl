    backlog:plansItem ex:ST_ReworkDeck_Ch03 ; backlog:producesTask ex:TK_ReworkDeck_Build, ex:TK_ReworkDeck_Verify .
ex:Refine_ReworkDeck a backlog:RefinementEvent ; rdfs:label "Refinement that made Rework of the chapter 3 deck as a lecture ready"@en ;
    backlog:refines ex:ST_ReworkDeck_Ch03 ; backlog:addressesConcern backlog:Concern_Data ; backlog:refinedAt "2026-09-29T05:54:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Owner ; backlog:groomsForIteration ex:Iter_3 ; backlog:hasRefinementOutcome "Settled: the deck is a lecture. Each slide has a talk track in its notes; an argument builds click by click; a process is drawn as a trace, a number line or pair lanes from a specification that was executed, never typed; every specification is re-run by the deck's check, and the programs the traces come from are re-run by the program check." .
ex:TK_ReworkDeck_Build a backlog:ExecutionTask ; rdfs:label "Rework of the chapter 3 deck as a lecture: build"@en ; backlog:hasIdentifier "TK_ReworkDeck_Build" ; backlog:hasTitle "Build Rework of the chapter 3 deck as a lecture" ;
    backlog:belongsToLineage ex:Lineage ; backlog:memberOfContainer ex:Backlog ; backlog:admittedByOutput ex:Out_Backlog ; backlog:hasState backlog:Done ; backlog:startedAt "2026-09-29T05:54:00"^^xsd:dateTime ; backlog:finishedAt "2026-09-29T06:07:49"^^xsd:dateTime ; backlog:hasEvidence ex:Ev_ReworkDeck ;
