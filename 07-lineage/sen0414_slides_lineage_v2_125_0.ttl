ex:Ev_Research_Ch17 a backlog:TestEvidence ; rdfs:label "Checks for Research Ch17"@en ; backlog:belongsToLineage ex:Lineage ;
    backlog:attestsCriterion ex:AC_Chapter ; backlog:evidenceVerified true ; backlog:hasTestId "Research/Ch17" ;
    backlog:hasTestSpec "RDODI Stages 1-3 for chapter 17 (PDF and Word Documents), built by 08-tooling/sen0414_ch17_build_run_v1_0_0.py from 08-tooling/sen0414_ch17_rdodi_data_v1_0_1.py: 52 sources (all HTTP 200 on the second pass), 15 findings, a taxonomy of 6 subjects, 19 mid concepts, 70 leaves and 95 document sections. Re-run by the lineage session: Stage1.A 842 triples, Stage1.B 0 violations, Stage2.A 403, Stage2.C conforms, Stage3.A 778, Stage3.F 52 citations verified, Stage3.B conforms, Stage3.E coverage and substance 96, source check 96 real-sourced; overall PASS. Reported by the building agent, not re-run by the lineage session: 105 execution checks with 0 mismatches and HermiT consistent; 91 third-party statements (89 match under the newest versions, 88 under the pins); 10 interpreters (3.11.17, 3.12.3, 3.13.16, 3.14.0 to 3.14.6); 12 corpus programs exit 0 under 3.14.6; eight diagrams all at 0.84 or more; six stories whose links answered HTTP 200. NOT EXECUTED: Microsoft Word and PDF viewers (no GUI steps; LibreOffice only counted pages in one case); the book's AI post-processing section (the language-model clean-up was not run); four sources were unreachable (GitHub and pdfa.org 403, ecma-international connection reset, planetpdf proxy error); the redaction-failure story was dropped; no story photograph (Wikimedia answered 429 including after spaced retries); timings come from one two-core machine and are indicative only." ;
    backlog:hasVerificationMethod "Gates run over the artefacts as committed in 94706a4 (sen0414: chapter 17 (PDF and Word Documents) research package at the CME standard); the gates re-run by the lineage session at 2026-10-12T18:32:14 UTC." ;
    backlog:verifiedByTool "08-tooling/sen0414_rdodi_gates_v1_1_1.py (rdodi-ecosystem/02-gates/rdodi_pipeline_validator_v1_6_0.py, Stages 1-3), sen0414_rdodi_checks_v1_2_0.py (Python 3.14.x; HermiT)" ;
    backlog:verifiedAt "2026-10-12T18:32:40"^^xsd:dateTime .
