    backlog:notYetScoreable true ; backlog:hasScoreabilityReason "Ranked through its stories' scores at planning." ;
    backlog:decomposesInto ex:ST_Deck_Ch01, ex:ST_Deck_Ch02, ex:ST_Deck_Ch03, ex:ST_Deck_Ch04, ex:ST_Deck_Ch05, ex:ST_Deck_Ch06, ex:ST_Deck_Ch07, ex:ST_Deck_Ch08, ex:ST_Deck_Ch09, ex:ST_Deck_Ch10, ex:ST_Deck_Ch11, ex:ST_Deck_Ch13, ex:ST_Deck_Ch14, ex:ST_Deck_Ch19, ex:ST_Deck_Ch24, ex:ST_Deck_Threads .

