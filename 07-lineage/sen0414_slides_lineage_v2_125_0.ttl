ex:Ev_Research_Ch15 a backlog:TestEvidence ; rdfs:label "Checks for Research Ch15"@en ; backlog:belongsToLineage ex:Lineage ;
    backlog:attestsCriterion ex:AC_Chapter ; backlog:evidenceVerified true ; backlog:hasTestId "Research/Ch15" ;
    backlog:hasTestSpec "RDODI Stages 1-3 for chapter 15 (Google Sheets), built by 08-tooling/sen0414_ch15_build_run_v1_0_0.py from 08-tooling/sen0414_ch15_rdodi_data_v1_0_1.py: 60 sources (all answered HTTP 200 with their passages present, per the builder), 14 findings, a taxonomy of 6 subjects, 20 mid concepts, 69 leaves and 95 document sections. Re-run by the lineage session: Stage1.A 813 triples, Stage1.B 0 violations, Stage2.A 403, Stage2.C conforms, Stage3.A 778, Stage3.F 60 citations verified, Stage3.B conforms, Stage3.E coverage and substance 96, source check 96 real-sourced; overall PASS. Reported by the building agent, not re-run by the lineage session: 127 execution checks with 0 mismatches and HermiT consistent; 47 whole third-party programs with 0 differing; 12 corpus programs exit 0; eight diagrams all at 0.90 or more; six stories whose links answered HTTP 200; the chapter page sha256 equals the book ontology's chapterDigest. NOT EXECUTED and stated so in the record: Google was replaced by a stand-in written for the run, so no Google answer was observed; everything needing an OAuth token, consent or the live API (creation, USER_ENTERED parsing, real quota errors, the Forms tool, revoking credentials, filling a sheet to the cell limit) was not run; 8 of 69 leaves are documentation-only; gspread was not run; the pinned chapter commit was not opened; no story photograph (Wikimedia rate-limited this environment), so none is shipped." ;
    backlog:hasVerificationMethod "Gates run over the artefacts as committed in 7dc0c93 (sen0414: chapter 15 (Google Sheets) research package at the CME standard); the gates re-run by the lineage session at 2026-10-12T12:16:26 UTC." ;
    backlog:verifiedByTool "08-tooling/sen0414_rdodi_gates_v1_1_1.py (rdodi-ecosystem/02-gates/rdodi_pipeline_validator_v1_6_0.py, Stages 1-3), sen0414_rdodi_checks_v1_2_0.py (Python 3.14.x; HermiT)" ;
    backlog:verifiedAt "2026-10-12T12:16:46"^^xsd:dateTime .
ex:Harness_Research_Ch15 a backlog:TestHarness ; rdfs:label "Checks for Research Ch15"@en ; backlog:harnessFor ex:ST_Research_Ch15 ; backlog:harnessComplete true ; backlog:hasHarnessEvidence ex:Ev_Research_Ch15 .
