ex:Excl_CommandLine a backlog:ScopeExclusion ;
    rdfs:label "No deck for command-line programs, or chapters equally outdated"@en ;
    backlog:excludesConcern "The 3rd edition's chapter 12, Designing and Deploying Command Line Programs, and any chapter the owner judges equally outdated." ;
    backlog:hasExclusionRationale "Owner ruling, 2026-09-24: not the current style of programming; not taught." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Product .

ex:Excl_Untaught a backlog:ScopeExclusion ;
    rdfs:label "No renewal for chapters the owner does not teach this term"@en ;
    backlog:excludesConcern "Chapters 15-18 and 20-23 of the 3rd edition, and the two GUI decks, which correspond to no chapter of any edition; the existing decks stay as they are." ;
    backlog:hasExclusionRationale "The owner's outline marks the planned chapters; the rest are taught only if time allows, and are renewed when the owner schedules them, not before." ;
    backlog:decidedBy backlog:Owner ; backlog:hasScopeLayer backlog:Layer_Product .

ex:Scope a backlog:ScopeStatement ;
    rdfs:label "Renew what is taught, deck by deck, on research"@en ;
    backlog:scopeForMission ex:Mission ; backlog:belongsToLineage ex:Lineage ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:scopeCompletionState backlog:Proposed ;
    backlog:hasScopeStatementText "IN (as of 2026-10-12, superseding the 2026-09-24/earlier text below): every chapter of the 3rd edition - including chapter 12, command-line programs, and chapters 15-18 and 20-23 held for scheduling - plus multithreading from the 2nd; a restyled and rewritten deck, the RDODI research behind it, and an interactive page for each, built chapter by chapter on the owner's 2026-10-12 ruling (see ex:Excl_CommandLine and ex:Excl_Untaught for the lifted exclusions). OUT: the two GUI decks only. Original text (2026-09-24): IN: for each of the sixteen taught subjects - fifteen chapters of the 3rd edition and multithreading from the 2nd - a restyled and rewritten deck, the RDODI research behind it, and an interactive page. OUT: command-line programs; chapters not taught this term; the two GUI decks." ;
    backlog:coversArea ex:Area_Deck, ex:Area_Research, ex:Area_Page ;
    backlog:hasScopeExclusion ex:Excl_CommandLine, ex:Excl_Untaught ;
    backlog:producedByStage ex:Out_Scope ;
    backlog:requiresDeliverable ex:Del_Deck_Ch01, ex:Del_Research_Ch01, ex:Del_Page_Ch01, ex:Del_Deck_Ch02, ex:Del_Research_Ch02, ex:Del_Page_Ch02, ex:Del_Deck_Ch03, ex:Del_Research_Ch03, ex:Del_Page_Ch03, ex:Del_Deck_Ch04, ex:Del_Research_Ch04, ex:Del_Page_Ch04, ex:Del_Deck_Ch05, ex:Del_Research_Ch05, ex:Del_Page_Ch05, ex:Del_Deck_Ch06, ex:Del_Research_Ch06, ex:Del_Page_Ch06, ex:Del_Deck_Ch07, ex:Del_Research_Ch07, ex:Del_Page_Ch07, ex:Del_Deck_Ch08, ex:Del_Research_Ch08, ex:Del_Page_Ch08, ex:Del_Deck_Ch09, ex:Del_Research_Ch09, ex:Del_Page_Ch09, ex:Del_Deck_Ch10, ex:Del_Research_Ch10, ex:Del_Page_Ch10, ex:Del_Deck_Ch11, ex:Del_Research_Ch11, ex:Del_Page_Ch11, ex:Del_Deck_Ch13, ex:Del_Research_Ch13, ex:Del_Page_Ch13, ex:Del_Deck_Ch14, ex:Del_Research_Ch14, ex:Del_Page_Ch14, ex:Del_Deck_Ch19, ex:Del_Research_Ch19, ex:Del_Page_Ch19, ex:Del_Deck_Ch24, ex:Del_Research_Ch24, ex:Del_Page_Ch24, ex:Del_Deck_Threads, ex:Del_Research_Threads, ex:Del_Page_Threads .

ex:Blueprint a backlog:Blueprint ;
    rdfs:label "What the slide renewal is about"@en ;
    backlog:belongsToLineage ex:Lineage ; backlog:blueprintFor ex:Scope, ex:Backlog ;
    backlog:hasDomainEntity ex:DE_Deck, ex:DE_ResearchRun, ex:DE_InteractivePage .
ex:DE_Deck a backlog:DomainEntity ; rdfs:label "Deck - a chapter's lecture slides"@en ; backlog:belongsToLineage ex:Lineage .
ex:DE_ResearchRun a backlog:DomainEntity ; rdfs:label "Research run - an RDODI run on a chapter's subject"@en ; backlog:belongsToLineage ex:Lineage .
ex:DE_InteractivePage a backlog:DomainEntity ; rdfs:label "Interactive page - a chapter's companion page"@en ; backlog:belongsToLineage ex:Lineage .
