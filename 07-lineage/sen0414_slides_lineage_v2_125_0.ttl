ex:ST_ReworkDeck_Ch03 a backlog:Story ; rdfs:label "Rework of the chapter 3 deck as a lecture"@en ; backlog:hasIdentifier "ST_ReworkDeck_Ch03" ; backlog:hasTitle "Rework of the chapter 3 deck as a lecture" ;
    backlog:belongsToLineage ex:Lineage ; backlog:memberOfContainer ex:Backlog ; backlog:admittedByOutput ex:Out_Backlog ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:asRole "SEN0414 instructor" ; backlog:wantsCapability "the chapter 3 deck reworked as a lecture - a narrative in the speaker notes, click-by-click builds, and traces, number lines and pair diagrams drawn from executed specifications" ; backlog:soThat "a lecture teaches the concepts with a narrative and visuals, not with code listings" ;
    backlog:satisfiesDeliverable ex:Del_Deck_Ch03 ; backlog:pursuesObjective ex:Obj_DecksRenewed ; backlog:hasAcceptanceCriterion ex:AC_Chapter ;
