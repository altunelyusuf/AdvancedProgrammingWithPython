ex:Gap_ResearchRun_Creation a backlog:BlueprintGap ; rdfs:label "No coverage yet for the ResearchRun at the creation stage"@en ; backlog:gapForEntity ex:DE_ResearchRun ; backlog:gapForStage backlog:Stage_Creation ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_ResearchRun_ActiveUse a backlog:BlueprintGap ; rdfs:label "No coverage yet for the ResearchRun at the active use stage"@en ; backlog:gapForEntity ex:DE_ResearchRun ; backlog:gapForStage backlog:Stage_ActiveUse ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_ResearchRun_SuspensionException a backlog:BlueprintGap ; rdfs:label "No coverage yet for the ResearchRun at the suspension or exception stage"@en ; backlog:gapForEntity ex:DE_ResearchRun ; backlog:gapForStage backlog:Stage_SuspensionException ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_ResearchRun_Termination a backlog:BlueprintGap ; rdfs:label "No coverage yet for the ResearchRun at the termination stage"@en ; backlog:gapForEntity ex:DE_ResearchRun ; backlog:gapForStage backlog:Stage_Termination ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_InteractivePage_Creation a backlog:BlueprintGap ; rdfs:label "No coverage yet for the InteractivePage at the creation stage"@en ; backlog:gapForEntity ex:DE_InteractivePage ; backlog:gapForStage backlog:Stage_Creation ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_InteractivePage_ActiveUse a backlog:BlueprintGap ; rdfs:label "No coverage yet for the InteractivePage at the active use stage"@en ; backlog:gapForEntity ex:DE_InteractivePage ; backlog:gapForStage backlog:Stage_ActiveUse ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_InteractivePage_SuspensionException a backlog:BlueprintGap ; rdfs:label "No coverage yet for the InteractivePage at the suspension or exception stage"@en ; backlog:gapForEntity ex:DE_InteractivePage ; backlog:gapForStage backlog:Stage_SuspensionException ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .
ex:Gap_InteractivePage_Termination a backlog:BlueprintGap ; rdfs:label "No coverage yet for the InteractivePage at the termination stage"@en ; backlog:gapForEntity ex:DE_InteractivePage ; backlog:gapForStage backlog:Stage_Termination ; backlog:hasGapReason "Admitted work that covers it arrives at the Backlog stage." .

ex:G_DecksTeachTheBook a backlog:Goal ;
    rdfs:label "Every taught deck teaches what its edition teaches"@en ;
    backlog:belongsToLineage ex:Lineage ; backlog:derivesFromScope ex:Scope ; backlog:goalCoversArea ex:Area_Deck ;
    backlog:contributesToMission ex:Mission ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner ;
    backlog:hasGoalRationale "Derived from the scope's deck area, and from the owner's request of 2026-09-24 for renewed decks, research and interactive pages together." ;
    backlog:producedByStage ex:Out_Goal .

ex:G_ResearchBehindEveryDeck a backlog:Goal ;
    rdfs:label "Every renewed deck rests on a recorded research run"@en ;
