ex:Complete_Template a backlog:TransitionEvent ; rdfs:label "Page template 9.7.0 from the owner's feedback on the pages completed"@en ;
    backlog:transitionedItem ex:ST_Template_Ch05 ; backlog:viaTransition backlog:T_Complete ;
