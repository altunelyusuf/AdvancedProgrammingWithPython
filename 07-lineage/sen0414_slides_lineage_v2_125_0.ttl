ex:Score_ReworkDeck a backlog:PriorityScore ; backlog:scoredByMethod backlog:Method_WSJF ;
    backlog:hasScoreValue "9.60"^^xsd:decimal ; backlog:scoredAt "2026-09-29T05:54:00"^^xsd:dateTime ; backlog:isAveragedFromMembers false ;
    backlog:hasScoreRationale "WSJF = (business value 20 + time criticality 20 + risk reduction 8) / job size 5, Components reused from the same kind of story in chapters 1 and 2, whose scores the owner approved; they were not approved again for this rework, so they are a proposal to the owner (L-116), not an approval. Time criticality is set by the class at 14:00 Istanbul on 2026-10-02." .
ex:Plan_ReworkDeck a backlog:PlanningEvent ; rdfs:label "Planning of Rework of the chapter 3 deck as a lecture into the third iteration"@en ; backlog:belongsToLineage ex:Lineage ;
