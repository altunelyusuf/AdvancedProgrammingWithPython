@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch17ch18-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch17ch18-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 17 and 18"@en ;
    owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0414-ch17ch18-lineage/1.1.0> ; dcterms:identifier "sen0414_ch17ch18_lineage" ;
    rdfs:comment "1.1.0 (2026-11-11): Scope stage only. Areas are taken from the chapter ontologies' own labels (automate_python_3e_ch17_v1_0_0.ttl: PDF Documents, Word Documents, Practice Programs; automate_python_3e_ch18_v1_0_0.ttl: The CSV Format, Versatile Plaintext Formats, Practice Program: Excel-to-CSV Converter), read for this stage."@en .

ex:Scope7 a backlog:ScopeStatement ;
    rdfs:label "Draft, check and (on approval) render chapters 17-18 only"@en ;
    backlog:scopeForMission ex:Mission7 ; backlog:belongsToLineage ex:Lineage7 ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:scopeCompletionState backlog:Proposed ;
    backlog:coversArea ex:Area7_StateCheck, ex:Area7_Draft, ex:Area7_Render ;
    backlog:hasScopeExclusion ex:Excl7_Ch1to16, ex:Excl7_OtherChapters, ex:Excl7_ExamWork, ex:Excl7_RenderBeforeApproval, ex:Excl7_StructuralRetrofit, ex:Excl7_Rdodi ;
    backlog:hasScopeDeliverable ex:Del7_ApprovedDraft, ex:Del7_CheckedMaterials ;
    backlog:hasScopeStatementText "IN: for chapters 17 (PDF Documents: pypdf PdfReader/PdfWriter, extracting text, rotating, assembling and protecting PDFs; Word Documents: python-docx Document, paragraphs, runs, styles, headings, pictures; practice programs) and 18 (The CSV Format: csv reader/writer/DictReader/DictWriter; Versatile Plaintext Formats: JSON and XML with ElementTree and xmltodict; the Excel-to-CSV converter) of the 3rd edition only - (a) read the existing deck, page, story-companion scripts and say plainly what is stale, missing or duplicated against the 2026-11-09 story principle and the current resources-slide standard; (b) write one plain-text draft per chapter for the owner's approval; (c) only after approval, render or confirm deck, page and document from that draft. OUT: see the exclusions." .

ex:Area7_StateCheck a backlog:ScopeArea ; rdfs:label "What exists for chapters 17-18 today"@en ; backlog:belongsToLineage ex:Lineage7 .
ex:Area7_Draft a backlog:ScopeArea ; rdfs:label "The one approved draft per chapter"@en ; backlog:belongsToLineage ex:Lineage7 .
ex:Area7_Render a backlog:ScopeArea ; rdfs:label "Deck, page and document rendered from the approved draft"@en ; backlog:belongsToLineage ex:Lineage7 .

ex:Del7_ApprovedDraft a backlog:ScopeDeliverable ; rdfs:label "Owner-approved plain-text draft, chapters 17 and 18"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:deliverableForArea ex:Area7_Draft .
ex:Del7_CheckedMaterials a backlog:ScopeDeliverable ; rdfs:label "Chapter-17/18 materials checked against current standard, gaps named"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:deliverableForArea ex:Area7_StateCheck .

ex:Excl7_Ch1to16 a backlog:ScopeExclusion ; rdfs:label "Chapters 1-16"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasExclusionRationale "Chapters 1-8 are midterm scope; chapters 9-16 belong to Lineage3 to Lineage6, none widened here." .
ex:Excl7_OtherChapters a backlog:ScopeExclusion ; rdfs:label "Chapters 19-25"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasExclusionRationale "Later chapter pairs get their own narrow lineages." .
ex:Excl7_ExamWork a backlog:ScopeExclusion ; rdfs:label "Exam and mock-exam work"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasExclusionRationale "Held outside this repository." .
ex:Excl7_RenderBeforeApproval a backlog:ScopeExclusion ; rdfs:label "Rendering before the draft is approved"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasExclusionRationale "Same draft-first rule as Lineage3 to Lineage6." .
ex:Excl7_StructuralRetrofit a backlog:ScopeExclusion ; rdfs:label "The iteration-20 structural retrofit for chapters 17-18"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasExclusionRationale "Recorded Done in the closed Lineage2 after its own repair cycles (ch17 page v9_95_0 to v9_96_0; ch18 page v9_95_0 to v9_96_0, deck v2_0_0 to v2_0_1); final controller checks pass. Not reopened without a found defect." .
ex:Excl7_Rdodi a backlog:ScopeExclusion ; rdfs:label "The rdodi/ research-artifact set for chapters 17-18"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasExclusionRationale "A separate artifact family from the deck+page+story+code+resources material this lineage reviews; left untouched, as in Lineage6." .
