@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch17ch18-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch17ch18-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 17 and 18"@en ;
    owl:versionInfo "1.4.0" ; owl:versionIRI <http://example.org/sen0414-ch17ch18-lineage/1.4.0> ; dcterms:identifier "sen0414_ch17ch18_lineage" ;
    rdfs:comment "1.4.0 (2026-11-11): Backlog stage, with the real state-check. No legacy YA duplicate decks exist for either chapter, so there is no retirement story."@en .

ex:Backlog7 a backlog:Backlog ;
    rdfs:label "Chapters 17-18 backlog"@en ;
    backlog:backlogForMission ex:Mission7 ; backlog:belongsToLineage ex:Lineage7 ;
    backlog:hasBacklogMember ex:ST7_StateCheck, ex:ST7_DraftCh17, ex:ST7_DraftCh18, ex:ST7_ApprovalGate, ex:ST7_RenderCh17, ex:ST7_RenderCh18 .

ex:ST7_StateCheck a backlog:Story ; rdfs:label "Real state-check of chapters 17-18 materials"@en ; backlog:belongsToLineage ex:Lineage7 ;
    backlog:decomposesInto ex:TK7_StateCheck_Ch17, ex:TK7_StateCheck_Ch18 ; backlog:hasState backlog:Done .

ex:TK7_StateCheck_Ch17 a backlog:Task ; rdfs:label "State-check chapter 17 materials"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Done ;
    backlog:hasAuditNote "From live files. Deck SEN0414_Ch17_PDFAndWordDocuments_3e_v2_0_0.pptx, the only version, 58 slides (slide_text.py). Page sen0414_ch17_page_v9_96_0.html is the latest; v9_95_0 failed page test 9.37.0 intermittently (PIL left None in sys.modules) and was repaired as v9_96_0; final runs pass (pagechk_Page_Ch17_v9_96_0_run5.log: Page/Ch17 PASS, 402 features passed, 0 failed; width_ch17_v9_96_0 PASS at 1366, 1400 and 390 px; leak probe seed 5 PASS). Register verdicts for TK_Ret_Ch17_Research, _Deck_Build and _Page_Build: Done. Stories script sen0414_ch17_stories_v1_0_0.py defines 6 stories (PDF/Camelot 1991, ZIP 1989, Office Open XML 2006-2008, PDF 1.7 ISO 32000, pypdf lineage, python-docx vs docx 2014). Manifest chapter_code_ch17_v1_0_0.json lists 28 examples. Resources slide has 14 links; link-by-link recheck is done when the draft is written. No legacy YA duplicate deck. rdodi/ folder out of scope (Excl7_Rdodi)." .

ex:TK7_StateCheck_Ch18 a backlog:Task ; rdfs:label "State-check chapter 18 materials"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Done ;
    backlog:hasAuditNote "From live files. Two decks exist; the register's control verdict (Ev2_Ctl_deck18) names SEN0414_Ch18_CSVJSONXML_3e_v2_0_1.pptx as the controlled deck (53 slides), v2_0_0 is superseded and not delivered. Page sen0414_ch18_page_v9_96_0.html is the latest; v9_95_0 failed the leak probe on seed 3 and the story-layout probe, repaired as template 9.52.4 and v9_96_0; final run passes (pagechk_Page_Ch18_v9_96_0_run5.log: Page/Ch18 PASS, 400 features passed, 0 failed). Register verdicts for the three Ch18 build tasks: Done. Stories script sen0414_ch18_stories_v1_0_0.py defines 6 stories (CSV 1972/1983, RFC 4180, JSON 2001, XML 1998, ElementTree and json in Python 2.5/2.6, billion laughs). Manifest chapter_code_ch18_v1_0_1.json lists 27 examples (the older v1_0_0 manifest is superseded). Resources slide has 14 links; link-by-link recheck is done when the draft is written. No legacy YA duplicate deck. rdodi/ folder out of scope." .

ex:ST7_DraftCh17 a backlog:Story ; rdfs:label "Write chapter 17 draft for owner approval"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Ready .
ex:ST7_DraftCh18 a backlog:Story ; rdfs:label "Write chapter 18 draft for owner approval"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Ready .
ex:ST7_ApprovalGate a backlog:Story ; rdfs:label "Owner reads and approves both drafts"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Blocked ;
    rdfs:comment "Blocked on both drafts."@en .
ex:ST7_RenderCh17 a backlog:Story ; rdfs:label "Render/confirm chapter 17 deck+page from the approved draft"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Blocked ;
    rdfs:comment "Blocked on the approval gate (Excl7_RenderBeforeApproval)."@en .
ex:ST7_RenderCh18 a backlog:Story ; rdfs:label "Render/confirm chapter 18 deck+page from the approved draft"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Blocked ;
    rdfs:comment "Blocked on the approval gate (Excl7_RenderBeforeApproval)."@en .

ex:Lineage7 backlog:hasLineageStatus backlog:LS_InProgress .

ex:Obs1_Obj7_StateChecksRecorded a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj7_StateChecksRecorded ;
    backlog:observedValue 2 ; backlog:observedAt "2026-11-11T00:00:00Z"^^xsd:dateTime ;
    rdfs:comment "Measured: TK7_StateCheck_Ch17 and TK7_StateCheck_Ch18 both Done with file-verified audit notes."@en .
