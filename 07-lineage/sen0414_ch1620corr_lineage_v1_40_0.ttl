#  Lineage13 set down into archive/sen0414_ch1620corr_lineage_archive_v1_1_0.ttl; the lineage,
#  its mission and its closure report stay here as the record that points in.
#################################################################

# The record each retired lineage leaves in the live register: a LineageArchiveEntry, not a
# Lineage -- no shape targeting Lineage, Mission or any stage element fires on retired work (G92).
ex:ArchiveEntry_Lineage13 a backlog:LineageArchiveEntry ;
    backlog:entryForLineage <http://example.org/sen0414-ch1620corr-lineage#Lineage13> ;
    backlog:entryForMission <http://example.org/sen0414-ch1620corr-lineage#Mission13> ;
    backlog:entryOutcome backlog:Out_Achieved ;
    backlog:entryOrdinal 13 ;
    backlog:archiveFile "archive/sen0414_ch1620corr_lineage_archive_v1_1_0.ttl" ;
    backlog:archivedAt "2026-11-26T17:07:53Z"^^xsd:dateTime ;
    backlog:archivalTrigger "Retired whole by backlog_lineage_archive_v2_0_0: mission Out_Achieved, closure report present, every item Done or Cancelled, not frozen. Everything the lineage owned -- its Lineage individual, its Mission, its closure report, its stage outputs, findings and items -- moved to the archive file; this entry is the only thing that remains, and it is a record, not a lineage (G92)." .
ex:Lineage13 backlog:lineageArchived true ; backlog:archiveFile "archive/sen0414_ch1620corr_lineage_archive_v1_1_0.ttl" ;
    backlog:archivedAt "2026-11-26T17:07:53Z"^^xsd:dateTime ; backlog:hasLineageStatus backlog:LS_Archived ;
    backlog:archivalTrigger "Found achieved and un-archived by backlog_lineage_archive_v2_12_0: mission Out_Achieved, closure report ClosureReport13 present, every item Done or Cancelled, not frozen. Owner's rule 2026-09-09: a settled lineage found un-archived triggers the archival activity." .
