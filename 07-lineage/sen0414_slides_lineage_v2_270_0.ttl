    backlog:hasInvestmentCategory backlog:Cat_Compliance ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:effectiveDefinitionOfDone ex:DoD ; backlog:hasState backlog:Done ; backlog:startedAt "2026-10-24T22:06:38"^^xsd:dateTime ; backlog:finishedAt "2026-10-24T23:54:34"^^xsd:dateTime ; backlog:hasEvidence ex:Ev2_Ctl_pagetest37, ex:Ev2_CtlFile_pagetest37_0 ;
