    backlog:belongsToLineage ex:Lineage2 ; backlog:memberOfContainer ex:Iter_19 ; backlog:responsible ex:Executor_ClaudeCodeSession ; backlog:admittedByOutput ex:Out2_BacklogR11 ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:asRole "SEN0414 instructor" ; backlog:wantsCapability "chapter 1 taught from a deck and a page that meet the written standard, with the slide code runnable in the page" ; backlog:soThat "every chapter of the course is taught from decks and pages that meet the same written standard" ;
    backlog:satisfiesDeliverable ex:Del2_StdDecks, ex:Del2_StdPages ; backlog:pursuesObjective ex:Obj2_StdDecks, ex:Obj2_StdPages ; backlog:hasAcceptanceCriterion ex:AC2F_Retrofit, ex:AC2F_RetrofitResearch ;
