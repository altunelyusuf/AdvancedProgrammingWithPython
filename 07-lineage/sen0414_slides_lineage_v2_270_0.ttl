ex:TK_Assess_Verify a backlog:ExecutionTask ; rdfs:label "Ten question types with corrections, mock midterm and final exams, and the live-model choice on the pages of chapters 1 to 6: verify"@en ; backlog:hasIdentifier "TK_Assess_Verify" ; backlog:hasTitle "Verify Ten question types with corrections, mock midterm and final exams, and the live-model choice on the pages of chapters 1 to 6" ;
    backlog:belongsToLineage ex:Lineage ; backlog:memberOfContainer ex:Backlog ; backlog:admittedByOutput ex:Out_Backlog ; backlog:hasState backlog:Done ; backlog:startedAt "2026-09-30T11:21:00"^^xsd:dateTime ; backlog:finishedAt "2026-09-30T12:11:17"^^xsd:dateTime ; backlog:hasEvidence ex:Ev_Assess ;
