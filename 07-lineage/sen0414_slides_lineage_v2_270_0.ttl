    backlog:hasInvestmentCategory backlog:Cat_NewCapability ; backlog:hasTaskType backlog:TaskType_Build ; backlog:effectiveDefinitionOfDone ex:DoD ; backlog:hasState backlog:Done ; backlog:startedAt "2026-10-25T01:49:00"^^xsd:dateTime ; backlog:finishedAt "2026-10-25T02:07:53"^^xsd:dateTime ; backlog:hasEvidence ex:Ev2_Ctl_deck05, ex:Ev2_CtlFile_deck05_0, ex:Ev2_CtlFile_deck05_1 ;
