ex:ST_Std_DeckTools a backlog:Story ; rdfs:label "The deck standard and the deck overlap check are measured by new tools, as new files, without moving any existing gate"@en ; backlog:hasIdentifier "ST_Std_DeckTools" ; backlog:hasTitle "The deck standard and the deck overlap check are measured by new tools, as new files, without moving any existing gate" ;
