ex:TK_Ret_Ch20_Page_Build a backlog:ExecutionTask ; rdfs:label "Rebuild the page of chapter 20 (Email, Texts and Push Notifications) on the new template with the chapter-code tab"@en ; backlog:hasIdentifier "TK_Ret_Ch20_Page_Build" ; backlog:hasTitle "Rebuild the page of chapter 20 (Email, Texts and Push Notifications) on the new template with the chapter-code tab" ;
