    backlog:satisfiesDeliverable ex:Del_Page_Ch05 ; backlog:pursuesObjective ex:Obj_PagesBuilt ; backlog:hasAcceptanceCriterion ex:AC_Chapter ;
    backlog:effectiveDefinitionOfDone ex:DoD ; backlog:hasApplicableConcern backlog:Concern_Data ;
