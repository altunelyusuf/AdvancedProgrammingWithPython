    backlog:contributesToGoal ex:G4_StateChecked ; backlog:fillsScope ex:Scope4 ; backlog:hasSuccessMetric ex:Met4_StateChecksRecorded ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasMeasurementQuery "Count of chapters (of 11, 12) whose existing deck/page/story-companion-script state has been read against the owner's 2026-11-09 story principle and the current resources-slide standard, with gaps named in writing." ;
    backlog:hasBaselineValue "0"^^xsd:decimal ; backlog:hasTargetValue "2"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Increase ;
