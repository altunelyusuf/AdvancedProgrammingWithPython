    backlog:observesMetric ex:Met4_StateChecksRecorded ; backlog:observationFor ex:Obj4_StateChecksRecorded ; backlog:hasObservedValue "0"^^xsd:decimal ;
    backlog:observedAt "2026-11-10T00:00:00Z"^^xsd:dateTime ; backlog:observedDuringCeremony true ;
