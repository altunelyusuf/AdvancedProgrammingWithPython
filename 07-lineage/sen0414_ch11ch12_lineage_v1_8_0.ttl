    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasMeasurementQuery "Count of chapter-11/12 plain-text drafts the owner has approved, read from his reply in this conversation." ;
    backlog:hasBaselineValue "0"^^xsd:decimal ; backlog:hasTargetValue "2"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasForecastDate "2026-11-12"^^xsd:date ; backlog:hasForecastRationale "Same two-day pacing as Lineage3's Obj3_DraftsApproved: draft for the owner's reading, leaving time for checking and rendering before the week's lecture. A forecast at the pace delivered, not a deadline or promise." ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:decidedBy backlog:Owner .
