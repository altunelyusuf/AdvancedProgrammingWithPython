    backlog:metricBaseline "0"^^xsd:integer ; backlog:metricTarget "5"^^xsd:integer ; backlog:metricUnit "chapter" ;
    rdfs:label "Chapters 21 to 25 that pass every objective of goals G14_DeckReads, G14_PageRuns and G14_Released, so a lecturer can teach and a student learn from them: 0 -> 5"@en .
ex:CP14_MissionLecture a backlog:ObjectiveCheckpoint ; backlog:checkpointDate "2026-11-28T00:00:00Z"^^xsd:dateTime ; backlog:expectedValue "5"^^xsd:decimal .
