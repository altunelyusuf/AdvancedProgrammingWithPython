    backlog:fillsScope ex:Scope14 ;
    backlog:hasMetric ex:Metric_Obj14_MissionLecture ; backlog:hasSuccessMetric ex:Metric_Obj14_MissionLecture ;
    backlog:hasMeasurementKind backlog:Meas_Derived ; backlog:hasMeasurementQuery "Count of chapters for which the objectives of goals G14_DeckReads, G14_PageRuns and G14_Released are all at target, derived from the observations in the register." ;
    backlog:hasBaselineValue "0"^^xsd:decimal ; backlog:hasTargetValue "5"^^xsd:decimal ; backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasCheckpoint ex:CP14_MissionLecture ;
    backlog:hasForecastDate "2026-11-28"^^xsd:date ; backlog:hasForecastRationale "A forecast, not a deadline. backlog_date_plan could not predict it: this register has no box with effort yet. The date is read from the delivered pace of Lineage13: five chapters from its mission commit (2026-11-26 about 17:00 Istanbul) to closure the same evening, about three hours, the chapters having decks already; chapters 21 to 25 start from first-version decks and need a spec and a chapter-code manifest each, taken as twice the work, about six hours from 2026-11-26 20:30, times the default buffer of 1.5, then the next midnight UTC. To be discussed with the Owner before it is final." ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ; backlog:decidedBy backlog:Owner .
