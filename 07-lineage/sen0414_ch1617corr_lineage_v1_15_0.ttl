<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.15.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.15.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment "1.15.0 (2026-11-19): Chapter 10 spec Done: the generic builder 2.6.0 runs it. The lineage stays open."@en .

ex:TK_ST10_Spec_10_Build backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Spec folder 08-tooling/ch10-deck/spec_v3_0_0: examples (two lambdas became a def; modes and quizfiles re-cut so each code box parses), visuals, content (parts, plan, stories as prose), spec.py; output paths deck 3.0.0 and manifest 1.1.0." .
ex:TK_ST10_Spec_10_Verify backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Builder 2.6.0 ran the spec: 41 slides, 18 code examples, manifest self-check pass (every example re-run in a fresh interpreter and in one interpreter). The old build's old file stays untouched." .
ex:ST10_Spec_10 backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Spec written and run by the generic builder; see its tasks." .
ex:TK_ST10_Deck_10_Build backlog:hasState backlog:Ready .
ex:Obs2_Obj10_SpecRuns a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_SpecRuns ; backlog:observedValue 2 ; backlog:observedAt "2026-11-19T21:00:00Z"^^xsd:dateTime ; rdfs:comment "Chapter 11 and chapter 10 specs run by the generic builder 2.6.0; chapter 17 is not yet written." .
