ex:ClosureReport13 a backlog:ClosureReport ;
    rdfs:label "Closure report: SEN0414 chapters 16 to 20 corrections"@en ;
    backlog:belongsToLineage ex:Lineage13 ;
    backlog:closesForMission ex:Mission13 ;
    backlog:closureCommittedAt "01e7548" ;
    backlog:hasClosureSummary "Partial achievement: 25 of 26 objectives at target on 2026-11-26. Decks of chapters 16 to 20: two result balloons on 117 of 117 code slides, analogy slides 0, think-of phrases 0, deck-standard, fit, reader-note, story-prose and material findings 0. Pages: 5 of 5 pass the full page test (100/207, 95/208, 95/207, 90/208, 91/208 widgets/features, 0 failed), 5 page A-boxes conform, run-in-order item on 5 of 5, lambda 0, analogy words 0, older drafts 0 (baseline 38). Release records 5, review verdicts 60, spec runs 5 (target 3), four formerly unmeasured items measured. Guards: exam, lab, other-chapter, outside and existing-rdodi files changed 0 (274 files, 0 modified). NOT at target: content changed beyond a ruling is 5 by the letter (recorded-paragraph wordings of chapters 16, 17, 19; chapter 18 also carries three corrected descriptions of linked pages). NOT achieved here: comparison of chapter code with the lab libraries (not in this repository, recorded for the lab lineage). Limits: reviews made by the building agent, materials not opened by the Owner, LibreOffice rendering only, Python 3.13.18, test key, links only partly re-read, lineage scripts owed to BRSF. Chapters 21 to 25, then the early chapters, are queued lineages. Full account in 07-lineage/CLOSURE_REPORT_sen0414_ch1620corr_lineage_Lineage13_v1_0_0.md."@en ;
    backlog:reportGeneratedAt "2026-11-26T19:45:00+00:00"^^xsd:dateTime ;
    backlog:reportsOnObjective ex:Obj13_Balloons,
        ex:Obj13_CodeParses,
        ex:Obj13_ContentChanged,
        ex:Obj13_DeckAnalogies,
        ex:Obj13_DeckStandard,
        ex:Obj13_ExamFiles,
        ex:Obj13_FitOverlaps,
        ex:Obj13_LabFiles,
        ex:Obj13_MaterialConditions,
        ex:Obj13_MissionLecture,
        ex:Obj13_OtherChapterFiles,
        ex:Obj13_OutsideFiles,
        ex:Obj13_OwnVersions,
        ex:Obj13_PageAbox,
        ex:Obj13_PageAnalogies,
        ex:Obj13_PageLambda,
        ex:Obj13_PagesPassing,
        ex:Obj13_PhraseHits,
        ex:Obj13_RdodiFiles,
        ex:Obj13_ReaderNotes,
        ex:Obj13_ReleaseRecords,
        ex:Obj13_ReviewVerdicts,
        ex:Obj13_RunInOrder,
        ex:Obj13_SpecRuns,
        ex:Obj13_StoryProse,
        ex:Obj13_Unmeasured .

