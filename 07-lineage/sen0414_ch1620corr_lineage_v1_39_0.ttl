ex:Commit13 a backlog:Commitment ;
    rdfs:label "This register commits to chapters 16 to 20 that meet the rulings"@en ;
    backlog:belongsToLineage ex:Lineage13 ;
    backlog:commitsToDefinitionOfDone ex:DoD13 ;
    backlog:commitsToGoal ex:G13_Mission ;
    backlog:commitsToObjective ex:Obj13_MissionLecture .

ex:DoD13_ContentUnchanged a backlog:DoDCriterion ;
    rdfs:label "Content, stories and examples stay as approved"@en ;
    backlog:hasCheckQuery "Compare, per chapter, the story ids and the number of examples in the new spec with the earlier deck and the stories file; list every difference." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "Every difference is one a ruling forces and is named in the story's record." ;
    rdfs:comment "The comparison is written in the Spec stories and its result then replaces this status." .

ex:DoD13_DeckChecks a backlog:DoDCriterion ;
    rdfs:label "Every new deck passes the automatic deck conditions"@en ;
    backlog:hasCheckQuery "Run 08-tooling/lineage12-opening/deckchecks_runner.sh NN DECK MANIFEST LOGDIR for each chapter." ;
    backlog:hasCriterionStatus backlog:Violated ;
    backlog:hasExpectedResult "Every check exits 0 on every chapter." ;
    rdfs:comment "On 2026-11-26 the reader-note check finds 188 findings on chapters 18 to 20 and the fit check refuses chapter 18 slide 43 and chapter 19 slide 16 (logs in 08-tooling/lineage13-opening/)." .

ex:DoD13_MatchingCode a backlog:DoDCriterion ;
    rdfs:label "Chapter code, page and lab libraries carry matching code"@en ;
    backlog:hasCheckQuery "Compare the manifest examples, the page frames and the lab library functions of chapters 16 to 20." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "Every example matches or its difference is recorded for the lab lineage." ;
    rdfs:comment "Not measured yet; the measurement story records it." .

ex:DoD13_MaterialCheck a backlog:DoDCriterion ;
    rdfs:label "Every new deck and page pass the material check"@en ;
    backlog:hasCheckQuery "Run 08-tooling/cme_material_check_v1_0_2.py DECK PAGE for each chapter." ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "No failing condition on any chapter." ;
    rdfs:comment "8 of 8 conditions pass on each of the five chapters on 2026-11-26; it is re-run on every new deck and page." .

ex:DoD13_OutsideFiles a backlog:DoDCriterion ;
    rdfs:label "No file outside chapters 16 to 20 and the lineage's own folders changes"@en ;
    backlog:hasCheckQuery "git diff --name-only from the objective-stage commit, filtered against the allowed folders." ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "No file outside the allowed folders." ;
    rdfs:comment "Only 07-lineage and 08-tooling/lineage13-opening changed so far." .

ex:DoD13_OwnVersion a backlog:DoDCriterion ;
    rdfs:label "Every changed file has its own new version"@en ;
    backlog:hasCheckQuery "Run python3 08-tooling/cme_version_check_v1_0_0.py . on the repository root." ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "Exit 0." ;
    rdfs:comment "Exit 0 on 2026-11-26 before this register file; it is re-run in each stage." .

ex:DoD13_PageTest a backlog:DoDCriterion ;
    rdfs:label "Every new page passes the full page test"@en ;
    backlog:hasCheckQuery "Run 08-tooling/sen0414_page_test_run_v1_1_0.py N VERSION for each chapter." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "The full test passes on every page." ;
    rdfs:comment "No new page exists yet; the test takes about 15 to 20 minutes per page." .

ex:DoD13_ReviewRecord a backlog:DoDCriterion ;
    rdfs:label "Each reviewed condition has a verdict from all three roles"@en ;
    backlog:hasCheckQuery "Count the verdicts recorded per chapter against 12 conditions (4 conditions times 3 roles)." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "Every chapter has all its verdicts." ;
    rdfs:comment "No verdict is recorded yet." .

ex:DoD13_RunOrderShape a backlog:DoDCriterion ;
    rdfs:label "Every chapter page has the run-in-order menu item"@en ;
    backlog:hasCheckQuery "Run the page-shapes check with sen0414_page_shapes_v1_0_0.ttl on the built page A-box of each chapter." ;
    backlog:hasCriterionStatus backlog:Violated ;
    backlog:hasExpectedResult "PageRunInOrderMenuShape passes on all five pages." ;
    rdfs:comment "None of the five pages has the item and the A-box of chapters 16 and 18 does not conform; chapters 17, 19 and 20 have no A-box file." .

ex:DoD13_StoryRepeat a backlog:DoDCriterion ;
    rdfs:label "No story of a chapter repeats in another chapter without the Owner"@en ;
    backlog:hasCheckQuery "Run 08-tooling/sen0414_story_repeat_check_v1_0_0.py 1 25 and read every hit for chapters 16 to 20." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "RESULT CLEAN for chapters 16 to 20 against every other chapter, or every hit recorded as a different story or sent to the Owner." ;
    rdfs:comment "Not measured for these chapters yet; the measurement story records it." .

ex:ProfileDecl13 a backlog:ProfileDeclaration ;
    rdfs:label "Profile: AAL (agentic adaptive), default"@en ;
    backlog:declaredAt "2026-11-26T00:00:00+00:00"^^xsd:dateTime ;
    backlog:declaresLevel backlog:Level_L2 ;
    backlog:declaresProfile backlog:Profile_AAL ;
    backlog:hasDeclarationRationale "Same declaration as Lineage3 to Lineage12: work is executed by an LLM agent, no human team; AAL is the default profile for agent-executed work and opens a lineage that names none (Lineage Operating Discipline v163.0.7, ceremony step 1). Level L2 stated plainly." ;
    backlog:hasIntentOrigin backlog:IOrigin_Default ;
    backlog:reviewDate "2026-12-03"^^xsd:date .

ex:DE13_Deck a backlog:DomainEntity ;
    rdfs:label "Deck - a chapter's lecture slides with notes and balloons"@en ;
    backlog:belongsToLineage ex:Lineage13 .

ex:DE13_Page a backlog:DomainEntity ;
    rdfs:label "Page - a chapter's interactive page that runs the slide code"@en ;
    backlog:belongsToLineage ex:Lineage13 .

ex:DE13_Review a backlog:DomainEntity ;
    rdfs:label "Review - a recorded verdict of one of the three roles on one condition"@en ;
    backlog:belongsToLineage ex:Lineage13 .

ex:DE13_Spec a backlog:DomainEntity ;
    rdfs:label "Spec - a chapter's description that the generic deck builder runs"@en ;
    backlog:belongsToLineage ex:Lineage13 .

ex:Excl13_Content a backlog:ScopeExclusion ;
    rdfs:label "Changes to what chapters 16 to 20 teach, their stories and their examples' meaning"@en ;
    backlog:belongsToLineage ex:Lineage13 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Any change to what chapters 16 to 20 teach, to their stories, or to the meaning of an example, except a change a ruling forces (a prompt, a lambda, a frame that does not parse, an analogy)." ;
    backlog:hasExclusionRationale "The content was approved by the owner earlier; only its form is corrected. A story repeated across chapters is reported, not changed, without the owner." ;
    backlog:hasScopeLayer backlog:Layer_Work .

ex:Excl13_ExamWork a backlog:ScopeExclusion ;
    rdfs:label "Exam and mock-exam work"@en ;
    backlog:belongsToLineage ex:Lineage13 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Any exam, mock-exam or exam-page work." ;
    backlog:hasExclusionRationale "Held outside this repository." ;
    backlog:hasScopeLayer backlog:Layer_Work .

ex:Excl13_LabMaterials a backlog:ScopeExclusion ;
    rdfs:label "Lab libraries, lab sessions and the lab-materials package"@en ;
    backlog:belongsToLineage ex:Lineage13 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Any lab library, lab session, lab handout or lab-materials package, including its code matching." ;
    backlog:hasExclusionRationale "The lab-materials package is queued as its own lineage and is discussed with the owner before any work (owner note of 2026-11-20)." ;
    backlog:hasScopeLayer backlog:Layer_Work .

ex:Excl13_OtherChapters a backlog:ScopeExclusion ;
    rdfs:label "Chapters 1-15 and 21-25"@en ;
    backlog:belongsToLineage ex:Lineage13 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Any work on chapters 1 to 15 and 21 to 25: their decks, pages, specs and records." ;
    backlog:hasExclusionRationale "One narrow lineage per slice; chapters 10 to 15 are corrected and closed; chapters 1 to 9 are the covered chapters the owner returns to after this lineage; chapters 21 to 25 have a page and no deck and are taken only with the owner." ;
    backlog:hasScopeLayer backlog:Layer_Work .

ex:Excl13_Rdodi a backlog:ScopeExclusion ;
    rdfs:label "Modification or deletion of existing research-artifact files of these chapters"@en ;
    backlog:belongsToLineage ex:Lineage13 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Any modification or deletion of an existing file under 03-materials/ch16 to ch20/rdodi/ (the research-artifact sets). A new own-version file there is allowed only where a ruling forces it and is then named in the register." ;
    backlog:hasExclusionRationale "Read by the concept-coverage check, not changed, as in Lineage6 to Lineage12." ;
    backlog:hasScopeLayer backlog:Layer_Work .

