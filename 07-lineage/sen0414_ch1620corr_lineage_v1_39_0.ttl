    backlog:hasForecastDate "2026-11-28"^^xsd:date ;
    backlog:hasForecastRationale "A forecast, not a deadline. backlog_date_plan 1.5.0 could not predict it: this register has no box with effort yet and Lineage12's archive has no pair of consecutive boxes with effort (the tool refused). The date is read from the delivered pace of Lineage12: four chapters from the mission commit (2026-11-26 08:39 Istanbul) to closure the same day, about eight hours; five chapters, two of them needing less work, about eight hours from 2026-11-26 17:00, times the tool's default buffer of 1.5, then the next midnight UTC. To be discussed with the Owner before it is final." ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasMeasurementQuery "Count of reports/REPORT_Lineage13_chNN_release_and_review files (NN 16 to 20) that exist with every check log named in them (today 0)." ;
