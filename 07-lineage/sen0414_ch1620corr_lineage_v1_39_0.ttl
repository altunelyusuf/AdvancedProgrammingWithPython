ex:Obj13_ContentChanged a backlog:Objective ;
    rdfs:label "Content changes that no ruling forces: 0 held"@en ;
    backlog:belongsToLineage ex:Lineage13 ;
    backlog:contributesToGoal ex:G13_Guard_Content ;
    backlog:decidedBy backlog:Owner ;
    backlog:fillsScope ex:Scope13 ;
    backlog:hasBaselineValue 0.0 ;
    backlog:hasCheckpoint ex:CP13_ContentChanged ;
    backlog:hasForecastDate "2026-11-28"^^xsd:date ;
    backlog:hasForecastRationale "A forecast, not a deadline. backlog_date_plan 1.5.0 could not predict it: this register has no box with effort yet and Lineage12's archive has no pair of consecutive boxes with effort (the tool refused). The date is read from the delivered pace of Lineage12: four chapters from the mission commit (2026-11-26 08:39 Istanbul) to closure the same day, about eight hours; five chapters, two of them needing less work, about eight hours from 2026-11-26 17:00, times the tool's default buffer of 1.5, then the next midnight UTC. To be discussed with the Owner before it is final." ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:hasMeasurementKind backlog:Meas_Judged ;
    backlog:hasMeasurementQuery "Count of changes the faculty reviewer and the owner find, reading each re-cut deck against the earlier deck of its chapter, that no ruling forces." ;
    backlog:hasMetric ex:Metric_Obj13_ContentChanged ;
    backlog:hasSuccessMetric ex:Metric_Obj13_ContentChanged ;
    backlog:hasTargetDirection backlog:Dir_Hold ;
    backlog:hasTargetValue 0.0 ;
    backlog:metricMovableBy ex:ST13_Guards ;
    backlog:objectiveForGoal ex:G13_Guard_Content ;
    rdfs:comment "Correction note 2026-11-26 (appended; the target stays as written): the count is 5 by the letter. The five changes are wordings of recorded paragraphs that show the real run under the recording interpreter instead of a missing-module or earlier-interpreter message; no concept, example or story changed. Chapter 18 also carries three corrected wrong descriptions of linked pages, made after the link check and not counted in the release record. The intent (no content change beyond what a ruling or a fact forces) is met only with this reading, so the objective is reported as not at target."@en .

