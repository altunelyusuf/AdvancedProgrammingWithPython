    backlog:observationFor ex:Obj13_Balloons ;
    backlog:observedAt "2026-11-26T14:00:00+00:00"^^xsd:dateTime ;
    backlog:observedDuringCeremony true ;
    backlog:observesMetric ex:Metric_Obj13_Balloons .

