<http://example.org/sen0414-ch1011simp-lineage> a owl:Ontology ;
    rdfs:label "Urgent narrow lineage: SEN0414 chapters 10 and 11, one code, one environment"@en ;
    owl:versionInfo "1.6.0" ; owl:versionIRI <http://example.org/sen0414-ch1011simp-lineage/1.6.0> ; dcterms:identifier "sen0414_ch1011simp_lineage" ;
    rdfs:comment """1.6.0 (2026-11-20): First story starts: the single-source step. The Owner said proceed at 19:17 Istanbul. The next task by the backlog order is TK11_Make_Build (first of the chain, no dependency)."""@en .

ex:ST11_Make backlog:hasState backlog:InProgress .
ex:TK11_Make_Build backlog:hasState backlog:InProgress ;
    backlog:hasTransitionNote "Starts 2026-11-20 after the Owner's go at 19:17 Istanbul. Chapter 11 already has a spec for the generic deck builder (08-tooling/ch11-deck/spec_v3_0_0); the new step makes the manifest, the slide code and the Slide code tab from one source and feeds that spec." .
