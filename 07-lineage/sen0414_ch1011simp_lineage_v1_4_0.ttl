@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1011simp-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1011simp-lineage> a owl:Ontology ;
    rdfs:label "Urgent narrow lineage: SEN0414 chapters 10 and 11, one code, one environment"@en ;
    owl:versionInfo "1.4.0" ; owl:versionIRI <http://example.org/sen0414-ch1011simp-lineage/1.4.0> ; dcterms:identifier "sen0414_ch1011simp_lineage" ;
    rdfs:comment """1.4.0 (2026-11-20): Objective stage only. Each objective measures one goal; baselines were measured from the live files on 2026-11-20, not from memory. CORRECTION of a figure in the 1.2.0 impact assessment: it said slide and page examples differ on 5 of 37, and that code is split on all 37 code slides; the measures are 7 of 37 and 35 of 37. The earlier record is not edited (L-112); the correction is noted on it below."""@en .

ex:IA11_Reuse rdfs:comment "Correction recorded in 1.4.0: the impact statement gives 5 of 37 slide and page examples that differ and splits on all 37; the measured figures are 7 of 37 and 35 of 37 (chapter 10: slides 10 and 28; chapter 11: slides 7, 14, 22, 27, 28). The impact on scope is unchanged."@en .

ex:Obj11_TracedExamples a backlog:Objective ; rdfs:label "Code examples traced to a block of the book's own code: 0 -> 37"@en ;
    backlog:objectiveForGoal ex:G11_BookCode ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasMetric ex:Metric_Obj11_TracedExamples ; backlog:hasForecastDate "2026-11-21"^^xsd:date .
ex:Metric_Obj11_TracedExamples a backlog:Metric ; rdfs:label "Code examples traced to a block of the book's own code: 0 -> 37"@en ; backlog:metricUnit "example" ; backlog:metricBaseline 0 ; backlog:metricTarget 37 .
ex:Obs0_Obj11_TracedExamples a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj11_TracedExamples ; backlog:observedValue 0 ; backlog:observedAt "2026-11-20T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: no trace of any chapter 10 or 11 example to a book code block is recorded. Measured 2026-11-20: 30 of 376 deck code lines equal a book line (ch10 11 of 156, ch11 19 of 220). The target 37 is the 18 + 19 code slides of today's decks; it is restated if the example list changes."@en .
ex:Obj11_SlidePageDiffs a backlog:Objective ; rdfs:label "Slide codes that differ from their page example: 7 -> 0"@en ;
    backlog:objectiveForGoal ex:G11_OneSource ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasMetric ex:Metric_Obj11_SlidePageDiffs ; backlog:hasForecastDate "2026-11-21"^^xsd:date .
ex:Metric_Obj11_SlidePageDiffs a backlog:Metric ; rdfs:label "Slide codes that differ from their page example: 7 -> 0"@en ; backlog:metricUnit "example" ; backlog:metricBaseline 7 ; backlog:metricTarget 0 .
ex:Obs0_Obj11_SlidePageDiffs a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj11_SlidePageDiffs ; backlog:observedValue 7 ; backlog:observedAt "2026-11-20T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: measured 2026-11-20 by comparing each code slide's code, in order, with the chapter-code manifest example of the same slide: chapter 10 differs on 2 of 18 (slides 10 and 28), chapter 11 on 5 of 19 (slides 7, 14, 22, 27, 28); 7 of 37."@en .
ex:Obj11_SplitCodeSlides a backlog:Objective ; rdfs:label "Code slides whose code is split over more than one box: 35 -> 0"@en ;
    backlog:objectiveForGoal ex:G11_DeckReadable ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasMetric ex:Metric_Obj11_SplitCodeSlides ; backlog:hasForecastDate "2026-11-21"^^xsd:date .
ex:Metric_Obj11_SplitCodeSlides a backlog:Metric ; rdfs:label "Code slides whose code is split over more than one box: 35 -> 0"@en ; backlog:metricUnit "slide" ; backlog:metricBaseline 35 ; backlog:metricTarget 0 .
ex:Obs0_Obj11_SplitCodeSlides a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj11_SplitCodeSlides ; backlog:observedValue 35 ; backlog:observedAt "2026-11-20T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: measured 2026-11-20 on decks v3.0.0, counting boxes in Courier New in the left column: chapter 10 has 17 of its 18 code slides with 2 to 4 code boxes, chapter 11 has 18 of 19; 35 of 37 code slides. Correction: earlier statements that every code slide is split (18 of 18 and 19 of 19) were an overcount by two slides."@en .
ex:Obj11_PageExamplesRun a backlog:Objective ; rdfs:label "Examples made from the single source that run on the page with the shown result: 0 -> 37"@en ;
    backlog:objectiveForGoal ex:G11_PageRuns ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasMetric ex:Metric_Obj11_PageExamplesRun ; backlog:hasForecastDate "2026-11-21"^^xsd:date .
ex:Metric_Obj11_PageExamplesRun a backlog:Metric ; rdfs:label "Examples made from the single source that run on the page with the shown result: 0 -> 37"@en ; backlog:metricUnit "example" ; backlog:metricBaseline 0 ; backlog:metricTarget 37 .
ex:Obs0_Obj11_PageExamplesRun a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj11_PageExamplesRun ; backlog:observedValue 0 ; backlog:observedAt "2026-11-20T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: no example exists yet on the single source, so none runs there. Not estimated."@en .
ex:Obj11_ReviewVerdicts a backlog:Objective ; rdfs:label "Recorded review verdicts of the three roles: 0 -> 24"@en ;
    backlog:objectiveForGoal ex:G11_ReleaseChecked ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasMetric ex:Metric_Obj11_ReviewVerdicts ; backlog:hasForecastDate "2026-11-21"^^xsd:date .
ex:Metric_Obj11_ReviewVerdicts a backlog:Metric ; rdfs:label "Recorded review verdicts of the three roles: 0 -> 24"@en ; backlog:metricUnit "verdict" ; backlog:metricBaseline 0 ; backlog:metricTarget 24 .
ex:Obs0_Obj11_ReviewVerdicts a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj11_ReviewVerdicts ; backlog:observedValue 0 ; backlog:observedAt "2026-11-20T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: no review record of chapters 10 and 11 under the corrected rulings (four reviewed conditions times three roles times two chapters = 24)."@en .
ex:Obj11_NeutralTools a backlog:Objective ; rdfs:label "Reusable tools shown working on both chapters with no chapter-specific text: 0 -> 3"@en ;
    backlog:objectiveForGoal ex:G11_Reusable ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasMetric ex:Metric_Obj11_NeutralTools ; backlog:hasForecastDate "2026-11-21"^^xsd:date .
ex:Metric_Obj11_NeutralTools a backlog:Metric ; rdfs:label "Reusable tools shown working on both chapters with no chapter-specific text: 0 -> 3"@en ; backlog:metricUnit "tool" ; backlog:metricBaseline 0 ; backlog:metricTarget 3 .
ex:Obs0_Obj11_NeutralTools a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj11_NeutralTools ; backlog:observedValue 0 ; backlog:observedAt "2026-11-20T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: none exists. The three are the generic check, the single-source step and the method guide."@en .
