@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1011simp-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1011simp-lineage> a owl:Ontology ;
    rdfs:label "Urgent narrow lineage: SEN0414 chapters 10 and 11, one code, one environment"@en ;
    owl:versionInfo "1.3.0" ; owl:versionIRI <http://example.org/sen0414-ch1011simp-lineage/1.3.0> ; dcterms:identifier "sen0414_ch1011simp_lineage" ;
    rdfs:comment """1.3.0 (2026-11-20): Goal stage only. One goal per scope area (code, source, deck, page, release, reuse), each stated as the benefit the work implements for chapters 10 and 11 and the method others can adopt. Benefits that appear later (time saved in a session) are tracked, not goals."""@en .

ex:G11_BookCode a backlog:Goal ; rdfs:label "Every example is the book's own code for the subject taught"@en ;
    backlog:goalForMission ex:Mission11 ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasGoalStatement "Each code example of chapters 10 and 11 is taken from the book's own code for that subject, short and plain, with no prompts and no additions beyond the subject, so the student meets the code the book teaches." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G11_OneSource a backlog:Goal ; rdfs:label "Slide, page and Slide code tab cannot differ"@en ;
    backlog:goalForMission ex:Mission11 ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasGoalStatement "Each example is held once per chapter, and the slide code, the page example and the Slide code tab are made from it, so what the teacher shows is what the student copies and runs." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G11_DeckReadable a backlog:Goal ; rdfs:label "Each code on a slide is whole, readable and copyable in one step"@en ;
    backlog:goalForMission ex:Mission11 ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasGoalStatement "Every code on the chapter 10 and 11 slides sits in one box, in order, without explanation boxes inside it, with its real result shown beside it and the standing deck rulings kept." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G11_PageRuns a backlog:Goal ; rdfs:label "The page shows, explains and runs every code as the slides progress"@en ;
    backlog:goalForMission ex:Mission11 ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasGoalStatement "On each chapter page every example of its deck is present in slide order with its explanation and runs with the shown result, so a session is given without another tool." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G11_ReleaseChecked a backlog:Goal ; rdfs:label "Chapters are released only on passed checks and recorded reviews"@en ;
    backlog:goalForMission ex:Mission11 ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasGoalStatement "Every automatic condition passes on each new deck and page, and each reviewed condition on teachability, understandability, explainability and human communication has a recorded verdict before the new versions are called released." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G11_Reusable a backlog:Goal ; rdfs:label "Other chapters and courses can adopt the method"@en ;
    backlog:goalForMission ex:Mission11 ; backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasGoalStatement "The check, the single-source step and the method guide carry no chapter-specific text and are proven on chapters 10 and 11, so another chapter or course adopts them by supplying its own source." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G11_BookCode backlog:goalCoversArea ex:Area11_Code .
ex:G11_OneSource backlog:goalCoversArea ex:Area11_Source .
ex:G11_DeckReadable backlog:goalCoversArea ex:Area11_Deck .
ex:G11_PageRuns backlog:goalCoversArea ex:Area11_Page .
ex:G11_ReleaseChecked backlog:goalCoversArea ex:Area11_Release .
ex:G11_Reusable backlog:goalCoversArea ex:Area11_Reuse .
