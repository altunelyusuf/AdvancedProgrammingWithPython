@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch19ch20-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch19ch20-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 19 and 20"@en ;
    owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/sen0414-ch19ch20-lineage/1.1.0> ; dcterms:identifier "sen0414_ch19ch20_lineage" ;
    rdfs:comment "1.1.0 (2026-11-12): Scope stage only. Areas are taken from the chapter ontologies' own section labels, read from GitHub for this stage (automate_python_3e_ch19_v1_0_0.ttl: The time Module, The datetime Module, Launching Other Programs from Python, Practice Programs; automate_python_3e_ch20_v1_0_0.ttl: The Gmail API, SMS Email Gateways, Push Notifications, Practice Programs). The state check of the Mission stage found that neither chapter received the iteration-20 retrofit, so the structural rebuild is inside this scope."@en .

ex:Scope8 a backlog:ScopeStatement ;
    rdfs:label "Draft, check and (on approval) build chapters 19-20 to the current deck and page standards"@en ;
    backlog:scopeForMission ex:Mission8 ; backlog:belongsToLineage ex:Lineage8 ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:scopeCompletionState backlog:Proposed ;
    backlog:coversArea ex:Area8_StateCheck, ex:Area8_Draft, ex:Area8_StoryUniqueness, ex:Area8_Render ;
    backlog:hasScopeExclusion ex:Excl8_Ch1to18, ex:Excl8_OtherChapters, ex:Excl8_ExamWork, ex:Excl8_RenderBeforeApproval, ex:Excl8_CoveredChapterCorrections, ex:Excl8_Rdodi ;
    backlog:hasScopeDeliverable ex:Del8_ApprovedDraft, ex:Del8_CheckedMaterials, ex:Del8_StoryUniquenessRecord, ex:Del8_BuiltMaterials ;
    backlog:hasScopeStatementText "IN: for chapters 19 (The time Module; The datetime Module; Launching Other Programs from Python; Practice Programs: time, datetime, zoneinfo, subprocess, scheduling) and 20 (The Gmail API; SMS Email Gateways; Push Notifications; Practice Programs: EZGmail, Gmail API, smtplib, imaplib, SMS gateways, ntfy) of the 3rd edition only - (a) read the existing decks, pages, story-companion scripts and say plainly what is stale, missing or duplicated against the deck and page standards and the 2026-11-09 and 2026-11-11 story principles; (b) write one plain-text draft per chapter for the owner's approval; (c) check every story of the two chapters against the chapters already presented; (d) only after approval, build deck, page and manifest from that draft to the standards that chapters 9 to 18 meet. OUT: see the exclusions." .

ex:Area8_StateCheck a backlog:ScopeArea ; rdfs:label "What exists for chapters 19-20 today"@en ; backlog:belongsToLineage ex:Lineage8 .
ex:Area8_Draft a backlog:ScopeArea ; rdfs:label "The one approved draft per chapter"@en ; backlog:belongsToLineage ex:Lineage8 .
ex:Area8_StoryUniqueness a backlog:ScopeArea ; rdfs:label "Chapter 19-20 stories checked against the chapters already presented"@en ; backlog:belongsToLineage ex:Lineage8 .
ex:Area8_Render a backlog:ScopeArea ; rdfs:label "Deck, page and chapter-code manifest built from the approved draft"@en ; backlog:belongsToLineage ex:Lineage8 .

ex:Del8_ApprovedDraft a backlog:ScopeDeliverable ; rdfs:label "Owner-approved plain-text draft, chapters 19 and 20"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:deliverableForArea ex:Area8_Draft .
ex:Del8_CheckedMaterials a backlog:ScopeDeliverable ; rdfs:label "Chapter-19/20 materials checked against the current standards, gaps named"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:deliverableForArea ex:Area8_StateCheck .
ex:Del8_StoryUniquenessRecord a backlog:ScopeDeliverable ; rdfs:label "Record of every chapter 19-20 story against the presented chapters, each repeat replaced or confirmed by the owner"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:deliverableForArea ex:Area8_StoryUniqueness .
ex:Del8_BuiltMaterials a backlog:ScopeDeliverable ; rdfs:label "Deck, page and chapter-code manifest of each chapter, built from its approved draft and checked"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:deliverableForArea ex:Area8_Render .

ex:Excl8_Ch1to18 a backlog:ScopeExclusion ; rdfs:label "Chapters 1-18"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasExclusionRationale "Chapters 1-8 are midterm scope; chapters 9-18 belong to Lineage3 to Lineage7, none widened here." .
ex:Excl8_OtherChapters a backlog:ScopeExclusion ; rdfs:label "Chapters 21-25"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasExclusionRationale "Later chapter pairs get their own narrow lineages." .
ex:Excl8_ExamWork a backlog:ScopeExclusion ; rdfs:label "Exam and mock-exam work"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasExclusionRationale "Held outside this repository." .
ex:Excl8_RenderBeforeApproval a backlog:ScopeExclusion ; rdfs:label "Building before the draft is approved"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasExclusionRationale "Same draft-first rule as Lineage3 to Lineage7." .
ex:Excl8_CoveredChapterCorrections a backlog:ScopeExclusion ; rdfs:label "Corrections to chapters already presented (1-18)"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasExclusionRationale "Owner ruling 2026-11-11: presented chapters are not updated until the whole book is finished; time to correct them is reserved only after the book. Repeats found in them stay recorded in the register of Lineage7 and are not changed here." .
ex:Excl8_Rdodi a backlog:ScopeExclusion ; rdfs:label "The rdodi/ research-artifact set for chapters 19-20"@en ; backlog:belongsToLineage ex:Lineage8 ; backlog:hasExclusionRationale "A separate artifact family from the deck+page+story+code+resources material this lineage builds; left untouched, as in Lineage6 and Lineage7. The deck standard's concept-coverage check reads the research set of each chapter; it is read, not changed." .
