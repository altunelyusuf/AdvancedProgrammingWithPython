@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch17ch18-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch17ch18-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 17 and 18"@en ;
    owl:versionInfo "1.10.0" ; owl:versionIRI <http://example.org/sen0414-ch17ch18-lineage/1.10.0> ; dcterms:identifier "sen0414_ch17ch18_lineage" ;
    rdfs:comment "1.10.0 (2026-11-11): Change request, Backlog stage only. One story for the new goal, with its tasks. The approval gate waits for it."@en .

ex:Backlog7 backlog:hasBacklogMember ex:ST7_StoryUniqueness .

ex:ST7_StoryUniqueness a backlog:Story ;
    rdfs:label "Chapter 17-18 stories checked against chapters 1-16; repeats replaced"@en ;
    backlog:belongsToLineage ex:Lineage7 ;
    backlog:decomposesInto ex:TK7_Uniq_Compare, ex:TK7_Uniq_ReplaceCh17, ex:TK7_Uniq_ReplaceCh18, ex:TK7_Uniq_Review ;
    backlog:hasState backlog:InProgress ;
    rdfs:comment "Acceptance: each of the 12 stories of chapters 17 and 18 is compared with every story of chapters 1-16 by people, event, date and source link; every repeat is replaced by a different story (real names, 5N1K, a live link, a free-source picture named) or is a repeat the owner confirmed; the revised drafts carry the result. Value: the owner's rule of 2026-11-11 that a story told once is not told again without his confirmation. Estimate: four tasks, one revision of each draft."@en .

ex:TK7_Uniq_Compare a backlog:Task ; rdfs:label "Compare the 12 stories of chapters 17-18 with chapters 1-16"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Done ;
    backlog:hasAuditNote "From the live story scripts of chapters 1-18 (latest version of each): shared source link finds chapter 10 and 18 on https://en.wikipedia.org/wiki/JSON; a name and event search finds the chapter 18 JSON story also in chapter 7 (Crockford and Morningstar, April 2001), the chapter 17 Office Open XML story (Microsoft, Ecma TC45, ECMA-376 December 2006) also in chapter 14 (OoxmlStandard2006). Chapter 9 (Fredrik Lundh, regular expressions) and chapter 18 story 5 (ElementTree) are different events. Lower bound only." .
ex:TK7_Uniq_ReplaceCh17 a backlog:Task ; rdfs:label "Replace chapter 17 story 3 (Office Open XML) with a different story in a new draft version"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Ready .
ex:TK7_Uniq_ReplaceCh18 a backlog:Task ; rdfs:label "Replace chapter 18 story 3 (JSON, Crockford) with a different story in a new draft version"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Ready .
ex:TK7_Uniq_Review a backlog:Task ; rdfs:label "Re-compare the revised drafts with chapters 1-16 and record the count"@en ; backlog:belongsToLineage ex:Lineage7 ; backlog:hasState backlog:Blocked ;
    rdfs:comment "After both replacements."@en .

ex:ST7_ApprovalGate backlog:hasState backlog:Blocked ;
    rdfs:comment "Blocked again on ST7_StoryUniqueness: the drafts the owner approves must carry the replaced stories."@en .
