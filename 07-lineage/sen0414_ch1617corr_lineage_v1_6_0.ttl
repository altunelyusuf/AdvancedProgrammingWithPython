@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.6.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.6.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment "1.6.0 (2026-11-18): Chapter 11 spec and deck stories Done: spec folder 08-tooling/ch11-deck/spec_v3_0_0, generic builder 2.5.0, deck 3.0.0 with manifest 1.1.0. Chapters 17 and 16 not started."@en .

ex:TK10_Spec_11_Build backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Spec folder 08-tooling/ch11-deck/spec_v3_0_0 (spec, examples, visuals, content, notes), written from the old chapter 11 builder and content files read from disk; the 19 examples of the old deck kept, with code re-cut where a box did not parse on its own. Generic builder 08-tooling/chapter_deck_build_v2_5_0.py (new file over 2.4.0: adds the left layout, a visual in the right column) was written for this chapter and also serves chapters 17 and 16." .
ex:TK10_Spec_11_Verify backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Builder 2.5.0 run on the spec: 41 slides, 19 examples. Old manifest 1.0.0 against new 1.1.0 (08-tooling/ch11-deck/logs_v3_0_0/examples_compare_old_new.log): expected results identical 19 of 19. Builder warnings on two slides (walk 1.38 against 1.40, zipmodes 1.18 against 1.20 line room); the overlap check is clean. Run by the builder that wrote the spec, so not an independent run." .
ex:TK10_Deck_11_Build backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Deck 03-materials/ch11/SEN0414_Ch11_OrganizingFiles_3e_v3_0_0.pptx and manifest 03-materials/ch11/page/chapter_code_ch11_v1_1_0.json. 41 notes written for the rulings (84 to 108 words; each points at something, says what the result shows, leads into the next slide); titles of at least 4 words; no prompt marker; no lambda; every text box 30 words or fewer; stories told as short paragraphs from the existing story files." .
ex:TK10_Deck_11_Verify backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Logs in 08-tooling/ch11-deck/logs_v3_0_0: material check 1.0.2 on the deck all deck conditions pass; deck standard 1.1.0 13 of 13; manifest self-check pass (19 of 19 examples re-run in fresh and shared interpreters); overlap clean; story prose clean; story repeat clean. The page conditions are read at the page stage." .
ex:ST10_Spec_11 backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Spec built and run; see its tasks." .
ex:ST10_Deck_11 backlog:hasState backlog:Done ;
    backlog:hasAuditNote "Deck 3.0.0 and manifest 1.1.0 built and checked; see its tasks." .

ex:Obs1_Obj10_SpecRuns a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_SpecRuns ; backlog:observedValue 1 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Chapter 11 spec runs in the generic builder 2.5.0 (1 of 3)."@en .
ex:Obs1_Obj10_DeckStandard a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_DeckStandard ; backlog:observedValue 4 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Deck standard 1.1.0 on chapter 11 deck 3.0.0: 13 of 13 pass, so 6 - 2 = 4 failing conditions remain (chapters 17 and 16)."@en .
