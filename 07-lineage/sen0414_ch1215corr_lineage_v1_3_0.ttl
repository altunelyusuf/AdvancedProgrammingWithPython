@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1215corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1215corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 12 to 15 corrections"@en ;
    owl:versionInfo "1.3.0" ; owl:versionIRI <http://example.org/sen0414-ch1215corr-lineage/1.3.0> ;
    owl:priorVersion <http://example.org/sen0414-ch1215corr-lineage/1.2.0> ; dcterms:identifier "sen0414_ch1215corr_lineage" ;
    rdfs:comment """1.3.0 (2026-11-26): Goal stage only (one stage per version). Derived from Scope12, not from a list of gaps (Lineage Operating Discipline v163.0.7, 3d): one mission-facing goal; scope-facing goals that between them cover all eight areas; one containment-facing goal; one exclusion-facing goal for each of the five exclusions. Each goal states the benefit of what the work implements; the conditions of the record are measured by the objectives of the next stage. The Owner's reading of the re-cut notes and balloons is a quality of this development, named in the mission-facing goal, not a condition recorded elsewhere."""@en .

ex:G12_Mission a backlog:Goal ;
    rdfs:label "Chapters 12 to 15 can be lectured from and learned from"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "A lecturer can teach each of chapters 12 to 15 from its deck and page in one four-hour time-box, and a student who receives the slides with their notes can learn the chapter from them without a presenter, with what the chapters teach unchanged." .

ex:G12_Build a backlog:Goal ;
    rdfs:label "Each chapter is described once, in a spec the generic builder runs"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area12_Conversion ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "Chapters 12 to 15 each have their examples, result visuals, words and plan in one spec that the generic chapter deck builder runs, so a later correction changes the spec and the deck is built again, not patched." .

ex:G12_DeckReads a backlog:Goal ;
    rdfs:label "The decks teach in plain words and serve the reader without a presenter"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area12_Deck , ex:Area12_Reader , ex:Area12_NoAnalogies ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "The chapter 12 to 15 decks teach one thing per slide, state each concept plainly without an everyday analogy, show plain parsing code without prompts or lambda, and carry notes and balloons that explain, add detail and connect, so the reader of the distributed slides learns from them." .

ex:G12_PageRuns a backlog:Goal ;
    rdfs:label "The pages run the code the slides show"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area12_Page , ex:Area12_PageCode ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "A student who copies a code example from a chapter 12 to 15 slide, from its page or from its chapter-code manifest gets the same code, and the page runs it with the result the slide shows." .

ex:G12_Released a backlog:Goal ;
    rdfs:label "The chapters are released only on passed checks and recorded reviews"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area12_Release , ex:Area12_OwnVersion ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "Each new deck and page of chapters 12 to 15 is called released only after every automatic condition passes and the academician, the faculty reviewer and the undergraduate reader have each recorded a verdict, and every changed file tells its own version story." .

ex:G12_Contained a backlog:Goal ;
    rdfs:label "No effort goes outside the eight areas"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Containment ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "Every file this lineage changes lies inside the folders of chapters 12 to 15 and their tooling and records, so no work is spent on what the scope did not name." .

ex:G12_Guard_Content a backlog:Goal ;
    rdfs:label "What the four chapters teach and tell stays as approved"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Exclusion ; backlog:guardsExclusion ex:Excl12_Content ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No topic, story or example meaning of chapters 12 to 15 changes beyond what a ruling forces, and every story overlap found is reported to the owner and not changed." .
ex:G12_Guard_ExamWork a backlog:Goal ;
    rdfs:label "No exam work is done here"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Exclusion ; backlog:guardsExclusion ex:Excl12_ExamWork ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No exam or mock-exam file is changed by this lineage." .
ex:G12_Guard_OtherChapters a backlog:Goal ;
    rdfs:label "The other chapters stay untouched"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Exclusion ; backlog:guardsExclusion ex:Excl12_OtherChapters ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No file of chapters 1 to 11 or 16 to 25 is changed by this lineage." .
ex:G12_Guard_LabMaterials a backlog:Goal ;
    rdfs:label "The lab materials wait for their own lineage"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Exclusion ; backlog:guardsExclusion ex:Excl12_LabMaterials ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No lab library, lab session or lab handout is written or changed by this lineage." .
ex:G12_Guard_Rdodi a backlog:Goal ;
    rdfs:label "The research-artifact sets stay as they are"@en ;
    backlog:belongsToLineage ex:Lineage12 ; backlog:goalForMission ex:Mission12 ; backlog:contributesToMission ex:Mission12 ;
    backlog:derivesFromScope ex:Scope12 ; backlog:hasGoalFacing backlog:Facing_Exclusion ; backlog:guardsExclusion ex:Excl12_Rdodi ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No file under the rdodi folders of chapters 12 to 15 is changed by this lineage." .
