ex:Excl13_Content a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage13 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Changes to what chapters 16 to 20 teach, their stories and their examples' meaning"@en ;
    backlog:excludesConcern "Any change to what chapters 16 to 20 teach, to their stories, or to the meaning of an example, except a change a ruling forces (a prompt, a lambda, a frame that does not parse, an analogy)." ;
    backlog:hasExclusionRationale "The content was approved by the owner earlier; only its form is corrected. A story repeated across chapters is reported, not changed, without the owner." ;
    backlog:hasScopeLayer backlog:Layer_Work .
ex:Excl13_ExamWork a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage13 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Exam and mock-exam work"@en ;
    backlog:excludesConcern "Any exam, mock-exam or exam-page work." ;
    backlog:hasExclusionRationale "Held outside this repository." ;
    backlog:hasScopeLayer backlog:Layer_Work .
ex:Excl13_OtherChapters a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage13 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Chapters 1-15 and 21-25"@en ;
    backlog:excludesConcern "Any work on chapters 1 to 15 and 21 to 25: their decks, pages, specs and records." ;
    backlog:hasExclusionRationale "One narrow lineage per slice; chapters 10 to 15 are corrected and closed; chapters 1 to 9 are the covered chapters the owner returns to after this lineage; chapters 21 to 25 have a page and no deck and are taken only with the owner." ;
    backlog:hasScopeLayer backlog:Layer_Work .
ex:Excl13_LabMaterials a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage13 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Lab libraries, lab sessions and the lab-materials package"@en ;
    backlog:excludesConcern "Any lab library, lab session, lab handout or lab-materials package, including its code matching." ;
    backlog:hasExclusionRationale "The lab-materials package is queued as its own lineage and is discussed with the owner before any work (owner note of 2026-11-20)." ;
    backlog:hasScopeLayer backlog:Layer_Work .
ex:Excl13_Rdodi a backlog:ScopeExclusion ; backlog:belongsToLineage ex:Lineage13 ; backlog:decidedBy backlog:Owner ;
    rdfs:label "Modification or deletion of existing research-artifact files of these chapters"@en ;
    backlog:excludesConcern "Any modification or deletion of an existing file under 03-materials/ch16 to ch20/rdodi/ (the research-artifact sets). A new own-version file there is allowed only where a ruling forces it and is then named in the register." ;
    backlog:hasExclusionRationale "Read by the concept-coverage check, not changed, as in Lineage6 to Lineage12." ;
    backlog:hasScopeLayer backlog:Layer_Work .

ex:Scope13 a backlog:ScopeStatement ; backlog:belongsToLineage ex:Lineage13 ;
    backlog:scopeForMission ex:Mission13 ;
    backlog:coversArea ex:Area13_Conversion , ex:Area13_Deck , ex:Area13_Reader , ex:Area13_NoAnalogies , ex:Area13_Page , ex:Area13_PageCode , ex:Area13_Release , ex:Area13_OwnVersion , ex:Area13_Unmeasured ;
    backlog:hasScopeDeliverable ex:Del13_Spec_18 , ex:Del13_Deck_18 , ex:Del13_Reader_18 , ex:Del13_Spec_19 , ex:Del13_Deck_19 , ex:Del13_Reader_19 , ex:Del13_Spec_20 , ex:Del13_Deck_20 , ex:Del13_Reader_20 , ex:Del13_NoAnalogies_16 , ex:Del13_Page_16 , ex:Del13_PageCode_16 , ex:Del13_ReleaseRecord_16 , ex:Del13_NoAnalogies_17 , ex:Del13_Page_17 , ex:Del13_PageCode_17 , ex:Del13_ReleaseRecord_17 , ex:Del13_NoAnalogies_18 , ex:Del13_Page_18 , ex:Del13_PageCode_18 , ex:Del13_ReleaseRecord_18 , ex:Del13_NoAnalogies_19 , ex:Del13_Page_19 , ex:Del13_PageCode_19 , ex:Del13_ReleaseRecord_19 , ex:Del13_NoAnalogies_20 , ex:Del13_Page_20 , ex:Del13_PageCode_20 , ex:Del13_ReleaseRecord_20 , ex:Del13_OwnVersion , ex:Del13_Measures ;
    backlog:requiresDeliverable ex:Del13_Spec_18 , ex:Del13_Deck_18 , ex:Del13_Reader_18 , ex:Del13_Spec_19 , ex:Del13_Deck_19 , ex:Del13_Reader_19 , ex:Del13_Spec_20 , ex:Del13_Deck_20 , ex:Del13_Reader_20 , ex:Del13_NoAnalogies_16 , ex:Del13_Page_16 , ex:Del13_PageCode_16 , ex:Del13_ReleaseRecord_16 , ex:Del13_NoAnalogies_17 , ex:Del13_Page_17 , ex:Del13_PageCode_17 , ex:Del13_ReleaseRecord_17 , ex:Del13_NoAnalogies_18 , ex:Del13_Page_18 , ex:Del13_PageCode_18 , ex:Del13_ReleaseRecord_18 , ex:Del13_NoAnalogies_19 , ex:Del13_Page_19 , ex:Del13_PageCode_19 , ex:Del13_ReleaseRecord_19 , ex:Del13_NoAnalogies_20 , ex:Del13_Page_20 , ex:Del13_PageCode_20 , ex:Del13_ReleaseRecord_20 , ex:Del13_OwnVersion , ex:Del13_Measures ;
    backlog:hasScopeExclusion ex:Excl13_Content , ex:Excl13_ExamWork , ex:Excl13_OtherChapters , ex:Excl13_LabMaterials , ex:Excl13_Rdodi ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ;
    backlog:scopeCompletionState backlog:Proposed ;
    backlog:hasScopeStatementText "IN: chapters 16 (SQLite Databases), 17 (PDF and Word Documents), 18 (CSV, JSON and XML), 19 (Time and Scheduling) and 20 (Email, Texts and Push Notifications) of the 3rd edition, in that order. (a) Conversion, chapters 18 to 20 only: examples, result visuals, words and plan move into a spec for the generic chapter deck builder, so each deck is rebuilt once; chapters 16 and 17 already have one. (b) Deck, chapters 18 to 20: titles of at least four words, one thing to look at per slide, plain code without prompts, no lambda unless taught, no text frames overlapping, chapter-code manifest equal to the deck's code in order, no slides added (fuller plain sentences go in speech balloons). (c) Reader, chapters 18 to 20: notes of 60 to 140 words written to the reader, no directions to a presenter, no think-of statement, each note linking to another slide, chapter or concept; one story balloon and two result balloons on every code slide. (d) No everyday analogies in the decks and pages of chapters 16 to 20; the plain meanings stay. (e) Page, chapters 16 to 20: a new page version built from the corrected deck and manifest by the lambda-free page pipeline with a page A-box, passing the full page test. (f) Page code: every page has a top menu item that runs the slide examples in order and conforms to the page shapes; code equal on slide, page and manifest. (g) Release: automatic checks and three recorded review verdicts per chapter before release. (h) Own version: every changed file gets its own version; older page drafts beside the newest page are removed from the tree (kept in git history) and the version check exits 0. (i) Measures: the four measures named open in the mission stage are read before any goal rests on them. FOLDERS THAT MAY CHANGE: 03-materials/ch16 to ch20 (except rdodi/), 08-tooling and 07-lineage. OUT: see the five exclusions." ;
    rdfs:label "Rebuild chapter 16 to 20 decks and pages to the owner's rulings"@en .

ex:Mission13 backlog:decidedBy backlog:Owner ; backlog:hasMissionOutcome backlog:Out_InFlight .
