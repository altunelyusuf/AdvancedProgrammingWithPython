@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1620corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1620corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 16 to 20 corrections"@en ;
    owl:versionInfo "1.4.0" ; owl:versionIRI <http://example.org/sen0414-ch1620corr-lineage/1.4.0> ;
    owl:priorVersion <http://example.org/sen0414-ch1620corr-lineage/1.3.0> ; dcterms:identifier "sen0414_ch1620corr_lineage" ;
    rdfs:comment """1.4.0 (2026-11-26): Backlog stage of Lineage13: the register root, the backlog, 22 stories with acceptance criteria and links to the objectives they move and the deliverables they satisfy, and the lineage's own Definition of Done. Tasks follow in the planning stage, where each is produced by a planning event. CORRECTION OF 1.3.0 (appended, never edited): the spec objective of 1.3.0 said that none of the five chapters has a spec folder and set the target at 5. Both were wrong: specs exist (chapter 16 spec_v4_0_0, chapter 17 spec_v4_0_0, chapter 18 spec_v3_0_0, chapter 19 spec, chapter 20 spec_v2_0_1) and the newest decks were built from them by the generic builder versions 2.9.0, 2.6.0, 2.4.0, 2.2.0 and 2.3.0. The baseline 0 stays true read as chapters whose newest deck is built by the current generic builder 2.10.0; the target is 3, the chapters 18 to 20 that are re-cut, because chapters 16 and 17 need no re-cut (mission: reduce rework). The wrong text stays visible in 1.3.0."""@en .

ex:Obj13_SpecRuns backlog:hasTargetValue "3"^^xsd:decimal ; rdfs:comment "Corrected in 1.4.0: target 3 (chapters 18 to 20 re-cut); the 1.3.0 target 5 and the sentence that no spec folder exists are withdrawn. Existing specs: chapter 16 spec_v4_0_0, chapter 17 spec_v4_0_0, chapter 18 spec_v3_0_0, chapter 19 spec, chapter 20 spec_v2_0_1; the measure counts chapters whose newest deck is built by generic builder 2.10.0."@en .
ex:Metric_Obj13_SpecRuns backlog:metricTarget "3"^^xsd:integer ; rdfs:label "Chapter specs that the generic builder 2.10.0 runs for the chapters 18 to 20 re-cut: 0 -> 3"@en .
ex:CP13_SpecRuns backlog:expectedValue "3"^^xsd:decimal .

ex:Register_Ch1620corr a backlog:Backlog ; backlog:isRegisterRoot true ; rdfs:label "Chapters 16 to 20 corrections register"@en .
ex:Backlog13 a backlog:Backlog ;
    backlog:memberOfContainer ex:Register_Ch1620corr ;
    backlog:backlogForMission ex:Mission13 ;
    backlog:belongsToLineage ex:Lineage13 ;
    rdfs:label "Chapters 16 to 20 corrections backlog"@en .
ex:DoD13 a backlog:DefinitionOfDone ;
    backlog:belongsToLineage ex:Lineage13 ;
    rdfs:comment "Written for this lineage. A story is Done only when each acceptance criterion has a check run in the current turn with its output saved in the repository, a verify task re-runs it from the files and not from the builder's report, and a check that cannot be run or a result that is not shown leaves the story open." ;
    rdfs:label "Definition of Done of the chapters 16 to 20 corrections lineage"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_ContentUnchanged .
ex:DoD13_ContentUnchanged a backlog:DoDCriterion ;
    backlog:hasCheckQuery "Compare, per chapter, the story ids and the number of examples in the new spec with the earlier deck and the stories file; list every difference." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "Every difference is one a ruling forces and is named in the story's record." ;
    rdfs:comment "The comparison is written in the Spec stories and its result then replaces this status." ;
    rdfs:label "Content, stories and examples stay as approved"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_DeckChecks .
ex:DoD13_DeckChecks a backlog:DoDCriterion ;
    backlog:hasCheckQuery "Run 08-tooling/lineage12-opening/deckchecks_runner.sh NN DECK MANIFEST LOGDIR for each chapter." ;
    backlog:hasCriterionStatus backlog:Violated ;
    backlog:hasExpectedResult "Every check exits 0 on every chapter." ;
    rdfs:comment "On 2026-11-26 the reader-note check finds 188 findings on chapters 18 to 20 and the fit check refuses chapter 18 slide 43 and chapter 19 slide 16 (logs in 08-tooling/lineage13-opening/)." ;
    rdfs:label "Every new deck passes the automatic deck conditions"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_MaterialCheck .
ex:DoD13_MaterialCheck a backlog:DoDCriterion ;
    backlog:hasCheckQuery "Run 08-tooling/cme_material_check_v1_0_2.py DECK PAGE for each chapter." ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "No failing condition on any chapter." ;
    rdfs:comment "8 of 8 conditions pass on each of the five chapters on 2026-11-26; it is re-run on every new deck and page." ;
    rdfs:label "Every new deck and page pass the material check"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_RunOrderShape .
ex:DoD13_RunOrderShape a backlog:DoDCriterion ;
    backlog:hasCheckQuery "Run the page-shapes check with sen0414_page_shapes_v1_0_0.ttl on the built page A-box of each chapter." ;
    backlog:hasCriterionStatus backlog:Violated ;
    backlog:hasExpectedResult "PageRunInOrderMenuShape passes on all five pages." ;
    rdfs:comment "None of the five pages has the item and the A-box of chapters 16 and 18 does not conform; chapters 17, 19 and 20 have no A-box file." ;
    rdfs:label "Every chapter page has the run-in-order menu item"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_PageTest .
ex:DoD13_PageTest a backlog:DoDCriterion ;
    backlog:hasCheckQuery "Run 08-tooling/sen0414_page_test_run_v1_1_0.py N VERSION for each chapter." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "The full test passes on every page." ;
    rdfs:comment "No new page exists yet; the test takes about 15 to 20 minutes per page." ;
    rdfs:label "Every new page passes the full page test"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_OwnVersion .
ex:DoD13_OwnVersion a backlog:DoDCriterion ;
    backlog:hasCheckQuery "Run python3 08-tooling/cme_version_check_v1_0_0.py . on the repository root." ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "Exit 0." ;
    rdfs:comment "Exit 0 on 2026-11-26 before this register file; it is re-run in each stage." ;
    rdfs:label "Every changed file has its own new version"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_OutsideFiles .
ex:DoD13_OutsideFiles a backlog:DoDCriterion ;
    backlog:hasCheckQuery "git diff --name-only from the objective-stage commit, filtered against the allowed folders." ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "No file outside the allowed folders." ;
    rdfs:comment "Only 07-lineage and 08-tooling/lineage13-opening changed so far." ;
    rdfs:label "No file outside chapters 16 to 20 and the lineage's own folders changes"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_StoryRepeat .
ex:DoD13_StoryRepeat a backlog:DoDCriterion ;
    backlog:hasCheckQuery "Run 08-tooling/sen0414_story_repeat_check_v1_0_0.py 1 25 and read every hit for chapters 16 to 20." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "RESULT CLEAN for chapters 16 to 20 against every other chapter, or every hit recorded as a different story or sent to the Owner." ;
    rdfs:comment "Not measured for these chapters yet; the measurement story records it." ;
    rdfs:label "No story of a chapter repeats in another chapter without the Owner"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_MatchingCode .
ex:DoD13_MatchingCode a backlog:DoDCriterion ;
    backlog:hasCheckQuery "Compare the manifest examples, the page frames and the lab library functions of chapters 16 to 20." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "Every example matches or its difference is recorded for the lab lineage." ;
    rdfs:comment "Not measured yet; the measurement story records it." ;
    rdfs:label "Chapter code, page and lab libraries carry matching code"@en .
ex:DoD13 backlog:hasDoDCriterion ex:DoD13_ReviewRecord .
ex:DoD13_ReviewRecord a backlog:DoDCriterion ;
    backlog:hasCheckQuery "Count the verdicts recorded per chapter against 12 conditions (4 conditions times 3 roles)." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "Every chapter has all its verdicts." ;
    rdfs:comment "No verdict is recorded yet." ;
    rdfs:label "Each reviewed condition has a verdict from all three roles"@en .
ex:Executor_ClaudeCodeSession a backlog:Executor_SingleAgent ; rdfs:label "The Claude session that carries out the work"@en .
ex:Register_Ch1620corr backlog:hasIdentifier "Register_SEN0414_Ch1620corr" ; backlog:belongsToLineage ex:Lineage13 ; backlog:hasCommitment ex:Commit13 .
ex:Backlog13 backlog:hasIdentifier "Backlog_SEN0414_Ch1620corr" ; backlog:hasCommitment ex:Commit13 .
ex:Commit13 a backlog:Commitment ; rdfs:label "This register commits to chapters 16 to 20 that meet the rulings"@en ;
    backlog:commitsToGoal ex:G13_Mission ; backlog:commitsToObjective ex:Obj13_MissionLecture ; backlog:commitsToDefinitionOfDone ex:DoD13 .
ex:Mission13 backlog:missionFor ex:Register_Ch1620corr .
ex:Register_Ch1620corr backlog:appliesDefinitionOfDone ex:DoD13 .
ex:Backlog13 backlog:appliesDefinitionOfDone ex:DoD13 .
ex:Blueprint13 a backlog:Blueprint ; rdfs:label "What the chapters 16 to 20 corrections are about"@en ;
    backlog:belongsToLineage ex:Lineage13 ; backlog:blueprintFor ex:Backlog13 ;
    backlog:hasDomainEntity ex:DE13_Deck , ex:DE13_Page , ex:DE13_Spec , ex:DE13_Review .
ex:Blueprint13Root a backlog:Blueprint ; rdfs:label "What the chapters 16 to 20 corrections are about (register root)"@en ;
    backlog:belongsToLineage ex:Lineage13 ; backlog:blueprintFor ex:Register_Ch1620corr ;
    backlog:hasDomainEntity ex:DE13_Deck , ex:DE13_Page , ex:DE13_Spec , ex:DE13_Review .
ex:DE13_Deck a backlog:DomainEntity ; rdfs:label "Deck - a chapter's lecture slides with notes and balloons"@en ; backlog:belongsToLineage ex:Lineage13 .
ex:DE13_Page a backlog:DomainEntity ; rdfs:label "Page - a chapter's interactive page that runs the slide code"@en ; backlog:belongsToLineage ex:Lineage13 .
ex:DE13_Spec a backlog:DomainEntity ; rdfs:label "Spec - a chapter's description that the generic deck builder runs"@en ; backlog:belongsToLineage ex:Lineage13 .
ex:DE13_Review a backlog:DomainEntity ; rdfs:label "Review - a recorded verdict of one of the three roles on one condition"@en ; backlog:belongsToLineage ex:Lineage13 .
ex:Session13_Backlog a backlog:RegisterSession ; rdfs:label "The session that wrote the backlog stage"@en ;
    backlog:sessionFor ex:Backlog13 , ex:Register_Ch1620corr ; backlog:sessionConductedBy "claude-session" ;
    backlog:sessionStartedAt "2026-11-26T14:10:00"^^xsd:dateTime ; backlog:sessionEndedAt "2026-11-26T15:00:00"^^xsd:dateTime ;
    backlog:stateVerifiedAtStart true ;
    backlog:hasSessionScopeNote "Set out to write the Backlog stage only (stories, acceptance criteria, Definition of Done, links to objectives and deliverables, and the correction of the spec objective). Left alone: tasks and planning events (planning stage), packages and sprints, and every file outside 07-lineage and 08-tooling/lineage13-opening. Verified first: the objective stage 1.3.0 check passed and the working tree was clean at eb2d646." .

