@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch17ch18-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch17ch18-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 17 and 18"@en ;
    owl:versionInfo "1.15.0" ; owl:versionIRI <http://example.org/sen0414-ch17ch18-lineage/1.15.0> ; dcterms:identifier "sen0414_ch17ch18_lineage" ;
    rdfs:comment "1.15.0 (2026-11-11): Change request on the owner decision to replace chapter 18 story 5: new draft v1_0_2 written, waiting for approval; the chapter 18 render is reopened by change management."@en .

ex:ST7_ReplaceCh18Story5 a backlog:BacklogItem ; backlog:belongsToLineage ex:Lineage7 ;
    rdfs:label "Replace chapter 18 story 5 (ElementTree and simplejson) with a story that does not share its source with chapter 16"@en ;
    backlog:hasState backlog:Ready ;
    backlog:hasAuditNote "Owner decision 2026-11-11: replace. Draft 03-materials/ch18/DRAFT_ch18_v1_0_2.md written (ElementTree origin story from the module history header, the Python commit mails of December 2005 and a core developer article). Waiting for the owner approval of the draft; then the deck, page and stories script are rebuilt from it." .

ex:ST7_RenderCh18 backlog:hasState backlog:Ready ;
    backlog:hasAuditNote "Reopened by change management on 2026-11-11 because story 5 is replaced; the render of commit 2825a56 (deck v2_0_2) stays in the repository as the earlier result." .
