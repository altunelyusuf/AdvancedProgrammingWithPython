    backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasExclusionRationale "One narrow lineage per slice; Lineage10 is paused by the urgency and the lab package is queued." .

ex:Excl11_Content a backlog:ScopeExclusion ;
