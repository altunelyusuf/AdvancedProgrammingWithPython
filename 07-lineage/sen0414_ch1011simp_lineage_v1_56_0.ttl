    backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasExclusionRationale "They adopt the method in their own narrow lineages; here it is only proven on chapters 10 and 11." .

ex:Excl11_SlideCount a backlog:ScopeExclusion ;
    rdfs:label "Adding slides"@en ;
    backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasExclusionRationale "Each section must fit one 4-hour time-box; fuller text uses balloons on existing slides." .

