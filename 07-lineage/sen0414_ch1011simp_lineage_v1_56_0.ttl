ex:DoD11_ContentUnchanged a backlog:DoDCriterion ;
    rdfs:label "Content, stories and the meaning of the notes stay as approved"@en ;
    backlog:hasCheckQuery "The Owner reads the changed slides and notes against the approved ones." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "The Owner confirms nothing went beyond the scope." ;
    rdfs:comment "No tool can run this; it needs the Owner's reading. Named and never dropped." .

ex:DoD11_OwnVersion a backlog:DoDCriterion ;
    rdfs:label "Every changed file has its own new version"@en ;
    backlog:hasCheckQuery "Run 08-tooling/cme_version_check_v1_0_0.py on the repository root." ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "Exit 0." ;
    rdfs:comment "Run on 2026-11-20 before this version: exit 0." .

ex:DoD11_ToolRun a backlog:DoDCriterion ;
    rdfs:label "A tool of this lineage gives identical output twice, runs its own output and refuses a broken input"@en ;
    backlog:hasCheckQuery "Run the tool twice on the same source and diff the outputs; run the made tab; run it on broken copies of the source." ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "Outputs identical; the tab exits 0; every broken copy is refused." ;
    rdfs:comment "Run on 2026-11-20 also for the generic code check: 08-tooling/code-source/logs_v1_0_0/check_toy_run.log and make_1_1_0_toy_run.log.",
        "Run on 2026-11-20 for the single-source step: 08-tooling/code-source/logs_v1_0_0/make_toy_run.log." .

ex:DoD11_TracedCode a backlog:DoDCriterion ;
    rdfs:label "Every chapter example is traced to a book code block, or the story names why not"@en ;
    backlog:hasCheckQuery "Compare each source example's book reference and code with the book file, and list every difference with its reason." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable ;
    backlog:hasExpectedResult "Every example has a trace or a named reason." ;
    rdfs:comment "Applies to the chapter code stories, not yet run; it becomes running there.",
        "Run on 2026-11-24 for chapter 11: 10 traced, 9 with a named reason, none without either. Chapter 10 still to run; the status stays NotYetEnforceable (one value only) until it has run for both chapters, then it is set once." .

ex:Excl11_Chapters a backlog:ScopeExclusion ;
