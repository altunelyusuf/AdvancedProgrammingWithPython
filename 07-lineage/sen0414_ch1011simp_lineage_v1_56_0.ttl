    backlog:belongsToLineage ex:Lineage11 ;
    backlog:hasExclusionRationale "Only the code, its presentation and its match with the page change. Story repeats are reported to the owner, not changed." .

ex:Excl11_OtherChapterConversion a backlog:ScopeExclusion ;
