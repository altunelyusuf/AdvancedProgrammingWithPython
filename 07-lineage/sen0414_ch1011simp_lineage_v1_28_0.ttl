@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1011simp-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1011simp-lineage> a owl:Ontology ;
    rdfs:label "Urgent narrow lineage: SEN0414 chapters 10 and 11, one code, one environment"@en ;
    owl:versionInfo "1.28.0" ; owl:versionIRI <http://example.org/sen0414-ch1011simp-lineage/1.28.0> ; dcterms:identifier "sen0414_ch1011simp_lineage" ;
    rdfs:comment """1.28.0 (2026-11-24): The two new deliverables of scope change SC11_ConceptPanels are groomed into one story each, with an acceptance criterion and two tasks (build, verify)."""@en .

ex:AC11_Concepts_10 a backlog:AcceptanceCriterion ; rdfs:label "Every Try it run and every entry of the chapter examples pane of the chapter 10 page is a line or program of the book (or of the chapter source that holds it) with its hidden set-up, runs in the browser, and the page test passes; a book line that cannot run alone carries a named reason."@en ; backlog:belongsToLineage ex:Lineage11 .
ex:ST11_Concepts_10 a backlog:Story ; rdfs:label "Chapter 10 page: concept panels and chapter examples run the book's code"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD11 ; backlog:hasAcceptanceCriterion ex:AC11_Concepts_10 ;
    backlog:decomposesInto ex:TK11_Concepts_10_Build, ex:TK11_Concepts_10_Verify .
ex:TK11_Concepts_10_Build a backlog:ExecutionTask ; rdfs:label "Write the new A-box version with the book's lines as Try it inputs and the pane examples from the manifest; rebuild page data and page"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Ready .
ex:TK11_Concepts_10_Verify a backlog:ExecutionTask ; rdfs:label "Compare every Try it input with the book file, run the code check and the full page test, read the logs"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK11_Concepts_10_Build .
ex:AC11_Concepts_11 a backlog:AcceptanceCriterion ; rdfs:label "Every Try it run and every entry of the chapter examples pane of the chapter 11 page is a line or program of the book (or of the chapter source that holds it) with its hidden set-up, runs in the browser, and the page test passes; a book line that cannot run alone carries a named reason."@en ; backlog:belongsToLineage ex:Lineage11 .
ex:ST11_Concepts_11 a backlog:Story ; rdfs:label "Chapter 11 page: concept panels and chapter examples run the book's code"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD11 ; backlog:hasAcceptanceCriterion ex:AC11_Concepts_11 ;
    backlog:decomposesInto ex:TK11_Concepts_11_Build, ex:TK11_Concepts_11_Verify .
ex:TK11_Concepts_11_Build a backlog:ExecutionTask ; rdfs:label "Write the new A-box version with the book's lines as Try it inputs and the pane examples from the manifest; rebuild page data and page"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Ready .
ex:TK11_Concepts_11_Verify a backlog:ExecutionTask ; rdfs:label "Compare every Try it input with the book file, run the code check and the full page test, read the logs"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK11_Concepts_11_Build .
