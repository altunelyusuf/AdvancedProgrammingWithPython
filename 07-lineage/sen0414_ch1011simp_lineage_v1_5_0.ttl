ex:TK11_Release_11_Build a backlog:ExecutionTask ; rdfs:label "Write the review record, labelled agent-made and not independent"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
