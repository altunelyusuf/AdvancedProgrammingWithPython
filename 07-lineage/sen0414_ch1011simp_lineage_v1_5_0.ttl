ex:TK11_Release_11_Verify a backlog:ExecutionTask ; rdfs:label "Re-run every automatic check from the files and compare with the record"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
