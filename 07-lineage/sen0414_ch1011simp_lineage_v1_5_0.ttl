ex:TK11_Deck_11_Build a backlog:ExecutionTask ; rdfs:label "Build the deck from the source; move explanations beside or below the code"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK11_Code_11_Verify .
ex:TK11_Deck_11_Verify a backlog:ExecutionTask ; rdfs:label "Run the deck standard, the material check and the code check on the deck from the files"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK11_Deck_11_Build .
ex:ST11_Page_11 a backlog:Story ; rdfs:label "Rebuild the chapter 11 page: every example present, in slide order, running"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasState backlog:Ready ;
    backlog:appliesDefinitionOfDone ex:DoD11 ; backlog:hasAcceptanceCriterion ex:AC11_Page_11 ;
    backlog:decomposesInto ex:TK11_Page_11_Build, ex:TK11_Page_11_Verify .
ex:TK11_Page_11_Build a backlog:ExecutionTask ; rdfs:label "Rebuild page data and page from the source"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Build ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK11_Deck_11_Verify .
ex:TK11_Page_11_Verify a backlog:ExecutionTask ; rdfs:label "Run the code check and the full page test; read the logs"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasTaskType backlog:TaskType_Verify ; backlog:hasState backlog:Blocked ;
    backlog:dependsOn ex:TK11_Page_11_Build .
ex:ST11_Release_11 a backlog:Story ; rdfs:label "Record the checks and the three-role review of chapter 11"@en ; backlog:belongsToLineage ex:Lineage11 ; backlog:hasState backlog:Ready ;
