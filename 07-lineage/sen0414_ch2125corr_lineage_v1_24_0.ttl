ex:Obs0_Obj14_Balloons a backlog:MetricObservation ;
    rdfs:label "Baseline of 2026-11-26: Code examples whose slide lacks two result balloons on the five decks"@en ;
    backlog:hasObservationMethod "Count of examples (11, 8, 7, 8, 8 = 42, read from the examples_out_v1_0_0.json file of each first-version deck, which holds three keys that are not examples) whose code slide does not carry two result balloons, read from the shape names of the deck (today 42: no deck has them). The count is read again against each chapter's chapter-code manifest once it exists, and a correction note is appended if the manifest holds another number." ;
    backlog:hasObservedValue 42.0 ;
    backlog:observationFor ex:Obj14_Balloons ;
    backlog:observedAt "2026-11-26T14:00:00+00:00"^^xsd:dateTime ;
    backlog:observedDuringCeremony true ;
    backlog:observesMetric ex:Metric_Obj14_Balloons .

