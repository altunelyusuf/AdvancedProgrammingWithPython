@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1617corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.2.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.2.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment "1.2.0 (2026-11-18): Scope stage only. Areas follow the six rulings of 2026-11-14 (handover v1.1.0) as they touch chapters 11, 17 and 16: how each is rebuilt, its deck, its page, and the checks and reviews that release it. Chapter 11 is first (owner, urgent)."@en .

ex:Scope10 a backlog:ScopeStatement ;
    rdfs:label "Rebuild chapter 11, 17 and 16 decks and pages to the six rulings of 2026-11-14"@en ;
    backlog:scopeForMission ex:Mission10 ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasIntentOrigin backlog:IOrigin_OwnerStated ; backlog:scopeCompletionState backlog:Proposed ;
    backlog:coversArea ex:Area10_Conversion, ex:Area10_Deck, ex:Area10_Page, ex:Area10_Release ;
    backlog:hasScopeExclusion ex:Excl10_Content, ex:Excl10_OtherChapters, ex:Excl10_Rdodi, ex:Excl10_ExamWork ;
    backlog:hasScopeDeliverable ex:Del10_Spec_11, ex:Del10_Deck_11, ex:Del10_Page_11, ex:Del10_ReleaseRecord_11, ex:Del10_Spec_17, ex:Del10_Deck_17, ex:Del10_Page_17, ex:Del10_ReleaseRecord_17, ex:Del10_Spec_16, ex:Del10_Deck_16, ex:Del10_Page_16, ex:Del10_ReleaseRecord_16 ;
    backlog:hasScopeStatementText "IN: chapters 11 (Organizing Files), 17 (PDF and Word Documents) and 16 (SQLite Databases) of the 3rd edition, in that order, chapter 11 first as urgent. (a) Conversion: each chapter's examples, result visuals, words and plan move into a spec for the generic chapter deck builder 2.4.0, so each deck is rebuilt once. (b) Deck: titles of at least four words, one thing to look at per slide, notes of 60 to 140 words (at least 30 on title, part and resources slides) that say what to point at and lead to the next slide, plain parsing code without prompts, no lambda unless taught, chapter-code manifest equal to the deck's code in order. (c) Page: a Slide code tab equal to the deck code in the same order, code without lambda, the full page test passing. (d) Release: every automatic condition passes and every reviewed condition has a recorded verdict from the academician, the faculty reviewer and the undergraduate reader. Latest CME and SEN0414 enhancements and the corrections recorded in the chapter 18 and 19-20 lineages are applied from the physical files." .
ex:Area10_Conversion a backlog:ScopeArea ; rdfs:label "Specs for the generic deck builder (chapters 11, 17, 16)"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:Area10_Deck a backlog:ScopeArea ; rdfs:label "Decks on the rulings (chapters 11, 17, 16)"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:Area10_Page a backlog:ScopeArea ; rdfs:label "Pages on the rulings (chapters 11, 17, 16)"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:Area10_Release a backlog:ScopeArea ; rdfs:label "Automatic checks and recorded reviews before release (chapters 11, 17, 16)"@en ; backlog:belongsToLineage ex:Lineage10 .
ex:Del10_Spec_11 a backlog:ScopeDeliverable ; rdfs:label "Spec folder of chapter 11 for the generic builder"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Conversion .
ex:Del10_Deck_11 a backlog:ScopeDeliverable ; rdfs:label "Chapter 11 deck and chapter-code manifest, new versions"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Deck .
ex:Del10_Page_11 a backlog:ScopeDeliverable ; rdfs:label "Chapter 11 page, new version, with its page test result"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Page .
ex:Del10_ReleaseRecord_11 a backlog:ScopeDeliverable ; rdfs:label "Check logs and the three-role review record of chapter 11"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Release .
ex:Del10_Spec_17 a backlog:ScopeDeliverable ; rdfs:label "Spec folder of chapter 17 for the generic builder"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Conversion .
ex:Del10_Deck_17 a backlog:ScopeDeliverable ; rdfs:label "Chapter 17 deck and chapter-code manifest, new versions"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Deck .
ex:Del10_Page_17 a backlog:ScopeDeliverable ; rdfs:label "Chapter 17 page, new version, with its page test result"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Page .
ex:Del10_ReleaseRecord_17 a backlog:ScopeDeliverable ; rdfs:label "Check logs and the three-role review record of chapter 17"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Release .
ex:Del10_Spec_16 a backlog:ScopeDeliverable ; rdfs:label "Spec folder of chapter 16 for the generic builder"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Conversion .
ex:Del10_Deck_16 a backlog:ScopeDeliverable ; rdfs:label "Chapter 16 deck and chapter-code manifest, new versions"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Deck .
ex:Del10_Page_16 a backlog:ScopeDeliverable ; rdfs:label "Chapter 16 page, new version, with its page test result"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Page .
ex:Del10_ReleaseRecord_16 a backlog:ScopeDeliverable ; rdfs:label "Check logs and the three-role review record of chapter 16"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:deliverableForArea ex:Area10_Release .
ex:Excl10_Content a backlog:ScopeExclusion ; rdfs:label "Changes to what chapters 11, 17 and 16 teach, their stories and their examples' meaning"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasExclusionRationale "The content was approved by the owner earlier; only its form is corrected. An example is changed only where a ruling forces it (a prompt, a lambda, a frame that does not parse). A story repeated across chapters is reported, not changed, without the owner." .
ex:Excl10_OtherChapters a backlog:ScopeExclusion ; rdfs:label "Chapters 1-10, 12-15, 18-25"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasExclusionRationale "One narrow lineage per slice; chapters 18-20 are closed; chapters 9-15 and 1-8 follow in later lineages reusing the conversion; chapters 21-22 only with the owner." .
ex:Excl10_Rdodi a backlog:ScopeExclusion ; rdfs:label "The rdodi/ research-artifact sets of these chapters"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasExclusionRationale "Read by the concept-coverage check, not changed, as in Lineage6 to Lineage9." .
ex:Excl10_ExamWork a backlog:ScopeExclusion ; rdfs:label "Exam and mock-exam work"@en ; backlog:belongsToLineage ex:Lineage10 ; backlog:hasExclusionRationale "Held outside this repository." .
