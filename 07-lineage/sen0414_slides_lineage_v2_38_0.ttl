ex:Ev_Review a backlog:TestEvidence ; rdfs:label "Checks for Deck 1.0.1 and page 9.8.0 from the owner's review of chapter 5"@en ; backlog:belongsToLineage ex:Lineage ;
    backlog:attestsCriterion ex:AC_Chapter ; backlog:evidenceVerified true ; backlog:hasTestId "Review/Ch05" ;
    backlog:hasTestSpec "Deck 1.0.1: 08-tooling/ch05-deck/build_v1_0_1.sh rebuilt the deck with a new step, ooxml_fix_v1_0_0.py, that removes the 64 paragraph-properties elements pptxgenjs had written after a run (the fault PowerPoint repaired on opening), and a new check, structure_check_v1_0_0.py, that refuses any paragraph in an order PowerPoint repairs; it found 42 such paragraphs in deck 1.0.0 and 0 in 1.0.1. The other checks passed unchanged: 8 expressions, 18 program runs and 103 visual values re-checked under Python 3.14.4 with 0 mismatches; the speaker notes are identical. The element order inside runs, shape properties, lines and paragraph properties was also checked: no other fault. PowerPoint itself could not be run here, so that the file opens without repair is inferred from the schema order, not observed. Page 9.8.0: 08-tooling/sen0414_page_test_v9_8_0.py passed all its checks in headless Chromium (54 of 54 widgets, every check of 9.7.0 plus the new ones): choosing an example in the Playground, the Code Lab, Step through or the Code pipeline fills the code at once (no Load button); Step through traces on the first Step (no Trace button) and again when the code changes, for each of its 10 examples; the Code pipeline offers 5 or more examples and each runs through all five stages. A fixture with one stored result altered was refused by three checks. Acceptance @ Courseware: as page 9.7.0; the attestation is pending, not claimed." ; backlog:hasVerificationMethod "Checks run over the artefacts as published in sen0414-v2.32.0." ;
    backlog:verifiedByTool "08-tooling/ch05-deck/structure_check_v1_0_0.py, deck_check_v1_0_1.py, program_check_v1_0_0.py and visual_check_v1_1_0.py under Python 3.14.4; 08-tooling/sen0414_page_test_v9_8_0.py in headless Chromium" ; backlog:verifiedAt "2026-09-29T08:52:52"^^xsd:dateTime .
ex:Harness_Review a backlog:TestHarness ; rdfs:label "Checks for Deck 1.0.1 and page 9.8.0 from the owner's review of chapter 5"@en ;
    backlog:harnessFor ex:ST_Review_Ch05 ; backlog:harnessComplete true ; backlog:hasHarnessEvidence ex:Ev_Review .
ex:Complete_Review a backlog:TransitionEvent ; rdfs:label "Deck 1.0.1 and page 9.8.0 from the owner's review of chapter 5 completed"@en ;
    backlog:transitionedItem ex:ST_Review_Ch05 ; backlog:viaTransition backlog:T_Complete ;
