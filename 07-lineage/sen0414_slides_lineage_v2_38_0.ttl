    backlog:harnessFor ex:ST_Enrich_Ch05 ; backlog:harnessComplete true ; backlog:hasHarnessEvidence ex:Ev_Enrich .
ex:Complete_Enrich a backlog:TransitionEvent ; rdfs:label "Clickable references, a page-wide search and grounded replies on the pages of chapters 1 to 6 completed"@en ;
    backlog:transitionedItem ex:ST_Enrich_Ch05 ; backlog:viaTransition backlog:T_Complete ;
