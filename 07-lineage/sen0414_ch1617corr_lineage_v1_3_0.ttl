@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1617corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.3.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.3.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment "1.3.0 (2026-11-18): Goal stage only. One goal per scope area (conversion, deck, page, release), each stated as the benefit the work implements for the three chapters."@en .

ex:G10_SpecBuilt a backlog:Goal ; rdfs:label "Each chapter is described once, in a spec the generic builder runs"@en ;
    backlog:goalForMission ex:Mission10 ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasGoalStatement "Chapters 11, 17 and 16 each have their examples, result visuals, words and plan in one spec that the generic chapter deck builder runs, so a deck is built, not patched." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G10_DeckOnRulings a backlog:Goal ; rdfs:label "Chapter decks meet the rulings"@en ;
    backlog:goalForMission ex:Mission10 ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasGoalStatement "The chapter 11, 17 and 16 decks teach one thing per slide, with notes that carry the lecture, plain parsing code without prompts and no lambda, and each chapter-code manifest equals its deck code in order." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G10_PageOnRulings a backlog:Goal ; rdfs:label "Chapter pages meet the rulings"@en ;
    backlog:goalForMission ex:Mission10 ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasGoalStatement "The chapter 11, 17 and 16 pages each have a Slide code tab that runs the deck code unchanged and in order, code without lambda, and pass the full page test." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G10_ReleaseChecked a backlog:Goal ; rdfs:label "Chapters are released only on passed checks and recorded reviews"@en ;
    backlog:goalForMission ex:Mission10 ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasGoalStatement "Every automatic condition passes on each new deck and page and each reviewed condition has a recorded verdict from each of the three roles before the new versions are called released." ;
    backlog:goalCompletionState backlog:Proposed .
