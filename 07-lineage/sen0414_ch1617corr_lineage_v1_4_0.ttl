<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.4.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.4.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment "1.4.0 (2026-11-18): Objective stage only. Each objective measures one goal; baselines were measured from the live files on 2026-11-18, not from memory."@en .

ex:Obj10_SpecRuns a backlog:Objective ; rdfs:label "Chapter specs that the generic builder runs: 0 -> 3"@en ;
    backlog:objectiveForGoal ex:G10_SpecBuilt ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasMetric ex:Metric_Obj10_SpecRuns ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj10_SpecRuns a backlog:Metric ; rdfs:label "Chapter specs that the generic builder runs: 0 -> 3"@en ; backlog:metricUnit "spec" ; backlog:metricBaseline 0 ; backlog:metricTarget 3 .
ex:Obs0_Obj10_SpecRuns a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_SpecRuns ; backlog:observedValue 0 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: chapters 11, 17 and 16 are built by their own old builders (08-tooling/ch11-deck/deck_build_v2_0_0.py and the chapter 16 and 17 equivalents), not by the generic one."@en .
ex:Obj10_MaterialConditions a backlog:Objective ; rdfs:label "Failing automatic conditions of the material check on the three decks and pages: 20 -> 0"@en ;
    backlog:objectiveForGoal ex:G10_DeckOnRulings ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasMetric ex:Metric_Obj10_MaterialConditions ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj10_MaterialConditions a backlog:Metric ; rdfs:label "Failing automatic conditions of the material check on the three decks and pages: 20 -> 0"@en ; backlog:metricUnit "condition" ; backlog:metricBaseline 20 ; backlog:metricTarget 0 .
ex:Obs0_Obj10_MaterialConditions a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_MaterialConditions ; backlog:observedValue 20 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: cme_material_check v1.0.2 on the live files, 2026-11-18. Chapter 11 (deck v2_0_0, page v9_96_0): 6 fail (title words 2 of 29; one thing to look at 1 of 29; notes 40 of 41; prompt markers 86 of 86; frames that parse 50 of 50 fail; lambda 2 in the deck and 145 in the page). Chapter 17 (deck v2_1_0, page v9_96_1): 7 fail (titles 1 of 46; look-at 1 of 46; notes 53 of 59; prompts 125 of 125; parse 71 of 71; lambda 507 in the page; code in page 2 of 71 missing). Chapter 16 (deck v2_0_1, page v9_97_0): 7 fail (titles 2 of 43; look-at 1 of 43; notes 48 of 54; prompts 124 of 124; parse 75 of 75; lambda 5 in the deck and 274 in the page; code in page 2 of 75 missing). 6 + 7 + 7 = 20."@en .
ex:Obj10_DeckStandard a backlog:Objective ; rdfs:label "Failing conditions of deck standard 1.1.0 on the three decks: 6 -> 0"@en ;
    backlog:objectiveForGoal ex:G10_DeckOnRulings ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasMetric ex:Metric_Obj10_DeckStandard ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj10_DeckStandard a backlog:Metric ; rdfs:label "Failing conditions of deck standard 1.1.0 on the three decks: 6 -> 0"@en ; backlog:metricUnit "condition" ; backlog:metricBaseline 6 ; backlog:metricTarget 0 .
ex:Obs0_Obj10_DeckStandard a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_DeckStandard ; backlog:observedValue 6 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: sen0414_deck_standard_check v1.1.0 on chapters 11, 17 and 16: each 11 of 13 pass, D7 (notes) and D10 (content slides complete) fail; 3 x 2 = 6."@en .
ex:Obj10_PagesPassing a backlog:Objective ; rdfs:label "Chapter pages shown to pass the full page test on the corrected pipeline: 0 -> 3"@en ;
    backlog:objectiveForGoal ex:G10_PageOnRulings ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasMetric ex:Metric_Obj10_PagesPassing ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj10_PagesPassing a backlog:Metric ; rdfs:label "Chapter pages shown to pass the full page test on the corrected pipeline: 0 -> 3"@en ; backlog:metricUnit "page" ; backlog:metricBaseline 0 ; backlog:metricTarget 3 .
ex:Obs0_Obj10_PagesPassing a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_PagesPassing ; backlog:observedValue 0 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: none of the three pages has been run on the corrected pipeline (template 9.53.5, lambda-free A-box, Slide code tab); no page is shown to pass. Not estimated."@en .
ex:Obj10_ReviewVerdicts a backlog:Objective ; rdfs:label "Recorded review verdicts of the three roles: 0 -> 36"@en ;
    backlog:objectiveForGoal ex:G10_ReleaseChecked ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasMetric ex:Metric_Obj10_ReviewVerdicts ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj10_ReviewVerdicts a backlog:Metric ; rdfs:label "Recorded review verdicts of the three roles: 0 -> 36"@en ; backlog:metricUnit "verdict" ; backlog:metricBaseline 0 ; backlog:metricTarget 36 .
ex:Obs0_Obj10_ReviewVerdicts a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj10_ReviewVerdicts ; backlog:observedValue 0 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: no review record of the three chapters under ruling 6 (four reviewed conditions times three roles times three chapters = 36)."@en .
