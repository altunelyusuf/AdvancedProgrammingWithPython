@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1011simp-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1011simp-lineage> a owl:Ontology ;
    rdfs:label "Urgent narrow lineage: SEN0414 chapters 10 and 11, one code, one environment"@en ;
    owl:versionInfo "1.0.0" ; owl:versionIRI <http://example.org/sen0414-ch1011simp-lineage/1.0.0> ; dcterms:identifier "sen0414_ch1011simp_lineage" ;
    rdfs:comment """1.0.0 (2026-11-20): Mission stage only (one stage per version), opened by the Owner's urgency case of 2026-11-20 17:37 Istanbul, routed under discipline step 3g(b): another purpose than Lineage10's rulings, and it cannot wait because the Owner could hardly teach chapter 10 today. The urgency itself is declared in the Lineage10 register 1.26.0.
The Owner's objections, each with its own answer in this lineage (L-113): (1) the slides are unusable in the session; (2) code examples are made up, not the book's original; (3) they are more complicated than the subject needs and badly organised, with additions beyond the intent; (4) a code is split over several boxes, so it is hard to read and cannot be copied in one step; (5) the slide code does not match the HTML page; (6) the HTML page should be the place that shows, explains and runs every code as the slides progress, because one missing example forces a switch to another tool. Asked for: review chapters 10 and 11, then a plan for simplification (teachability, understandability, explainability, human communication)."""@en .

ex:ProfileDecl11 a backlog:ProfileDeclaration ;
    rdfs:label "Profile: AAL (agentic adaptive), default"@en ;
    backlog:declaresProfile backlog:Profile_AAL ; backlog:declaresLevel backlog:Level_L2 ;
    backlog:hasIntentOrigin backlog:IOrigin_Default ;
    backlog:hasDeclarationRationale "Work is executed by an LLM agent, no human team; AAL is the default profile for agent-executed work, as for Lineage3 to Lineage10. Level L2 stated plainly." ;
    backlog:declaredAt "2026-11-20T00:00:00Z"^^xsd:dateTime ; backlog:reviewDate "2026-11-27"^^xsd:date .

ex:Lineage11 a backlog:Lineage ;
    rdfs:label "Chapters 10 and 11: one code, one environment, urgent narrow lineage"@en ;
    backlog:lineageForMission ex:Mission11 ; backlog:lineageOrdinal 11 ; backlog:lineageArchived false ;
    backlog:hasLineageStatus backlog:LS_Opened ;
    backlog:hasProfile backlog:Profile_AAL ; backlog:followsProfileDeclaration ex:ProfileDecl11 ;
    backlog:continuesFrom ex:Lineage2 .

ex:Mission11 a backlog:Mission ;
    rdfs:label "Chapters 10 and 11 teach the book's own code, in one piece, run on the page"@en ;
    backlog:missionFor ex:Backlog11 ;
    backlog:hasMissionStatement "The SEN0414 chapter 10 and chapter 11 slides and interactive pages are simplified so that every code example is the book's own code for the subject taught, shown in one readable piece that can be copied in one step, identical on the slide and on the page, with the page as the place that shows, explains and runs each code as the slides progress; a teacher can give the session without leaving the page." ;
    backlog:hasMissionOrigin "Owner's urgency case of 2026-11-20 17:37 Istanbul (objections on slides and code examples of chapters 10 and 11, and the request to review them and plan their simplification)." .

ex:Backlog11 a backlog:Backlog ; rdfs:label "Backlog of Lineage11"@en ; backlog:belongsToLineage ex:Lineage11 .

ex:ST11_Review_And_Plan a backlog:Story ;
    rdfs:label "Review chapters 10 and 11 against the book's own code and the page, and plan their simplification"@en ;
    backlog:belongsToLineage ex:Lineage11 ; backlog:hasState backlog:InProgress .
