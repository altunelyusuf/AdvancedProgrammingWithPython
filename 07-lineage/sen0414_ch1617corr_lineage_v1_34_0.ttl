@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.34.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.34.0> ; owl:priorVersion <http://example.org/sen0414-ch1617corr-lineage/1.33.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment """1.34.0 (2026-11-25): Chapter 17 page build started. One note of the plain deck was corrected after its verification (a slide reference), the deck was rebuilt and the same checks were run again (all exit 0); the Lecture tab text of the page is exported from deck 4.0.0."""@en .

ex:TK10_Page_17_Build backlog:hasState backlog:InProgress ;
    backlog:hasAuditNote "Started 2026-11-25. Found before the build: the Lecture tab of the released page 9.21.0 holds the notes of deck 2.1.0 (lecture_v1_0_0.json), not those of deck 3.0.0, so the page needs a new lecture file from the plain deck: lecture_export_v2_0_0.py writes lecture_v2_0_0.json (59 slides, 33 linked to a concept, every concept id checked against the page data). The older page 9.21.0 is the last page of this chapter; the new page gets its own version." .
