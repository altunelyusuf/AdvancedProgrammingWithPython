@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch2125corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch2125corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 21 to 25 corrections"@en ;
    owl:versionInfo "1.2.0" ; owl:versionIRI <http://example.org/sen0414-ch2125corr-lineage/1.2.0> ;
    owl:priorVersion <http://example.org/sen0414-ch2125corr-lineage/1.1.0> ; dcterms:identifier "sen0414_ch2125corr_lineage" ;
    rdfs:comment """1.2.0 (2026-11-26): Goal stage only (one stage per version). Derived from Scope14, not from a list of gaps (Lineage Operating Discipline v163.0.7, 3d): one mission-facing goal; scope-facing goals that between them cover all nine areas; one containment-facing goal; one exclusion-facing goal for each of the five exclusions. Each goal states the benefit of what the work implements; the conditions of the record are measured by the objectives of the next stage."""@en .

ex:G14_Mission a backlog:Goal ;
    rdfs:label "Chapters 21 to 25 can be lectured from and learned from"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "A lecturer can teach each of chapters 21 to 25 from its deck and page in one four-hour time-box, and a student who receives the slides with their notes can learn the chapter from them without a presenter, with what the chapters teach unchanged." .

ex:G14_Build a backlog:Goal ;
    rdfs:label "Chapters 21 to 25 are each described once, in a spec the generic builder runs"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area14_Conversion ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "Chapters 21 to 25 each have their examples, result visuals, words and plan in one spec that the generic chapter deck builder runs, so a later correction changes the spec and the deck is built again, not patched." .

ex:G14_DeckReads a backlog:Goal ;
    rdfs:label "The decks teach in plain words and serve the reader without a presenter"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area14_Deck , ex:Area14_Reader , ex:Area14_NoAnalogies ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "The chapter 21 to 25 decks teach one thing per slide, state each concept plainly without an everyday analogy, show plain code without prompts or lambda, and carry notes and balloons that explain, add detail and connect, so the reader of the distributed slides learns from them." .

ex:G14_PageRuns a backlog:Goal ;
    rdfs:label "The pages run the code the slides show, in the order of the slides"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area14_Page , ex:Area14_PageCode ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "A student who copies a code example from a chapter 21 to 25 slide, from its page or from its chapter-code manifest gets the same code, and the page runs it with the result the slide shows, one example after another in the order of the slides." .

ex:G14_Released a backlog:Goal ;
    rdfs:label "The chapters are released only on passed checks and recorded reviews"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area14_Release , ex:Area14_OwnVersion ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "Each new deck and page of chapters 21 to 25 is called released only after every automatic condition passes and the academician, the faculty reviewer and the undergraduate reader have each recorded a verdict, and every changed file tells its own version story." .

ex:G14_Known a backlog:Goal ;
    rdfs:label "What is still unmeasured about the chapters is read before work rests on it"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea ex:Area14_Unmeasured ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "The four measures left open at the start of the lineage (page test on the current pipeline, matching code across slide, page and lab libraries, story links and pictures, story repeat) are read and their results recorded before a goal is called reached." .

ex:G14_Contained a backlog:Goal ;
    rdfs:label "No effort goes outside the nine areas"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Containment ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "Every file this lineage changes lies inside the folders of chapters 21 to 25 and their tooling and records, so no work is spent on what the scope did not name." .

ex:G14_Guard_Content a backlog:Goal ;
    rdfs:label "What the five chapters teach and tell stays as approved"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Exclusion ;
    backlog:guardsExclusion ex:Excl14_Content ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No topic, story or example meaning of chapters 21 to 25 changes beyond what a ruling forces, and every story overlap found is reported to the owner and not changed." .

ex:G14_Guard_ExamWork a backlog:Goal ;
    rdfs:label "No exam work is done here"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Exclusion ;
    backlog:guardsExclusion ex:Excl14_ExamWork ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No exam or mock-exam file is changed by this lineage." .

ex:G14_Guard_OtherChapters a backlog:Goal ;
    rdfs:label "The other chapters stay untouched"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Exclusion ;
    backlog:guardsExclusion ex:Excl14_OtherChapters ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No file of chapters 1 to 20 is changed by this lineage." .

ex:G14_Guard_LabMaterials a backlog:Goal ;
    rdfs:label "The lab materials wait for their own lineage"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Exclusion ;
    backlog:guardsExclusion ex:Excl14_LabMaterials ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No lab library, lab session or lab handout is written or changed by this lineage." .

ex:G14_Guard_Rdodi a backlog:Goal ;
    rdfs:label "The research-artifact sets stay as they are"@en ;
    backlog:belongsToLineage ex:Lineage14 ; backlog:goalForMission ex:Mission14 ; backlog:contributesToMission ex:Mission14 ;
    backlog:derivesFromScope ex:Scope14 ; backlog:hasGoalFacing backlog:Facing_Exclusion ;
    backlog:guardsExclusion ex:Excl14_Rdodi ;
    backlog:decidedBy backlog:Owner ; backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:goalCompletionState backlog:Proposed ;
    backlog:hasGoalStatement "No existing file under the rdodi folders of chapters 21 to 25 is modified or deleted by this lineage." .

