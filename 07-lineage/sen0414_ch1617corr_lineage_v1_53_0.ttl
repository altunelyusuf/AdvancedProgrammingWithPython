@prefix backlog: <http://example.org/backlog#> .
@prefix ex: <http://example.org/sen0414-ch1617corr-lineage#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.53.0" ;
    owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.53.0> ;
    owl:priorVersion <http://example.org/sen0414-ch1617corr-lineage/1.52.0> ;
    dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment "1.51.0 (2026-11-26): Merged register. The delta files 1.0.0 to 1.50.0 are combined into one file holding the latest state of every item (hasState, hasLineageStatus and hasMissionOutcome take their latest value; every other statement is kept), so that BRSF's archive tool, which reads one file, can run. Nothing is added or changed in meaning. A register root is added, as BRSF's standard (2.5c-xxi, archival partition) requires: the container the register itself is, marked isRegisterRoot, above every lineage and belonging to none; the backlog of this lineage is a member of it. Without it the lineage's own backlog counted as the root and the archive tool protected the Lineage and the Mission. 1.53.0 (2026-11-26): Correction of the closure statement. Lineage10 was closed (1.50.0) and archived (1.52.0) with the statement that the conditions held. That was wrong: in the archive, criterion DoD10_StoryRepeat is still recorded Violated (stale: the chapter 10 candidates are gone and the per-chapter checks for chapters 10, 11, 16 and 17 give RESULT CLEAN on 2026-11-26) and DoD10_ContentUnchanged is still NotYetEnforceable (the owner has not read the re-cut story prose and balloons). The nine measured objectives stand. The closure is full achievement of the measured objectives with the owner reading outstanding. Report: 07-lineage/reports/REPORT_G237_DoD10_repair_and_closure_finding_v1_0_0.md."@en .




























ex:Register_Ch1617corr a backlog:Backlog ;
    rdfs:label "Register of the chapters 11, 17 and 16 corrections work"@en ;
    backlog:hasIdentifier "Register_SEN0414_Ch1617corr" ;
    backlog:isRegisterRoot true .

#################################################################
#  2026-11-25T21:10:44Z -- ARCHIVAL by backlog_lineage_archive_v2_0_0: 190 subjects of
#  Lineage10 set down into archive/sen0414_ch1617corr_lineage_archive_v1_1_0.ttl; the lineage,
#  its mission and its closure report stay here as the record that points in.
#################################################################

# The record each retired lineage leaves in the live register: a LineageArchiveEntry, not a
# Lineage -- no shape targeting Lineage, Mission or any stage element fires on retired work (G92).
ex:ArchiveEntry_Lineage10 a backlog:LineageArchiveEntry ;
    backlog:entryForLineage <http://example.org/sen0414-ch1617corr-lineage#Lineage10> ;
    backlog:entryForMission <http://example.org/sen0414-ch1617corr-lineage#Mission10> ;
    backlog:entryOutcome backlog:Out_Achieved ;
    backlog:entryOrdinal 10 ;
    backlog:archiveFile "archive/sen0414_ch1617corr_lineage_archive_v1_1_0.ttl" ;
    backlog:archivedAt "2026-11-25T21:10:44Z"^^xsd:dateTime ;
    backlog:archivalTrigger "Retired whole by backlog_lineage_archive_v2_0_0: mission Out_Achieved, closure report present, every item Done or Cancelled, not frozen. Everything the lineage owned -- its Lineage individual, its Mission, its closure report, its stage outputs, findings and items -- moved to the archive file; this entry is the only thing that remains, and it is a record, not a lineage (G92)." .
ex:Lineage10 backlog:lineageArchived true ; backlog:archiveFile "archive/sen0414_ch1617corr_lineage_archive_v1_1_0.ttl" ;
    backlog:archivedAt "2026-11-25T21:10:44Z"^^xsd:dateTime ; backlog:hasLineageStatus backlog:LS_Archived ;
    backlog:archivalTrigger "Found achieved and un-archived by backlog_lineage_archive_v2_12_0: mission Out_Achieved, closure report ClosureReport10 present, every item Done or Cancelled, not frozen. Owner's rule 2026-09-09: a settled lineage found un-archived triggers the archival activity." .
