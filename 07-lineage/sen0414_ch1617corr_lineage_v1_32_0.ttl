    owl:versionInfo "1.32.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.32.0> ; owl:priorVersion <http://example.org/sen0414-ch1617corr-lineage/1.31.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
