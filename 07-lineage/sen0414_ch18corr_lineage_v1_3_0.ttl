@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch18corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch18corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapter 18 corrections"@en ;
    owl:versionInfo "1.3.0" ; owl:versionIRI <http://example.org/sen0414-ch18corr-lineage/1.3.0> ; dcterms:identifier "sen0414_ch18corr_lineage" ;
    rdfs:comment "1.3.0 (2026-11-18): Objective stage only. Baselines are measured on the live files of 2026-11-18; the measured observations after the work are recorded with each task."@en .

ex:Obj9_SpecRuns a backlog:Objective ; rdfs:label "Chapter 18 specs that the generic builder runs: 0 -> 1"@en ;
    backlog:objectiveForGoal ex:G9_SpecBuilt ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasMetric ex:Metric_Obj9_SpecRuns ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj9_SpecRuns a backlog:Metric ; rdfs:label "Chapter 18 specs that the generic builder runs: 0 -> 1"@en ; backlog:metricUnit "spec" ; backlog:metricBaseline 0 ; backlog:metricTarget 1 .
ex:Obs0_Obj9_SpecRuns a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj9_SpecRuns ; backlog:observedValue 0 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: the chapter 18 deck is built by its own builder (08-tooling/ch18-deck/deck_build_v2_0_3.py), not by the generic one."@en .
ex:Obj9_MaterialConditions a backlog:Objective ; rdfs:label "Failing automatic conditions of the material check on deck and page: 7 -> 0"@en ;
    backlog:objectiveForGoal ex:G9_DeckOnRulings ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasMetric ex:Metric_Obj9_MaterialConditions ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj9_MaterialConditions a backlog:Metric ; rdfs:label "Failing automatic conditions of the material check on deck and page: 7 -> 0"@en ; backlog:metricUnit "condition" ; backlog:metricBaseline 7 ; backlog:metricTarget 0 .
ex:Obs0_Obj9_MaterialConditions a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj9_MaterialConditions ; backlog:observedValue 7 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: cme_material_check v1.0.1 on deck v2_0_3 and page v9_96_2: 7 of 8 conditions fail (title words 3 of 41; one thing to look at 1 of 41; notes 49 of 53; prompt markers 120 of 175; frames that parse 112 of 128 fail; lambda 322 in the page; code in page 36 of 128 missing)."@en .
ex:Obj9_DeckStandard a backlog:Objective ; rdfs:label "Failing conditions of deck standard 1.1.0 on the deck: 2 -> 0"@en ;
    backlog:objectiveForGoal ex:G9_DeckOnRulings ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasMetric ex:Metric_Obj9_DeckStandard ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj9_DeckStandard a backlog:Metric ; rdfs:label "Failing conditions of deck standard 1.1.0 on the deck: 2 -> 0"@en ; backlog:metricUnit "condition" ; backlog:metricBaseline 2 ; backlog:metricTarget 0 .
ex:Obs0_Obj9_DeckStandard a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj9_DeckStandard ; backlog:observedValue 2 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: sen0414_deck_standard_check v1.1.0 on deck v2_0_3: 11 of 13 pass; D7 (notes 49 slides outside 60-140) and D10 (37 of 41 content slides complete) fail."@en .
ex:Obj9_PageTestFailing a backlog:Objective ; rdfs:label "Page test features failing or not run on the page: all -> 0"@en ;
    backlog:objectiveForGoal ex:G9_PageOnRulings ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasMetric ex:Metric_Obj9_PageTestFailing ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj9_PageTestFailing a backlog:Metric ; rdfs:label "Page test features failing or not run on the page: all -> 0"@en ; backlog:metricUnit "feature" ; backlog:metricBaseline 412 ; backlog:metricTarget 0 .
ex:Obs0_Obj9_PageTestFailing a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj9_PageTestFailing ; backlog:observedValue 412 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: page 9.96.2 on the old template stops on a browser crash (70 features passed, the rest not run); 412 features run on the corrected template, so the baseline is stated as 412 not shown to pass."@en .
ex:Obj9_ReviewVerdicts a backlog:Objective ; rdfs:label "Recorded review verdicts of the three roles: 0 -> 12"@en ;
    backlog:objectiveForGoal ex:G9_ReleaseChecked ; backlog:belongsToLineage ex:Lineage9 ;
    backlog:hasMetric ex:Metric_Obj9_ReviewVerdicts ; backlog:hasForecastDate "2026-11-19"^^xsd:date .
ex:Metric_Obj9_ReviewVerdicts a backlog:Metric ; rdfs:label "Recorded review verdicts of the three roles: 0 -> 12"@en ; backlog:metricUnit "verdict" ; backlog:metricBaseline 0 ; backlog:metricTarget 12 .
ex:Obs0_Obj9_ReviewVerdicts a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj9_ReviewVerdicts ; backlog:observedValue 0 ; backlog:observedAt "2026-11-18T00:00:00Z"^^xsd:dateTime ; rdfs:comment "Baseline: no review record of chapter 18 under ruling 6 (four reviewed conditions times three roles)."@en .
