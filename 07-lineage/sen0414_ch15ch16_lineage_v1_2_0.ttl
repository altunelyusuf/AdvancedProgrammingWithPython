@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch15ch16-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch15ch16-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 15 and 16"@en ;
    owl:versionInfo "1.2.0" ; owl:versionIRI <http://example.org/sen0414-ch15ch16-lineage/1.2.0> ; dcterms:identifier "sen0414_ch15ch16_lineage" ;
    rdfs:comment "1.2.0 (2026-11-11): Objective stage. Baseline observations only; the 'measured' observation for each objective is recorded together with the Backlog stage's real state-check tasks, same pattern as Lineage5."@en .

## --- Objective (measurable progress toward each Goal) ---

ex:Obj6_DraftsApproved a backlog:Objective ;
    rdfs:label "Owner-approved drafts: 0 -> 2"@en ;
    backlog:objectiveForGoal ex:G6_DraftApproved ; backlog:belongsToLineage ex:Lineage6 ;
    backlog:hasMetric ex:Metric_Obj6_DraftsApproved ;
    backlog:hasForecastDate "2026-11-13"^^xsd:date .

ex:Metric_Obj6_DraftsApproved a backlog:Metric ; rdfs:label "Count of owner-approved chapter drafts (ch15, ch16)"@en ;
    backlog:metricUnit "draft" ; backlog:metricBaseline 0 ; backlog:metricTarget 2 .

ex:Obs0_Obj6_DraftsApproved a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj6_DraftsApproved ;
    backlog:observedValue 0 ; backlog:observedAt "2026-11-11T00:00:00Z"^^xsd:dateTime ;
    rdfs:comment "Baseline: no draft written yet for either chapter."@en .

ex:Obj6_StateChecksRecorded a backlog:Objective ;
    rdfs:label "Real state-checks recorded: 0 -> 2"@en ;
    backlog:objectiveForGoal ex:G6_StateChecked ; backlog:belongsToLineage ex:Lineage6 ;
    backlog:hasMetric ex:Metric_Obj6_StateChecksRecorded ;
    backlog:hasForecastDate "2026-11-11"^^xsd:date .

ex:Metric_Obj6_StateChecksRecorded a backlog:Metric ; rdfs:label "Count of chapters with a recorded real state-check (ch15, ch16)"@en ;
    backlog:metricUnit "state-check" ; backlog:metricBaseline 0 ; backlog:metricTarget 2 .

ex:Obs0_Obj6_StateChecksRecorded a backlog:MetricObservation ; backlog:observationForMetric ex:Metric_Obj6_StateChecksRecorded ;
    backlog:observedValue 0 ; backlog:observedAt "2026-11-11T00:00:00Z"^^xsd:dateTime ;
    rdfs:comment "Baseline: no state-check task recorded in this lineage yet (the preliminary state-check named in the ontology-level comment of v1.0.0 is informal; the Backlog-stage task is the recorded one)."@en .
