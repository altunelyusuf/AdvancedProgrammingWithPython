@prefix backlog: <http://example.org/backlog#> .
@prefix ex:      <http://example.org/sen0414-ch1617corr-lineage#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/sen0414-ch1617corr-lineage> a owl:Ontology ;
    rdfs:label "Fresh narrow lineage: SEN0414 Chapters 11, 17 and 16 corrections"@en ;
    owl:versionInfo "1.10.0" ; owl:versionIRI <http://example.org/sen0414-ch1617corr-lineage/1.10.0> ; dcterms:identifier "sen0414_ch1617corr_lineage" ;
    rdfs:comment """1.10.0 (2026-11-19): Goal stage only. One goal per added scope area, each stated as the benefit the work implements."""@en .

ex:G10_ReaderMaterial a backlog:Goal ; rdfs:label "Slides read well on their own, and the notes serve the reader"@en ;
    backlog:goalForMission ex:Mission10 ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasGoalStatement "The chapter 10 and 11 decks carry their fuller plain-language sentences in speech balloons on the existing slides, and their notes explain, add detail and connect, so a student who receives the slides with their notes can learn from them without a presenter." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G10_OwnVersions a backlog:Goal ; rdfs:label "Each file's version tells its own story"@en ;
    backlog:goalForMission ex:Mission10 ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasGoalStatement "Every changed file of chapters 10 and 11 is one step above its own last released version, no two files share a counter, and no unreleased draft of a page is kept beside the page that replaces it." ;
    backlog:goalCompletionState backlog:Proposed .
ex:G10_Chapter10OnRulings a backlog:Goal ; rdfs:label "Chapter 10 meets the rulings and the handover's practices"@en ;
    backlog:goalForMission ex:Mission10 ; backlog:belongsToLineage ex:Lineage10 ;
    backlog:hasGoalStatement "The chapter 10 deck and page teach one thing per slide, with plain parsing code, no lambda, a Slide code tab, balloons and reader notes, and pass the full page test, with the reviews recorded." ;
    backlog:goalCompletionState backlog:Proposed .
