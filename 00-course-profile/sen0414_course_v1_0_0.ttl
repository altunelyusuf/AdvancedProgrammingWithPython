@prefix schema:  <https://schema.org/> .
@prefix cme:     <http://example.org/cme#> .
@prefix sen0414: <http://example.org/sen0414#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Course profile part - governed by Schema.org Course (CME standards adoption: aligned).
# Every value is taken from the course outline in this folder; nothing here is inferred.

<http://example.org/sen0414/course> a owl:Ontology ;
    rdfs:label "SEN0414 Advanced Programming: course profile"@en ;
    owl:versionInfo "1.0.0" ; dcterms:identifier "sen0414_course_v1_0_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

sen0414:Course a schema:Course ;
    schema:courseCode "SEN0414" ;
    schema:name "Advanced Programming" ;
    schema:provider "Istanbul Kultur University, Department of Computer Engineering" ;
    schema:instructor "Yusuf Altunel" ;
    schema:inLanguage "en" ;
    schema:hasCourseInstance sen0414:Fall2026 ;
    cme:localCreditNotation "2+2 - 3" ;
    cme:creditNote "As printed on the outline: two hours of theory and two of practice a week, three local credits. The ECTS value is not stated here because the ECTS Users' Guide is not yet verified in CME and the catalogue page was empty." .

sen0414:Fall2026 a schema:CourseInstance ;
    schema:name "2026-2027 Fall" ;
    schema:courseSchedule "Fridays 14:00-17:45, four lecture hours, theory and practice" ;
    schema:location "2B PC Lab 12/14" .

# The course repository itself, and the profile it claims.
cme:CR_SEN0414 a cme:CourseRepository_ProfileV1 ;
    cme:repositoryName "altunelyusuf/AdvancedProgrammingWithPython" ; cme:courseCode "SEN0414" ;
    cme:carriesPart cme:Part_CourseProfile, cme:Part_Outcomes, cme:Part_Textbook, cme:Part_Materials,
                    cme:Part_Assessment, cme:Part_Projects, cme:Part_Quality .
